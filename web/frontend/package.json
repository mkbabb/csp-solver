{
  "name": "csp-solver-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "packageManager": "npm@11.x",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "scripts": {
    "wasm": "make -C ../../csp-solver/wasm wasm",
    "prebuild": "npm run wasm",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "prettier --check --config .prettierrc.json src/ scripts/ ../../scripts/",
    "lint:eslint": "eslint .",
    "lint:boundary": "eslint --no-config-lookup --config eslint.boundary.config.js src/games",
    "lint:knip": "knip",
    "lint:ink": "node scripts/check-ink-pressure.mjs --self-test",
    "lint:catch": "node scripts/check-empty-catch.mjs --self-test",
    "lint:theme-selectors": "node scripts/check-theme-selectors.mjs --self-test",
    "lint:theme-tokens": "node scripts/check-theme-tokens.mjs --self-test",
    "lint:lanes": "node scripts/check-lane-membership.mjs --self-test",
    "lint:sleep": "node scripts/check-sleep-lint.mjs --self-test",
    "lint:motion": "node scripts/check-motion-contract.mjs --self-test",
    "lint:tdz": "node scripts/tdz-probe.mjs --self-test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:report": "vitest run --reporter=default --reporter=json --outputFile.json=vitest-report.json",
    "test:unit:count": "node scripts/check-unit-count.mjs vitest-report.json",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:relay": "vitest run --root ../relay",
    "test:coverage:floor": "node scripts/check-coverage-floor.mjs --self-test",
    "test:e2e": "playwright test",
    "test:support-floor": "node scripts/check-support-floor.mjs --self-test",
    "test:e2e:projects": "node scripts/check-pw-projects.mjs --self-test",
    "test:e2e:retries": "node scripts/check-pw-retries.mjs --self-test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:throttle": "playwright test --config playwright-throttle.config.ts",
    "test:golden": "playwright test --config playwright-golden.config.ts",
    "test:golden:update": "playwright test --config playwright-golden.config.ts --update-snapshots",
    "test:golden:bytes": "node scripts/check-golden-bytes.mjs",
    "test:golden:selfdelta": "node scripts/golden-selfdelta.mjs",
    "test:font-coverage": "node scripts/check-font-coverage.mjs",
    "test:prod-shake": "node scripts/check-prod-shake.mjs",
    "deploy": "bash ../../scripts/deploy-gated.sh",
    "deploy:raw": "wrangler pages deploy dist --project-name=sudoku --branch=master --commit-dirty=true"
  },
  "dependencies": {
    "@mkbabb/csp-solver-wasm": "file:../../csp-solver/wasm/pkg",
    "@mkbabb/pencil-boil": "^0.12.0",
    "@tailwindcss/vite": "^4.3.2",
    "@vueuse/core": "^14.3.0",
    "tailwindcss": "^4.3.2",
    "unique-names-generator": "^4.7.1",
    "vue": "^3.5.39"
  },
  "//devDependencies": "esbuild is listed DIRECTLY with no direct import, and that is the answer to T7-W6's dead-dependency row rather than an oversight: vite and wrangler each depend on it, and npm dedupes them to ONE copy only while the range they both resolve to is pinned here (`npm ls esbuild` — 0.28.1, deduped under vite 8 and wrangler 4). Unpinned, wrangler's exact-version dependency splits the tree into two installs of a multi-megabyte platform binary and lets the build and the deploy disagree about the same syntax. Knip sees no importer for it by design; the pin is the consumer.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.26.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7",
    "wrangler": "~4.116.0"
  }
}
