{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["src/**/*.{ts,vue,css}"],
  "ignore": ["src/games/shared/scene.css"],
  "ignoreBinaries": ["make"],
  "playwright": {
    "config": ["playwright.config.ts"],
    "entry": ["e2e/**/*.spec.ts"]
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "duplicates": "error",
    "exports": "error",
    "nsExports": "error",
    "types": "error",
    "nsTypes": "error",
    "enumMembers": "error"
  }
}
