{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // T7-W6. `project` was `src/**` alone for two campaigns, so `scripts/**` and the NON-SPEC
  // half of `e2e/` sat outside the census entirely — which is how `e2e/magnitude-reporter.mjs`
  // (zero referents, retired here) and `scripts/check-theme-tokens.mjs` (no lane runs it)
  // survived a `files: "error"` rule. A dead-file rule that cannot see two of the three
  // first-party source dirs is not a dead-file rule. Widened to both.
  //
  // `perf-rig/**` stays OUT, deliberately and on the record: its six modules run as CHILD
  // PROCESSES of each other and of `run-safari.sh`/`run-sim.sh`, never as imports, so knip's
  // module graph reads all six as unused and the widening would buy six false reds instead of
  // one true one. The rig's own membership question is the perf-lane row (W6, ci-subset.mjs),
  // and `scripts/check-lane-membership.mjs` is the instrument that answers it — it reads
  // ci.yml, which is where the rig's callers live.
  "project": ["src/**/*.{ts,vue,css}", "scripts/**/*.mjs", "e2e/**/*.{ts,mjs}"],

  // Roots whose CALLER is not JavaScript, so no module graph can reach them. Each is named
  // here with the caller that runs it — a file listed without one is a hole.
  //   scripts/dist-identity.mjs      .github/workflows/ci.yml, the dist lane (T9-W5 §5.3):
  //                                  `run: node scripts/dist-identity.mjs --self-test` and
  //                                  `--dist dist`; perf-rig/run-safari.sh + run-sim.sh reach
  //                                  the same file through the AUDIT prepend.
  //   e2e/ch62-admission.ts          .github/workflows/ch62-probe.yml, the CH-62 admission arm
  // `scripts/golden-magnitude.mjs` USED to sit here, cited to "ci.yml, the golden lane" — a
  // lane deleted at T7-WGATE on standing ruling O-12 (d1daefb3). The entry outlived its
  // caller by a whole campaign, which is how a dead file keeps a live-looking badge: knip
  // asks "is it reachable", and an `entry` line answers yes on the author's word. T9-W5 §5.4
  // adjudicated the file KEPT as a declared local instrument, so its caller is now
  // `scripts.test:golden:magnitude` in package.json — a real referent knip resolves for
  // itself — and it carries a `NOT-A-LANE:` header that check-lane-membership.mjs polices.
  // NOT a place to park an unwired gate: a `check-*.mjs` belongs to a lane or declares
  // NOT-A-LANE in its own header, and check-lane-membership.mjs reds if it does neither.
  "entry": ["scripts/dist-identity.mjs", "e2e/ch62-admission.ts"],

  "ignore": ["src/games/shared/scene.css", "src/games/shared/gameCell.css"],

  // `make` is reached through scripts.wasm (`make -C ../../csp-solver/wasm wasm`).
  "ignoreBinaries": ["make"],

  // Dependencies whose CONSUMER is outside this package, named with that consumer — the
  // same law the `entry` block keeps for files.
  //   wrangler  ../../scripts/deploy-gated.sh, which carries BOTH deploy lines (Pages
  //             and the relay Worker) and reaches the binary through
  //             node_modules/.bin. web/relay borrows the same install
  //             (web/relay/wrangler.toml names the path). The line sat in
  //             `scripts.deploy:raw` from T5-W6.2 purely so knip could see the binary
  //             consumed, and that appeasement was an ungated side door: `npm run
  //             deploy:raw` shipped `dist/` past every refusal in the gate (T9-W5,
  //             V3-C6). The gate is the consumer; this is where knip is told so.
  "ignoreDependencies": ["wrangler"],
  "playwright": {
    "config": ["playwright.config.ts"],
    "entry": ["e2e/**/*.spec.ts"]
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "duplicates": "error",
    "exports": "error",
    "nsExports": "error",
    "types": "error",
    "nsTypes": "error",
    "enumMembers": "error"
  }
}
