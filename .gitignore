# Python
__pycache__/
*.pyc
*.pyo
.venv/
my_venv/
*.egg-info/

# Node
web/frontend/node_modules/
web/frontend/dist/
# T4-W2: isolated preview build for the throttled-void probe (playwright-throttle.config.ts)
web/frontend/dist-throttle/

# IDE
.vscode/
.idea/
.metadata/

# OS
.DS_Store

# Environment
.env
.env.local

# Build
/bin/

# Docker
.docker/

# Playwright (browser cache + test artifacts)
.playwright-mcp/
web/frontend/test-results/
web/frontend/playwright-report/

# Temp screenshots (docs/tranches/.gitignore negates this for tranche evidence — keep both intact)
*.png
*.jpeg
*.jpg
# T2-W6 PWA manifest icons are real deploy assets, not temp screenshots — the
# manifest.webmanifest references them and vite-plugin-pwa precaches them.
!web/frontend/public/pwa-192x192.png
!web/frontend/public/pwa-512x512.png
!web/frontend/public/pwa-maskable-512x512.png
# T4-W2 visual goldens — committed small-crop regression fixtures (the π/DELTA MINT).
# These MUST be tracked despite the global *.png ignore; they're policed for bloat by
# web/frontend/scripts/check-golden-bytes.mjs (≤150 KB/image, EVIDENCE-POLICY).
!web/frontend/e2e/goldens/
!web/frontend/e2e/goldens/**/*.png

# Vite cache
.vite/

# TS build info
*.tsbuildinfo

# Rust
target/

# Harness session infra (worktree checkouts, thousands of ephemeral files)
.claude/

# wasm-pack build outputs (rebuilt at release by CI)
csp-solver/wasm/pkg/
csp-solver/wasm-morph/pkg/
