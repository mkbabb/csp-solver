+/**
+ * THE WASM HANDOFF (T9-W8 §8.2 C04) — main thread → worker, beside the request wire.
+ *
+ * Two worker instances share one binary (the resident and the deal channel, T9-W4 §4.1), and
+ * each used to fetch and compile its own copy: two 123,336 B GETs racing one link on a cold
+ * visit, which is 593 ms of blank board on a slow one. A compiled `WebAssembly.Module` is
+ * structured-cloneable, so the flight can be single — the first worker minted compiles and
+ * hands its module back, the transport keeps it, and every worker minted after that is handed
+ * the module instead of a URL. Both instances stay; the second download goes.
+ *
+ * It is not a request: it carries no `id`, correlates to nothing, and is posted at mint,
+ * before any request the caller makes. `own` says which side of the flight a worker is on
+ * when no module exists yet — `true`, fetch and compile it; `false`, another worker already
+ * is, so wait for the module rather than open a second connection for the same bytes.
+ */
+export interface WasmHandoff {
+  kind: "wasm";
+  /** the compiled module, when the estate already holds one. */
+  module?: WebAssembly.Module;
+  /** `true` when this worker owns the one flight. */
+  own?: boolean;
+}
+
+/** Worker → main thread: the module this worker compiled, offered to the next one. */
+export interface WasmModuleOffer {
+  kind: "wasm-module";
+  module: WebAssembly.Module;
+}
+
+/** Is this frame the handoff rather than a request? A request always carries an `id`. */
+export function isWasmHandoff(frame: unknown): frame is WasmHandoff {
+  return (
+    typeof frame === "object" &&
+    frame !== null &&
+    (frame as { kind?: unknown }).kind === "wasm"
+  );
+}
+
+/** Is this frame the module offer rather than a response? */
+export function isWasmModuleOffer(frame: unknown): frame is WasmModuleOffer {
+  return (
+    typeof frame === "object" &&
+    frame !== null &&
+    (frame as { kind?: unknown }).kind === "wasm-module"
+  );
+}
