+import { test, expect, type Page } from "@playwright/test";
+
+// PRM: live, because the dock sheet's rise is the app's own motion and the strip rides it; every
+//   read here is a box, a computed style, an attribute or a count, and the boil moves none of them.
+
+/**
+ * T9-W7 M18 · THE TOOL STRIP WEARS AN EDGE ("This needs to have a border in some way").
+ *
+ * The strip is the card's fifth compartment: the wells' own drawn frame (`HandDrawnOutline`
+ * 1.5 / outset 4 / radius 3 / pose 0) around the verbs row, in `#card-foot` below the card's
+ * scrollport on the rail and the portrait dock, in the body's flow on the landscape dock. Every
+ * row carries its negative control. The painted reads (coverage per side, the leak differential,
+ * stroke daylight, painted contrast) live in the G-BAR prototype instrument
+ * (`docs/.../intake-owner-2026-09-22/prototype/G-BAR/instruments/gbar.mjs`); this file gates the
+ * geometry and the DOM that make them true.
+ */
+
+const PINNED =
+  "./?board=ATMuNTA4MDAwMDAwMDAzMDAwMDAwNjA5MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAw";
+
+async function load(page: Page, touch = false) {
+  await page.goto(PINNED);
+  await page.waitForSelector("svg.handwritten-logo", { timeout: 15000 });
+  await expect
+    .poll(() => page.locator(".sudoku-cell .glyph-svg").count(), { timeout: 15000 })
+    .toBeGreaterThan(0);
+  const tab = page.locator(".drawer-tab").first();
+  if ((await tab.getAttribute("aria-expanded")) === "false") {
+    if (touch) await tab.tap();
+    else await tab.click();
+  }
+  // THE DOCK SHEET SLIDES — poll the settled pose (three reads agreeing), never a sleep.
+  let last = "";
+  let same = 0;
+  await expect
+    .poll(
+      async () => {
+        const s = await page.evaluate(() =>
+          JSON.stringify(document.querySelector(".controls-card")?.getBoundingClientRect()),
+        );
+        same = s === last ? same + 1 : 0;
+        last = s;
+        return same;
+      },
+      { timeout: 5000, intervals: [120] },
+    )
+    .toBeGreaterThanOrEqual(3);
+}
+
+const STRIP = () => {
+  const R = (el: Element | null) => {
+    if (!el) return null;
+    const b = el.getBoundingClientRect();
+    return { x: b.x, y: b.y, r: b.right, b: b.bottom, w: b.width, h: b.height };
+  };
+  const card = document.querySelector(".controls-card")!;
+  const body = document.querySelector(".card-body") as HTMLElement;
+  const bar = document.querySelector(".action-bar")!;
+  const lip = document.querySelector(".tool-lip");
+  const svg = lip?.querySelector(":scope > svg.outline-svg") ?? null;
+  const paths = svg
+    ? [...svg.querySelectorAll("path")].filter(
+        (p) => getComputedStyle(p.parentElement!).display !== "none",
+      )
+    : [];
+  const wells = [...document.querySelectorAll(".control-panel-wrap .tray-well > svg.outline-svg")];
+  const borders = [bar, ...bar.querySelectorAll("*")]
+    .filter((e) => !(e instanceof SVGElement) && e.tagName !== "KBD")
+    .map((e) => {
+      const s = getComputedStyle(e);
+      return Math.max(
+        ...["Top", "Right", "Bottom", "Left"].map(
+          (k) => parseFloat(s.getPropertyValue(`border-${k.toLowerCase()}-width`)) || 0,
+        ),
+      );
+    });
+  const fade = getComputedStyle(document.querySelector("#card-foot")!, "::before");
+  const foot = document.querySelector("#card-foot") as HTMLElement;
+  return {
+    card: R(card),
+    body: R(body),
+    foot: R(foot),
+    footPadB: getComputedStyle(foot).paddingBottom,
+    bar: R(bar),
+    inFoot: !!bar.closest("#card-foot"),
+    svg: R(svg),
+    paths: paths.length,
+    strokeWidth: paths.map((p) => p.getAttribute("stroke-width")),
+    pruned: !!svg?.classList.contains("is-pruned"),
+    wellSvgs: wells.map(R),
+    maxBorder: Math.max(0, ...borders),
+    fadeLeft: fade.left,
+    fadeRight: fade.right,
+    spb: getComputedStyle(body).scrollPaddingBottom,
+    vpH: innerHeight,
+  };
+};
