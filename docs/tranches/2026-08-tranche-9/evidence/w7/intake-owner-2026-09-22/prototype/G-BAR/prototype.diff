+  test.use({ viewport: { width: 1280, height: 800 } });
+
+  const WALK = async (page: Page) =>
+    page.evaluate(async () => {
+      const body = document.querySelector(".card-body") as HTMLElement;
+      body.scrollTop = 0;
+      const foc = [...body.querySelectorAll<HTMLElement>("button, a[href], input, select")].filter(
+        (e) => !(e as HTMLButtonElement).disabled && e.getClientRects().length > 0 && !e.closest("[inert]"),
+      );
+      let under = 0;
