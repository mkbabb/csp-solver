+        e.focus();
+        await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
+        const edge = body.getBoundingClientRect().bottom - (body.hasAttribute("data-fold-below") ? 32 : 0);
+        if (e.getBoundingClientRect().bottom - edge > 0.5) under++;
+      }
+      return { n: foc.length, under };
+    });
+
+  test("G10 — focus-scroll lands every control above the bottom fade", async ({ page }) => {
+    await load(page);
+    expect(await page.locator(".card-body").evaluate((el) => getComputedStyle(el).scrollPaddingBottom)).toBe("32px");
+    const w = await WALK(page);
+    expect(w.n).toBeGreaterThan(8);
+    expect(w.under).toBe(0);
+    // NEGATIVE CONTROL: without the static 2rem at least one control parks under the fade.
+    await page.addStyleTag({ content: ".card-body { scroll-padding-bottom: 0 !important; }" });
+    expect((await WALK(page)).under).toBeGreaterThanOrEqual(1);
+  });
+
+  test("G11 — each verb's note lies astride the frame's bottom stroke, in the foot", async ({ page }) => {
+    await load(page);
+    for (let i = 0; i < 4; i++) {
+      await page.locator(".action-verbs > .icon-btn").nth(i).hover();
+      await expect
+        .poll(() =>
+          page.evaluate((i) => +getComputedStyle(document.querySelectorAll(".action-verbs .washi-label")[i]).opacity, i),
+        )
+        .toBe(1);
+      const g = await page.evaluate((i) => {
+        const n = document.querySelectorAll(".action-verbs .washi-label")[i].getBoundingClientRect();
+        const svg = document.querySelector(".tool-lip > svg.outline-svg")!.getBoundingClientRect();
+        const card = document.querySelector(".controls-card")!.getBoundingClientRect();
+        return { top: n.top - svg.bottom, bottom: card.bottom - n.bottom };
+      }, i);
+      expect(g.top, "note top within 5px of the stroke").toBeLessThanOrEqual(5);
+      expect(g.bottom, "note inside the card").toBeGreaterThanOrEqual(0);
+    }
+    // the berthed invite note answers its verb across the body/foot seam
+    const invite = page.locator(".invite-btn").first();
+    if (await invite.count()) {
+      await invite.scrollIntoViewIfNeeded();
+      await invite.hover();
+      await expect
+        .poll(() => page.evaluate(() => +getComputedStyle(document.querySelector(".berth-note")!).opacity))
+        .toBe(1);
+    }
+  });
+});
+
+test.describe("the portrait dock @ 390×844 (coarse)", () => {
+  test.use({ viewport: { width: 390, height: 844 }, hasTouch: true, isMobile: true });
+
+  test("G5 — the foot sits on the inset, the frame's box clear of the viewport bottom", async ({ page }) => {
+    await load(page, true);
+    const s = await page.evaluate(STRIP);
+    expect(s.inFoot).toBe(true);
+    expect(s.footPadB).toBe("10px");
+    const src = await page.evaluate(() =>
+      [...document.styleSheets].some((sh) => {
+        try {
+          return [...sh.cssRules].some((r) => r.cssText.includes("safe-area-inset-bottom") && r.cssText.includes("card-foot"));
+        } catch {
+          return false;
+        }
+      }),
+    );
+    expect(src, "env(safe-area-inset-bottom) in the foot's rule").toBe(true);
+    // the frame's svg box (stroke + outset) ends above the viewport bottom
+    expect(s.vpH - s.svg!.b).toBeGreaterThanOrEqual(2);
+    // NEGATIVE CONTROL: the foot's pad struck → the frame's box runs off the bottom
+    await page.addStyleTag({ content: ".card-foot { padding-bottom: 0 !important; }" });
+    const n = await page.evaluate(STRIP);
+    expect(n.vpH - n.svg!.b).toBeLessThan(2);
+  });
+});
+
+for (const vp of [
+  { width: 844, height: 390 },
+  { width: 812, height: 375 },
+]) {
+  test.describe(`the landscape dock @ ${vp.width}×${vp.height} (coarse)`, () => {
+    test.use({ viewport: vp, hasTouch: true, isMobile: true });
+
+    test("G13 — the frame drawn in place, clear of the last well and the play row, no foot", async ({ page }) => {
+      await load(page, true);
+      const g = await page.evaluate(() => {
+        const bar = document.querySelector(".action-bar")!;
+        const svg = document.querySelector(".tool-lip > svg.outline-svg")!.getBoundingClientRect();
+        const play = document.querySelector(".play-controls")!.getBoundingClientRect();
+        const wells = [...document.querySelectorAll(".control-panel-wrap .tray-well > svg.outline-svg")].map((w) =>
+          w.getBoundingClientRect(),
+        );
+        const last = wells.filter((w) => w.bottom <= svg.top + 1).pop()!;
+        return {
+          inFoot: !!bar.closest("#card-foot"),
+          shadow: getComputedStyle(bar).boxShadow,
+          toPlay: play.top - svg.bottom,
+          toWell: svg.top - last.bottom,
+        };
+      });
+      expect(g.inFoot).toBe(false);
+      expect(g.shadow).toBe("none");
+      expect(g.toPlay).toBeGreaterThanOrEqual(0);
