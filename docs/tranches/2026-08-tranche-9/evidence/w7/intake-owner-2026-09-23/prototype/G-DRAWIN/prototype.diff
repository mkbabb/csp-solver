@@ -0,0 +1,45 @@
+import { describe, expect, it } from "vitest";
+import { MOTION, cubicBezier, handStroke } from "./pencilConfig";
+
+// T9-M20 — the hand's curve is one ledger string read by a JS solver; the solver must agree with
+// the CSS arithmetic of the same string (the twin a `<style>` consumer would get).
+describe("handStroke", () => {
+  const [x1, y1, x2, y2] = [0.35, 0.05, 0.25, 1];
+  const bez = (a: number, b: number, t: number) =>
+    3 * a * (1 - t) ** 2 * t + 3 * b * (1 - t) * t * t + t ** 3;
+
+  it("reads the ledger string", () => {
+    expect(MOTION.curves.handStroke).toBe("cubic-bezier(0.35, 0.05, 0.25, 1)");
+  });
+
+  it("agrees with the parametric curve at 41 samples to 1e-4", () => {
+    for (let i = 0; i <= 40; i++) {
+      const t = i / 40;
+      expect(handStroke(bez(x1, x2, t))).toBeCloseTo(bez(y1, y2, t), 4);
+    }
+  });
+
+  it("touches down slow, peaks near a third, and stops", () => {
+    const speed = (x: number, h = 1e-4) =>
+      (handStroke(x + h) - handStroke(x - h)) / (2 * h);
+    expect(speed(1e-3)).toBeLessThan(0.3); // ≤ 0.3× the mean speed at touch-down
+    let peak = 0;
+    let at = 0;
+    for (let x = 0.01; x < 1; x += 0.001) {
+      const s = speed(x);
+      if (s > peak) [peak, at] = [s, x];
+    }
+    expect(at).toBeGreaterThan(0.2);
+    expect(at).toBeLessThan(0.4);
+    expect(peak).toBeCloseTo(2.394, 2);
+    expect(handStroke(0.2)).toBeLessThan(0.25);
+    expect(handStroke(0.9)).toBeGreaterThan(0.99);
+  });
+
+  it("parses any cubic-bezier string and clamps its ends", () => {
+    const linear = cubicBezier("cubic-bezier(0, 0, 1, 1)");
+    expect(linear(0.37)).toBeCloseTo(0.37, 5);
+    expect(linear(-1)).toBe(0);
+    expect(linear(2)).toBe(1);
+  });
+});
