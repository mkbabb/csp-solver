+/** A CSS `cubic-bezier(x1, y1, x2, y2)` string as a JS curve (Newton on x with a
+ *  bisection fallback), so one ledger string serves both layers. */
+export function cubicBezier(css: string): (t: number) => number {
+  const [x1, y1, x2, y2] = (css.match(/-?[\d.]+/g) ?? []).map(Number);
+  const bez = (a: number, b: number, t: number) =>
+    3 * a * (1 - t) ** 2 * t + 3 * b * (1 - t) * t * t + t ** 3;
+  const dBez = (a: number, b: number, t: number) =>
+    3 * a * (1 - t) ** 2 + 6 * (b - a) * (1 - t) * t + 3 * (1 - b) * t * t;
+  return (x: number) => {
+    if (x <= 0) return 0;
+    if (x >= 1) return 1;
+    let t = x;
+    for (let i = 0; i < 8; i++) {
+      const d = dBez(x1, x2, t);
+      if (Math.abs(d) < 1e-6) break;
+      t -= (bez(x1, x2, t) - x) / d;
+    }
+    if (!(t >= 0 && t <= 1) || Math.abs(bez(x1, x2, t) - x) > 1e-6) {
+      let lo = 0;
+      let hi = 1;
+      for (let i = 0; i < 48; i++) {
+        t = (lo + hi) / 2;
+        if (bez(x1, x2, t) < x) lo = t;
+        else hi = t;
+      }
+    }
+    return bez(y1, y2, t);
+  };
+}
+
+/** The hand's curve, resolved once. */
+export const handStroke = cubicBezier(MOTION.curves.handStroke);
