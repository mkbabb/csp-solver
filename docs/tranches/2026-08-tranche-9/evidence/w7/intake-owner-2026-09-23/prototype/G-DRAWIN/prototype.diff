index 00000000..0958c24d
--- /dev/null
+++ b/web/frontend/src/pencil/composables/bootHand.ts
@@ -0,0 +1,67 @@
+import { ref } from "vue";
+import { createSequenceSubscription, type SequenceHandle } from "@mkbabb/pencil-boil";
+import { MOTION } from "@pencil/config/pencilConfig";
+
+/**
+ * T9-M20 · THE HAND'S CLOCK. The boot's draw-ins used to read the wall clock, so a frame the
+ * main thread lost painted every line wherever the clock said (a 100–440 ms stall moved one
+ * line 72–100 % in a single painted frame). Here one master `sequence` subscription carries
+ * the rAF timeline (`raw × SPAN_MS`) and the hand's clock advances by at most
+ * `MOTION.hand.stepMs` per tick: a healthy 60 Hz frame is never slowed, and a stall pauses
+ * the hand for one frame's travel instead of teleporting it.
+ *
+ * Every stroke on the boot (the grid's ruling, the wordmark's rubbing) enrolls here, so they
+ * share one clock; a stroke returns `true` when it is finished and leaves the set. The master
+ * leaves the scheduler the tick the set empties. The library form (`stepMs` on the sequence
+ * itself, pencil-boil 0.12.1) deletes this file.
+ */
+type Stroke = (clock: number) => boolean;
+
+const SPAN_MS = 600_000;
+let clock = 0;
+let last = -1;
+let master: SequenceHandle | null = null;
+const strokes = new Set<Stroke>();
+
+function tick(_eased: number, raw: number): void {
+  const t = raw * SPAN_MS;
+  if (last >= 0) clock += Math.min(Math.max(0, t - last), MOTION.hand.stepMs);
+  last = t;
+  for (const s of [...strokes]) if (s(clock)) strokes.delete(s);
+  if (strokes.size === 0) {
+    master?.stop();
+    master = null;
+    last = -1;
+  }
+}
+
+/** Enroll a stroke on the hand clock; returns its withdrawal. */
+export function enrollStroke(stroke: Stroke): () => void {
+  strokes.add(stroke);
+  if (!master) {
+    master = createSequenceSubscription({ durationMs: SPAN_MS, onProgress: tick });
+    master.start();
+  }
+  return () => {
+    strokes.delete(stroke);
+  };
+}
+
+/** The wordmark's rubbing onset on the hand clock: the grid's frame lands at its lift. */
+let rubbingAt: number | null = null;
+export function markRubbing(): void {
+  rubbingAt = clock;
+}
+/** How long the ruling waits so its first stroke lands at the rubbing's lift (0 if none). */
+export function rulingOffset(): number {
+  if (rubbingAt === null) return 0;
+  const lift = rubbingAt + MOTION.hand.lift * MOTION.hand.serial.rubbing;
+  return Math.max(0, lift - clock);
+}
+
+/** The grid's whole pose stack has landed: the wordmark may bake the rest of its own. */
+export const gridStackLanded = ref(false);
+
+/** The wordmark's pose 0 is resident (or its ceiling passed): the ruling may start without
+ *  the wordmark's encode landing under it (WebKit bakes it ~20–100 ms after the grid's). */
+export const wordmarkResident = ref(false);
