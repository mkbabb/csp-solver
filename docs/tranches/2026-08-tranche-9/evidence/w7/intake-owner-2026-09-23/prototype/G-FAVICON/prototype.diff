+#!/usr/bin/env node
+/**
+ * THE TOUCH ICON (T9-M22, TAB-PEN). Rasters `public/icon.svg`'s light arm to
+ * `public/apple-touch-icon.png`, 180 × 180, square paper (iOS rounds the corners itself), palette PNG,
+ * and stamps the SVG's sha256 into PROVENANCE below so `check-favicon.mjs` (e) can tell, without a
+ * rasteriser, whether the PNG was cut from the SVG on disk.
+ *
+ * `sharp` is NOT a dependency of this package. It is miniflare's transitive (package-lock.json,
+ * `node_modules/sharp`), resolved here through createRequire the way the favicon census's cost.mjs
+ * did. A wrangler/miniflare bump can move or drop it; declaring it is the fold's decision.
+ *
+ * NOT-A-LANE: it rides an undeclared transitive (sharp via miniflare) and writes a committed binary, so its cadence is a re-cut of public/icon.svg, run by hand beside it; CI holds the pair through lint:favicon (e), which reads the PNG's IHDR and the provenance sha with no rasteriser (scripts/check-favicon.mjs).
+ *
+ * Run: `node scripts/icons.mjs` (write) · `node scripts/icons.mjs --check` (re-raster, compare the
+ * DECODED pixels and the sha; exit 1 on drift). cwd web/frontend.
+ */
+import { createHash } from "node:crypto";
+import { createRequire } from "node:module";
+import fs from "node:fs";
+import path from "node:path";
+
+const PROVENANCE =
+  "icon.svg sha256 856c8ad5bdfe114aaf93fb4cd75e55122acc6fd055d880c9b03eaafadb14d338";
+
+const ROOT = path.join(import.meta.dirname, "..");
+const SVG = path.join(ROOT, "public", "icon.svg");
+const PNG = path.join(ROOT, "public", "apple-touch-icon.png");
+const SIZE = 180;
+
+const sharp = createRequire(path.join(ROOT, "package.json"))("sharp");
+const svg = fs.readFileSync(SVG);
+const sha = createHash("sha256").update(svg).digest("hex");
+// The light arm, explicitly: the rasteriser's own prefers-color-scheme is not a thing to rely on.
+const light = Buffer.from(
+  svg.toString().replace(/@media[^{]*\{(?:[^{}]*\{[^}]*\})*[^}]*\}/, ""),
+);
+
+const raster = () =>
+  sharp(light, { density: (72 * SIZE) / 32 })
+    .resize(SIZE, SIZE)
+    .png({ palette: true, compressionLevel: 9 })
+    .toBuffer();
+const pixels = (buf) => sharp(buf).ensureAlpha().raw().toBuffer();
+
+if (process.argv.includes("--check")) {
+  const fresh = await pixels(await raster());
+  const kept = await pixels(fs.readFileSync(PNG));
+  let maxDelta = 0;
+  for (let i = 0; i < Math.max(fresh.length, kept.length); i++)
+    maxDelta = Math.max(maxDelta, Math.abs((fresh[i] ?? 0) - (kept[i] ?? 0)));
+  const shaOk = PROVENANCE.endsWith(sha);
+  console.log(
+    `icons --check: decoded max Δ ${maxDelta}, provenance ${shaOk ? "matches" : "STALE"}`,
+  );
+  process.exit(maxDelta === 0 && shaOk ? 0 : 1);
+}
+
+const png = await raster();
+fs.writeFileSync(PNG, png);
+const self = import.meta.filename;
+fs.writeFileSync(
+  self,
+  fs
+    .readFileSync(self, "utf8")
+    .replace(/icon\.svg sha256 [0-9a-f]{64}/, `icon.svg sha256 ${sha}`),
+);
+console.log(
+  `apple-touch-icon.png ${SIZE}×${SIZE}, ${png.length} B, from icon.svg ${sha}`,
+);
