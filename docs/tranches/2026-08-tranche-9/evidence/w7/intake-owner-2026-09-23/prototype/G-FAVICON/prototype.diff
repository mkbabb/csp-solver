--- /dev/null
+++ b/web/frontend/scripts/check-favicon.mjs
@@ -0,0 +1,392 @@
+#!/usr/bin/env node
+/**
+ * THE FAVICON GATE (T9-M22, TAB-PEN). The tab's s is written with the board's pen, on the page's
+ * paper, in the page's ink. Five clauses over the files on disk, browserless:
+ *
+ *   a  no filter      no <filter>, feTurbulence, feDisplacementMap, clip-path/clipPath, rx/ry.
+ *                     A displacement at tab size is a no-op in Chromium and a blur in WebKit.
+ *   b  one pen line   exactly one <path>: fill none, round caps and joins, stroke-width in
+ *                     [3.6, 5.2] of the 32 viewBox; no opacity/stroke-opacity/fill-opacity/filter
+ *                     anywhere; <= 600 B.
+ *   c  the page's     the light rect/path literals (presentation attributes AND <style>) and the
+ *      colours        @media (prefers-color-scheme: dark) pair are byte-equal to the resolved
+ *                     @theme / .dark --color-background / --color-foreground in src/assets/index.css
+ *                     (this file's own hsl() resolver), and ink over paper is >= 7:1 in each theme.
+ *   d  the pen's box  the exact cubic-extrema bbox inflated by half the pen is within [0.55, 0.80]
+ *                     of the tile per axis, centred within 0.5 unit of the tile's centre, and
+ *                     stroke / (bbox H + stroke) is in [0.15, 0.17] (the digits' line).
+ *   e  the estate     index.html links /icon.svg and /apple-touch-icon.png, both exist, the PNG's
+ *                     IHDR reads 180 x 180, scripts/icons.mjs's PROVENANCE carries icon.svg's
+ *                     sha256, and public/favicon.svg is gone (the rename is the favicon-store bust).
+ *
+ * The SVG audited is the one index.html's rel="icon" link names, so the gate reads a tree that
+ * still ships favicon.svg as RED on a-d rather than as "missing".
+ *
+ * `--self-test` plants six defects, each of which must RED exactly its clause(s) (the plant re-stamps
+ * the provenance sha as icons.mjs would, except P6, whose whole point is the stale sha):
+ *   P1 main's favicon.svg verbatim (a b c d) · P2 ink #1a1a1a (c) · P3 stroke-width 6 (b d) ·
+ *   P4 the @media block deleted (c) · P5 FAINT INK: stroke-opacity 0.15 (b), and separately ink
+ *   #e8e6e3 on the light paper, ~1.2:1 (c) · P6 the SVG edited after the PNG (e).
+ *
+ * Run: `node scripts/check-favicon.mjs [--self-test] [--root <web/frontend dir>]`, cwd web/frontend.
+ */
+import { createHash } from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+import process from "node:process";
+
+const argRoot = process.argv.indexOf("--root");
+const ROOT =
+  argRoot > 0
+    ? path.resolve(process.argv[argRoot + 1])
+    : path.join(import.meta.dirname, "..");
+
+/* ── colour: the gate's own hsl() -> #rrggbb, and WCAG contrast ─────────────── */
+function hslHex(css) {
+  const m = /hsl\(\s*([\d.]+)\s+([\d.]+)%\s+([\d.]+)%\s*\)/.exec(css);
+  if (!m) return null;
+  const [h, s, l] = [+m[1], +m[2] / 100, +m[3] / 100];
+  const c = (1 - Math.abs(2 * l - 1)) * s;
+  const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
+  const [r, g, b] = [
+    [c, x, 0],
+    [x, c, 0],
+    [0, c, x],
+    [0, x, c],
+    [x, 0, c],
+    [c, 0, x],
+  ][Math.floor(h / 60) % 6];
+  const to = (v) =>
+    Math.round((v + l - c / 2) * 255)
+      .toString(16)
+      .padStart(2, "0");
+  return `#${to(r)}${to(g)}${to(b)}`;
+}
+function contrast(a, b) {
+  const lum = (hex) => {
+    const [r, g, bl] = [1, 3, 5].map((i) => {
+      const v = parseInt(hex.slice(i, i + 2), 16) / 255;
+      return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
+    });
+    return 0.2126 * r + 0.7152 * g + 0.0722 * bl;
+  };
+  const [hi, lo] = [lum(a), lum(b)].sort((p, q) => q - p);
+  return (hi + 0.05) / (lo + 0.05);
+}
+/** The body of the first block whose header matches `head` (brace-matched). */
+function block(text, head) {
+  const at = text.search(head);
+  if (at < 0) return "";
+  let i = text.indexOf("{", at) + 1;
+  const from = i;
+  for (let depth = 1; depth && i < text.length; i++)
+    depth += { "{": 1, "}": -1 }[text[i]] ?? 0;
+  return text.slice(from, i - 1);
+}
+function tokens(css) {
+  const read = (body, name) =>
+    hslHex(new RegExp(`${name}:\\s*([^;]+);`).exec(body)?.[1] ?? "");
+  const light = block(css, /@theme\s*\{/);
+  const dark = block(css, /^\.dark\s*\{/m);
+  return {
+    light: {
+      paper: read(light, "--color-background"),
+      ink: read(light, "--color-foreground"),
+    },
+    dark: {
+      paper: read(dark, "--color-background"),
+      ink: read(dark, "--color-foreground"),
+    },
+  };
+}
+
+/* ── geometry: absolute M/L/H/V/C/Q/Z, exact extrema ────────────────────────── */
+function bbox(d) {
+  const t = d.match(/[MLHVCQZ]|-?\d*\.?\d+(?:e-?\d+)?/gi);
+  if (!t || t.some((x) => /[a-z]/.test(x) && x !== x.toUpperCase())) return null; // relative: unread
+  let [cx, cy] = [0, 0];
+  const xs = [];
+  const ys = [];
+  const at = (p, k) => p.map((q) => q[k]);
+  const extrema = (v, cubic) => {
+    const roots = [];
+    if (cubic) {
+      const [a, b, c] = [
+        -v[0] + 3 * v[1] - 3 * v[2] + v[3],
+        2 * (v[0] - 2 * v[1] + v[2]),
+        v[1] - v[0],
+      ];
+      if (Math.abs(a) < 1e-12) {
+        if (Math.abs(b) > 1e-12) roots.push(-c / b);
+      } else {
+        const disc = b * b - 4 * a * c;
+        if (disc >= 0)
+          roots.push(
+            (-b + Math.sqrt(disc)) / (2 * a),
+            (-b - Math.sqrt(disc)) / (2 * a),
+          );
+      }
+    } else if (Math.abs(v[0] - 2 * v[1] + v[2]) > 1e-12)
+      roots.push((v[0] - v[1]) / (v[0] - 2 * v[1] + v[2]));
+    const out = [v[0], v[v.length - 1]];
+    for (const u of roots.filter((r) => r > 0 && r < 1))
+      out.push(
+        cubic
+          ? (1 - u) ** 3 * v[0] +
+              3 * (1 - u) ** 2 * u * v[1] +
+              3 * (1 - u) * u * u * v[2] +
+              u ** 3 * v[3]
+          : (1 - u) ** 2 * v[0] + 2 * (1 - u) * u * v[1] + u * u * v[2],
+      );
+    return out;
+  };
+  let cmd = "";
+  for (let i = 0; i < t.length;) {
+    if (/[A-Z]/.test(t[i])) cmd = t[i++];
+    const n = () => +t[i++];
+    if (cmd === "Z") continue;
+    if (cmd === "M" || cmd === "L") [cx, cy] = [n(), n()];
+    else if (cmd === "H") cx = n();
+    else if (cmd === "V") cy = n();
+    else if (cmd === "C" || cmd === "Q") {
+      const p = [[cx, cy]];
+      for (let k = 0; k < (cmd === "C" ? 3 : 2); k++) p.push([n(), n()]);
+      xs.push(...extrema(at(p, 0), cmd === "C"));
+      ys.push(...extrema(at(p, 1), cmd === "C"));
+      [cx, cy] = p[p.length - 1];
+      continue;
+    } else return null;
+    xs.push(cx);
+    ys.push(cy);
+  }
+  return [Math.min(...xs), Math.min(...ys), Math.max(...xs), Math.max(...ys)];
+}
+
+/* ── the audit: one model in, a list of [clause, reason] out ────────────────── */
+function audit(m) {
+  const fails = [];
+  const red = (clause, why) => fails.push([clause, why]);
+  const svg = m.svg ?? "";
+  // a
+  for (const [re, what] of [
+    [/<filter\b/, "<filter>"],
+    [/feTurbulence/, "feTurbulence"],
+    [/feDisplacementMap/, "feDisplacementMap"],
+    [/clip-?[pP]ath/, "a clip path"],
+    [/\sr[xy]=/, "a corner radius (rx/ry)"],
+  ])
+    if (re.test(svg)) red("a", `the icon carries ${what}`);
+  // b
+  const paths = svg.match(/<path\b[^>]*>/g) ?? [];
+  if (paths.length !== 1)
+    red("b", `${paths.length} <path> elements, one pen line wanted`);
+  const p = paths[0] ?? "";
+  const attr = (tag, name) => new RegExp(`\\s${name}="([^"]*)"`).exec(tag)?.[1];
+  if (attr(p, "fill") !== "none")
+    red("b", `fill="${attr(p, "fill")}", a filled glyph, not a pen line`);
+  if (attr(p, "stroke-linecap") !== "round") red("b", "stroke-linecap is not round");
+  if (attr(p, "stroke-linejoin") !== "round") red("b", "stroke-linejoin is not round");
+  const sw = +attr(p, "stroke-width");
+  if (!(sw >= 3.6 && sw <= 5.2))
+    red("b", `stroke-width ${attr(p, "stroke-width")} outside [3.6, 5.2]`);
+  if (
+    /(?:^|[^-\w])(?:stroke-|fill-)?opacity\b|\bfilter\b/.test(
+      svg.replace(/<filter\b/g, ""),
+    )
+  )
+    red("b", "opacity or filter on the icon (faint ink is not ink)");
+  if (Buffer.byteLength(svg) > 600) red("b", `${Buffer.byteLength(svg)} B > 600`);
+  // c
+  const tok = m.tokens;
+  const style = /<style>([\s\S]*?)<\/style>/.exec(svg)?.[1] ?? "";
+  const media = block(style, /@media\s*\(\s*prefers-color-scheme\s*:\s*dark\s*\)/);
+  const base = style.replace(/@media[^{]*\{(?:[^{}]*\{[^}]*\})*[^}]*\}/, "");
+  const rule = (css, sel, prop) =>
+    new RegExp(`${sel}\\s*\\{[^}]*${prop}:\\s*(#[0-9a-fA-F]{3,8})`).exec(css)?.[1];
+  const rects = svg.match(/<rect\b[^>]*>/g) ?? [];
+  const rect = rects.find((r) => attr(r, "fill")) ?? rects[0] ?? "";
+  const seen = {
+    "light rect fill (attribute)": [attr(rect, "fill"), tok.light.paper],
+    "light path stroke (attribute)": [attr(p, "stroke"), tok.light.ink],
+    "light rect fill (style)": [rule(base, "rect", "fill"), tok.light.paper],
+    "light path stroke (style)": [rule(base, "path", "stroke"), tok.light.ink],
+    "dark rect fill (@media)": [rule(media, "rect", "fill"), tok.dark.paper],
+    "dark path stroke (@media)": [rule(media, "path", "stroke"), tok.dark.ink],
+  };
+  for (const [where, [got, want]] of Object.entries(seen))
+    if (got?.toLowerCase() !== want)
+      red("c", `${where} is ${got ?? "absent"}, the page's token is ${want}`);
+  for (const theme of ["light", "dark"]) {
+    const { ink, paper } = tok[theme];
+    if (!ink || !paper || contrast(ink, paper) < 7)
+      red("c", `${theme} token ink/paper below 7:1`);
+  }
+  const litInk = attr(p, "stroke");
+  const litPaper = attr(rect, "fill");
+  if (/^#[0-9a-f]{6}$/i.test(litInk ?? "") && /^#[0-9a-f]{6}$/i.test(litPaper ?? "")) {
+    const k = contrast(litInk, litPaper);
+    if (k < 7) red("c", `the icon's own light ink/paper reads ${k.toFixed(2)}:1`);
+  }
+  // d
+  const box = bbox(attr(p, "d") ?? "");
+  const tf =
+    /transform="translate\(\s*([-\d.]+)[ ,]+([-\d.]+)\s*\)\s*scale\(\s*([\d.]+)\s*\)"/.exec(
+      svg,
+    );
+  if (/transform=/.test(svg) && !tf) red("d", "a transform this gate cannot read");
+  if (!box)
+    red("d", "the path's geometry is unreadable (relative or unknown commands)");
+  else {
+    const [ox, oy, s] = tf ? [+tf[1], +tf[2], +tf[3]] : [0, 0, 1];
+    const [x0, y0, x1, y1] = [
+      ox + s * box[0],
+      oy + s * box[1],
+      ox + s * box[2],
+      oy + s * box[3],
+    ];
+    const pen = Number.isFinite(sw) ? sw : 0;
+    const [W, H] = [x1 - x0 + pen, y1 - y0 + pen];
+    for (const [axis, v] of [
+      ["width", W / 32],
+      ["height", H / 32],
+    ])
+      if (!(v >= 0.55 && v <= 0.8))
+        red("d", `ink ${axis} ${v.toFixed(3)} of the tile, outside [0.55, 0.80]`);
+    const [cx, cy] = [(x0 + x1) / 2, (y0 + y1) / 2];
+    if (Math.hypot(cx - 16, cy - 16) > 0.5)
+      red("d", `ink centre (${cx.toFixed(2)}, ${cy.toFixed(2)}) off (16, 16)`);
+    const ratio = pen / H;
+    if (!(ratio >= 0.15 && ratio <= 0.17))
+      red("d", `stroke/H ${ratio.toFixed(3)} outside [0.15, 0.17]`);
+  }
+  // e
+  const links = m.html.match(/<link\b[^>]*>/g) ?? [];
+  const linked = (rel, href) =>
+    links.some((l) => attr(l, "rel") === rel && attr(l, "href") === href);
+  if (!linked("icon", "/icon.svg"))
+    red("e", 'index.html does not link rel="icon" /icon.svg');
+  if (!linked("apple-touch-icon", "/apple-touch-icon.png"))
+    red("e", "index.html does not link /apple-touch-icon.png");
+  if (!m.iconExists) red("e", "public/icon.svg is missing");
+  const png = m.png;
+  if (!png) red("e", "public/apple-touch-icon.png is missing");
+  else if (
+    png.subarray(12, 16).toString() !== "IHDR" ||
+    png.readUInt32BE(16) !== 180 ||
+    png.readUInt32BE(20) !== 180
+  )
+    red("e", "apple-touch-icon.png is not a 180 x 180 PNG");
+  const sha = createHash("sha256").update(svg).digest("hex");
+  const stamped = /icon\.svg sha256 ([0-9a-f]{64})/.exec(m.iconsSrc ?? "")?.[1];
+  if (stamped !== sha)
+    red("e", "the PNG's provenance sha is not icon.svg's (re-run scripts/icons.mjs)");
+  if (m.faviconExists) red("e", "public/favicon.svg still ships");
+  return fails;
+}
+
+function readTree(root) {
+  const read = (...p) => {
+    try {
+      return fs.readFileSync(path.join(root, ...p));
+    } catch {
+      return null;
+    }
+  };
+  const html = String(read("index.html") ?? "");
+  const href =
+    /<link\b[^>]*rel="icon"[^>]*href="\/([^"]+)"/.exec(html)?.[1] ?? "icon.svg";
+  return {
+    svg: String(read("public", href) ?? ""),
+    html,
+    tokens: tokens(String(read("src", "assets", "index.css") ?? "")),
+    png: read("public", "apple-touch-icon.png"),
+    iconsSrc: String(read("scripts", "icons.mjs") ?? ""),
+    iconExists: read("public", "icon.svg") !== null,
+    faviconExists: read("public", "favicon.svg") !== null,
+  };
+}
+
+const MAIN_FAVICON = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
+  <defs>
+    <filter id="w" x="-20%" y="-20%" width="140%" height="140%">
+      <feTurbulence type="turbulence" baseFrequency="0.035" numOctaves="3" seed="5" result="t"/>
+      <feDisplacementMap in="SourceGraphic" in2="t" scale="4" xChannelSelector="R" yChannelSelector="G"/>
+    </filter>
+    <clipPath id="c">
+      <rect width="32" height="32" rx="6" ry="6"/>
+    </clipPath>
+  </defs>
+  <rect width="32" height="32" rx="6" ry="6" fill="#faf8f5"/>
+  <g clip-path="url(#c)">
+    <g transform="translate(1.10,29.71) scale(0.056751)" filter="url(#w)">
+      <path fill="#1a1a1a" d="M268-49.50L268-49.50Q296.50-49.50 310.25-62Q324-74.50 324-92L324-92Q324-102.50 320-111.75Q316-121 301.50-128.75Q287-136.50 255.50-141.50L255.50-141.50Q162.50-157 113.75-182.75Q65-208.50 47.50-243.75Q30-279 30-323L30-323Q30-404.50 86.75-450.75Q143.50-497 254.50-497L254.50-497Q292.50-497 315.25-491Q338-485 351.75-479Q365.50-473 376.50-473L376.50-473Q389-473 395.75-479Q402.50-485 409.75-491Q417-497 430.50-497L430.50-497Q441-497 449.50-490Q458-483 463.50-464L463.50-464L489.50-375.50Q497.50-349.50 494.25-334Q491-318.50 475-312.50L475-312.50Q459-306.50 447.25-312Q435.50-317.50 424-334L424-334Q401.50-367.50 376.50-389.50Q351.50-411.50 324.50-422.50Q297.50-433.50 268-433.50L268-433.50Q234.50-433.50 217.75-421Q201-408.50 201-387.50L201-387.50Q201-374.50 207.75-365Q214.50-355.50 235.50-347.75Q256.50-340 298-332.50L298-332.50Q371-319.50 413.50-295.25Q456-271 474.50-235.50Q493-200 493-152L493-152Q493-102 466-64.50Q439-27 392.25-6.50Q345.50 14 285.50 14L285.50 14Q248.50 14 227.25 7.75Q206 1.50 192.50-4.75Q179-11 166-11L166-11Q153-11 143.50-4.75Q134 1.50 125 7.75Q116 14 104 14L104 14Q93 14 85.50 6Q78-2 74.50-21.50L74.50-21.50L59-107Q54.50-132.50 58.50-145.25Q62.50-158 76.50-164L76.50-164Q92-170.50 104-163.75Q116-157 128.50-139.50L128.50-139.50Q163-90 198.50-69.75Q234-49.50 268-49.50Z"/>
+    </g>
+  </g>
+</svg>
+`;
+
+function selfTest(clean) {
+  const restamp = (svg) =>
+    `icon.svg sha256 ${createHash("sha256").update(svg).digest("hex")}`;
+  const plant = (label, edit, want, keepSha = false) => {
+    const svg = edit(clean.svg);
+    const m = { ...clean, svg, iconsSrc: keepSha ? clean.iconsSrc : restamp(svg) };
+    const got = [...new Set(audit(m).map(([c]) => c))].sort().join("");
+    const ok = got === want && svg !== clean.svg;
+    console.log(
+      `  ${ok ? "RED as required" : "FAILED"}  ${label}: red ${got || "none"}, want ${want}`,
+    );
+    return ok;
+  };
+  console.log("\nself-test plants:");
+  const results = [
+    plant("P1 main's favicon.svg verbatim", () => MAIN_FAVICON, "abcd"),
+    plant("P2 ink #1a1a1a", (s) => s.replaceAll("#0a0a0a", "#1a1a1a"), "c"),
+    plant(
+      "P3 stroke-width 6",
+      (s) => s.replace(/stroke-width="[^"]*"/, 'stroke-width="6"'),
+      "bd",
+    ),
+    plant(
+      "P4 @media deleted",
+      (s) => s.replace(/@media[^{]*\{(?:[^{}]*\{[^}]*\})*[^}]*\}/, ""),
+      "c",
+    ),
+    plant(
+      "P5 FAINT INK stroke-opacity 0.15",
+      (s) => s.replace("<path ", '<path stroke-opacity="0.15" '),
+      "b",
+    ),
+    plant(
+      "P5 FAINT INK #e8e6e3 on the light paper",
+      (s) => s.replaceAll("#0a0a0a", "#e8e6e3"),
+      "c",
+    ),
+    plant(
+      "P6 the SVG edited after the PNG",
+      (s) => s.replace(/d="M[\d.]+/, (x) => `${x}1`),
+      "e",
+      true,
+    ),
+  ];
+  return results.every(Boolean);
+}
+
+const model = readTree(ROOT);
+const fails = audit(model);
+console.log(`check-favicon (${ROOT}):`);
+for (const clause of "abcde") {
+  const mine = fails.filter(([c]) => c === clause);
+  console.log(
+    `  ${clause}  ${mine.length ? "RED" : "GREEN"}${mine.map(([, w]) => `\n       ${w}`).join("")}`,
+  );
+}
+if (process.argv.includes("--self-test") && !selfTest(model)) {
+  console.error("\ncheck-favicon: a plant did not red its clause");
+  process.exit(2);
+}
+if (fails.length) {
+  console.error(`\ncheck-favicon: ${fails.length} failure(s)`);
+  process.exit(1);
+}
+console.log("\ncheck-favicon: the tab's s is the house pen, on the page's paper");
