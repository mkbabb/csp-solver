+    expect(hingeMs(false)).toBe(87);
+  });
+
+  it("springPop's crest abscissa is derived, 0.573 ± 0.002, and the TS copy is index.css's", () => {
+    const css = CSS.match(/--ease-springPop:\s*(cubic-bezier\([^)]+\))/)![1];
+    expect(css).toBe(MOTION.curves.springPop);
+    expect(Math.abs(bezierCrestX(MOTION.curves.springPop) - 0.573)).toBeLessThan(0.002);
+  });
+
+  it("arm R's score is spent from the rungs; arm K is the owner's table verbatim", () => {
+    const { whisper, note, throw: thr, dusk } = MOTION.rungs;
+    const crest = Math.round(bezierCrestX(MOTION.curves.springPop) * thr);
+    const R = storybookScore("R");
+    expect(R.flip).toBe(whisper);
+    expect([R.fold, R.birth, R.rise]).toEqual([note, note, thr]);
+    expect(R.stars).toEqual([0, 1, 2].map((k) => note + crest + k * MOTION.beatMs));
+    expect(R.plush).toBe(0);
+    expect(R.turningOff).toBe(whisper + dusk + MOTION.beatMs);
+    const K = storybookScore("K");
+    expect([K.flip, K.fold, K.birth, K.rise, K.plush]).toEqual([0, 340, 60, 800, 1010]);
+    expect(K.stars).toEqual([560, 640, 720]);
+  });
+
+  it("the toggle's SFC carries no timing literal but the hover's (the score is v-bound)", () => {
+    const sfc = read("src/pencil/celestial/DarkModeToggle.vue");
+    const css = sfc
+      .slice(sfc.lastIndexOf("<style scoped>"))
+      .replace(/\/\*[\s\S]*?\*\//g, "");
+    const script = sfc
+      .slice(sfc.indexOf("<script"), sfc.indexOf("</script>"))
+      .replace(/\/\/.*$/gm, "");
+    // 0s is a step, not a timing; the one literal left is the hover's, which is no beat of the score
+    expect(css.match(/\b[1-9]\d*m?s\b/g) ?? []).toEqual(["200ms"]);
+    expect(script.match(/setTimeout\([^)]*?,\s*\d+\)/g) ?? []).toEqual([]);
+  });
+
+  it("every :hover in the toggle is fenced to a pointer that can hover (R6 law 14)", () => {
+    const css = read("src/pencil/celestial/DarkModeToggle.vue")
+      .replace(/\/\*[\s\S]*?\*\//g, "")
+      .split("<style scoped>")[1];
+    const fence = css.indexOf("@media (hover: hover)");
+    const hovers = [...css.matchAll(/:hover/g)].map((m) => m.index!);
+    expect(hovers.length).toBeGreaterThan(0);
+    for (const at of hovers) {
+      // inside the fence's block: after its opening, before the brace that closes it
+      const block = css.slice(fence, css.indexOf("\n}\n", fence));
+      expect(
+        fence >= 0 && at > fence && at < fence + block.length,
+        `:hover at ${at}`,
+      ).toBe(true);
+    }
+  });
+});
