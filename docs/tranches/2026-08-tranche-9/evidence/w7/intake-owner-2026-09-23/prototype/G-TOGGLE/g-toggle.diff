+describe("the storybook's derived numbers (T9-M21)", () => {
+  it("the dusk MOTION names is the dusk index.css runs", () => {
+    const rule = CSS.match(
+      /background-color (\d+)ms (ease)\b,\s*color \d+ms ease !important/,
+    );
+    expect(rule, "index.css dusk rule").not.toBeNull();
+    expect(Number(rule![1])).toBe(MOTION.rungs.dusk as number);
+    // CSS `ease` is cubic-bezier(0.25, 0.1, 0.25, 1) by definition.
+    expect(MOTION.dusk.curve).toBe("cubic-bezier(0.25, 0.1, 0.25, 1)");
+  });
+
+  it("MOTION.hinge is the grid's equal-contrast instant, both directions, within 1 ms", () => {
+    for (const dark of [true, false]) {
+      const grid = crossing("--grid-line-color", dark);
+      const frac = dark ? MOTION.hinge.toDark : MOTION.hinge.toLight;
+      expect(
+        Math.abs(frac * MOTION.rungs.dusk - grid),
+        `grid ${dark ? "→dark" : "→light"}`,
+      ).toBeLessThan(1);
+      // the digits (--color-foreground) cross within a millisecond of the grid
+      const digits = crossing("--color-foreground", dark);
+      expect(
+        Math.abs(digits - grid),
+        `digits ${dark ? "→dark" : "→light"}`,
+      ).toBeLessThan(1);
+    }
+  });
+
+  it("the ink at the hinge holds ≥ 3:1 against its paper (grid) and ≥ 4:1 (digits)", () => {
+    for (const dark of [true, false]) {
+      const [from] = dark ? ["light"] : ["dark"];
+      const t = crossing("--grid-line-color", dark);
+      const p0 = token("--color-card", from as "light" | "dark");
+      const p1 = token("--color-card", dark ? "dark" : "light");
+      const e = bezier(MOTION.dusk.curve)(t / MOTION.rungs.dusk);
+      const paper = p0.map((v, i) => v + (p1[i] - v) * e) as RGB;
+      expect(
