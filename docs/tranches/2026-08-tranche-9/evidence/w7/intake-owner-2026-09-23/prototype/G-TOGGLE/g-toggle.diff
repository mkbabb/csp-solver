+          `@property ${name} \\{\\s*syntax: "<time>";\\s*inherits: true;\\s*initial-value: 0ms;\\s*\\}`,
+        ),
+      );
+      expect(CSS).toMatch(new RegExp(`${name}: ${value}ms;`));
