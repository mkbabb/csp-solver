+import { describe, expect, it } from "vitest";
+import { MOTION, bezierCrestX, hingeMs, storybookScore } from "./pencilConfig";
+
+// T9-M21 · THE STORYBOOK'S NUMBERS ARE DERIVED, and this file is the derivation run again.
+// The hinge is read off index.css's own tokens and the dusk's own curve; the stars' delay off
+// springPop's own crest. A token retuned in index.css without MOTION following reds here.
+
+// Node's fs, reached untyped: the app tsconfig carries no node types, and vitest's CSS
+// pipeline answers `index.css?raw` with an empty string. vitest runs from web/frontend.
+const { readFileSync } = (await import(/* @vite-ignore */ `node:${"fs"}`)) as {
+  readFileSync(path: string, encoding: "utf8"): string;
+};
+const ROOT = (globalThis as unknown as { process: { cwd(): string } }).process.cwd();
+const read = (rel: string) => readFileSync(`${ROOT}/${rel}`, "utf8");
+const CSS = read("src/assets/index.css");
+
+type RGB = [number, number, number];
+function hsl(h: number, s: number, l: number): RGB {
+  s /= 100;
+  l /= 100;
+  const k = (n: number) => (n + h / 30) % 12;
+  const a = s * Math.min(l, 1 - l);
+  const f = (n: number) =>
+    l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
+  return [f(0), f(8), f(4)].map((x) => x * 255) as RGB;
+}
+const lum = (c: RGB) => {
+  const [r, g, b] = c.map((v) => {
+    v /= 255;
+    return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
+  });
+  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
+};
+const contrast = (a: RGB, b: RGB) => {
+  const [x, y] = [lum(a), lum(b)];
+  return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
+};
+/** y at x of a CSS cubic-bezier (bisection on x(s)). */
+function bezier(curve: string) {
+  const [x1, y1, x2, y2] = (curve.match(/-?[\d.]+/g) ?? []).map(Number);
+  const c = (s: number, p1: number, p2: number) =>
+    3 * (1 - s) ** 2 * s * p1 + 3 * (1 - s) * s * s * p2 + s ** 3;
+  return (x: number) => {
+    let lo = 0;
+    let hi = 1;
+    for (let i = 0; i < 60; i++) {
+      const m = (lo + hi) / 2;
+      if (c(m, x1, x2) < x) lo = m;
+      else hi = m;
+    }
+    return c((lo + hi) / 2, y1, y2);
+  };
+}
+
+/** A token's value in the light block (`@theme`, first declaration) or the `.dark` block. */
+function token(name: string, theme: "light" | "dark"): RGB {
+  const scope =
+    theme === "light"
+      ? CSS.slice(CSS.indexOf("@theme"))
+      : CSS.slice(CSS.indexOf("\n.dark {"));
+  const m = scope.match(
+    new RegExp(`${name}:\\s*hsl\\(([\\d.]+) ([\\d.]+)% ([\\d.]+)%\\)`),
+  );
+  if (!m) throw new Error(`index.css: ${name} (${theme}) is not an hsl() literal`);
+  return hsl(+m[1], +m[2], +m[3]);
+}
+
+/** ms after the flip at which old ink and new ink read equally on the dusking paper. */
+function crossing(ink: string, toDark: boolean): number {
+  const [from, to] = toDark
+    ? (["light", "dark"] as const)
+    : (["dark", "light"] as const);
+  const p0 = token("--color-card", from);
+  const p1 = token("--color-card", to);
+  const e = bezier(MOTION.dusk.curve);
+  const dusk = MOTION.rungs.dusk;
+  const paper = (t: number) => p0.map((v, i) => v + (p1[i] - v) * e(t / dusk)) as RGB;
+  const g = (t: number) =>
+    contrast(token(ink, from), paper(t)) - contrast(token(ink, to), paper(t));
+  let lo = 0;
+  let hi: number = dusk;
+  for (let i = 0; i < 60; i++) {
+    const m = (lo + hi) / 2;
+    if (g(m) > 0) lo = m;
+    else hi = m;
+  }
+  return lo;
+}
