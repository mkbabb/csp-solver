+// PASS 9 · THE ASK'S DIRTY SIGNAL IS PLAYER INK SINCE THE DEAL (CHAIR-RULINGS p9 §8; T9-M12).
+// Born RED: the panel read `undoDepth > 0`, which is 1 after a deal with no ink (row D1), so a
+// fine pointer was asked "fill in the whole board?" on a board nobody had written on.
+describe("inkSinceDeal — the destructive ask's signal", () => {
+  const deal = (h: ReturnType<typeof harness>, tag: string) =>
+    h.recordBoard(board("prev"), board(tag), emptyMarks(), emptyMarks(), "deal");
+  it("D1 a deal alone is not ink, though it is undo depth", () => {
+    const h = harness();
+    deal(h, "b1");
+    expect(h.undoDepth.value).toBe(1);
+    expect(h.inkSinceDeal.value).toBe(false);
+  });
+  it("D2 one player digit after the deal is ink; undoing it is not", () => {
+    const h = harness();
+    deal(h, "b1");
+    h.recordEdit(4, 0, 7);
+    expect(h.inkSinceDeal.value).toBe(true);
+    h.undo();
+    expect(h.inkSinceDeal.value).toBe(false);
+    h.redo();
+    expect(h.inkSinceDeal.value).toBe(true);
+  });
+  it("D3 a mark, a fill sweep and hint ink each count as ink", () => {
+    for (const write of [
+      (h: ReturnType<typeof harness>) =>
+        h.recordMark(2, { corner: { prev: [], next: [3] } }),
+      (h: ReturnType<typeof harness>) => h.recordBatch([{ pos: 1, prev: 0, next: 5 }]),
+      (h: ReturnType<typeof harness>) => h.recordHintInk(3, 0, 9),
+    ]) {
+      const h = harness();
+      deal(h, "b1");
+      write(h);
+      expect(h.inkSinceDeal.value).toBe(true);
+    }
+  });
+  it("D4 a new deal ends the epoch; a clear or a solve does not", () => {
+    const h = harness();
+    deal(h, "b1");
+    h.recordEdit(4, 0, 7);
+    h.recordBoard(board("b1"), board("blank"), emptyMarks(), emptyMarks(), "clear");
+    expect(h.inkSinceDeal.value).toBe(true);
+    h.recordBoard(board("blank"), board("solved"), emptyMarks(), emptyMarks(), "solve");
+    expect(h.inkSinceDeal.value).toBe(true);
+    deal(h, "b2");
+    expect(h.inkSinceDeal.value).toBe(false);
+    h.recordBoard(board("b2"), board("b3"), emptyMarks(), emptyMarks(), "resize");
+    h.recordEdit(0, 0, 1);
+    h.undo();
+    expect(h.inkSinceDeal.value).toBe(false);
+  });
+  it("D6 a resize is a deal: ink before it is not ink after it", () => {
+    const h = harness();
+    deal(h, "b1");
+    h.recordEdit(4, 0, 7);
+    h.recordBoard(board("b1"), board("b4x4"), emptyMarks(), emptyMarks(), "resize");
+    expect(h.inkSinceDeal.value).toBe(false);
+  });
+  it("D5 a log with no deal in it (the mount deal is off-log) reads its own writes", () => {
+    const h = harness();
+    expect(h.inkSinceDeal.value).toBe(false);
+    h.recordEdit(0, 0, 1);
+    expect(h.inkSinceDeal.value).toBe(true);
+  });
+});
