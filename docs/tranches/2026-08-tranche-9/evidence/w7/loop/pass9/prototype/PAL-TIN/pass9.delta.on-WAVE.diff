+    expect(tapeRing, `${arm}: the name's ink on the tape's flat paper`).toBeGreaterThanOrEqual(4.5);
+  }
+});
+
+// ── 2b · THE NAME ON THE TAPE, AND ITS TALLY, PAINTED ───────────────────────────────────────
+/** THE FLAT STATISTIC (the pass-5 critic's): the SPEC colour against the ground PAINTED under
+ *  every pixel the text changed — its minimum and its count under 4.5. The label photographed as
+ *  drawn, TWICE with its colour transparent (a pixel the two bare shots disagree on is a transient
+ *  ground and is dropped) and once more as drawn (the noise control); a Range over the text bounds
+ *  the clip. It reads what the ink COULD paint on this ground, which is the in-run negative's
+ *  statistic; what the glyphs DID paint is the chair's glyph-population probe below (§2b). */
+async function paintedName(page: Page, label: ReturnType<Page["locator"]>) {
+  const box = await label.evaluate((l) => {
+    const r = document.createRange();
+    r.selectNodeContents(l.firstChild!);
+    const b = r.getBoundingClientRect();
+    return { x: b.x, y: b.y, width: b.width, height: b.height };
+  });
+  const clip = { x: box.x - 1, y: box.y - 1, width: box.width + 2, height: box.height + 2 };
+  const ink = await rawOf(page, await page.screenshot({ clip }));
+  const spec = await label.evaluate((l) => getComputedStyle(l).color);
+  // a STYLESHEET, never a write into the Vue-owned label (LAWS P7 §F)
+  const off = await page.addStyleTag({ content: `${TAPE} { color: transparent !important; }` });
+  await expect.poll(() => label.evaluate((l) => getComputedStyle(l).color)).toBe("rgba(0, 0, 0, 0)");
+  const bare = await rawOf(page, await page.screenshot({ clip }));
+  const bare2 = await rawOf(page, await page.screenshot({ clip }));
+  await off.evaluate((e) => (e as Element).remove());
+  await expect.poll(() => label.evaluate((l) => getComputedStyle(l).color)).toBe(spec);
+  const again = await rawOf(page, await page.screenshot({ clip }));
+  const specRgb = await page.evaluate((css) => {
+    const c = document.createElement("canvas");
+    c.width = c.height = 1;
+    const g = c.getContext("2d", { willReadFrequently: true })!;
+    g.fillStyle = css;
+    g.fillRect(0, 0, 1, 1);
+    return Array.from(g.getImageData(0, 0, 1, 1).data.slice(0, 3));
+  }, spec);
+  const specL = lumAt(specRgb, 0);
+  const dist = (X: number[], Y: number[], k: number) =>
+    Math.abs(X[k] - Y[k]) + Math.abs(X[k + 1] - Y[k + 1]) + Math.abs(X[k + 2] - Y[k + 2]);
+  let top = 0;
+  let noise = 0;
+  const moved: number[] = [];
+  for (let k = 0; k < ink.data.length; k += 4) {
+    if (dist(ink.data, again.data, k) > 8 || dist(bare.data, bare2.data, k) > 8) {
+      noise++;
+      moved.push(0);
+      continue;
+    }
+    const d = dist(ink.data, bare.data, k);
+    moved.push(d);
+    top = Math.max(top, d);
+  }
+  const text: number[] = [];
+  moved.forEach((d, n) => {
+    if (d <= 0.2 * top) return;
+    text.push(ratio(specL, lumAt(bare.data, n * 4)));
+  });
+  // an EMPTY population is RED at the call site (worst = 0), never `Math.min()` of nothing
+  return {
+    spec,
+    textPx: text.length,
+    worst: text.length ? Math.min(...text) : 0,
+    under45: text.length ? text.filter((r) => r < 4.5).length : Infinity,
+    noise,
+  };
+}
+
+/** THE TALLY ON THE TAPE, PAINTED — the ring statistic on a stroke (§2.4 / §2.11): the tick
+ *  photographed ON, OFF (`visibility: hidden`), OFF again and ON again; a pixel either pair
+ *  disagrees on is dropped; the core is every pixel the tick moved at ≥ 50 % of the most-moved,
+ *  read as the painted pixel against the ground under it. */
+async function paintedTick(page: Page) {
+  const tick = page.locator(".attribution-tape .roster-tick");
+  const b = (await tick.boundingBox())!;
+  const clip = { x: Math.floor(b.x - 2), y: Math.floor(b.y - 2), width: Math.ceil(b.width + 4), height: Math.ceil(b.height + 4) };
+  const frames = () => page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+  const on = await rawOf(page, await page.screenshot({ clip }));
+  const hide = await page.addStyleTag({ content: ".attribution-tape .roster-tick { visibility: hidden !important; }" });
+  await frames();
+  const off = await rawOf(page, await page.screenshot({ clip }));
+  const off2 = await rawOf(page, await page.screenshot({ clip }));
+  await hide.evaluate((e) => (e as Element).remove());
+  await frames();
+  const on2 = await rawOf(page, await page.screenshot({ clip }));
+  const dist = (X: number[], Y: number[], k: number) =>
+    Math.abs(X[k] - Y[k]) + Math.abs(X[k + 1] - Y[k + 1]) + Math.abs(X[k + 2] - Y[k + 2]);
+  let top = 0;
+  const mv: [number, number][] = [];
+  for (let k = 0; k < on.data.length; k += 4) {
+    if (dist(on.data, on2.data, k) > 8 || dist(off.data, off2.data, k) > 8) continue;
+    const d = dist(on.data, off.data, k);
+    mv.push([d, k]);
+    top = Math.max(top, d);
+  }
+  const r = mv
+    .filter(([d]) => top > 0 && d >= 0.5 * top)
+    .map(([, k]) => ratio(lumAt(on.data, k), lumAt(off.data, k)))
+    .sort((u, v) => u - v);
+  return { top, n: r.length, med: r[r.length >> 1] ?? 0, p10: q(r, 0.1) ?? 0, under3: r.filter((v) => v < 3).length / Math.max(1, r.length) };
+}
+
+/** THE ESTATE'S ONE GLYPH-POPULATION PROBE at its PRODUCT HOME (`./lib/glyph-pop.mjs`, registry-v7
+ *  §2.4): the WHOLE glyph population clipped to the TEXT RUN (the tally's svg is never text), kept
+ *  only where two ON and two OFF photographs agree (the OFF-pair compare: a pixel that moved between
+ *  the OFF photographs of one pair is transient ground, never ink), G1 an empty or thin population
+ *  RED, G2 an ABSOLUTE core median, G3 the fraction under 4.5 bounded PER PAYLOAD (`glyphGate`: this
+ *  read's clean fraction + 0.05, never a pooled stamp), G4 columns scaled to the ink span, G5 per
+ *  glyph. This file carries no reader of its own. */
+type Pop = {
+  red: boolean;
+  why: string[];
+  population: number;
+  coreMedian: number;
+  fracUnder: number;
+  transientOn?: number;
+  transientOff?: number;
+};
+type Gate = { payload: string; bound: number | null; clean: Pop; plants: Record<string, Pop> };
+
+/** EVERY ID ON THE PAGE, PINNED (LAWS P7 §C): A the host (hand 0), four joiners, and B — the sixth
+ *  player, index 5, stick 1 on its second lap, so the tape carries a tick. The tape reads
+ *  "quickest-rodent" for B and A's own slug for A in every run and both engines. */
+const IDS = [
+  "p-0000000a0a0a",
+  "p-00000000c1c1",
+  "p-00000000c2c2",
+  "p-00000000c3c3",
+  "p-00000000c4c4",
+  "p-0000000b0b0b",
+] as const;
+const TAPE = ".attribution-tape .washi-label";
+/** THE AUTHORED ARM (LAWS P8 §E: a 'one publisher' row reads the AUTHORED value; the pass-8 critic's
+ *  §1.2): \`index.css\` as written, per arm, through the sheet's own \`var()\` chain — never
+ *  \`getComputedStyle\`, which resolves whatever the cascade ships (a \`.pcss\` re-declaration moved the
+ *  reference with the paint and every 'one publisher' row stayed GREEN). */
+const SHEET = readFileSync(fileURLToPath(new URL("../src/assets/index.css", import.meta.url)), "utf8").replace(/\/\*[\s\S]*?\*\//g, "");
+const authored = (ref: string, arm: "light" | "dark"): string => {
+  // \`ref\` is written as a consumer, \`var(--color-peer-N-name)\`: a token named in value position
+  const token = /^var\(\s*(--[\w-]+)\s*\)$/.exec(ref)?.[1] ?? ref;
+  const at = SHEET.indexOf("\n.dark");
+  const look = (t: string) => {
+    const re = new RegExp(`(?<![\\w-])${t}:\\s*([^;]+);`);
+    return (re.exec(arm === "dark" ? SHEET.slice(at) : SHEET.slice(0, at)) ?? (arm === "dark" ? re.exec(SHEET.slice(0, at)) : null))?.[1].trim() ?? null;
+  };
+  let v = look(token);
+  for (let d = 0; v && d < 5 && /^var\(/.test(v); d++) v = look(/^var\(\s*(--[\w-]+)\s*\)$/.exec(v)?.[1] ?? "--none");
+  if (!v || !/^#[0-9a-f]{6}$/i.test(v)) throw new Error(`index.css's ${arm} ${token} is not an authored hex (${v})`);
+  return `rgb(${[1, 3, 5].map((k) => parseInt(v!.slice(k, k + 2), 16)).join(", ")})`;
+};
+/** the name token the product BINDS on the tape (\`GameBoard\`'s anchor rebinds \`--color-user-ink\`); its
+ *  value is the authored arm above, never the cascade's */
+const tapeToken = (page: Page) =>
+  page.locator(".attribution-tape").evaluate((e) => (e as HTMLElement).style.getPropertyValue("--color-user-ink").trim());
+const nameIndex = (binding: string): number => {
+  const m = /^var\(\s*--color-peer-(\d+)-name\s*\)$/.exec(binding);
+  if (!m) throw new Error(`the tape binds --color-user-ink to ${binding || "nothing"}, not a name arm`);
+  return +m[1];
+};
+/** HEAD's ink for index i — `74a2b5d9`'s `inkFor`: hue i × 137.5°, chroma 0.11, band 0.5 / 0.8. The
+ *  ballot's control is THIS, the SAME INDEX (LAWS P7 §G, registry-v7 §2.13a); pass 7's control was
+ *  HEAD's best hue (i = 1, 137.5°), printed beside it so the chair holds both numbers. */
+const HEAD_INK = (i: number, arm: "light" | "dark"): string =>
+  `oklch(${arm === "light" ? 0.5 : 0.8} 0.11 ${((i * 137.5) % 360).toFixed(2)}deg)`;
+/** G2 on the hand's tag rung (LEDGER T9-R8): chromium at DPR 1, where this 600-weight face is
+ *  mostly anti-aliased edge and HEAD's same-index ink reads under 4.5 too. G2 is PRINTED there — and
+ *  only while HEAD's same-index ink also reads under 4.5 on the key (LAWS §E: 4.5 wherever the
+ *  control clears it); G1, G3, G4, G5 gate everywhere. */
+const G2_RUNG = new Set(["chromium/1"]);
+/** A plant PRINTED rather than required: WebKit paints an 80 % fill as no fade on this label (its
+ *  core reads ×0.97–1.00; PAL-WALK's reading, and this file's). Every other plant is required in
+ *  both engines — FADE65 included. */
+const printedPlant = (name: string, project: string): boolean => project === "webkit" && /^FADE80/.test(name);
+
