diff --git a/web/frontend/src/games/shared/boardRaster.test.ts b/web/frontend/src/games/shared/boardRaster.test.ts
new file mode 100644
index 00000000..b14dd8dd
--- /dev/null
+++ b/web/frontend/src/games/shared/boardRaster.test.ts
@@ -0,0 +1,35 @@
+import { describe, it, expect } from "vitest";
+import { SMALL_RASTER_DPX, boardRasterOf } from "./boardRaster";
+
+// The span key's unit row (T9-W7 ACC-GRAPHITE). The rigs are the band's own: each board width is
+// the one the five-rig read measured, so a change to the key that moves any rig shows here first.
+describe("boardRasterOf — keyed on device pixels, never on the pointer", () => {
+  it("marks the two phone boards small and leaves every 600+ board alone", () => {
+    expect(boardRasterOf(365, 1)).toBe("small"); // 393x699 phone
+    expect(boardRasterOf(347, 1)).toBe("small"); // 812x375 phone, landscape
+    expect(boardRasterOf(604, 1)).toBeUndefined(); // 1024x768 tablet, coarse at 1x
+    expect(boardRasterOf(636, 1)).toBeUndefined(); // 1280x800, fine or coarse
+    expect(boardRasterOf(668, 1)).toBeUndefined(); // 768x1024 tablet, coarse at 1x
+    expect(boardRasterOf(380, 1)).toBeUndefined(); // the first span the sweep read above the cliff
+  });
+
+  it("reads the device pixels: the same phone board at DPR 2 is not small", () => {
+    expect(boardRasterOf(365, 2)).toBeUndefined();
+    expect(boardRasterOf(180, 2)).toBe("small");
+  });
+
+  it("cuts at the bound exactly, on both sides of it", () => {
+    expect(SMALL_RASTER_DPX).toBe(375);
+    expect(boardRasterOf(SMALL_RASTER_DPX - 0.01, 1)).toBe("small");
+    expect(boardRasterOf(SMALL_RASTER_DPX, 1)).toBeUndefined();
+    expect(boardRasterOf(SMALL_RASTER_DPX / 2 - 0.01, 2)).toBe("small");
+    expect(boardRasterOf(SMALL_RASTER_DPX / 2, 2)).toBeUndefined();
+  });
+
+  it("never marks an unmeasured board, and treats a missing ratio as 1", () => {
+    expect(boardRasterOf(0, 1)).toBeUndefined();
+    expect(boardRasterOf(365, 0)).toBe("small");
+    expect(boardRasterOf(365, Number.NaN)).toBe("small");
+    expect(boardRasterOf(604, Number.NaN)).toBeUndefined();
+  });
+});
diff --git a/web/frontend/src/games/shared/boardRaster.ts b/web/frontend/src/games/shared/boardRaster.ts
