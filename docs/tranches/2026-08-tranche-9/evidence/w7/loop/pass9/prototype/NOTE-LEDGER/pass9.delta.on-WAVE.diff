+describe("GameBoard — a link that would not parse is said, and a re-deal still empties (share-truth)", () => {
+  /** BoardHost's `freshBoardCopy`, verbatim in shape: the sentence once, then "". */
+  const once = () => {
+    let pending = true;
+    return () => {
+      if (!pending) return "";
+      pending = false;
+      return "this shared link couldn't be read";
+    };
+  };
+  const hint = {
+    technique: "naked-single" as const,
+    cell: 0,
+    value: 4,
+    becauseCells: [0],
+  };
+
+  it("the first board's sentence survives the generation arm in the same flush", async () => {
+    const w = mountBoard({ dealt: true, freshBoardCopy: once() });
+    // the FIRST board: the givens 0→N and the generation bump land in one flush
+    await w.setProps({ givenCells: new Set(["5"]), boardGeneration: 2 });
+    await nextTick();
+    expect(margin(w)).toBe("this shared link couldn't be read");
+    w.unmount();
+  });
+
+  it("a re-deal (no 0→N) still empties line one", async () => {
+    const w = mountBoard({
+      dealt: true,
+      givenCells: new Set(["5"]),
+      values: { ...emptyValues(), "5": 3 },
+      // an ordinary deal's copy: "" (the link's sentence is spent on the first board)
+      freshBoardCopy: () => "",
+    });
+    await w.setProps({ hint });
+    await nextTick();
+    expect(margin(w)).toBe("only 4 fits here");
+    // the re-deal refills the same set inside one flush: the size never passes through 0
+    await w.setProps({ hint: null, givenCells: new Set(["6"]), boardGeneration: 2 });
+    await nextTick();
+    expect(margin(w), "the deal empties the live line").toBe("");
+    w.unmount();
+  });
+
+  it("the flush memory ends with its flush: a later re-deal is not silenced", async () => {
+    const w = mountBoard({ dealt: true, freshBoardCopy: once() });
+    await w.setProps({ givenCells: new Set(["5"]), boardGeneration: 2 });
+    await nextTick();
+    expect(margin(w)).toBe("this shared link couldn't be read");
+    await w.setProps({ givenCells: new Set(["6"]), boardGeneration: 3 });
+    await nextTick();
+    expect(margin(w), "the next deal reads the spent copy and empties").toBe("");
+    w.unmount();
+  });
+});
