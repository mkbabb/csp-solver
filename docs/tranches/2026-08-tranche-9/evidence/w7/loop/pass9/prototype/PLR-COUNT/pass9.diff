+// ── LOBBY_ARIA_ONLY's behavioural twin (SHAPE law iii; the pass-8 critic's gap 8) ─────────────
+// `check-font-coverage.mjs` drops `LOBBY_COPY.plus` from the painted corpus by name, on the claim
+// that its line reaches ONLY the mark's `:aria-label`. A source claim owes its twin on the page: at
+// six and at sixteen people, under the arm the source ships, no text on the page outside an
+// `aria-label` holds a `plus` line (every text node under <body>, every `title`, every ::before /
+// ::after `content`), and under arm (c) the mark's accessible name does. The plant paints the line
+// into the mark in the run, the shape a `{{ markName }}` paint would ship, and the row must SEE it.
+const PLUS = /plus:\s*\([^)]*\)\s*=>\s*`\$\{\w+\}([^`$]*)\$\{\w+\}`/.exec(
+  readFileSync(
+    fileURLToPath(new URL("../src/pencil/chrome/PlayerMark/copy.ts", import.meta.url)),
+    "utf8",
+  ),
+)![1];
+const PLUS_LINE = new RegExp(`\\d+${PLUS.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}\\d+`);
+/** Every string the page shows outside an accessible name. */
+const shown = (page: Page) =>
+  page.evaluate(() => {
+    const out: string[] = [];
+    const tw = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
+    for (let n = tw.nextNode(); n; n = tw.nextNode()) {
+      if (n.parentElement?.closest("script, style, template, noscript")) continue;
+      if (n.textContent?.trim()) out.push(n.textContent);
+    }
+    for (const el of document.body.querySelectorAll("*")) {
+      const t = el.getAttribute("title");
+      if (t) out.push(t);
+      for (const p of ["::before", "::after"]) {
+        const c = getComputedStyle(el, p).content;
+        if (c && c !== "none" && c !== "normal") out.push(c);
+      }
+    }
+    return out.join("\n");
+  });
+test("the `plus` line reaches only the mark's accessible name (LOBBY_ARIA_ONLY's twin)", async ({
+  page,
+}) => {
+  const room = `tally-plus-${Date.now()}`;
+  await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+  await settled(page);
+  const reads: { N: number; name: string | null; shown: string | null }[] = [];
+  for (const [k, N] of [
+    [5, 6],
+    [10, 16],
+  ] as const) {
+    await peers(page, room, k);
+    const name = await mark(page).getAttribute("aria-label");
+    reads.push({ N, name, shown: PLUS_LINE.exec(await shown(page))?.[0] ?? null });
+  }
+  await mark(page).evaluate((el, s) => {
+    const t = document.createElement("span");
+    t.textContent = s;
+    el.append(t);
+  }, `5${PLUS}11`);
+  const plantSeen = PLUS_LINE.exec(await shown(page))?.[0] ?? null;
+  console.log("PLUS", JSON.stringify({ engine: test.info().project.name, arm: SIX_ARM, PLUS, reads, plantSeen }));
+  expect(plantSeen, "the planted plus line is SEEN").toBe(`5${PLUS}11`);
+  for (const r of reads) {
+    expect(r.shown, `no shown text holds a plus line at ${r.N}`).toBeNull();
+    expect(PLUS_LINE.test(r.name ?? ""), `the name holds the plus line at ${r.N} under arm (c) only`).toBe(
+      SIX_ARM === "remainder",
+    );
+  }
+});
