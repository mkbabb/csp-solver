+/** G5one, the C5 sweep: EACH glyph of the line in turn striped 1 px whole / 2 px at 25 % (its own
+ *  box, read by a Range), one plant per glyph. Two thirds of a glyph's interior fade, so its
+ *  low-quantile core can fall where a p95 column, which keeps a whole stripe in three, does not;
+ *  one glyph is a few hundredths of a long line, under G3's slack. Which glyph only G5 sees is
+ *  geometry (the stripes' phase on the glyph's strokes), so every glyph is planted and the row
+ *  reads the set; it never picks the glyph by the clause that sees it. */
+const G5SWEEP = (page: Page, subject: string) =>
+  page.evaluate((subject) => {
+    const sub = document.querySelector(subject) as HTMLElement | null;
+    if (!sub) return [];
+    const eb = sub.getBoundingClientRect();
+    const out: string[] = [];
+    const tw = document.createTreeWalker(sub, NodeFilter.SHOW_TEXT);
+    for (let n = tw.nextNode(); n; n = tw.nextNode()) {
+      const s = n.textContent ?? "";
+      for (let i = 0; i < s.length; i++) {
+        if (!s[i].trim()) continue;
+        const r = document.createRange();
+        r.setStart(n, i);
+        r.setEnd(n, i + 1);
+        const g = r.getBoundingClientRect();
+        const c0 = (g.left - eb.left).toFixed(2),
+          c1 = (g.right - eb.left).toFixed(2);
+        const m =
+          `linear-gradient(to right, #000 ${c0}px, transparent ${c0}px, transparent ${c1}px, #000 ${c1}px), ` +
+          "repeating-linear-gradient(to right, #000 0 1px, rgba(0, 0, 0, 0.25) 1px 3px)";
