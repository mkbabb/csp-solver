+  const out = [];
+  const L = (i) => baseLine + lineAt(s, i) - 1;
+  const consts = constBindings(s);
+  const lit = (a) => {
+    const t = a.trim();
+    const q = /^(['"`])([^'"`$]*)\1$/.exec(t);
+    return q ? q[2] : foldConcat(t, consts);
+  };
