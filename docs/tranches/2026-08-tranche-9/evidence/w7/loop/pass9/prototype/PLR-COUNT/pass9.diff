+/** TAB-PEN C9: a token with two PLACED sites in one scope (same selector, same context) whose values
+ *  disagree resolves by walk order, not by the cascade the build ships: every such name. */
+export function tokenConflicts(all) {
+  if (!on("token-conflict")) return [];
+  const by = new Map();
+  for (const t of all) {
+    const k = `${t.prop}\u0000${(t.prelude ?? "").replace(/\s+/g, "")}\u0000${t.ctx ?? ""}`;
+    by.set(k, [...(by.get(k) ?? []), t]);
+  }
+  return [...by.values()]
+    .filter((ts) => new Set(ts.map((t) => t.value.trim())).size > 1)
