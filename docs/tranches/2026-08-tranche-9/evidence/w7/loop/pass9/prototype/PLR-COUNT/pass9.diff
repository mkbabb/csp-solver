+  expect(r18.want, JSON.stringify({ r16, r18 })).toBe(17);
+  expect(Math.abs(r16.mean - r16.want), JSON.stringify({ r16, r18 })).toBeLessThanOrEqual(1);
+  expect(Math.abs(r18.mean - r18.want), JSON.stringify({ r16, r18 })).toBeLessThanOrEqual(1);
