+ * at least 1px between them. The literal 15 at 18px sits about 2.7px short.
+ */
+test('the frame follows the ground\'s corner at an 18px root', async ({ page }) => {
+  await page.emulateMedia({ reducedMotion: 'reduce' });
+  await page.goto(SOLO);
+  await settled(page);
+  const read = () =>
+    lobby(page).evaluate((el) => {
+      const g = el.getBoundingClientRect();
+      const inset = (el.querySelector('.head-sheet-edge') as HTMLElement).offsetTop;
+      const pts: [number, number][] = [];
+      for (const p of el.querySelectorAll<SVGPathElement>('.head-sheet-edge path')) {
+        const m = p.getScreenCTM()!;
+        for (let s = 0, L = p.getTotalLength(); s <= L; s += 0.25) {
+          const q = p.getPointAtLength(s);
+          pts.push([m.a * q.x + m.c * q.y + m.e, m.b * q.x + m.d * q.y + m.f]);
+        }
+      }
+      const drawn = [
+        [g.left, g.top],
+        [g.right, g.top],
+        [g.right, g.bottom],
+        [g.left, g.bottom],
+      ].map(([cx, cy]) => {
+        const d = Math.min(...pts.map(([x, y]) => Math.hypot(x - cx, y - cy)));
+        return (d - inset * Math.SQRT2) / (Math.SQRT2 - 1);
+      });
