+// ── G16 · the written count's weight, ON PAINTED BYTES, per arm and per theme, EVERY count ─────
+// Ink weight, one normaliser for every crop compared, reduced motion so every stroke is inked, and
+// THE POSE PARKED: the boil beat swaps four grain poses under reduced motion too, and `one` read
+// ±4.5 % with the pose index (pass-6 critic), so every crop shows pose 0 only and the spread over
+// the four poses is printed beside it. A ground arm (the mark's ink hidden) must read no ink, so
+// nothing but the mark is in the crop.
+// KEYED ON `SIX_ARM`, and read at EVERY count the design names, 6 to 16 (LAWS P6 §E: pass 6 read
+// six alone, and arm (c)'s clause was false at six of the ten later steps):
+//   (a) title / (b) heading — the FLOOR: every written count out-weighs one graphite stroke.
+//       Plant: a rung the floor must see as lighter than one, at six AND at seven (the thinnest
+//       numeral: ×1.19 of one against six's ×1.41). In light that is the rung below title
+//       (heading); in dark the heading rung clears one stroke, so the dark plant is the body rung.
+//       Arm (b) is RED in light by design: that is its ballot price.
+//   (c) remainder — every count from six paints at least 6/5 of five strokes' ink. It does NOT
+//       promise the ink grows with the room: a written number is not monotone in its value, and
+//       the table printed here is the ballot's (ink and ink per person at every count). Plant: the
+//       remainder and its plus hidden, read at every count, must fall under the bar.
+const G16_PLANT = (theme: "light" | "dark"): string =>
+  SIX_ARM === "remainder"
+    ? ".pt-count.is-rest, .pt-plus { visibility: hidden !important; }"
+    : SIX_ARM === "title" && theme === "light"
+      ? ".pt-count { font-size: var(--type-heading) !important; }"
+      : ".pt-count { font-size: var(--type-body) !important; }";
+const parkPose = (k: number) =>
+  `.pt-marks > g.pt-pose { opacity: 0 !important; } .pt-marks > g.pt-pose:nth-of-type(${k}) { opacity: 1 !important; }`;
+for (const theme of ["light", "dark"] as const)
+  test.describe(`the written count's weight · ${theme}`, () => {
+    test.use({
+      viewport: { width: 1280, height: 800 },
+      deviceScaleFactor: 2,
+      colorScheme: theme,
+      contextOptions: { reducedMotion: "reduce" },
+    });
+    test(`every count from six against one and five, and the plant that breaks the promise (${SIX_ARM}, ${theme})`, async ({
+      page,
+    }) => {
+      test.setTimeout(240_000);
+      const room = `tally-ink-${theme}-${Date.now()}`;
+      // THE STROKE IS PINNED, not only the pose: `one` is this page's own stroke, seeded by its id
+      // over 97 poses, so an unpinned run draws a different `one` every time (pass-7 critic: 4.2
+      // ink units between ids). B's id and the peers' `tally-n` fix every stroke on the page.
+      await pinId(page, room);
+      await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+      await settled(page);
+      expect(
+        await page.evaluate(() => document.documentElement.classList.contains("dark")),
+      ).toBe(theme === "dark");
+      expect(await boundId(page, room), "the page is B").toBe(B_ID);
+      await page.mouse.move(640, 790);
+      const crop = async (css?: string) => {
+        const t = css ? await page.addStyleTag({ content: css }) : null;
+        await stable(() => mark(page).evaluate((e) => e.getBoundingClientRect().width));
+        const p = await painted(page, await mark(page).screenshot({ animations: "disabled" }));
+        if (t) await t.evaluate((e) => (e as HTMLElement).remove());
+        return p;
+      };
+      const oneAt: Painted[] = [];
+      for (const k of [1, 2, 3, 4]) oneAt.push(await crop(parkPose(k)));
+      const one = oneAt[0];
+      const park = await page.addStyleTag({ content: parkPose(1) });
+      const ground = await crop(".pt-marks, .pt-count { visibility: hidden !important; }");
+      await peers(page, room, 4);
+      const five = await crop();
+      const at: Record<number, Painted> = {};
+      const planted: Record<number, Painted> = {};
+      for (let N = 6; N <= 16; N++) {
+        await peers(page, room, 1);
+        at[N] = await crop();
+        planted[N] = await crop(G16_PLANT(theme));
+      }
+      await park.evaluate((t) => (t as HTMLElement).remove());
+      const all = [...oneAt, ground, five, ...Object.values(at), ...Object.values(planted)];
+      const D = Math.max(...all.map((p) => p.core));
+      const ink = (p: Painted) => inkOf(p.hist, D, 2);
+      const table = Object.fromEntries(
+        Object.keys(at).map((k) => {
+          const N = Number(k);
+          return [N, { ink: ink(at[N]), perPerson: +(ink(at[N]) / N).toFixed(2), planted: ink(planted[N]) }];
+        }),
+      ) as Record<number, { ink: number; perPerson: number; planted: number }>;
+      const falls = Object.keys(table)
+        .map(Number)
+        .filter((N) => N > 6 && table[N].ink < table[N - 1].ink)
+        .map((N) => `${N - 1}→${N}`);
+      const r = {
+        one: ink(one),
+        onePoses: oneAt.map(ink),
+        ground: ink(ground),
+        five: ink(five),
+        fivePerPerson: +(ink(five) / 5).toFixed(2),
+      };
+      // the plant's margin under its bar, at six and seven, printed (the row's thinnest reads)
+      const bar = SIX_ARM === "remainder" ? (6 / 5) * r.five : Math.min(...r.onePoses);
+      const margin = Object.fromEntries(
+        [6, 7].map((N) => [N, +(1 - table[N].planted / bar).toFixed(4)]),
+      );
+      console.log(
+        "G16",
+        JSON.stringify({
+          engine: test.info().project.name,
+          arm: SIX_ARM,
+          theme,
+          ids: `${B_ID} + tally-0…14`,
+          D,
+          ...r,
+          table,
+          falls,
+          margin,
+        }),
+      );
+      // THE CROP IS THE MARK: with its ink hidden it reads (nearly) nothing
+      expect(r.ground, "the ground arm reads no ink").toBeLessThan(0.02 * r.one);
+      for (let N = 6; N <= 16; N++) {
+        if (SIX_ARM === "remainder") {
+          const bar = (6 / 5) * r.five;
+          expect(table[N].ink, `${N} paints 6/5 of five`).toBeGreaterThanOrEqual(bar);
+          expect(table[N].planted, `${N} with the remainder hidden is SEEN under the bar`).toBeLessThan(bar);
+        } else {
+          // against one's HEAVIEST pose, so no pose of one is ever heavier than a written count
+          expect(table[N].ink, `${N} out-weighs one`).toBeGreaterThanOrEqual(Math.max(...r.onePoses));
+        }
+      }
+      if (SIX_ARM !== "remainder")
+        for (const N of [6, 7])
+          // against one's LIGHTEST pose: the plant is seen whatever pose one is drawn in
+          expect(table[N].planted, `the planted rung at ${N} is SEEN as lighter than one`).toBeLessThan(
+            Math.min(...r.onePoses),
+          );
+    });
