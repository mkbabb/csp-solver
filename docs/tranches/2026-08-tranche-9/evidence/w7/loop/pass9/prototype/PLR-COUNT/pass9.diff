+test('the head rule is a registered length whose publisher can be struck visibly', async ({
+  page,
+}) => {
+  await page.setViewportSize({ width: 1280, height: 800 });
+  await page.goto(SOLO);
+  await settled(page);
+
+  const read = () =>
+    page.evaluate(() => {
+      const root = document.querySelector('.page-root')!;
+      const corner = document.querySelector('.corner-left') as HTMLElement;
+      const probe = document.getElementById('plr-self-probe') as HTMLElement;
+      return {
+        token: getComputedStyle(root).getPropertyValue('--head-rule').trim(),
+        cornerTop: +corner.getBoundingClientRect().top.toFixed(2),
+        probeTop: +getComputedStyle(probe).top.replace('px', ''),
