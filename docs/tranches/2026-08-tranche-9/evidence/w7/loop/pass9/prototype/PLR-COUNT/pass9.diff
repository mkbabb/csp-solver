+export function stemMatches(name, names) {
+  const { head, tail } = stemParts(name);
+  return [...names].filter(
+    (k) =>
+      k.startsWith(head) &&
+      k.endsWith(tail) &&
+      k.length > head.length + tail.length - (on("stem-all") ? 0 : 1),
+  );
+}
