+/**
+ * The mark's two row shapes (T9-W7 §11). They live beside the components rather than inside
+ * them because `<script setup>` carries no exports, and App.vue reads the first one.
+ */
+
+/** A person at the table, as the head draws them. `ink` is `playerIdentity.inkFor`'s shape —
+ *  a `--color-user-ink` rebinding — or `{}` for the incumbent. */
+export interface MarkRow {
+  id: string;
+  name: string;
+  ink: Record<string, string>;
+  self: boolean;
+}
+
+/** One line of the sheet: a name in its own ink, and at most one qualifier after it
+ *  (`you`, or `26 seconds ago`). */
+export interface LobbyLine extends Omit<MarkRow, "self"> {
+  qualifier: string;
+}
diff --git a/web/frontend/src/pencil/composables/useTallyStrokes.ts b/web/frontend/src/pencil/composables/useTallyStrokes.ts
new file mode 100644
index 00000000..1d7d9c44
--- /dev/null
+++ b/web/frontend/src/pencil/composables/useTallyStrokes.ts
@@ -0,0 +1,188 @@
+/**
+ * THE TALLY STROKE, SHARED (T9-W7 PLR-COUNT §7.1) — extracted from `DifficultyTally.vue:84-183`
+ * the day a second surface started drawing the same object.
+ *
+ * One upright, in the house hand: `frameCount` grain-BAKED filterless pose siblings
+ * (`generateLineBoilFrames` + the grain-static preset, the T3-W13 grain-in-geometry
+ * discipline), opacity-swapped on the SHARED boil beat, with a stroke-dashoffset draw-in on
+ * the shared sequence chain. Zero live filters, so `filterBudget` is 9 by construction rather
+ * than by permission, and no caller enrolls a scheduler subscriber of its own.
+ *
+ * WHAT THE EXTRACTION IS NOT: a new geometry. Every number a caller passes reaches
+ * `generateLineBoilFrames` unchanged, so `DifficultyTally`'s four uprights and its binding
+ * diagonal serialize to the SAME `d` attributes they did before (the refactor's gate, G13 —
+ * 20 `d` values diffed against the HEAD control, not asserted). The two constants that were
+ * file-local — the perturbation and the stagger — are now `BOIL_CONFIG.tallyBoil` and
+ * `MOTION.tallyStaggerMs`, at their shipped values: a number two components share belongs in
+ * the config hub.
+ *
+ * A STROKE CARRIES ITS OWN KEY, and that is this pass's repair. Pass 2 kept the tweens in a
+ * `Map<number, …>` while the pose was keyed to the person: a departure and an arrival in ONE
+ * tick left the slot count unchanged, so the watch never fired and the newcomer inherited the
+ * departed person's reveal — a stroke drawn by nobody's hand. The key is the caller's
+ * identity (a person's id, a tally slot's ordinal), the map and the reveal are keyed by it,
+ * and nothing in here knows what the key means.
+ */
+import { computed, onUnmounted, reactive } from "vue";
+import {
+  createSequenceSubscription,
+  easeOutCubic,
+  heldFrameCount,
+  usePrefersReducedMotion,
+  type SequenceHandle,
+} from "@mkbabb/pencil-boil";
+import { generateLineBoilFrames } from "@pencil/grid/gridPaths";
+import {
+  BOIL_CONFIG,
+  DRAW_IN_PRESETS,
+  FILTER_PRESETS,
+  MOTION,
+  beatsFor,
+} from "@pencil/config/pencilConfig";
+import { useBeatFrame } from "@pencil/composables/boilBeat";
+
+export interface TallyStroke {
+  /** whose stroke this is — a person's id, or a slot's ordinal on a fixed tally */
+  key: string;
+  x1: number;
+  y1: number;
+  x2: number;
+  y2: number;
+  /** decorrelates this stroke's boil from its neighbours' — no two hands wobble together */
+  seed: number;
+}
+
+/** The wobble every tally stroke is drawn with, in one place so the two callers cannot drift. */
+const TALLY_WOBBLE = { roughness: 0.95, segments: 4, jagged: true } as const;
+
+const grainConfig = () => FILTER_PRESETS["grain-static"]?.grain;
+
+/** One stroke's pose stack — `frameCount` grain-baked variants of the same line. Not exported:
+ *  the two callers want either the whole stack (through `useTallyStrokes`) or pose 0, and an
+ *  export with no importer is a substrate nothing uses (knip, G18). */
+function tallyFrames(s: TallyStroke): string[] {
+  return generateLineBoilFrames(
+    s.x1,
+    s.y1,
+    s.x2,
+    s.y2,
+    { ...TALLY_WOBBLE, seed: s.seed },
+    BOIL_CONFIG.tallyBoil,
+    BOIL_CONFIG.frameCount,
+    grainConfig(),
+  );
+}
+
+/** Pose 0 of one stroke — the still form, for a surface with no beat inside it (the register's
+ *  rows sit in a popover; a sheet that breathes is a sheet that asks to be watched). */
+export const tallyPose0 = (s: TallyStroke): string => tallyFrames(s)[0];
+
+export function useTallyStrokes(strokes: () => TallyStroke[]) {
+  const strokeFrames = computed(() => strokes().map(tallyFrames));
+
+  /** poses[f] = every stroke at pose f — the sibling layers opacity-swap between these. */
+  const poses = computed<string[][]>(() => {
+    const fc = Math.max(2, Math.floor(BOIL_CONFIG.frameCount));
+    const out: string[][] = [];
+    for (let f = 0; f < fc; f++) {
+      out.push(strokeFrames.value.map((fr) => fr[f % fr.length]));
+    }
+    return out;
+  });
+
+  // The shared boil beat (one driver, ref-counted — enrolls no new scheduler subscriber).
+  // `heldFrameCount` collapses the count to 1 during an answer-key hold so the surface freezes
+  // IN PLACE rather than snapping to pose 0 (P1-W3's contract repair, inherited whole).
+  const boilFrame = useBeatFrame(
+    heldFrameCount(() => BOIL_CONFIG.frameCount),
+    () => beatsFor(BOIL_CONFIG.intervalMs),
+  );
+
+  /** reveal[key] ∈ [0,1] — that stroke's inked arc-length fraction, shared across its poses.
+   *  `pathLength=100` normalises the dash, so strokeDashoffset = 100·(1−reveal). */
+  const reveal = reactive<Record<string, number>>({});
+  const reducedMotion = usePrefersReducedMotion();
+  /**
+   * PER STROKE, NOT ONE LIST, and the distinction is a measured defect rather than taste. A
+   * flat list made `drawIn` a global cancel: two people arriving in two ticks ran
+   * `drawIn([a])` then `drawIn([b])`, the second stopped the first, and stroke a was left at
+   * `reveal = 0` — invisible, forever. Read off the live page at N=3 and N=6:
+   * `stroke-dashoffset` `["0","100","0"]` and `["0","100","0","100","100","0"]`. A tally is a
+   * SET: re-arming one member must not un-draw another.
+   */
+  const draws = new Map<string, SequenceHandle>();
+
+  function stop(): void {
+    for (const d of draws.values()) d.stop();
+    draws.clear();
+  }
+
+  /** These strokes are gone. Their tween stops with them and their reveal goes with it, so a
+   *  key that comes back later comes back un-drawn rather than inheriting a stranger's. */
+  function forget(keys: string[]): void {
+    for (const k of keys) {
+      draws.get(k)?.stop();
+      draws.delete(k);
+      delete reveal[k];
+    }
+  }
+
+  /**
+   * Land these strokes inked, no tween — an un-drawn stroke, or PRM, or a stranded reveal.
+   *
+   * NO TWEEN IS LIVE WHEN THIS RUNS, and that is the callers' contract, not this function's.
+   * `DifficultyTally` calls `stop()` first on every path; `PlayerMark` calls this only when
+   * reduced motion engages, and the sequence chain has already force-cleared every tween by
+   * then (it stops them and never finishes the value, which is why this exists). Pass 4 put a
+   * per-key `stop()` here as well; pass 5 struck it after reading it redundant: with the two
+   * lines gone the mid-draw PRM row stays green in both engines, and with the PRM watch gone
+   * it reds (the stroke strands at 39.5 / 46.9). Pass 3's settle-race came from a third caller,
+   * the survivor `settle` in the crossing watch, which pass 4 deleted.
+   */
+  function settle(keys: string[]): void {
+    for (const k of keys) reveal[k] = 1;
+  }
+
+  /** Tick these strokes in, one at a time, on the shared sequence chain. The stagger counts
+   *  POSITION IN THE CALL, so a lone arrival draws immediately and a full set still ticks. */
+  function drawIn(keys: string[]): void {
+    if (reducedMotion.value) {
+      settle(keys); // PRM: snap inked, no tween (the chain's own gate would no-op anyway)
+      return;
+    }
+    keys.forEach((k, pos) => {
+      draws.get(k)?.stop(); // only THIS stroke's own tween is replaced
+      draws.delete(k);
+      reveal[k] = 0;
+      const seq = createSequenceSubscription({
+        durationMs: DRAW_IN_PRESETS.glyph.duration,
+        delayMs: pos * MOTION.tallyStaggerMs,
+        easing: easeOutCubic,
+        onProgress: (eased) => {
+          reveal[k] = eased;
+        },
+        onComplete: () => {
+          reveal[k] = 1;
+          draws.delete(k);
+        },
+      });
+      seq.start();
+      draws.set(k, seq);
+    });
+  }
+
+  const dashOffset = (k: string): number => 100 * (1 - (reveal[k] ?? 1));
+
+  onUnmounted(stop);
+
+  return {
+    poses,
+    boilFrame,
+    reducedMotion,
+    drawIn,
+    settle,
+    forget,
+    stop,
+    dashOffset,
+  };
+}
