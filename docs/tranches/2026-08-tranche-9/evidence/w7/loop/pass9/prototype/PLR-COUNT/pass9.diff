+export function pinsBreached(sites: Site[], pins: Record<string, unknown>): Site[];
+
+// ── elements, regimes, lengths ──────────────────────────────────────────────────────────────────
+export function templateElements(tpl: string, baseLine?: number): TemplateElement[];
+export function mayMatch(
+  sel: string,
+  el: TemplateElement,
+  els: TemplateElement[],
+  o?: { outer?: (compound: string) => boolean },
+): boolean;
+export function elementSites(
+  fe: string,
+  o: TreeOptions & {
+    file: string;
+    pick: (el: TemplateElement) => boolean;
+    props: string[];
+    whitelist?: Record<string, string[]>;
+  },
+): {
