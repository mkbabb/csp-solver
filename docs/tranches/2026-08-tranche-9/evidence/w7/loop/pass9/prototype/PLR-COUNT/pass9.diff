diff --git a/web/frontend/e2e/player-mark.spec.ts b/web/frontend/e2e/player-mark.spec.ts
new file mode 100644
index 00000000..e73e819e
--- /dev/null
+++ b/web/frontend/e2e/player-mark.spec.ts
@@ -0,0 +1,1352 @@
+/**
+ * THE HEAD'S PLAYER MARK (T9-W7 §11 · §12 · M14) — the mark, its sheet, and the laws that are
+ * easy to lose.
+ *
+ * PRM: live, because every row here reads a SETTLED pose, never a frame inside a beat — the
+ * mark's one beat is a 400ms `color` transition and the sheet's is a 150ms fade, and each row
+ * that touches either polls until two reads agree before it asserts. The reduced arm is not this
+ * file's: `join-language-prm.spec.ts` reads this mark's transition under `reducedMotion: reduce`.
+ *
+ * O-12: LOCAL. CI is sixteen browserless lanes; this is an instrument, run by hand and by the
+ * wave's own battery, never by a runner.
+ *
+ *   1  your own mark is the colour the room paints you, and graphite when nobody else is here
+ *      (PLR-COUNT seat: the labels count everyone, `1 player` / `2 players` / `9 players`)
+ *   2  a mouse press opens the sheet without taking focus or telling the room you looked away;
+ *      Escape then shuts it and leaves the caret where it was; a focus move from the cell shuts it
+ *   3  Space and Enter each toggle once; Escape shuts it; focus never leaves the mark
+ *   4  the sheet never scrolls, and the sentence, the rows and `and N more` count one population
+ *   5  the head rule is registered and its absence is visible
+ *   6  Escape has one owner while the sheet is open
+ *   7  the row budget is keyed on the MEASURED space, on both axes, and read again at rest
+ *      when the space changes under an open sheet; the three more rows are added only where
+ *      they grow nothing over the board (no-growth), no width flips the pose while the board
+ *      slides, and the desk is read at rest on a tolerance
+ *   8  a tap opens the mark on a coarse phone in both engines, and is a look, not a look-away:
+ *      one toggle per tap however the tap's click is labelled, a tap on the sheet keeps the cell,
+ *      and the tap's debt ENDS: a click with no press after it toggles once; a press, a key and
+ *      a paid click each forgive it, each row with its own clause deleted in the run
+ *   9  both head disclosures PAINT a drawn edge on all four sides and no CSS border, in both
+ *      themes (the ONE four-band probe, `e2e/lib/edge-bands.mjs`); shut, they paint nothing at
+ *      all; the frame's corner is the ground's, read live at a larger root
+ *  10  the deck's swatch for you is the colour the room paints you (F1's fourth surface)
+ */
+import { test, expect, type Browser, type BrowserContext, type Page } from '@playwright/test';
+import { pressCommitted } from './committed-press';
+import * as edgeBands from './lib/edge-bands.mjs';
+import { EDGE_PLANTS, edgeGate, fmt } from './lib/edge-bands.mjs';
+
+const SOLO = './?size=3&difficulty=EASY&wire=local';
+
+async function settled(page: Page) {
+  await page.waitForSelector('svg.handwritten-logo', { timeout: 60000 });
+  await expect
+    .poll(() => page.locator('.sudoku-cell .glyph-svg').count(), { timeout: 60000 })
+    .toBeGreaterThan(0);
+  // ...and the deal at rest: its staggered `cell-reveal` still running reads a board with cells
+  // missing (1032×768: two cells under the sheet at 0.6s, three at 0.8s, on a loaded box).
+  await expect
+    .poll(
+      () =>
+        page.evaluate(
+          () =>
+            document
+              .getAnimations()
+              .filter((a) => (a as CSSAnimation).animationName === 'cell-reveal' && a.playState === 'running').length,
+        ),
+      { timeout: 30000 },
+    )
+    .toBe(0);
+}
+
+/** A pose is settled when two reads 150ms apart agree — the dock's slide, the sheet's fade and
+ *  the mark's ink each end on their own clock, and this waits for the clock, not a guess at it. */
+async function stable(read: () => Promise<unknown>) {
+  let last: unknown = Symbol('unread');
+  await expect
+    .poll(
+      async () => {
+        const v = JSON.stringify(await read());
+        const same = v === last;
+        last = v;
+        return same;
+      },
+      { intervals: [150], timeout: 8000 },
+    )
+    .toBe(true);
+}
+
+async function invite(page: Page): Promise<string> {
+  const verb = page.locator(
+    '.controls-card button[aria-label="Play together on this board"]',
+  );
+  await expect(verb).toBeEnabled();
+  const docked = !(await verb.isVisible());
+  if (docked) {
+    await page.locator('.drawer-tab').first().click();
+    // the dock SLIDES — its settled pose is the verb's own box holding still
+    await stable(() => verb.evaluate((e) => e.getBoundingClientRect().top));
+  }
+  await verb.click();
+  // The URL is stamped before the wire is listening; self's own row is the proof it is up.
+  await expect.poll(() => page.locator('.players-roster .player-row').count()).toBe(1);
+  if (docked) {
+    // Shut the door again: an open dock makes the board inert, and rows here play on it.
+    await page.locator('.drawer-tab').first().click();
+    await expect(page.locator('#controls-drawer .drawer-case')).toBeHidden();
+  }
+  return page.url();
+}
+
+/** `n` pretend peers say hello on the local wire, so the room holds `n + 1`. */
+async function crowd(page: Page, n: number, tag: string) {
+  await page.evaluate(
+    ({ n, tag }) => {
+      const room = new URL(location.href).searchParams.get('s')!;
+      const ch = new BroadcastChannel(`board:${room}`);
+      for (let i = 0; i < n; i++) ch.postMessage({ kind: 'hi', data: {}, from: `${tag}-${i}` });
+      setTimeout(() => ch.close(), 0);
+    },
+    { n, tag },
+  );
+  await expect
+    .poll(() => page.locator('.players-roster .player-row').count(), { timeout: 15000 })
+    .toBe(n + 1);
+}
+
+/** A page at one cell, its pointer regime WITNESSED rather than assumed. */
+async function cellPage(browser: Browser, width: number, height: number, coarse: boolean, url = SOLO) {
+  const ctx = await browser.newContext({ viewport: { width, height }, hasTouch: coarse });
+  const page = await ctx.newPage();
+  await page.goto(url);
+  await settled(page);
+  expect(await page.evaluate(() => matchMedia('(pointer: coarse)').matches)).toBe(coarse);
+  return { ctx, page };
+}
+
+const coarsePage = (browser: Browser, width: number, height: number) =>
+  cellPage(browser, width, height, true);
+
+const mark = (page: Page) => page.locator('[data-player-mark]:visible');
+const lobby = (page: Page) => page.locator('[data-lobby]:visible');
+/** Open means the SETTLED pose: the 150ms fade and scale-in done (opacity 1, no transform left),
+ *  and then the box holding still — a loaded box can freeze a page mid-scale long enough for two
+ *  reads to agree on a sheet still 0.9 of its size. */
+const openSheet = async (page: Page) => {
+  await expect(lobby(page)).toHaveClass(/is-open/);
+  await expect
+    .poll(() =>
+      lobby(page).evaluate((e) => {
+        const c = getComputedStyle(e);
+        return `${c.opacity} ${c.transform}`;
+      }),
+    )
+    .toMatch(/^1 (none|matrix\(1, 0, 0, 1, 0, 0\))$/);
+  await stable(() => lobby(page).evaluate((e) => JSON.stringify(e.getBoundingClientRect())));
+};
+const inCell = (page: Page) =>
+  page.evaluate(() => !!(document.activeElement as HTMLElement | null)?.closest('.sudoku-cell'));
+
+test('the mark rests graphite alone and takes the room ink the moment somebody else is here', async ({
+  browser,
+}) => {
+  const ctx: BrowserContext = await browser.newContext();
+  const a = await ctx.newPage();
+  await a.goto(SOLO);
+  await settled(a);
+
+  const alone = await mark(a).evaluate((el) => ({
+    live: el.classList.contains('is-live'),
+    label: el.getAttribute('aria-label'),
+    color: getComputedStyle(el).color,
+  }));
+  expect(alone.live).toBe(false);
+  expect(alone.label).toBe('1 player');
+  // ALONE, THE SHEET'S ONE ROW IS YOU IN THE MARK'S OWN INK — one person, one colour. On the
+  // tally seat (PLR-COUNT, re-aimed, declared) what paints you in the head is the STROKE, so the
+  // row's stub is held against the stroke's painted ink, not the button's `color`.
+  const soloStroke = await mark(a).evaluate(
+    (el) => getComputedStyle(el.querySelector('.pt-stroke')!).stroke,
+  );
+  await mark(a).click();
+  await openSheet(a);
+  const soloRow = await lobby(a).evaluate((el) => ({
+    rows: el.querySelectorAll('.pl-row').length,
+    stub: getComputedStyle(el.querySelector('.pl-row .pl-stub')!).color,
+  }));
+  expect(soloRow.rows).toBe(1);
+  expect(soloRow.stub).toBe(soloStroke);
+  await a.keyboard.press('Escape');
+  await expect(mark(a)).toHaveAttribute('aria-expanded', 'false');
+
+  const link = await invite(a);
+  const b = await ctx.newPage();
+  await b.goto(link);
+  await settled(b);
+  await a.bringToFront();
+  await expect.poll(() => a.locator('.players-roster .player-row').count()).toBe(2);
+  // past the 400ms presence ink: the colour holds still
+  await stable(() => mark(a).evaluate((el) => getComputedStyle(el).color));
+
+  const live = await mark(a).evaluate((el) => ({
+    live: el.classList.contains('is-live'),
+    label: el.getAttribute('aria-label'),
+    color: getComputedStyle(el).color,
+  }));
+  expect(live.live).toBe(true);
+  expect(live.label).toBe('2 players');
+  expect(live.color).not.toBe(alone.color);
+
+  // AND IT IS THE COLOUR THE ROOM PAINTS YOU (F1). What B draws for A is what A draws for A.
+  const aSlug = await a.evaluate(
+    () =>
+      document
+        .querySelector('.players-roster .player-row:has(.player-self) .player-name')
+        ?.textContent?.trim() ?? '',
+  );
+  const theirs = await b.evaluate((slug) => {
+    const li = [...document.querySelectorAll('.players-roster .player-row')].find(
+      (e) => e.querySelector('.player-name')?.textContent?.trim() === slug,
+    );
+    return li ? getComputedStyle(li.querySelector('.player-swatch')!).backgroundColor : '';
+  }, aSlug);
+  expect(theirs).toBe(live.color);
+  await ctx.close();
+});
+
+test('a mouse press opens the sheet, keeps the cell focused, and tells the room nothing', async ({
+  page,
+}) => {
+  await page.goto(SOLO);
+  await settled(page);
+  await invite(page);
+
+  await page.evaluate(() => {
+    const room = new URL(location.href).searchParams.get('s')!;
+    const w = window as unknown as Record<string, unknown>;
+    const seen: unknown[] = [];
+    w.__frames = seen;
+    const ch = new BroadcastChannel(`board:${room}`);
+    ch.onmessage = (e: MessageEvent) => seen.push(e.data);
+  });
+  const curs = () =>
+    page.evaluate(
+      () =>
+        ((window as any).__frames as { kind?: string }[]).filter((f) => f?.kind === 'cur').length,
+    );
+
+  // The listener hears the wire: the cell's own focus goes out as a `cur`, then the tally resets.
+  await page.locator('.sudoku-cell input').first().click();
+  await expect.poll(curs).toBeGreaterThan(0);
+  await page.evaluate(() => ((window as any).__frames as unknown[]).splice(0));
+
+  await mark(page).click();
+  await openSheet(page);
+  // sleep-ok: an ABSENCE has no event to poll — a look-away reaches the wire CUR_MS (120ms) after
+  // the cell lets go, so a 500ms window with nothing in it is the measurement, not a settle.
+  await page.waitForTimeout(500);
+  // Opening your own roster is not looking away from the board — the board is still under it.
+  expect(await curs()).toBe(0);
+  expect(await inCell(page)).toBe(true);
+});
+
+/**
+ * ESCAPE SHUTS THE SHEET AND MOVES NOTHING ELSE (PLR-COUNT pass 4, grafted back; pass-5 row 2).
+ * The pass-4 listener ended in `el.focus()`: a no-op after a keyboard open, and a THEFT after a
+ * mouse open, where the caret was in a cell (INPUT → BUTTON, both engines). And a mouse-opened
+ * sheet is left by a focus move that never started on the mark, so the mark's own `focusout`
+ * cannot hear it; the document `focusin` does. The negative controls are in the run: the
+ * keyboard arm (row 3) keeps focus ON the mark, and the mark's own `focusout` count is read
+ * across the leave and is zero.
+ */
+test('after a mouse open, Escape keeps the caret in the cell, and a focus move from the cell shuts the sheet', async ({
+  page,
+}) => {
+  await page.goto(SOLO);
+  await settled(page);
+  await invite(page);
+  const cells = page.locator('.sudoku-cell input');
+  await cells.first().click();
+  expect(await inCell(page)).toBe(true);
+
+  // THE ESCAPE ROW.
+  await mark(page).click();
+  await openSheet(page);
+  expect(await inCell(page)).toBe(true);
+  await page.keyboard.press('Escape');
+  await expect(mark(page)).toHaveAttribute('aria-expanded', 'false');
+  expect(await inCell(page)).toBe(true);
+  expect(await mark(page).evaluate((el) => el === document.activeElement)).toBe(false);
+
+  // THE LEAVE ROW. Open by mouse again, then move focus from the cell to another cell.
+  await mark(page).click();
+  await openSheet(page);
+  await mark(page).evaluate((el) => {
+    (window as any).__markOut = 0;
+    el.addEventListener('focusout', () => (window as any).__markOut++);
+  });
+  await page.evaluate(() => ((window as any).__before = document.activeElement));
+  await cells.nth(40).focus();
+  expect(await page.evaluate(() => document.activeElement !== (window as any).__before)).toBe(true);
+  await expect(mark(page)).toHaveAttribute('aria-expanded', 'false');
+  // The mark never held focus, so its own `focusout` never fired: only the document heard this.
+  expect(await page.evaluate(() => (window as any).__markOut)).toBe(0);
+});
+
+test('Space and Enter each toggle once, Escape shuts it, and focus never leaves the mark', async ({
+  page,
+}) => {
+  await page.goto(SOLO);
+  await settled(page);
+  await invite(page);
+  const m = mark(page);
+  await m.evaluate((el: HTMLElement) => el.focus());
+
+  // A double toggle nets zero inside ONE key event, so `true` never renders and a poll for it
+  // reds; a single toggle renders and the poll agrees.
+  const state = (expanded: string) =>
+    expect
+      .poll(() =>
+        m.evaluate((el) => ({
+          expanded: el.getAttribute('aria-expanded'),
+          focused: el === document.activeElement,
+        })),
+      )
+      .toEqual({ expanded, focused: true });
+  await state('false');
+  await page.keyboard.press('Space');
+  await state('true');
+  await page.keyboard.press('Space');
+  await state('false');
+  // ONE activation, not two: `@keydown.enter` beside a native button was a double-toggle that
+  // netted zero (CH-70). The handler is gone; the button's own activation is the contract.
+  await page.keyboard.press('Enter');
+  await state('true');
+  await page.keyboard.press('Escape');
+  await state('false');
+});
+
+test('the sheet never scrolls, and it compresses rather than outgrow its budget', async ({
+  page,
+}) => {
+  // A desk tall enough that four rows lap no cell, so the no-growth key keeps them (at 1280×800
+  // they would lap four cells where one row laps two, and the sheet draws one row there).
+  await page.setViewportSize({ width: 1280, height: 1100 });
+  await page.goto(SOLO);
+  await settled(page);
+  await invite(page);
+  await crowd(page, 8, 'mark-spec');
+  await mark(page).click();
+  await openSheet(page);
+  const sheet = await lobby(page).evaluate((el) => ({
+    rows: el.querySelectorAll('.pl-row').length,
+    more: el.querySelector('.pl-more')?.textContent?.trim() ?? '',
+    state: el.querySelector('.pl-state')?.textContent?.trim() ?? '',
+    scrolls: el.scrollHeight !== el.clientHeight,
+    width: +el.getBoundingClientRect().width.toFixed(1),
+  }));
+  // ONE POPULATION (registry-v4 §2.5): the state line, the mark's name, the rows and `and N more`
+  // count the same nine people, you first. 4 drawn + 5 more = 9. ONE REFERENT PER LINE (LAWS P6
+  // §E, PLR-COUNT): the name IS the state line; under the tally's arm (c) it goes on to read the
+  // mark as painted (`9 players, 5 plus 4`) and never borrows the sheet's `and N more`.
+  expect(sheet.state).toBe('9 players');
+  const rest = await mark(page).evaluate(
+    (el) => el.querySelector('.pt-count.is-rest')?.textContent?.trim() ?? null,
+  );
+  expect(await mark(page).getAttribute('aria-label')).toBe(
+    rest ? `${sheet.state}, 5 plus ${rest}` : sheet.state,
+  );
+  expect(sheet.rows).toBe(4);
+  expect(sheet.more).toBe('and 5 more');
+  expect(sheet.scrolls).toBe(false);
+  expect(sheet.width).toBe(256);
+});
+
+/**
+ * G18 — `--head-rule` IS REGISTERED, AND ITS ABSENCE IS VISIBLE (pass-4 gap 2).
+ *
+ * Pass 3 asserted the registration and called that a born-RED. It was not: with
+ * `initial-value: 12px` an unpublished token and a published one paint the same pixel, so the
+ * row passed with or without a publisher and the `env(safe-area-inset-top)` term could vanish
+ * unseen (PLR-SELF C4, both engines). The registration now carries `0px`, which is
+ * computationally independent AND fails where a reader can see it: strike the publisher and
+ * both head marks sit hard against the viewport's top edge.
+ *
+ * The negative control is in this same run, and it is the pass-3 form: a planted token
+ * registered at `12px` with the identical publisher, struck the identical way, which does not
+ * move. One run, two ablations, one of them proving the other can fail.
