+  if (!u1) hole = true;
+  rows.push(`POSTPAINT unit U1 key-inraf: kPaint ${kPaintOf(pp)} (rAF-time key ${kPaintByStamp(pp)}) ${u1 ? "OK" : "← a hole: the late entry drops a clean frame 1"}`);
+  // U2 stale: WebKit #5's shape — post k0 ran after frame 1's timeline update (ct 16, 96 px) beside inRAF k0 at ct 0
+  const post = [fr(0, 246, 16, 96, 263), fr(1, 263, 16, 96), fr(2, 280, 33, 198), fr(3, 295, 48, 288)];
+  const inRAF = [fr(0, 246, 0), fr(1, 263, 16, 96), fr(2, 280, 33, 198), fr(3, 295, 48, 288)];
+  const u2 = analyse(post, rest, { kPaint: 0, inRAF });
+  if (u2.red) hole = true;
+  rows.push(`POSTPAINT unit U2 stale: ${fmtArm(u2)} → ${u2.red ? "RED ← a hole: a stale post read is frame 1" : "GREEN"}`);
+  // U3 F1ct: frame 1 at rest by position, 16 ms into its clock
+  const u3 = analyse([fr(0, 246, 16), fr(1, 263, 32, 1), fr(2, 280, 48, 2)], rest, { kPaint: 0 });
+  if (!(u3.f1ct && !u3.f1pos)) hole = true;
+  rows.push(`POSTPAINT unit U3 F1ct: ${fmtArm(u3)} → ${u3.f1ct && !u3.f1pos ? "RED (ct only)" : "GREEN ← a hole"}`);
+  // U4 thresholds (LAWS P8 §F): F1ct at ctTol ± ε, F1 at tolPx ± ε
+  const at = (ct, dx) => analyse([fr(0, 0, ct, dx), fr(1, 16, 16 + ct, dx), fr(2, 32, 32 + ct, dx)], rest, { kPaint: 0 });
