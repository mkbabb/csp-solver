+// glyph-pop.d.mts — the TYPES of the ONE glyph-population probe (`./glyph-pop.mjs`), so a TypeScript spec
+// imports it under `typecheck:e2e` (strict, no `allowJs`). No behaviour lives here; every export is typed
+// with its option names (LAWS P8 §I: never `[k: string]: unknown`). PLR-COUNT's pass-8 hand-rolled copy
+// (`GlyphRead`, `GlyphPlant`) is folded in by name.
+// NOT-A-LANE: the chair's home (T9-W7 pass 9, homes v2).
+import type { Browser, Page } from "@playwright/test";
+
+/** One population read: `why` holds one entry per breached clause, each led by its id (G0 … G5). */
+export interface GlyphRead {
+  red: boolean;
+  why: string[];
+  population?: number;
+  coreMedian?: number;
+  fracUnder?: number;
+  columns?: number;
+  slicePop?: number;
+  slices?: (number | null)[];
+  glyphCores?: (number | null)[];
+  /** the G4 columns read low (labels `k` / `½k`), untolerated */
+  g4Lows?: string[];
+  /** the G4 columns the CONTROL's lows tolerated (`label:core`) */
+  g4Tolerated?: string[];
+  transientOn?: number;
+  transientOff?: number;
+  outsideRun?: number;
+  clip?: { x: number; y: number; width: number; height: number };
+  dpr?: number;
+}
+/** The probe's options. `tolerate` = the CONTROL's g4Lows (never this run's own). */
+export interface GlyphOptions {
+  subject: string;
+  off?: string | null;
+  floor?: number;
+  minPop?: number;
+  fracBound?: number | null;
+  delta?: number;
+  pad?: number;
+  slices?: number | "auto";
+  slicePop?: number | "auto";
+  sliceRatio?: number;
+  sliceQ?: number;
+  textRun?: boolean;
+  glyphWindows?: boolean;
+  runClip?: boolean;
+  /** G5: the quantile of the glyph's interior read (default 0.5) */
+  g5Q?: number;
+  tolerate?: string[] | null;
+}
+/** A plant: a CSS string, or a mask over the text run — `[a, b]` of the run (or glyph `glyph`'s box) at
+ *  25 %, striped (1 px at 25 % α) with `comb`. */
+export type GlyphPlant = string | { mask: [number, number]; comb?: boolean; glyph?: number | null };
+/** The control-anchored reference: the CONTROL's read of the same payload. */
+export type GlyphControl = Pick<GlyphRead, "fracUnder" | "g4Lows" | "population">;
+export interface GlyphGateOptions extends Omit<GlyphOptions, "fracBound"> {
+  payload: string;
+  plants?: Record<string, GlyphPlant> | null;
+  slack?: number;
+  img?: { ng: string; ink?: [number, number] } | null;
+  control?: GlyphControl | null;
+}
+export interface GlyphGate {
+  payload: string;
+  bound: number | null;
+  clean: GlyphRead;
+  plants: Record<string, GlyphRead>;
+}
+
+export const GLYPH_CLAUSES: readonly string[];
+export function autoSlices(span: number): number;
+export function glyphPopulation(page: Page, o: GlyphOptions): Promise<GlyphRead>;
+export function glyphGate(page: Page, o: GlyphGateOptions): Promise<GlyphGate>;
+/** G3's bound from a reference fraction, clamped below 1 at a reference ≥ 0.95. */
+export function boundOf(frac: number | null | undefined, slack?: number, pop?: number, minPop?: number): number | null;
+export function FILE_PLANTS(subject: string): Record<"OPA80F" | "COMB", string>;
+export function TEXT_PLANTS(subject: string): Record<string, GlyphPlant>;
+export function IMG_PLANTS(subject: string, ng: string, ink?: [number, number]): Record<string, string>;
+export function applyPlant(page: Page, subject: string, plant: GlyphPlant): Promise<() => Promise<void>>;
+export function applyTail(page: Page, subject: string, tail: number): Promise<unknown>;
+export function undoTail(page: Page, subject: string): Promise<void>;
+export function applyMask(
+  page: Page,
+  subject: string,
+  range: [number, number],
+  o?: { comb?: boolean; glyph?: number | null },
+): Promise<{ ok: boolean; run?: [number, number]; cut?: [number, number]; box?: number }>;
+export function undoMask(page: Page, subject: string): Promise<void>;
+export function selfTest(browser: Browser, o?: { dpr?: number }): Promise<{ rows: string[]; exit: number }>;
+export function fmt(r: GlyphRead): string;
