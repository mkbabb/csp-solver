+// ── G14 · the sheet's quiet rungs, PAINTED, on an opaque ground, ANCHORED TO THE CONTROL ────
+// The contrast half is the chair's ONE glyph-population probe at its product home
+// (`./lib/glyph-pop.mjs`, homes v2) in its CONTROL-ANCHORED mode (`glyphGate({ control })`).
+// Per cell and per quiet line, the SAME PAYLOAD is painted by the π control's own dist (`74a2b5d9`,
+// served at G14_CONTROL in the same run): the line's own text, at the line's own position, in the
+// tag rung's declarations (`TAG_RUNG`, the sheet's authored rung: the hand, the tag size, the quiet
+// ink) on the popover ground, every value a `var()` the CONTROL resolves. The control's read is
+// that payload's reference; a bound is never cut from this run's own clean read (pass 8's hole: a
+// whole-line fade shipped in the product was GREEN in every light cell).
+//   G1  a population under 40 px is RED (an empty or thin line)
+//   G2  the median ≥ 4.5, ABSOLUTE
+//   G3  the fraction under 4.5 ≤ the CONTROL's fraction + G14_SLACK, clamped below 1 (G3clamp)
+//   G4  columns, each core (p95) ≥ max(3.0, 0.4 × the line's p95); a column is tolerated only
+//       where the CONTROL holds the same column low (g4tol)
+//   G5  per glyph, the low quantile of its 4-neighbour interior (G5core) ≥ the same floor
+// ONE RULE PRINTS A WHOLE CLAUSE (G2 or G5), AND ONLY ONE: the control's own read of the same
+// payload fails it. G4 is never printed whole: the probe tolerates the control's low columns one by
+// one (g4tol), and G5's per-glyph twin is PROPOSED to the probe (`g5tol`, this lane's evidence dir).
+// A printed clause is the hand's tag rung failing (ledger row T9-R8: the control's failure is the
+// ceiling, never 4.5) and it is printed with its numbers; every other clause is the probe's
+// verdict as it stands. Nothing here re-scores a clause; the verdict is the probe's `why`, by id.
+// THE PAYLOAD IS PINNED: this page is `p-0000000b0b0b` (its tab binding, read back) and the fifteen
+// peers are `tally-0` … `tally-14`, so no id on the page is drawn at random (LAWS P6/P7 §C).
+// Every cell plants its negatives IN THE RUN, and every one must be SEEN by a clause the cell gates:
+// the probe's TEXT_PLANTS (FAINT30, FADE65, FADE80, TAIL12, TAIL35, HEAD12, MID20, COMB, EMPTY),
+// the pass-5 critic's head-kept fade X1b and dark's witnessed `.dark` form X2w. Beside them, G5one:
+// each glyph striped in turn, the set G5 alone sees read in the run (the clause-sabotage C5 bite).
+// The FILE plants (OPA80F, COMB, FADE80F written into `PlayerLobby.vue`) are the battery's and red
+// the CLEAN verdict, which is asserted first.
+const QUIET = [".pl-state", ".pl-qual", ".pl-more"] as const;
+type Quiet = (typeof QUIET)[number];
+/** The tag rung as the sheet authors it (`PlayerLobby.vue`), per line: the weight is the one
+ *  declaration the three lines do not share. Every value is a token the CONTROL resolves. */
+const TAG_RUNG = (q: Quiet) =>
+  `font-family:var(--font-hand);font-size:var(--type-tag);line-height:1.35;` +
+  `font-weight:${q === ".pl-state" ? 500 : 400};color:var(--ink-press-quiet)`;
+/** G3's slack over the control's fraction (the probe's default, stated): a line may hold at most
+ *  5 % more of its pixels under 4.5 than the control holds on the same payload. */
+const G14_SLACK = Number(process.env.G14_SLACK ?? 0.05);
+/** The served π control (LOCAL, O-12): the row cannot read without it, and says so. */
+const G14_CONTROL = process.env.G14_CONTROL ?? "";
+/** The clause-sabotage battery (LAWS P7 §F (ii)): `G14_DROP=G5` deletes that clause from the
+ *  verdict, and the row must then RED on the plant only that clause sees. */
+const G14_DROP = new Set((process.env.G14_DROP ?? "").split(",").filter(Boolean));
+/** The page's own id and its peers', pinned for every painted row (LAWS P7 §C). */
+const B_ID = "p-0000000b0b0b";
+const pinId = (page: Page, room: string) =>
+  page.addInitScript(
+    ([r, i]) => {
+      try {
+        sessionStorage.setItem("session-identity-v1", JSON.stringify({ [r]: i }));
+      } catch {
+        /* a page that cannot bind arrives as a stranger; the read-back below reds */
+      }
+    },
+    [room, B_ID],
+  );
+const boundId = (page: Page, room: string) =>
+  page.evaluate((r) => {
+    try {
+      return JSON.parse(sessionStorage.getItem("session-identity-v1") ?? "{}")[r] ?? null;
+    } catch {
+      return null;
+    }
+  }, room);
+const clauseOf = (w: string) => w.slice(0, 2);
+/** The whole clauses the CONTROL fails on the same payload: printed (T9-R8), never gated. G3 is
+ *  never in it (the control carries no bound), nor G1 (a control that paints nothing is no read),
+ *  nor G4 (tolerated column by column inside the probe). */
+const printedBy = (ctl: GlyphRead) =>
+  new Set(ctl.why.map(clauseOf).filter((c) => c === "G2" || c === "G5"));
+/** The reasons a read is RED on the clauses THIS cell and line gate (empty = it holds). */
+const gated = (r: GlyphRead, printed: Set<string>) =>
+  r.why.filter((w) => !printed.has(clauseOf(w)) && !G14_DROP.has(clauseOf(w)));
+const lines = (q: readonly Quiet[]) => q.map((s) => `html body [data-lobby] ${s}`).join(", ");
+const X1B =
+  lines(QUIET) +
