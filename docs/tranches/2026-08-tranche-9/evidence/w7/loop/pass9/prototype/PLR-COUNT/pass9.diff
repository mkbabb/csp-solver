index 00000000..7954eb7c
--- /dev/null
+++ b/web/frontend/src/pencil/chrome/PlayerMark/rowBudget.test.ts
@@ -0,0 +1,53 @@
+import { describe, expect, it } from "vitest";
+import { takesShort, type Box } from "./rowBudget";
+
+// The no-growth rule's bound is ZERO growth, strict. Each side of it is a row (LAWS P8 §F, the
+// threshold battery: the bound is read at +ε and −ε, ε = 1/64 px, the layout's own grain).
+const box = (left: number, top: number, w: number, h: number): Box => ({
+  left,
+  top,
+  right: left + w,
+  bottom: top + h,
+});
+const EPS = 1 / 64;
+// The desk's geometry (1280×800 fine, rounded): the sheets hang from the head at x 0..256.
+const short = box(0, 52, 256, 70);
+const tall = box(0, 52, 256, 163);
+
+describe("the row budget's one predicate (no growth)", () => {
+  it("keeps four rows when the tall sheet laps nothing, untried", () => {
+    expect(takesShort(tall, null, box(300, 0, 500, 500))).toBe(false);
+  });
+  it("reads the lap on both axes: a board below the sheet, or beside it, laps nothing", () => {
+    // x spans meet, y spans do not (the board starts below the tall sheet)
+    expect(takesShort(tall, null, box(0, 216, 500, 500))).toBe(false);
+    // y spans meet, x spans do not (the board starts right of the sheet)
+    expect(takesShort(tall, null, box(257, 0, 500, 500))).toBe(false);
+  });
+  // THE BOUND, BOTH SIDES: a board under your row whose bottom edge sits ε above the short
+  // sheet's bottom (the added rows lap none of it) and ε below it (they lap ε × 50 px² of it).
+  it("keeps four rows at −ε: the board ends ε inside your row", () => {
+    expect(takesShort(tall, short, box(10, 60, 50, short.bottom - 60 - EPS))).toBe(
+      false,
+    );
+  });
+  it("takes one row at +ε: the board runs ε under the added rows", () => {
+    expect(takesShort(tall, short, box(10, 60, 50, short.bottom - 60 + EPS))).toBe(
+      true,
+    );
+  });
+  it("reads both axes: a board ε right of the sheet laps nothing; ε left of its edge, it grows", () => {
+    expect(takesShort(tall, short, box(256 + EPS, 100, 500, 500))).toBe(false);
+    expect(takesShort(tall, short, box(256 - EPS, 130, 500, 500))).toBe(true);
+  });
+  it("takes one row at the desk, where four rows lap four cells and one row two", () => {
+    expect(takesShort(tall, short, box(130, 124.45, 552, 552))).toBe(true);
+  });
+  it("takes one row when the second read returns nothing (the declared direction)", () => {
+    expect(takesShort(tall, null, box(130, 124.45, 552, 552))).toBe(true);
+  });
+  it("keeps four rows when the board is under your row as much as under all four", () => {
+    // a board entirely inside the short sheet's box: the added rows add nothing over it
+    expect(takesShort(tall, short, box(10, 60, 50, 50))).toBe(false);
+  });
+});
diff --git a/web/frontend/src/pencil/chrome/PlayerMark/rowBudget.ts b/web/frontend/src/pencil/chrome/PlayerMark/rowBudget.ts
