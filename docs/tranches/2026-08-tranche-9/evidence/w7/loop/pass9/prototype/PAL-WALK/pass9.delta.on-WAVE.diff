+test("§B the ring, photographed — the line the product actually draws", async ({ page }, info) => {
+  await page.goto(SOLO);
+  await settled(page);
+  // THE BOIL PARKS AT IDLE, and until it does the two photographs differ everywhere the grid is.
+  // One wait, once, before any of them — not a per-shot sleep.
+  await page.waitForTimeout(2500);
+  const dpr = await page.evaluate(() => window.devicePixelRatio);
+  // The hands the CORE MEDIAN finds hardest over all 144 at the chair's pair (the pass-5 sweep):
+  // light i=6 / 95 (3.133), dark i=86 / 89 / 5 (3.341–3.348) — five per arm, both arms.
+  //
+  // THE ROW'S SCOPE, SAID: five hands per arm on every run; `WALK_SWEEP=1` photographs all 144
+  // (≈10 min an engine per density) and is how the five are re-chosen — pass 5 ran it at dpr
+  // 1/2/3: `evidence/w7/loop/pass5/prototype/PAL-WALK/`.
+  const HANDS = [5, 6, 86, 89, 95];
+  for (const arm of ["light", "dark"] as const) {
+    await theme(page, arm);
+    const shipped = await page.evaluate(() =>
+      getComputedStyle(document.documentElement).getPropertyValue("--peer-ring-l").trim(),
+    );
+    const sweep = !!process.env.WALK_SWEEP;
+    for (const i of sweep ? Array.from({ length: 144 }, (_, k) => k) : HANDS) {
+      const p = await paintedRing(page, i);
+      const c = p.core;
+      console.log(
+        `[${info.project.name}/${arm}] dpr ${dpr} band ${shipped} i=${i}: ` +
+          `isTheRing ${p.isTheRing} (Δ to computed ${p.deltaToComputed.toFixed(1)}) · ` +
+          `CORE px ${c.px} max ${c.max.toFixed(3)} p30 ${c.p30.toFixed(3)} median ${c.median.toFixed(3)} ` +
+          `frac<3 ${(c.under3 * 100).toFixed(1)}% noise ${c.noise} · scan core ${p.ratio.toFixed(3)} · ` +
+          `sensitivity ${p.sensitivity} · ${p.where}`,
+      );
+      expect(p.isTheRing, `the sampler found the ring, ${arm} i=${i}`).toBe(true);
+      expect(c.median, `painted ring core median, ${arm} i=${i}, dpr ${dpr}`).toBeGreaterThanOrEqual(
+        CORE_FLOOR,
+      );
+    }
+    // THE EDGE, through the ONE four-band probe (LAWS P7 §E (ii), P8 §E, the probe's defaults —
+    // no parameter chosen here): per band, the ring's core against the ring OFF (B2), its painted
+    // depth against the RING floor 2 × 0.9 css px (B3, the per-band thickness clause), no holes
+    // (B4), no side thin among thick ones (B6). The 1 px ring and a faded stroke are planted IN
+    // THIS RUN and each must RED. The hand is the arm's hardest by core median (pass-5 sweep).
+    {
+      const hand = arm === "light" ? 6 : 86;
+      const edge = ".game-cell.is-peer-cursor .cell-ghost-path";
+      const P = EDGE_PLANTS(edge);
+      await seatCursor(page, hand);
+      // The subject IS the ring's path: it sits 8 css px inside the cell's box (a cell-box strip
+      // of 8 px misses the left side whole), so the bands are cut around the line itself.
+      const r = await edgeGate(page, {
+        subject: edge,
+        edge,
+        plants: { THIN_1PX: P.THIN_1PX, STROKE_OPACITY015: P.STROKE_OPACITY015 },
+      });
+      await seatCursor(page, null);
+      const tag = `[${info.project.name}/${arm}] dpr ${dpr} EDGE i=${hand}`;
+      console.log(`${tag} clean ${r.clean.red ? "RED" : "GREEN"} ${edgeFmt(r.clean)}`);
+      for (const [k, v] of Object.entries(r.plants))
+        console.log(`${tag} plant ${k} ${v.red ? "RED" : "GREEN (a hole)"} ${edgeFmt(v)}`);
+      expect(r.clean.why, `the ring's four bands, ${arm} i=${hand}, dpr ${dpr}`).toEqual([]);
+      for (const [k, v] of Object.entries(r.plants))
+        expect(v.red, `edge plant ${k} RED, ${arm} i=${hand}, dpr ${dpr}`).toBe(true);
+    }
+  }
+  await page.evaluate(() => document.documentElement.classList.remove("dark"));
+});
+
+/**
+ * §C · THE NAME ON THE TAPE, PAINTED — read by the estate's ONE glyph-population probe
+ * (`./lib/glyph-pop.mjs`, registry-v7 §2.4). This spec carried its own copy of the probe through
+ * pass 7; the copy POOLED its G3 bound over both payloads, and the pooled bound is what let a
+ * WebKit 65 % fill fade read green (0.271 against 0.279, where the per-read bound is 0.259). The
+ * copy is deleted: every clause below is the probe's, bounded PER READ (`glyphGate`).
+ *
+ * The probe photographs the label ON and with its text made transparent, twice each, keeps only
+ * the pixels stable across both pairs and inside the TEXT RUN (text nodes only), and reads each as
+ * its painted pixel against its own painted ground (grid line, digit, tape paper and all):
+ *   G1  the population is ≥ 40 px (an empty or thin name is RED);
+ *   G2  the population's median ≥ 4.5 — ABSOLUTE. The one exemption is NAMED, not derived:
+ *       chromium at DPR 1 paints a 13 px hand's whole population under 4.5 on every arm read
+ *       (this tree, HEAD's same-index ink, the pass-6 ring string alike), which is the estate's
+ *       tag-rung row LEDGER T9-R8 — there G2 is PRINTED and cited, and every other clause holds;
+ *   G3  the fraction under 4.5 ≤ this read's own clean fraction + 0.05 (per read, never pooled);
+ *   G4  every x-column's p95 ≥ max(3.0, 0.4 × the whole p95), the column count scaled to the ink,
+ *       read aligned and half-shifted; G5 the same per character.
+ * And B-TAPE's clause: the name's median never loses to HEAD's SAME-INDEX ink (`oklch(0.5|0.8 0.11
+ * i × 137.5°)`, LAWS P7 §G) painted on the same label, paper and cell.
+ *
+ * TWO SUBJECTS (registry-v7 §2.13d): B's name read on A's page (index 1), and A's name — the
+ * HOST's, hand 0, the name every joiner reads — on B's page. Every id on both pages is PINNED
+ * (LAWS P7 §C), so each name is one word per payload in both engines.
+ */
+
+type Pop = {
+  red: boolean;
+  why: string[];
+  population: number;
+  coreMedian: number;
+  fracUnder: number;
+};
+type Gate = { bound: number | null; clean: Pop; plants: Record<string, Pop> };
+
+const TAPE = ".attribution-tape .washi-label";
+/** B's pinned ids (two payloads: a 15-letter name and a 25-letter one) and A's, the host's. */
+const NAME_IDS = ["p-0000000b0b0b", "p-00000000002e"];
+const A_ID = "p-0000000a0a0a";
+/** HEAD's ink for index i (`74a2b5d9`'s `inkFor`: hue i × 137.5°, chroma 0.11, band 0.5 / 0.8). */
+const HEAD_INK = (i: number, arm: "light" | "dark"): string =>
+  `oklch(${arm === "light" ? 0.5 : 0.8} 0.11 ${((i * 137.5) % 360).toFixed(2)}deg)`;
+/** G2's named rung cells (LEDGER T9-R8): engine/DPR. */
+const G2_RUNG = new Set(["chromium/1"]);
+const FILL = (ink: string, p: number): string =>
+  `${TAPE} { -webkit-text-fill-color: color-mix(in srgb, ${ink} ${p}%, transparent) !important; }`;
+/** THE PLANTS, each required RED: the probe's own set (FAINT30, FADE65, FADE80 on the fill; TAIL12,
+ *  TAIL35, HEAD12, MID20 as run masks at 25 %; EMPTY) plus the fades keyed on the name's own var
+ *  (`color` stays green either way). WEBKIT PAINTS AN 80 % FILL AS NO FADE on this label (its core
+ *  reads ×0.97–1.00 in both readers): FADE80 and its twin are PRINTED in WebKit. FADE65 is REQUIRED
+ *  in WebKit at DPR 2 (registry-v7 §2.13h — the per-read bound reds it there) and at DPR 1 (pass 8:
+ *  RED 8/8 on G3 per read), planted at EVERY cell of BOTH payloads (pass 9); DPR 3 prints it. PAPER
+ *  (the washi back to translucent) is printed: the occlusion arm, which no clause reads. */
+const PLANTS = (): Record<string, string | { mask: [number, number] }> => ({
+  ...TEXT_PLANTS(TAPE),
+  FAINT30v_fill: FILL("var(--color-peer-name-ink)", 30),
+  FADE65v_fill: FILL("var(--color-peer-name-ink)", 65),
+  FADE80v_fill: FILL("var(--color-peer-name-ink)", 80),
+  PAPER: `${TAPE} { background: var(--sheet-washi-neutral) !important; }`,
+});
+const printedPlant = (name: string, project: string, dpr: string): boolean =>
+  name === "PAPER" ||
+  (project === "webkit" && (/^FADE80/.test(name) || (/^FADE65/.test(name) && dpr === "3")));
+
+test("§C the name on the tape is written in its own string, and reads 4.5 on the ground it is painted on", async ({
+  browser,
+}, info) => {
+  for (const [n, id] of NAME_IDS.entries()) await nameOnTape(browser, id, info.project.name, n === 0);
+});
+
+async function nameOnTape(
+  browser: import("@playwright/test").Browser,
+  bId: string,
+  project: string,
+  planted: boolean,
+): Promise<void> {
+  // Two pages in ONE context, so `?wire=local`'s BroadcastChannel is the room — the product's own
+  // invite flow. FROZEN AT THE TEST (emulateMedia before goto): a boil between the photographs is a
+  // second variable; the tape, its paper and the name are not motion-gated.
+  const context = await browser.newContext();
+  const a = await context.newPage();
+  await a.emulateMedia({ reducedMotion: "reduce" });
+  await a.addInitScript((id) => {
+    // THE HOST'S PER-TAB IDENTITY MAP ANSWERS FOR THE ROOM THE ADDRESS BAR NAMES: the invite
+    // writes \`?s=\` synchronously before the page claims its id, so the claim reads this pin
+    // for the room it just opened and stays the room's author (its epoch, its hand 0).
+    const get = Storage.prototype.getItem;
+    Storage.prototype.getItem = function (k: string) {
+      const room = new URL(location.href).searchParams.get("s");
+      if (this === sessionStorage && k === "session-identity-v1" && room)
+        return JSON.stringify({ ...JSON.parse(get.call(this, k) || "{}"), [room]: id });
+      return get.call(this, k);
+    };
+  }, A_ID);
+  await a.goto(SOLO);
+  await settled(a);
+  const verb = a.locator('.controls-card button[aria-label="Play together on this board"]');
+  await expect(verb).toBeEnabled();
+  await verb.click();
+  await expect.poll(() => new URL(a.url()).searchParams.get("s")).not.toBeNull();
+  const room = new URL(a.url()).searchParams.get("s")!;
+  const b = await context.newPage();
+  await b.emulateMedia({ reducedMotion: "reduce" });
+  await b.addInitScript(
+    ([r, id]) => sessionStorage.setItem("session-identity-v1", JSON.stringify({ [r]: id })),
+    [room, bId] as const,
+  );
+  await b.goto(a.url());
+  await settled(b);
+  const inputs = (p: Page) => p.locator(".sudoku-cell input");
+  const board = (p: Page) =>
+    p.evaluate(() =>
+      [...document.querySelectorAll(".sudoku-cell input")]
+        .map((i) => (i as HTMLInputElement).value || ".")
+        .join(""),
+    );
+  expect(await board(a), "the encoded board decoded on A").toBe(GIVENS);
+  expect(await board(b), "the encoded board decoded on B").toBe(GIVENS);
+  const empty = [...GIVENS].flatMap((ch, i) => (ch === "." ? [i] : []));
+  const givenAbove = empty.filter((i) => i >= 9 && GIVENS[i - 9] !== ".");
+  const top = empty.filter((i) => i < 9);
+  // B writes three cells with a given above and the top row's one empty cell (pass 7's four); A
+  // (the host) writes the next two given-above cells. The deal has ONE empty top-row cell, so the
+  // flip below is read on B's subject only.
+  const cellsB = [...givenAbove.slice(0, 3), top[0]];
+  const cellsA = givenAbove.slice(3, 5);
+  expect(top.length, "the deal's empty top-row cells").toBe(1);
+  const write = async (p: Page, q: Page, cells: number[]) => {
+    await p.bringToFront();
+    for (const x of cells) {
+      await inputs(p).nth(x).click();
+      await inputs(p).nth(x).fill("7");
+      await expect.poll(() => inputs(q).nth(x).inputValue()).toBe("7");
+    }
+  };
+  await write(b, a, cellsB);
+  await write(a, b, cellsA);
+  // both cursors parked on a given, off every subject cell
+  await inputs(b).nth(GIVENS.indexOf("3")).click({ force: true });
+  await inputs(a).nth(GIVENS.indexOf("9")).click({ force: true });
+  await a.waitForTimeout(2500); // sleep-ok: the boil parks before a byte is read
+  const dpr = String(await a.evaluate(() => devicePixelRatio));
+  console.log(`[${project}/dpr${dpr}] room ${room}: A ${A_ID}, B ${bId}; B wrote ${cellsB.join(",")}, A wrote ${cellsA.join(",")}`);
+  const aSlug = await a.evaluate(async (id) => {
+    const served = "/src/games/shared/playerIdentity.ts";
+    const m = (await import(/* @vite-ignore */ served)) as {
+      slugFor: (p: string, t: ReadonlySet<string>) => string;
+    };
+    return m.slugFor(id, new Set());
+  }, A_ID);
+  for (const [page, cells, index, who] of [
+    [a, cellsB, 1, `B ${bId}`],
+    [b, cellsA, 0, `A ${A_ID} (hand 0, the host) on B's page`],
+  ] as const) {
+    // THE READ PAGE IS BROUGHT FORWARD: a page behind another in its context gets no rendering
+    // update, and every photograph below waits on two of them.
+    await page.bringToFront();
+    const label = page.locator(TAPE);
+    const hover = async (x: number) => {
+      // Re-made until the tape mounts: under load WebKit can drop the first pointer move.
+      await expect(async () => {
+        await page.mouse.move(2, 2);
+        await page.locator(".game-cell").nth(x).hover();
+        await expect(label).toBeVisible({ timeout: 3000 });
+      }).toPass({ timeout: 30000 });
+    };
+    const withCss = async (css: string, read: () => Promise<Pop>): Promise<Pop> => {
+      const tag = await page.addStyleTag({ content: css });
+      await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+      const t = await read();
+      await tag.evaluate((e) => (e as Element).remove());
+      await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+      return t;
+    };
+    const pop = async (): Promise<Pop> => (await glyphPopulation(page, { subject: TAPE })) as Pop;
+    for (const arm of ["light", "dark"] as const) {
+      await theme(page, arm);
+      for (const x of cells) {
+        await hover(x);
+        // The name string the cascade hands the tape, resolved OUTSIDE the product's DOM (LAWS P7
+        // §F: an e2e row never writes into a Vue-owned node): the token and its band read off the
+        // tape's own computed style, painted on a probe in <body>.
+        const own = await label.evaluate((l) => {
+          const cs = getComputedStyle(l);
+          const raw = cs.getPropertyValue("--color-peer-name-ink").trim();
+          const band = cs.getPropertyValue("--peer-name-l").trim();
+          const probe = document.createElement("span");
+          probe.style.color = raw.replace(/var\(\s*--peer-name-l\s*\)/g, band);
+          document.body.appendChild(probe);
+          const c = getComputedStyle(probe).color;
+          probe.remove();
+          return c;
+        });
+        const spec = await label.evaluate((l) => getComputedStyle(l).color);
+        const text = (await label.textContent())?.trim() ?? "";
+        const at = `[${project}/${arm}/dpr${dpr}] ${who} cell ${x}${x < 9 ? " (top row, below)" : " (given above)"} "${text}"`;
+        // The whole plant set on the first payload's first and last cell; FADE65 (the probe's and
+        // the name-var twin) at EVERY cell of BOTH payloads — the thinnest pass-8 margin sat at a
+        // cell that spec never planted (`…002e` cell 12, WebKit DPR 2, 0.001).
+        const full = planted && (x === cells[0] || x === cells[cells.length - 1]);
+        const P = PLANTS();
+        const g = (await glyphGate(page, {
+          subject: TAPE,
+          payload: `${who}/${arm}/cell${x}`,
+          plants: full ? P : { FADE65_fill: P.FADE65_fill, FADE65v_fill: P.FADE65v_fill },
+        })) as Gate;
+        const head = await withCss(`${TAPE} { color: ${HEAD_INK(index, arm)} !important; }`, pop);
+        const ring = await withCss(`${TAPE} { color: var(--color-peer-cursor-ink) !important; }`, pop);
+        const rung = G2_RUNG.has(`${project}/${dpr}`);
+        // ONE verdict for the clean read AND every plant: on the rung G2 is printed for both, so a
+        // plant never reds on the clause the clean read is already excused from (a plant red only
+        // by G2 at the rung would be a gate that cannot fail).
+        const verdict = (r: Pop): string[] => r.why.filter((w) => !(rung && /^G2/.test(w)));
+        const why = verdict(g.clean);
+        console.log(
+          `${at} name ${spec} · bound ${g.bound?.toFixed(3)} · ${popFmt(g.clean)}${rung && why.length !== g.clean.why.length ? " · G2 PRINTED (rung T9-R8)" : ""}\n` +
+            `${at} HEAD same-index ${HEAD_INK(index, arm)} · ${popFmt(head)}\n` +
+            `${at} ring string (pass 6) · ${popFmt(ring)}\n` +
+            `${at} B-TAPE name − HEAD = ${(g.clean.coreMedian - head.coreMedian).toFixed(3)}`,
+        );
+        expect(spec, "the tape writes the name string").toBe(own);
+        if (index === 0) expect(text, "the host's pinned name").toBe(aSlug);
+        expect.soft(why, `the name, ${who}, ${arm} cell ${x}`).toEqual([]);
+        expect
+          .soft(g.clean.coreMedian, `B-TAPE: the name against HEAD's same-index ink, ${who}, ${arm} cell ${x}`)
+          .toBeGreaterThanOrEqual(head.coreMedian);
+        for (const [name, r] of Object.entries(g.plants)) {
+          const required = !printedPlant(name, project, dpr);
+          console.log(
+            `${at} ${required ? "PLANT" : "READING"} ${name} · ${popFmt(r)} · median ×${(r.coreMedian / g.clean.coreMedian).toFixed(3)} · G3 margin ${g.bound === null ? "—" : (r.fracUnder - g.bound).toFixed(3)} → ${verdict(r).length ? `RED ${verdict(r).map((w) => w.split(" ")[0]).join("+")}` : required ? "GREEN (a hole)" : "GREEN"}`,
+          );
+          if (required) expect.soft(verdict(r).length, `plant ${name} reds the gate, ${who}, ${arm} cell ${x}`).toBeGreaterThan(0);
+        }
+        await page.mouse.move(2, 2);
+        await expect(label).toHaveCount(0);
+      }
+    }
+  }
+  await context.close();
+}
