+/** The `RING_GEOMETRY` comment, and its figure table `N×N  head +a  graft +b`. */
+function ringFigures(src: string) {
+  const at = src.indexOf("/** THE RING'S GEOMETRY");
+  const text = src.slice(at, src.indexOf("*/", at));
+  const rows = [...text.matchAll(/(\d+×\d+)\s+head \+(\d+\.\d+)\s+graft \+(\d+\.\d+)/g)].map((m) => ({
+    board: m[1],
+    head: +m[2],
+    graft: +m[3],
+  }));
+  let prose = text;
+  for (const m of text.matchAll(/(\d+×\d+)\s+head \+(\d+\.\d+)\s+graft \+(\d+\.\d+)/g)) prose = prose.replace(m[0], " ");
+  for (const a of [/T9-B29/g, /U-10/g, /74a2b5d9/g, /\b\d+×\d+\b/g, /roughness 0\.4/g, /\b2 segments\b/g, /\b4 below\b/g, /pinned at 4\b/g, /stroke 10\b/g, /G-LIVE-22/g, /T9-W7/g])
+    prose = prose.replace(a, " ");
+  return { rows, unguarded: [...prose.matchAll(/\d+(?:[.,]\d+)*/g)].map((m) => m[0]) };
+}
