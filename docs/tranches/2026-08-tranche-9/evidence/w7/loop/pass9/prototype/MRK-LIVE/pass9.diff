+  const posed = async (cell: number, label: string, theme: string) => {
+    // by class: an svg `<image>` on this tree, a masked `<div>` beside the svg on the WAVE union
+    const bake = ".board-shell .boil-frame-bitmap";
+    const n = await page.evaluate((s) => document.querySelectorAll(s).length, bake);
+    if (n !== BOIL_CONFIG.frameCount) fails.push(`${theme} ${label}: the grid carries ${n} baked poses, not ${BOIL_CONFIG.frameCount}`);
+    await focusCell(cell);
+    for (let k = 0; k < n; k++) {
+      const hold = await page.addStyleTag({
+        content: `${bake} { opacity: 0 !important; } ${bake}:nth-of-type(${k + 1}) { opacity: 1 !important; }`,
+      });
+      await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+      judge(theme, await read("[data-gl23]", T2, 8, 16, `${label} @pose${k}`));
+      await hold.evaluate((e) => (e as HTMLElement).remove());
+    }
+  };
+  const tier2 = async (cell: number, label: string): Promise<Row> => {
+    await focusCell(cell);
+    return read("[data-gl23]", T2, 8, 16, label);
+  };
+  const focusCell = async (cell: number) => {
+    await page.locator(".board-shell .game-cell .cell-native-input").nth(cell).focus();
+    await page.keyboard.press("Shift");
+    await expect.poll(() => page.evaluate(() => document.querySelectorAll(".game-cell:has(input:focus-visible)").length)).toBe(1);
+    await docSettled(page);
+    await page.evaluate((cell) => {
+      document.querySelectorAll("[data-gl23]").forEach((e) => e.removeAttribute("data-gl23"));
+      document.querySelectorAll(".board-shell .game-cell")[cell].setAttribute("data-gl23", "");
+    }, cell);
+  };
+  /** The verdict is the PROBE's (its `why`); an admitted side forgives only its own B2 line, and only
+   *  at or above its floor. B1/B3/B4 are never forgiven. */
+  const verdict = (r: Row, admittedAs: string, theme: string) => {
+    const adm = G23_ADMITTED[admittedAs];
+    const floors: Floors = adm?.floors[`${engine}/${theme}`] ?? {};
+    if (!r.bands) return { ok: false, stale: [] as string[], say: `${r.key}: ${r.why.join("; ")}` };
+    const kept = r.why.filter((w) => {
+      const m = /^B2 (\w+) core median ([\d.]+)/.exec(w);
+      const f = m ? floors[m[1] as Side] : undefined;
+      return !m || f == null || +m[2] < f;
+    });
+    // THE COUNT (the frame cells): the stations under 3:1 on all four bands, held at the shipped count.
+    const cap = adm?.regimeCounts?.[`${regime}:${engine}/${theme}`] ?? adm?.counts?.[`${engine}/${theme}`];
+    const n = (Object.values(r.bands) as Band[]).reduce((a, b) => a + under(b), 0);
+    if (cap != null && n > cap) kept.push(`COUNT ${n} stations under 3:1 > the admitted ${cap}`);
+    const staleSides: string[] = (Object.keys(floors) as Side[]).filter((s) => r.bands![s].coreMedian >= 3);
+    // THE CAP IS PINNED AT ITS BOUNDARY (pass 9, LAWS P8 §F): the shipped read sits ON the cap
+    // (margin 0); a read under it means the admission is loose by the margin and must be cut to it.
+    if (cap != null && n < cap) staleSides.push(`count ${n} < the admitted ${cap} (loose by ${cap - n})`);
+    return {
+      ok: kept.length === 0,
+      stale: staleSides,
+      say: `${r.key}: ${brief(r)}${Object.keys(floors).length ? ` [admitted ${JSON.stringify(floors)}]` : ""}${kept.length ? ` ⟨${kept.join("; ")}⟩` : ""}`,
+    };
+  };
+  const judge = (theme: string, r: Row | null) => {
+    if (!r) return null;
+    const v = verdict(r, r.key, theme);
+    log(`${v.ok ? "ok " : "RED"} ${theme} ${v.say}`);
+    if (!v.ok) fails.push(`${theme} ${v.say}`);
+    if (v.stale.length) stale.push(`${theme} ${r.key} ${v.stale.join("/")}`);
+    return v;
+  };
+  /** A plant must red the read it is laid on; a GREEN read under a plant is a hole in this row. */
+  const planted = async (theme: string, name: string, plant: unknown, edgeSel: string, on: string | number, as = "", only = "") => {
+    // FOCUS FIRST, THEN PLANT, THEN READ WITHOUT RE-FOCUSING: the probe's `{ fade }` plant is keyed on
+    // the edge's own elements, and a re-focus re-mounts the drawn ring (a fresh node, no key), so a
+    // plant laid before the focus voids itself and reads GREEN (measured: FADE15 4.188 on both engines).
+    const f = typeof on === "string" ? await focusKey(on) : (await focusCell(on), null);
+    if (typeof on === "string" && !f) {
+      fails.push(`${theme} PLANT ${name}: ${on} not reached`);
+      return;
+    }
+    const undo = await edge.applyEdgePlant(page, edgeSel, plant);
+    await docSettled(page);
+    const r = f ? await readKey(f, as || (on as string)) : await read("[data-gl23]", T2, 8, 16, as || `tier 2 on cell ${on}`);
+    await undo();
+    await docSettled(page);
+    const green = !!r && verdict(r, as, theme).ok;
+    log(`PLANT ${theme} ${name}: ${r ? brief(r) : "not reached"} → ${green ? "GREEN (a hole)" : "RED"}${only && r ? ` by ⟨${r.why.join("; ")}⟩` : ""}`);
+    if (green) fails.push(`${theme} PLANT ${name} left its read GREEN: this row cannot see it`);
+    // AN ISOLATING PLANT (pass 9, gap 5): it must red through its own clause and no other, so that
+    // switching that clause off (EDGE_SABOTAGE) turns it GREEN and the battery sees the deletion.
+    const stray = only && r ? r.why.filter((w) => !w.startsWith(`${only} `)) : [];
+    if (only && r && !green && stray.length) fails.push(`${theme} PLANT ${name} is not confined to ${only}: it reds by ${stray.join("; ")}`);
+  };
+  /** EVERY home stop the walk reaches, judged (pass 9: the first-clean pick is struck; it skipped a
+   *  red stop before the first clean one). `quiet` judges into the returned list only: a sibling
+   *  plant's read, never the row's own verdict. */
+  const everyStop = async (w: ReturnType<typeof g23Walk>, theme: string, quiet = false) => {
+    const reds: string[] = [];
+    const reached: string[] = [];
+    for (const key of await w.keys()) {
+      const r = await chrome(key);
+      if (!r) continue;
+      reached.push(key);
+      if (quiet) {
+        const v = verdict(r, r.key, theme);
+        log(`SIBLING ${v.ok ? "ok " : "RED"} ${theme} ${v.say}`);
+        if (!v.ok) reds.push(key);
+      } else if (!judge(theme, r)!.ok) reds.push(key);
+    }
+    return { reds, reached };
+  };
+  /** The home half of the shipped floor: each named key reached, or a RED by name. Under a coarse
+   *  pointer the shipped set is one key shorter by design: `button.info-btn` is `display: none`
+   *  outside `(hover: hover) and (pointer: fine)` (GameControlPanel.vue's info-btn rule), and a key
+   *  the regime does not ship is never owed. A key reached that the regime should not ship reds too. */
+  const homeFloor = (theme: string, reached: string[], notShipped: string[] = []) => {
+    for (const k of G23_HOME.filter((x) => !notShipped.includes(x)))
+      if (!reached.includes(k)) fails.push(`${theme}: the walk did not reach the shipped stop ${k}`);
+    for (const k of notShipped) if (reached.includes(k)) fails.push(`${theme}: the walk reached ${k}, which this regime does not ship`);
+    log(`${theme}: home stops reached ${reached.length}: ${reached.join(", ")}${notShipped.length ? ` · not shipped here: ${notShipped.join(", ")}` : ""}`);
+  };
+  /** THE SIBLING (the pass-8 critic's MORE2S/COARSE2S): the ring at 0.15 on ONE stop, under the
+   *  regime's own query, laid on a stop the dist ships. The every-stop read must red that stop, and
+   *  only it. */
+  const sibling = async (w: ReturnType<typeof g23Walk>, theme: string, mq: string, key = SIBLING_STOP) => {
+    const t = await page.addStyleTag({ content: `@media ${mq} { html:has(${key}:focus-visible) .focus-ring { opacity: 0.15 !important; } }` });
+    const { reds } = await everyStop(w, theme, true);
+    await t.evaluate((e) => (e as HTMLElement).remove());
+    await docSettled(page);
+    const name = `SIB ${mq} the ring at 0.15 on ${key} alone`;
+    log(`PLANT ${theme} ${name}: every-stop reds at ${reds.join(", ") || "none"} → ${reds.includes(key) ? "RED" : "GREEN (a hole)"}`);
+    if (!reds.includes(key)) fails.push(`${theme} PLANT ${name} left the every-stop read GREEN: this row cannot see it`);
+    const off = reds.filter((r) => r !== key);
+    if (off.length) fails.push(`${theme} PLANT ${name} redded stops it was not laid on: ${off.join(", ")}`);
+  };
+  const armGuard = async () => {
+    const blank = await page.evaluate(() => [...document.querySelectorAll(".board-shell .game-cell")].findIndex((c) => !c.querySelector(".glyph-svg")));
+    expect(blank, "an empty cell to write in").toBeGreaterThanOrEqual(0);
+    await page.locator(".board-shell .game-cell .cell-native-input").nth(blank).focus();
+    await page.keyboard.press("1");
+    await expect.poll(() => page.evaluate((i) => !!document.querySelectorAll(".board-shell .game-cell")[i].querySelector(".glyph-svg"), blank)).toBe(true);
+    await page.locator("button.logo-trigger").focus();
+    await page.keyboard.press("Enter");
+    await expect(page.locator(".staging-band")).toBeVisible({ timeout: 20000 });
+    await docSettled(page);
+    // The deck's own deal verb, `d` on the scrollport one step off the mounted game (G-LIVE-21's
+    // gesture): focusing `.staging-deal` and pressing Enter raced the staging band's settle outside
+    // `reduce` and twice this pass dealt with no ribbon (the board, not the guard, on screen).
+    const vp = page.locator(".gallery-viewport");
+    await vp.focus();
+    await vp.press("ArrowRight");
+    await docSettled(page);
+    await vp.press("d");
+    await expect(page.locator(".gallery-guard"), "the armed guard (a dirty board, a deal)").toBeVisible({ timeout: 10000 });
+    await docSettled(page);
+  };
+  /** THE WALK, WHOLE, in one theme: every home stop key, tier 2 on cell 40 and on the frame cells
+   *  (9×9 and 16×16 cell 0), the deck's card and staging face, the armed guard. */
+  const walkWhole = async (w: ReturnType<typeof g23Walk>, theme: "light" | "dark", onDeck?: () => Promise<void>) => {
+    await w.board(theme);
+    const reached: string[] = [...(await everyStop(w, theme)).reached];
+    judge(theme, await tier2(40, "tier 2 on 9×9 cell 40"));
+    judge(theme, await tier2(0, "tier 2 on 9×9 cell 0"));
+    await w.board(theme, 4);
+    if (regime === "reduce") judge(theme, await tier2(0, "tier 2 on 16×16 cell 0"));
+    else await posed(0, "tier 2 on 16×16 cell 0", theme);
+    await page.goto(`./?view=gallery&size=3&board=${mintSudoku(3)}`);
+    await expect(page.locator(".staging-band")).toBeVisible({ timeout: 30000 });
+    await w.setTheme(theme);
+    for (const key of await w.keys())
+      if (/gallery-viewport|staging-btn/.test(key)) {
+        const r = await chrome(key, `deck ${key}`);
+        if (r) reached.push(`deck ${key}`);
+        judge(theme, r);
+      }
+    if (onDeck) await onDeck();
+    await w.board(theme);
+    await armGuard();
+    for (const key of await w.keys())
+      if (/guard-btn/.test(key)) {
+        const r = await chrome(key, `guard ${key}`);
+        if (r) reached.push(`guard ${key}`);
+        judge(theme, r);
+      }
+    const beyond = reached.filter((k) => !G23_SHIPPED.includes(k));
+    log(`${theme}: ${reached.length} stop keys reached: ${reached.join(", ")} · the shipped set ${G23_SHIPPED.filter((k) => reached.includes(k)).length}/${G23_SHIPPED.length}${beyond.length ? ` · beyond it (judged, not counted): ${beyond.join(", ")}` : ""}`);
+    for (const must of G23_SHIPPED) if (!reached.includes(must)) fails.push(`${theme}: the walk did not reach the shipped stop ${must}`);
+  };
+  /** A regime plant, proven IN FORCE (the ring's computed opacity) before its reads count. */
+  const regimeLive = async (mq: string, key: string) => {
+    const t = await page.addStyleTag({ content: G23_REGIME_PLANT(mq) });
+    await chrome(key);
+    const live = await page.evaluate(() => {
+      const r = document.querySelector(".focus-ring");
+      return r ? getComputedStyle(r).opacity : null;
+    });
+    await t.evaluate((e) => (e as HTMLElement).remove());
+    log(`${mq} plant live: ring opacity ${live}`);
+    if (live !== "0.15") fails.push(`the ${mq} plant is not in force (ring opacity ${live}): it proves nothing`);
+  };
+  const finish = () => {
+    expect(fails, `every side of every ring reads 3:1 or better, 2 css px deep, with no holes (or its admitted floor), and every plant reds\n${lines.join("\n")}`).toEqual([]);
+    expect(stale, "STALE: an admitted side now clears 3:1; strike its admission").toEqual([]);
+  };
+  const P = (sel: string) => edge.EDGE_PLANTS(sel) as Record<string, unknown>;
+  return { log, chrome, tier2, judge, planted, everyStop, homeFloor, sibling, walkWhole, regimeLive, finish, P, verdict, brief };
+}
