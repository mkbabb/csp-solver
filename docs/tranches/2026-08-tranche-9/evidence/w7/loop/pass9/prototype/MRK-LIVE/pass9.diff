+import { test, expect, type Page } from "@playwright/test";
+import { mkdirSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { wobbleRect } from "@mkbabb/pencil-boil";
+import { BOIL_CONFIG, RING_GEOMETRY } from "../src/pencil/config/pencilConfig";
+
+// PRM: live, because the ring's whole claim is that it follows a box the dock GLIDES under a
+// WAAPI transform; freezing motion deletes the subject of gates 4 and 15.
+//
+/**
+ * T9-W7 §5/§6 — THE DRAWN FOCUS RING, as estate gates.
+ *
+ * The design (`FocusRing.vue`) suppresses the UA outline globally and draws ONE ring in the
+ * house hand on whatever has focus. Four claims carry it, and until this file they lived in a
+ * lane's probe directory, where nothing in CI could read them:
+ *
+ *   G-LIVE-4   the ring travels with what it rings — pressing a control the ring is already on
+ *              glides that control 520 ms under a transform that fires no scroll, resize or
+ *              transitionend on its path, and the ring's framing error stays 0.
+ *   G-LIVE-14  the rank is an ORDER, and it holds in EVERY media arm. At HEAD the
+ *              `prefers-contrast: more` arm ranked tier 2 = tier 1 = 0.9; a ladder that
+ *              collapses in one arm is not a ladder.
+ *   G-LIVE-15  no focus stop rests on a running animation: at rest the ring's target path reads
+ *              0 FINITE animations. (`document.getAnimations()` reads 1 at rest — the board's
+ *              perpetual boil — so a document-wide read is not a test for "in motion".)
+ *   G-LIVE-16  every focusable stop keeps an indicator. Suppressing the UA outline is the most
+ *              dangerous thing this design does, so the walk is the tripwire: each stop carries
+ *              a drawn ring ON IT, the board's own tier-2 ink, or an outline whose STYLE is not
+ *              `none` — and a stranded focusable injected into the same walk must be caught.
+ *   G-LIVE-19  the seams the ring reads are registered ONCE each, no `var(x, fallback)` stands
+ *              behind any registered name, and each registration's value is what paints.
+ *   G-LIVE-17  in a room, the coarse tape names the author's cell, takes no tap, and never
+ *              shares a pixel with your ring (its covering of OTHER cells is the chair's row).
+ *   G-LIVE-20  on a phone, the ring leaves with what it rang: an activation of the dock's tab
+ *              drops focus to `body` in WebKit with no `focusout` on the ring's path, and no
+ *              ring may survive that at any framed instant.
+ *   G-LIVE-21  under forced colours the drawn ring is gone and the deck's active card, a
+ *              staging face and the armed guard's verb each carry an outline in the engine's
+ *              own Highlight, and the guard's paints.
+ *   G-LIVE-22  MA-N from the DOM (MRK-ABS's G-ABS-7/8): no board ring's ink enters its
+ *              neighbour at 16×16, 9×9 or 4×4, proven on the recipe the shipped arm of
+ *              `RING_GEOMETRY` names, and the comment's figure table held to the DOM.
+ *   G-LIVE-23  the ring is VISIBLE, not merely present: all four sides of the chrome ring at every
+ *              stop key and of the board's tier-2 ring read a painted core median of 3:1 or
+ *              better against the same pixels with the ring hidden; a faint ring, a faded ink and
+ *              a clipped side red it in the same run.
+ *
+ * NO CLOCK STANDS IN FOR A SETTLE. Every settle waits on the ANIMATION SET of the target's own
+ * ancestor path (the bound the component uses) or on a polled pose (`poseSettled`: the dock
+ * sheet, the tape). A `waitForTimeout(520)` would re-introduce exactly the duration guess the
+ * design deleted, and W8's next retune of the 520 would silently un-gate the row. The waits that
+ * remain are GESTURES, not settles, each tagged where it stands: the boot pause, the keyboard
+ * modality pause, the 140 ms mid-glide reversal and G-LIVE-20's framed instants.
+ */
+
+const FE_ROOT = join(fileURLToPath(new URL(".", import.meta.url)), "..");
+/** THE INSTRUMENTS, at their PRODUCT HOMES (registry-v7 §2.4, LAWS P7 §I): the four-band edge probe
+ *  (`e2e/lib/edge-bands.mjs`) and the shape-census library (`scripts/shape-census.mjs`), imported by
+ *  RELATIVE path, never hand-rolled and never read from the loop's record. Loaded at run time because
+ *  they are untyped `.mjs` (the e2e typecheck carries no `allowJs`). */
+const instrument = (rel: string): Promise<any> => import(new URL(rel, import.meta.url).href);
+const EDGE_BANDS = "./lib/edge-bands.mjs";
+const SHAPE_CENSUS = "../scripts/shape-census.mjs";
+
+const BOARD = "?game=sudoku";
+
+async function boardReady(page: Page, query = BOARD) {
+  await page.goto("./" + query);
+  await page.waitForSelector('[role="grid"] [role="gridcell"]', { timeout: 60000 });
+  await page.waitForSelector("path.cell-line", { state: "attached", timeout: 60000 });
+  await page.waitForTimeout(1200);
+}
+
+/** Keyboard modality first, so `:focus-visible` is true whichever way focus then lands. */
+async function focusByKeyboard(page: Page, sel: string) {
+  await page.keyboard.press("Tab");
+  await page.evaluate(
+    (s) => document.querySelector<HTMLElement>(s)?.focus({ preventScroll: true }),
+    sel,
+  );
+  await page.waitForTimeout(400);
+}
+
+/** Nothing FINITE left running on the ring's target's own ancestor path. The target is the
+ *  `aria-activedescendant` when one is declared: a listbox keeps DOM focus while its option is
+ *  what travels. */
+async function settled(page: Page, after = 120) {
+  await page.waitForFunction(
+    () => {
+      const a = document.activeElement as HTMLElement | null;
+      if (!a) return true;
+      const owned = a.getAttribute?.("aria-activedescendant");
+      const box = (owned && document.getElementById(owned)) || a;
+      const set: Animation[] = [];
+      for (let e: Element | null = box; e; e = e.parentElement)
+        set.push(...e.getAnimations());
+      return (
+        set.filter((x) =>
+          Number.isFinite(x.effect?.getComputedTiming().endTime ?? Infinity),
+        ).length === 0
+      );
+    },
+    undefined,
+    { timeout: 20000 },
+  );
+  await page.waitForTimeout(after);
+}
+
+const framing = (page: Page) =>
+  page.evaluate(() => {
+    const a = document.activeElement as HTMLElement | null;
+    const ring = document.querySelector<SVGElement>(".focus-ring");
+    const owned = a?.getAttribute?.("aria-activedescendant");
+    const box = ((owned && document.getElementById(owned)) || a) as HTMLElement | null;
+    if (!ring || !box) return { ring: !!ring, box: !!box, err: null as number | null };
+    const rb = ring.getBoundingClientRect();
+    const bb = box.getBoundingClientRect();
+    const o = parseFloat(getComputedStyle(box).getPropertyValue("--focus-ring-outset"));
+    return {
+      ring: true,
+      box: true,
+      outset: o,
+      rings: document.querySelectorAll(".focus-ring").length,
+      err: +Math.max(
+        Math.abs(rb.left - Math.max(0, bb.left - o)),
+        Math.abs(rb.top - (bb.top - o)),
+      ).toFixed(2),
+    };
+  });
+
+// ── G-LIVE-4 ────────────────────────────────────────────────────────────────────────────
+test("G-LIVE-4 · the ring travels with the control it rings", async ({ page }) => {
+  await boardReady(page);
+  if (!(await page.locator(".drawer-tab").count()))
+    test.skip(true, "no .drawer-tab at this viewport");
+
+  await focusByKeyboard(page, ".drawer-tab");
+  const before = await framing(page);
+  expect(before.ring, "the ring lands on the tab before the press").toBe(true);
+  expect(before.err).toBeLessThanOrEqual(0.5);
+
+  // THE DEFECT'S OWN GESTURE — press the control focus is already on. Nothing moves focus, so
+  // no focus event arrives, and the box glides out from under the ring unless the ring follows
+  // the animation set.
+  await page.evaluate(() => document.querySelector<HTMLElement>(".drawer-tab")?.click());
+  await settled(page);
+  const afterPress = await framing(page);
+  expect(afterPress.ring, "the ring is still on the tab after the glide").toBe(true);
+  expect(
+    afterPress.err,
+    "framing error after the dock's 520 ms glide",
+  ).toBeLessThanOrEqual(0.5);
+  expect(afterPress.rings, "exactly one ring exists").toBe(1);
+
+  // A REVERSAL, DEALT IN THE PAGE AND WITNESSED. The dock retargets a mid-glide press by
+  // `anim.reverse()` (`useControlsDrawer.ts`): the SAME animation stays on the path with its rate
+  // flipped. A Playwright-timed second press lands after the glide in WebKit often enough to
+  // green a broken tree (pass 6: a ring that stops following a reversed glide was caught in
+  // chromium only), so the press, the 140 ms and the second press all run in-page, the row
+  // ASSERTS the glide it reverses was running and now runs backwards, and the ring's framing is
+  // sampled at EVERY frame of the reversed glide (read after each frame's paint), not only at rest.
+  // The tab is RE-QUERIED at every read, as the FOCUSED tab: the dock re-berths it on the state
+  // flip, so a node held from before the press, or the first `.drawer-tab` in the document, is
+  // not the one the ring is on (WebKit read an empty path that way). The
+  // reversed rate is PENDING for a frame or two after `reverse()`, so it is watched for, not read
+  // once.
+  const rev = await page.evaluate(async () => {
+    const q = () =>
+      ((document.activeElement as HTMLElement | null)?.closest<HTMLElement>(".drawer-tab") ??
+        document.querySelector<HTMLElement>(".drawer-tab"))!;
+    const path = () => {
+      const set: Animation[] = [];
+      for (let e: Element | null = q(); e; e = e.parentElement) set.push(...e.getAnimations());
+      return set.filter((a) => Number.isFinite(a.effect?.getComputedTiming().endTime ?? Infinity));
+    };
+    const err = () => {
+      const ring = document.querySelector(".focus-ring");
+      if (!ring) return null;
+      const rb = ring.getBoundingClientRect();
+      const bb = q().getBoundingClientRect();
+      const o = parseFloat(getComputedStyle(q()).getPropertyValue("--focus-ring-outset"));
+      return Math.max(Math.abs(rb.left - Math.max(0, bb.left - o)), Math.abs(rb.top - (bb.top - o)));
+    };
+    const series: (number | null)[] = [];
+    let stop = false;
+    const sample = () =>
+      requestAnimationFrame(() =>
+        setTimeout(() => {
+          series.push(err());
+          if (!stop) sample();
+        }, 0),
+      );
+    q().click();
+    await new Promise((r) => setTimeout(r, 140)); // the gesture: the second press lands mid-glide
+    const midway = path().length;
+    q().click();
+    sample();
+    let reversed = false;
+    for (let f = 0; f < 4 && !reversed; f++) {
+      await new Promise((r) => requestAnimationFrame(r));
+      reversed = path().some((a) => a.playbackRate < 0);
+    }
+    // Sampled until the path is empty AND the focused tab holds its pose for five frames: the
+    // dock re-flips its layout after the last animation ends, and a ring left behind shows there.
+    const t0 = performance.now();
+    await new Promise<void>((done) => {
+      let still = 0;
+      let last = "";
+      const check = () => {
+        const b = q().getBoundingClientRect();
+        const pose = `${b.left},${b.top}`;
+        still = path().length === 0 && pose === last ? still + 1 : 0;
+        last = pose;
+        if (still >= 5 || performance.now() - t0 > 3000) done();
+        else requestAnimationFrame(check);
+      };
+      check();
+    });
+    await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
+    stop = true;
+    return {
+      midway,
+      reversed,
+      frames: series.length,
+      missing: series.filter((v) => v === null).length,
+      max: +Math.max(...series.map((v) => v ?? Infinity)).toFixed(2),
+    };
+  });
+  console.log(`[G-LIVE-4 reversal] ${JSON.stringify(rev)}`);
+  expect(rev.midway, "the second press lands while the glide is running").toBeGreaterThan(0);
+  // THE INTERLEAVE EACH ENGINE DEALT, printed and never pinned (chair A.5.6): whether the dock
+  // reverses a mid-glide press in place or cuts it is §13's mechanics, and a ring row may not red
+  // when §13 changes it. The ring's claim is the per-frame framing bound below, through whatever
+  // was dealt. The reversal clause still needs a subject, so each engine records its deal beside
+  // the run's output and asserts that at least one engine of THIS INVOCATION reversed; a lone engine
+  // run (no sibling record from this invocation) prints that it could not check, and says so.
+  // PER INVOCATION (pass 9; the pass-8 critic's gap 11): a record is keyed on the runner process every
+  // worker of one `playwright test` shares (`process.ppid`), never a 20-minute clock window, so a
+  // stale sibling from an earlier invocation cannot satisfy the clause. Its plant, in-run: a stale
+  // record that REVERSED, written beside the real ones under a foreign runner key, must not count.
+  const project = test.info().project.name;
+  const run = process.ppid;
+  const deals = join(test.info().project.outputDir, "g-live-4-deals");
+  mkdirSync(deals, { recursive: true });
+  writeFileSync(join(deals, `${project}.json`), JSON.stringify({ reversed: rev.reversed, at: Date.now(), run }));
+  writeFileSync(join(deals, `stale-plant.json`), JSON.stringify({ reversed: true, at: Date.now(), run: -run }));
+  type Deal = { reversed: boolean; at: number; run?: number; file: string };
+  const records = readdirSync(deals)
+    .filter((f) => f !== `${project}.json`)
+    .map((f) => ({ ...(JSON.parse(readFileSync(join(deals, f), "utf8")) as Omit<Deal, "file">), file: f }) as Deal);
+  const siblings = records.filter((d) => d.run === run);
+  expect(
+    siblings.some((d) => d.file === "stale-plant.json"),
+    "the stale-record plant (a reversal from another invocation) is not counted as this run's sibling",
+  ).toBe(false);
+  expect(records.some((d) => d.file === "stale-plant.json"), "the stale-record plant is on disk beside the real records").toBe(true);
+  console.log(
+    `[G-LIVE-4 dealt] ${project} (runner ${run}): ${rev.reversed ? "reversed in place" : "cut"} · siblings this invocation: ${siblings.length ? siblings.map((d) => `${d.file} ${d.reversed ? "reversed" : "cut"}`).join(", ") : "none recorded (the at-least-one clause is unchecked)"} · foreign records ignored: ${records.length - siblings.length}`,
+  );
+  expect(
+    rev.reversed || siblings.length === 0 || siblings.some((d) => d.reversed),
+    "at least one engine deals a reversal, or the reversal clause has no subject",
+  ).toBe(true);
+  expect(rev.frames, "the reversed glide was sampled frame by frame").toBeGreaterThan(5);
+  expect(rev.missing, "a ring at every sampled frame of the reversed glide").toBe(0);
+  expect(rev.max, "worst per-frame framing error through the reversed glide (px)").toBeLessThanOrEqual(1);
+  await settled(page);
+  // STRICT, no `if`: a reversal that loses its ring is a red, never a skip (the silent
+  // `if (afterReversal.ring)` stood three passes). Polled, because the reads after a fixed
+  // in-page window inherit its clock: the invariant is read until it holds or the row reds.
+  await expect
+    .poll(async () => {
+      const f = await framing(page);
+      return { ring: f.ring, rings: f.rings, framed: f.err !== null && f.err <= 0.5 };
+    }, { message: "after the reversal: one ring, on the tab, framed within 0.5 px" })
+    .toEqual({ ring: true, rings: 1, framed: true });
+
+  // NEGATIVE CONTROL, same run, for the reversal read alone: move the tab under a transform that
+  // fires no event the ring listens to (no scroll, no resize, no ResizeObserver entry, no
+  // animation), and the same read must see the ring left behind.
+  await page.evaluate(() => {
+    const t = document.querySelector<HTMLElement>(".drawer-tab")!;
+    t.style.translate = "0 24px";
+  });
+  await page.evaluate(
+    () => new Promise<void>((r) => requestAnimationFrame(() => requestAnimationFrame(() => r()))),
+  );
+  await expect
+    .poll(async () => (await framing(page)).err ?? 0, {
+      message: "the reversal's read sees a ring its box left behind",
+    })
+    .toBeGreaterThan(0.5);
+  await page.evaluate(() => {
+    document.querySelector<HTMLElement>(".drawer-tab")!.style.translate = "";
+  });
+});
+
+// ── G-LIVE-14 ───────────────────────────────────────────────────────────────────────────
+//
+// The order, not the values: `1 > tier2 > tier1 > peer` must hold in the normal arm AND under
+// `prefers-contrast: more`. PW-WebKit DOES emulate `prefers-contrast` (measured; the spec's
+// "chromium-only" caveat was wrong), so the arm is asserted in both engines and the row says
+// so by reading `matchMedia` rather than trusting the emulation.
+test("G-LIVE-14 · the opacity rank is an order in every media arm", async ({ page }) => {
+  for (const contrast of ["no-preference", "more"] as const) {
+    await page.emulateMedia({ contrast });
+    await boardReady(page);
+    const arm = await page.evaluate(() => {
+      const probe = document.createElement("div");
+      document.body.appendChild(probe);
+      const read = (cls: string) => {
+        probe.className = cls;
+        return parseFloat(getComputedStyle(probe).opacity);
+      };
+      const matched = window.matchMedia("(prefers-contrast: more)").matches;
+      probe.remove();
+      return { matched, read: read.name };
+    });
+    expect(
+      arm.matched,
+      `the ${contrast} arm is the arm the engine actually applied`,
+    ).toBe(contrast === "more");
+
+    // READ THE PAINT, NOT THE STYLESHEET TEXT. A `cssText` scrape greens on a null read the
+    // moment a selector is renamed or the compiler re-scopes it — measured: this row passed
+    // vacuously until the not-null clause below was added. Focus one cell, leave another
+    // alone, and ask the two live paths what they actually compute.
+    // THE WHOLE LADDER, ONE PLACE (registry v4 §5): invalid > tier 2 > tier 1 > peer. The two
+    // states a solo board never shows are put on REAL cells by their own class names, so the
+    // numbers are the scoped rules' computed values, not a copy of them in this file.
+    const rank = await page.evaluate(() => {
+      const cells = Array.from(document.querySelectorAll<HTMLElement>(".game-cell"));
+      const n = cells.length;
+      const input = cells[0]?.querySelector<HTMLInputElement>("input");
+      input?.focus();
+      const read = (c: HTMLElement | undefined) => {
+        const p = c?.querySelector<SVGPathElement>(".cell-ghost-path");
+        if (!p) return null;
+        const v = parseFloat(getComputedStyle(p).strokeOpacity);
+        return Number.isFinite(v) ? v : null;
+      };
+      const as = (c: HTMLElement | undefined, cls: string) => {
+        c?.classList.add(cls);
+        const v = read(c);
+        c?.classList.remove(cls);
+        return v;
+      };
+      return {
+        invalid: as(cells[n >> 1], "is-invalid"),
+        tier2: read(cells[0]),
+        tier1: read(cells[n - 1]),
+        peer: as(cells[(n >> 1) + 1], "is-peer-cursor"),
+      };
+    });
+    await page.waitForTimeout(250);
+    // A row that reads nothing must RED, not pass: the rank is only a rank if both rungs were
+    // found. This is the clause that keeps the gate from greening on a renamed selector.
+    expect(rank.tier1, `tier 1's stroke-opacity was read in the ${contrast} arm`).not.toBeNull();
+    expect(rank.tier2, `tier 2's stroke-opacity was read in the ${contrast} arm`).not.toBeNull();
+    expect(rank.invalid, `the invalid rung was read in the ${contrast} arm`).not.toBeNull();
+    expect(rank.peer, `the peer rung was read in the ${contrast} arm`).not.toBeNull();
+    // A ladder that ties is not a ladder: every rung strictly above the next, in every arm.
+    expect(
+      rank.invalid,
+      `invalid outranks tier 2 in the ${contrast} arm`,
+    ).toBeGreaterThan(rank.tier2!);
+    expect(
+      rank.tier2,
+      `tier 2 outranks tier 1 in the ${contrast} arm`,
+    ).toBeGreaterThan(rank.tier1!);
+    expect(
+      rank.tier1,
+      `tier 1 outranks a peer's ring in the ${contrast} arm`,
+    ).toBeGreaterThan(rank.peer!);
+  }
+  await page.emulateMedia({ contrast: "no-preference" });
+});
+
+// ── G-LIVE-15 ───────────────────────────────────────────────────────────────────────────
+test("G-LIVE-15 · no focus stop rests on a running animation", async ({ page }) => {
+  await boardReady(page);
+  for (const sel of ["button.logo-trigger", ".sun-moon-toggle", ".drawer-tab"]) {
+    if (!(await page.locator(sel).count())) continue;
+    await focusByKeyboard(page, sel);
+    await settled(page);
+    const counts = await page.evaluate((s) => {
+      const el = document.querySelector<HTMLElement>(s);
+      if (!el) return null;
+      const set: Animation[] = [];
+      for (let e: Element | null = el; e; e = e.parentElement)
+        set.push(...e.getAnimations());
+      return {
+        all: set.length,
+        finite: set.filter((x) =>
+          Number.isFinite(x.effect?.getComputedTiming().endTime ?? Infinity),
+        ).length,
+      };
+    }, sel);
+    expect(counts, `${sel} exists`).not.toBeNull();
+    expect(counts!.finite, `${sel} rests with nothing finite on its path`).toBe(0);
+  }
+  // THE FIFTH STOP, THE ARMED GUARD (charter row 13): a dirty board, the deck, a step, `d` for
+  // deal — the ribbon arms and its verbs take focus. They rest on nothing running, and the ring
+  // lands on the verb it names.
+  const blank = await page.evaluate(() => {
+    const cells = document.querySelectorAll(".sudoku-cell");
+    for (let i = 0; i < cells.length; i++) if (!cells[i].querySelector(".glyph-svg")) return i;
+    return -1;
+  });
+  expect(blank, "an empty cell to dirty").toBeGreaterThanOrEqual(0);
+  await page.evaluate((idx) => {
+    const input = document.querySelectorAll<HTMLInputElement>(".sudoku-cell input")[idx];
+    input.focus();
+    Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value")!.set!.call(input, "1");
+    input.dispatchEvent(new Event("input", { bubbles: true }));
+  }, blank);
+  await page.evaluate(() => document.querySelector<HTMLElement>("button.logo-trigger")?.click());
+  const viewport = page.locator(".gallery-viewport");
+  await expect(viewport).toBeVisible({ timeout: 15000 });
+  await viewport.press("ArrowRight");
+  await viewport.press("d");
+  await expect(page.locator(".gallery-guard")).toBeVisible();
+  await focusByKeyboard(page, ".guard-btn");
+  await settled(page);
+  const guard = await page.evaluate(() => {
+    const el = document.activeElement as HTMLElement;
+    const set: Animation[] = [];
+    for (let e: Element | null = el; e; e = e.parentElement) set.push(...e.getAnimations());
+    const rb = document.querySelector(".focus-ring")?.getBoundingClientRect();
+    const bb = el.getBoundingClientRect();
+    const cx = bb.left + bb.width / 2;
+    const cy = bb.top + bb.height / 2;
+    return {
+      on: el.classList.contains("guard-btn"),
+      finite: set.filter((x) =>
+        Number.isFinite(x.effect?.getComputedTiming().endTime ?? Infinity),
+      ).length,
+      ringed: !!rb && rb.left <= cx && cx <= rb.right && rb.top <= cy && cy <= rb.bottom,
+    };
+  });
+  expect(guard.on, "focus is on a guard verb").toBe(true);
+  expect(guard.finite, ".guard-btn rests with nothing finite on its path").toBe(0);
+  expect(guard.ringed, "the ring lands on the guard verb").toBe(true);
+
+  // NEGATIVE CONTROL, same run: an INFINITE animation on the path enters the raw set and must
+  // NOT enter the filtered one — otherwise the row above is green because the filter is broken.
+  const ctl = await page.evaluate(() => {
+    const el = document.querySelector<HTMLElement>(".drawer-tab") ?? document.body;
+    const a = document.body.animate([{ opacity: 1 }, { opacity: 1 }], {
+      duration: 1000,
+      iterations: Infinity,
+    });
+    const set: Animation[] = [];
+    for (let e: Element | null = el; e; e = e.parentElement) set.push(...e.getAnimations());
+    const out = {
+      all: set.length,
+      finite: set.filter((x) =>
+        Number.isFinite(x.effect?.getComputedTiming().endTime ?? Infinity),
+      ).length,
+    };
+    a.cancel();
+    return out;
+  });
+  expect(ctl.all, "the injected infinite animation is on the path").toBeGreaterThan(0);
+  expect(ctl.finite, "and the FINITE filter refuses it").toBe(0);
+});
+
+// ── G-LIVE-16 ───────────────────────────────────────────────────────────────────────────
+//
+// EVERY focusable stop keeps an indicator, and an indicator is PAINT. Suppressing the UA outline
+// is the most dangerous thing this design does, so this walk is its tripwire, and a tripwire that
+// reads a rect or a declared style cannot see the danger: with `--ring-ink` deleted the ring's
+// path computes `stroke: none` and paints 0 px, and with the living cell's ghost at opacity 0 the
+// board paints 0 px on focus, yet a rect-and-style form of this row stayed green in both engines
+// (pass-5 critic, X1/X2). Three forms count, and each is judged on the pixels it changes:
+//   · a DRAWN ring that rings the element focus is ON (its `aria-activedescendant` first): the
+//     ring's path computes a stroke that is not `none`, no ancestor zeroes its opacity, and the
+//     ring's own box, photographed ON and then with `.focus-ring { visibility: hidden }`, differs
+//     by more than FLOOR pixels beyond the noise of a second ON photograph;
+//   · the BOARD's own tier-2 ink on a cell input: the ghost computes a stroke at ≥ 0.9, its
+//     opacity chain is non-zero, and the cell photographed focused and then blurred differs by
+//     more than FLOOR pixels beyond the noise;
+//   · an OUTLINE whose style is not `none`, photographed ON and then with its style struck.
+//
+// WHY ONE STOP PER ROUND TRIP. The ring is a Vue render: it exists only after the focus event's
+// flush, so each stop is focused, two frames are awaited, and only then read. The walk runs with
+// the boil PARKED (`reducedMotion: reduce`): the living mark is born at pose 0 and the grid holds
+// still, so a pixel that changes between two photographs is the indicator, not the beat.
+//
+// THE NEGATIVE CONTROLS, SAME RUN. The stranded control (an `<input class="cell-native-input">`
+// outside any cell: the ring refuses it, no board ink is behind it, index.css strips its outline)
+// must be CAUGHT. Then five plants are laid one at a time over a stop the walk judged good, and
+// each must turn that stop's verdict false: X1 the ink deleted (`--ring-ink: initial`), X1b the
+// ink made transparent, X1c the ring at opacity 0, X2 the living cell's ghost at opacity 0, X2b
+// the ghost's stroke made transparent. A plant that leaves its stop green means this row cannot
+// see paint, and the row reds.
+const FOCUSABLE =
+  'a[href], button:not([disabled]), input:not([disabled]), select, textarea, [tabindex]:not([tabindex="-1"])';
+/** Changed pixels (any channel moved ≥ 16/255) a real indicator must paint beyond the noise. */
+const FLOOR = 30;
+
+const frames2 = (page: Page) =>
+  page.evaluate(
+    () => new Promise<void>((r) => requestAnimationFrame(() => requestAnimationFrame(() => r()))),
+  );
+
+/** Pixels that changed between ON and OFF but NOT between ON and a second ON, decoded in the
+ *  page: the indicator's own pixels, with anything that moves on its own (a caret, a sparkle)
+ *  subtracted pixel by pixel rather than by count. */
+type Shot = Awaited<ReturnType<Page["screenshot"]>>;
+const indicatorPixels = (page: Page, on: Shot, off: Shot, again: Shot, offAgain?: Shot) =>
+  page.evaluate(
+    async (shots) => {
+      const load = async (s: string) => {
+        const blob = await (await fetch("data:image/png;base64," + s)).blob();
+        const bmp = await createImageBitmap(blob);
+        const c = new OffscreenCanvas(bmp.width, bmp.height);
+        const x = c.getContext("2d")!;
+        x.drawImage(bmp, 0, 0);
+        return x.getImageData(0, 0, bmp.width, bmp.height).data;
+      };
+      const [p, q, r, o] = await Promise.all(shots.map(load));
+      if (p.length !== q.length || p.length !== r.length || (o && o.length !== p.length)) return { paint: -1, noise: -1 };
+      const moved = (u: Uint8ClampedArray, v: Uint8ClampedArray, i: number) =>
+        Math.max(Math.abs(u[i] - v[i]), Math.abs(u[i + 1] - v[i + 1]), Math.abs(u[i + 2] - v[i + 2])) >= 16;
+      let paint = 0;
+      let noise = 0;
+      for (let i = 0; i < p.length; i += 4) {
+        // With a second OFF shot, a pixel must also hold still OFF → OFF: the grid's boil (live
+        // outside `reduce`) swaps its lines' pose between any two shots and is never the indicator.
+        const n = moved(p, r, i) || (o ? moved(q, o, i) : false);
+        if (n) noise++;
+        else if (moved(p, q, i)) paint++;
+      }
+      return { paint, noise };
+    },
+    [on, off, again, ...(offAgain ? [offAgain] : [])].map((b) => b.toString("base64")),
+  );
+
+type Kind = "drawn" | "board" | "outline";
+interface Verdict {
+  who: string;
+  judged: boolean;
+  ok: boolean;
+  stranded: boolean;
+  by: Kind | null;
+  paint: Partial<Record<Kind, number>>;
+  noise?: number;
+}
+
+/** Judge the stop tagged `data-gl16=i` (focus is already on it): which indicator it CLAIMS, then
+ *  whether that indicator paints. */
+async function judgeStop(page: Page, i: number): Promise<Verdict> {
+  const claim = await page.evaluate((i) => {
+    const e = document.querySelector<HTMLElement>(`[data-gl16="${i}"]`)!;
+    const who = e.tagName.toLowerCase() + "." + (String(e.className).split(" ")[0] || "");
+    const stranded = "gl16Stranded" in e.dataset;
+    if (document.activeElement !== e || !e.matches(":focus-visible"))
+      return { who, judged: false, stranded, drawn: null, board: null, outline: null };
+    const chainOpaque = (n: Element | null) => {
+      for (; n; n = n.parentElement) {
+        const s = getComputedStyle(n);
+        if (parseFloat(s.opacity) === 0 || s.visibility === "hidden" || s.display === "none")
+          return false;
+      }
+      return true;
+    };
+    const pad = (r: DOMRect, p: number) => {
+      const x = Math.max(0, Math.floor(r.left - p));
+      const y = Math.max(0, Math.floor(r.top - p));
+      return {
+        x,
+        y,
+        width: Math.min(innerWidth, Math.ceil(r.right + p)) - x,
+        height: Math.min(innerHeight, Math.ceil(r.bottom + p)) - y,
+      };
+    };
+    const owned = e.getAttribute("aria-activedescendant");
+    const target = (owned && document.getElementById(owned)) || e;
+    const cb = target.getBoundingClientRect();
+    const cx = cb.left + cb.width / 2;
+    const cy = cb.top + cb.height / 2;
+    const ring = Array.from(document.querySelectorAll<SVGElement>(".focus-ring")).find((r) => {
+      const rb = r.getBoundingClientRect();
+      return rb.left <= cx && cx <= rb.right && rb.top <= cy && cy <= rb.bottom;
+    });
+    // THE POSE THAT IS PAINTED, not the first path: the ring and the living cell each carry four
+    // sibling poses and show one per beat (the rest at opacity 0). Under `reduce` the mark rests on
+    // pose 0, so path 1 was always the painted one; outside it the read lands mid-revolution.
+    const shown = (ps: NodeListOf<SVGPathElement> | undefined) => (ps ? Array.from(ps).find((q) => chainOpaque(q)) : undefined);
+    const rp = shown(ring?.querySelectorAll<SVGPathElement>("path"));
+    const drawn =
+      ring && rp && getComputedStyle(rp).stroke !== "none" && chainOpaque(rp)
+        ? pad(ring.getBoundingClientRect(), 2)
+        : null;
+    const cell = e.closest(".game-cell");
+    const ghost = shown(cell?.querySelectorAll<SVGPathElement>(".cell-ghost-path"));
+    const gs = ghost ? getComputedStyle(ghost) : null;
+    const board =
+      cell && ghost && gs!.stroke !== "none" && parseFloat(gs!.strokeOpacity) >= 0.9 && chainOpaque(ghost)
+        ? pad(cell.getBoundingClientRect(), 4)
+        : null;
+    const cs = getComputedStyle(e);
+    const outline =
+      cs.outlineStyle !== "none" && parseFloat(cs.outlineWidth) > 0
+        ? pad(e.getBoundingClientRect(), parseFloat(cs.outlineWidth) + Math.abs(parseFloat(cs.outlineOffset) || 0) + 2)
+        : null;
+    return { who, judged: true, stranded, drawn, board, outline };
+  }, i);
+  const v: Verdict = { who: claim.who, judged: claim.judged, ok: false, stranded: claim.stranded, by: null, paint: {} };
+  if (!claim.judged) return v;
+  // ON, OFF, ON, OFF: a pixel counts when it moved ON → OFF, held still ON → ON and OFF → OFF, and
+  // the indicator is left ON. A clip outside the viewport cannot be photographed and reads −1.
+  const read = async (clip: { x: number; y: number; width: number; height: number }, off: () => Promise<void>, on: () => Promise<void>) => {
+    if (clip.width < 1 || clip.height < 1) return -1;
+    const a = await page.screenshot({ clip, caret: "hide" });
+    await off();
+    await frames2(page);
+    const b = await page.screenshot({ clip, caret: "hide" });
+    await on();
+    await frames2(page);
+    const c = await page.screenshot({ clip, caret: "hide" });
+    await off();
+    await frames2(page);
+    const d = await page.screenshot({ clip, caret: "hide" });
+    await on();
+    await frames2(page);
+    const { paint, noise } = await indicatorPixels(page, a, b, c, d);
+    v.noise = Math.max(v.noise ?? 0, noise);
+    return paint;
+  };
+  const style = (css: string) =>
+    page.evaluate((css) => {
+      const s = document.createElement("style");
+      s.dataset.gl16Off = "";
+      s.textContent = css;
+      document.head.appendChild(s);
+    }, css);
+  const unstyle = () => page.evaluate(() => document.querySelectorAll("style[data-gl16-off]").forEach((s) => s.remove()));
+  if (claim.drawn)
+    v.paint.drawn = await read(claim.drawn, () => style(".focus-ring { visibility: hidden !important; }"), unstyle);
+  // The board's indicator is the cell's OWN ghost, its ink removed in place (focus kept): a blur also
+  // lifts the peer-unit wash on the row, column and box, and under `prefers-contrast: more` (13 %)
+  // that wash alone moved 456–516 px of the padded clip with the ghost's stroke planted transparent
+  // (X2b). THE GROUND IS HELD STILL for this read: outside `reduce` the board's grid swaps its baked
+  // pose EVERY beat (`BOIL_CONFIG.intervalMs` 150 → one 125 ms beat), so the four photographs can
+  // alias the boil (ON at one pose, OFF at the other, twice) and 36–37 px of grid rule counted as
+  // the indicator with its ink planted transparent (X2b GREEN in WebKit `no-preference`/`more`,
+  // 5 of 18 WebKit non-`reduce` runs). This row asks whether the indicator EXISTS; the grid is hidden in all four
+  // photographs, and G-LIVE-23 reads the ring against the real ground.
+  if (claim.board) {
+    await page.evaluate(() => {
+      const s = document.createElement("style");
+      s.dataset.gl16Ground = "";
+      s.textContent = ".board-shell .hand-drawn-grid { visibility: hidden !important; }";
+      document.head.appendChild(s);
+    });
+    await frames2(page);
+    v.paint.board = await read(
+      claim.board,
+      () =>
+        style(
+          `.game-cell:has([data-gl16="${i}"]) .cell-ghost-path { stroke: rgba(0,0,0,0) !important; fill: none !important; }`,
+        ),
+      unstyle,
+    );
+    await page.evaluate(() => document.querySelectorAll("style[data-gl16-ground]").forEach((s) => s.remove()));
+    await frames2(page);
+  }
+  if (claim.outline)
+    v.paint.outline = await read(claim.outline, () => style(`[data-gl16="${i}"] { outline-style: none !important; }`), unstyle);
+  for (const k of ["drawn", "board", "outline"] as const)
+    if ((v.paint[k] ?? 0) > FLOOR) {
+      v.ok = true;
+      v.by = k;
+      break;
+    }
+  return v;
+}
+
+/** EVERY REGIME A READER BRINGS (LAWS P7 §E i): the walk settles under `reduce`, and runs whole
+ *  again under `no-preference`, `prefers-contrast: more` and `pointer: coarse` (a touch context,
+ *  witnessed). Each non-settle regime ships the plant only it can see: the ring and the living
+ *  ghost at opacity 0 INSIDE that regime's media query, which must red the stop it is laid on
+ *  (pass 7's reduce-only walk could not see a ring deleted for the majority). */
+const G16_REGIMES = [
+  { name: "reduce", media: { reducedMotion: "reduce", contrast: "no-preference" }, mq: null, touch: false },
+  { name: "no-preference", media: { reducedMotion: "no-preference", contrast: "no-preference" }, mq: "(prefers-reduced-motion: no-preference)", touch: false },
+  { name: "more", media: { reducedMotion: "no-preference", contrast: "more" }, mq: "(prefers-contrast: more)", touch: false },
+  { name: "coarse", media: { reducedMotion: "no-preference", contrast: "no-preference" }, mq: "(pointer: coarse)", touch: true },
+] as const;
+type G16Regime = (typeof G16_REGIMES)[number];
+
+for (const regime of G16_REGIMES) {
+  const title = `G-LIVE-16 · the UA outline is suppressed and nobody is stranded (read on paint) [${regime.name}]`;
+  if (regime.touch)
+    test.describe(`G-LIVE-16 · ${regime.name}`, () => {
+      test.use({ hasTouch: true });
+      test(title, ({ page }) => g16(page, regime));
+    });
+  else test(title, ({ page }) => g16(page, regime));
+}
+
+async function g16(page: Page, regime: G16Regime) {
+  test.setTimeout(240000);
+  await page.emulateMedia(regime.media);
+  await boardReady(page);
+  if (regime.mq)
+    expect(await page.evaluate((mq) => matchMedia(mq).matches, regime.mq), `the ${regime.name} regime is witnessed, not assumed`).toBe(true);
+  const sampled = await page.evaluate((FOCUSABLE) => {
+    const s = document.createElement("input");
+    s.className = "cell-native-input";
+    s.setAttribute("aria-label", "stranded control");
+    s.dataset.gl16Stranded = "";
+    s.style.cssText = "position:fixed;left:8px;bottom:8px;width:48px;height:24px";
+    document.body.appendChild(s);
+    const stops = Array.from(document.querySelectorAll<HTMLElement>(FOCUSABLE)).filter((e) => {
+      const b = e.getBoundingClientRect();
+      return b.width > 0 && b.height > 0 && !e.closest("[inert]");
+    });
+    // Two per tag.class signature — the whole estate at one route is thousands of cells. The
+    // stranded control is walked LAST and always.
+    const seen = new Map<string, number>();
+    let i = 0;
+    for (const e of stops) {
+      if (e === s) continue;
+      const k = e.tagName + "." + (String(e.className).split(" ")[0] || "");
+      const n = seen.get(k) ?? 0;
+      if (n >= 2) continue;
+      seen.set(k, n + 1);
+      e.dataset.gl16 = String(i++);
+      if (i >= 24) break;
+    }
+    s.dataset.gl16 = String(i++);
+    return i;
+  }, FOCUSABLE);
+  expect(sampled, "the walk reached some stops").toBeGreaterThan(4);
+
+  // A stop is photographed where a reader would see it: scrolled to the viewport's middle first
+  // (a ring below the fold paints nothing a screenshot can hold).
+  // Outside `reduce` the ring SKETCHES IN (its draw-on and the living mark's beats): two frames after
+  // focus it is still at opacity 0, and a read there judges the draw-in, not the indicator. The read
+  // waits for the document's finite animations to drain (the perpetual boil is infinite and excluded)
+  // and for the living mark's breath to end on pose 0 (`docSettled`).
+  const focusStop = async (i: number) => {
+    await page.evaluate((i) => {
+      const e = document.querySelector<HTMLElement>(`[data-gl16="${i}"]`);
+      e?.scrollIntoView({ block: "center", inline: "nearest" });
+      e?.focus({ preventScroll: true });
+    }, i);
+    await frames2(page);
+    await frames2(page);
+    await docSettled(page);
+  };
+  await page.keyboard.press("Tab");
+  const verdicts: (Verdict & { i: number })[] = [];
+  for (let i = 0; i < sampled; i++) {
+    await focusStop(i);
+    verdicts.push({ i, ...(await judgeStop(page, i)) });
+  }
+
+  console.log(
+    `[G-LIVE-16 ${regime.name}] ` +
+      verdicts.map((v) => `${v.who}:${v.judged ? (v.ok ? v.by : "NONE") : "-"}${JSON.stringify(v.paint)}~${v.noise ?? 0}`).join(" | "),
+  );
+  const judged = verdicts.filter((v) => v.judged);
+  // A stop that refused focus, or took it without `:focus-visible`, is not judged — so an engine
+  // where nothing is judged would green this row on an empty list.
+  expect(judged.length, "stops actually focused and matching :focus-visible").toBeGreaterThan(4);
+  expect(
+    judged.filter((v) => !v.stranded && !v.ok).map((v) => `${v.who} ${JSON.stringify(v.paint)}`),
+    "every judged estate stop PAINTS an indicator",
+  ).toEqual([]);
+
+  // THE PLANTS, one at a time over a stop the walk judged good by the form the plant attacks.
+  const drawnStop = verdicts.find((v) => v.ok && v.by === "drawn" && !v.stranded);
+  const boardStop = verdicts.find((v) => v.ok && v.by === "board" && !v.stranded);
+  expect(drawnStop, "the walk judged a stop good by its drawn ring").toBeDefined();
+  expect(boardStop, "the walk judged a cell good by the board's ink").toBeDefined();
+  const plants: [string, string, number][] = [
+    ["X1 the ring's ink deleted", ":root { --ring-ink: initial !important; }", drawnStop!.i],
+    ["X1b the ring's ink transparent", ".focus-ring, .focus-ring * { stroke: rgba(0,0,0,0) !important; color: transparent !important; }", drawnStop!.i],
+    ["X1c the ring at opacity 0", ".focus-ring { opacity: 0 !important; }", drawnStop!.i],
+    ["X2 the living cell's ghost at opacity 0", ".cell-ghost.is-active { opacity: 0 !important; }", boardStop!.i],
+    ["X2b the ghost's stroke transparent", ".cell-ghost-path { stroke: rgba(0,0,0,0) !important; fill: none !important; }", boardStop!.i],
+    ...(regime.mq
+      ? ([
+          [`${regime.name.toUpperCase()}0 the ring at opacity 0 inside ${regime.mq}`, `@media ${regime.mq} { .focus-ring { opacity: 0 !important; } }`, drawnStop!.i],
+          [`${regime.name.toUpperCase()}0 the ghost at opacity 0 inside ${regime.mq}`, `@media ${regime.mq} { .cell-ghost.is-active { opacity: 0 !important; } }`, boardStop!.i],
+        ] as [string, string, number][])
+      : []),
+  ];
+  const planted: { plant: string; who: string; ok: boolean; paint: Verdict["paint"] }[] = [];
+  for (const [name, css, i] of plants) {
+    await page.evaluate((css) => {
+      const s = document.createElement("style");
+      s.dataset.gl16Plant = "";
+      s.textContent = css;
+      document.head.appendChild(s);
+    }, css);
+    await page.evaluate(() => (document.activeElement as HTMLElement | null)?.blur());
+    await focusStop(i);
+    const v = await judgeStop(page, i);
+    planted.push({ plant: name, who: v.who, ok: v.ok, paint: v.paint });
+    await page.evaluate(() => document.querySelectorAll("style[data-gl16-plant]").forEach((s) => s.remove()));
+  }
+  await page.evaluate(() => {
+    document.querySelector("[data-gl16-stranded]")?.remove();
+    for (const e of document.querySelectorAll<HTMLElement>("[data-gl16]")) delete e.dataset.gl16;
+  });
+  console.log(`[G-LIVE-16 ${regime.name} plants] ` + planted.map((p) => `${p.plant} on ${p.who}: ok=${p.ok} ${JSON.stringify(p.paint)}`).join(" | "));
+
+  const control = verdicts.find((v) => v.stranded);
+  expect(control?.judged, "the stranded control took focus and matched :focus-visible").toBe(true);
+  expect(control?.ok, "the stranded control is CAUGHT (else this row cannot fail)").toBe(false);
+  for (const p of planted) expect(p.ok, `${p.plant} turns ${p.who} RED (else this row cannot see paint)`).toBe(false);
+}
+
+// ── G-LIVE-19 ───────────────────────────────────────────────────────────────────────────
+//
+// The seams the ring reads from its host are REGISTERED, once each, with no `var(…, fallback)`
+// behind any of them anywhere, and each registration's value is the one that paints:
+//   · ONE HOME is counted in SOURCE, not assumed: every `@property` at every CSS site, comments
+//     stripped, tallied per name, and its brace depth read — a second registration of any name is
+//     RED, and so is one nested inside a rule (the bundler hoists it silently). The CSSOM cannot
+//     make this count: the compiler dedupes `@property`, so a duplicate in source reaches the page
+//     as one rule (measured: a second `--motion-note` block greened the CSSOM tally). The CSSOM
+//     walk (recursive; a style rule read BEFORE its nested rules) still proves each one SHIPPED.
+//   · NO MASKED DEFAULT is scanned for — in every site a value can be written from, read through
+//     the chair's shape-census library (LAWS P6 §F, the SHAPE law; one copy, imported): every SFC
+//     `<style>` block, every stylesheet under `src/` and `public/`, `index.html`, AND every
+//     template (`style="…"`, `:style` objects and strings) and every script (`setProperty`, style
+//     writes, string literals). Pass 6's scan read `<style>` alone and a masked default written as
+//     a template `style=` attribute of the lazy laminate stayed green (X5, chair A.5.5).
+//   · `--toggle-bleed`'s initial is a SENTINEL (9999px) no rung ever publishes, so the host
+//     must read its publisher's value (< 0); an absent publisher reds here, not silently.
+//   · `--motion-note`'s 250ms is read where it PAINTS: the marks' own scoped rule, on a probe
+//     that carries that rule's scope hash, computes `animation-duration: 0.25s`.
+// Nothing is wrapped in an `if`: a surface this route should carry and does not is a RED.
+
+/** Every site a value can be written from, per file, comments stripped by the ONE library's
+ *  string-aware strippers: `css` (style blocks, stylesheets, `index.html`'s `<style>`) and `code`
+ *  (templates and scripts). `plant` overlays one file's raw text in memory. */
+function sites(shape: any, plant?: { file: string; text: string }) {
+  const out: { file: string; css: string; code: string }[] = [];
+  for (const f of shape.sources(FE_ROOT) as string[]) {
+    const file = f.slice(FE_ROOT.length + 1).replace(/^src\//, "");
+    const text = plant && plant.file === file ? plant.text : readFileSync(f, "utf8");
+    if (f.endsWith(".vue")) {
+      const b = shape.sfc(text);
+      out.push({
+        file,
+        css: b.styles.map((x: any) => shape.stripCss(x.css)).join("\n"),
+        code: [b.template ? shape.stripHtml(b.template.text) : "", ...b.scripts.map((x: any) => shape.stripJs(x.text))].join("\n"),
+      });
+    } else if (shape.isCss(f)) out.push({ file, css: shape.stripCss(text), code: "" });
+    else if (f.endsWith(".html"))
+      out.push({
+        file,
+        css: [...text.matchAll(/<style[^>]*>([\s\S]*?)<\/style>/g)].map((m) => shape.stripCss(m[1])).join("\n"),
+        code: shape.stripHtml(text.replace(/<style[^>]*>[\s\S]*?<\/style>/g, "")),
+      });
+    else out.push({ file, css: "", code: f.endsWith(".json") ? text : shape.stripJs(text) });
+  }
+  return out;
+}
+
+/** THE MASKED-DEFAULT READ IS THE LIBRARY'S (`maskedDefaults`: `var(` matched case-insensitively,
+ *  string concatenation folded, a same-file const NAME folded, a `${}` stem expanded against the
+ *  registered names). A hit behind a registered name is a RED. A stem nothing resolves is a RED too,
+ *  as `UNRESOLVED <stem>`: a name the read cannot spell cannot be cleared (pass 8's code dropped it). */
