index 00000000..06d766a9
--- /dev/null
+++ b/web/frontend/src/pencil/chrome/FocusRing.vue
@@ -0,0 +1,328 @@
+<script setup lang="ts">
+/**
+ * ONE DRAWN RING OFF THE BOARD (T9-W7 §6).
+ *
+ * The board draws focus in its own hand (`gameCell.css` tier 2); everywhere else the estate
+ * drew it six different ways — a 2px solid here, a dashed one there, a `color-mix` 40% on the
+ * logo and 45% on the guard face — and three of those read under 3:1 on their ground. This is
+ * the one mark: the house hand as a px-native SVG rect on whatever has focus, four baked
+ * poses, ink `--color-focus-sketch`, `outlineBoilPx` 0.45. It is findable because it MOVES —
+ * one revolution on the shared beat when it lands, then rest — not because of its colour.
+ *
+ * It TAKES ITS TARGET rather than merely listening for one, in two ranks:
+ *   1. the owner the focused control DECLARES — `aria-activedescendant`. The deck is such a
+ *      listbox: DOM focus never leaves its 1056px scrollport, so a focusin-only ring frames
+ *      the scrollport and never moves on ArrowRight. The card is the owner, and the
+ *      accessibility tree already says so.
+ *   2. `document.activeElement` when it matches `:focus-visible`, read on capture
+ *      focusin/focusout.
+ *
+ * Position is EVENT-DRIVEN — capture-phase scroll, resize, and a ResizeObserver on the target.
+ * A rAF follower measured 255 repositions per 900ms of idle: a permanent subscriber, which is
+ * the exact shape `boilBeat.ts` exists to eliminate. The event form measured 4.
+ *
+ * IT TRAVELS WITH WHAT IT RINGS. None of those events fires for a WAAPI transform, so while an
+ * animation is running on the target's own ancestor path the ring follows per frame and stops
+ * the frame the last one ends (`settle()`). That is the whole clock: no duration constant.
+ */
+import { computed, onBeforeUnmount, onMounted, ref } from "vue";
+import { generateRectBoilFrames } from "@pencil/grid/gridPaths";
+import { BOIL_CONFIG, FILTER_PRESETS } from "@pencil/config/pencilConfig";
+import { useMarkPose } from "@pencil/composables/boilBeat";
+
+/** The board has its own hand; the deck's scrollport is never the owner (its card is). */
+const EXEMPT = ".cell-native-input, .gallery-viewport";
+/** What a scrollport hands the ring instead of nothing: the option a reader can act on. */
+const FIRST_OPTION = '[role="option"], .game-card.is-center';
+const STROKE = 2.5;
+
+const target = ref<Element | null>(null);
+const rect = ref<DOMRect | null>(null);
+/** THE GEOMETRY, NOT THE BOX. The four poses depend on the SHAPE — width, height, and the
+ *  host's declared outset — and on nothing else, so a box that merely travels re-positions one
+ *  `<svg>` instead of re-baking four identical `d` strings (a deck landing did that 23–36
+ *  times, every one of them discarded). */
+const geom = ref({ w: 0, h: 0, outset: 0, cl: 0, cr: 0 });
+
+// One revolution when it lands, then rest — the board's breath, off the board.
+const pose = useMarkPose(() => target.value);
+
+/** The ring's own box: the target's plus the outset, less what the page's edges clip. */
+const ringW = computed(
+  () => geom.value.w + geom.value.outset * 2 - geom.value.cl - geom.value.cr,
+);
+const ringH = computed(() => geom.value.h + geom.value.outset * 2);
+const viewBox = computed(() => `0 0 ${ringW.value} ${ringH.value}`);
+
+// Same bake the board's outline uses (T3-W13 §1-P2): the grain is folded into the geometry,
+// so the poses render as filterless siblings and the census does not move.
+const frames = computed(() => {
+  const { w: rw, h: rh, outset: o, cl, cr } = geom.value;
+  // A geometry that is not a geometry bakes nothing. `--focus-ring-outset` has ONE home, its
+  // registration's `initial-value` (index.css), and no JS fallback stands behind it: delete the
+  // registration and an undeclared host hands back an empty string, `o` is NaN, and the ring
+  // vanishes instead of quietly drawing a house default nobody published. The OUTSET box is the
+  // geometry, not the element's: an outset that swallows the box (the toggle's bleed sentinel,
+  // index.css) must bake nothing too — an `<svg>` given a negative width falls back to 300×150 in
+  // WebKit and paints a ring the size of nothing on the page.
+  const w = rw + o * 2 - cl - cr;
+  const h = rh + o * 2;
+  if (!(rw > 0 && rh > 0 && Number.isFinite(o) && w > STROKE && h > STROKE)) return [];
+  return generateRectBoilFrames(
+    STROKE / 2,
+    STROKE / 2,
+    w - STROKE,
+    h - STROKE,
+    { roughness: 0.5, segments: 6, seed: 77, jagged: true },
+    BOIL_CONFIG.outlineBoilPx,
+    BOIL_CONFIG.frameCount,
+    0,
+    FILTER_PRESETS["grain-outline"]?.grain,
+  );
