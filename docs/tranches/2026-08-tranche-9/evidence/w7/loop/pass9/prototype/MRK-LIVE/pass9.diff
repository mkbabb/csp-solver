+  TAILWIND,
+  TAILWIND_ALL,
+  candidates,
+  attrsOf,
+  templateSites,
+  consumerSites,
+  hasCompound,
+  scriptWrites,
+  scriptCss,
+  cssBlocks,
+  rulesOf,
+  census,
+  tokens,
+  tokenConflicts,
+  stemMatches,
+  resolve,
+  varRefs,
+  maskedDefaults,
+  tokenSites,
+  publishers,
