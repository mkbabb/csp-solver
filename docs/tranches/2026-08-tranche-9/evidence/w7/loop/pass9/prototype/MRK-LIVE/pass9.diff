+// ----------------------------------------------------------------------------------- II. recorder
+export const loadArr = () => loadStr().split(" ").map(Number);
+
+/** Page-side: the painted timeline. `sel` (optional) is read post-paint each frame. */
+export function installTimeline(sel) {
+  const w = window;
+  const read = () => {
+    if (!sel) return null;
+    if (sel.startsWith("ruled:")) {
+      const els = [...document.querySelectorAll(sel.slice(6))];
+      if (!els.length) return null;
+      let s = 0;
+      for (const e of els) {
+        const d = e.style.strokeDasharray,
+          o = parseFloat(e.style.strokeDashoffset);
+        if (d === "none") s += 1;
+        else if (d) s += Math.max(0, Math.min(1, 1 - (isNaN(o) ? 0 : o) / parseFloat(d)));
+      }
+      return { x: +s.toFixed(4), y: 0, w: 0, h: 0, ct: null };
+    }
+    if (sel.startsWith("len:")) {
+      // ACC-FIVE pass 8 (PROPOSED → the ONE copy): the DRAWN LENGTH over every match — a front cut
+      // as geometry (`poseFronts`) has no dash to read, so `ruled:` reads it whole. Per match:
+      // getTotalLength() × the dash's drawn fraction (1 − offset / first dash, both in the path's
+      // own `pathLength` units, from the COMPUTED style, so an attribute dash counts; `none` = 1).
+      // x = the summed drawn length, y = the match count (a class the product toggles counts).
+      const els = [...document.querySelectorAll(sel.slice(4))];
+      let s = 0;
+      for (const e of els) {
+        let L;
+        try {
+          L = e.getTotalLength();
+        } catch {
+          L = 0;
+        }
+        const cs = getComputedStyle(e);
+        const dash = cs.strokeDasharray && cs.strokeDasharray !== "none" ? parseFloat(cs.strokeDasharray) : NaN;
+        const off = parseFloat(cs.strokeDashoffset) || 0;
+        s += Number.isFinite(dash) && dash > 0 ? L * Math.max(0, Math.min(1, 1 - off / dash)) : L;
+      }
+      return { x: +s.toFixed(2), y: els.length, w: 0, h: 0, ct: null };
+    }
+    if (sel.startsWith("range:")) {
+      // ACC-SIX pass 8 (PROPOSED → the ONE copy): the TEXT RANGE of the first match — the rect its
+      // text paints, never its box. A line laid in a zero-height box (the strip's yielding meta)
+      // reads h 0 as a selector at every pose; its text can still paint a row below (LAWS P7 §E:
+      // a painted-text gate on a 0 px box clips to the Range).
+      const el = document.querySelector(sel.slice(6));
+      if (!el) return null;
+      const rg = document.createRange();
+      rg.selectNodeContents(el);
+      const b = rg.getBoundingClientRect();
+      return { x: +b.left.toFixed(2), y: +b.top.toFixed(2), w: +b.width.toFixed(2), h: +b.height.toFixed(2), ct: null };
+    }
+    if (sel.startsWith("css:")) {
+      const i = sel.lastIndexOf(":");
+      const el = document.querySelector(sel.slice(4, i));
+      return el ? { x: getComputedStyle(el).getPropertyValue(sel.slice(i + 1)), y: 0, w: 0, h: 0, ct: null } : null;
+    }
+    const el = document.querySelector(sel);
+    if (!el) return null;
+    const r = el.getBoundingClientRect();
+    const a = el.getAnimations?.().find((x) => x.playState === "running" || x.playState === "paused");
+    return { x: +r.left.toFixed(2), y: +r.top.toFixed(2), w: +r.width.toFixed(2), h: +r.height.toFixed(2), ct: a ? Number(a.currentTime ?? NaN) : null };
+  };
+  w.__pf = { rafs: [], post: [], on: true, origin: performance.timeOrigin };
+  const tick = (ts) => {
+    if (!w.__pf.on) return;
+    const k = w.__pf.rafs.length;
+    w.__pf.rafs.push({ k, ts });
+    setTimeout(() => w.__pf.post.push({ k, t: performance.now(), r: read() }), 0);
+    requestAnimationFrame(tick);
+  };
+  requestAnimationFrame(tick);
+}
+
+/** Per-photograph mean |Δ| of the ROI's grey (0.2126 R + 0.7152 G + 0.0722 B on the encoded values)
+ *  against the previous photograph, decoded IN A PAGE of the recording's own browser (createImageBitmap
+ *  → OffscreenCanvas): no image package (the pass-7 copy leaned on `sharp`, which this package does not
+ *  declare). A photograph that fails to decode is skipped as the previous one's ground, never read as 0. */
+async function photoDeltas(browser, frames, roi) {
+  const ctx = await browser.newContext();
+  const page = await ctx.newPage();
+  await page.evaluate(() => (window.__prev = null));
+  const out = [];
+  for (let i = 0; i < frames.length; i += 12) {
+    const batch = frames.slice(i, i + 12).map((f) => f.buf.toString("base64"));
+    const ds = await page.evaluate(
+      async ({ batch, roi }) => {
+        const res = [];
+        for (const b64 of batch) {
+          let g;
+          try {
+            const bin = Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
+            const bmp = await createImageBitmap(new Blob([bin]));
+            const r = roi ?? { left: 0, top: 0, width: bmp.width, height: bmp.height };
+            const w = Math.max(1, Math.min(r.width, bmp.width - r.left)),
+              h = Math.max(1, Math.min(r.height, bmp.height - r.top));
+            const c = new OffscreenCanvas(w, h).getContext("2d");
+            c.drawImage(bmp, -r.left, -r.top);
+            const d = c.getImageData(0, 0, w, h).data;
+            g = new Float32Array(w * h);
+            for (let j = 0, k = 0; j < d.length; j += 4, k++) g[k] = 0.2126 * d[j] + 0.7152 * d[j + 1] + 0.0722 * d[j + 2];
+          } catch {
+            g = null;
+          }
+          const p = window.__prev;
+          let m = null;
+          if (p && g) {
+            if (p.length !== g.length) m = Infinity;
+            else {
+              let t = 0;
+              for (let k = 0; k < g.length; k++) t += Math.abs(p[k] - g[k]);
+              m = t / g.length;
+            }
+          }
+          res.push(m);
+          if (g) window.__prev = g;
+        }
+        return res;
+      },
+      { batch, roi },
+    );
+    out.push(...ds);
+  }
+  await ctx.close();
+  return out;
+}
+
+/** Start the photograph track. Returns stop() → [{t (epoch ms), buf}]. */
+export async function startPhotos(page, engine, size) {
+  const frames = [];
+  if (engine === "chromium") {
+    const cdp = await page.context().newCDPSession(page);
+    cdp.on("Page.screencastFrame", async (f) => {
+      frames.push({ t: f.metadata.timestamp * 1000, buf: Buffer.from(f.data, "base64") });
+      try {
+        await cdp.send("Page.screencastFrameAck", { sessionId: f.sessionId });
+      } catch {
+        /* the session closed under the ack */
+      }
+    });
+    await cdp.send("Page.startScreencast", { format: "jpeg", quality: 90, everyNthFrame: 1, maxWidth: size.width, maxHeight: size.height });
+    return async () => {
+      await cdp.send("Page.stopScreencast");
+      await cdp.detach().catch(() => {});
+      return frames;
+    };
+  }
+  // WebKit's frame timestamp is a monotonic clock, not the epoch: align it by the least-delayed arrival.
+  await page.screencast.start({ size, quality: 90, onFrame: ({ data, timestamp }) => frames.push({ ts: timestamp, arr: Date.now(), buf: data }) });
+  return async () => {
+    await page.screencast.stop();
+    const off = Math.min(...frames.map((f) => f.arr - f.ts));
+    return frames.map((f) => ({ t: f.ts + off, buf: f.buf }));
+  };
+}
+
+export function stat(a) {
+  if (!a.length) return null;
+  const s = [...a].sort((p, q) => p - q);
+  return { n: s.length, min: +s[0].toFixed(1), median: +s[s.length >> 1].toFixed(1), p95: +s[Math.floor(s.length * 0.95)].toFixed(1), max: +s[s.length - 1].toFixed(1) };
+}
+
+/** Analyse photographs: per-frame ROI Δ, the motion window, held intervals. `scale` maps CSS px → frame
+ *  px; `browser` decodes the photographs (photoDeltas). */
+export async function analysePhotos(browser, frames, roiCss, scale = 1, eps = 0.35, t0 = -Infinity, t1 = Infinity) {
+  const roi = roiCss ? { left: Math.max(0, Math.round(roiCss.x * scale)), top: Math.max(0, Math.round(roiCss.y * scale)), width: Math.max(1, Math.round(roiCss.w * scale)), height: Math.max(1, Math.round(roiCss.h * scale)) } : null;
+  const inWin = frames.filter((x) => x.t >= t0 - 60 && x.t <= t1 + 60);
+  const pd = await photoDeltas(browser, inWin, roi);
+  const rows = inWin.map((f, i) => ({ t: f.t, d: pd[i] == null ? null : Number.isFinite(pd[i]) ? +pd[i].toFixed(4) : pd[i] }));
+  const changed = rows.filter((r) => r.d != null && r.d > eps && r.t >= t0 && r.t <= t1 + 40);
+  const gaps = rows.slice(1).map((r, i) => r.t - rows[i].t);
+  let maxHeld = 0,
+    heldAt = null;
+  const intervals = [];
+  for (let i = 1; i < changed.length; i++) {
+    const h = changed[i].t - changed[i - 1].t;
+    intervals.push([changed[i - 1].t, changed[i].t]);
+    if (h > maxHeld) {
+      maxHeld = h;
+      heldAt = changed[i - 1].t;
+    }
+  }
+  const ds = rows.map((r) => r.d).filter((d) => d != null && Number.isFinite(d));
+  return {
+    photos: rows.length,
+    changed: changed.length,
+    eps,
+    deltaMedian: ds.length ? +[...ds].sort((a, b) => a - b)[ds.length >> 1].toFixed(4) : null,
+    windowMs: changed.length ? +(changed[changed.length - 1].t - changed[0].t).toFixed(1) : 0,
+    firstChange: changed[0]?.t ?? null,
+    gapMs: stat(gaps),
+    maxHeldMs: +maxHeld.toFixed(1),
+    heldAt,
+    intervals,
+    deltas: rows.map((r) => [+(r.t - (rows[0]?.t ?? 0)).toFixed(1), r.d]),
+  };
+}
+
+/** Timeline analysis inside [t0, t1] (epoch ms): rAF gaps, max held gap. */
+export function analyseTimeline(pf, t0, t1) {
+  const rafs = pf.rafs.map((r) => ({ ...r, e: pf.origin + r.ts })).filter((r) => r.e >= t0 && r.e <= t1);
+  const gaps = rafs.slice(1).map((r, i) => r.e - rafs[i].e);
+  let maxGap = 0,
+    at = null;
+  const intervals = [];
+  for (let i = 1; i < rafs.length; i++) {
+    const g = rafs[i].e - rafs[i - 1].e;
+    intervals.push([rafs[i - 1].e, rafs[i].e]);
+    if (g > maxGap) {
+      maxGap = g;
+      at = rafs[i - 1].e;
+    }
+  }
+  return { rafs: rafs.length, gapMs: stat(gaps), maxGapMs: +maxGap.toFixed(1), at, intervals };
+}
+
+/** The clock self-test: a CSS spinner (compositor) + a main-thread `left` mover on a blank page. */
+export async function clockSelfTest(browser, engine, viewport = { width: 800, height: 600 }) {
+  const ctx = await browser.newContext({ viewport });
+  const page = await ctx.newPage();
+  await page.setContent(
+    `<style>body{margin:0;background:#fff}.s{position:absolute;left:300px;top:200px;width:80px;height:80px;border:8px solid #333;border-top-color:transparent;border-radius:50%;animation:r .6s linear infinite}.m{position:absolute;top:400px;width:40px;height:40px;background:#333;animation:m 1s linear infinite alternate}@keyframes r{to{transform:rotate(360deg)}}@keyframes m{from{left:0}to{left:700px}}</style><div class="s"></div><div class="m"></div>`,
+  );
+  await page.evaluate(installTimeline, null);
+  await page.waitForTimeout(300);
+  const stop = await startPhotos(page, engine, viewport);
+  const t0 = Date.now();
+  await page.waitForTimeout(1200);
+  const frames = await stop();
+  const pf = await page.evaluate(() => window.__pf);
+  await ctx.close();
+  const w = frames.filter((f) => f.t >= frames[0].t + 100 && f.t <= frames[0].t + 1100);
+  const tl = analyseTimeline(pf, t0 + 100, t0 + 1100);
+  return { photosPerSec: w.length, photoGapMs: stat(w.slice(1).map((f, i) => f.t - w[i].t)), rafPerSec: tl.rafs, rafGapMs: tl.gapMs, load: loadArr() };
+}
+
+/** One recording. o: url | html, viewport, dpr, scheme, trigger, roi, subject, windowMs, eps, heldMs,
+ *  plant {busyMs, delayMs}, ready, touch, settleMs. */
+export async function record(browser, engine, o) {
+  const ctx = await browser.newContext({ viewport: o.viewport, deviceScaleFactor: o.dpr ?? 1, colorScheme: o.scheme ?? "light", reducedMotion: "no-preference", hasTouch: !!o.touch });
+  const page = await ctx.newPage();
+  const onLoad = o.trigger === "load"; // the page's own boot motion (the draw-in, M20): record from navigation
+  let roi, stop, tTrig;
+  const box = async () => {
+    const b = o.roi ? await page.locator(o.roi).first().boundingBox() : null;
+    return b ? { x: b.x, y: b.y, w: b.width, h: b.height } : null;
+  };
+  if (onLoad) {
+    await page.addInitScript(installTimeline, o.subject ?? null);
+    if (o.plant?.busyMs)
+      await page.addInitScript(({ busyMs, delayMs }) => {
+        setTimeout(() => {
+          const t = performance.now();
+          while (performance.now() - t < busyMs);
+          window.__plantRan = performance.timeOrigin + t;
+        }, delayMs);
+      }, o.plant);
+    await page.goto("about:blank");
+    stop = await startPhotos(page, engine, o.viewport);
+    tTrig = Date.now();
+    await page.goto(o.url);
+    if (o.ready) await page.locator(o.ready).first().waitFor({ timeout: 30000 });
+    roi = await box();
+  } else {
+    if (o.html) await page.setContent(o.html);
+    else await page.goto(o.url);
+    if (o.ready) await page.locator(o.ready).first().waitFor({ timeout: 30000 });
+    await page.evaluate(() => document.fonts.ready);
+    await page.waitForTimeout(o.settleMs ?? 1500);
+    roi = await box();
+    await page.evaluate(installTimeline, o.subject ?? null);
+    stop = await startPhotos(page, engine, o.viewport);
+    await page.waitForTimeout(250);
+    if (o.plant?.busyMs)
+      await page.evaluate(({ busyMs, delayMs }) => {
+        window.__plantArm = () =>
+          setTimeout(() => {
+            const t = performance.now();
+            while (performance.now() - t < busyMs);
+            window.__plantRan = performance.timeOrigin + t;
+          }, delayMs);
+      }, o.plant);
+    tTrig = Date.now();
+    if (o.plant?.busyMs) await page.evaluate(() => window.__plantArm());
+    if (o.trigger?.startsWith("key:")) await page.keyboard.press(o.trigger.slice(4));
+    else if (o.trigger?.startsWith("click:")) await page.locator(o.trigger.slice(6)).first().click();
+  }
+  await page.waitForTimeout(o.windowMs ?? 1200);
+  const frames = await stop();
+  const pf = await page.evaluate(() => {
+    window.__pf.on = false;
+    return { ...window.__pf, plantRan: window.__plantRan ?? null };
+  });
+  await ctx.close();
+  // The motion window: trigger → the last post-paint frame whose subject read moved. With no subject,
+  // trigger → trigger + window. Intervals between consecutive subject changes are the painted
+  // timeline's held intervals (webkit's primary track; chromium prints it beside the photographs).
+  let tEnd = tTrig + (o.windowMs ?? 1200),
+    tStart = tTrig,
+    moved = 0;
+  const mv = [];
+  if (o.subject) {
+    const reads = pf.post.map((p) => ({ e: pf.origin + p.t, r: p.r })).filter((p) => p.e >= tTrig && p.r);
+    let first = null,
+      last = null;
+    for (let i = 1; i < reads.length; i++) {
+      const a = reads[i - 1].r,
+        b = reads[i].r;
+      if (a.x !== b.x || a.y !== b.y || a.w !== b.w || a.h !== b.h) {
+        if (first == null) {
+          first = reads[i - 1].e;
+          mv.push(first);
+        }
+        mv.push(reads[i].e);
+        last = reads[i].e;
+        moved++;
+      }
+    }
+    tStart = first ?? tTrig;
+    tEnd = last ?? tTrig;
+  }
+  const subjIv = mv.slice(1).map((t, i) => [mv[i], t]);
+  const subjMax = subjIv.reduce((m, [a, b]) => Math.max(m, b - a), 0);
+  // chromium CDP photographs arrive at the viewport's CSS size (maxWidth = viewport) → scale 1.
+  const ph = await analysePhotos(browser, frames, roi, 1, o.eps ?? 0.35, tStart, tEnd);
+  const tl = analyseTimeline(pf, tStart, tEnd);
+  const heldList = (iv, floor) => iv.filter(([a, b]) => b - a >= floor).map(([a, b]) => [+(a - tTrig).toFixed(1), +(b - a).toFixed(1)]);
+  const plantAt = pf.plantRan ? pf.plantRan - tTrig : null;
+  const seen = (iv) => plantAt != null && iv.some(([a, b]) => b - a >= 0.9 * o.plant.busyMs && a - tTrig <= plantAt + 20 && b - tTrig >= plantAt + o.plant.busyMs - 20);
+  const floor = o.heldMs ?? 50;
+  return {
+    engine,
+    trigger: o.trigger,
+    roi,
+    held: { photo: heldList(ph.intervals, floor), rAF: heldList(tl.intervals, floor), subject: heldList(subjIv, floor) },
+    subjectMaxMs: +subjMax.toFixed(1),
+    plantSeen: o.plant ? { photo: seen(ph.intervals), rAF: seen(tl.intervals), subject: seen(subjIv) } : null,
+    subjectMovedFrames: moved,
+    motionMs: +(tEnd - tStart).toFixed(1),
+    latencyMs: +(tStart - tTrig).toFixed(1),
+    plant: o.plant ?? null,
+    plantRanAt: pf.plantRan ? +(pf.plantRan - tTrig).toFixed(1) : null,
+    photos: { ...ph, intervals: undefined },
+    timeline: { ...tl, intervals: undefined },
+    load: loadArr(),
+  };
+}
+
+/** The verdict of one recording: chromium's primary track = photographs; webkit's = the subject (or rAF). */
+export function verdict(r, engine, { held = 50, subject = null } = {}) {
+  const primary = engine === "chromium" ? r.photos.maxHeldMs : subject ? r.subjectMaxMs : r.timeline.maxGapMs;
+  const empty = engine === "chromium" ? r.photos.changed < 2 : subject ? r.subjectMovedFrames < 1 : r.timeline.rafs < 2;
+  return { red: empty || primary >= held, empty, primary, track: engine === "chromium" ? "photo" : subject ? "subject" : "rAF" };
+}
+
+/** The rAF-frozen photograph ladder: replay, pause every animation in rAF k after the trigger, photograph. */
+export async function ladder(browser, o, K = 4) {
+  const out = [];
+  for (let k = 1; k <= K; k++) {
+    const ctx = await browser.newContext({ viewport: o.viewport, deviceScaleFactor: o.dpr ?? 1, colorScheme: o.scheme ?? "light", reducedMotion: "no-preference", hasTouch: !!o.touch });
+    const page = await ctx.newPage();
+    await page.goto(o.url);
+    if (o.ready) await page.locator(o.ready).first().waitFor({ timeout: 30000 });
+    await page.evaluate(() => document.fonts.ready);
+    await page.waitForTimeout(o.settleMs ?? 1500);
+    await page.evaluate(
+      ({ k, sel }) => {
+        const w = window;
+        w.__lad = null;
+        let n = 0;
+        // frame 1 = the first rAF in which the SUBJECT carries a running or paused (held) animation
+        const live = () => {
+          if (!sel) return true;
+          const el = document.querySelector(sel);
+          return !!el?.getAnimations().some((a) => a.playState === "running" || a.playState === "paused");
+        };
+        const arm = () =>
+          requestAnimationFrame(function f() {
+            if (!live() && n === 0) return requestAnimationFrame(f);
+            if (++n < k) return requestAnimationFrame(f);
+            const anims = document.getAnimations();
+            anims.forEach((a) => a.pause());
+            const el = sel ? document.querySelector(sel) : null;
+            const r = el?.getBoundingClientRect();
+            w.__lad = { k, anims: anims.length, ct: anims.map((a) => Number(a.currentTime ?? NaN)).slice(0, 4), rect: r ? [r.left, r.top, r.width, r.height].map((v) => +v.toFixed(2)) : null };
+          });
+        addEventListener("keydown", arm, { once: true, capture: true });
+        addEventListener("pointerdown", arm, { once: true, capture: true });
+      },
+      { k, sel: o.subject ?? null },
+    );
+    if (o.trigger?.startsWith("key:")) await page.keyboard.press(o.trigger.slice(4));
+    else if (o.trigger?.startsWith("click:")) await page.locator(o.trigger.slice(6)).first().click();
+    await page.waitForFunction(() => window.__lad, null, { timeout: 5000 }).catch(() => {});
+    const lad = await page.evaluate(() => window.__lad);
+    const shot = o.roi ? await page.locator(o.roi).first().screenshot().catch(() => null) : await page.screenshot();
+    out.push({ ...lad, shotBytes: shot?.length ?? 0, shotSha: shot ? crypto.createHash("sha1").update(shot).digest("hex").slice(0, 10) : null });
+    await ctx.close();
+  }
+  return out;
+}
+
+/** The recorder's self-test beyond the clock: VERB's two extensions, each with its plant.
+ *  RULED: 21 lines ruled one after another (inline dash offsets from a rAF loop); `ruled:.rl` must see
+ *  the motion, the legacy subject `.rl` (the first line's rect) reads EMPTY.
+ *  EPS (chromium: photographs are its primary track): a 2 px stroke growing 3 px per frame across a
+ *  640 × 360 ROI; at eps 0.35 the window is EMPTY, at `--eps 0.001` it is seen, and a 150 ms busy plant
+ *  inside it reds the held clause.
+ *  LEN (ACC-FIVE pass 8, PROPOSED): `#grow` is cut as geometry; `len:#grow` sees it, `ruled:#grow` is EMPTY.
+ *  RANGE (ACC-SIX pass 8, PROPOSED): a zero-height box's text wraps; `range:#m` sees it, `#m` is EMPTY. */
+const RULED = `<!doctype html><html><head><style>body{margin:0;background:#fbf8f1}svg{position:absolute;left:20px;top:20px}</style></head><body>
+<svg width="640" height="360" id="roi">${Array.from({ length: 21 }, (_, i) => `<line class="rl" x1="10" x2="630" y1="${12 + i * 16}" y2="${12 + i * 16}" stroke="#3b3833" stroke-width="2" style="stroke-dasharray: 620; stroke-dashoffset: 620"/>`).join("")}
+<line id="grow" x1="10" x2="10" y1="350" y2="350" stroke="#3b3833" stroke-width="2"/></svg>
+<script>
+  addEventListener("keydown", (e) => {
+    const t0 = performance.now();
+    if (e.key === "r") {
+      const ls = [...document.querySelectorAll(".rl")];
+      const f = () => { const u = (performance.now() - t0) / 30; ls.forEach((l, i) => l.style.strokeDashoffset = String(620 * (1 - Math.max(0, Math.min(1, u - i))))); if (u < ls.length) requestAnimationFrame(f); };
+      requestAnimationFrame(f);
+    }
+    if (e.key === "g") {
+      const g = document.getElementById("grow");
+      const f = () => { const x = 10 + Math.min(600, ((performance.now() - t0) / 16.7) * 3); g.setAttribute("x2", String(x)); if (x < 610) requestAnimationFrame(f); };
+      requestAnimationFrame(f);
+    }
+  });
+</script></body></html>`;
+
+const RANGE = `<!doctype html><html><head><style>body{margin:0;background:#fbf8f1;font:16px/20px sans-serif}#w{width:600px;margin:20px}#m{height:0}</style></head><body>
+<div id="w"><p id="m">one two three four five six seven eight nine ten</p></div>
+<script>addEventListener("keydown", (e) => { if (e.key === "w") setTimeout(() => (document.getElementById("m").style.wordSpacing = "60px"), 150); });</script></body></html>`;
+
+export async function recorderSelfTest(browser, engine) {
+  const rows = [];
+  let hole = false;
+  const base = { html: RULED, viewport: { width: 700, height: 420 }, settleMs: 200, windowMs: 1000, heldMs: 50 };
+  const ruled = await record(browser, engine, { ...base, trigger: "key:r", subject: "ruled:.rl" });
+  const legacy = await record(browser, engine, { ...base, trigger: "key:r", subject: ".rl" });
+  if (ruled.subjectMovedFrames < 10) hole = true;
+  rows.push(`RECORDER self-test ${engine} RULED ruled:.rl moved ${ruled.subjectMovedFrames} frames over ${ruled.motionMs} ms (subject max interval ${ruled.subjectMaxMs} ms) ${ruled.subjectMovedFrames >= 10 ? "SEEN" : "NOT SEEN ← a hole"} | LEGACY .rl moved ${legacy.subjectMovedFrames} ${legacy.subjectMovedFrames < 1 ? "EMPTY ← the hole ruled: closes" : "(seen)"}`);
+  // LEN (ACC-FIVE pass 8, PROPOSED): a stroke cut as GEOMETRY (`#grow`'s x2, no dash) — `len:#grow`
+  // must see it grow; `ruled:#grow` reads no dash and is EMPTY (the hole `len:` closes).
+  const len = await record(browser, engine, { ...base, trigger: "key:g", subject: "len:#grow" });
+  const lenRuled = await record(browser, engine, { ...base, trigger: "key:g", subject: "ruled:#grow" });
+  if (len.subjectMovedFrames < 10 || lenRuled.subjectMovedFrames >= 1) hole = true;
+  rows.push(`RECORDER self-test ${engine} LEN len:#grow moved ${len.subjectMovedFrames} frames over ${len.motionMs} ms ${len.subjectMovedFrames >= 10 ? "SEEN" : "NOT SEEN ← a hole"} | ruled:#grow moved ${lenRuled.subjectMovedFrames} ${lenRuled.subjectMovedFrames < 1 ? "EMPTY ← the hole len: closes" : "(seen ← the fixture no longer cuts by geometry)"}`);
+  // RANGE (ACC-SIX pass 8, PROPOSED): a line in a ZERO-HEIGHT box wraps to a second row on 'w';
+  // `range:#m` must see its text move, the selector `#m` (the box: same x, y, w and h 0 at both poses)
+  // reads EMPTY.
+  const rng = await record(browser, engine, { ...base, html: RANGE, trigger: "key:w", subject: "range:#m" });
+  const rngBox = await record(browser, engine, { ...base, html: RANGE, trigger: "key:w", subject: "#m" });
+  if (rng.subjectMovedFrames < 1 || rngBox.subjectMovedFrames >= 1) hole = true;
+  rows.push(`RECORDER self-test ${engine} RANGE range:#m moved ${rng.subjectMovedFrames} frames ${rng.subjectMovedFrames >= 1 ? "SEEN" : "NOT SEEN ← a hole"} | #m moved ${rngBox.subjectMovedFrames} ${rngBox.subjectMovedFrames < 1 ? "EMPTY ← the hole range: closes" : "(seen ← the fixture's box moves)"}`);
+  if (engine === "chromium") {
+    const e35 = await record(browser, engine, { ...base, trigger: "key:g", roi: "#roi" });
+    const e1 = await record(browser, engine, { ...base, trigger: "key:g", roi: "#roi", eps: 0.001 });
+    const plant = await record(browser, engine, { ...base, trigger: "key:g", roi: "#roi", eps: 0.001, plant: { busyMs: 150, delayMs: 300 } });
+    const v35 = verdict(e35, engine),
+      v1 = verdict(e1, engine),
+      vp = verdict(plant, engine);
+    if (v1.red || !vp.red) hole = true;
+    rows.push(`RECORDER self-test ${engine} EPS eps 0.35: changed ${e35.photos.changed}/${e35.photos.photos} (Δ median ${e35.photos.deltaMedian}) → ${v35.red ? "RED" + (v35.empty ? " EMPTY" : "") : "GREEN"} ← the legacy threshold | eps 0.001: changed ${e1.photos.changed}/${e1.photos.photos} maxHeld ${e1.photos.maxHeldMs} ms → ${v1.red ? "RED ← a hole (clean)" : "GREEN"} | eps 0.001 + busy 150@300: maxHeld ${plant.photos.maxHeldMs} ms plant seen photo ${plant.plantSeen.photo ? "YES" : "NO"} → ${vp.red ? "RED" : "GREEN ← a hole"}`);
+  }
+  return { rows, exit: hole ? 3 : 0 };
+}
+
+// ------------------------------------------------------------------------------------------ CLI
+if (process.argv[1] && fileURLToPath(import.meta.url) === resolvePath(process.argv[1])) {
+  const A = args();
+  const engine = A.engine ?? "chromium";
+  if (A["sabotage-battery"]) {
+    // each sampler clause off in turn (POSTPAINT_SABOTAGE): the sampler self-test must RED
+    const { spawnSync } = await import("node:child_process");
+    let bad = 0;
+    for (const c of PP_CLAUSES) {
+      const r = spawnSync(process.execPath, [fileURLToPath(import.meta.url), "--self-test", "--sampler-only", "--reps", "1", "--engine", engine], { env: { ...process.env, POSTPAINT_SABOTAGE: c }, encoding: "utf8" });
+      const hit = (r.stdout ?? "").split("\n").filter((l) => /← a hole|CLEAN.*→ RED/.test(l)).length;
+      console.log(`SABOTAGE ${engine} ${c.padEnd(10)} → exit ${r.status} ${r.status ? `RED (${hit} row(s))` : "GREEN — the clause has no plant"}`);
+      if (!r.status) bad++;
+    }
+    console.log(`POSTPAINT SABOTAGE BATTERY ${engine}: ${PP_CLAUSES.length - bad}/${PP_CLAUSES.length} clauses red the self-test when deleted · load ${loadStr()}`);
+    process.exit(bad ? 1 : 0);
+  }
+  const browser = await playwright()[engine].launch();
+  let exit;
+  if (A["self-test"]) {
+    const s = await samplerSelfTest(browser, { reps: +(A.reps ?? 3) });
+    for (const row of s.rows) console.log(`${engine} ${row}`);
+    if (A["sampler-only"]) {
+      console.log(`${engine} SAMPLER exit ${s.exit} · load ${loadStr()}`);
+      await browser.close();
+      process.exit(s.exit);
+    }
+    const st = await clockSelfTest(browser, engine);
+    const clock = engine === "chromium" ? st.photosPerSec : st.rafPerSec;
+    console.log(`${engine} RECORDER clock photos/s ${st.photosPerSec} rAF/s ${st.rafPerSec} clock ${clock} ${clock >= 55 ? "OK" : "BELOW 55"}`);
+    const r = await recorderSelfTest(browser, engine);
+    for (const row of r.rows) console.log(`${engine} ${row}`);
+    exit = Math.max(s.exit, r.exit);
+  } else if (A.recorder) {
+    const [vw, vh] = (A.viewport ?? "1280x800").split("x").map(Number);
+    const st = await clockSelfTest(browser, engine);
+    const clock = engine === "chromium" ? st.photosPerSec : st.rafPerSec;
+    console.log(`SELFTEST ${engine} photos/s ${st.photosPerSec} (gap ${JSON.stringify(st.photoGapMs)}) rAF/s ${st.rafPerSec} (gap ${JSON.stringify(st.rafGapMs)}) clock ${clock} ${clock >= 55 ? "OK" : "BELOW 55"} load ${st.load.join(" ")}`);
+    exit = clock >= 55 ? 0 : 2;
+    if (!A["selftest-only"]) {
+      const plant = A.plant ? (([b, d]) => ({ busyMs: +b, delayMs: +d }))(A.plant.replace(/^busy:/, "").split("@")) : null;
+      const held = +(A.held ?? 50);
+      const o = { heldMs: held, url: A.url, viewport: { width: vw, height: vh }, dpr: +(A.dpr ?? 1), scheme: A.scheme, trigger: A.trigger, roi: A.roi, subject: A.subject, windowMs: +(A.window ?? 1200), eps: A.eps ? +A.eps : undefined, plant, ready: A.ready, touch: A.touch === "1" };
+      const res = [];
+      for (let i = 0; i < +(A.runs ?? 1); i++) {
+        const r = await record(browser, engine, o);
+        res.push(r);
+        const v = verdict(r, engine, { held, subject: o.subject });
+        console.log(
+          `RECORD ${engine} run${i + 1} ${A.trigger} plant=${A.plant ?? "none"} plantAt+${r.plantRanAt ?? "-"}ms motion ${r.motionMs}ms from +${r.latencyMs}ms (${r.subjectMovedFrames} moved) | photos ${r.photos.photos} changed ${r.photos.changed} (eps ${r.photos.eps}) window ${r.photos.windowMs}ms maxHeld(photo) ${r.photos.maxHeldMs}ms | rAF ${r.timeline.rafs} maxGap(rAF) ${r.timeline.maxGapMs}ms | load ${r.load.join(" ")} | ${v.red ? "RED" : "GREEN"}${v.empty ? " (EMPTY motion window)" : ""} primary=${v.track} | held≥${held}ms [+at,dur] photo ${JSON.stringify(r.held.photo)} subject ${JSON.stringify(r.held.subject)} rAF ${JSON.stringify(r.held.rAF)}${r.plantSeen ? ` | PLANT SEEN photo ${r.plantSeen.photo ? "YES" : "NO"} subject ${r.plantSeen.subject ? "YES" : "NO"} rAF ${r.plantSeen.rAF ? "YES" : "NO"}` : ""}`,
+        );
+        if (exit === 0 && v.red) exit = 1;
+      }
+      if (A.ladder) for (const l of await ladder(browser, o, +A.ladder)) console.log(`LADDER ${engine} ${JSON.stringify(l)}`);
+      if (A.out) fs.writeFileSync(A.out, JSON.stringify({ selftest: st, runs: res.map((r) => ({ ...r, photos: { ...r.photos, deltas: r.photos.deltas.slice(0, 200) } })) }));
+    }
+  } else {
+    // the GA1-shaped row, generic: any mover, any trigger, the cells named
+    const CELLS = { desk: { name: "1280x800 fine", width: 1280, height: 800, hasTouch: false }, phone: { name: "390x844 coarse", width: 390, height: 844, hasTouch: true } };
+    const plant = A.plant ?? "";
+    let red = 0;
+    for (const c of (A.cells ?? "desk,phone").split(",")) {
+      const cell = CELLS[c];
+      for (let rep = 1; rep <= +(A.reps ?? 2); rep++) {
+        const { ctx, page } = await openCell(browser, { ...cell, colorScheme: A.scheme ?? "light", reducedMotion: "no-preference" });
+        if (plant === "skip") await ctx.addInitScript(SKIP_PLANT);
+        if (plant === "f2") await ctx.addInitScript(F2_PLANT, A.sel);
+        await page.goto(A.url);
+        await page.locator(A.ready ?? ".board-cells").first().waitFor({ timeout: 30000 });
+        await page.evaluate(() => document.fonts.ready);
+        await page.waitForTimeout(600);
+        const r = await readMover(page, { sel: A.sel, key: A.key ?? (A.click ? null : "g"), click: A.click ?? null });
+        await ctx.close();
+        if (r.post.red) red = 1;
+        console.log(`POSTPAINT ${engine} ${cell.name} r${rep} plant=${plant || "none"} io ${r.io} kPaint ${r.kPaint} | POST ${fmtArm(r.post)} | LEGACY ${fmtArm(r.legacy)} | inRAF ${fmtArm(r.inRAF)} | rAF2 ${fmtArm(r.rAF2)} → ${r.post.red ? "RED " + r.post.why.join("; ") : "GREEN"}`);
+      }
+    }
+    exit = plant ? (red ? 0 : 3) : red;
+    if (plant) console.log(`PLANT ${plant} ${red ? "RED (bites)" : "GREEN ← a hole"}`);
+  }
+  console.log(`LOAD ${loadStr()}`);
+  await browser.close();
+  process.exit(exit);
+}
