+    {
+      _swap: [
+        "@media (max-width: 1023.98px) {\n  .margin-note {",
+        "@media (min-width: 2000px) and (max-width: 1023.98px) {\n  .margin-note {",
+      ],
+    },
+    true,
+  ],
+  [
+    "NN `.margin-note-previous:not(.margin-note)` is not the voice",
+    "chair",
+    { tail: ".margin-note-previous:not(.margin-note) {\n  min-height: 0;\n}\n" },
+    false,
+  ],
+];
+function plantedFixture(over) {
+  const tree = mnFixture(over);
+  if (over._swap) {
+    const [a, b] = over._swap;
+    if (!tree["src/MarginNote.vue"].includes(a))
+      throw new Error(`plant anchor missing: ${a.slice(0, 40)}`);
