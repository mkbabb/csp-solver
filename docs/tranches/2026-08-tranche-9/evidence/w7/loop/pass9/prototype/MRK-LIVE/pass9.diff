+
+function measure() {
+  const el = target.value;
+  // THE RING NEVER OUTLIVES ITS REASON, AND NOT EVERY DEPARTURE SENDS AN EVENT. On a phone
+  // WebKit opens the dock sheet over the tab and focus falls to `document.body` with NO
+  // `focusout` on the path we listen to; nothing then re-reads the document, and the ring sat
+  // 341.5px from its box mid-glide and 504.92px away at settle (measured, 393x699 hasTouch,
+  // both this and the reversal). Chromium blanks correctly there, which is exactly why the
+  // check cannot live in a listener. Every path into the ring — event, observer, settle frame
+  // — runs through this function, so the departure is read here instead.
+  const live = document.activeElement;
+  if (el && (!el.isConnected || !live || live === document.body)) {
+    target.value = null;
+    ro?.disconnect();
+    rect.value = null;
+    return;
+  }
+  if (!el) {
+    rect.value = null;
+    return;
+  }
+  // `--focus-ring-outset` is registered as a <length> in index.css, so this reads px even
+  // when the host declares a calc() — and reads the registration's own initial value when the
+  // host declares nothing. No fallback lives here: one publisher, one home.
+  const o = parseFloat(getComputedStyle(el).getPropertyValue("--focus-ring-outset"));
+  const r = el.getBoundingClientRect();
+  if (!r.width && !r.height) {
+    rect.value = null;
+    return;
+  }
+  // A SIDE OFF THE PAGE IS NO SIDE (`focus-ring.spec.ts` G-LIVE-23). A stop flush with the
+  // viewport's edge puts a whole side of its ring past it, unpainted: the attribution tab sits at
+  // x 0 (its ring's left side drew at −3px) and the toggle's 54px ornament ends 2px past the right.
+  // The page never scrolls sideways, so the ring's box is clipped to the layout viewport's width
+  // and every side is drawn where a reader can see it.
+  const vw = document.documentElement.clientWidth;
+  const cl = Math.max(0, o - r.left);
+  const cr = Math.max(0, r.right + o - vw);
+  const g = geom.value;
+  if (
+    g.w !== r.width ||
+    g.h !== r.height ||
+    g.outset !== o ||
+    g.cl !== cl ||
+    g.cr !== cr
+  )
+    geom.value = { w: r.width, h: r.height, outset: o, cl, cr };
+  // Write only a box that actually moved: a fresh DOMRect every scroll frame is a new object
+  // and would wake every consumer of this ref for a rect that says the same thing.
+  const p = rect.value;
+  if (
+    p &&
+    p.left === r.left &&
+    p.top === r.top &&
+    p.width === r.width &&
+    p.height === r.height
+  )
+    return;
+  rect.value = r;
+}
+
+let ro: ResizeObserver | null = null;
+let owner: MutationObserver | null = null;
+let settling = 0;
+/** Which settle owns `settling`: an older chain reads a stale generation and returns. */
+let settleGen = 0;
+
+/** The target and every ancestor it hangs from: what moves the box is rarely the box. */
+function chain(el: Element): Element[] {
+  const out: Element[] = [];
+  for (let e: Element | null = el; e; e = e.parentElement) out.push(e);
+  return out;
+}
+
+/** The animations that can still move this target, read one level at a time (`getAnimations()`
+ *  without `subtree`), and only the ones that END: a perpetual boil on an ancestor would keep
+ *  the loop hunting forever. `document.getAnimations()` reads 1 at rest, so a document-wide
+ *  read is not a test for "in motion"; this path reads 0 at rest and 2 while the tab glides. */
+function running(el: Element): Animation[] {
+  return chain(el)
+    .flatMap((e) => e.getAnimations())
+    .filter((a) => Number.isFinite(a.effect?.getComputedTiming().endTime ?? Infinity));
+}
+
+/** A RING IS BOUNDED BY THE MOTION IT CHASES, NEVER BY A CLOCK. The box can travel without
+ *  firing `scroll`, `resize` or a ResizeObserver — pressing the dock's tab glides the tab and
+ *  its host 520ms under a WAAPI transform, and fires ZERO `transitionend`/`animationend` on
+ *  that path (measured, both engines). A duration bound guessed at that motion and missed it
+ *  by ~45ms; this one asks the target's own path what is running and stops the frame the last
+ *  one ends.
+ *
+ *  ONE CHAIN, ONE HANDLE. A first cut also awaited `Promise.allSettled(a.finished)` beside the
+ *  rAF; every frame of the glide armed another chain, 33 of them resolved in the frame the
+ *  animations ended, and one press cost 191 sweeps of this path in chromium (594 `getAnimations`
+ *  calls in a single frame) with `cancelAnimationFrame` provably unable to reach chains it never
+ *  created. The promise bought nothing the per-frame read does not already have, so it is gone
+ *  and a generation token retires an older loop when a newer `settle()` starts.
+ *
+ *  Two rules keep their reasons: the FIRST read is one frame late on purpose (the glide starts
+ *  in the button's own handler, after our capture listener — first animation visible at
+ *  t = 7ms chromium / 3ms webkit); three still frames after the set empties, because the drawer
+ *  re-flips its layout in `onSettle` after the last animation ends. Then this loop does not
+ *  exist. A reversal needs no special case: the dock retargets a mid-glide press by
+ *  `anim.reverse()`, so the SAME animation stays in the set with its rate flipped and the loop
+ *  keeps following it (`focus-ring.spec.ts` G-LIVE-4 samples every frame of that glide). */
+function settle() {
+  cancelAnimationFrame(settling);
+  const gen = ++settleGen;
+  let still = 0;
+  const step = () => {
+    const el = target.value;
+    if (!el || gen !== settleGen) return;
+    measure();
+    if (running(el).length) still = 0;
+    else if (++still >= 3) return;
+    settling = requestAnimationFrame(step);
+  };
+  settling = requestAnimationFrame(step);
+}
+
+function take(el: Element | null) {
+  if (el && (el.matches(EXEMPT) || !el.isConnected)) el = null;
+  // The revolution answers the LANDING (`useMarkPose` watches this ref), so the ref is written
+  // only for a NEW target and a re-measure of the same one never restarts it. The settle runs
+  // either way: a RESIDENT target is exactly the thing that moves when you press it.
+  if (el !== target.value) {
+    target.value = el;
+    ro?.disconnect();
+    if (el) ro?.observe(el);
+  }
+  measure();
+  if (el) settle();
+}
+
+function fromDocument() {
+  const a = document.activeElement;
+  if (!a || a === document.body || !a.matches(":focus-visible")) {
+    owner?.disconnect();
+    return take(null);
+  }
+  // Rank 1, THE OWNER IT DECLARES: an `aria-activedescendant` control keeps DOM focus on
+  // itself and names the option that is actually active (the deck's card, never its 1056px
+  // scrollport). The accessibility tree already carries that truth, so the ring reads it there
+  // instead of asking every such surface to hand over a ref — and it follows that truth when
+  // it changes, because an arrow key moves the active option without moving focus at all.
+  const owned = a.getAttribute("aria-activedescendant");
+  owner?.disconnect();
+  if (owned)
+    owner?.observe(a, {
+      attributes: true,
+      attributeFilter: ["aria-activedescendant"],
+    });
+  const el = (owned && document.getElementById(owned)) || a;
+  // A scrollport hands the ring its first option; an empty scrollport has nothing to act on
+  // and shows no ring. An exempt container that names no active descendant would otherwise
+  // take the ring to `null` and leave a focused reader with nothing at all — measured on the
+  // deck with the attribute removed, both engines, zero rings.
+  take(el.matches(EXEMPT) ? el.querySelector(FIRST_OPTION) : el);
+}
+
+const onFocusChange = () => fromDocument();
+/** The next focusin lands in the same task; read after it so a tab step never blanks. */
+const onFocusOut = () => requestAnimationFrame(fromDocument);
+const reposition = () => measure();
+/** ACTIVATION OF A RESIDENT TARGET. Focus does not move when you press the control it is
+ *  already on, so no focus event arrives and the box glides out from under the ring. `click`
+ *  fires for Enter and Space on a button as well as for a pointer, so this one capture-phase
+ *  listener covers every activation; the `aria-activedescendant` path already lands a new
+ *  target of its own. */
+const onActivate = (e: Event) => {
+  const el = target.value;
+  if (el && e.target instanceof Node && el.contains(e.target)) settle();
+};
+
+onMounted(() => {
+  ro = new ResizeObserver(reposition);
+  owner = new MutationObserver(fromDocument);
+  document.addEventListener("focusin", onFocusChange, true);
+  document.addEventListener("focusout", onFocusOut, true);
+  document.addEventListener("click", onActivate, true);
+  window.addEventListener("scroll", reposition, { capture: true, passive: true });
+  window.addEventListener("resize", reposition, { passive: true });
+});
+
+onBeforeUnmount(() => {
+  cancelAnimationFrame(settling);
+  ro?.disconnect();
+  owner?.disconnect();
+  document.removeEventListener("focusin", onFocusChange, true);
+  document.removeEventListener("focusout", onFocusOut, true);
+  document.removeEventListener("click", onActivate, true);
+  window.removeEventListener("scroll", reposition, true);
+  window.removeEventListener("resize", reposition);
+});
+</script>
+
+<template>
+  <svg
+    v-if="rect && frames.length"
+    class="focus-ring"
+    aria-hidden="true"
+    :viewBox="viewBox"
+    :width="ringW"
+    :height="ringH"
+    :style="{
+      left: `${rect.left - geom.outset + geom.cl}px`,
+      top: `${rect.top - geom.outset}px`,
+    }"
+    xmlns="http://www.w3.org/2000/svg"
+  >
+    <path
+      v-for="(d, f) in frames"
+      :key="f"
+      :d="d"
+      fill="none"
+      :stroke-width="STROKE"
+      stroke-linecap="round"
+      stroke-linejoin="round"
+      :style="pose === f ? undefined : { opacity: 0 }"
+    />
+  </svg>
+</template>
+
+<style scoped>
+/* Above the floating action bar (60) and the sheet, under nothing that takes focus. */
+.focus-ring {
+  position: fixed;
+  z-index: 70;
+  pointer-events: none;
+  overflow: visible;
+  /* THE ONE LINE EVERY §10/§11 CONSUMER COPIES (registry v3 §2.9). The ring drinks from the
+     NAME, not the value: `--ring-ink` is what the chrome consumes and `--color-focus-sketch` is
+     what it resolves to (index.css, the `--ring-ink` declaration at `:root`). BARE — a static design token declared at `:root` is
+     always present, so `, currentColor` could only fire where the declaration is gone, and then
+     the ring should be missing rather than painted in a colour nobody named. */
+  stroke: var(--ring-ink);
+}
+
+/* Forced colors: the UA outline restored in `index.css` is the ring here, and a drawn one
+   would print as a second, unrelated frame. */
+@media (forced-colors: active) {
+  .focus-ring {
+    display: none;
+  }
+}
+</style>
