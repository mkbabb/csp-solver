@@ -0,0 +1,19 @@
+// THE BAND'S RASTER (T9-W7 ACC-GRAPHITE). The focus band's second pass is weighed against the
+// frame's stroke, and that ratio moves with the DEVICE pixels the board spans, never with the
+// pointer: a 1x tablet is a large raster under a coarse pointer. A board under SMALL_RASTER_DPX
+// takes the thinner pass (gameCell.css `[data-raster="small"]`).
+//
+// THE CLIFF IS BETWEEN 365 AND 380 (pass 9, both engines, five rigs and a sweep of eleven spans):
+// 12 units holds 1.37-1.39 at 365 and reds at 400-470; 15 reds at 365 (1.47-1.50) and holds
+// 1.38-1.44 from 380 up, except chromium at 450 (1.457). 366-379 is unread. A fitted constant.
+
+/** The span, in device pixels, below which the board takes the thinner second pass. */
+export const SMALL_RASTER_DPX = 375;
+
+/** `"small"` when a board `cssWidth` layout pixels wide spans fewer than SMALL_RASTER_DPX device
+ *  pixels at `dpr`; otherwise no attribute. An unmeasured board (width 0) is never small. */
+export function boardRasterOf(cssWidth: number, dpr: number): "small" | undefined {
+  return cssWidth > 0 && cssWidth * (dpr > 0 ? dpr : 1) < SMALL_RASTER_DPX
+    ? "small"
+    : undefined;
+}
