+        for (const a of s.matchAll(
+          /(?:const|let|var)\s*\{([^}]*)\}\s*=\s*(?:(?:window|globalThis)\s*\.\s*)?CSS\b/g,
+        )) {
+          const d = /registerProperty(?:\s*:\s*([A-Za-z_$][\w$]*))?/.exec(a[1]);
+          if (d) aliases.add(d[1] ?? "registerProperty");
+        }
+        for (const a of aliases)
+          if (a !== "registerProperty")
+            s = s.replace(
+              new RegExp(`(?<![\\w$.])${a.replace(/\$/g, "\\$")}\\s*\\(`, "g"),
+              "registerProperty(",
+            );
