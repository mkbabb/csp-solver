+      await ctx.close();
+    }
+  }
+  // (e) HEIGHT AT REST (the chair, pass 9): CLEAN (a box at 100 px) rests at 100; LATE (its height lands
+  // at 140 px 350 ms in, after the 10-frame window) must read 140 — the window-only reader reads 100,
+  // printed as the hole; ANIM (a running animation in the subtree, height unchanged) never rests
+  {
+    const BOX = (late, anim) => `<!doctype html><html><body style="margin:0"><div id="card"><div id="pw" style="height:100px;background:#ccc"></div>${anim ? '<i id="spin" style="display:block;width:4px;height:4px"></i>' : ""}</div><script>${late ? 'setTimeout(() => (document.getElementById("pw").style.height = "140px"), 350);' : ""}${anim ? 'document.getElementById("spin").animate([{opacity:1},{opacity:0.5}],{duration:400,iterations:Infinity});' : ""}</script></body></html>`;
