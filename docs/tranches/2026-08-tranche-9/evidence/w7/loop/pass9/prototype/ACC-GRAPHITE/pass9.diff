@@ -0,0 +1,239 @@
+import { describe, it, expect, vi, afterEach } from "vitest";
+import { poseFronts, generateFrameTraceFrames, FRONT_MIN_MS } from "./gridPaths";
+import { MOTION } from "../config/pencilConfig";
+
+/**
+ * THE FRONT'S CONTRACT (T9-W7 §1/§4, the cross-family hand-off).
+ *
+ * `poseFronts` is exported to ACC-SIX, the §10 tally and PLR-COUNT, and it carries a
+ * precondition the pass-3 critique found unstated (§3.7): it parses a pose as ONE polyline.
+ * Handed a multi-subpath pose it would count the JUMPS between subpaths as drawn length and
+ * return a single connected path crossing the board — a wrong shape that looks plausible. The
+ * guard hands such a pose back uncut, and these rows are what make that a contract rather than
+ * a comment. Both arms of the guard are exercised against the estate's OWN generators, not a
+ * hand-written string: `generateGridBoilFrames` really does emit a four-subpath frame.
+ */
+const subpaths = (d: string) => (d.match(/[Mm]/g) ?? []).length;
+const points = (d: string) => (d.match(/-?\d*\.?\d+(?:e[-+]?\d+)?/gi) ?? []).length / 2;
+
+// the board gauge's own ring, grain-baked exactly as HandDrawnGrid bakes it (grain-static)
+const RING = generateFrameTraceFrames(1000, 42, 4, 1.5, {
+  baseFrequency: 0.04,
+  numOctaves: 2,
+  scale: 2.5,
+  seed: 7,
+});
+
+describe("poseFronts — the drawn front, as geometry", () => {
+  it("cuts a single-subpath ring at its own arc-length fraction", () => {
+    expect(subpaths(RING[0])).toBe(1);
+    const half = poseFronts(RING, 0.5);
+    expect(half).toHaveLength(RING.length);
+    // a cut pose is shorter than the whole one, and still one subpath
+    expect(points(half[0])).toBeLessThan(points(RING[0]));
+    expect(points(half[0])).toBeGreaterThan(2);
+    expect(subpaths(half[0])).toBe(1);
+    // and the cut is monotone in the fraction
+    expect(points(poseFronts(RING, 0.25)[0])).toBeLessThan(points(half[0]));
+  });
+
+  it("returns the poses UNCHANGED at f >= 1 and empty at f <= 0", () => {
+    expect(poseFronts(RING, 1)).toBe(RING);
+    expect(poseFronts(RING, 1.7)).toBe(RING);
+    expect(poseFronts(RING, 0)).toEqual(RING.map(() => ""));
+    expect(poseFronts(RING, -0.3)).toEqual(RING.map(() => ""));
+  });
+
+  it("hands a MULTI-SUBPATH pose back uncut rather than joining its subpaths", () => {
+    const multi = "M0,0 L100,0 L100,100 M300,300 L400,300 L400,400";
+    expect(subpaths(multi)).toBe(2);
+    expect(poseFronts([multi], 0.5)[0]).toBe(multi);
+  });
+
+  it("hands a CURVE pose back uncut — control points are not vertices", () => {
+    // the shape `catmullRomToBezier` emits: `wobbleLine`'s non-jagged branch, which every
+    // caller avoids today by passing `jagged: true`. Parsed as a polyline its control points
+    // would be counted as points on the line and both the length and the cut would be wrong.
+    const curved = "M0,0 C10,0 20,10 20,20 C20,30 30,40 40,40";
+    expect(subpaths(curved)).toBe(1);
+    expect(poseFronts([curved], 0.5)[0]).toBe(curved);
+  });
+
+  it("BORN-RED CONTROL: the guard discriminates, it does not refuse everything", () => {
+    // a single linear pose of the same family IS cut — so the two rows above fail the moment
+    // `poseIsLinearSinglePath` stops discriminating and starts returning false for everything.
+    const single = RING[0];
+    expect(subpaths(single)).toBe(1);
+    expect(poseFronts([single], 0.5)[0]).not.toBe(single);
+    expect(poseFronts(["M0,0 L100,0 L100,100"], 0.5)[0]).not.toBe(
+      "M0,0 L100,0 L100,100",
+    );
+  });
+
+  it("memoises on the frames array's identity without changing the answer", () => {
+    const a = poseFronts(RING, 0.37);
+    const b = poseFronts(RING, 0.37);
+    expect(b).toEqual(a);
+    // a fresh array of the same strings is a memo MISS and must still agree
+    expect(poseFronts([...RING], 0.37)).toEqual(a);
+  });
+});
+
+// The gate's clock state is the page's (one `performance.now()`), so every row loads a fresh
+// module and drives its own mocked clock.
+async function freshGate(times: { now: number }) {
+  vi.resetModules();
+  vi.spyOn(performance, "now").mockImplementation(() => times.now);
+  return (await import("./gridPaths")).frontGate;
+}
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.useRealTimers();
+});
+
+describe("frontGate — the front's rate budget (A.6: the end included, on the clock's own grain)", () => {
+  it("the budget is the hand's displacement clause less one millisecond: ≤62.5 re-cuts/s", () => {
+    expect(FRONT_MIN_MS).toBe(MOTION.hand.stepMs - 1);
+    expect(1000 / FRONT_MIN_MS).toBe(62.5);
+  });
+
+  it("a fine clock: a 15 ms gap is swallowed and a 16 ms gap commits", async () => {
+    const t = { now: 0.25 };
+    const frontGate = await freshGate(t);
+    const seen: number[] = [];
+    const gate = frontGate((v) => seen.push(v));
+    for (const now of [0.25, 8.35, 15.25, 16.25, 24.35, 31.2, 32.3]) {
+      t.now = now;
+      gate.write(now);
+    }
+    // 15.25 is 15.0 after 0.25 (swallowed), 16.25 is 16.0 (commits); 31.2 is 14.95 after it
+    expect(seen).toEqual([0.25, 16.25, 32.3]);
+  });
+
+  it("a whole-millisecond clock: a reading of 16 is swallowed (it may be 15.01 ms), 17 commits", async () => {
+    const t = { now: 100 };
+    const frontGate = await freshGate(t);
+    const seen: number[] = [];
+    const gate = frontGate((v) => seen.push(v));
+    for (const now of [100, 108, 116, 117, 125, 133, 134]) {
+      t.now = now;
+      gate.write(now);
+    }
+    expect(seen).toEqual([100, 117, 134]);
+  });
+
+  it("a forced end inside the window is owed, and lands at the window's end, never inside it", async () => {
+    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+    const t = { now: 0.5 };
+    const frontGate = await freshGate(t);
+    const seen: [number, number][] = [];
+    const gate = frontGate((v) => seen.push([v, t.now]));
+    gate.write(0.1); // lands at once: 0.5
+    t.now = 8.6; // a fine clock (8.1 ms later)
+    gate.write(1, true); // the tween's exact end, 8.1 ms after the last commit
+    expect(seen).toEqual([[0.1, 0.5]]);
+    t.now = 16.4;
+    vi.advanceTimersByTime(7.8); // a timer that fires early re-checks the clock and waits
+    expect(seen.length).toBe(1);
+    t.now = 16.5;
+    vi.advanceTimersByTime(1);
+    expect(seen).toEqual([
+      [0.1, 0.5],
+      [1, 16.5],
+    ]);
+    const gaps = seen.slice(1).map(([, at], i) => at - seen[i][1]);
+    expect(Math.min(...gaps)).toBeGreaterThanOrEqual(FRONT_MIN_MS);
+  });
+
+  it("a write while an end is owed replaces it; a re-arm drops it and the window holds across runs", async () => {
+    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+    const t = { now: 0.5 };
+    const frontGate = await freshGate(t);
+    const seen: number[] = [];
+    const gate = frontGate((v) => seen.push(v));
+    gate.write(0.2);
+    t.now = 4.7;
+    gate.write(1, true); // owed
+    t.now = 6.9;
+    gate.write(0, true); // the ring unmounts: the latest value is the truth
+    t.now = 16.6;
+    vi.advanceTimersByTime(20);
+    expect(seen).toEqual([0.2, 0]);
+    t.now = 20.1;
+    gate.write(0.4, true); // owed again (3.5 ms after the last commit)
+    gate.rearm(); // a new run supersedes it
+    vi.advanceTimersByTime(40);
+    expect(seen).toEqual([0.2, 0]);
+    gate.write(0.05); // the new run's first frame, 3.5 ms after the last commit: folded
+    t.now = 24.3;
+    gate.write(0, true); // a restart's forced first write: owed to the window's end
+    expect(seen).toEqual([0.2, 0]);
+    t.now = 32.7;
+    vi.advanceTimersByTime(40);
+    expect(seen).toEqual([0.2, 0, 0]);
+    t.now = 49.8;
+    gate.write(0.3); // 17.1 ms later: the window is clear, it lands at once
+    expect(seen).toEqual([0.2, 0, 0, 0.3]);
+  });
+});
+
+describe("frontGate — a forced write is timed from the landing (pass 7)", () => {
+  it("an owed end waits for the last re-cut to LAND, not for its request", async () => {
+    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+    const t = { now: 0.5 };
+    const frontGate = await freshGate(t);
+    const seen: [number, number][] = [];
+    // the render lands the commit 3.2 ms after the request (the rest of the frame + the flush)
+    const gate = frontGate((v) => {
+      seen.push([v, t.now]);
+      queueMicrotask(() => (t.now += 3.2));
+    });
+    gate.write(0.4); // requested at 0.5, lands at 3.7
+    await Promise.resolve();
+    await Promise.resolve();
+    t.now = 8.6;
+    gate.write(1, true); // the end, owed
+    t.now = 16.6; // 16.1 after the request, 12.9 after the landing: still owed
+    vi.advanceTimersByTime(8);
+    expect(seen.length).toBe(1);
+    t.now = 19.8; // 16.1 after the landing
+    vi.advanceTimersByTime(8);
+    expect(seen.map(([v]) => v)).toEqual([0.4, 1]);
+    // a frame's own write keeps the request's clock (a 60 Hz panel keeps every frame)
+    await Promise.resolve();
+    await Promise.resolve();
+    t.now = 36.0; // 16.2 after the end's request, 13.0 after its landing
+    gate.write(0.9);
+    expect(seen.map(([v]) => v)).toEqual([0.4, 1, 0.9]);
+  });
+});
+
+describe("frontGate — a frame's write is timed on its frame (pass 7)", () => {
+  it("two frames 15.6 ms apart are one re-cut, however far apart their callbacks ran", async () => {
+    const t = { now: 100.2 };
+    const frontGate = await freshGate(t);
+    const seen: number[] = [];
+    const gate = frontGate((v) => seen.push(v));
+    gate.write(0.1, false, 100.0); // frame 100.0, its callback at 100.2
+    t.now = 116.3; // the next callback 16.1 ms later (a fine clock) ...
+    gate.write(0.2, false, 115.6); // ... in a frame 15.6 ms after the last: swallowed
+    t.now = 117.0;
+    gate.write(0.3, false, 116.0); // a frame 16.0 ms after: commits
+    expect(seen).toEqual([0.1, 0.3]);
+  });
+
+  it("a tween's end written inside a frame is timed on that frame, and owed when it is early", async () => {
+    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+    const t = { now: 100.2 };
+    const frontGate = await freshGate(t);
+    const seen: number[] = [];
+    const gate = frontGate((v) => seen.push(v));
+    gate.write(0.5, false, 100.0);
+    t.now = 117.1; // the end's callback runs 16.9 ms after the last one ...
+    gate.write(1, true, 115.5); // ... in a frame 15.5 ms after the last re-cut: owed, not landed
+    expect(seen).toEqual([0.5]);
+    t.now = 118.0;
+    vi.advanceTimersByTime(4);
+    expect(seen).toEqual([0.5, 1]);
+  });
+});
