+    for (const r of cssRules(st.css, st.line))
+      for (const d of r.decls)
+        if (PAINT_ATTR.test(d.prop) || d.prop === "filter")
+          for (const u of urlRefs(d.value))
+            out.push({ prop: d.prop, ...u, where: r.prelude });
+  return out;
+}
