+/** A closed linear pose (`pointsToLinear` + ` Z`) back to its points, the close made explicit. */
+function posePoints(d: string): [number, number][] {
+  const nums = d.match(/-?\d*\.?\d+(?:e[-+]?\d+)?/gi);
+  if (!nums || nums.length < 4) return [];
