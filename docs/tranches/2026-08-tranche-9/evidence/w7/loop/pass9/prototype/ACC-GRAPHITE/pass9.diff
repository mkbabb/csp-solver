+// ------------------------------------------------------------------------ svg references (SIX)
+/** Every `url(…)` reference to an id in a text (CSS escapes and entities decoded first, SIX T9/T10):
+ *  [{raw, id | null, unresolved}] — an argument carrying `${…}`, a `+`, or anything that is not a
+ *  literal `#id` is UNRESOLVED (T7 `url(${base}#${id})`, T8), never read as a non-reference. */
+export function urlRefs(text) {
