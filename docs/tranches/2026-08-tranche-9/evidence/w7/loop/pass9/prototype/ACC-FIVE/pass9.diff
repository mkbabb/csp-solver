+          reg?.[1] === token &&
+          d.prop === "initial-value"
+        )
+          push({
+            file,
+            kind: "at-property",
+            prelude: r.prelude,
+            value: d.value,
+            line: d.line,
+          });
+    }
+  };
+  const attrSites = (html, line, kind, file) => {
