index 00000000..a1913500
--- /dev/null
+++ b/web/frontend/e2e/lib/paint-lib.d.mts
@@ -0,0 +1,59 @@
+// paint-lib.d.mts — the TYPES of the ONE painted-byte library (`./paint-lib.mjs`), so a TypeScript spec
+// imports it under `typecheck:e2e` (strict, no `allowJs`: a bare `.mjs` import is TS7016). No behaviour
+// lives here; every export is typed with its option names (LAWS P8 §I). The pass-8 hand-rolled copies
+// (FACE, TAPE, VERB, the WAVE's) are folded into this one; `Rgb` keeps §13's name for `Shot`.
+// NOT-A-LANE: the chair's home (T9-W7 pass 9, homes v2).
+import type { Browser, BrowserContext, BrowserType, Page } from "@playwright/test";
+
+/** A decoded photograph: packed RGB, device pixels. */
+export interface Shot {
+  data: Uint8Array;
+  w: number;
+  h: number;
+}
+export type Rgb = Shot;
+export interface Clip {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+/** A text run's rect (css px, viewport-relative); `ch` on a per-character read. */
+export interface RunRect {
+  l: number;
+  r: number;
+  t: number;
+  b: number;
+  ch?: string;
+}
+/** A paint cell: viewport, DPR, scheme, motion, pointer, contrast, forced colours. */
+export interface CellOptions {
+  width?: number;
+  height?: number;
+  dpr?: number;
+  colorScheme?: "light" | "dark";
+  reducedMotion?: "reduce" | "no-preference";
+  hasTouch?: boolean;
+  contrast?: "more" | "less" | "no-preference" | null;
+  forcedColors?: "active" | "none" | null;
+  label?: string;
+}
+
+export function playwright(): { chromium: BrowserType; webkit: BrowserType; firefox: BrowserType };
+export function lum(d: ArrayLike<number>, i: number): number;
+export function grey(d: ArrayLike<number>, i: number): number;
+export function ratio(a: number, b: number): number;
+export function median(a: number[]): number;
+export function quantile(a: number[], f: number): number;
+export function maxDelta(d1: ArrayLike<number>, d2: ArrayLike<number>, i: number): number;
+export function settle(page: Page): Promise<void>;
+/** The clip photographed ON, then with `offCss` applied (OFF), both decoded. */
+export function onOff(page: Page, clip: Clip, offCss: string): Promise<{ on: Shot; off: Shot }>;
+/** Page-side: the subject's TEXT RUN (text nodes only; svg and hidden descendants skipped). */
+export function textRunRects(o: { subject: string; chars?: boolean }): RunRect[] | null;
+/** `--key value` / `--flag` argv → a flat record (a bare flag reads "1"). */
+export function args(argv?: string[]): Record<string, string>;
+/** The 1/5/15-minute load averages, printed. */
+export function load(): string;
+export function cellsOf(A: Record<string, string>): CellOptions[];
+export function openCell(browser: Browser, o?: CellOptions): Promise<{ ctx: BrowserContext; page: Page }>;
diff --git a/web/frontend/e2e/lib/paint-lib.mjs b/web/frontend/e2e/lib/paint-lib.mjs
new file mode 100644
index 00000000..b7b2ad13
--- /dev/null
+++ b/web/frontend/e2e/lib/paint-lib.mjs
@@ -0,0 +1,218 @@
+// paint-lib.mjs — the painted-byte reads the estate's paint probes share (T9-W7; LAWS P6 §I, P7 §C;
+// registry-v7 §2.4 PRODUCT HOME). ONE copy: `edge-bands.mjs` (four bands), `glyph-pop.mjs` (the glyph
+// population), `postpaint.mjs` and `rest-probes.mjs` import it by relative path; a spec imports it as
+// `./lib/paint-lib.mjs`. Nothing here is resolved by an absolute path, and nothing leans on an
+// undeclared package: the browsers come from `@playwright/test` (this package's devDependency) and the
+// photographs are decoded HERE (a PNG reader over node:zlib) — the pass-7 copy required `sharp` and
+// `playwright`, which reach node_modules only through wrangler's miniflare and @playwright/test, and
+// knip reds an unlisted dependency.
+//
+// Photographs are DEVICE-scaled (`scale: 'device'`: a DPR 2 read is read at DPR 2's pixels) PNGs decoded
+// to RGB; luminance is WCAG 2.x relative luminance; a contrast is (Lhi + 0.05) / (Llo + 0.05).
+// A photograph of the subject ON and of the subject with its paint OFF (the edge hidden / the text
+// transparent) are compared PIXEL FOR PIXEL: the OFF photo is the painted ground under each pixel, so no
+// ground is guessed and no crop maximum keys anything.
+import os from "node:os";
+import process from "node:process";
+import { Buffer } from "node:buffer";
+import { inflateSync } from "node:zlib";
+import { chromium, webkit, firefox } from "@playwright/test";
+
+/** The browser types, from this package's declared @playwright/test. */
+export const playwright = () => ({ chromium, webkit, firefox });
+
+/** A PNG (8-bit, non-interlaced, colour type 2 RGB or 6 RGBA — what Playwright's screenshots are) to
+ *  packed RGB. Anything else throws: a photograph this cannot read is never read as blank. */
+function decodePng(buf) {
+  if (buf.readUInt32BE(0) !== 0x89504e47) throw new Error("decodePng: not a PNG");
+  let w = 0,
+    h = 0,
+    ct = 0;
+  const idat = [];
+  for (let o = 8; o < buf.length; ) {
+    const len = buf.readUInt32BE(o),
+      type = buf.toString("latin1", o + 4, o + 8),
+      body = buf.subarray(o + 8, o + 8 + len);
+    if (type === "IHDR") {
+      w = body.readUInt32BE(0);
+      h = body.readUInt32BE(4);
+      ct = body[9];
+      if (body[8] !== 8 || (ct !== 2 && ct !== 6) || body[12] !== 0) throw new Error(`decodePng: depth ${body[8]} colour type ${ct} interlace ${body[12]} unsupported`);
+    } else if (type === "IDAT") idat.push(body);
+    else if (type === "IEND") break;
+    o += 12 + len;
+  }
+  const bpp = ct === 6 ? 4 : 3,
+    stride = w * bpp,
+    raw = inflateSync(Buffer.concat(idat)),
+    px = Buffer.alloc(h * stride);
+  for (let y = 0; y < h; y++) {
+    const f = raw[y * (stride + 1)],
+      src = y * (stride + 1) + 1,
+      dst = y * stride;
+    for (let x = 0; x < stride; x++) {
+      const a = x >= bpp ? px[dst + x - bpp] : 0,
+        b = y ? px[dst - stride + x] : 0,
+        c = x >= bpp && y ? px[dst - stride + x - bpp] : 0;
+      let v = raw[src + x];
+      if (f === 1) v += a;
+      else if (f === 2) v += b;
+      else if (f === 3) v += (a + b) >> 1;
+      else if (f === 4) {
+        const p = a + b - c,
+          pa = Math.abs(p - a),
+          pb = Math.abs(p - b),
+          pc = Math.abs(p - c);
+        v += pa <= pb && pa <= pc ? a : pb <= pc ? b : c;
+      }
+      px[dst + x] = v & 255;
+    }
+  }
+  if (bpp === 3) return { data: px, w, h };
+  const data = Buffer.alloc(w * h * 3);
+  for (let i = 0, j = 0; i < px.length; i += 4, j += 3) {
+    data[j] = px[i];
+    data[j + 1] = px[i + 1];
+    data[j + 2] = px[i + 2];
+  }
+  return { data, w, h };
+}
+const rgb = async (png) => decodePng(png);
+
+const lin = (v) => ((v /= 255) <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
+export const lum = (d, i) =>
+  0.2126 * lin(d[i]) + 0.7152 * lin(d[i + 1]) + 0.0722 * lin(d[i + 2]);
+/** The gamma-encoded grey of a pixel (0–255): browsers blend coverage in this space. */
+export const grey = (d, i) => 0.2126 * d[i] + 0.7152 * d[i + 1] + 0.0722 * d[i + 2];
+export const ratio = (a, b) => (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
+export const median = (a) => {
+  if (!a.length) return 0;
+  const s = [...a].sort((p, q) => p - q);
+  return s[s.length >> 1];
+};
+export const quantile = (a, f) => {
+  if (!a.length) return 0;
+  const s = [...a].sort((x, y) => x - y);
+  return s[Math.min(s.length - 1, Math.floor(s.length * f))];
+};
+export const maxDelta = (d1, d2, i) =>
+  Math.max(
+    Math.abs(d1[i] - d2[i]),
+    Math.abs(d1[i + 1] - d2[i + 1]),
+    Math.abs(d1[i + 2] - d2[i + 2]),
+  );
+
+/** Two rendering updates (a style tag or a mask lands before the next photograph). */
+export const settle = (page) =>
+  page.evaluate(
+    () => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))),
+  );
+
+/** Photograph `clip` twice: as is, then with `offCss` injected (removed after). Returns the decoded pair. */
+export async function onOff(page, clip, offCss) {
+  const on = await page.screenshot({ clip, scale: "device", animations: "disabled" });
+  const tag = await page.addStyleTag({ content: offCss });
+  await settle(page);
+  const off = await page.screenshot({ clip, scale: "device", animations: "disabled" });
+  await tag.evaluate((e) => e.remove());
+  await settle(page);
+  return { on: await rgb(on), off: await rgb(off) };
+}
+
+/** Page-side: the rects of the subject's TEXT RUN — its text nodes only, never an svg or a hidden
+ *  descendant (TIN/FIVE: a Range over the element counted the tape's inline svg as run, and TAIL12
+ *  landed on the svg). `chars: true` returns one rect per non-space character (the glyph windows). */
+export function textRunRects({ subject, chars = false }) {
+  const el = document.querySelector(subject);
+  if (!el) return null;
+  const out = [];
+  const tw = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
+    acceptNode(n) {
+      if (!n.textContent.trim()) return NodeFilter.FILTER_REJECT;
+      for (let p = n.parentElement; p && p !== el.parentElement; p = p.parentElement) {
+        if (p instanceof SVGElement) return NodeFilter.FILTER_REJECT;
+        const cs = getComputedStyle(p);
+        if (cs.display === "none" || cs.visibility === "hidden") return NodeFilter.FILTER_REJECT;
+      }
+      return NodeFilter.FILTER_ACCEPT;
+    },
+  });
+  for (let n = tw.nextNode(); n; n = tw.nextNode()) {
+    const r = document.createRange();
+    if (!chars) {
+      r.selectNodeContents(n);
+      for (const q of r.getClientRects())
+        if (q.width > 0) out.push({ l: q.left, t: q.top, r: q.right, b: q.bottom });
+      continue;
+    }
+    const s = n.textContent;
+    for (let i = 0; i < s.length; i++) {
+      if (!s[i].trim()) continue;
+      r.setStart(n, i);
+      r.setEnd(n, i + 1);
+      const q = r.getBoundingClientRect();
+      if (q.width > 0) out.push({ l: q.left, t: q.top, r: q.right, b: q.bottom, ch: s[i] });
+    }
+  }
+  return out;
+}
+
+/** `--key value` / `--flag` argv → an object ("1" for a bare flag). */
+export function args(argv = process.argv.slice(2)) {
+  return Object.fromEntries(
+    argv.reduce((acc, a, i, all) => {
+      if (a.startsWith("--"))
+        acc.push([
+          a.slice(2),
+          all[i + 1]?.startsWith("--") || all[i + 1] == null ? "1" : all[i + 1],
+        ]);
+      return acc;
+    }, []),
+  );
+}
+/** The box load (LAWS P6 §B: a timing row declares it). */
+export const load = () =>
+  os
+    .loadavg()
+    .map((v) => v.toFixed(2))
+    .join(" ");
+
+/** THE REGIME STOPS a paint row reads beyond the one it emulates (LAWS P7 §E (i)): both themes, the
+ *  reduced-motion setting it settles under AND `no-preference`, a coarse pointer, `prefers-contrast:
+ *  more`. Each is a Playwright context option bag plus a label. */
+const PAINT_REGIMES = [
+  { label: "light PRM fine", colorScheme: "light", reducedMotion: "reduce" },
+  { label: "dark PRM fine", colorScheme: "dark", reducedMotion: "reduce" },
+  { label: "light no-preference fine", colorScheme: "light", reducedMotion: "no-preference" },
+  { label: "dark no-preference fine", colorScheme: "dark", reducedMotion: "no-preference" },
+  { label: "light PRM coarse", colorScheme: "light", reducedMotion: "reduce", hasTouch: true },
+  { label: "light PRM contrast-more", colorScheme: "light", reducedMotion: "reduce", contrast: "more" },
+  { label: "dark PRM contrast-more", colorScheme: "dark", reducedMotion: "reduce", contrast: "more" },
+];
+/** The cells a paint CLI reads: `--regimes all` = every PAINT_REGIMES stop at the row's viewport and
+ *  DPR (LAWS P7 §E: the regime it emulates AND the ones it does not); otherwise the one cell the flags
+ *  name. Each is an `openCell` option bag with its label. */
+export function cellsOf(A) {
+  const [width, height] = (A.viewport ?? "1280x800").split("x").map(Number);
+  const dpr = +(A.dpr ?? 1);
+  if (A.regimes === "all") return PAINT_REGIMES.map((r) => ({ width, height, dpr, ...r }));
+  const one = { width, height, dpr, colorScheme: A.scheme ?? "light", reducedMotion: A.prm === "0" ? "no-preference" : "reduce", hasTouch: A.touch === "1", contrast: A.contrast ?? null };
+  return [{ ...one, label: `${one.colorScheme} ${one.reducedMotion === "reduce" ? "PRM" : "no-preference"} ${one.hasTouch ? "coarse" : "fine"}${one.contrast ? " contrast-" + one.contrast : ""}` }];
+}
+/** A context for one cell: viewport, DPR, theme, motion, pointer, contrast (emulated after open). */
+export async function openCell(
+  browser,
+  { width = 1280, height = 800, dpr = 1, colorScheme = "light", reducedMotion = "reduce", hasTouch = false, contrast = null, forcedColors = null } = {},
+) {
+  const ctx = await browser.newContext({
+    viewport: { width, height },
+    deviceScaleFactor: dpr,
+    colorScheme,
+    reducedMotion,
+    hasTouch,
+    ...(forcedColors ? { forcedColors } : {}),
+  });
+  const page = await ctx.newPage();
+  if (contrast) await page.emulateMedia({ contrast });
+  return { ctx, page };
+}
diff --git a/web/frontend/e2e/lib/postpaint.d.mts b/web/frontend/e2e/lib/postpaint.d.mts
new file mode 100644
index 00000000..f5778ce6
--- /dev/null
+++ b/web/frontend/e2e/lib/postpaint.d.mts
@@ -0,0 +1,169 @@
+// postpaint.d.mts — the TYPES of the ONE post-paint sampler and painted-frame recorder (`./postpaint.mjs`),
+// so a TypeScript spec imports it under `typecheck:e2e` (strict, no `allowJs`). No behaviour lives here.
+// Every export is typed with its option names (LAWS P8 §I: never `[k: string]: unknown`); the pass-8
+// hand-rolled copies (ERASE, VERB, TAPE, the WAVE's) are folded into this one.
+// NOT-A-LANE: the chair's home (T9-W7 pass 9, homes v2).
+import type { Browser, Page } from "@playwright/test";
+
+/** One read of the subject: frame index, the frame's timeline time, the timeline AT the read (a post
+ *  read whose `tlNow` moved past `tl` is STALE: the next frame's), the scripted animation's clock, the centre. */
+export interface PPRead {
+  k: number;
+  tl: number;
+  tlNow?: number;
+  ct: number | null;
+  ps: string | null;
+  x: number;
+  y: number;
+  w: number;
+  stale?: boolean;
+}
+/** `window.__pp` after `installSampler`. */
+export interface PP {
+  inRAF: PPRead[];
+  post: PPRead[];
+  rAF2: PPRead[];
+  stamps: number[];
+  io: number | null;
+  done: boolean;
+}
+/** One analysed arm: F1 (frame 1 at rest by position AND at ct ≤ ctTol) and CI (the clock identity). */
+export interface Arm {
+  red: boolean;
+  f1red: boolean;
+  f1pos?: boolean;
+  f1ct?: boolean;
+  ciRed: boolean;
+  why: string[];
+  f1: { k: number; ct: number; c: number; dw: number; ps: string | null; stale?: boolean } | null;
+  ci: { k: number; ct: number; tlDelta: number; off: number }[];
+  frames?: number;
+  dropped: number;
+  stale?: number;
+}
+export interface Mover {
+  kPaint: number;
+  /** the frame the rAF time alone keys (the pass-8 key), and the POST frames read from it (printed) */
+  kStamp: number;
+  byStamp: Arm;
+  io: number | "none" | "pending";
+  post: Arm;
+  legacy: Arm;
+  inRAF: Arm;
+  rAF2: Arm;
+}
+export interface AnalyseOptions {
+  kPaint?: number;
+  tolPx?: number;
+  tolMs?: number;
+  ks?: number[];
+  /** F1ct: frame 1's clock bound in ms (default 4) */
+  ctTol?: number;
+  /** the in-rAF reads that stand in for a STALE post read of the same frame */
+  inRAF?: PPRead[] | null;
+}
+export const PP_CLAUSES: readonly string[];
+export function installSampler(o: { sel: string; anyAnim?: boolean; maxFrames?: number; io?: boolean }): void;
+export function kPaintByStamp(pp: Pick<PP, "io" | "stamps">): number;
+export function kPaintOf(pp: Pick<PP, "io" | "stamps"> & { inRAF?: PPRead[] }): number;
+export function analyse(frames: PPRead[], rest: { x: number; y: number; w: number }, o?: AnalyseOptions): Arm;
+/** Every explicit startTime write lands `ms` early (default 150; 16 = the one-frame skip F1ct sees). */
+export function SKIP_PLANT(ms?: number): void;
+/** Frame 1 at rest, the clock jumping 150 ms on the second rAF (CI reds, F1 green). */
+export function F2_PLANT(sel: string): void;
+/** The first keyframe 40 px off the rest pose at ct 0 (F1's position clause alone reds). */
+export function FROM_PLANT(sel: string): void;
+export function readMover(page: Page, o: { sel: string; key?: string | null; click?: string | null; io?: boolean }): Promise<Mover>;
+export function fmtArm(r: Arm): string;
+export function unitSelfTest(): { rows: string[]; hole: boolean };
+export function samplerSelfTest(browser: Browser, o?: { reps?: number }): Promise<{ rows: string[]; exit: number }>;
+
+// ── II · the painted-frame recorder ─────────────────────────────────────────────────────────────
+export interface Stat {
+  n: number;
+  min: number;
+  median: number;
+  p95: number;
+  max: number;
+}
+/** A recording's options: the page, the trigger (`key:<k>`, `click:<sel>`, `load`), the ROI, the subject
+ *  (`<sel>`, `css:<sel>:<prop>`, `ruled:<sel>`, `len:<sel>`, `range:<sel>`), a busy plant. */
+export interface RecordOptions {
+  url?: string;
+  html?: string;
+  viewport: { width: number; height: number };
+  dpr?: number;
+  scheme?: "light" | "dark";
+  touch?: boolean;
+  trigger: string;
+  roi?: string | null;
+  subject?: string | null;
+  windowMs?: number;
+  eps?: number;
+  heldMs?: number;
+  plant?: { busyMs: number; delayMs: number } | null;
+  ready?: string;
+}
+export interface Photos {
+  photos: number;
+  changed: number;
+  eps: number;
+  deltaMedian: number | null;
+  windowMs: number;
+  firstChange: number | null;
+  gapMs: Stat;
+  maxHeldMs: number;
+  heldAt: number | null;
+  deltas: [number, number][];
+}
+export interface Timeline {
+  rafs: number;
+  gapMs: Stat;
+  maxGapMs: number;
+  at: number | null;
+}
+export type Held = [number, number][];
+export interface Recording {
+  engine: string;
+  trigger: string;
+  roi: { x: number; y: number; w: number; h: number } | null;
+  held: { photo: Held; rAF: Held; subject: Held };
+  subjectMaxMs: number;
+  plantSeen: { photo: boolean; rAF: boolean; subject: boolean } | null;
+  subjectMovedFrames: number;
+  motionMs: number;
+  latencyMs: number;
+  plant: { busyMs: number; delayMs: number } | null;
+  plantRanAt: number | null;
+  photos: Photos;
+  timeline: Timeline;
+  load: number[];
+}
+export function loadArr(): number[];
+/** Page-side (an init script or `page.evaluate`): the painted timeline in `window.__pf`. */
+export function installTimeline(sel?: string | null): void;
+export function startPhotos(page: Page, engine: string, size: { width: number; height: number }): Promise<() => Promise<{ t: number; png: Uint8Array }[]>>;
+export function stat(a: number[]): Stat;
+export function analysePhotos(
+  browser: Browser,
+  frames: { t: number; png: Uint8Array }[],
+  roiCss: { x: number; y: number; w: number; h: number },
+  scale?: number,
+  eps?: number,
+  t0?: number,
+  t1?: number,
+): Promise<Photos>;
+export function analyseTimeline(pf: { rafs: number[] }, t0: number, t1: number): Timeline;
+export function clockSelfTest(
+  browser: Browser,
+  engine: string,
+  viewport?: { width: number; height: number },
+): Promise<{ photosPerSec: number; photoGapMs: Stat; rafPerSec: number; rafGapMs: Stat; load: number[] }>;
+export function record(browser: Browser, engine: string, o: RecordOptions): Promise<Recording>;
+export function verdict(
+  r: Recording,
+  engine: string,
+  o?: { held?: number; subject?: string | null },
