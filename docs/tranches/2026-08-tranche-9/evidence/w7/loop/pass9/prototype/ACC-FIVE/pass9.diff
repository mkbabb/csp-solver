+// ------------------------------------------------------------------------ svg references (SIX)
+/** Every `url(…)` reference to an id in a text (CSS escapes and entities decoded first, SIX T9/T10):
+ *  [{raw, id | null, unresolved}] — an argument carrying `${…}`, a `+`, or anything that is not a
+ *  literal `#id` is UNRESOLVED (T7 `url(${base}#${id})`, T8), never read as a non-reference. */
+export function urlRefs(text) {
+  const t = decodeCssEscapes(decodeEntities(String(text)));
+  const out = [];
+  for (const m of t.matchAll(/url\(\s*((?:[^()]|\([^()]*\)|\$\{[^}]*\})*)\)/g)) {
+    const arg = m[1].trim().replace(/^(["'])(.*)\1$/, "$2");
+    const lit = /^#([\w-]+)$/.exec(arg);
+    if (lit) out.push({ raw: m[0], id: lit[1], unresolved: false });
+    else if (!on("url-dyn")) {
+      const x = /^#\$?\{?([\w-]*)/.exec(arg);
+      if (x) out.push({ raw: m[0], id: null, unresolved: true });
+    } else if (/\$\{|\+|^[^#/.a-z]/i.test(arg) || arg.includes("#"))
+      out.push({ raw: m[0], id: null, unresolved: true });
+  }
+  return out;
+}
+/** The svg paint references of one SFC, keyed by the CONSUMING property (SIX T6: resolved through
+ *  the binding that reads the name, never the name itself): static attributes, bound attributes
+ *  whose expression is a same-file const or literal, CSS declarations. [{prop, id, unresolved, where}] */
+export function svgRefSites(text) {
+  const b = sfc(text);
+  const consts = new Map();
+  for (const sc of b.scripts) {
+    const s = stripJs(sc.text);
+    for (const m of s.matchAll(
+      /\b(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*=\s*([^;\n]+)/g,
+    ))
+      consts.set(m[1], m[2].trim());
+    for (const m of s.matchAll(
+      /\b([A-Za-z_$][\w$]*)\s*=\s*computed\(\s*\(\)\s*=>\s*([^)\n]+)\)/g,
+    ))
+      consts.set(m[1], m[2].trim());
+  }
+  const out = [];
+  const PAINT_ATTR =
+    /^(fill|stroke|filter|clip-path|mask|marker-start|marker-mid|marker-end)$/;
+  if (b.template)
+    for (const m of stripHtml(b.template.text).matchAll(TAG_RE))
+      for (const a of attrsOf(m[2] ?? "")) {
+        const bound = /^(?::|v-bind:)(.+)$/.exec(a.name);
