+    red: why.length > 0,
+    why,
+    population: pop.length,
+    coreMedian: +med.toFixed(3),
+    fracUnder: +frac.toFixed(3),
+    columns: n,
+    slicePop: sp,
+    slices: sl,
+    glyphCores: gw,
+    g4Lows: g4Lows.map((x) => x.split(":")[0]),
+    g4Tolerated: tolerated,
+    transientOn,
+    transientOff,
+    outsideRun,
+    clip,
+    dpr,
+  };
+}
+
+/** THE PER-PAYLOAD GATE (WALK W4): read the clean subject for THIS payload, bound G3 at its own
+ *  fraction + `slack`, then read every plant against that bound. `payload` names what the page holds
+ *  (a board, a deal, a peer id) and is REQUIRED — a bound is never pooled across payloads. */
+export async function glyphGate(page, { subject, payload, plants = null, slack = 0.05, img = null, control = null, ...opts }) {
+  if (!payload) throw new Error("glyphGate: `payload` is required (a G3 bound is per payload, never pooled)");
+  const first = await glyphPopulation(page, { subject, ...opts });
+  // anchor (the chair p9; COUNT gap 1 / LAWS P8 §F): with `control` — the CONTROL tree's read of the
+  // SAME payload ({fracUnder, g4Lows}) — G3 is bound at the control's fraction + slack and G4
+  // tolerates only the control's low columns; a bound cut from this run's own clean read cannot see a
+  // shipped regression (OPA80F: frac 1.000 against its own 1.050)
+  const ref = control && gOn("anchor") ? control : first;
+  const bound = boundOf(ref.fracUnder, slack, ref.population ?? Infinity, opts.minPop ?? 40);
+  opts = { ...opts, tolerate: control && gOn("anchor") ? (control.g4Lows ?? []) : opts.tolerate };
+  const clean = await glyphPopulation(page, { subject, fracBound: bound, ...opts });
+  const P = plants ?? (img ? IMG_PLANTS(subject, img.ng, img.ink) : TEXT_PLANTS(subject));
+  const out = {};
+  for (const [name, plant] of Object.entries(P)) {
+    const undo = await applyPlant(page, subject, plant);
+    await settle(page);
+    const r = await glyphPopulation(page, { subject, fracBound: bound, ...opts });
+    await undo();
+    await settle(page);
+    out[name] = r;
+  }
+  return { payload, bound, clean, plants: out };
+}
+
+/** G3's bound from a reference fraction: ref + slack, CLAMPED (G3clamp, the chair p9; COUNT gap 4) —
+ *  at a reference ≥ 0.95 the bound is half-way from it to 1, so it never reaches 1.0 and a plant that
+ *  drives every pixel under the floor (OPA80F's 1.000) still reds. null when the reference is thin. */
+export const boundOf = (frac, slack = 0.05, pop = Infinity, minPop = 40) => {
+  if (frac == null || pop < minPop) return null;
+  const b = frac + slack;
+  return gOn("G3clamp") && frac >= 0.95 ? Math.min(b, frac + (1 - frac) / 2) : b;
+};
+/** The FILE plants (COUNT, pass 8's critic): CSS a lane writes INTO the product file under test (never
+ *  an in-run sheet that the in-run plants could shadow). OPA80F: the subject at opacity 0.8. COMB: 1 px
+ *  stripes at 25 % α over the whole subject (a repeating mask). Each must RED on the shipped surface. */
+export const FILE_PLANTS = (s) => ({
+  OPA80F: `${s} { opacity: 0.8 !important; }`,
+  COMB: `${s} { -webkit-mask-image: repeating-linear-gradient(to right, #000 0 1px, rgba(0,0,0,.25) 1px 2px) !important; mask-image: repeating-linear-gradient(to right, #000 0 1px, rgba(0,0,0,.25) 1px 2px) !important; }`,
+});
+/** The in-run text plants (LAWS P6 §E, P7 §E (v)) — each must RED. FAINT/FADE move only the FILL
+ *  (`color` stays green); `{ mask: [a, b] }` paints the fraction a..b of the TEXT RUN (text nodes
+ *  only) at 25 % through a mask keyed to the run's own pixels: TAIL12 [0.88, 1], TAIL35 [0.65, 1],
+ *  HEAD12 [0, 0.12] (COUNT: the leading digit), MID20 [0.4, 0.6]. */
+export const TEXT_PLANTS = (s) => ({
+  FAINT30_fill: `${s}, ${s} * { -webkit-text-fill-color: color-mix(in srgb, currentColor 30%, transparent) !important; }`,
+  FADE65_fill: `${s}, ${s} * { -webkit-text-fill-color: color-mix(in srgb, currentColor 65%, transparent) !important; }`,
+  FADE80_fill: `${s}, ${s} * { -webkit-text-fill-color: color-mix(in srgb, currentColor 80%, transparent) !important; }`,
+  TAIL12_a25: { mask: [0.88, 1] },
+  TAIL35_a25: { mask: [0.65, 1] },
+  HEAD12_a25: { mask: [0, 0.12] },
+  MID20_a25: { mask: [0.4, 0.6] },
+  COMB_a25: { mask: [0, 1], comb: true },
+  EMPTY_hidden: `${s}, ${s} * { color: transparent !important; -webkit-text-fill-color: transparent !important; }`,
+});
+/** TAB-PEN (pass 7 PROPOSED): the plants' twins for an IMAGE subject (a favicon <img>): FAINT/FADE by
+ *  opacity, TAIL/HEAD by a mask over that fraction of the INK's x-extent (`ink` = [x0, x1] as fractions
+ *  of the box), EMPTY by the paper-only twin `ng`. Each must RED. */
+export const IMG_PLANTS = (s, ng, ink = [6 / 32, 26 / 32]) => {
+  const band = (a, bnd) => {
+    const p0 = ((ink[0] + a * (ink[1] - ink[0])) * 100).toFixed(2),
+      p1 = ((ink[0] + bnd * (ink[1] - ink[0])) * 100).toFixed(2);
+    const g = `linear-gradient(to right, #000 ${p0}%, rgba(0,0,0,.25) ${p0}%, rgba(0,0,0,.25) ${p1}%, #000 ${p1}%)`;
+    return `${s} { -webkit-mask-image: ${g} !important; mask-image: ${g} !important; }`;
+  };
+  return {
+    FAINT30_opacity: `${s} { opacity: 0.3 !important; }`,
+    FADE65_opacity: `${s} { opacity: 0.65 !important; }`,
+    FADE80_opacity: `${s} { opacity: 0.8 !important; }`,
+    TAIL12_a25: band(0.88, 1),
+    TAIL35_a25: band(0.65, 1),
+    HEAD12_a25: band(0, 0.12),
+    EMPTY_paper: `${s} { content: url("${ng}") !important; }`,
+  };
+};
+/** Apply one plant (a CSS string or a run mask); returns its undo. */
+export async function applyPlant(page, subject, plant) {
+  if (typeof plant === "string") {
+    const tag = await page.addStyleTag({ content: plant });
+    return () => tag.evaluate((e) => e.remove());
+  }
+  await applyMask(page, subject, plant.mask, plant);
+  return () => undoMask(page, subject);
+}
+/** The pass-7 names, kept so a lane re-pointing from `pass7/instruments/glyph-pop.mjs` changes only
+ *  its import path: `applyTail(page, s, 0.12)` = the mask over the run's last 12 % (on the TEXT-NODE run
+ *  now, never the element's Range), `undoTail` its undo. */
+export const applyTail = (page, subject, tail) => applyMask(page, subject, [1 - tail, 1]);
+export const undoTail = undoMask;
+/** Mask the fraction [a, b] of the subject's TEXT RUN (text nodes only) to 25 %. */
+export async function applyMask(page, subject, [a, b], { comb = false, glyph = null } = {}) {
+  // `glyph: k` (the chair p9): the range is glyph k's own box, not a fraction of the run; `comb`: the
+  // range is striped (1 px at 25 % α, 1 px whole) instead of faded whole — COUNT's COMB
+  const rects = await page.evaluate(textRunRects, { subject, chars: glyph != null });
+  const pick = glyph != null ? [rects[glyph]].filter(Boolean) : rects;
+  return page.evaluate(
+    ({ subject, a, b, rects, comb }) => {
+      const sub = document.querySelector(subject);
+      if (!sub || !rects.length) return { ok: false };
+      // ACC-SIX pass 8 (PROPOSED): a ZERO-HEIGHT subject's mask would clip every glyph it overflows
+      // (the mask's painting area is its 0 px box), so the mask goes on its parent, cut at the
+      // subject's own run; the population stays clipped to that run.
+      const el = sub.getBoundingClientRect().height < 1 && sub.parentElement ? sub.parentElement : sub;
+      sub.dataset.maskHost = el === sub ? "self" : "parent";
+      const eb = el.getBoundingClientRect();
+      const left = Math.min(...rects.map((q) => q.l)),
+        right = Math.max(...rects.map((q) => q.r));
+      const c0 = left + a * (right - left) - eb.left,
+        c1 = left + b * (right - left) - eb.left;
+      const g = comb
+        ? `linear-gradient(to right, #000 ${c0.toFixed(1)}px, transparent ${c0.toFixed(1)}px, transparent ${c1.toFixed(1)}px, #000 ${c1.toFixed(1)}px), repeating-linear-gradient(to right, #000 0 1px, rgba(0,0,0,.25) 1px 2px)`
+        : `linear-gradient(to right, #000 ${c0.toFixed(1)}px, rgba(0,0,0,.25) ${c0.toFixed(1)}px, rgba(0,0,0,.25) ${c1.toFixed(1)}px, #000 ${c1.toFixed(1)}px)`;
+      el.dataset.maskPrev = el.getAttribute("style") ?? "";
+      el.style.setProperty("-webkit-mask-image", g, "important");
+      el.style.setProperty("mask-image", g, "important");
+      return { ok: true, run: [+(left - eb.left).toFixed(1), +(right - eb.left).toFixed(1)], cut: [+c0.toFixed(1), +c1.toFixed(1)], box: +eb.width.toFixed(1) };
+    },
+    { subject, a, b, rects: pick, comb },
+  );
+}
+export async function undoMask(page, subject) {
+  await page.evaluate((subject) => {
+    const sub = document.querySelector(subject);
+    if (!sub) return;
+    const el = sub.dataset.maskHost === "parent" && sub.parentElement ? sub.parentElement : sub;
+    delete sub.dataset.maskHost;
+    const p = el.dataset.maskPrev;
+    if (p) el.setAttribute("style", p);
+    else el.removeAttribute("style");
+    delete el.dataset.maskPrev;
+  }, subject);
+}
