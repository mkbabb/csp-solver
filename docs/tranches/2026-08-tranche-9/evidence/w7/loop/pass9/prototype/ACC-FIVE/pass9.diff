index 00000000..8cb21f3b
--- /dev/null
+++ b/web/frontend/e2e/front-rate.spec.ts
@@ -0,0 +1,510 @@
+// PRM: live, because the subject IS the tween: the front's re-cut only runs while a draw-in eases, and
+// under reduced motion every consumer lands its fraction in one frame with nothing to count.
+import { test, expect } from "@playwright/test";
+import { loadavg } from "node:os";
+import { clockFor, clockHz } from "./rate-clock";
+
+/**
+ * G10 — THE FRONT'S RATE BUDGET, COUNTED ON THE SURFACE (pass-4 critique §3.2, LAWS P4: count a
+ * primitive's consumers and gate every call site in the SAME page).
+ *
+ * All three `poseFronts` consumers, one page A at no-preference (witnessed): the tally draws in
+ * when the dealt board's grade lands, three hints move the fill gauge, and B joining A's room
+ * rings A's board (`?wire=local`, the dev server's transport, one context). A MutationObserver on
+ * `d` clusters records into re-cut FRAMES; each consumer's worst burst must hold
+ * ≤ 1000 / FRONT_MIN_MS = 62.5 re-cuts per second.
+ *
+ * THE STATISTIC IS THE INTERVAL RATE, (frames − 1) / span: N commits are N − 1 gaps, and the
+ * budget bounds the gaps. frames / span reads 64/s on a 60 Hz panel whose every frame clears the
+ * gate, where no two cuts are closer than 16.7 ms.
+ *
+ * THE CLOCK IS THE ROW'S, NOT THE HOST'S (T9-W7 pass 6; pass-5 critique §3.1). A budget of
+ * 62.5/s cannot be seen broken on a clock at or under 62.5 Hz: with FRONT_MIN_MS deleted this row
+ * PASSED at 58–61/s under a 60 Hz rAF shim in both engines. So the page runs the chair's DRIVEN
+ * 125 Hz animation clock (`rate-clock.ts`, one copy with pass6/instruments/), and the measured
+ * in-page clock must reach 1.5 × the budget (93.75 Hz) BEFORE any rate is read — a slow clock reds
+ * loudly instead of passing a broken tree. CLOCK=60 is the negative control (reds on the
+ * precondition), CLOCK=native reads the host panel.
+ *
+ * THE INTERLEAVE IS WITNESSED (pass-5 critique §3.5). The tally's one-clock cure exists for
+ * several strokes drawing at once; a board graded at one stroke draws 4 `d` a frame and never shows
+ * it. The tally inks the DEALT board's measured grade, not the tier asked for (a HARD deal can grade
+ * at one stroke, and did: 68 d over 17 frames, pass 6), and a shared `?board=` payload is never
+ * graded at all (twelve bank templates read "level not graded yet" after 30 s), so no pinned board
+ * can carry this row. The row deals HARD and re-deals, at most six times, until the tally inks
+ * ≥ 3 strokes, then asserts ONE tally draw-in averaged MORE than 4 `d` records per re-cut frame:
+ * it saw the stagger or it says so.
+ *
+ * THE SHORTEST GAP IS GATED TOO (pass-6 critique §3.1; chair A.6). A rate over a burst can pass
+ * while single gaps break the budget: the forced end-write landed 5.9–9.5 ms after the last gated
+ * commit, and WebKit's whole-millisecond clock let 14–15 ms gaps through a 16 ms gate. Every
+ * burst prints its gaps' minimum, and every minimum must be ≥ 15.5 ms (the budget's 16 on a
+ * clock read to the half millisecond). The gap is read between the FRAMES the re-cuts belong to
+ * (the chair's "rAF timestamp", A.6), which is the clock `frontGate` times a tween's writes on:
+ * the driven clock runs a frame's callbacks in one task, so a write's DOM time waits for the
+ * rest of the frame's work, and that wait moved 0–8 ms frame to frame at load 35–50 (pass 7:
+ * WebKit's DOM gaps read 13.0 and 15.0 ms in 2 of 6 runs). The DOM gaps print beside it, never
+ * hidden. A write outside any frame (a timer's, a worker message's) is read at the DOM.
+ *
+ * THE FRAME CLOCK BINDS, THE DOM CLOCK PRINTS (pass8/CHAIR-RULINGS §2.4, registry-v7 §2.7d). Every
+ * row prints each consumer's DOM minimum beside its frame minimum and a `DOM<15.5` flag; a DOM
+ * red in ≥ 2 of 10 runs per engine is the FLUSH LAG, a named defect (a re-cut's `d` reaches the
+ * DOM after the rest of its frame's work, and that wait moves frame to frame), never noise.
+ *
+ * THE FLOOR (pass 8, registry-v7 §2.7b; RULED pass9/CHAIR-RULINGS §6 and LAWS P8 §D). A ceiling
+ * alone passes a front slowed to 18/s: with `FRONT_MIN_MS` at 49 this row read 17.8–18.8/s exit 0
+ * in both engines (pass-7 critique §1.2). Every burst must also re-cut at ≥ 0.9 × the A.6-DELIVERED
+ * best: the best any A.6 gate could do on the write opportunities the page actually offered over
+ * the burst (the ticks and the consumer's wall-timed writes, greedy under the budget's slots). The
+ * rate form, 0.9 × (Hz / ⌈15.5 · Hz / 1000⌉) on the clock's measured Hz (= 0.9 × min(Hz, 62.5) at
+ * 30/60/120/125/240 Hz), PRINTS beside it with the box's load: a burst red on the rate form and
+ * green on the delivered one is the page stalling its own frames (the deal's render under load),
+ * not the gate (pass-8 critique §0.2: 3 of 7 runs, all at load 211–253 or 0.04/s of margin). The floor is attainable because the driven clock is now a PANEL: it stamps each
+ * frame on its vsync grid (`rate-clock.ts`), where the pass-6 pump stamped the timer's lateness
+ * into every frame and no A.6 gate could keep two frames in a slot (the A.6 optimum over 3 s of
+ * those ticks was 51.1/s chromium, 54.7/s WebKit at 125 Hz, under the formula's 56.25; STAMP=wall
+ * keeps that clock for the proof). Below 93.75 Hz a driven clock cannot see the ceiling broken,
+ * so its precondition is its own rate (≥ 0.9 × HZ) and the floor is what it gates.
+ *
+ * THE RATES ARE READ ON THE FRAME CLOCK (pass8/CHAIR-RULINGS §2.4: A.6 binds the frame clock);
+ * the DOM rates print beside, flagged DOM>62.5 where a burst's endpoint lags push them over.
+ *
+ * BORN-REDs: `FRONT_MIN_MS` 16 → 0 in `gridPaths.ts` reds the rate on the driven clock in both
+ * engines; the pass-6 compare (a forced end committed inside the window, a whole-ms reading of
+ * 16 admitted) reds the shortest gap; `FRONT_MIN_MS` 16 → 49 reds the floor; pass 7's whole-ms
+ * +1 on the frame clock reds the floor at HZ=60 in WebKit; CLOCK=60 (the rAF shim) reds the
+ * precondition; DEAL=EASY reds the interleave witness. The pass-5 hole (the ablation passing
+ * under a 60 Hz clock with the precondition off) is the critic's instrument, not a switch this
+ * file ships.
+ */
+const BUDGET_PER_S = 62.5;
+const MIN_GAP_MS = 15.5;
+const MIN_CLOCK_HZ = 1.5 * BUDGET_PER_S;
+const FLOOR_SHARE = 0.9;
+const CONSUMERS = { gauge: ".progress-trace", tally: ".dt-stroke", join: ".join-pose path" };
+const DEAL = process.env.DEAL ?? "HARD";
+
+type Cuts = Record<string, { d: number; times: number[]; frames: number[]; n: number[]; lag: number[] }>;
+
+const OBSERVE_CUTS = (selectors: Record<string, string>) => {
+  const w = window as unknown as { __cuts: Cuts };
+  w.__cuts = {};
+  // ONE observer per consumer, so a commit's `d` writes arrive in ONE callback on ONE clock read:
+  // one callback is one re-cut. (Pass 7: an observer PER ELEMENT read the clock once per element,
+  // and on WebKit's whole-millisecond clock a commit whose callbacks straddled a millisecond
+  // boundary split into two "frames" 1.0 ms apart — the instrument's clock, not the gate's.)
+  //
+  // TWO CLOCKS PER RE-CUT. `times` is when the `d` write reached the DOM (the observer's read).
+  // `frames` is the animation frame the write belongs to: the timestamp of the rAF callback whose
+  // task wrote it, or the DOM time for a write outside any frame (an end in a timer, a start in a
+  // worker's message). The budget is "re-cuts per second at any refresh rate", and a re-cut paints
+  // with its frame however late in that frame's task the render flushes it: the flush's lag
+  // (`lag`, DOM − frame) moved 0–11 ms frame to frame at load 35–50 (pass 7) and is printed,
+  // not gated. The gap clause reads `frames`; the DOM gaps print beside it.
+  // A write belongs to a frame only if that frame's own task made it. Every timer task opens with
+  // no frame (the driven clock's pump is a timer too, and sets its frame after); a frame's writes
+  // close it once the observers have read them; and a frame that wrote nothing is closed by a
+  // posted message, the next task its own task queues. (Pass 7: a zero-delay clear let an owed
+  // end's timer, already due when the pump ended, run first and read as the pump's frame, a
+  // 14.9 ms "frame" gap between writes 16.2 ms apart at the DOM; and a draw-in started from the
+  // worker's message after a frame with no writes read as that frame, 5.0 ms against 16.0.)
+  const raf = window.requestAnimationFrame.bind(window);
+  const later = window.setTimeout.bind(window);
+  let frameTs: number | null = null;
+  window.setTimeout = ((fn: unknown, ms?: number, ...a: unknown[]) =>
+    later(() => {
+      frameTs = null;
+      if (typeof fn === "function") fn(...a);
+    }, ms)) as unknown as typeof window.setTimeout;
+  const close = new MessageChannel();
+  close.port1.onmessage = () => (frameTs = null);
+  // A worker's message is a task of its own, and it can run between a frame's task and the posted
+  // close (pass 8, load 50–100: a forced start written from the grade's message read as a frame
+  // 15 ms old and printed a 10.0 ms "frame" gap between writes 15+ ms apart at the DOM). A
+  // listener added in the constructor runs before the app's own, so the task opens with no frame.
+  const NativeWorker = window.Worker;
+  window.Worker = class extends NativeWorker {
+    constructor(...a: ConstructorParameters<typeof Worker>) {
+      super(...a);
+      this.addEventListener("message", () => (frameTs = null));
+    }
+  };
+  window.requestAnimationFrame = (cb) =>
+    raf((ts) => {
+      frameTs = ts;
+      close.port2.postMessage(0);
+      cb(ts);
+    });
+  const obs: Record<string, MutationObserver> = {};
+  for (const k of Object.keys(selectors)) {
+    w.__cuts[k] = { d: 0, times: [], frames: [], n: [], lag: [] };
+    obs[k] = new MutationObserver((recs) => {
+      const t = performance.now();
+      const d = recs.filter((m) => m.attributeName === "d").length;
+      if (!d) return;
+      const r = w.__cuts[k];
+      r.d += d;
+      r.times.push(t);
+      r.frames.push(frameTs ?? t);
+      r.n.push(d);
+      r.lag.push(frameTs == null ? NaN : t - frameTs); // NaN: a write outside any frame
+      if (frameTs != null) queueMicrotask(() => (frameTs = null));
+    });
+  }
+  const seen = new WeakSet<Element>();
+  const attach = () => {
+    for (const [k, sel] of Object.entries(selectors))
+      document.querySelectorAll(sel).forEach((el) => {
+        if (seen.has(el)) return;
+        seen.add(el);
+        obs[k].observe(el, { attributes: true, attributeFilter: ["d"] });
+      });
+  };
+  // an init script runs before <body> exists; observing a null body throws and loses the hook
+  const go = () => {
+    attach();
+    new MutationObserver(attach).observe(document.body, { childList: true, subtree: true });
+  };
+  if (document.body) go();
+  else document.addEventListener("DOMContentLoaded", go, { once: true });
+};
+
+test("G10: every poseFronts consumer re-cuts at most 62.5 times a second, and at the panel's rate below it", async ({
+  browser,
+}, testInfo) => {
+  test.setTimeout(180000);
+  const clock = clockFor();
+  const ctx = await browser.newContext({ reducedMotion: "no-preference" });
+  await ctx.addInitScript(clock.script as (a?: typeof clock.arg) => void, clock.arg);
+  await ctx.addInitScript(OBSERVE_CUTS, CONSUMERS);
+  const a = await ctx.newPage();
+  await a.goto(`/?wire=local&size=3&difficulty=${DEAL}`);
+  await a.waitForSelector(".sudoku-cell", { timeout: 60000 });
+  expect(await a.evaluate(() => matchMedia("(prefers-reduced-motion: reduce)").matches)).toBe(
+    false,
+  );
+  const t0 = await a.evaluate(() => performance.now());
+  // the tally's grade lands off the solver worker; re-deal until it inks ≥ 3 strokes (one pose's)
+  const INKED = () => {
+    const t = document.querySelector(".difficulty-tally");
+    if (!t || t.classList.contains("is-ungraded")) return -1;
+    return document.querySelector(".dt-pose")?.querySelectorAll(".dt-stroke.inked").length ?? 0;
+  };
+  const BOARD = () =>
+    Array.from(document.querySelectorAll(".sudoku-cell input[aria-label]"), (c) => c.getAttribute("aria-label")).join("|");
+  let inked: number;
+  let deals = 1;
+  for (;;) {
+    await expect.poll(() => a.evaluate(INKED), { timeout: 30000 }).toBeGreaterThanOrEqual(0);
+    inked = await a.evaluate(INKED);
+    if (inked >= 3 || deals >= 6) break;
+    // the next board, not the last one's tally: wait for the cells to change before re-reading
+    const before = await a.evaluate(BOARD);
+    await a.locator('.controls-card button[aria-label="Deal a new board"]').click();
+    await expect.poll(() => a.evaluate(BOARD), { timeout: 15000 }).not.toBe(before);
+    deals++;
+  }
+  await a.waitForTimeout(1500); // the last draw-in ends before the hints move the gauge
+  // the product's own HINT, pressed the way `fillByHint` presses it (the first match in the DOM
+  // is the live control; a locator's `.first()` can resolve a hidden twin)
+  await expect
+    .poll(() => a.evaluate(() => !!document.querySelector<HTMLButtonElement>('[aria-label*="Hint" i]:not([disabled])')), { timeout: 30000 })
+    .toBe(true);
+  // three hints must FILL cells (the gauge moves), or the gauge's row measures nothing: a press
+  // does not always fill (0, 1, 1, 2 over four presses, pass 7), so the row presses until three
+  // fills have landed, at most twelve presses, one fill's tween apart
+  const FILLED = () =>
+    Number(document.querySelector('[role="progressbar"]')?.getAttribute("aria-valuenow") ?? -1);
+  const filled0 = await a.evaluate(FILLED);
+  let fills = 0;
+  for (let press = 0; press < 12 && fills < 3; press++) {
+    const was = await a.evaluate(FILLED);
+    // a hint's fallback reveals the SELECTED cell (a HARD board often has no nameable single):
+    // keep an empty cell selected so every second press can land a digit
+    await a.evaluate(() =>
+      Array.from(document.querySelectorAll<HTMLInputElement>(".sudoku-cell input"))
+        .find((i) => !i.value)
+        ?.focus(),
+    );
+    await a.evaluate(() => document.querySelector<HTMLButtonElement>('[aria-label*="Hint" i]:not([disabled])')?.click());
+    // a loaded solver worker lands the fill late: wait for it (3 s), then one tween's settle
+    const moved = await expect
+      .poll(() => a.evaluate(FILLED), { timeout: 3000 })
+      .toBeGreaterThan(was)
+      .then(() => true, () => false);
+    if (moved) fills++;
+    await a.waitForTimeout(700);
+  }
+  expect(fills, `three hints filled no more than ${fills} cells (gauge ${filled0} → ${await a.evaluate(FILLED)} %)`).toBe(3);
+  const verb = a.locator('.controls-card button[aria-label="Play together on this board"]');
+  await expect(verb).toBeEnabled();
+  await verb.click();
+  await expect.poll(() => new URL(a.url()).searchParams.get("s")).not.toBeNull();
+  await a.waitForTimeout(1500); // the join policy's boot suppression (join-language.spec.ts)
+  const b = await ctx.newPage();
+  await b.goto(a.url());
+  await b.waitForSelector(".sudoku-cell", { timeout: 60000 });
+  await expect.poll(() => a.evaluate(() => (window as any).__cuts.join.d), { timeout: 15000 })
+    .toBeGreaterThan(0);
+  await a.waitForTimeout(2000);
+
+  const hz = await clockHz(a, t0);
+  const ticks = await a.evaluate(() => (window as unknown as { __ticks: number[] }).__ticks);
+  const drops = await a.evaluate(() => (window as unknown as { __drops?: number }).__drops ?? 0);
+  const rafErrors = await a.evaluate(() => (window as unknown as { __rafErrors?: string[] }).__rafErrors ?? []);
+  // THE PANEL AS DELIVERED: the best ANY A.6 gate can do on the write opportunities the page
+  // actually offered in [b0, b1] — the clock's ticks plus the consumer's own writes outside a frame
+  // (a forced start or end, timed on the wall) — greedy (optimal for a minimum-gap schedule) under
+  // the budget's own ceiling: one re-cut per 16 ms slot, a pause banks no credit (a commit a whole
+  // slot late restarts the slots there, as the budget states it in gridPaths). On a panel that
+  // delivers every vsync this IS min(Hz, 62.5); where the page stalls its own frames (the deal's
+  // render: ticks 16/32/32/24 ms at the tally's start, WebKit, pass 8) it is what was offered.
+  const a6Best = (b0: number, b1: number, extra: number[]) => {
+    const slotMs = 1000 / BUDGET_PER_S;
+    let n = 1,
+      last = b0,
+      slot = b0 + slotMs;
+    for (const x of [...ticks, ...extra].sort((u, v) => u - v)) {
+      if (x <= b0 || x > b1 || x < slot || x - last < MIN_GAP_MS) continue;
+      slot = x >= slot + slotMs ? x + slotMs : slot + slotMs;
+      last = x;
+      n++;
+    }
+    return n > 1 ? ((n - 1) / (b1 - b0)) * 1000 : Infinity;
+  };
+  const cuts = await a.evaluate(() => (window as unknown as { __cuts: Cuts }).__cuts);
+  const rings = await a.evaluate(() => document.querySelectorAll(".progress-trace").length);
+  const need = clock.hz !== undefined && clock.hz < MIN_CLOCK_HZ ? FLOOR_SHARE * clock.hz : MIN_CLOCK_HZ;
+  const lines: string[] = [
+    `clock ${clock.name}: measured ${hz.hz.toFixed(1)} Hz over ${hz.gaps} gaps, ${drops} vsyncs dropped by a late pump, ${rafErrors.length} frame callbacks threw${rafErrors.length ? ` [${[...new Set(rafErrors)].join(" | ").slice(0, 300)}]` : ""} (precondition ≥ ${need.toFixed(2)} Hz) · deal ${DEAL} ×${deals}, tally inked ${inked} · .progress-trace nodes ${rings}`,
+  ];
+  const worsts: Record<string, number> = {};
+  const slowest: Record<string, number> = {};
+  const shortfall: Record<string, number> = {};
+  const rateRed: Record<string, number> = {};
+  const floorsOf: Record<string, number[]> = {};
+  // the rate form, PRINTED per burst: 0.9 × the A.6-deliverable best at the clock's measured Hz
+  const rateFloor = FLOOR_SHARE * Math.min(BUDGET_PER_S, hz.hz / Math.ceil((MIN_GAP_MS * hz.hz) / 1000));
+  const load = loadavg()[0];
+  const minGaps: Record<string, number> = {};
+  const bursts_: Record<string, number> = {};
+  let tallyBestDPerFrame = 0;
+  for (const k of Object.keys(CONSUMERS)) {
+    const t = cuts[k].times;
+    // bursts: one event's frames (a gap > 300 ms starts the next event)
+    const bursts: number[][] = [];
+    const burstD: number[] = [];
+    const burstLag: number[][] = [];
+    const burstFr: number[][] = [];
+    t.forEach((x, i) => {
+      const cur = bursts[bursts.length - 1];
+      if (cur && x - cur[cur.length - 1] <= 300) {
+        cur.push(x);
+        burstD[burstD.length - 1] += cuts[k].n[i];
+        burstLag[burstLag.length - 1].push(cuts[k].lag[i]);
+        burstFr[burstFr.length - 1].push(cuts[k].frames[i]);
+      } else {
+        bursts.push([x]);
+        burstD.push(cuts[k].n[i]);
+        burstLag.push([cuts[k].lag[i]]);
+        burstFr.push([cuts[k].frames[i]]);
+      }
+    });
+    const dPerFrame = bursts.map((q, i) => burstD[i] / q.length);
+    if (k === "tally") tallyBestDPerFrame = Math.max(0, ...dPerFrame);
+    const rated = bursts
+      .map((q, i) => ({ q, fr: burstFr[i], wall: burstFr[i].filter((_, j) => Number.isNaN(burstLag[i][j])) }))
+      .filter(({ q }) => q.length > 2);
+    // THE RATE IS READ ON THE FRAME CLOCK (pass8/CHAIR-RULINGS §2.4: A.6 binds the frame clock). A
+    // re-cut paints with its frame; at the DOM a burst's endpoints carry the flush lag (the DOM
+    // rate of a gate exactly at the budget read 62.7/s on frames at 62.5/s, pass 8) and print beside.
+    const domRates = rated.map(({ q }) => ((q.length - 1) / (q[q.length - 1] - q[0])) * 1000);
+    const rates = rated.map(({ fr }) => ((fr.length - 1) / (fr[fr.length - 1] - fr[0])) * 1000);
+    // each burst's floor on its own frames: 0.9 × min(62.5, the A.6 optimum over its span)
+    const floors = rated.map(({ fr, wall }) => FLOOR_SHARE * Math.min(BUDGET_PER_S, a6Best(fr[0], fr[fr.length - 1], wall)));
+    worsts[k] = Math.max(0, ...rates);
+    slowest[k] = Math.min(Infinity, ...rates);
+    // THE FLOOR, GATED on the A.6-delivered form (pass9/CHAIR-RULINGS §6, LAWS P8 §D), every burst;
+    // the rate form prints beside it with the box's load (a red there alone is the page's stall)
+    shortfall[k] = Math.min(Infinity, ...rates.map((r, i) => r - floors[i]));
+    rateRed[k] = rates.filter((r) => r < rateFloor).length;
+    floorsOf[k] = floors;
+    bursts_[k] = rates.length;
+    // each burst's shortest gap, the end-write included: on the frame clock (gated) and at the DOM
+    const minOf = (q: number[]) => Math.min(...q.slice(1).map((x, i) => x - q[i]));
+    // the pair behind the minimum frame gap, both clocks and both lags (a race reads as a big lag)
+    let pair = "";
+    burstFr.forEach((q, bi) =>
+      q.slice(1).forEach((x, i) => {
+        if (x - q[i] === Math.min(Infinity, ...burstFr.filter((z) => z.length > 1).map(minOf)))
+          pair ||= `frames ${q[i].toFixed(1)}→${x.toFixed(1)}, DOM ${bursts[bi][i].toFixed(1)}→${bursts[bi][i + 1].toFixed(1)}, lags ${burstLag[bi][i]?.toFixed?.(1)}/${burstLag[bi][i + 1]?.toFixed?.(1)}`;
+      }),
+    );
+    const mins = burstFr.filter((q) => q.length > 1).map(minOf);
+    const domMins = bursts.filter((q) => q.length > 1).map(minOf);
+    minGaps[k] = Math.min(Infinity, ...mins);
+    const domMin = Math.min(Infinity, ...domMins);
+    // THE FLUSH LAG, NAMED (§2.7d): the pair behind the minimum DOM gap, both clocks and both lags
+    // (NaN = a write outside any frame, timed on the wall), so a DOM red names its mechanism
+    let domPair = "";
+    bursts.forEach((q, bi) =>
+      q.slice(1).forEach((x, i) => {
+        if (x - q[i] === domMin)
+          domPair ||= `DOM ${q[i].toFixed(1)}→${x.toFixed(1)}, frames ${burstFr[bi][i].toFixed(1)}→${burstFr[bi][i + 1].toFixed(1)}, lags ${burstLag[bi][i].toFixed(1)}/${burstLag[bi][i + 1].toFixed(1)}`;
+      }),
+    );
+    lines.push(`${k}: ${cuts[k].d} d records, ${t.length} frames (${(cuts[k].d / Math.max(1, t.length)).toFixed(2)} d/frame; by burst ${dPerFrame.map((v) => v.toFixed(2)).join("/")}), ${rates.length} bursts, rates ${rates.map((v) => v.toFixed(1)).join("/")}/s (worst ${worsts[k].toFixed(1)}, slowest ${slowest[k].toFixed(1)}; floor (gated, A.6-delivered) ${floorsOf[k].map((v) => v.toFixed(1)).join("/")} ${shortfall[k] < 0 ? `RED ${rates.filter((r, i) => r < floorsOf[k][i]).length}/${rates.length}` : "GREEN"}; rate form (printed) 0.9 × A.6's best at ${hz.hz.toFixed(1)} Hz = ${rateFloor.toFixed(1)} ${rateRed[k] ? `RED ${rateRed[k]}/${rates.length}` : "GREEN"} at load ${load.toFixed(1)}), DOM rates ${domRates.map((v) => v.toFixed(1)).join("/")}/s${domRates.some((r) => r > BUDGET_PER_S) ? " DOM>62.5" : ""}, frame min ${minGaps[k].toFixed(1)} ms [${pair}], DOM min ${domMin.toFixed(1)} ms${domMin < MIN_GAP_MS ? ` DOM<15.5 [${domPair}]` : ""}, min gap by burst ${mins.map((v) => v.toFixed(1)).join("/")} ms (DOM ${domMins.map((v) => v.toFixed(1)).join("/")}), flush lag by burst ${burstLag.map((l) => { const f = l.filter((x) => !Number.isNaN(x)); return `${Math.min(...f).toFixed(1)}–${Math.max(...f).toFixed(1)}`; }).join("/")} ms, ${cuts[k].lag.filter((x) => Number.isNaN(x)).length} of ${t.length} outside a frame`);
+  }
+  // every consumer's reading is printed BEFORE any assertion, so a red names all three
+  for (const l of lines) console.log(`G10 ${testInfo.project.name} ${l}`);
+  testInfo.annotations.push({ type: "G10", description: lines.join(" · ") });
+  // THE CLAUSE TABLE (LAWS P7 §F (ii)): every clause's own verdict, printed before the first assertion
+  // stops the row, so a plant's run shows WHICH clauses red it and the clause-sabotage battery reads
+  // off one line (a clause whose plant reds no other clause is the only thing standing between it
+  // and GREEN)
+  const ks = Object.keys(CONSUMERS);
