+    rows.push(`GLYPH self-test ${scheme} dpr${dpr} #g-tape LEGACY-RANGE TAIL12 (cut at ${legacy.toFixed(1)} px, on the svg) ${fmt(lr)} ← the pass-7 hole ${lr.red ? "(read RED here)" : "(GREEN: the fix is load-bearing)"}`);
