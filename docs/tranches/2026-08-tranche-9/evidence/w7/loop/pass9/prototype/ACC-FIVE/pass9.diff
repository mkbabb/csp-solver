+// ---------------------------------------------------------------------- font bindings (FACE CHECK 7)
+/** FACE CHECK 7 (font-binding; the chair p9): every place a FAMILY NAME is bound to bytes — each
+ *  `@font-face` (family + src) in every CSS language, and each `new FontFace(family, source)` in
+ *  code (the family folded through concatenation and consts; a non-literal family is UNRESOLVED).
+ *  A gate compares the bindings of one family: a second binding is a RE-BINDING.
+ *  [{family, src, kind, file, line, unresolved?}] */
+export function fontFaces(fe, { files, read, exists } = {}) {
+  const rd = read ?? ((f) => readFileSync(f, "utf8"));
+  const list = files
+    ? followImports(files, { read: rd, exists })
+    : sources(fe, { read: rd, exists });
+  const out = [];
+  if (!on("font-binding")) return out;
+  const unq = (v) => v?.trim().replace(/^(["'])([\s\S]*)\1$/, "$2") ?? null;
+  for (const f of list) {
+    const file = relative(fe, f);
+    const text = rd(f);
+    for (const r of rulesOf(f, text, fe))
+      if (/^@font-face\b/i.test(r.prelude)) {
+        const get = (p) => r.decls.find((d) => d.prop === p)?.value ?? null;
+        out.push({
+          family: unq(get("font-family")),
+          src: get("src"),
+          kind: "@font-face",
+          file,
+          line: r.line,
+        });
+      }
+    const codes = f.endsWith(".vue")
+      ? sfc(text).scripts.map((s) => s.text)
+      : /\.(ts|tsx|js|mjs)$/.test(f)
+        ? [text]
+        : [];
+    for (const code of codes) {
+      const s = stripJs(code);
+      const consts = constBindings(s);
+      for (const m of s.matchAll(
+        /new\s+FontFace\s*\(\s*((?:[^,()]|\([^()]*\))+?)\s*,\s*((?:[^()]|\([^()]*\))+?)\s*[,)]/g,
+      )) {
+        const fam = foldConcat(m[1], consts);
+        out.push({
+          family: fam ?? `?${m[1].trim()}`,
+          src: foldConcat(m[2], consts) ?? m[2].trim(),
+          kind: "FontFace",
+          file,
+          line: lineAt(s, m.index),
+          ...(fam == null ? { unresolved: true } : {}),
+        });
+      }
+    }
+  }
+  return out;
+}
