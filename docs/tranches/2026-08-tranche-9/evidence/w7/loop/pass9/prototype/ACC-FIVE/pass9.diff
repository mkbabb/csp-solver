+              const v0 = inPop.get(y * W + x);
+              if (v0 == null) continue;
+              if ([[1, 0], [-1, 0], [0, 1], [0, -1]].every(([dx, dy]) => inPop.has((y + dy) * W + x + dx))) core.push(v0);
+            }
+          c = core.length >= sp ? +quantile(core, g5Q).toFixed(2) : v.length >= sp ? +quantile(v, sliceQ).toFixed(2) : null;
+        } else c = v.length >= sp ? +quantile(v, sliceQ).toFixed(2) : null;
+        gw.push(c);
+        if (c != null && c < lim) glows.push(`${k}'${g.ch}':${c}`);
+      });
+      if (glows.length) why.push(`G5 glyph core (${gOn("G5core") ? `interior p${Math.round(g5Q * 100)}` : `p${Math.round(sliceQ * 100)}`}) under ${lim.toFixed(2)} at ${glows.join(", ")}`);
+    }
+  }
