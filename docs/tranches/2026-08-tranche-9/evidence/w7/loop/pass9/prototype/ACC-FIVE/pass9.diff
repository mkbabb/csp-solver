+    ["60 Hz, fine stamps", 60, false, CHAIR(60)],
+    ["30 Hz, whole-ms stamps", 30, true, CHAIR(30)],
+    ["30 Hz, fine stamps", 30, false, CHAIR(30)],
+    ["120 Hz, whole-ms stamps (ProMotion)", 120, true, CHAIR(120)],
+    ["125 Hz, fine stamps (the driven clock, vsync-exact)", 125, false, CHAIR(125)],
+    ["128 Hz, fine stamps (this box's chromium panel)", 128, false, CHAIR(128)],
+    [
+      "75 Hz, fine stamps (A.6 caps it: every second frame)",
+      75,
+      false,
+      0.9 * A6_BEST(75),
+    ],
+    [
+      "90 Hz, fine stamps (A.6 caps it: every second frame)",
+      90,
+      false,
+      0.9 * A6_BEST(90),
+    ],
+    [
+      "100 Hz, fine stamps (A.6 caps it: every second frame)",
+      100,
+      false,
+      0.9 * A6_BEST(100),
+    ],
+    [
+      "144 Hz, fine stamps (A.6 caps it: every third frame)",
+      144,
+      false,
+      0.9 * A6_BEST(144),
+    ],
+    [
+      "165 Hz, fine stamps (A.6 caps it: every third frame)",
+      165,
+      false,
+      0.9 * A6_BEST(165),
+    ],
+    ["240 Hz, fine stamps (every fourth frame clears A.6)", 240, false, CHAIR(240)],
+    ["1000 Hz, fine stamps (the ceiling under load)", 1000, false, CHAIR(1000)],
+  ] as const)("%s: floor, ceiling and A.6 hold", async (_name, hz, quant, floor) => {
+    const r = await stream(hz, Math.round(hz * 2), quant);
+    // the gate reaches A.6's arithmetic best wherever the panel is exact (it keeps every frame A.6
+    // admits), and where the chair's formula is below that best, the formula binds
+    expect(r.perS).toBeGreaterThanOrEqual(
