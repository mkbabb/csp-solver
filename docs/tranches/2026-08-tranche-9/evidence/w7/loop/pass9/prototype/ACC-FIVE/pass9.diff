+                file,
+                kind: `${kind}-setProperty-param`,
+                prelude: "setProperty",
+                value: c.value,
+                line: L(c.at),
+              });
+        } else
+          push({
+            file,
+            kind: `${kind}-setProperty-computed`,
+            prelude: k,
+            value: v,
+            line: L(m.index),
+            unresolved: true,
+          });
+      }
+    }
+    for (const m of js.matchAll(
+      /(?:\.style\s*\.\s*cssText\s*\+?=(?!=)|setAttribute\(\s*(["'`])style\1\s*,)\s*([^;\n]+)/g,
+    )) {
+      if (!on("csstext")) break;
+      const v = foldConcat(m[2].replace(/\)\s*$/, ""), consts);
+      if (v == null)
+        push({
+          file,
+          kind: `${kind}-cssText-computed`,
+          prelude: "cssText",
+          value: m[2].trim(),
+          line: L(m.index),
+          unresolved: true,
+        });
+      else
+        for (const d of decls(v))
+          if (d.prop === token)
+            push({
+              file,
+              kind: `${kind}-cssText`,
+              prelude: "cssText",
+              value: d.value,
+              line: L(m.index),
+            });
+    }
+    for (const m of js.matchAll(/(['"`])((?:\\.|(?!\1)[^\\])*?)\1/g))
+      if (new RegExp(`${esc}\\s*:`).test(m[2]) && !new RegExp(`^${esc}$`).test(m[2])) {
