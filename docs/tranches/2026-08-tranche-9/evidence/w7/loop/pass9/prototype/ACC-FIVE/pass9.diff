+describe("frontGate — the cadence at every refresh rate (pass 8: a rate floor, not only a ceiling)", () => {
+  // THE FLOOR (the chair's, registry-v7 §2.7b): every burst ≥ 0.9 × min(panel Hz, 62.5). THE
+  // CEILING: ≤ 62.5/s, the k-th commit never before the first + k·FRONT_MIN_MS. A.6: no two
+  // frames' commits closer than FRONT_GAP_MS. A.6 alone caps a panel at Hz / ⌈15.5 · Hz / 1000⌉
+  // (every k-th frame), and the chair's formula is reachable only where that is ≥ 56.25/s:
+  // Hz ≤ 64.5, 112.5–129, 168.75–193.5, ≥ 225. Between them no gate that honours A.6 meets it —
+  // 75 Hz commits every second frame (13.3 ms < 15.5), 37.5/s; 90 Hz 45.0; 100 Hz 50.0; 144 Hz
+  // every third, 48.0; 165 Hz every third, 55.0 — so those rows' floor is 0.9 × A.6's best and
+  // says so. The contradiction is the chair's to rule (A.6's 15.5 ms or the formula), not a
+  // gate this file re-words: the rows print both numbers.
+  const CHAIR = (hz: number) => 0.9 * Math.min(hz, 1000 / FRONT_MIN_MS);
+  const A6_BEST = (hz: number) =>
+    1000 / (Math.ceil((FRONT_GAP_MS * hz) / 1000) * (1000 / hz));
