+/**
+ * D10-STALLRUN — A RUN OF STALLS INSIDE A LIVE TWEEN, IN THIS ENGINE (pass 9 row 1; LAWS P8 §D: a
+ * stall cap keys on the SHORTEST recent tick, never a median). The served tree's own `frontTween`
+ * (the dev server's graph, no copy) runs on the page's real rAF chain; a second rAF loop busy-waits
+ * 150 ms in five CONSECUTIVE frames, after twenty healthy ones. Every stalled tick must advance the
+ * tween's clock by at most max(the hand's step, the shortest tick the row saw) + 1 ms, and the
+ * healthy tick after the run keeps its travel. BORN-RED: the pass-8 median of nine (`panelFrameMs`
+ * sorted, the middle tick) lets the fifth stall travel the wall clock (pass-8 critique §0.1).
+ */
+test("D10-stallrun: five consecutive 150 ms stalls inside a live tween each travel at most one frame", async ({ page }, testInfo) => {
+  await page.goto("/?size=3&difficulty=EASY");
+  await page.waitForSelector(".sudoku-cell", { timeout: 60000 });
+  await page.waitForTimeout(1500);
+  // the run's shape (defaults: five 150 ms stalls) and the cap's slack (default 1 ms) are the
+  // battery's knobs: D10_STALL_MS=0 injects none (the vacuity clause), D10_SLACK=±ε pins the margin
+  const nStall = Number(process.env.D10_STALLS ?? 5);
+  const stallMs = Number(process.env.D10_STALL_MS ?? 150);
+  const slack = Number(process.env.D10_SLACK ?? 1);
+  const r = await page.evaluate(async ([grid, cfg, n, ms]) => {
+    const m = await import(/* @vite-ignore */ grid);
+    const c = await import(/* @vite-ignore */ cfg);
+    const rec: { at: number; clock: number }[] = [];
+    const DUR = 1e6;
+    await new Promise<void>((done) => {
+      const tw = m.frontTween({
+        durationMs: DUR,
+        easing: (x: number) => x,
+        onProgress: (e: number, at: number) => rec.push({ at, clock: e * DUR }),
+        onComplete: () => {},
+      });
+      tw.start();
+      let f = 0;
+      const loop = () => {
+        f++;
+        if (f > 20 && f <= 20 + n) {
+          const t = performance.now();
+          while (performance.now() - t < ms);
+        }
+        if (f < 40 + n) requestAnimationFrame(loop);
+        else {
+          tw.stop();
+          done();
+        }
+      };
+      requestAnimationFrame(loop);
+    });
+    return { rec, stepMs: c.MOTION.hand.stepMs as number };
+  }, ["/src/pencil/grid/gridPaths.ts", "/src/pencil/config/pencilConfig.ts", nStall, stallMs] as const);
+  const steps = r.rec.slice(1).map((x, i) => ({ dt: x.at - r.rec[i].at, travel: x.clock - r.rec[i].clock }));
+  const stalled = steps.filter((s) => stallMs > 0 && s.dt >= 0.8 * stallMs);
+  const healthy = steps.filter((s) => !(stallMs > 0 && s.dt >= 0.8 * stallMs));
+  const minTick = Math.min(...healthy.map((s) => s.dt));
+  const cap = Math.max(r.stepMs, minTick) + slack;
+  const line = `${stalled.length} stalled ticks (dt ${stalled.map((s) => s.dt.toFixed(0)).join("/")} ms) travelled ${stalled.map((s) => s.travel.toFixed(1)).join("/")} ms; cap max(stepMs ${r.stepMs}, shortest tick ${minTick.toFixed(1)}) + ${slack} = ${cap.toFixed(2)} ms, margin ${(cap - Math.max(0, ...stalled.map((s) => s.travel))).toFixed(3)} ms; ${healthy.length} healthy ticks, worst healthy shortfall ${Math.max(0, ...healthy.map((s) => s.dt - s.travel)).toFixed(2)} ms; load ${loadavg()[0].toFixed(1)}`;
