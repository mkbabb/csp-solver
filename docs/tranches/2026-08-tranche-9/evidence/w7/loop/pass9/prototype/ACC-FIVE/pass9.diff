+        // `insertRule(".peer { --x: v }")`, a `<style>` textContent, `replaceSync(…)` — is read
+        // as rules, so the last declaration before `}` is a site; a bare declaration list stays decls
+        const rules =
+          on("tok-string-rule") && /\{/.test(m[2])
+            ? cssRules(m[2].replace(/<\/?style[^>]*>/g, " "))
+            : [{ prelude: "'…'", decls: decls(m[2]) }];
