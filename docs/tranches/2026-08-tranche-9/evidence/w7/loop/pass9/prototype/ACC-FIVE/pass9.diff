+    const animate = Element.prototype.animate;
+    Element.prototype.animate = function (...a) {
+      const anim = animate.apply(this, a);
+      if (w.__pp.io === null && this.matches?.(sel)) {
+        w.__pp.io = -1;
+        const ob = new IntersectionObserver((es) => {
+          w.__pp.io = es[0].time;
+          ob.disconnect();
+        });
+        ob.observe(this);
+      }
+      return anim;
+    };
