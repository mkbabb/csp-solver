+    ["9", "the dock's card visible", dockQ(".controls-card { overflow-y: visible; }")],
+    ["9", "C6 a vacuous cap (999rem)", desk(".drawer-case { max-height: 999rem; }")],
+    [
+      "9",
+      "the cap past the viewport by 1px",
+      desk(".drawer-case { max-height: calc(100dvh + 1px); }"),
