+/** T9-W7 §10 pass 4 — THE REGISTRATION TOOK, and THE PUBLISHER RAN (index.css §6.5's two rows).
+ *
+ *  §6.5 strikes every `, 0px` fallback on a measured token and buys the safety back with an
+ *  `@property` registration carrying an absolute initial. That trade is only worth making if
+ *  both halves are held by something that can go red, and until this pass both halves lived in
+ *  a probe — the block's own comment named "two e2e rows" that did not exist. They exist here.
+ *
+ *  ROW 1, THE REGISTRATION TOOK. Delete the publishers on the served page (remove the written
+ *  values from the two elements that carry them — exactly the state a missing publisher leaves)
+ *  and every registered name must still compute to a LENGTH, never to the empty string. HEAD's
+ *  signature for the same strip is `""`.
+ *
+ *  AND THE DISCRIMINATOR, because a presence check alone is one browserslist move from vacuous:
+ *  the build emits a down-level `:root, :host` twin of this block for engines without
+ *  `@property`, so "non-empty" could be that twin rather than the registration. A REGISTERED
+ *  `<length>` rejects an invalid value at computed-value time and falls back to its initial; an
+ *  unregistered custom property computes to the literal token text. Writing `zzz` to the name
+ *  and reading `0px` back is the registration itself answering, and no emitted fallback can
+ *  fake it.
+ *
+ *  ROW 2, THE PUBLISHER RAN. After settle every published name must differ from its initial —
+ *  a registration that quietly stands in for a dead publisher is the failure §6.5 introduces,
+ *  and this is the row that would catch it.
+ */
+test("THE REGISTRATION TOOK and THE PUBLISHER RAN — §6.5's trade, both halves", async ({
+  page,
+}) => {
+  await loadSudoku(page);
+  await page.waitForTimeout(400);
+
+  const NAMES = [
+    "--masthead-foot",
+    "--case-offset",
+    "--sheet-chrome",
+    "--pin-band",
+  ];
+  const READ = (names: string[]) => {
+    const el = document.querySelector(".controls-card") ?? document.documentElement;
+    const cs = getComputedStyle(el);
+    return Object.fromEntries(names.map((n) => [n, cs.getPropertyValue(n).trim()]));
+  };
+
+  // ROW 2 first, while the publisher is still alive: every PUBLISHED name ≠ its 0px initial.
+  const live = await page.evaluate(READ, NAMES);
+  // pass 7: `--card-foot-h` is no longer published (the case is a flex column), and its
+  // registration went with it.
+  const PUBLISHED = ["--masthead-foot"];
+  for (const n of PUBLISHED) {
+    expect(parseFloat(live[n]), `THE PUBLISHER RAN: ${n} is still at its initial (${live[n]})`).toBeGreaterThan(0);
+  }
+
+  // THE DISCRIMINATOR. A registered `inherits: true` <length> handed an invalid value is
+  // invalid at computed-value time and takes its PARENT's value (the initial only when no
+  // ancestor declares the name — the build's `:root, :host` twin can). So the parent is STATED:
+  // the row plants `7px` on the card's parent and the invalid value must read exactly that; an
+  // unregistered name keeps its token text (the negative control below).
+  const invalid = await page.evaluate(() => {
+    const card = document.querySelector(".controls-card") as HTMLElement | null;
+    const parent = card?.parentElement;
+    if (!card || !parent) return null;
+    parent.style.setProperty("--pin-band", "7px");
+    card.style.setProperty("--pin-band", "zzz-not-a-length");
+    const after = getComputedStyle(card).getPropertyValue("--pin-band").trim();
+    card.style.removeProperty("--pin-band");
+    parent.style.removeProperty("--pin-band");
+    return { after, parent: parent.className.toString().slice(0, 40) };
+  });
+  expect(
+    invalid?.after,
+    `the registration is not live: an invalid <length> under a 7px parent (${invalid?.parent}) computed to "${invalid?.after}"`,
+  ).toBe("7px");
+
+  // ROW 1 — delete the publishers' written values and read again.
+  await page.evaluate(() => {
+    for (const n of ["--masthead-foot", "--case-offset"])
+      document.documentElement.style.removeProperty(n);
+  });
+  await page.waitForTimeout(150);
+  const stripped = await page.evaluate(READ, NAMES);
+  for (const n of NAMES) {
+    expect(
+      stripped[n],
+      `THE REGISTRATION TOOK: ${n} computed to "" with the publisher deleted`,
+    ).not.toBe("");
+    expect(
+      Number.isFinite(parseFloat(stripped[n])),
+      `THE REGISTRATION TOOK: ${n} computed to a non-length "${stripped[n]}"`,
+    ).toBe(true);
+  }
+
+  // NEGATIVE CONTROL, in the same run: this row must be able to see an UNREGISTERED name go
+  // empty, or "non-empty" is a statement about custom properties in general and not about the
+  // block. `--tap-floor` is §6.5's own declared out-list entry and is declared at `.page-root`,
+  // so the card is a host that DECLARES nothing for it — the ablation is read where the name
+  // is genuinely absent (chair §6.5's fourth clause).
+  const control = await page.evaluate(() => {
+    const card = document.querySelector(".controls-card") as HTMLElement | null;
+    const probe = getComputedStyle(card!).getPropertyValue("--not-registered-at-all").trim();
+    card!.style.setProperty("--not-registered-at-all", "zzz-not-a-length");
+    const raw = getComputedStyle(card!).getPropertyValue("--not-registered-at-all").trim();
+    card!.style.removeProperty("--not-registered-at-all");
+    return { absent: probe, raw };
+  });
+  expect(control.absent, "negative control: an unregistered name must read empty").toBe("");
+  expect(
+    control.raw,
+    "negative control: an unregistered name must keep its invalid token text",
+  ).toBe("zzz-not-a-length");
 });
 
