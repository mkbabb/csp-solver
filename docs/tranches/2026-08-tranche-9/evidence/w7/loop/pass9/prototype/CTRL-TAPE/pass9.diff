+// postpaint.d.mts — the TYPES of the ONE post-paint sampler and painted-frame recorder (`./postpaint.mjs`),
+// so a TypeScript spec imports it under `typecheck:e2e` (strict, no `allowJs`). No behaviour lives here.
+// Every export is typed with its option names (LAWS P8 §I: never `[k: string]: unknown`); the pass-8
+// hand-rolled copies (ERASE, VERB, TAPE, the WAVE's) are folded into this one.
+// NOT-A-LANE: the chair's home (T9-W7 pass 9, homes v2).
+import type { Browser, Page } from "@playwright/test";
+
+/** One read of the subject: frame index, the frame's timeline time, the timeline AT the read (a post
+ *  read whose `tlNow` moved past `tl` is STALE: the next frame's), the scripted animation's clock, the centre. */
+export interface PPRead {
+  k: number;
+  tl: number;
+  tlNow?: number;
+  ct: number | null;
+  ps: string | null;
+  x: number;
+  y: number;
+  w: number;
+  stale?: boolean;
+}
+/** `window.__pp` after `installSampler`. */
+export interface PP {
+  inRAF: PPRead[];
+  post: PPRead[];
+  rAF2: PPRead[];
+  stamps: number[];
+  io: number | null;
+  done: boolean;
+}
+/** One analysed arm: F1 (frame 1 at rest by position AND at ct ≤ ctTol) and CI (the clock identity). */
+export interface Arm {
+  red: boolean;
+  f1red: boolean;
+  f1pos?: boolean;
+  f1ct?: boolean;
+  ciRed: boolean;
+  why: string[];
+  f1: { k: number; ct: number; c: number; dw: number; ps: string | null; stale?: boolean } | null;
+  ci: { k: number; ct: number; tlDelta: number; off: number }[];
+  frames?: number;
+  dropped: number;
+  stale?: number;
+}
+export interface Mover {
+  kPaint: number;
+  /** the frame the rAF time alone keys (the pass-8 key), and the POST frames read from it (printed) */
+  kStamp: number;
+  byStamp: Arm;
+  io: number | "none" | "pending";
+  post: Arm;
+  legacy: Arm;
+  inRAF: Arm;
+  rAF2: Arm;
+}
+export interface AnalyseOptions {
+  kPaint?: number;
+  tolPx?: number;
+  tolMs?: number;
+  ks?: number[];
+  /** F1ct: frame 1's clock bound in ms (default 4) */
+  ctTol?: number;
+  /** the in-rAF reads that stand in for a STALE post read of the same frame */
+  inRAF?: PPRead[] | null;
+}
+export const PP_CLAUSES: readonly string[];
+export function installSampler(o: { sel: string; anyAnim?: boolean; maxFrames?: number; io?: boolean }): void;
+export function kPaintByStamp(pp: Pick<PP, "io" | "stamps">): number;
+export function kPaintOf(pp: Pick<PP, "io" | "stamps"> & { inRAF?: PPRead[] }): number;
+export function analyse(frames: PPRead[], rest: { x: number; y: number; w: number }, o?: AnalyseOptions): Arm;
+/** Every explicit startTime write lands `ms` early (default 150; 16 = the one-frame skip F1ct sees). */
+export function SKIP_PLANT(ms?: number): void;
+/** Frame 1 at rest, the clock jumping 150 ms on the second rAF (CI reds, F1 green). */
+export function F2_PLANT(sel: string): void;
+/** The first keyframe 40 px off the rest pose at ct 0 (F1's position clause alone reds). */
+export function FROM_PLANT(sel: string): void;
+export function readMover(page: Page, o: { sel: string; key?: string | null; click?: string | null; io?: boolean }): Promise<Mover>;
+export function fmtArm(r: Arm): string;
+export function unitSelfTest(): { rows: string[]; hole: boolean };
+export function samplerSelfTest(browser: Browser, o?: { reps?: number }): Promise<{ rows: string[]; exit: number }>;
+
+// ── II · the painted-frame recorder ─────────────────────────────────────────────────────────────
+export interface Stat {
+  n: number;
+  min: number;
+  median: number;
+  p95: number;
+  max: number;
+}
+/** A recording's options: the page, the trigger (`key:<k>`, `click:<sel>`, `load`), the ROI, the subject
+ *  (`<sel>`, `css:<sel>:<prop>`, `ruled:<sel>`, `len:<sel>`, `range:<sel>`), a busy plant. */
+export interface RecordOptions {
+  url?: string;
+  html?: string;
+  viewport: { width: number; height: number };
+  dpr?: number;
+  scheme?: "light" | "dark";
+  touch?: boolean;
+  trigger: string;
+  roi?: string | null;
+  subject?: string | null;
+  windowMs?: number;
+  eps?: number;
+  heldMs?: number;
+  plant?: { busyMs: number; delayMs: number } | null;
+  ready?: string;
+}
+export interface Photos {
+  photos: number;
+  changed: number;
+  eps: number;
+  deltaMedian: number | null;
+  windowMs: number;
+  firstChange: number | null;
+  gapMs: Stat;
+  maxHeldMs: number;
+  heldAt: number | null;
+  deltas: [number, number][];
+}
+export interface Timeline {
+  rafs: number;
+  gapMs: Stat;
+  maxGapMs: number;
+  at: number | null;
+}
+export type Held = [number, number][];
+export interface Recording {
+  engine: string;
+  trigger: string;
+  roi: { x: number; y: number; w: number; h: number } | null;
+  held: { photo: Held; rAF: Held; subject: Held };
+  subjectMaxMs: number;
+  plantSeen: { photo: boolean; rAF: boolean; subject: boolean } | null;
+  subjectMovedFrames: number;
+  motionMs: number;
+  latencyMs: number;
+  plant: { busyMs: number; delayMs: number } | null;
+  plantRanAt: number | null;
+  photos: Photos;
+  timeline: Timeline;
+  load: number[];
+}
+export function loadArr(): number[];
+/** Page-side (an init script or `page.evaluate`): the painted timeline in `window.__pf`. */
+export function installTimeline(sel?: string | null): void;
+export function startPhotos(page: Page, engine: string, size: { width: number; height: number }): Promise<() => Promise<{ t: number; png: Uint8Array }[]>>;
+export function stat(a: number[]): Stat;
+export function analysePhotos(
+  browser: Browser,
+  frames: { t: number; png: Uint8Array }[],
+  roiCss: { x: number; y: number; w: number; h: number },
+  scale?: number,
+  eps?: number,
+  t0?: number,
+  t1?: number,
+): Promise<Photos>;
+export function analyseTimeline(pf: { rafs: number[] }, t0: number, t1: number): Timeline;
+export function clockSelfTest(
+  browser: Browser,
+  engine: string,
+  viewport?: { width: number; height: number },
+): Promise<{ photosPerSec: number; photoGapMs: Stat; rafPerSec: number; rafGapMs: Stat; load: number[] }>;
+export function record(browser: Browser, engine: string, o: RecordOptions): Promise<Recording>;
+export function verdict(
+  r: Recording,
+  engine: string,
+  o?: { held?: number; subject?: string | null },
+): { red: boolean; empty: boolean; primary: number; track: "photo" | "subject" | "rAF" };
+export function ladder(browser: Browser, o: RecordOptions, K?: number): Promise<Record<string, number | string | null>[]>;
+export function recorderSelfTest(browser: Browser, engine: string): Promise<{ rows: string[]; exit: number }>;
