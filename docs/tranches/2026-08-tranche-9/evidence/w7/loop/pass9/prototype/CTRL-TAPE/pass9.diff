index 00000000..4c6cd96f
--- /dev/null
+++ b/web/frontend/e2e/lib/glyph-pop.d.mts
@@ -0,0 +1,88 @@
+// glyph-pop.d.mts — the TYPES of the ONE glyph-population probe (`./glyph-pop.mjs`), so a TypeScript spec
+// imports it under `typecheck:e2e` (strict, no `allowJs`). No behaviour lives here; every export is typed
+// with its option names (LAWS P8 §I: never `[k: string]: unknown`). PLR-COUNT's pass-8 hand-rolled copy
+// (`GlyphRead`, `GlyphPlant`) is folded in by name.
+// NOT-A-LANE: the chair's home (T9-W7 pass 9, homes v2).
+import type { Browser, Page } from "@playwright/test";
+
+/** One population read: `why` holds one entry per breached clause, each led by its id (G0 … G5). */
+export interface GlyphRead {
+  red: boolean;
+  why: string[];
+  population?: number;
+  coreMedian?: number;
+  fracUnder?: number;
+  columns?: number;
+  slicePop?: number;
+  slices?: (number | null)[];
+  glyphCores?: (number | null)[];
+  /** the G4 columns read low (labels `k` / `½k`), untolerated */
+  g4Lows?: string[];
+  /** the G4 columns the CONTROL's lows tolerated (`label:core`) */
+  g4Tolerated?: string[];
+  transientOn?: number;
+  transientOff?: number;
+  outsideRun?: number;
+  clip?: { x: number; y: number; width: number; height: number };
+  dpr?: number;
+}
+/** The probe's options. `tolerate` = the CONTROL's g4Lows (never this run's own). */
+export interface GlyphOptions {
+  subject: string;
+  off?: string | null;
+  floor?: number;
+  minPop?: number;
+  fracBound?: number | null;
+  delta?: number;
+  pad?: number;
+  slices?: number | "auto";
+  slicePop?: number | "auto";
+  sliceRatio?: number;
+  sliceQ?: number;
+  textRun?: boolean;
+  glyphWindows?: boolean;
+  runClip?: boolean;
+  /** G5: the quantile of the glyph's interior read (default 0.5) */
+  g5Q?: number;
+  tolerate?: string[] | null;
+}
+/** A plant: a CSS string, or a mask over the text run — `[a, b]` of the run (or glyph `glyph`'s box) at
+ *  25 %, striped (1 px at 25 % α) with `comb`. */
+export type GlyphPlant = string | { mask: [number, number]; comb?: boolean; glyph?: number | null };
+/** The control-anchored reference: the CONTROL's read of the same payload. */
+export type GlyphControl = Pick<GlyphRead, "fracUnder" | "g4Lows" | "population">;
+export interface GlyphGateOptions extends Omit<GlyphOptions, "fracBound"> {
+  payload: string;
+  plants?: Record<string, GlyphPlant> | null;
+  slack?: number;
+  img?: { ng: string; ink?: [number, number] } | null;
+  control?: GlyphControl | null;
+}
+export interface GlyphGate {
+  payload: string;
+  bound: number | null;
+  clean: GlyphRead;
+  plants: Record<string, GlyphRead>;
+}
+
+export const GLYPH_CLAUSES: readonly string[];
+export function autoSlices(span: number): number;
+export function glyphPopulation(page: Page, o: GlyphOptions): Promise<GlyphRead>;
+export function glyphGate(page: Page, o: GlyphGateOptions): Promise<GlyphGate>;
+/** G3's bound from a reference fraction, clamped below 1 at a reference ≥ 0.95. */
+export function boundOf(frac: number | null | undefined, slack?: number, pop?: number, minPop?: number): number | null;
+export function FILE_PLANTS(subject: string): Record<"OPA80F" | "COMB", string>;
+export function TEXT_PLANTS(subject: string): Record<string, GlyphPlant>;
+export function IMG_PLANTS(subject: string, ng: string, ink?: [number, number]): Record<string, string>;
+export function applyPlant(page: Page, subject: string, plant: GlyphPlant): Promise<() => Promise<void>>;
+export function applyTail(page: Page, subject: string, tail: number): Promise<unknown>;
+export function undoTail(page: Page, subject: string): Promise<void>;
+export function applyMask(
+  page: Page,
+  subject: string,
+  range: [number, number],
+  o?: { comb?: boolean; glyph?: number | null },
+): Promise<{ ok: boolean; run?: [number, number]; cut?: [number, number]; box?: number }>;
+export function undoMask(page: Page, subject: string): Promise<void>;
+export function selfTest(browser: Browser, o?: { dpr?: number }): Promise<{ rows: string[]; exit: number }>;
+export function fmt(r: GlyphRead): string;
diff --git a/web/frontend/e2e/lib/glyph-pop.mjs b/web/frontend/e2e/lib/glyph-pop.mjs
new file mode 100644
index 00000000..39a15c5f
--- /dev/null
+++ b/web/frontend/e2e/lib/glyph-pop.mjs
@@ -0,0 +1,540 @@
+// glyph-pop.mjs — THE glyph-population probe (T9-W7; registry-v5 §2.11 statistic, LAWS P6 §E, P7 §E
+// (v); registry-v7 §2.4 PRODUCT HOME). A painted-text gate reads the WHOLE glyph-coverage population:
+//   the subject photographed ON and with its text transparent (`color` AND `-webkit-text-fill-color`
+//   transparent, text-shadow none; or the caller's `off` sheet for an ink that is not text — TAB-PEN's
+//   favicon <img> photographed as its paper-only twin); every pixel whose RGB moved by ≥ `delta`
+//   (6/255) is a glyph pixel; its value = contrast(ON pixel, OFF pixel), the ink against its own ground.
+// The population is CLIPPED TO THE TEXT RUN (its text nodes' rects, never an svg or hidden descendant:
+// TIN/FIVE) and keeps only pixels STABLE across two ON photographs AND two OFF photographs (TIN: a
+// stray far-right cluster changed between the ON and OFF of one pair and red a clean tree 2 in 4).
+// Clauses (every one RED on breach — never `min(4.5, 0)`, never a skip):
+//   G0  the subject exists and is visible
+//   G1  the population ≥ `minPop` (40) px — an EMPTY or thin population is RED
+//   G2  the core median ≥ `floor` (4.5) — ABSOLUTE, never relative to an in-run photo of the subject
+//   G3  the fraction under `floor` ≤ `fracBound` — the bound is PER PAYLOAD (WALK: a pooled stamp
+//       handed the tighter subject the looser bound and masked a WebKit FADE65); `glyphGate` takes
+//       the clean read of THIS payload + 0.05
+//   G4  x-columns: every column holding ≥ `slicePop` px keeps its CORE (p95) ≥ max(3.0, 0.4 × the
+//       whole population's p95). The column count SCALES TO THE INK SPAN (TAB-PEN/COUNT: 16 columns
+//       over ~10 px of ink hold < 8 px each and G4 went blind) and the grid is read twice, aligned and
+//       shifted by half a column, so a 12 % fade always covers one whole column
+//   G5  glyph windows: the same core clause per CHARACTER (a Range per character of the run — COUNT:
+//       a p95 per x-window is blind to a fade over < ~95 % of it, and the leading digit is the
+//       costliest glyph to lose)
+// Plants (TEXT_PLANTS / IMG_PLANTS; each must RED): FAINT30, FADE65, FADE80 (fill), TAIL12, TAIL35,
+// HEAD12, MID20 (a mask over that fraction of the RUN at 25 %), EMPTY.
+//   node e2e/lib/glyph-pop.mjs --self-test [--engine chromium|webkit]     synthetic subjects, every plant
+//   node e2e/lib/glyph-pop.mjs --url <u> --subject <sel> --payload <name> [--scheme dark] [--dpr 2]
+//        [--viewport 1280x800] [--ready <sel>] [--click <sel>] [--hover <sel>] [--touch] [--prm 0]
+//        [--contrast more] [--regimes all]   (`all` = every paint-lib PAINT_REGIMES stop, LAWS P7 §E)
+// Exit: 0 clean GREEN and every plant RED · 1 clean RED · 3 a plant GREEN (a hole) · 4 both.
+import process from "node:process";
+import { fileURLToPath } from "node:url";
+import { resolve as resolvePath } from "node:path";
+import {
+  onOff,
+  lum,
+  ratio,
+  median,
+  quantile,
+  maxDelta,
+  settle,
+  textRunRects,
+  args,
+  load,
+  playwright,
+  openCell,
+  cellsOf,
+} from "./paint-lib.mjs";
+
+/** The column count for an ink span of `span` device px (G4). The floor is 13, not 8:
+ *  the aligned and half-shifted grids hold a WHOLE column inside any 12 % end run only when 1.5 / n ≤ 0.12
+ *  (at 8 columns a 17 px icon's TAIL12 straddled two columns and read GREEN in WebKit at DPR 1, pass 8). */
+export const autoSlices = (span) =>
+  Math.max(1, Math.min(Math.floor(span), 24, Math.max(13, Math.round(span / 3))));
+const autoSlicePop = (pop, n) => Math.max(3, Math.min(8, Math.round(pop / n / 3)));
+/** Clause switches for the glyph-pop sabotage battery (GLYPH_SABOTAGE=a,b; LAWS P7 §F (ii)): the chair's
+ *  pass-9 clauses — G5core (G5 reads a LOW quantile of the glyph's INTERIOR), G3clamp (a clean ≥ 0.95
+ *  never bounds G3 above 1), anchor (the control-anchored bound), g4tol (G4 tolerates only the
+ *  CONTROL's low columns, never this run's own). */
+export const GLYPH_CLAUSES = ["G5core", "G3clamp", "anchor", "g4tol"];
+const G_OFF = new Set((process.env.GLYPH_SABOTAGE ?? "").split(",").filter(Boolean));
+const gOn = (c) => !G_OFF.has(c);
+
+export async function glyphPopulation(
+  page,
+  { subject, off = null, floor = 4.5, minPop = 40, fracBound = null, delta = 6, pad = 2, slices = "auto", slicePop = "auto", sliceRatio = 0.4, sliceQ = 0.95, textRun = true, glyphWindows = true, runClip = true, g5Q = 0.5, tolerate = null },
+) {
+  const loc = page.locator(subject).first();
+  // ACC-SIX pass 8 (PROPOSED → the ONE copy; LAWS P7 §E): a text laid in a ZERO-HEIGHT box (the strip's
+  // yielding meta) paints outside its box, so the box is not the clip: the clip is the box ∪ the text
+  // run, and a box Playwright calls invisible (0 px tall) is visible when its run paints. `runClip:
+  // false` is the legacy box clip (the self-test's ZERO row reads it G0/G1 — the hole this closes).
+  const runCss = textRun && runClip ? await page.evaluate(textRunRects, { subject }) : null;
+  const vis = (await loc.isVisible().catch(() => false)) || !!runCss?.length;
+  if (!vis) return { red: true, why: [`G0 subject ${subject} not visible`] };
+  let b = await loc.boundingBox();
+  if (runCss?.length && b) {
+    const l = Math.min(b.x, ...runCss.map((q) => q.l)),
+      t = Math.min(b.y, ...runCss.map((q) => q.t)),
+      r = Math.max(b.x + b.width, ...runCss.map((q) => q.r)),
+      bt = Math.max(b.y + b.height, ...runCss.map((q) => q.b));
+    b = { x: l, y: t, width: r - l, height: bt - t };
+  }
+  const vw = page.viewportSize();
+  const dpr = await page.evaluate(() => devicePixelRatio);
+  const x = Math.max(0, Math.floor(b.x - pad)),
+    y = Math.max(0, Math.floor(b.y - pad));
+  const clip = {
+    x,
+    y,
+    width: Math.min(vw.width - x, Math.ceil(b.width + 2 * pad)),
+    height: Math.min(vw.height - y, Math.ceil(b.height + 2 * pad)),
+  };
+  const offCss =
+    off ??
+    `${subject}, ${subject} * { color: transparent !important; -webkit-text-fill-color: transparent !important; text-shadow: none !important; }`;
+  // the text run (device px, relative to the clip) — the population's own extent
+  const run = textRun ? await page.evaluate(textRunRects, { subject }) : null;
+  const glyphs = textRun && glyphWindows ? await page.evaluate(textRunRects, { subject, chars: true }) : null;
+  const toDev = (r) => ({
+    l: Math.floor((r.l - clip.x) * dpr) - 1,
+    r: Math.ceil((r.r - clip.x) * dpr) + 1,
+    t: Math.floor((r.t - clip.y) * dpr) - 1,
+    b: Math.ceil((r.b - clip.y) * dpr) + 1,
+  });
+  const runDev = run && run.length ? run.map(toDev) : null;
+  const A = await onOff(page, clip, offCss);
+  const B = await onOff(page, clip, offCss);
+  const W = A.on.w;
+  let transientOn = 0,
+    transientOff = 0,
+    outsideRun = 0;
+  const pop = [],
+    xs = [],
+    ys = [];
+  const inPop = new Map(); // device pixel index → its contrast (the interior read, G5core)
+  for (let i = 0; i < A.on.data.length; i += 3) {
+    const px = (i / 3) % W,
+      py = Math.floor(i / 3 / W);
+    if (maxDelta(A.on.data, A.off.data, i) < delta) continue;
+    const tOn = maxDelta(A.on.data, B.on.data, i) >= delta,
+      tOff = maxDelta(A.off.data, B.off.data, i) >= delta;
+    if (tOn) transientOn++;
+    if (tOff) transientOff++;
+    if (tOn || tOff) continue;
+    if (runDev && !runDev.some((q) => px >= q.l && px < q.r && py >= q.t && py < q.b)) {
+      outsideRun++;
+      continue;
+    }
+    pop.push(ratio(lum(A.on.data, i), lum(A.off.data, i)));
+    xs.push(px);
+    ys.push(py);
+    inPop.set(py * W + px, pop.at(-1));
+  }
+  const why = [];
+  const med = median(pop);
+  const frac = pop.length ? pop.filter((v) => v < floor).length / pop.length : 1;
+  if (pop.length < minPop) why.push(`G1 population ${pop.length} px < ${minPop} (EMPTY/thin is RED)`);
+  else {
+    if (med < floor) why.push(`G2 core median ${med.toFixed(3)} < ${floor}`);
+    if (fracBound != null && frac > fracBound)
+      why.push(`G3 fraction under ${floor} = ${frac.toFixed(3)} > bound ${fracBound.toFixed(3)}`);
+  }
+  const sl = [],
+    gw = [];
+  let g4Lows = [],
+    tolerated = [];
+  let n = 0,
+    sp = 0,
+    lim = 0;
+  if (pop.length >= minPop) {
+    const core = quantile(pop, sliceQ);
+    lim = Math.max(3.0, sliceRatio * core);
+    const x0 = Math.min(...xs),
+      x1 = Math.max(...xs) + 1;
+    n = slices === "auto" ? autoSlices(x1 - x0) : slices;
+    sp = slicePop === "auto" ? autoSlicePop(pop.length, n) : slicePop;
+    const w = (x1 - x0) / n;
+    const lows = [];
+    g4Lows = lows;
+    for (const shift of [0, 0.5]) {
+      for (let k = 0; k < n; k++) {
+        const a = x0 + (k + shift) * w,
+          e = a + w;
+        if (e > x1 + 0.001) continue;
+        const v = pop.filter((_, j) => xs[j] >= a && xs[j] < e);
+        const c = v.length >= sp ? +quantile(v, sliceQ).toFixed(2) : null;
+        if (!shift) sl.push(c);
+        // g4tol (the chair p9; COUNT's G4 tolerance, re-cut): a column is tolerated ONLY when the
+        // CONTROL's read of the same payload holds it low (`tolerate`, from that read's g4Lows) —
+        // never this run's own clean read, which made gated(clean, clean) unable to add a column
+        const label = `${shift ? "½" : ""}${k}`;
+        if (c != null && c < lim) {
+          if (gOn("g4tol") && tolerate?.includes(label)) tolerated.push(`${label}:${c}`);
+          else lows.push(`${label}:${c}`);
+        }
+      }
+    }
+    if (lows.length)
+      why.push(`G4 column core (p${Math.round(sliceQ * 100)}) under ${lim.toFixed(2)} (= max(3.0, ${sliceRatio}×whole p${Math.round(sliceQ * 100)} ${core.toFixed(2)}); ${n} columns, ≥${sp} px) at ${lows.join(", ")}`);
+    if (glyphs && glyphs.length) {
+      const glows = [];
+      glyphs.forEach((g, k) => {
+        const q = toDev(g);
+        const v = pop.filter((_, j) => xs[j] >= q.l + 1 && xs[j] < q.r - 1 && ys[j] >= q.t && ys[j] < q.b);
+        // G5core (the chair p9; COUNT gap 2): the glyph's INTERIOR — population pixels whose four
+        // neighbours are population too (antialiased rims dropped, faded strokes KEPT) — read at a LOW
+        // quantile (g5Q, p50): a p95 per window is blind to a fade over < ~95 % of the glyph (COMB)
+        let c;
+        if (gOn("G5core")) {
+          const core = [];
+          for (let y = q.t; y < q.b; y++)
+            for (let x = q.l + 1; x < q.r - 1; x++) {
+              const v0 = inPop.get(y * W + x);
+              if (v0 == null) continue;
+              if ([[1, 0], [-1, 0], [0, 1], [0, -1]].every(([dx, dy]) => inPop.has((y + dy) * W + x + dx))) core.push(v0);
+            }
+          c = core.length >= sp ? +quantile(core, g5Q).toFixed(2) : v.length >= sp ? +quantile(v, sliceQ).toFixed(2) : null;
+        } else c = v.length >= sp ? +quantile(v, sliceQ).toFixed(2) : null;
+        gw.push(c);
+        if (c != null && c < lim) glows.push(`${k}'${g.ch}':${c}`);
+      });
+      if (glows.length) why.push(`G5 glyph core (${gOn("G5core") ? `interior p${Math.round(g5Q * 100)}` : `p${Math.round(sliceQ * 100)}`}) under ${lim.toFixed(2)} at ${glows.join(", ")}`);
+    }
+  }
+  return {
+    red: why.length > 0,
+    why,
+    population: pop.length,
+    coreMedian: +med.toFixed(3),
+    fracUnder: +frac.toFixed(3),
+    columns: n,
+    slicePop: sp,
+    slices: sl,
+    glyphCores: gw,
+    g4Lows: g4Lows.map((x) => x.split(":")[0]),
+    g4Tolerated: tolerated,
+    transientOn,
+    transientOff,
+    outsideRun,
+    clip,
+    dpr,
+  };
+}
+
+/** THE PER-PAYLOAD GATE (WALK W4): read the clean subject for THIS payload, bound G3 at its own
+ *  fraction + `slack`, then read every plant against that bound. `payload` names what the page holds
+ *  (a board, a deal, a peer id) and is REQUIRED — a bound is never pooled across payloads. */
+export async function glyphGate(page, { subject, payload, plants = null, slack = 0.05, img = null, control = null, ...opts }) {
+  if (!payload) throw new Error("glyphGate: `payload` is required (a G3 bound is per payload, never pooled)");
+  const first = await glyphPopulation(page, { subject, ...opts });
+  // anchor (the chair p9; COUNT gap 1 / LAWS P8 §F): with `control` — the CONTROL tree's read of the
+  // SAME payload ({fracUnder, g4Lows}) — G3 is bound at the control's fraction + slack and G4
+  // tolerates only the control's low columns; a bound cut from this run's own clean read cannot see a
+  // shipped regression (OPA80F: frac 1.000 against its own 1.050)
+  const ref = control && gOn("anchor") ? control : first;
+  const bound = boundOf(ref.fracUnder, slack, ref.population ?? Infinity, opts.minPop ?? 40);
+  opts = { ...opts, tolerate: control && gOn("anchor") ? (control.g4Lows ?? []) : opts.tolerate };
+  const clean = await glyphPopulation(page, { subject, fracBound: bound, ...opts });
+  const P = plants ?? (img ? IMG_PLANTS(subject, img.ng, img.ink) : TEXT_PLANTS(subject));
+  const out = {};
+  for (const [name, plant] of Object.entries(P)) {
+    const undo = await applyPlant(page, subject, plant);
+    await settle(page);
+    const r = await glyphPopulation(page, { subject, fracBound: bound, ...opts });
+    await undo();
+    await settle(page);
+    out[name] = r;
+  }
+  return { payload, bound, clean, plants: out };
+}
+
+/** G3's bound from a reference fraction: ref + slack, CLAMPED (G3clamp, the chair p9; COUNT gap 4) —
+ *  at a reference ≥ 0.95 the bound is half-way from it to 1, so it never reaches 1.0 and a plant that
+ *  drives every pixel under the floor (OPA80F's 1.000) still reds. null when the reference is thin. */
+export const boundOf = (frac, slack = 0.05, pop = Infinity, minPop = 40) => {
+  if (frac == null || pop < minPop) return null;
+  const b = frac + slack;
+  return gOn("G3clamp") && frac >= 0.95 ? Math.min(b, frac + (1 - frac) / 2) : b;
+};
+/** The FILE plants (COUNT, pass 8's critic): CSS a lane writes INTO the product file under test (never
+ *  an in-run sheet that the in-run plants could shadow). OPA80F: the subject at opacity 0.8. COMB: 1 px
+ *  stripes at 25 % α over the whole subject (a repeating mask). Each must RED on the shipped surface. */
+export const FILE_PLANTS = (s) => ({
+  OPA80F: `${s} { opacity: 0.8 !important; }`,
+  COMB: `${s} { -webkit-mask-image: repeating-linear-gradient(to right, #000 0 1px, rgba(0,0,0,.25) 1px 2px) !important; mask-image: repeating-linear-gradient(to right, #000 0 1px, rgba(0,0,0,.25) 1px 2px) !important; }`,
+});
+/** The in-run text plants (LAWS P6 §E, P7 §E (v)) — each must RED. FAINT/FADE move only the FILL
+ *  (`color` stays green); `{ mask: [a, b] }` paints the fraction a..b of the TEXT RUN (text nodes
+ *  only) at 25 % through a mask keyed to the run's own pixels: TAIL12 [0.88, 1], TAIL35 [0.65, 1],
+ *  HEAD12 [0, 0.12] (COUNT: the leading digit), MID20 [0.4, 0.6]. */
+export const TEXT_PLANTS = (s) => ({
+  FAINT30_fill: `${s}, ${s} * { -webkit-text-fill-color: color-mix(in srgb, currentColor 30%, transparent) !important; }`,
+  FADE65_fill: `${s}, ${s} * { -webkit-text-fill-color: color-mix(in srgb, currentColor 65%, transparent) !important; }`,
+  FADE80_fill: `${s}, ${s} * { -webkit-text-fill-color: color-mix(in srgb, currentColor 80%, transparent) !important; }`,
+  TAIL12_a25: { mask: [0.88, 1] },
+  TAIL35_a25: { mask: [0.65, 1] },
+  HEAD12_a25: { mask: [0, 0.12] },
+  MID20_a25: { mask: [0.4, 0.6] },
+  COMB_a25: { mask: [0, 1], comb: true },
+  EMPTY_hidden: `${s}, ${s} * { color: transparent !important; -webkit-text-fill-color: transparent !important; }`,
+});
+/** TAB-PEN (pass 7 PROPOSED): the plants' twins for an IMAGE subject (a favicon <img>): FAINT/FADE by
+ *  opacity, TAIL/HEAD by a mask over that fraction of the INK's x-extent (`ink` = [x0, x1] as fractions
+ *  of the box), EMPTY by the paper-only twin `ng`. Each must RED. */
+export const IMG_PLANTS = (s, ng, ink = [6 / 32, 26 / 32]) => {
+  const band = (a, bnd) => {
+    const p0 = ((ink[0] + a * (ink[1] - ink[0])) * 100).toFixed(2),
+      p1 = ((ink[0] + bnd * (ink[1] - ink[0])) * 100).toFixed(2);
+    const g = `linear-gradient(to right, #000 ${p0}%, rgba(0,0,0,.25) ${p0}%, rgba(0,0,0,.25) ${p1}%, #000 ${p1}%)`;
+    return `${s} { -webkit-mask-image: ${g} !important; mask-image: ${g} !important; }`;
+  };
+  return {
+    FAINT30_opacity: `${s} { opacity: 0.3 !important; }`,
+    FADE65_opacity: `${s} { opacity: 0.65 !important; }`,
+    FADE80_opacity: `${s} { opacity: 0.8 !important; }`,
+    TAIL12_a25: band(0.88, 1),
+    TAIL35_a25: band(0.65, 1),
+    HEAD12_a25: band(0, 0.12),
+    EMPTY_paper: `${s} { content: url("${ng}") !important; }`,
+  };
+};
+/** Apply one plant (a CSS string or a run mask); returns its undo. */
+export async function applyPlant(page, subject, plant) {
+  if (typeof plant === "string") {
+    const tag = await page.addStyleTag({ content: plant });
+    return () => tag.evaluate((e) => e.remove());
+  }
+  await applyMask(page, subject, plant.mask, plant);
+  return () => undoMask(page, subject);
+}
+/** The pass-7 names, kept so a lane re-pointing from `pass7/instruments/glyph-pop.mjs` changes only
+ *  its import path: `applyTail(page, s, 0.12)` = the mask over the run's last 12 % (on the TEXT-NODE run
+ *  now, never the element's Range), `undoTail` its undo. */
+export const applyTail = (page, subject, tail) => applyMask(page, subject, [1 - tail, 1]);
+export const undoTail = undoMask;
+/** Mask the fraction [a, b] of the subject's TEXT RUN (text nodes only) to 25 %. */
+export async function applyMask(page, subject, [a, b], { comb = false, glyph = null } = {}) {
+  // `glyph: k` (the chair p9): the range is glyph k's own box, not a fraction of the run; `comb`: the
+  // range is striped (1 px at 25 % α, 1 px whole) instead of faded whole — COUNT's COMB
+  const rects = await page.evaluate(textRunRects, { subject, chars: glyph != null });
+  const pick = glyph != null ? [rects[glyph]].filter(Boolean) : rects;
+  return page.evaluate(
+    ({ subject, a, b, rects, comb }) => {
+      const sub = document.querySelector(subject);
+      if (!sub || !rects.length) return { ok: false };
+      // ACC-SIX pass 8 (PROPOSED): a ZERO-HEIGHT subject's mask would clip every glyph it overflows
+      // (the mask's painting area is its 0 px box), so the mask goes on its parent, cut at the
+      // subject's own run; the population stays clipped to that run.
+      const el = sub.getBoundingClientRect().height < 1 && sub.parentElement ? sub.parentElement : sub;
+      sub.dataset.maskHost = el === sub ? "self" : "parent";
+      const eb = el.getBoundingClientRect();
+      const left = Math.min(...rects.map((q) => q.l)),
+        right = Math.max(...rects.map((q) => q.r));
+      const c0 = left + a * (right - left) - eb.left,
+        c1 = left + b * (right - left) - eb.left;
+      const g = comb
+        ? `linear-gradient(to right, #000 ${c0.toFixed(1)}px, transparent ${c0.toFixed(1)}px, transparent ${c1.toFixed(1)}px, #000 ${c1.toFixed(1)}px), repeating-linear-gradient(to right, #000 0 1px, rgba(0,0,0,.25) 1px 2px)`
+        : `linear-gradient(to right, #000 ${c0.toFixed(1)}px, rgba(0,0,0,.25) ${c0.toFixed(1)}px, rgba(0,0,0,.25) ${c1.toFixed(1)}px, #000 ${c1.toFixed(1)}px)`;
+      el.dataset.maskPrev = el.getAttribute("style") ?? "";
+      el.style.setProperty("-webkit-mask-image", g, "important");
+      el.style.setProperty("mask-image", g, "important");
+      return { ok: true, run: [+(left - eb.left).toFixed(1), +(right - eb.left).toFixed(1)], cut: [+c0.toFixed(1), +c1.toFixed(1)], box: +eb.width.toFixed(1) };
+    },
+    { subject, a, b, rects: pick, comb },
+  );
+}
+export async function undoMask(page, subject) {
+  await page.evaluate((subject) => {
+    const sub = document.querySelector(subject);
+    if (!sub) return;
+    const el = sub.dataset.maskHost === "parent" && sub.parentElement ? sub.parentElement : sub;
+    delete sub.dataset.maskHost;
+    const p = el.dataset.maskPrev;
+    if (p) el.setAttribute("style", p);
+    else el.removeAttribute("style");
+    delete el.dataset.maskPrev;
+  }, subject);
+}
+
+// ------------------------------------------------------------------------------------ self-test
+/** Synthetic subjects (no product surface): a heading with a leading digit, the same text beside an
+ *  inline svg (the TIN/FIVE text-run case), light and dark. Each must read clean GREEN, every plant
+ *  RED; the svg subject also reads TAIL12 through the LEGACY element Range to show the hole it had. */
+const FIXTURE = (scheme) => `<!doctype html><html><head><style>
+  body { margin: 0; padding: 40px; background: ${scheme === "dark" ? "#1f1d1a" : "#fbf8f1"}; color: ${scheme === "dark" ? "#a9a298" : "#5d5852"}; font: 28px/1.3 Georgia, serif; }
+  h2 { font: inherit; margin: 0 0 24px; display: inline-block; padding: 0 12px; }
+  .tape { display: inline-flex; align-items: center; gap: 6px; padding: 2px 10px; }
+  .tape svg { width: 40px; height: 22px; }
+</style></head><body>
+  <h2 id="g-head">16 players</h2><br>
+  <span id="g-tape" class="tape">new game<svg viewBox="0 0 40 22"><path d="M2 11h36" stroke="currentColor" stroke-width="3"/></svg></span><br>
+  <img id="g-icon" width="32" height="32" alt="" src="${ICON(true)}">
+  <div style="display:flex;flex-wrap:wrap;width:360px;margin-top:24px"><span>a line</span><p id="g-zero" style="height:0;margin:0">3 of 170 on the board</p></div>
+  <p id="g-long" style="margin:16px 0 0;font-size:22px;color:${scheme === "dark" ? "#d8d2c6" : "#3b3833"}">Make a quiet line of many small words that reads in one breath</p>
+</body></html>`;
+/** A 32-unit tab icon (TAB-PEN's shape: ink from 8/32 to 25/32 on a paper tile) and its paper twin. The ink
+ *  sits at 5.10:1 on the tile (just over AA, like the text fixture): at 12.36:1 an 80 % or 65 % fade stays
+ *  legal (6.72 / 8.55 dark), so those plants read GREEN by physics, not by a blind reader. */
+const ICON = (ink) =>
+  "data:image/svg+xml," +
+  encodeURIComponent(
+    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="6" fill="#f4efe4"/>${ink ? '<path d="M8 22c3-9 6-12 8-12s3 4 2 7-3 5 1 5 5-3 7-6" fill="none" stroke="#6a645c" stroke-width="3.2" stroke-linecap="round"/>' : ""}</svg>`,
+  );
+export async function selfTest(browser, { dpr = 1 } = {}) {
+  const rows = [];
+  let hole = false,
+    cleanRed = false;
+  // G3clamp (pure): a reference ≥ 0.95 never bounds above 1; the clamp's edge at 0.95 ± ε printed
+  const bs = [0.5, 0.9499, 0.95, 0.97, 1].map((x) => [x, boundOf(x)]);
+  const clampOk = bs.every(([x, b]) => b <= 1 && b > x - 1e-9) && boundOf(0.97) < 1 && Math.abs(boundOf(0.5) - 0.55) < 1e-9;
+  if (!clampOk) hole = true;
+  rows.push(`GLYPH self-test G3clamp bounds ${bs.map(([x, b]) => `${x}→${b.toFixed(4)}`).join(" ")} ${clampOk ? "OK" : "← a hole (a bound reaches above 1)"}`);
+  for (const scheme of ["light", "dark"]) {
+    const { ctx, page } = await openCell(browser, { width: 800, height: 400, dpr, colorScheme: scheme });
+    await page.setContent(FIXTURE(scheme));
+    await page.evaluate(() => document.fonts.ready);
+    for (const subject of ["#g-head", "#g-tape", "#g-zero"]) {
+      const g = await glyphGate(page, { subject, payload: `fixture-${scheme}` });
+      if (g.clean.red) cleanRed = true;
+      rows.push(`GLYPH self-test ${scheme} dpr${dpr} ${subject} CLEAN ${fmt(g.clean)} (bound ${g.bound?.toFixed(3)})`);
+      for (const [k, r] of Object.entries(g.plants)) {
+        if (!r.red) hole = true;
+        rows.push(`GLYPH self-test ${scheme} dpr${dpr} ${subject} PLANT ${k} ${fmt(r)}`);
+      }
+    }
+    // TAB-PEN: an IMAGE subject (a 16 px tab icon, ~10 device px of ink at DPR 1): OFF is its paper
+    // twin, the plants are IMG_PLANTS, the column count scales to the ink span
+    const ng = ICON(false);
+    const gi = await glyphGate(page, { subject: "#g-icon", payload: `fixture-icon-${scheme}`, textRun: false, off: `#g-icon { content: url("${ng}") !important; }`, img: { ng, ink: [8 / 32, 25 / 32] }, minPop: 20 });
+    if (gi.clean.red) cleanRed = true;
+    rows.push(`GLYPH self-test ${scheme} dpr${dpr} #g-icon CLEAN ${fmt(gi.clean)} (bound ${gi.bound?.toFixed(3)})`);
+    for (const [k, r] of Object.entries(gi.plants)) {
+      if (!r.red) hole = true;
+      rows.push(`GLYPH self-test ${scheme} dpr${dpr} #g-icon PLANT ${k} ${fmt(r)}`);
+    }
+    // --- the chair, pass 9 (COUNT's gaps 1–5): each new clause has a row only IT sees
+    // G5core: ONE glyph combed (1 px stripes at 25 % α) on a long line — the median, G3 and G4's p95
+    // columns hold; only the interior low quantile reds
+    const gl = await glyphGate(page, { subject: "#g-long", payload: `fixture-long-${scheme}`, plants: { G0COMB_a25: { mask: [0, 1], comb: true, glyph: 0 } } });
+    if (gl.clean.red) cleanRed = true;
+    const g0 = gl.plants.G0COMB_a25;
+    const g5only = g0.red && g0.why.every((w) => w.startsWith("G5"));
+    if (!g5only) hole = true;
+    rows.push(`GLYPH self-test ${scheme} dpr${dpr} #g-long CLEAN ${fmt(gl.clean)}`);
+    rows.push(`GLYPH self-test ${scheme} dpr${dpr} #g-long PLANT G0COMB_a25 ${fmt(g0)} ← ${g5only ? "RED by G5 ONLY" : g0.red ? "RED but not by G5 alone ← the G5 row is not pinned" : "GREEN ← a hole"}`);
+    // FILE plants (COUNT): OPA80F and COMB written as the product's own CSS; the CONTROL read is the
+    // unplanted page, the TREE read is the planted page. anchor: bound at the control's fraction → RED;
+    // the own-anchored read (its bound cut from the planted page itself) is printed as the hole
+    const control = await glyphPopulation(page, { subject: "#g-head" });
+    for (const [name, css] of Object.entries(FILE_PLANTS("#g-head"))) {
+      const tag = await page.addStyleTag({ content: css });
+      await settle(page);
+      const anch = await glyphGate(page, { subject: "#g-head", payload: `fixture-file-${scheme}`, plants: {}, control });
+      const own = await glyphGate(page, { subject: "#g-head", payload: `fixture-file-${scheme}`, plants: {} });
+      await tag.evaluate((e) => e.remove());
+      await settle(page);
+      // pinned on G3 itself: the plant may red G2/G4/G5 too, but only the control's bound reds G3 (an
+      // own bound is cut above its own fraction, so it never can) — the row the anchor clause owns
+      const g3 = (r) => r.why.some((w) => w.startsWith("G3"));
+      if (!g3(anch.clean)) hole = true;
+      rows.push(`GLYPH self-test ${scheme} dpr${dpr} #g-head FILE ${name} control-anchored (bound ${anch.bound?.toFixed(3)}) ${fmt(anch.clean)} ← ${g3(anch.clean) ? "RED by G3" : "no G3 ← a hole"} | own-anchored (bound ${own.bound?.toFixed(3)}) → ${g3(own.clean) ? "G3 RED" : `no G3 (the pass-8 hole: a bound cut from the planted read)${own.clean.red ? "; red by " + own.clean.why.map((w) => w.slice(0, 2)).join("/") : ""}`}`);
+    }
+    // g4tol: TAIL35 on #g-long read against a CONTROL that holds the same low columns (T9-R8: the
+    // control's own failure is the ceiling) → G4 tolerated; against the unplanted control → RED
+    const tail = TEXT_PLANTS("#g-long").TAIL35_a25;
+    const ctlClean = await glyphPopulation(page, { subject: "#g-long" });
+    const undo = await applyPlant(page, "#g-long", tail);
+    await settle(page);
+    const ctlLow = await glyphPopulation(page, { subject: "#g-long" });
+    const tolLow = await glyphPopulation(page, { subject: "#g-long", tolerate: ctlLow.g4Lows });
+    const tolClean = await glyphPopulation(page, { subject: "#g-long", tolerate: ctlClean.g4Lows });
+    await undo();
+    await settle(page);
+    const g4of = (r) => r.why.some((w) => w.startsWith("G4"));
+    if (!ctlLow.g4Lows.length || g4of(tolLow) || !g4of(tolClean)) hole = true;
+    rows.push(`GLYPH self-test ${scheme} dpr${dpr} #g-long g4tol TAIL35 lows [${ctlLow.g4Lows.join(" ")}] | tolerated by a control holding them → G4 ${g4of(tolLow) ? "RED ← a hole" : "GREEN"} | against the unplanted control → G4 ${g4of(tolClean) ? "RED" : "GREEN ← a hole"}`);
+    // the LEGACY box clip on a ZERO-HEIGHT subject (ACC-SIX pass 8): G0/G1 — the hole the run clip closes
+    const zl = await glyphPopulation(page, { subject: "#g-zero", runClip: false });
+    rows.push(`GLYPH self-test ${scheme} dpr${dpr} #g-zero LEGACY-BOX-CLIP ${fmt(zl)} ← ${zl.red ? "RED (the box clip reads no glyph)" : "GREEN ← the fixture's box is not zero"}`);
+    if (!zl.red) hole = true;
+    // the LEGACY Range (the element's contents, svg included): TAIL12 lands on the svg, fades no glyph
+    const legacy = await page.evaluate(() => {
+      const el = document.querySelector("#g-tape");
+      const r = document.createRange();
+      r.selectNodeContents(el);
+      const rects = [...r.getClientRects()].filter((q) => q.width > 0);
+      const eb = el.getBoundingClientRect();
+      const left = Math.min(...rects.map((q) => q.left)),
+        right = Math.max(...rects.map((q) => q.right));
+      const cut = left + 0.88 * (right - left) - eb.left;
+      const g = `linear-gradient(to right, #000 ${cut.toFixed(1)}px, rgba(0,0,0,.25) ${cut.toFixed(1)}px)`;
+      el.style.setProperty("mask-image", g, "important");
+      el.style.setProperty("-webkit-mask-image", g, "important");
+      return cut;
+    });
+    await settle(page);
+    const lr = await glyphPopulation(page, { subject: "#g-tape", glyphWindows: false });
+    rows.push(`GLYPH self-test ${scheme} dpr${dpr} #g-tape LEGACY-RANGE TAIL12 (cut at ${legacy.toFixed(1)} px, on the svg) ${fmt(lr)} ← the pass-7 hole ${lr.red ? "(read RED here)" : "(GREEN: the fix is load-bearing)"}`);
+    await ctx.close();
+  }
+  return { rows, exit: cleanRed ? (hole ? 4 : 1) : hole ? 3 : 0 };
+}
+export const fmt = (r) =>
+  `pop ${r.population ?? 0} median ${r.coreMedian ?? "-"} <4.5 ${r.fracUnder ?? "-"} cols ${r.columns ?? "-"}(≥${r.slicePop ?? "-"}px) [${(r.slices ?? []).map((v) => v ?? "·").join(" ")}] glyphs [${(r.glyphCores ?? []).map((v) => v ?? "·").join(" ")}] transient on/off ${r.transientOn ?? "-"}/${r.transientOff ?? "-"} outside-run ${r.outsideRun ?? "-"} → ${r.red ? "RED " + r.why.join("; ") : "GREEN"}`;
+
+// ------------------------------------------------------------------------------------------ CLI
+if (process.argv[1] && fileURLToPath(import.meta.url) === resolvePath(process.argv[1])) {
+  const A = args();
+  const engine = A.engine ?? "chromium";
+  if (A["sabotage-battery"]) {
+    // each pass-9 clause off in turn (GLYPH_SABOTAGE): the self-test must RED (DPR 1 is enough)
+    const { spawnSync } = await import("node:child_process");
+    let bad = 0;
+    for (const c of GLYPH_CLAUSES) {
+      const r = spawnSync(process.execPath, [fileURLToPath(import.meta.url), "--self-test", "--engine", engine, "--dprs", A.dprs ?? "1"], { env: { ...process.env, GLYPH_SABOTAGE: c }, encoding: "utf8" });
+      const hit = (r.stdout ?? "").split("\n").filter((l) => /← a hole|← the G5 row is not pinned/.test(l));
+      console.log(`SABOTAGE ${engine} ${c.padEnd(8)} → exit ${r.status} ${r.status ? `RED (${hit.length} row(s): ${hit[0]?.slice(0, 120) ?? ""})` : "GREEN — the clause has no plant"}`);
+      if (!r.status) bad++;
+    }
+    console.log(`GLYPH SABOTAGE BATTERY ${engine}: ${GLYPH_CLAUSES.length - bad}/${GLYPH_CLAUSES.length} clauses red the self-test when deleted · load ${load()}`);
+    process.exit(bad ? 1 : 0);
+  }
+  const browser = await playwright()[engine].launch();
+  let exit = 0;
+  if (A["self-test"]) {
+    for (const dpr of (A.dprs ?? "1,2").split(",").map(Number)) {
+      const r = await selfTest(browser, { dpr });
+      for (const row of r.rows) console.log(`${engine} ${row}`);
+      exit = Math.max(exit, r.exit);
+    }
+  } else {
+    let cleanRed = false,
+      hole = false;
+    for (const cell of cellsOf(A)) {
+      const { ctx, page } = await openCell(browser, cell);
+      await page.goto(A.url);
+      await page.locator(A.ready ?? ".board-cells").first().waitFor({ timeout: 30000 });
+      await page.evaluate(() => document.fonts.ready);
+      await page.waitForFunction(() => document.getAnimations().every((a) => a.playState !== "running" || a.effect?.getTiming().iterations === Infinity), null, { timeout: 8000 }).catch(() => {});
+      if (A.hover) await page.locator(A.hover).first().hover();
+      if (A.click) await page.locator(A.click).first().click();
+      await settle(page);
+      const tag = `${engine} ${cell.label} ${cell.width}x${cell.height} dpr${cell.dpr}`;
+      if (!A.payload) throw new Error("--payload <name> is required (a G3 bound is per payload, never pooled)");
+      const g = await glyphGate(page, { subject: A.subject, payload: A.payload, ...(A.off ? { off: A.off } : {}) });
+      console.log(`GLYPH ${tag} payload=${g.payload} ${A.subject} CLEAN ${fmt(g.clean)} (bound ${g.bound?.toFixed(3) ?? "-"})`);
+      if (g.clean.red) cleanRed = true;
+      for (const [k, r] of Object.entries(g.plants)) {
+        if (!r.red) hole = true;
+        console.log(`GLYPH ${tag} payload=${g.payload} ${A.subject} PLANT ${k} ${fmt(r)}`);
+      }
+      await ctx.close();
+    }
+    exit = cleanRed ? (hole ? 4 : 1) : hole ? 3 : 0;
+  }
+  console.log(`LOAD ${load()}`);
+  await browser.close();
+  process.exit(exit);
+}
