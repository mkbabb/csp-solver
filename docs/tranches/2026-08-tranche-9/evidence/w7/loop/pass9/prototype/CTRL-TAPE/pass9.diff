index 00000000..3f642be1
--- /dev/null
+++ b/web/frontend/e2e/lib/rest-probes.mjs
@@ -0,0 +1,409 @@
+// rest-probes.mjs — THE resize-at-rest, un-park, sequence-guard and row-focus probes (T9-W7; registry-v6
+// §2.11, LAWS P6 §D; registry-v7 §2.4 PRODUCT HOME). Four mechanisms recur across the estate:
+//   (a) UN-PARK — a publisher parked until `transitionend` never un-parks when no transition starts (FACE:
+//       two presses in one task; `--action-bar-h` 121 vs 132 for the page's life). Probe: act, reach REST,
+//       perturb something ELSE that moves the subject (the root font +12.5 %), reach rest, and compare every
+//       PUBLISHED length with its TRUTH (0.5 px).
+//   (b) RESIZE AT REST — a regime measured at OPEN goes stale on a resize at rest (SELF: 390×844 → 390×800
+//       keeps 4 rows / 7 cells lapped). Probe: open at A, resize to B, reach rest, read; close, reopen at
+//       B, read; the two reads must AGREE.
+//   (c) SEQUENCE-KEYED TOUCH GUARD — WebKit labels a touch's click `pointerType: "mouse"`. Probe: one tap,
+//       its event sequence logged, the state toggles counted (exactly one), and under the RELABEL plant
+//       (WebKit's label with iOS's delivery, in any engine) still exactly one.
+//   (d) ROW TAP KEEPS FOCUS — a tap on a row inside an open overlay keeps focus where the reader was
+//       (never BODY).
+// The presets are GENERIC (the chair's pass-7 gap 6: its presets named SELF's and FACE's trees): every
+// subject, state and read is a selector or a JS expression on the command line.
+//   node e2e/lib/rest-probes.mjs --self-test [--engine chromium|webkit]
+//   node e2e/lib/rest-probes.mjs --url <u> --preset resize --toggle <sel> --open <js→bool> --read <js→value>
+//        [--viewport 390x844] [--to 390x800] [--touch 1]
+//   node e2e/lib/rest-probes.mjs --url <u> --preset unpark --act <js> --pairs <name|publishedJs|truthJs;;…>
+//        [--perturb <js>] [--viewport 1280x800]
+//   node e2e/lib/rest-probes.mjs --url <u> --preset touch --target <sel> --state <js> [--plant relabel]
+//   node e2e/lib/rest-probes.mjs --url <u> --preset rowfocus --cell <sel> --toggle <sel> --open <js→bool>
+//        --row <sel> [--focus-ok <sel>]
+//   common: [--ready <sel>] [--engine] [--scheme dark]
+// Exit: 0 GREEN · 1 RED · 3 (self-test) a born-RED fixture or a plant read GREEN (a hole) · 4 both.
+import process from "node:process";
+import { fileURLToPath } from "node:url";
+import { resolve as resolvePath } from "node:path";
+import { args, load, playwright, openCell } from "./paint-lib.mjs";
+
+/** REST: no running/pending animation over two consecutive frames (read post-paint). An infinite
+ *  animation (a boil, a spinner) never rests: its names are printed as `residual`, never hidden. */
+export async function atRest(page, timeout = 6000) {
+  const t0 = Date.now();
+  let quiet = 0;
+  while (Date.now() - t0 < timeout) {
+    const n = await page.evaluate(
+      () =>
+        new Promise((r) =>
+          requestAnimationFrame(() => setTimeout(() => r(document.getAnimations().filter((a) => a.playState === "running" || a.pending).length), 0)),
+        ),
+    );
+    quiet = n === 0 ? quiet + 1 : 0;
+    if (quiet >= 2) return { ms: Date.now() - t0, residual: 0 };
+  }
+  const residual = await page.evaluate(() =>
+    document
+      .getAnimations()
+      .filter((a) => a.playState === "running")
+      .map((a) => a.animationName ?? a.id ?? a.constructor.name)
+      .slice(0, 5),
+  );
+  return { ms: Date.now() - t0, residual };
+}
+
+/** Clause switches for the rest-probes sabotage battery (REST_SABOTAGE=a,b). */
+export const REST_CLAUSES = ["confirm", "anim"];
+const R_OFF = new Set((process.env.REST_SABOTAGE ?? "").split(",").filter(Boolean));
+/** (e) HEIGHT AT REST (the chair, pass 9; CTRL-FACE's PANEL_H_AT_REST folded home, LAWS P8 §I): fonts
+ *  ready, then `frames` consecutive frames with the subject's height unchanged (to 0.01 px) and no
+ *  running animation in `root`'s subtree (anim); then a CONFIRMATION read `confirmMs` later must
+ *  agree, else the window restarts (confirm) — a layout that lands after the frame window (FACE's
+ *  critic: "read early") is never the rest. → {h, rested, frames, restarts} */
+export async function heightAtRest(page, { sel, root = null, frames = 10, confirmMs = 500, timeout = 6000 }) {
+  return page.evaluate(
+    async ({ sel, root, frames, confirmMs, timeout, off }) => {
+      await document.fonts.ready;
+      const el = document.querySelector(sel);
+      if (!el) return { h: null, rested: false, frames: 0, restarts: 0 };
+      const host = root ? (el.closest(root) ?? el) : el;
+      const raf = () => new Promise((r) => requestAnimationFrame(() => r()));
+      const moving = () => !off.includes("anim") && host.getAnimations({ subtree: true }).some((a) => a.playState === "running" || a.pending);
+      const read = () => +el.getBoundingClientRect().height.toFixed(2);
+      let last = -1,
+        same = 0,
+        n = 0,
+        restarts = 0;
+      const t0 = performance.now();
+      while (performance.now() - t0 < timeout) {
+        await raf();
+        n++;
+        const h = read();
+        if (h === last && !moving()) same++;
+        else {
+          same = 0;
+          last = h;
+        }
+        if (same < frames) continue;
+        if (off.includes("confirm")) return { h: last, rested: true, frames: n, restarts };
+        await new Promise((r) => setTimeout(r, confirmMs));
+        await raf();
+        if (read() === last && !moving()) return { h: last, rested: true, frames: n, restarts };
+        restarts++;
+        same = 0;
+        last = read();
+      }
+      return { h: last, rested: false, frames: n, restarts };
+    },
+    { sel, root, frames, confirmMs, timeout, off: [...R_OFF] },
+  );
+}
+
+/** Evaluate a JS expression string in the page. */
+export const js = (page, expr) => page.evaluate((e) => new Function(`return (${e})`)(), expr);
+
+/** (b) open → resize at rest → read, vs a fresh open at the new size. `same(a, b)` decides agreement. */
+export async function openThenResize(page, { open, close, read, to, same = (a, b) => JSON.stringify(a) === JSON.stringify(b) }) {
+  await open();
+  await atRest(page);
+  const before = await read();
+  await page.setViewportSize(to);
+  await page.waitForFunction(({ width, height }) => innerWidth === width && innerHeight === height, to);
+  const rest = await atRest(page);
+  const after = await read();
+  await close();
+  await atRest(page);
+  await open();
+  await atRest(page);
+  const reopened = await read();
+  return { before, after, reopened, rest, agree: same(after, reopened) };
+}
+
+/** (a) act → rest → perturb → rest → published vs truth per pair ([name, publishedJs, truthJs]); 0.5 px. */
+export async function unpark(page, { act, perturb = () => page.evaluate(() => (document.documentElement.style.fontSize = "18px")), pairs }) {
+  const read = () =>
+    page.evaluate(
+      (pairs) =>
+        pairs.map(([name, pubJs, truthJs]) => ({ name, published: new Function(`return (${pubJs})`)(), truth: new Function(`return (${truthJs})`)() })),
+      pairs,
+    );
+  const before = await read();
+  await act();
+  const r1 = await atRest(page);
+  const afterAct = await read();
+  await perturb();
+  const r2 = await atRest(page);
+  const afterPerturb = await read();
+  const stale = afterPerturb.filter((x) => x.published == null || x.published === "" || Math.abs(parseFloat(x.published) - parseFloat(x.truth)) > 0.5);
+  return { before, afterAct, afterPerturb, rest: [r1, r2], stale };
+}
+
+/** (c) the RELABEL plant — WebKit's LABEL with iOS's DELIVERY, in any engine: after a trusted touch
+ *  release exactly one `click` labelled `pointerType: "mouse"` reaches the target. A trusted touch click
+ *  (chromium) is swallowed in capture and re-dispatched as `mouse`; where the engine sends none (WebKit
+ *  after a prevented pointerdown), one is synthesised 60 ms after the release. */
+export const RELABEL = () => {
+  let pending = null;
+  const fire = (target, x, y) => target.dispatchEvent(new PointerEvent("click", { bubbles: true, cancelable: true, composed: true, pointerType: "mouse", clientX: x, clientY: y, button: 0 }));
+  window.addEventListener(
+    "pointerup",
+    (e) => {
+      if (!e.isTrusted || e.pointerType !== "touch") return;
+      const target = e.target,
+        x = e.clientX,
+        y = e.clientY;
+      pending = setTimeout(() => {
+        pending = null;
+        fire(target, x, y);
+      }, 60);
+    },
+    { capture: true },
+  );
+  window.addEventListener(
+    "click",
+    (e) => {
+      if (!e.isTrusted) return;
+      if (pending) {
+        clearTimeout(pending);
+        pending = null;
+      }
+      if (e.pointerType === "mouse") return; // already WebKit's label
+      e.stopImmediatePropagation();
+      e.preventDefault();
+      const t = e.target,
+        x = e.clientX,
+        y = e.clientY;
+      queueMicrotask(() => fire(t, x, y));
+    },
+    { capture: true },
+  );
+};
+/** Tap once; log the event sequence; count toggles of `state` (a JS expression) across the tap. */
+export async function tapToggles(page, { target, state }) {
+  await page.evaluate(() => {
+    window.__seq = [];
+    for (const t of ["pointerdown", "pointerup", "touchend", "click"])
+      window.addEventListener(t, (e) => window.__seq.push(`${t}:${e.pointerType ?? "-"}${e.isTrusted ? "" : "(synthetic)"}`), { capture: true });
+  });
+  await page.evaluate((stateJs) => {
+    const f = new Function(`return (${stateJs})`);
+    window.__st = [f()];
+    const mo = new MutationObserver(() => {
+      const v = f();
+      if (v !== window.__st[window.__st.length - 1]) window.__st.push(v);
+    });
+    mo.observe(document.body, { subtree: true, attributes: true, childList: true, characterData: true });
+    window.__mo = mo;
+  }, state);
+  await page.locator(target).first().tap();
+  await page.waitForTimeout(400);
+  await atRest(page, 3000);
+  const r = await page.evaluate(() => {
+    window.__mo.disconnect();
+    return { seq: window.__seq, states: window.__st };
+  });
+  return { ...r, toggles: r.states.length - 1 };
+}
+/** (d) focus a cell, open the overlay, tap a row: where is focus? `ok` = the selector focus must match. */
+export async function rowTapFocus(page, { cell, open, row, ok = cell }) {
+  await page.locator(cell).first().tap();
+  await open();
+  await atRest(page, 3000);
+  if (!(await page.locator(row).first().isVisible())) return { focus: null, kept: false, why: `the row ${row} is not visible after open` };
+  await page.locator(row).first().tap();
+  await page.waitForTimeout(300);
+  await atRest(page, 3000);
+  return page.evaluate((ok) => {
+    const a = document.activeElement;
+    return { focus: a ? `${a.tagName}${a.id ? "#" + a.id : ""}${a.classList.length ? "." + [...a.classList].slice(0, 2).join(".") : ""}` : null, kept: !!a?.matches(ok) };
+  }, ok);
+}
+
+// ------------------------------------------------------------------------------------ self-test
+/** Synthetic fixtures (no product surface), each a LIVE and a STALE twin: the stale twin is born RED,
+ *  the live twin GREEN. `?v=live|stale` picks the twin. */
+const FIXTURE = (v) => `<!doctype html><html><head><style>
+  body { margin: 0; font: 1rem/1.4 Georgia, serif; background: #fbf8f1; color: #3b3833; }
+  #bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 8px; transition: padding 200ms; background: #eee; }
+  #bar.big { padding: 24px; }
+  #sheet { position: fixed; left: 0; right: 0; top: 40px; background: #fff; display: none; }
+  #tog { position: fixed; top: 0; right: 0; height: 36px; z-index: 2; }
+  #sheet.open { display: block; }
+  .row { display: block; width: 100%; height: 40px; }
+  #cell { margin-top: 300px; }
+</style></head><body>
+  <div id="bar">bar</div>
+  <input id="cell" aria-label="cell">
+  <button id="tog" aria-expanded="false">toggle</button>
+  <div id="sheet"></div>
+<script>
+  const V = ${JSON.stringify(v)};
+  const bar = document.getElementById("bar");
+  const pub = () => document.documentElement.style.setProperty("--bar-h", bar.getBoundingClientRect().height + "px");
+  pub();
+  // the STALE publisher parks on a press and un-parks only on transitionend; two presses in one task
+  // start no transition, so it stays parked while the root font moves the bar (its line box, not its padding)
+  let parked = false;
+  new ResizeObserver(() => { if (V === "live" || !parked) pub(); }).observe(bar);
+  bar.addEventListener("transitionend", () => { parked = false; pub(); });
+  window.act = () => { parked = true; bar.classList.toggle("big"); bar.classList.toggle("big"); };
+  const sheet = document.getElementById("sheet"), tog = document.getElementById("tog");
+  let rows = 0;
+  const measure = () => { rows = Math.floor((innerHeight - 100) / 40); sheet.innerHTML = Array.from({ length: rows }, (_, i) => '<button class="row">row ' + i + "</button>").join(""); wire(); };
+  const wire = () => { for (const r of sheet.querySelectorAll(".row")) {
+    if (V === "live") r.addEventListener("pointerdown", (e) => e.preventDefault()); // the row never takes focus
+    else r.addEventListener("pointerdown", () => r.focus()); // a menu row that takes focus, then hides
+    r.addEventListener("click", () => setOpen(false)); } };
+  const setOpen = (o) => { sheet.classList.toggle("open", o); tog.setAttribute("aria-expanded", String(o)); if (o) measure(); };
+  if (V === "live") addEventListener("resize", () => sheet.classList.contains("open") && measure());
+  let touchSeq = false;
+  tog.addEventListener("pointerdown", (e) => { if (V === "live" && e.pointerType === "touch") { touchSeq = true; e.preventDefault(); } });
+  tog.addEventListener("pointerup", (e) => { if (e.pointerType === "touch") setOpen(!sheet.classList.contains("open")); });
+  tog.addEventListener("click", (e) => {
+    if (V === "live") { if (touchSeq) { touchSeq = false; return; } }
+    else if (e.pointerType === "touch") return; // the guard keyed on the click's LABEL
+    setOpen(!sheet.classList.contains("open"));
+  });
+  window.sheetRows = () => sheet.querySelectorAll(".row").length;
+  window.setOpen = setOpen;
+</script></body></html>`;
+
+export async function selfTest(browser) {
+  const rows = [];
+  let hole = false,
+    liveRed = false;
+  const cell = async (v, { touch = false, plant = null, w = 390, h = 844 } = {}) => {
+    const { ctx, page } = await openCell(browser, { width: w, height: h, hasTouch: touch });
+    await page.setContent(FIXTURE(v));
+    if (plant === "relabel") await page.evaluate(RELABEL); // setContent commits no navigation: no init script runs
+    return { ctx, page };
+  };
+  const expect = (v, red, label, detail) => {
+    const bad = v === "live" ? red : !red;
+    if (bad && v === "live") liveRed = true;
+    if (bad && v === "stale") hole = true;
+    rows.push(`REST self-test ${label} ${v.toUpperCase()} ${detail} → ${red ? "RED" : "GREEN"}${bad ? (v === "live" ? " ← the live twin RED" : " ← a hole (the stale twin GREEN)") : ""}`);
+  };
+  for (const v of ["live", "stale"]) {
+    {
+      const { ctx, page } = await cell(v, { w: 1280, h: 800 });
+      const r = await unpark(page, { act: () => page.evaluate(() => window.act()), pairs: [["--bar-h", `getComputedStyle(document.documentElement).getPropertyValue("--bar-h")`, `document.getElementById("bar").getBoundingClientRect().height + "px"`]] });
+      expect(v, r.stale.length > 0, "UNPARK (two presses in one task, root font +12.5 %)", JSON.stringify(r.afterPerturb));
+      await ctx.close();
+    }
+    {
+      const { ctx, page } = await cell(v);
+      const open = async () => (await js(page, `document.getElementById("sheet").classList.contains("open")`)) || (await page.locator("#tog").click());
+      const close = async () => (await js(page, `document.getElementById("sheet").classList.contains("open")`)) && (await page.locator("#tog").click());
+      const r = await openThenResize(page, { open, close, read: () => js(page, "window.sheetRows()"), to: { width: 390, height: 800 } });
+      expect(v, !r.agree, "RESIZE 390x844 → 390x800 at rest", `rows before ${r.before} after ${r.after} reopened ${r.reopened}`);
+      await ctx.close();
+    }
+    for (const plant of [null, "relabel"]) {
+      const { ctx, page } = await cell(v, { touch: true, plant });
+      const t = await tapToggles(page, { target: "#tog", state: `document.getElementById("tog").getAttribute("aria-expanded")` });
+      // without the plant both guards hold in chromium; the RELABEL plant is the discriminator
+      if (plant) expect(v, t.toggles !== 1, "TOUCH one tap under RELABEL", `seq ${t.seq.join(",")} states ${t.states.join("→")} toggles ${t.toggles}`);
+      else {
+        if (t.toggles !== 1 && v === "live") liveRed = true;
+        rows.push(`REST self-test TOUCH one tap (no plant) ${v.toUpperCase()} seq ${t.seq.join(",")} toggles ${t.toggles} → ${t.toggles === 1 ? "GREEN" : "RED"}`);
+      }
+      await ctx.close();
+    }
+    {
+      const { ctx, page } = await cell(v, { touch: true });
+      // opened by script: the row probe's subject is the ROW tap, not the toggle's guard (WebKit's own
+      // mouse-labelled click double-toggles the stale guard with no plant)
+      const f = await rowTapFocus(page, { cell: "#cell", open: () => page.evaluate(() => window.setOpen(true)), row: "#sheet .row >> nth=1" });
+      expect(v, !f.kept, "ROW TAP inside the open sheet", `focus ${f.focus}${f.why ? " (" + f.why + ")" : ""}`);
+      await ctx.close();
+    }
+  }
+  // (e) HEIGHT AT REST (the chair, pass 9): CLEAN (a box at 100 px) rests at 100; LATE (its height lands
+  // at 140 px 350 ms in, after the 10-frame window) must read 140 — the window-only reader reads 100,
+  // printed as the hole; ANIM (a running animation in the subtree, height unchanged) never rests
+  {
+    const BOX = (late, anim) => `<!doctype html><html><body style="margin:0"><div id="card"><div id="pw" style="height:100px;background:#ccc"></div>${anim ? '<i id="spin" style="display:block;width:4px;height:4px"></i>' : ""}</div><script>${late ? 'setTimeout(() => (document.getElementById("pw").style.height = "140px"), 350);' : ""}${anim ? 'document.getElementById("spin").animate([{opacity:1},{opacity:0.5}],{duration:400,iterations:Infinity});' : ""}</script></body></html>`;
+    for (const [name, late, anim, want] of [
+      ["CLEAN", false, false, (r) => r.rested && r.h === 100],
+      ["LATE", true, false, (r) => r.rested && r.h === 140],
+      ["ANIM", false, true, (r) => !r.rested],
+    ]) {
+      const { ctx, page } = await openCell(browser, { width: 400, height: 300 });
+      await page.setContent(BOX(late, anim));
+      const r = await heightAtRest(page, { sel: "#pw", root: "#card", timeout: 2500 });
+      await ctx.close();
+      const ok = want(r);
+      if (!ok) {
+        if (name === "CLEAN") liveRed = true;
+        else hole = true;
+      }
+      rows.push(`REST self-test (e) height-at-rest ${name} h ${r.h} rested ${r.rested} frames ${r.frames} restarts ${r.restarts} → ${ok ? "AS THE LAW" : name === "CLEAN" ? "RED" : "← a hole"}`);
+    }
+  }
+  return { rows, exit: liveRed ? (hole ? 4 : 1) : hole ? 3 : 0 };
+}
+
+// ------------------------------------------------------------------------------------------ CLI
+if (process.argv[1] && fileURLToPath(import.meta.url) === resolvePath(process.argv[1])) {
+  const A = args();
+  const engine = A.engine ?? "chromium";
+  if (A["sabotage-battery"]) {
+    // each pass-9 clause off in turn (REST_SABOTAGE): the self-test must RED
+    const { spawnSync } = await import("node:child_process");
+    let bad = 0;
+    for (const c of REST_CLAUSES) {
+      const r = spawnSync(process.execPath, [fileURLToPath(import.meta.url), "--self-test", "--engine", engine], { env: { ...process.env, REST_SABOTAGE: c }, encoding: "utf8" });
+      const hit = (r.stdout ?? "").split("\n").filter((l) => /← a hole/.test(l));
+      console.log(`SABOTAGE ${engine} ${c.padEnd(8)} → exit ${r.status} ${r.status ? `RED (${hit.length} row(s): ${hit[0]?.slice(0, 110) ?? ""})` : "GREEN — the clause has no plant"}`);
+      if (!r.status) bad++;
+    }
+    console.log(`REST SABOTAGE BATTERY ${engine}: ${REST_CLAUSES.length - bad}/${REST_CLAUSES.length} clauses red the self-test when deleted · load ${load()}`);
+    process.exit(bad ? 1 : 0);
+  }
+  const browser = await playwright()[engine].launch();
+  let exit;
+  if (A["self-test"]) {
+    const r = await selfTest(browser);
+    for (const row of r.rows) console.log(`${engine} ${row}`);
+    exit = r.exit;
+  } else {
+    const [w, h] = (A.viewport ?? "390x844").split("x").map(Number);
+    const touch = A.touch === "1" || ["touch", "rowfocus"].includes(A.preset);
+    const { ctx, page } = await openCell(browser, { width: w, height: h, hasTouch: touch, colorScheme: A.scheme ?? "light", reducedMotion: "no-preference" });
+    if (A.plant === "relabel") await ctx.addInitScript(RELABEL);
+    await page.goto(A.url);
+    await page.locator(A.ready ?? ".board-cells").first().waitFor({ timeout: 30000 });
+    await atRest(page, 4000);
+    const isOpen = () => js(page, A.open);
+    const tapOrClick = (sel) => (touch ? page.locator(sel).first().tap() : page.locator(sel).first().click());
+    let red, out;
+    if (A.preset === "resize") {
+      const [tw, th] = (A.to ?? "390x800").split("x").map(Number);
+      const r = await openThenResize(page, { open: async () => (await isOpen()) || (await tapOrClick(A.toggle)), close: async () => (await isOpen()) && (await tapOrClick(A.toggle)), read: () => js(page, A.read), to: { width: tw, height: th } });
+      red = !r.agree;
+      out = { from: `${w}x${h}`, to: A.to ?? "390x800", before: r.before, afterResizeAtRest: r.after, reopened: r.reopened, rest: r.rest };
+    } else if (A.preset === "unpark") {
+      const pairs = A.pairs.split(";;").map((p) => p.split("|"));
+      const r = await unpark(page, { act: () => js(page, A.act), ...(A.perturb ? { perturb: () => js(page, A.perturb) } : {}), pairs });
+      red = r.stale.length > 0;
+      out = { afterAct: r.afterAct, afterPerturb: r.afterPerturb, rest: r.rest, stale: r.stale };
+    } else if (A.preset === "touch") {
+      const t = await tapToggles(page, { target: A.target, state: A.state });
+      red = t.toggles !== 1;
+      out = { seq: t.seq, states: t.states, toggles: t.toggles };
+    } else if (A.preset === "rowfocus") {
+      const f = await rowTapFocus(page, { cell: A.cell, open: async () => (await isOpen()) || (await tapOrClick(A.toggle)), row: A.row, ok: A["focus-ok"] ?? A.cell });
+      red = !f.kept;
+      out = f;
+    } else throw new Error(`unknown --preset ${A.preset} (resize | unpark | touch | rowfocus)`);
+    console.log(`REST ${engine} ${A.preset}${A.plant ? " plant=" + A.plant : ""} ${JSON.stringify(out)} → ${red ? "RED" : "GREEN"}`);
+    exit = red ? 1 : 0;
+    await ctx.close();
+  }
+  console.log(`LOAD ${load()}`);
+  await browser.close();
+  process.exit(exit);
+}
