+      const m = /^@property\s+(--[\w-]+)/.exec(pre);
+      if (!m) continue;
+      const get = (p) => r.decls.find((d) => d.prop === p)?.value ?? null;
+      out.push({
+        name: m[1],
+        inherits: get("inherits"),
+        syntax: get("syntax"),
+        initial: get("initial-value"),
+        kind: `@property ${r.kind}`,
+        file,
+        line: r.line,
+      });
+    }
+    const codes = f.endsWith(".vue")
+      ? sfc(text).scripts.map((s) => s.text)
+      : /\.(ts|tsx|js|mjs)$/.test(f)
+        ? [text]
+        : [];
+    for (const code of codes) {
+      let s = stripJs(code);
+      const consts = constBindings(s);
+      if (on("register-script")) {
+        // the chair p9 (the shape law's script clauses): concatenations folded first (TIN's
+        // foldText), `CSS["registerProperty"](…)` read as the call, and every BOUND ALIAS —
+        // `const reg = CSS.registerProperty.bind(CSS)`, `const { registerProperty: rp } = CSS` —
+        // rewritten to the call it is
+        s = foldText(s, { consts }).replace(
+          /\[\s*(["'`])registerProperty\1\s*\]\s*\(/g,
+          ".registerProperty(",
+        );
+        const aliases = new Set();
+        for (const a of s.matchAll(
+          /(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*=\s*(?:(?:window|globalThis)\s*\.\s*)?CSS\s*\.\s*registerProperty\b/g,
+        ))
