+// edge-bands.d.mts — the TYPES of the ONE four-band edge probe (`./edge-bands.mjs`), so a TypeScript spec
+// imports it under `typecheck:e2e` (strict, no `allowJs`). No behaviour lives here; every export is typed
+// with its option names (LAWS P8 §I: never `[k: string]: unknown`). The pass-8 hand-rolled copies
+// (PLR-SELF's `BandsRead`/`EdgePlant`, CTRL-FACE's `FourBands`/`FourBandsOptions`) are folded in by name.
+// NOT-A-LANE: the chair's home (T9-W7 pass 9, homes v2).
+import type { Browser, Page } from "@playwright/test";
+
+export type Side = "top" | "right" | "bottom" | "left";
+export interface Band {
+  stations: number;
+  coreMedian: number;
+  fracUnder: number;
+  dropped: number;
+  holeFrac: number;
+  holeRuns: number;
+  longestHole: number;
+  /** B3's painted depth, css px (the subject's own fill tint excluded: ownfill) */
+  thickness: number;
+  ink: "computed" | "p99";
+  station8?: { median: number; dropped: number; n: number };
+  pose?: string;
+  firstPose?: string;
+  occluder: string | null;
+}
+export interface FourBands {
+  red: boolean;
+  why: string[];
+  bands: Record<Side, Band> | null;
+  edgeCount: number;
+  dpr?: number;
+  topOnly?: "GREEN" | "RED";
+  station8?: "GREEN" | "RED";
+  box?: { x: number; y: number; w: number; h: number } | null;
+  /** set by `edgeGate` on a plant read */
+  noop?: boolean;
+  info?: boolean;
+}
+export type BandsRead = FourBands;
+export interface FourBandsOptions {
+  subject: string;
+  edge: string;
+  off?: string | null;
+  out?: number;
+  inn?: number;
+  span?: [number, number];
+  floor?: number;
+  thick?: number;
+  thickTol?: number;
+  holes?: number;
+  above?: number | null;
+  /** B6: each band's depth ≥ relBand × the deepest band's (default 0.5) */
+  relBand?: number;
+}
+/** A plant: a CSS string, or `{ fade }` — every painted colour of the edge and its descendants at that alpha. */
+export type EdgePlant = string | { fade: number };
+export interface EdgeGateOptions extends FourBandsOptions {
+  plants?: Record<string, EdgePlant> | null;
+}
+
+export const EDGE_CLAUSES: readonly string[];
+export function fourBands(page: Page, o: FourBandsOptions): Promise<FourBands>;
+export function EDGE_PLANTS(edge: string): Record<
+  | "X6_bottom_erased"
+  | "X4_opacity_015"
+  | "STROKE_OPACITY015"
+  | "PATH_OPACITY015"
+  | "FILTER_OPACITY015"
+  | "THIN_1PX"
+  | "DASH_1IN8"
+  | "INFO_X5_opacity_04",
+  string
+> & { FADE15_desc: { fade: number } };
+/** The previous ink replayed through stroke-opacity / path opacity / filter opacity() at `a` (B5). */
+export function INK_PLANTS(edge: string, a?: number): Record<string, EdgePlant>;
+export function applyEdgePlant(page: Page, edge: string, plant: EdgePlant): Promise<() => Promise<void>>;
+export function edgeGate(page: Page, o: EdgeGateOptions): Promise<{ clean: FourBands; plants: Record<string, FourBands> }>;
+export function fmt(r: FourBands): string;
+export function selfTest(browser: Browser, o?: { dpr?: number }): Promise<{ rows: string[]; exit: number }>;
