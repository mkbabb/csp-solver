+
+/** PASS 9 · the pass-8 critic's escapes (C1 C4 C6 C7 C9–C12 C14 P7 P9 T4–T6) as plants, each
+ *  sub-clause's siblings beside them, and a BOUNDARY pair per numeric bound: the `green` arm passes
+ *  by ε and must stay GREEN on its clause, the other reds by ε (LAWS P8 §F, threshold sabotage). */
+function pass9Plants({ live, once, P, addScene, bar }) {
+  const desk = (rule) => addScene(`@media (min-width: 1024px) { ${rule} }`);
+  const dockQ = (rule) => addScene(`@media (max-width: 1023.98px) { ${rule} }`);
+  const foot = (attr) => ({
+    [SCENE_SFC]: once(
+      live.gsfc,
+      'class="card-foot"',
+      `class="card-foot"\n          ${attr}`,
+    ),
+  });
+  const tp = (a, b) => P(once(live.panel, a, b));
+  const HID = J("hid", "den");
+  return [
+    [
+      "9",
+      "C1 the card not a scrollport (overflow-y: visible)",
+      desk(".controls-card { overflow-y: visible; }"),
+    ],
