+// paint-lib.d.mts — the TYPES of the ONE painted-byte library (`./paint-lib.mjs`), so a TypeScript spec
+// imports it under `typecheck:e2e` (strict, no `allowJs`: a bare `.mjs` import is TS7016). No behaviour
+// lives here; every export is typed with its option names (LAWS P8 §I). The pass-8 hand-rolled copies
+// (FACE, TAPE, VERB, the WAVE's) are folded into this one; `Rgb` keeps §13's name for `Shot`.
+// NOT-A-LANE: the chair's home (T9-W7 pass 9, homes v2).
+import type { Browser, BrowserContext, BrowserType, Page } from "@playwright/test";
+
+/** A decoded photograph: packed RGB, device pixels. */
+export interface Shot {
+  data: Uint8Array;
+  w: number;
+  h: number;
+}
+export type Rgb = Shot;
+export interface Clip {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+/** A text run's rect (css px, viewport-relative); `ch` on a per-character read. */
+export interface RunRect {
+  l: number;
+  r: number;
+  t: number;
+  b: number;
+  ch?: string;
+}
+/** A paint cell: viewport, DPR, scheme, motion, pointer, contrast, forced colours. */
+export interface CellOptions {
+  width?: number;
+  height?: number;
+  dpr?: number;
+  colorScheme?: "light" | "dark";
+  reducedMotion?: "reduce" | "no-preference";
+  hasTouch?: boolean;
+  contrast?: "more" | "less" | "no-preference" | null;
+  forcedColors?: "active" | "none" | null;
+  label?: string;
+}
+
+export function playwright(): { chromium: BrowserType; webkit: BrowserType; firefox: BrowserType };
+export function lum(d: ArrayLike<number>, i: number): number;
+export function grey(d: ArrayLike<number>, i: number): number;
+export function ratio(a: number, b: number): number;
+export function median(a: number[]): number;
+export function quantile(a: number[], f: number): number;
+export function maxDelta(d1: ArrayLike<number>, d2: ArrayLike<number>, i: number): number;
+export function settle(page: Page): Promise<void>;
+/** The clip photographed ON, then with `offCss` applied (OFF), both decoded. */
+export function onOff(page: Page, clip: Clip, offCss: string): Promise<{ on: Shot; off: Shot }>;
+/** Page-side: the subject's TEXT RUN (text nodes only; svg and hidden descendants skipped). */
+export function textRunRects(o: { subject: string; chars?: boolean }): RunRect[] | null;
+/** `--key value` / `--flag` argv → a flat record (a bare flag reads "1"). */
+export function args(argv?: string[]): Record<string, string>;
+/** The 1/5/15-minute load averages, printed. */
+export function load(): string;
+export function cellsOf(A: Record<string, string>): CellOptions[];
+export function openCell(browser: Browser, o?: CellOptions): Promise<{ ctx: BrowserContext; page: Page }>;
