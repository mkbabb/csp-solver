+// shape-census.d.mts — the TYPES of the ONE browserless shape-census library (`./shape-census.mjs`), so a
+// TypeScript caller (`vite.config.ts`'s face-stamp, a `.spec.ts`) imports it strict. An ambient `declare
+// module` cannot name a relative path, so the declaration sits beside the module, as `e2e/lib/*.d.mts` do.
+// Every export is typed with its option names (LAWS P8 §I: never `[k: string]: unknown`); CTRL-FACE's
+// pass-8 narrow copy (`followImports`) is folded in.
+// NOT-A-LANE: the chair's home (T9-W7 pass 9, homes v2).
+
+/** The option bag every tree reader takes: an explicit file list (followed through `@import` and the
+ *  module graph) or the disk walk under `fe`; `read`/`exists`/`ls` swap the disk for a virtual tree. */
+export interface TreeOptions {
+  files?: string[];
+  read?: (f: string) => string;
+  exists?: (f: string) => boolean;
+  extra?: string[];
+}
+export type Ls = (dir: string) => { name: string; dir: boolean }[] | null;
+export interface Fixture {
+  fe: string;
+  files: string[];
+  read: (f: string) => string;
+  exists: (f: string) => boolean;
+  ls: Ls;
+}
+export interface Decl {
+  prop: string;
+  value: string;
+  important: boolean;
+  line: number;
+}
+export interface Rule {
+  ctx: string[];
+  prelude: string;
+  /** an at-rule's own declarations read as a selector (`@utility x` → `.x`, `@theme` → `:root`) */
+  as?: string;
+  decls: Decl[];
+  line: number;
+  kind?: string;
+}
+/** A declaration SITE: a stylesheet rule, a template attribute, a script write, a token publisher. */
+export interface Site {
+  file?: string;
+  kind?: string;
+  ctx?: string;
+  prelude?: string;
+  prop?: string;
+  value: string;
+  important?: boolean;
+  line: number;
+  varLed?: boolean;
+  /** the regimes it may hold in (media EVALUATED; a false @supports dead) */
+  regimes?: string[];
+  /** the regimes it is SURE to hold in (an unproven @supports or @ container query dead) */
+  sure?: string[];
+  unresolved?: boolean;
+  stem?: boolean | string | null;
+  bad?: boolean;
+}
+export interface SfcBlock {
+  attrs: string;
+  line: number;
+}
+export interface Sfc {
+  styles: (SfcBlock & { css: string })[];
+  scripts: (SfcBlock & { text: string })[];
+  template: { text: string; line: number } | null;
+}
+export interface TemplateElement {
+  i: number;
+  tag: string;
+  id: string | null;
+  /** every class it may carry (static `class=` and the literals of a `:class` binding) */
+  classes: Set<string>;
+  /** the static `class=` only: the classes it CERTAINLY carries */
+  sure: Set<string>;
+  dynClass: boolean;
+  attrs: Map<string, string | null>;
+  parent: number | null;
+  line: number;
+}
+export interface Regime {
+  width: number;
+  height: number;
+  pointer: "fine" | "coarse";
+  hover: "hover" | "none";
+  [feature: string]: string | number;
+}
+export interface Rgba {
+  rgb: [number, number, number];
+  a: number;
+}
+export interface Registration {
+  name: string;
+  unresolved?: boolean;
+  inherits: string | null;
+  syntax: string | null;
+  initial: string | null;
+  kind: string;
+  file: string;
+  line: number;
+}
+export interface FontBinding {
+  family: string | null;
+  src: string | null;
+  kind: "@font-face" | "FontFace";
+  file: string;
+  line: number;
+  unresolved?: boolean;
+}
+export interface Link {
+  rel: string[];
+  href: string | null;
+  attrs: Map<string, string>;
+}
+
+// ── clauses, files, strippers ───────────────────────────────────────────────────────────────────
+export const CLAUSES: Readonly<Record<string, string>>;
+/** Switch clauses off (the clause-sabotage battery); `[]` restores all. */
+export function sabotage(ids?: string[]): void;
+export function walk(
+  dir: string,
+  pred: (p: string) => boolean,
+  out?: string[],
+  ls?: Ls,
+): string[];
+export function isCss(p: string): boolean;
+/** THE ONE walker: src/ (code and every CSS language), public/** sheets, index.html, then every file an
+ *  `@import` chain or the module graph reaches. */
+export function sources(
+  fe: string,
+  o?: {
+    tests?: boolean;
+    read?: (f: string) => string;
+    exists?: (f: string) => boolean;
+    ls?: Ls;
+  },
+): string[];
+export function followImports(
+  files: string[],
+  o?: { read?: (f: string) => string; exists?: (f: string) => boolean },
+): string[];
+export function stripCss(s: string): string;
+export function stripJs(s: string): string;
+export function stripHtml(s: string): string;
+export function decodeEntities(s: string): string;
+export function decodeCssEscapes(s: string): string;
+export function sfc(text: string): Sfc;
+export function cssRules(
+  css: string,
+  baseLine?: number,
+  ctx?: string[],
+  out?: Rule[],
+): Rule[];
+export function decls(body: string, line?: number): Decl[];
+export function splitTop(s: string, sep: RegExp): string[];
+export function subjectCompound(sel: string): string;
+export function compoundClasses(compound: string): {
+  pos: Set<string>;
+  neg: Set<string>;
+};
+export function subjectHas(prelude: string, cls: string): boolean;
+export const SHORTHANDS: Readonly<Record<string, string[]>>;
+export function sets(d: { prop: string }, prop: string): boolean;
+export function constBindings(js: string): Map<string, string>;
+export function foldConcat(
+  expr: string,
+  consts?: Map<string, string>,
+  o?: { hole?: string | null },
+): string | null;
+export function foldText(
+  js: string,
+  o?: { consts?: Map<string, string> | null; hole?: string },
+): string;
+
+// ── Tailwind, templates, scripts ────────────────────────────────────────────────────────────────
+export function twPalette(): Map<string, string>;
+export function TAILWIND_ALL(tw: string): [prop: string, value: string][];
+export function TAILWIND(tw: string): [prop: string, value: string][];
+export function candidates(classes: string): string[];
+export function attrsOf(attrText: string): { name: string; value: string | null }[];
+export function templateSites(tpl: string, cls: string, baseLine?: number): Site[];
+export function consumerSites(text: string): Site[];
+export function hasCompound(sels: string[], tail: string): boolean;
+export function scriptWrites(text: string, prop: string, baseLine?: number): Site[];
+export function classWrites(
+  text: string,
+  baseLine?: number,
+): (Site & { classes: string[] })[];
+export function scriptCss(js: string, baseLine?: number): Rule[];
+export function cssBlocks(
+  f: string,
+  text: string,
+  fe?: string,
+): { css: string; line: number; kind: string }[];
+export function rulesOf(f: string, text: string, fe?: string): Rule[];
+
+// ── the census, tokens, registrations ───────────────────────────────────────────────────────────
+export function census(fe: string, cls: string, prop: string, o?: TreeOptions): Site[];
+export function tokens(
+  fe: string,
+  o?: TreeOptions,
+): { map: Map<string, string>; all: Site[] };
+export function tokenConflicts(all: Site[]): { name: string; sites: Site[] }[];
+export function stemMatches(name: string, names: Iterable<string>): string[];
+export function resolve(
+  value: string,
+  map: Map<string, string>,
+  depth?: number,
+): string;
+export function varRefs(
+  value: string,
+  names?: string[],
+  o?: { values?: string[] },
+): {
+  name: string;
+  fallback: string | null;
+  stem: boolean;
+  matches: string[];
+  unresolved: boolean;
+}[];
+export function maskedDefaults(
+  text: string,
+  registered?: string[],
+): {
+  name: string;
+  fallback: string;
+  stem: string | null;
+  at: number;
+  unresolved?: boolean;
+}[];
+export function publishers(sites: Site[]): Site[];
+export function unresolvedSites(sites: Site[]): Site[];
+export function tokenSites(fe: string, token: string, o?: TreeOptions): Site[];
+export function fontFaces(fe: string, o?: TreeOptions): FontBinding[];
+export function propertyRegistrations(fe: string, o?: TreeOptions): Registration[];
+/** `bare`: `root` is an alias bound to a clock (`const W = MOTION.rungs.whisper`), read with no member. */
+export function clockReads(
+  text: string,
+  root?: string,
+  o?: { bare?: boolean },
+): {
+  expr: string;
+  arith: boolean;
+  line: number;
+  how: "math" | "bracket" | "operator" | "read";
+  /** the arithmetic operator beside the read, or null */
+  op: string | null;
+}[];
+export function urlRefs(
+  text: string,
+): { id: string | null; raw: string; unresolved?: boolean }[];
+export function svgRefSites(
+  text: string,
+): { id: string | null; raw: string; line: number; unresolved?: boolean }[];
+export function componentSites(fe: string, o?: TreeOptions): Site[];
+export function pinsBreached(sites: Site[], pins: Record<string, unknown>): Site[];
+
+// ── elements, regimes, lengths ──────────────────────────────────────────────────────────────────
+export function templateElements(tpl: string, baseLine?: number): TemplateElement[];
+export function mayMatch(
+  sel: string,
+  el: TemplateElement,
+  els: TemplateElement[],
+  o?: { outer?: (compound: string) => boolean },
+): boolean;
+export function elementSites(
+  fe: string,
+  o: TreeOptions & {
+    file: string;
+    pick: (el: TemplateElement) => boolean;
+    props: string[];
+    whitelist?: Record<string, string[]>;
+  },
+): {
+  elements: { tag: string; id: string | null; classes: string[]; line: number }[];
+  sites: Site[];
+};
+export const REGIMES: Readonly<Record<string, Regime>>;
+export function ALL_REGIMES(): string[];
+export function evalMedia(query: string, regime: Regime): boolean;
+export function evalSupports(cond: string): boolean | null;
+export function regimesOf(
+  ctx?: string[],
+  regimes?: Record<string, Regime>,
+  o?: { must?: boolean },
+): string[];
+export function lengthPx(
+  value: string,
+  consumer?: { fontSize?: number; lineHeight?: number; rootFontSize?: number },
+  map?: Map<string, string>,
+): number | null;
+export function effectiveAt<S extends Site>(sites: S[], regime: string): S | null;
+
+// ── links, colours ──────────────────────────────────────────────────────────────────────────────
+export function stripInert(html: string): string;
+export function htmlLinks(html: string): Link[];
+export const LINK_ALLOW: Readonly<Record<string, Record<string, string[] | null>>>;
+export function exactlyOneLink(
+  html: string,
+  rel: string,
+  o?: { allow?: Record<string, string[] | null> | null },
+): { ok: boolean; links: Link[]; why: string[] };
+export function srgbToOklab(rgb: [number, number, number]): [number, number, number];
+export function parseColor(str: string): Rgba | null;
+export function deltaE(c1: Rgba, c2: Rgba): number;
+export function colorLiterals(value: string): (Rgba & { text: string })[];
+export function chromaOf(rgb: [number, number, number]): number;
+export function darkArmCensus(
+  fe: string,
+  o?: TreeOptions & { ring?: string[]; ringAncestor?: string; chroma?: number },
+): Record<string, unknown>;
+
+// ── the self-test ───────────────────────────────────────────────────────────────────────────────
+export function fixture(tree: Record<string, string>, root?: string): Fixture;
+export function selfTest(L: Record<string, unknown>): {
+  rows: {
+    clause: string | null;
+    family: string;
+    name: string;
+    ok: boolean;
+    err: string | null;
+  }[];
+  fails: number;
+};
+export function treeReading(fe: string): {
+  anchor: boolean;
+  rows: { name: string; ok: boolean; red: boolean | null; why: string }[];
+};
