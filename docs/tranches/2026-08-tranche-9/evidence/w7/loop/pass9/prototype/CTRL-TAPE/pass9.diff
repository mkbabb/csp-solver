+// ---------------------------------------------------------------------------- clock reads (LADDER)
+/** Every read of the motion clock `root` (`MOTION.rungs.whisper`, `MOTION["rungs"].x`) with `arith`
+ *  true when it is ARITHMETIC: an operand of `* / % + - >> << >>> | & ^ ~`, an argument of a Math
+ *  call (`Math.min(MOTION.x, 40)`), or read through a bracket (LADDER M1–M3). */
+export function clockReads(text, root = "MOTION", { bare = false } = {}) {
+  const s = stripJs(text);
+  const out = [];
+  // LADDER (pass 8): a name BOUND to a clock (`const W = MOTION.rungs.whisper`) is read bare —
+  // `Math.min(W, 40)` has no member access, and a root-only reader never saw it
+  const tail = bare && on("clock-alias") ? "*" : "+";
+  const re = new RegExp(
+    `(?<![\\w$.])${root}((?:\\s*\\.\\s*[A-Za-z_$][\\w$]*|\\s*\\[[^\\]]+\\])${tail})(?![\\w$])`,
+    "g",
+  );
+  for (const m of s.matchAll(re)) {
+    const before = s.slice(Math.max(0, m.index - 40), m.index);
+    const after = s.slice(m.index + m[0].length, m.index + m[0].length + 6);
+    const bracket = m[1].includes("[");
+    // the operator itself is returned (pass 8): a consumer that bounds only SHORTENING arithmetic
+    // reads `op`. A LOGICAL `||`/`&&` is a fallback, never a bitwise `|`/`&` (pass 8: the
+    // `props.noiseDelay || DRAW_IN_PRESETS.glyph.baseDelay` read was 'arithmetic' by its last bar)
+    const opB = /(>>>?|<<|\*\*|[*/%^~]|(?<![|&])[|&]|(?<=[^+])\+|(?<=[^-])-)\s*$/.exec(
+      before,
+    );
+    const opA = /^\s*(>>>?|<<|\*\*|[*/%^]|[|&](?![|&])|\+(?!\+)|-(?!-))/.exec(after);
+    const op = !!(opB || opA);
+    const inMath =
+      /Math\.(?:min|max|floor|round|ceil|trunc|abs|pow|sign)\(\s*(?:[^()]*,\s*)?$/.test(
+        before,
+      );
+    out.push({
+      expr: m[0].replace(/\s+/g, ""),
+      line: lineAt(s, m.index),
+      arith: on("clock-arith")
+        ? op || inMath || bracket
+        : /[*/%-]\s*$/.test(before) || /^\s*[*/%-]/.test(after),
+      how: inMath ? "math" : bracket ? "bracket" : op ? "operator" : "read",
+      op: (opB ?? opA)?.[1] ?? null,
+    });
+  }
+  return out;
+}
