@@ -0,0 +1,2055 @@
+#!/usr/bin/env node
+/**
+ * THE FOOT'S DECLARATION WITNESS (T9-W7 · CTRL-TAPE, the shape of CTRL-COST's `check-cost-face`).
+ *
+ * CI is browserless (O-12), so what CI can hold is the DECLARATION a measured row follows from.
+ * Each clause below is the load-bearing half of a row read on paint in the e2e estate
+ * (`zone-grammar.spec.ts`, "the foot's painted bottom", is the behavioural half of 1/3/8/9/10).
+ *
+ * PASS 8 · KEYED ON THE ELEMENTS, NOT ON CLASS NAMES (LAWS P7 §F, registry-v7 §2.5). Pass 7 asked
+ * whether a rule's subject compound NAMED `card-foot`/`action-bar`/`bar-frame`; 26 of 29 one-line
+ * siblings the critic fed it stayed GREEN, four of them erasing or displacing the foot on paint
+ * (`.bar-frame { inset: 0 0 100% 0 }`, `.drawer-case > div:last-of-type { overflow: clip }`,
+ * `.action-bar { top: 2.875rem }`, and a revert of the pass's own flex column). This gate builds
+ * the foot's DOM chain from the three templates that render it — `GameScene` (the case, the card,
+ * `#card-foot`), `GameControlPanel` (the bar, teleported into the foot; its frame; a well) and
+ * `HandDrawnOutline` (the root the case and both frames ARE, and the svg under each) — and asks of
+ * EVERY rule in the estate whether its selector MAY MATCH each element (the ONE library's
+ * `mayMatch`, with the page above GameScene's root CLOSED to the classes the rest of the estate can
+ * put there). An extra class, an attribute, `:nth-*`/`:last-*`, `:where()`, nesting and a scoped
+ * block all reach the element or they do not; the VALUE is read on every prop the clause keys on.
+ * Script writes are read tree-wide in every file that names the chain (the library's
+ * `scriptWrites`, `cssText`/`setAttribute('style')` folded, and `classWrites` for a utility a
+ * script adds). The library is imported from its product home, `./shape-census.mjs`.
+ *
+ *   1 THE INSET   every site that sets the foot's bottom pad spends `env(safe-area-inset-bottom)`
+ *                 ADDED (coefficient 1) to a net pad no smaller than its regime's swept floor
+ *                 (0.75rem dock, 1.125rem short landscape; the rail's note berth
+ *                 `max(3.5rem, env())`), and in EVERY regime the effective pad is such a site.
+ *   2 THE LAYER   the foot is positioned `relative` and its effective z-index is ≥ the card's in
+ *                 every regime (unpositioned it paints UNDER the card; coverage 0.00).
+ *   3 THE PEN     the bar's `HandDrawnOutline` carries the WELLS' four props and mounts whenever
+ *                 the bar does; a rule that reaches the frame and not a well declares only
+ *                 `position: absolute; inset: 0; pointer-events: none; z-index: 0`; a rule that
+ *                 reaches the frame's svg/g/path and not a well's is refused whatever it sets.
+ *   4 ONE HAND    no rule on the bar, its verbs or the foot draws an edge, lays a slab or sets ink.
+ *   5 THE FLOOR   the confirm's answers take `min-width`/`min-height: var(--tap-floor)` BARE.
+ *   6 THE BAND    `.controls-card` spends `padding-top: var(--pin-band)`, `--pin-band` is a
+ *                 `calc()`, and nothing in src publishes it (or its dead sample `--card-pad-t`).
+ *   7 THE REGIME  ONE predicate per regime: the foot's landscape pad, the tongue's flank and the
+ *                 quick set's berth key on the SAME query; the note berth's pad and its mount too;
+ *                 no module but `useCoarsePointer.ts` mints a media ref.
+ *   8 THE CLIP    nothing clips the frame's chain (the frame, the bar, the foot, the case) and
+ *                 nothing fades the frame, the bar or the foot — by any rule, utility class, inline
+ *                 style or script write.
+ *   9 THE COLUMN  (pass 7's seam, CI-held from pass 8) the case is `display: flex;
+ *                 flex-direction: column` with a `max-height` cap in every regime; the card may
+ *                 shrink (no `flex-shrink: 0`, no `flex: none`, no min/max height of its own); the
+ *                 foot is `flex: none` in every regime and nothing makes it yield. PASS 9 keys
+ *                 the PRECONDITIONS: the card is a scrollport (`overflow-y` auto|scroll) in every
+ *                 regime, the case's cap bounds at or under the viewport (`bounds()`), no `order`
+ *                 on the card or the foot, no band above the foot, the case's bottom pad ≤ 32 px,
+ *                 the foot and the bar no height of their own, and no `@apply` sets a watched prop.
+ *  11 THE MOUNT   (pass 9) no `v-show`/`v-if`/`hidden` on the chain, and the bar's Teleport goes to
+ *                 `#card-foot`, disabled only on an expression that names something.
+ *  10 THE SEAT   nothing moves the bar or the foot off its layout box: no `top`/`bottom`/`inset`,
+ *                 `translate`, `transform`, `scale`, `rotate`, `zoom`, no negative bottom margin on
+ *                 the foot, and the bar stays `position: relative`.
+ *
+ * `--self-test` feeds every plant in memory (no tree file is written) and requires each to RED the
+ * clause beside it and the live tree GREEN. `--sabotage-battery` deletes each clause in turn and
+ * requires the self-test to RED (LAWS P7 §F (ii)). Run from web/frontend:
+ * `node scripts/check-tape-foot.mjs [--self-test] [--sabotage-battery] [--verbose]`.
+ */
+import fs from "node:fs";
+import path from "node:path";
+import process from "node:process";
+import {
+  sources,
+  sfc,
+  rulesOf,
+  splitTop,
+  templateElements,
+  mayMatch,
+  decls,
+  TAILWIND_ALL,
+  scriptWrites,
+  classWrites,
+  stripJs,
+  resolve,
+  regimesOf,
+  effectiveAt,
+  REGIMES,
+  ALL_REGIMES,
+} from "./shape-census.mjs";
+
+const ROOT = path.join(import.meta.dirname, "..");
+const PANEL = "src/games/shared/GameControlPanel.vue";
+const SCENE_SFC = "src/games/shared/GameScene.vue";
+const RIBBON = "src/games/shared/ConfirmRibbon.vue";
+const OUTLINE = "src/pencil/grid/HandDrawnOutline.vue";
+const REGIME_TS = "src/games/shared/useCoarsePointer.ts";
+const TAB = "src/games/shared/DrawerTab.vue";
+const SCENE_CSS = "src/games/shared/scene.css";
+/** The chain's own classes and id: what only the foot's three templates carry. */
+const CHAIN_NAMES = [
+  "card-foot",
+  "action-bar",
+  "action-verbs",
+  "bar-frame",
+  "drawer-case",
+  "controls-card",
+];
+const J = (...s) => s.join(""); // keeps a plant's utility out of Tailwind's source scan
+
+/** Clause sabotage (`--sabotage-battery`): a clause id in here is not checked. */
+const OFF = new Set();
+
+// ------------------------------------------------------------------------------ the tree
+const disk = new Map();
+const fromDisk = (f) => disk.get(f) ?? disk.set(f, fs.readFileSync(f, "utf8")).get(f);
+let listed = null;
+export function tree(overlay = {}) {
+  listed ??= sources(ROOT);
+  const files = [
+    ...new Set([...listed, ...Object.keys(overlay).map((r) => path.join(ROOT, r))]),
+  ];
+  const read = (f) => overlay[path.relative(ROOT, f)] ?? fromDisk(f);
+  return {
+    files,
+    read,
+    rel: (f) => path.relative(ROOT, f),
+    abs: (r) => path.join(ROOT, r),
+  };
+}
+const ruleCache = new Map();
+function rulesFor(t, f) {
+  const text = t.read(f);
+  const key = f + "\0" + text;
+  if (!ruleCache.has(key)) ruleCache.set(key, rulesOf(f, text, ROOT));
+  return ruleCache.get(key);
+}
+const elCache = new Map();
+function elementsOf(t, rel) {
+  const text = t.read(t.abs(rel));
+  if (!elCache.has(text)) {
+    const b = sfc(text);
+    elCache.set(
+      text,
+      b.template ? templateElements(b.template.text, b.template.line) : [],
+    );
+  }
+  return elCache.get(text);
+}
+
+// ------------------------------------------------------------------------------ the chain
+/** The foot's DOM, stitched from its three templates: GameScene's elements; HandDrawnOutline's
+ *  root MERGED into the case and into both frames (a component root is the host element, with
+ *  both files' scope), its svg subtree hung under each; the panel's roots under the card (the
+ *  panel is the card's slot) and the bar re-parented under `#card-foot` (the Teleport). */
+export function chain(t) {
+  const els = [];
+  const graft = (list, file) => {
+    const base = els.length;
+    for (const e of list)
+      els.push({
+        ...e,
+        i: base + e.i,
+        parent: e.parent == null ? null : base + e.parent,
+        classes: new Set(e.classes),
+        attrs: new Map(e.attrs),
+        from: new Set([file]),
+      });
+    return (pred) => {
+      const e = list.find(pred);
+      return e ? els[base + e.i] : null;
+    };
+  };
+  const gs = graft(elementsOf(t, SCENE_SFC), SCENE_SFC);
+  const panelList = elementsOf(t, PANEL);
+  const pn = graft(panelList, PANEL);
+  const hdo = elementsOf(t, OUTLINE);
+  const root = hdo.find((e) => e.parent == null);
+  const outline = (host) => {
+    if (!host || !root) return [];
+    for (const c of root.classes) host.classes.add(c);
+    host.from.add(OUTLINE);
+    host.tag = root.tag;
+    const kids = hdo.filter((e) => e !== root);
+    const at = new Map([[root.i, host.i]]);
+    kids.forEach((e, k) => at.set(e.i, els.length + k));
+    for (const e of kids)
+      els.push({
+        ...e,
+        i: at.get(e.i),
+        parent: at.get(e.parent) ?? host.i,
+        classes: new Set(e.classes),
+        attrs: new Map(e.attrs),
+        from: new Set([OUTLINE]),
+        k: e.i,
+      });
+    return kids.map((e) => els[at.get(e.i)]);
+  };
+  const c = {
+    CASE: gs((e) => e.classes.has("drawer-case")),
+    CARD: gs((e) => e.classes.has("controls-card")),
+    FOOT: gs((e) => e.id === "card-foot"),
+    BAR: pn((e) => e.classes.has("action-bar")),
+    VERBS: pn((e) => e.classes.has("action-verbs")),
+    FRAME: pn((e) => e.classes.has("bar-frame")),
+    WELL: pn((e) => e.classes.has("tray-well")),
+  };
+  c.CASE_SUB = outline(c.CASE);
+  c.FRAME_SUB = outline(c.FRAME);
+  c.WELL_SUB = outline(c.WELL);
+  const base =
+    els.indexOf(c.BAR) -
+    panelList.indexOf(panelList.find((e) => e.classes.has("action-bar")));
+  for (const e of panelList)
+    if (e.parent == null && c.CARD) els[base + e.i].parent = c.CARD.i;
+  if (c.BAR && c.FOOT) c.BAR.parent = c.FOOT.i;
+  // THE PAGE ABOVE GameScene's ROOT: every class and id any OTHER template or script can put there
+  // (the chain's own names only if something else also carries them).
+  const outerCls = new Set(["dark"]);
+  const outerIds = new Set(["app"]);
+  for (const f of t.files) {
+    const rel = t.rel(f);
+    if (/\.vue$/.test(rel) && ![SCENE_SFC, PANEL, OUTLINE].includes(rel))
+      for (const e of elementsOf(t, rel)) {
+        for (const x of e.classes) outerCls.add(x);
+        if (e.id) outerIds.add(e.id);
+      }
+    if (/\.(vue|ts|js|mjs)$/.test(rel) && !/\.test\.ts$/.test(rel)) {
+      const text = t.read(f);
+      if (!cwCache.has(text)) cwCache.set(text, classWrites(text));
+      for (const w of cwCache.get(text)) for (const x of w.classes) outerCls.add(x);
+    }
+  }
+  const outer = (comp) => {
+    const bare = comp.replace(/:not\((?:[^()]|\([^()]*\))*\)/g, "");
+    for (const m of bare.matchAll(/\.([\w-]+)/g)) if (!outerCls.has(m[1])) return false;
+    for (const m of bare.matchAll(/#([\w-]+)/g)) if (!outerIds.has(m[1])) return false;
+    return true;
+  };
+  const sig = [SCENE_SFC, PANEL, OUTLINE]
+    .map((r) => sfc(t.read(t.abs(r))).template?.text ?? "")
+    .concat([...outerCls].sort().join(" "), [...outerIds].sort().join(" "))
+    .join("\0");
+  return { els, ...c, outer, sig };
+}
+const cwCache = new Map();
+
+// ------------------------------------------------------------------------------ sites
+const PSEUDO_EL =
+  /::?(before|after|marker|placeholder|selection|backdrop|first-line|first-letter|-webkit-[\w-]+)\s*$/;
+/** Every declaration that may reach each named element: rules (scoped blocks only on their own
+ *  file's elements unless `:deep()`), the element's `style=`, a bound `:style`/`v-bind` (UNRESOLVED)
+ *  and its Tailwind candidates. → Map name → [{file, ctx, prelude, prop, value, important, line,
+ *  regimes, pseudo, key, kind}] */
+const siteCache = new Map();
+function sitesOf(t, ch, named) {
+  const out = new Map(Object.keys(named).map((n) => [n, []]));
+  for (const f of t.files) {
+    const rel = t.rel(f);
+    const text = t.read(f);
+    const key = `${ch.sig}\0${f}\0${text}`;
+    if (siteCache.has(key)) {
+      for (const [n, list] of siteCache.get(key)) out.get(n).push(...list);
+      continue;
+    }
+    const mine = new Map(Object.keys(named).map((n) => [n, []]));
+    for (const r of rulesFor(t, f)) {
+      const prelude = r.as ?? r.prelude;
+      if (!prelude || prelude.startsWith("@") || prelude.startsWith("<")) continue;
+      if (r.ctx.some((c) => /^@(-webkit-)?keyframes\b/.test(c))) continue; // a frame, not a selector
+      const scoped = r.kind === "sfc-style-scoped";
+      for (const sel of splitTop(prelude, /,/)) {
+        const one = sel.trim();
+        if (!one) continue;
+        const deep = /:deep\(|::v-deep/.test(one);
+        const pseudo = PSEUDO_EL.test(one);
+        for (const [n, el] of Object.entries(named)) {
+          if (!el) continue;
+          if (scoped && !deep && !el.from.has(rel)) continue;
+          if (!mayMatch(one, el, ch.els, { outer: ch.outer })) continue;
+          for (const d of r.decls)
+            mine.get(n).push({
+              kind: r.kind,
+              file: rel,
+              ctx: r.ctx.join(" "),
+              prelude: one,
+              prop: d.prop,
+              value: d.value,
+              important: d.important,
+              line: d.line,
+              regimes: regimesOf(r.ctx),
+              pseudo,
+              key: `${rel}:${d.line}:${one}:${d.prop}`,
+            });
+        }
+      }
+    }
+    siteCache.set(key, mine);
+    for (const [n, list] of mine) out.get(n).push(...list);
+  }
+  for (const [n, el] of Object.entries(named)) {
+    if (!el) continue;
+    const file = [...el.from][0];
+    for (const d of decls(el.attrs.get("style") ?? ""))
+      out.get(n).push({
+        ...d,
+        kind: "style-attr",
+        file,
+        ctx: "",
+        prelude: `<${el.tag} style>`,
+        line: el.line,
+        regimes: ALL_REGIMES(),
+        key: `${file}:${el.line}:style:${d.prop}`,
+      });
+    for (const a of [":style", "v-bind:style", "v-bind"])
+      if (el.attrs.has(a))
+        out.get(n).push({
