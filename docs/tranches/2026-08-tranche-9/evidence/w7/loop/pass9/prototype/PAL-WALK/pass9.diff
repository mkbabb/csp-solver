@@ -0,0 +1,1091 @@
+// PRM: live, because §A and §B read fills of colours the module computes and no byte of them is
+// animated. §C is the per-test exception, frozen AT THE TEST (emulateMedia before goto on both of
+// its pages): the board frame's boil moved bytes inside the name's clip between its photographs.
+/**
+ * THE PLAYER'S COLOUR, READ OFF THE ENGINE'S OWN PIXELS (T9-W7 §11c, tier 3).
+ *
+ * The arcs gate has three tiers and this is the last one. Tier 1 (`scripts/check-peer-arcs.mjs`)
+ * holds the CONSTANT against `index.css` by resolved value. Tier 2 (`useSession.test.ts`) holds
+ * the MODULE's emitted hues against that constant and prices the capacity in ΔE. Neither of them
+ * paints: a requested `oklch()` is not a colour until an engine clips it into sRGB and rounds it
+ * to three bytes, and that round trip is where every earlier version of this claim died — a flat
+ * chroma rotated hues by 15.33° and walked a hand back inside crayon-blue's arc while the
+ * arithmetic said it was 12° clear.
+ *
+ * So this asks the ENGINE, twice over. §A composites the walk's own strings through the page's
+ * canvas at the bands the live stylesheet is serving. §B photographs the ONE ring the product
+ * actually draws and reads its bytes back, because a stroke that paints 1.89 CSS px wide never
+ * reaches its token and every arithmetic ring number over-reports by the difference.
+ *
+ * NOTHING HERE IS A LITERAL THAT COULD ROT. The ring's alpha and fill come off the cascade, not
+ * out of this file. The count of hands near a house ink is a RATIO to the count the house's own
+ * chromatic tokens produce among themselves, re-derived in the same run — a literal ceiling of 5
+ * reds at 94 of 360 hues the moment a sibling wave lands one new token, which is a gate measuring
+ * the estate's weather rather than this family's design.
+ */
+import { test, expect, type Page } from "@playwright/test";
+import { glyphGate, glyphPopulation, TEXT_PLANTS, fmt as popFmt } from "./lib/glyph-pop.mjs";
+// §B reads paint through the ONE libraries (homes v2): the photographs and WCAG luminance from
+// paint-lib, the four-band edge with its per-band thickness clause from edge-bands. The private
+// PNG decoder and luminance this file carried through pass 8 are deleted.
+import { onOff, lum as lumAt, ratio as wcag } from "./lib/paint-lib.mjs";
+import { edgeGate, EDGE_PLANTS, fmt as edgeFmt } from "./lib/edge-bands.mjs";
+
+/** ONE BOARD, ENCODED (the chair's addendum: `?board=` is a codec payload, not a name) — minted
+ *  with the app's own codec from the `74a2b5d9` control's deal, `base64url("\x01" + "3." + 81
+ *  cells base36)`, so every arm and every run reads the same givens. */
+const BOARD =
+  "ATMuMzkxNjc4NDIwMjQwMDMwNjA4Njc4MDAwMDMwMTg2OTI3MzAwMDU5MzE0Mjg2NDAyODU2OTE3MDYzNTkxMDQwNTA3NDYyODkwOTI0NzgzMDYx";
+const GIVENS =
+  "39167842.24..3.6.8678....3.1869273...593142864.2856917.63591.4.5.746289.924783.61";
+const SOLO = `./?board=${BOARD}&wire=local`;
+/** THE SECTION'S STATISTIC (registry-v4 §2.4): the ring's CORE MEDIAN — every pixel the ring
+ *  moved at ≥ 50 % of the most-moved one, read against its own fill, and the median of those —
+ *  clears 3.0 with the pin rule's 0.10 of headroom. It is the stroke's solid interior, so it does
+ *  not move with density (3.133 light / 3.341 dark, worst of 144, at dpr 1, 2 and 3 alike); what
+ *  density moves is the p30 and the share of core pixels under 3.0, which are printed. */
+const CORE_FLOOR = 3.1;
+
+interface Reading {
+  band: string;
+  ringBand: string;
+  /** what the CASCADE says the ring is drawn with — never a literal in this file. */
+  ring: { alpha: number; fill: number; width: number };
+  hands: { i: number; h: number; C: number; ringC: number; rgb: number[] }[];
+  /** THE LAW IN DEGREES, on the painted bytes of BOTH strings a hand writes: the digit and the
+   *  ring. `sep` is the nearest a painted hue comes to a painted house token's hue (the law's
+   *  floor is 12°); `drift` is how far the engine turned the hue the module asked for. */
+  arcs: Record<
+    "digit" | "ring",
+    { sep: number; i: number; token: string; drift: number; driftAt: number }
+  >;
+  /** the ring at §6's three candidate alphas, shipped band, worst of 144 over its own fill. */
+  ringAlpha: Record<string, number>;
+  /** the digit against the ring drawn round it — the one adjacency the second key invents. */
+  digitVsRing: { ratio: number; i: number };
+  nearest: { dE: number; i: number; token: string };
+  /** hands under the house's own nearest-pair distance, and that distance, re-derived here. */
+  houseReference: number;
+  underReference: number;
+  /** the share of the house's OWN chromatic tokens whose nearest neighbour is under that same
+   *  reference — the ceiling the walk's own share is held against. */
+  houseShare: number;
+  houseTokens: number;
+  aa: { ratio: number; i: number; ground: string }[];
+  /** the ring against its own fill, by token arithmetic, at the shipped band. */
+  ringArithmetic: Record<string, { worst: number; i: number; onPopover: number; minC: number }>;
+  /** what alpha ALONE would have to be for the palette to clear 3:1 with no ring band. */
+  alphaOnly: { first: number | null; under065: number };
+  peerVsPeer: Record<string, number>;
+}
+
+async function settled(page: Page): Promise<void> {
+  await page.waitForSelector("svg.handwritten-logo", { timeout: 40000 });
+  await expect
+    .poll(() => page.locator(".sudoku-cell .glyph-svg").count(), { timeout: 40000 })
+    .toBeGreaterThan(0);
+}
+
+async function theme(page: Page, t: "light" | "dark"): Promise<void> {
+  await page.evaluate((x) => {
+    document.documentElement.classList.toggle("dark", x === "dark");
+  }, t);
+  await page.evaluate(
+    () => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))),
+  );
+}
+
+/** Put a peer's cursor on one cell for real: the product's own class and the product's own var,
+ *  bound with the ring string the module emits. Nothing else about the cell is touched. */
+async function seatCursor(page: Page, index: number | null): Promise<void> {
+  await page.evaluate(async (i) => {
+    const w = window as unknown as { __walkSeat?: MutationObserver };
+    const cell = document.querySelectorAll<HTMLElement>(".game-cell")[40];
+    if (!cell) throw new Error("no cell 40");
+    w.__walkSeat?.disconnect();
+    delete w.__walkSeat;
+    if (i === null) {
+      cell.classList.remove("is-peer-cursor");
+      cell.style.removeProperty("--color-peer-cursor-ink");
+      return;
+    }
+    const served = "/src/games/shared/playerIdentity.ts";
+    const m = (await import(/* @vite-ignore */ served)) as {
+      inkFor: (n: number) => Record<string, string>;
+    };
+    const ink = m.inkFor(i)["--color-peer-cursor-ink"];
+    const set = (): void => {
+      cell.style.setProperty("--color-peer-cursor-ink", ink);
+      cell.classList.add("is-peer-cursor");
+    };
+    set();
+    // THE BOIL RE-RENDERS THE CELL, and Vue patches `class` by writing the attribute whole — so
+    // a class set from outside the component survives until the next tick and no longer. The
+    // product's own seat is a peer on the wire; this probe is about the RING'S BYTES, not the
+    // session, so the seat is simply re-asserted. Three lines of test affordance, and not one
+    // declaration of `gameCell.css` is restated here.
+    const o = new MutationObserver(() => {
+      if (!cell.classList.contains("is-peer-cursor")) set();
+    });
+    o.observe(cell, { attributes: true, attributeFilter: ["class", "style"] });
+    w.__walkSeat = o;
+  }, index);
+  // THE PHOTOGRAPH IS OF THE FINISHED LINE. The ring draws on (`ghost-draw-on`, 180ms), so the
+  // settle is the draw-on's own end: no animation left running on cell 40's ghost path — read
+  // on that element, never document-wide, where the boil's beat would never let it settle.
+  await expect
+    .poll(() =>
+      page.evaluate(() => {
+        const cell = document.querySelectorAll<HTMLElement>(".game-cell")[40];
+        const path = cell?.querySelector(".cell-ghost-path");
+        return !path || path.getAnimations().every((a) => a.playState !== "running");
+      }),
+    )
+    .toBe(true);
+}
+
+/** One theme's whole arithmetic reading, taken inside the page so the bytes are the engine's. */
+async function read(page: Page): Promise<Reading> {
+  // THE SHIPPED BAND IS THE SHEET'S, never this file's — a spec that sets the token it is about
+  // to assert on cannot red when the token moves, which is exactly what the first cut of this
+  // row did. The ALTERNATE is passed in and priced beside it; nothing is written to the page.
+  await seatCursor(page, 0);
+  const out = await page.evaluate(async (): Promise<Reading> => {
+    // The module the BOARD imports, in the page's own graph — a served path rather than a static
+    // specifier, because this file is typechecked from `e2e/` where that path does not resolve,
+    // and because the point is to ask the running product rather than a copy of it.
+    const served = "/src/games/shared/playerIdentity.ts";
+    const m = (await import(/* @vite-ignore */ served)) as {
+      inkFor: (i: number) => Record<string, string>;
+    };
+    const cs = getComputedStyle(document.documentElement);
+    const band = cs.getPropertyValue("--peer-ink-l").trim();
+    const ringBandNow = cs.getPropertyValue("--peer-ring-l").trim();
+    const sub = (s: string): string =>
+      s.replace("var(--peer-ink-l)", band).replace("var(--peer-ring-l)", ringBandNow);
+    const inks = Array.from({ length: 144 }, (_, i) => sub(m.inkFor(i)["--color-user-ink"]));
+    const rings = Array.from({ length: 144 }, (_, i) =>
+      sub(m.inkFor(i)["--color-peer-cursor-ink"]),
+    );
+
+    // THE RING'S GEOMETRY IS THE CASCADE'S. `gameCell.css` is §6's file and this family does not
+    // touch it, so the alpha, the fill and the width are READ off the element the product draws
+    // rather than written down here where they would rot silently.
+    const path = document.querySelector(".game-cell.is-peer-cursor .cell-ghost-path");
+    if (!path) throw new Error("no peer-cursor ring on the board");
+    const ps = getComputedStyle(path);
+    const ringGeom = {
+      alpha: Number(ps.strokeOpacity),
+      fill: Number(ps.fillOpacity),
+      width: parseFloat(ps.strokeWidth),
+    };
+
+    // EVERY CUSTOM PROPERTY THE SHEET NAMES, RESOLVED THROUGH THE CASCADE — which is what
+    // "reserved per arm" means and what a regex over the source cannot do: in dark, the light
+    // block's hexes are text in a stylesheet and paint nothing, and comparing a night-time hand
+    // against a daytime token is a number about nobody.
+    const names = new Set<string>();
+    for (const s of document.styleSheets) {
+      let rules: CSSRuleList;
+      try {
+        rules = s.cssRules;
+      } catch {
+        continue; // a cross-origin sheet has nothing to say about this product's tokens
+      }
+      for (const r of rules)
+        for (const mm of r.cssText.matchAll(/(--[a-z0-9-]+):/g)) names.add(mm[1]);
+    }
+
+    const c = document.createElement("canvas");
+    c.width = c.height = 1;
+    const g = c.getContext("2d", { willReadFrequently: true })!;
+    const paint = (ground: string, css: string, alpha: number): number[] => {
+      g.globalAlpha = 1;
+      g.globalCompositeOperation = "copy";
+      g.fillStyle = ground;
+      g.fillRect(0, 0, 1, 1);
+      g.globalCompositeOperation = "source-over";
+      g.globalAlpha = alpha;
+      g.fillStyle = css;
+      g.fillRect(0, 0, 1, 1);
+      const d = g.getImageData(0, 0, 1, 1).data;
+      return [d[0], d[1], d[2]];
+    };
+    const lin = (v: number): number =>
+      v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
+    const oklab = ([R, G, B]: number[]): number[] => {
+      const [r, gg, b] = [R, G, B].map((v) => lin(v / 255));
+      const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * gg + 0.0514459929 * b);
+      const mm = Math.cbrt(0.2119034982 * r + 0.6806995451 * gg + 0.1073969566 * b);
+      const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * gg + 0.6299787005 * b);
+      return [
+        0.2104542553 * l + 0.793617785 * mm - 0.0040720468 * s,
+        1.9779984951 * l - 2.428592205 * mm + 0.4505937099 * s,
+        0.0259040371 * l + 0.7827717662 * mm - 0.808675766 * s,
+      ];
+    };
+    const dE = (a: number[], b: number[]): number => {
+      const [x, y] = [oklab(a), oklab(b)];
+      return Math.hypot(x[0] - y[0], x[1] - y[1], x[2] - y[2]);
+    };
+    const chromaOf = (rgb: number[]): number => {
+      const [, A, B] = oklab(rgb);
+      return Math.hypot(A, B);
+    };
+    const lum = ([r, gg, b]: number[]): number =>
+      0.2126 * lin(r / 255) + 0.7152 * lin(gg / 255) + 0.0722 * lin(b / 255);
+    const ratio = (a: number[], b: number[]): number => {
+      const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p);
+      return (x + 0.05) / (y + 0.05);
+    };
+
+    const hueOf = (rgb: number[]): number => {
+      const [, A, B] = oklab(rgb);
+      const h = (Math.atan2(B, A) * 180) / Math.PI;
+      return h < 0 ? h + 360 : h;
+    };
+    const arcGap = (a: number, b: number): number => {
+      const d = Math.abs(a - b) % 360;
+      return d > 180 ? 360 - d : d;
+    };
+    const asked = (css: string): number => Number(/([\d.]+)deg\)/.exec(css)![1]);
+
+    const hands = inks.map((css, i) => {
+      const rgb = paint("#808080", css, 1);
+      const [, A, B] = oklab(rgb);
+      const h = (Math.atan2(B, A) * 180) / Math.PI;
+      return {
+        i,
+        h: h < 0 ? h + 360 : h,
+        C: Math.hypot(A, B),
+        ringC: chromaOf(paint("#808080", rings[i], 1)),
+        rgb,
+      };
+    });
+
+    // THE TOKENS THIS ARM ACTUALLY SERVES, found by chroma in the live cascade — the same rule
+    // tier 1 reads the source with, so a rename cannot hide a hue here either.
+    const tokens = [...names]
+      .map((name) => ({ name, value: cs.getPropertyValue(name).trim() }))
+      .filter((t) => /^(#|rgb|hsl|oklch|color\()/i.test(t.value))
+      .map((t) => ({ name: t.name, rgb: paint("#808080", t.value, 1) }))
+      .filter((t) => chromaOf(t.rgb) > 0.06);
+
+    // THE REFERENCE, RE-DERIVED IN THIS RUN AND IN THIS ARM. It used to be the literal 0.0764 —
+    // the light arm's orange against gold — carried into the dark arm where the same pair reads
+    // 0.0605. The estate states this number about itself: the closest two CRAYONS, the five
+    // colours this product calls different colours, read off the live cascade.
+    const crayons = tokens.filter((t) => /^--color-crayon-/.test(t.name));
+    let houseReference = Infinity;
+    for (let a = 0; a < crayons.length; a++)
+      for (let b = a + 1; b < crayons.length; b++)
+        houseReference = Math.min(houseReference, dE(crayons[a].rgb, crayons[b].rgb));
+
+    /** How close a thing gets to the nearest OTHER chromatic token in the house. */
+    const nearestOther = (rgb: number[], self?: string): { dE: number; token: string } => {
+      let best = { dE: Infinity, token: "" };
+      for (const t of tokens) {
+        if (t.name === self) continue;
+        const d = dE(rgb, t.rgb);
+        if (d > 1e-9 && d < best.dE) best = { dE: d, token: t.name };
+      }
+      return best;
+    };
+
+    // AND THE COUNT IS A RATIO TO THE HOUSE'S OWN. `underReference ≤ 5` was a literal, and a
+    // literal measures the estate's weather: one new token from a sibling wave reds it at 94 of
+    // 360 hues. What the walk owes is that it crowd the house's inks NO HARDER THAN THE HOUSE
+    // CROWDS ITSELF — the share of house tokens whose own nearest neighbour is under the crayon
+    // reference, re-derived here, against the share of hands that are.
+    // THE LAW IN DEGREES, painted. Tier 1 holds the arcs against the sheet and tier 2 the
+    // module's hues against the arcs, both in arithmetic; this is the only row that asks where
+    // the ENGINE put each hue, for the digit AND the ring. The ring is the harder case: at a
+    // chroma near 0.055 an 8-bit round trip turns a hue further than it turns the digit's, so
+    // the ±1° margin inside the ±13° arcs was sized for a string the ring is not.
+    const tokenHues = tokens.map((t) => ({ name: t.name, h: hueOf(t.rgb) }));
+    const arcs = {} as Reading["arcs"];
+    for (const [key, list] of [
+      ["digit", inks],
+      ["ring", rings],
+    ] as ["digit" | "ring", string[]][]) {
+      const row = { sep: Infinity, i: -1, token: "", drift: 0, driftAt: -1 };
+      list.forEach((css, i) => {
+        const h = hueOf(paint("#808080", css, 1));
+        const drift = arcGap(h, asked(css));
+        if (drift > row.drift) Object.assign(row, { drift, driftAt: i });
+        for (const t of tokenHues) {
+          const d = arcGap(h, t.h);
+          if (d < row.sep) Object.assign(row, { sep: d, i, token: t.name });
+        }
+      });
+      arcs[key] = row;
+    }
+
+    let houseUnder = 0;
+    for (const t of tokens)
+      if (nearestOther(t.rgb, t.name).dE < houseReference) houseUnder++;
+
+    let nearest = { dE: Infinity, i: -1, token: "" };
+    let underReference = 0;
+    for (const hand of hands) {
+      const best = nearestOther(hand.rgb);
+      if (best.dE < houseReference) underReference++;
+      if (best.dE < nearest.dE) nearest = { dE: best.dE, i: hand.i, token: best.token };
+    }
+    const houseShare = houseUnder / tokens.length;
+
+    // THE GROUNDS A DIGIT IS ACTUALLY PAINTED ON. The board sits on the card over the paper; the
+    // roster row sits in the controls card, which is the dock sheet's popover on a phone; the
+    // selection wash is the 8% crayon-blue a digit reads against on your own selected cell; the
+    // TAPE is the washi the fold's attribution rides (`--sheet-washi-neutral`); and the LAMINATE
+    // is the armed-hint ground under the same digit. The laminate is REPORTED: it is the fold's
+    // surface. The tape is this family's since pass 4 — the name on it is written in the RING's
+    // string (`GameBoard.vue` .attribution-tape), and it is asserted below on its own rows.
+    const cardCssBase = cs.getPropertyValue("--color-card").trim();
+    const rgbOf = (v: number[]): string => `rgb(${v[0]},${v[1]},${v[2]})`;
+    const wash = paint(cardCssBase, cs.getPropertyValue("--color-crayon-blue").trim(), 0.08);
+    // THE TAPE IS TRANSLUCENT (0.82 light / 0.92 dark), so its ground is the mix COMPOSITED over
+    // the card it hangs above — `lint:ink`'s tape row's own model. Painted bare, the canvas keeps
+    // the tape's alpha and the ratio reads the tape's colour over nothing (pass 3's 2.813 did).
+    const tape = rgbOf(paint(cardCssBase, cs.getPropertyValue("--sheet-washi-neutral").trim(), 1));
+    // the armed-hint wash, as `gameCell.css:.cell-because` composes it: 15% teacher-red on the card.
+    const laminate = rgbOf(
+      paint(cardCssBase, cs.getPropertyValue("--color-teacher-red").trim(), 0.15),
+    );
+    const grounds: Record<string, string> = {
+      background: cs.getPropertyValue("--color-background").trim(),
+      card: cardCssBase,
+      popover: cs.getPropertyValue("--color-popover").trim(),
+      "selection-wash": rgbOf(wash),
+    };
+    const reported: Record<string, string> = {
+      "laminate (reported)": laminate || cardCssBase,
+      "accent (watched, not a ground)": cs.getPropertyValue("--color-accent").trim(),
+    };
+    const aa: Reading["aa"] = [];
+    for (const [name, gcss] of Object.entries({ ...grounds, ...reported })) {
+      if (!gcss) continue;
+      const bg = paint(gcss, "rgba(0,0,0,0)", 0);
+      let worst = { ratio: Infinity, i: -1, ground: name };
+      for (const hand of hands) {
+        const r = ratio(paint(gcss, inks[hand.i], 1), bg);
+        if (r < worst.ratio) worst = { ratio: r, i: hand.i, ground: name };
+      }
+      aa.push(worst);
+    }
+    // THE NAME ON THE TAPE, two ways: the ring's string (what ships — the hand pressed harder)
+    // and the digit's string (the other arm of this family's ballot). HEAD's name is priced on
+    // PAINT against the control's own tree (§C's instrument), never as a band pinned here.
+    for (const [name, list] of [
+      ["tape · ring string (shipped)", rings],
+      ["tape · digit string (reported, ballot arm)", inks],
+    ] as [string, string[]][]) {
+      let worst = { ratio: Infinity, i: -1, ground: name };
+      list.forEach((css, i) => {
+        const r = ratio(paint(tape, css, 1), paint(tape, "rgba(0,0,0,0)", 0));
+        if (r < worst.ratio) worst = { ratio: r, i, ground: name };
+      });
+      aa.push(worst);
+    }
+
+    // THE RING against its OWN fill, the thing a reader actually has to see it against — the 4%
+    // wash of the same ink inside the same cell. Priced at the band the sheet ships (the pair is
+    // the chair's, registry §2.4), and on the phone's popover ground as well as the card.
+    const cardCss = grounds.card || grounds.background;
+    const ringAt = (band: string, alpha = ringGeom.alpha) => {
+      const swap = (s: string): string => s.replace(ringBandNow, band);
+      let worst = { r: Infinity, i: -1 };
+      let onPopover = Infinity;
+      let minC = Infinity;
+      for (const hand of hands) {
+        const ringCss = swap(rings[hand.i]);
+        minC = Math.min(minC, chromaOf(paint("#808080", ringCss, 1)));
+        for (const [ground, keep] of [
+          [cardCss, true],
+          [grounds.popover, false],
+        ] as [string, boolean][]) {
+          const fill = paint(ground, ringCss, ringGeom.fill);
+          const stroke = paint(rgbOf(fill), ringCss, alpha);
+          const r = ratio(stroke, fill);
+          if (keep) {
+            if (r < worst.r) worst = { r, i: hand.i };
+          } else onPopover = Math.min(onPopover, r);
+        }
+      }
+      return { worst: worst.r, i: worst.i, onPopover, minC };
+    };
+    const ringArithmetic: Reading["ringArithmetic"] = {};
+    ringArithmetic[ringBandNow] = ringAt(ringBandNow);
+    // §6's candidates (chair §4 / registry §6.5): which of 0.55 / 0.65 / 0.80 the walk's ring
+    // survives at the SHIPPED band. Reported; `join-language-prm:153` keeps 0.55.
+    const ringAlpha: Reading["ringAlpha"] = {};
+    for (const a of [0.55, 0.65, 0.8]) ringAlpha[String(a)] = ringAt(ringBandNow, a).worst;
+
+    // THE DIGIT INSIDE ITS OWN RING — same hue, two bands, on one fill. Priced, not asserted:
+    // the two never touch (the fill runs between them; the gap is read in §B), so 1.4.11's
+    // adjacency is the ring against its fill and the card, which rows 4 and §B hold.
+    let digitVsRing = { ratio: Infinity, i: -1 };
+    for (const hand of hands) {
+      const fill = paint(cardCss, rings[hand.i], ringGeom.fill);
+      const stroke = paint(rgbOf(fill), rings[hand.i], ringGeom.alpha);
+      const r = ratio(paint(rgbOf(fill), inks[hand.i], 1), stroke);
+      if (r < digitVsRing.ratio) digitVsRing = { ratio: r, i: hand.i };
+    }
+
+    // THE OPACITY AXIS ALONE (§6's question): with no ring band, how much alpha would the ring
+    // need? Reported, never asserted — `join-language-prm:153` holds the shipped 0.55.
+    let first: number | null = null;
+    let under065 = 0;
+    for (let a = 0.5; a <= 1.0001; a += 0.01) {
+      let ok = true;
+      let count = 0;
+      for (const hand of hands) {
+        const fill = paint(cardCss, inks[hand.i], ringGeom.fill);
+        const stroke = paint(rgbOf(fill), inks[hand.i], a);
+        if (ratio(stroke, fill) < 3) {
+          ok = false;
+          count++;
+        }
+      }
+      if (Math.abs(a - 0.65) < 0.005) under065 = count;
+      if (ok && first === null) first = Math.round(a * 100) / 100;
+    }
+
+    const peerVsPeer: Record<string, number> = {};
+    for (const n of [2, 3, 4, 5, 8, 16]) {
+      let min = Infinity;
+      for (let i = 0; i < n; i++)
+        for (let k = i + 1; k < n; k++)
+          min = Math.min(min, dE(hands[i].rgb, hands[k].rgb));
+      peerVsPeer[String(n)] = min;
+    }
+    return {
+      band,
+      ringBand: ringBandNow,
+      ring: ringGeom,
+      hands,
+      nearest,
+      houseReference,
+      underReference,
+      houseShare,
+      houseTokens: tokens.length,
+      aa,
+      ringArithmetic,
+      arcs,
+      ringAlpha,
+      digitVsRing,
+      alphaOnly: { first, under065 },
+      peerVsPeer,
+    };
+  });
+  await seatCursor(page, null);
+  return out;
+}
+
+/** The ring OFF: its one path hidden on the seated cell (the fill rides the same path). */
+const RING_OFF = ".game-cell.is-peer-cursor .cell-ghost-path { visibility: hidden !important; }";
+
+/** MRK-ABS's `isTheRing`, on this family's subject: two photographs of one cell, the CHANGED
+ *  pixels are the ring and its fill, and the stroke's median is verified against what the
+ *  cascade says it should composite to before any number is believed. */
+async function paintedRing(
+  page: Page,
+  index: number,
+): Promise<{
+  isTheRing: boolean;
+  deltaToComputed: number;
+  ratio: number;
+  ink: number[];
+  fill: number[];
+  samples: number;
+  sensitivity: string;
+  /** THE SECTION'S STATISTIC: the core distribution against the ring's own fill. */
+  core: { px: number; max: number; p30: number; median: number; under3: number; noise: number };
+  where: string;
+}> {
+  const box = await page.locator(".game-cell").nth(40).boundingBox();
+  if (!box) throw new Error("cell 40 has no box");
+  const clip = {
+    x: Math.floor(box.x - 6),
+    y: Math.floor(box.y - 6),
+    width: Math.ceil(box.width + 12),
+    height: Math.ceil(box.height + 12),
+  };
+  await seatCursor(page, index);
+  // WHERE THE LINE IS, in the page's own coordinates. `getBoundingClientRect` on an SVG path
+  // includes half the stroke on each edge, so the centreline sits one half-stroke in — and that
+  // is the only place a 1.89px anti-aliased line is actually its own colour. Sampling by "the
+  // deepest pixels that changed" reads the glyph instead, which is the first thing this probe
+  // did and the reason it is written this way.
+  const geom = await page.evaluate(() => {
+    const path = document.querySelector(
+      ".game-cell.is-peer-cursor .cell-ghost-path",
+    ) as SVGGraphicsElement;
+    const r = path.getBoundingClientRect();
+    const bb = path.getBBox();
+    const w = parseFloat(getComputedStyle(path).strokeWidth);
+    const scale = r.width / (bb.width + w);
+    return { x: r.x, y: r.y, w: r.width, h: r.height, stroke: w * scale };
+  });
+  const expected = await page.evaluate(() => {
+    const path = document.querySelector(".game-cell.is-peer-cursor .cell-ghost-path")!;
+    const ps = getComputedStyle(path);
+    const cell = document.querySelectorAll<HTMLElement>(".game-cell")[40];
+    const c = document.createElement("canvas");
+    c.width = c.height = 1;
+    const g = c.getContext("2d", { willReadFrequently: true })!;
+    const lay = (ground: string, css: string, a: number): number[] => {
+      g.globalAlpha = 1;
+      g.globalCompositeOperation = "copy";
+      g.fillStyle = ground;
+      g.fillRect(0, 0, 1, 1);
+      g.globalCompositeOperation = "source-over";
+      g.globalAlpha = a;
+      g.fillStyle = css;
+      g.fillRect(0, 0, 1, 1);
+      const d = g.getImageData(0, 0, 1, 1).data;
+      return [d[0], d[1], d[2]];
+    };
+    const ink = getComputedStyle(cell).getPropertyValue("--color-peer-cursor-ink").trim();
+    const ground = getComputedStyle(document.documentElement)
+      .getPropertyValue("--color-card")
+      .trim();
+    const fill = lay(ground, ink, Number(ps.fillOpacity));
+    const stroke = lay(`rgb(${fill[0]},${fill[1]},${fill[2]})`, ink, Number(ps.strokeOpacity));
+    return { fill, stroke };
+  });
+  // ON = the ringed cell, OFF = the same cell with the ring's path hidden (paint-lib's `onOff`).
+  // A SECOND OFF PHOTOGRAPH, so a pixel the grid's boil repainted between the two is named and
+  // dropped rather than read as ring: noise is what differs between two photographs of the
+  // same unringed cell.
+  const first = await onOff(page, clip, RING_OFF);
+  const second = await onOff(page, clip, RING_OFF);
+  await seatCursor(page, null);
+  const [A, B, C] = [first.off, first.on, second.off];
+
+  const dpr = A.w / clip.width;
+  const at = (I: typeof A, x: number, y: number): number[] => {
+    const px = Math.round((x - clip.x) * dpr);
+    const py = Math.round((y - clip.y) * dpr);
+    if (px < 0 || py < 0 || px >= I.w || py >= I.h) return [];
+    const i = (py * I.w + px) * 3;
+    return [I.data[i], I.data[i + 1], I.data[i + 2]];
+  };
+  const dist = (a: number[], b: number[]): number =>
+    Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);
+  const med = (v: number[]): number => v.slice().sort((p, q) => p - q)[v.length >> 1];
+  /** WHERE THE LINE ACTUALLY IS. The ghost path is HAND-DRAWN — it wobbles off the bounding box
+   *  by a pixel or three — so each sample is a perpendicular scan inward from the edge and the
+   *  pixel that CHANGED MOST is the line. A fixed inset finds paper most of the time, which is
+   *  the second thing this probe got wrong. */
+  const REACH = Math.max(6, geom.stroke * 3);
+  const strokePx: number[][] = [];
+  const rayRuns: { d: number; px: number[] }[][] = [];
+  for (let k = 1; k < 12; k++) {
+    const tx = geom.x + (geom.w * k) / 12;
+    const ty = geom.y + (geom.h * k) / 12;
+    const rays: [number, number, number, number][] = [
+      [tx, geom.y, 0, 1],
+      [tx, geom.y + geom.h, 0, -1],
+      [geom.x, ty, 1, 0],
+      [geom.x + geom.w, ty, -1, 0],
+    ];
+    for (const [ox, oy, dx, dy] of rays) {
+      let best = { d: 0, px: [] as number[] };
+      const run: { d: number; px: number[] }[] = [];
+      for (let t = -1; t <= REACH; t += 0.5) {
+        const a = at(A, ox + dx * t, oy + dy * t);
+        const b = at(B, ox + dx * t, oy + dy * t);
+        if (!a.length || !b.length) continue;
+        const d = dist(a, b);
+        run.push({ d, px: b });
+        if (d > best.d) best = { d, px: b };
+      }
+      rayRuns.push(run);
+      // A ray keeps its deepest change UNLESS that pixel is nowhere near the line's own colour:
+      // the grid boil repaints between the two photographs, and a moved graphite stroke is a
+      // bigger change than the ring is. An outlier is dropped, never replaced — if the ring did
+      // not paint, no ray survives and `isTheRing` says so.
+      if (best.d > 8 && dist(best.px, expected.stroke) < 48) strokePx.push(best.px);
+    }
+  }
+  /** The 4% fill, read a third of a cell in from every edge — inside the line, outside the glyph
+   *  (a digit is centred), and the median throws away anything that is neither. */
+  const fillSamples: number[][] = [];
+  for (const [fx, fy] of [
+    [0.3, 0.2],
+    [0.7, 0.2],
+    [0.2, 0.3],
+    [0.8, 0.3],
+    [0.2, 0.7],
+    [0.8, 0.7],
+    [0.3, 0.8],
+    [0.7, 0.8],
+  ]) {
+    const b = at(B, geom.x + geom.w * fx, geom.y + geom.h * fy);
+    if (b.length) fillSamples.push(b);
+  }
+  const changed = { length: strokePx.length + fillSamples.length };
+  const none = { px: 0, max: 0, p30: 0, median: 0, under3: 1, noise: 0 };
+  if (strokePx.length < 8 || !fillSamples.length)
+    return {
+      isTheRing: false,
+      deltaToComputed: Infinity,
+      ratio: 0,
+      ink: [],
+      fill: [],
+      samples: 0,
+      sensitivity: "",
+      core: none,
+      where: `clip ${clip.x},${clip.y} ${clip.width}x${clip.height} raster ${A.w}x${A.h} path ${geom.x.toFixed(1)},${geom.y.toFixed(1)} ${geom.w.toFixed(1)}x${geom.h.toFixed(1)} stroke ${geom.stroke.toFixed(2)} lines ${strokePx.length} fills ${fillSamples.length}`,
+    };
+  const inkPx = [0, 1, 2].map((c) => med(strokePx.map((p) => p[c])));
+  const fillPx = [0, 1, 2].map((c) => med(fillSamples.map((p) => p[c])));
+  const lum = (p: number[]): number => lumAt(p, 0);
+  const delta = dist(inkPx, expected.stroke);
+  // THE THRESHOLD-SENSITIVITY ROW (LAWS §Gates). The core is each scan's deepest change; a line
+  // 1.9px wide has flanks, and a reader sees those too. Per scan, the FAINTEST pixel still
+  // counted as line at 50/70/90/100% of the median core change; the worst scan and the share of
+  // scans under 3.0 at each. Printed beside the core, never asserted: the flank of any
+  // anti-aliased stroke reads under its core, and pricing it is the point.
+  const rat = (p: number[]): number => wcag(lum(p), lum(fillPx));
+  const M = med(rayRuns.map((r) => Math.max(0, ...r.map((q) => q.d))));
+  const sens = [0.5, 0.7, 0.9, 1.0].map((x) => {
+    const per = rayRuns
+      .map((r) => r.filter((q) => q.d >= x * M && dist(q.px, expected.stroke) < 64))
+      .filter((c) => c.length)
+      .map((c) => Math.min(...c.map((q) => rat(q.px))));
+    return `${Math.round(x * 100)}%: worst ${per.length ? Math.min(...per).toFixed(3) : "—"} · ${per.filter((v) => v < 3).length}/${per.length} under 3`;
+  });
+  // THE CORE DISTRIBUTION (registry-v4 §2.4 — PAL-TIN's critic's statistic, adopted by the
+  // chair). Ring-OFF subtracted: every pixel of the clip that the ring moved, the move being the
+  // sum of channel differences between the unringed and the ringed photograph; the CORE is every
+  // pixel moved at ≥ 50 % of the most-moved one, each read against the ring's own fill. The
+  // median of that is the number the pair is pinned on, and the max / p30 / fraction under 3.0
+  // travel with it so a best pixel can never stand in for the line.
+  const moved: number[] = [];
+  let top = 0;
+  let noise = 0;
+  const px4 = (I: typeof A, k: number): number[] => [I.data[k], I.data[k + 1], I.data[k + 2]];
+  for (let k = 0; k < B.data.length; k += 3) {
+    const a = px4(A, k);
+    if (dist(a, px4(C, k)) > 8) {
+      noise++;
+      continue;
+    }
+    const d = Math.abs(a[0] - B.data[k]) + Math.abs(a[1] - B.data[k + 1]) + Math.abs(a[2] - B.data[k + 2]);
+    moved.push(d, k);
+    if (d > top) top = d;
+  }
+  const coreR: number[] = [];
+  for (let n = 0; n < moved.length; n += 2)
+    if (moved[n] >= 0.5 * top) coreR.push(rat(px4(B, moved[n + 1])));
+  coreR.sort((p, q) => p - q);
+  const q = (f: number): number => coreR[Math.min(coreR.length - 1, Math.floor(coreR.length * f))];
+  const core = coreR.length
+    ? {
+        px: coreR.length,
+        max: coreR[coreR.length - 1],
+        p30: q(0.3),
+        median: q(0.5),
+        under3: coreR.filter((v) => v < 3).length / coreR.length,
+        noise,
+      }
+    : none;
+  return {
+    isTheRing: delta <= 24,
+    deltaToComputed: delta,
+    ratio: wcag(lum(inkPx), lum(fillPx)),
+    ink: inkPx,
+    fill: fillPx,
+    samples: changed.length,
+    sensitivity: sens.join(" | "),
+    core,
+    where: `path ${geom.w.toFixed(1)}x${geom.h.toFixed(1)} stroke ${geom.stroke.toFixed(2)}px · ink ${inkPx.join(",")} vs computed ${expected.stroke.join(",")} · fill ${fillPx.join(",")} vs computed ${expected.fill.join(",")}`,
+  };
+}
+
+test("§A the painted law — no hand is a house colour, and the ring is priced at both bands", async ({
+  page,
+}, info) => {
+  await page.goto(SOLO);
+  await settled(page);
+  for (const arm of ["light", "dark"] as const) {
+    await theme(page, arm);
+    const r = await read(page);
+    const say = (s: string): void => console.log(`[${info.project.name}/${arm}] ${s}`);
+    say(`band ${r.band} · ring band ${r.ringBand} · ring drawn at alpha ${r.ring.alpha}, fill ${r.ring.fill}, width ${r.ring.width}`);
+    say(`nearest token ${r.nearest.token} ΔE ${r.nearest.dE.toFixed(4)} at i=${r.nearest.i}`);
+    say(
+      `crayon reference (re-derived) ${r.houseReference.toFixed(6)} · hands under it ${r.underReference}/144 = ${(r.underReference / 144).toFixed(4)} · the house crowds itself ${(r.houseShare * 100).toFixed(1)}% of ${r.houseTokens} tokens`,
+    );
+
+    // 0 — the ring's geometry is the cascade's and this file asserts what it READ, which is the
+    // one way a literal cannot rot here. §6 owns the value; this row simply refuses to guess it.
+    expect(r.ring.alpha).toBeCloseTo(0.55, 5);
+    expect(r.ring.fill).toBeCloseTo(0.04, 5);
+
+    // 1 — THE LAW, in the only units it is felt in, on two floors. The ABSOLUTE one is the
+    // family's own claim (no hand nearer a house ink than 0.07); the RATIO is the estate's claim
+    // about itself, and it moves when the estate does.
+    expect(r.nearest.dE).toBeGreaterThanOrEqual(0.07);
+    expect(r.underReference / 144).toBeLessThanOrEqual(r.houseShare);
+
+    // 2 — no two hands paint the same bytes over the first 16, 24 and 40.
+    for (const n of [16, 24, 40]) {
+      const bytes = r.hands.slice(0, n).map((h) => h.rgb.join(","));
+      expect(new Set(bytes).size, `${n} hands, ${arm}`).toBe(n);
+    }
+
+    // 3 — AA on the grounds a player's words are painted on, worst of 144. A digit is text, and
+    // so is the name on the tape (in the ring's string). The laminate and the accent are PRINTED
+    // and not asserted: the laminate is the fold's surface, and the accent is a coupling for any
+    // future wave that paints a slug on a chip.
+    for (const w of r.aa) {
+      say(`AA ${w.ground}: worst ${w.ratio.toFixed(3)}:1 at i=${w.i}`);
+      if (!/reported|watched/.test(w.ground)) expect(w.ratio).toBeGreaterThanOrEqual(4.5);
+    }
+
+    // 4 — the ring by arithmetic at the shipped band, and the minimum chroma it spends.
+    for (const [b, v] of Object.entries(r.ringArithmetic))
+      say(
+        `ring band ${b}: worst ${v.worst.toFixed(3)}:1 at i=${v.i} · on popover ${v.onPopover.toFixed(3)}:1 · min ring chroma ${v.minC.toFixed(4)}`,
+      );
+    say(
+      `opacity alone would need alpha ≥ ${r.alphaOnly.first ?? "none ≤ 1.0"}; at 0.65, ${r.alphaOnly.under065}/144 are under 3:1`,
+    );
+    expect(r.ringArithmetic[r.ringBand].worst).toBeGreaterThanOrEqual(3);
+    say(
+      `§6 candidates at the shipped band: ${Object.entries(r.ringAlpha)
+        .map(([a, v]) => `α ${a} → ${v.toFixed(3)}`)
+        .join(" · ")} · digit vs its own ring ${r.digitVsRing.ratio.toFixed(3)}:1 at i=${r.digitVsRing.i} (priced, not asserted)`,
+    );
+
+    // 4b — THE LAW IN DEGREES, painted, on BOTH strings. The floor is the family law's 12°, not
+    // the arcs' 13°: the extra degree is the rounding margin, and this row is where the margin is
+    // tested rather than trusted. The drift is printed so the budget in `playerIdentity.ts`'s
+    // header is re-derived from the string that rounds worst, which is the ring.
+    for (const key of ["digit", "ring"] as const) {
+      const a = r.arcs[key];
+      say(
+        `${key} painted hue: nearest house token ${a.token} ${a.sep.toFixed(3)}° at i=${a.i} · worst drift from the asked hue ${a.drift.toFixed(3)}° at i=${a.driftAt}`,
+      );
+      expect(a.sep, `${key}: a painted hue inside the law's 12°, ${arm}`).toBeGreaterThanOrEqual(12);
+    }
+
+    // 5 — THE CAPACITY, painted and pinned to what it is rather than what would be nicer.
+    say(
+      `peer-vs-peer ${[2, 3, 4, 5, 8, 16].map((n) => `N=${n} ${r.peerVsPeer[String(n)].toFixed(4)}`).join(" · ")}`,
+    );
+    expect(r.peerVsPeer["4"]).toBeGreaterThan(0.05);
+    expect(r.peerVsPeer["8"]).toBeLessThan(0.05);
+    expect(r.peerVsPeer["16"]).toBeLessThan(0.02);
+  }
+  await page.evaluate(() => document.documentElement.classList.remove("dark"));
+});
+
+test("§B the ring, photographed — the line the product actually draws", async ({ page }, info) => {
+  await page.goto(SOLO);
+  await settled(page);
+  // THE BOIL PARKS AT IDLE, and until it does the two photographs differ everywhere the grid is.
+  // One wait, once, before any of them — not a per-shot sleep.
+  await page.waitForTimeout(2500);
+  const dpr = await page.evaluate(() => window.devicePixelRatio);
+  // The hands the CORE MEDIAN finds hardest over all 144 at the chair's pair (the pass-5 sweep):
+  // light i=6 / 95 (3.133), dark i=86 / 89 / 5 (3.341–3.348) — five per arm, both arms.
+  //
+  // THE ROW'S SCOPE, SAID: five hands per arm on every run; `WALK_SWEEP=1` photographs all 144
+  // (≈10 min an engine per density) and is how the five are re-chosen — pass 5 ran it at dpr
+  // 1/2/3: `evidence/w7/loop/pass5/prototype/PAL-WALK/`.
+  const HANDS = [5, 6, 86, 89, 95];
+  for (const arm of ["light", "dark"] as const) {
+    await theme(page, arm);
+    const shipped = await page.evaluate(() =>
+      getComputedStyle(document.documentElement).getPropertyValue("--peer-ring-l").trim(),
+    );
+    const sweep = !!process.env.WALK_SWEEP;
+    for (const i of sweep ? Array.from({ length: 144 }, (_, k) => k) : HANDS) {
+      const p = await paintedRing(page, i);
+      const c = p.core;
+      console.log(
+        `[${info.project.name}/${arm}] dpr ${dpr} band ${shipped} i=${i}: ` +
+          `isTheRing ${p.isTheRing} (Δ to computed ${p.deltaToComputed.toFixed(1)}) · ` +
+          `CORE px ${c.px} max ${c.max.toFixed(3)} p30 ${c.p30.toFixed(3)} median ${c.median.toFixed(3)} ` +
+          `frac<3 ${(c.under3 * 100).toFixed(1)}% noise ${c.noise} · scan core ${p.ratio.toFixed(3)} · ` +
+          `sensitivity ${p.sensitivity} · ${p.where}`,
+      );
+      expect(p.isTheRing, `the sampler found the ring, ${arm} i=${i}`).toBe(true);
+      expect(c.median, `painted ring core median, ${arm} i=${i}, dpr ${dpr}`).toBeGreaterThanOrEqual(
+        CORE_FLOOR,
+      );
+    }
+    // THE EDGE, through the ONE four-band probe (LAWS P7 §E (ii), P8 §E, the probe's defaults —
+    // no parameter chosen here): per band, the ring's core against the ring OFF (B2), its painted
+    // depth against the RING floor 2 × 0.9 css px (B3, the per-band thickness clause), no holes
+    // (B4), no side thin among thick ones (B6). The 1 px ring and a faded stroke are planted IN
+    // THIS RUN and each must RED. The hand is the arm's hardest by core median (pass-5 sweep).
+    {
+      const hand = arm === "light" ? 6 : 86;
+      const edge = ".game-cell.is-peer-cursor .cell-ghost-path";
+      const P = EDGE_PLANTS(edge);
+      await seatCursor(page, hand);
+      // The subject IS the ring's path: it sits 8 css px inside the cell's box (a cell-box strip
+      // of 8 px misses the left side whole), so the bands are cut around the line itself.
+      const r = await edgeGate(page, {
+        subject: edge,
+        edge,
+        plants: { THIN_1PX: P.THIN_1PX, STROKE_OPACITY015: P.STROKE_OPACITY015 },
+      });
+      await seatCursor(page, null);
+      const tag = `[${info.project.name}/${arm}] dpr ${dpr} EDGE i=${hand}`;
+      console.log(`${tag} clean ${r.clean.red ? "RED" : "GREEN"} ${edgeFmt(r.clean)}`);
+      for (const [k, v] of Object.entries(r.plants))
+        console.log(`${tag} plant ${k} ${v.red ? "RED" : "GREEN (a hole)"} ${edgeFmt(v)}`);
+      expect(r.clean.why, `the ring's four bands, ${arm} i=${hand}, dpr ${dpr}`).toEqual([]);
+      for (const [k, v] of Object.entries(r.plants))
+        expect(v.red, `edge plant ${k} RED, ${arm} i=${hand}, dpr ${dpr}`).toBe(true);
+    }
+  }
+  await page.evaluate(() => document.documentElement.classList.remove("dark"));
+});
+
+/**
+ * §C · THE NAME ON THE TAPE, PAINTED — read by the estate's ONE glyph-population probe
+ * (`./lib/glyph-pop.mjs`, registry-v7 §2.4). This spec carried its own copy of the probe through
+ * pass 7; the copy POOLED its G3 bound over both payloads, and the pooled bound is what let a
+ * WebKit 65 % fill fade read green (0.271 against 0.279, where the per-read bound is 0.259). The
+ * copy is deleted: every clause below is the probe's, bounded PER READ (`glyphGate`).
+ *
+ * The probe photographs the label ON and with its text made transparent, twice each, keeps only
+ * the pixels stable across both pairs and inside the TEXT RUN (text nodes only), and reads each as
+ * its painted pixel against its own painted ground (grid line, digit, tape paper and all):
+ *   G1  the population is ≥ 40 px (an empty or thin name is RED);
+ *   G2  the population's median ≥ 4.5 — ABSOLUTE. The one exemption is NAMED, not derived:
+ *       chromium at DPR 1 paints a 13 px hand's whole population under 4.5 on every arm read
+ *       (this tree, HEAD's same-index ink, the pass-6 ring string alike), which is the estate's
+ *       tag-rung row LEDGER T9-R8 — there G2 is PRINTED and cited, and every other clause holds;
+ *   G3  the fraction under 4.5 ≤ this read's own clean fraction + 0.05 (per read, never pooled);
+ *   G4  every x-column's p95 ≥ max(3.0, 0.4 × the whole p95), the column count scaled to the ink,
+ *       read aligned and half-shifted; G5 the same per character.
+ * And B-TAPE's clause: the name's median never loses to HEAD's SAME-INDEX ink (`oklch(0.5|0.8 0.11
+ * i × 137.5°)`, LAWS P7 §G) painted on the same label, paper and cell.
+ *
+ * TWO SUBJECTS (registry-v7 §2.13d): B's name read on A's page (index 1), and A's name — the
+ * HOST's, hand 0, the name every joiner reads — on B's page. Every id on both pages is PINNED
+ * (LAWS P7 §C), so each name is one word per payload in both engines.
+ */
+
+type Pop = {
+  red: boolean;
+  why: string[];
+  population: number;
+  coreMedian: number;
+  fracUnder: number;
+};
+type Gate = { bound: number | null; clean: Pop; plants: Record<string, Pop> };
+
+const TAPE = ".attribution-tape .washi-label";
+/** B's pinned ids (two payloads: a 15-letter name and a 25-letter one) and A's, the host's. */
+const NAME_IDS = ["p-0000000b0b0b", "p-00000000002e"];
+const A_ID = "p-0000000a0a0a";
+/** HEAD's ink for index i (`74a2b5d9`'s `inkFor`: hue i × 137.5°, chroma 0.11, band 0.5 / 0.8). */
+const HEAD_INK = (i: number, arm: "light" | "dark"): string =>
+  `oklch(${arm === "light" ? 0.5 : 0.8} 0.11 ${((i * 137.5) % 360).toFixed(2)}deg)`;
+/** G2's named rung cells (LEDGER T9-R8): engine/DPR. */
+const G2_RUNG = new Set(["chromium/1"]);
+const FILL = (ink: string, p: number): string =>
+  `${TAPE} { -webkit-text-fill-color: color-mix(in srgb, ${ink} ${p}%, transparent) !important; }`;
+/** THE PLANTS, each required RED: the probe's own set (FAINT30, FADE65, FADE80 on the fill; TAIL12,
+ *  TAIL35, HEAD12, MID20 as run masks at 25 %; EMPTY) plus the fades keyed on the name's own var
+ *  (`color` stays green either way). WEBKIT PAINTS AN 80 % FILL AS NO FADE on this label (its core
+ *  reads ×0.97–1.00 in both readers): FADE80 and its twin are PRINTED in WebKit. FADE65 is REQUIRED
+ *  in WebKit at DPR 2 (registry-v7 §2.13h — the per-read bound reds it there) and at DPR 1 (pass 8:
+ *  RED 8/8 on G3 per read), planted at EVERY cell of BOTH payloads (pass 9); DPR 3 prints it. PAPER
+ *  (the washi back to translucent) is printed: the occlusion arm, which no clause reads. */
+const PLANTS = (): Record<string, string | { mask: [number, number] }> => ({
+  ...TEXT_PLANTS(TAPE),
+  FAINT30v_fill: FILL("var(--color-peer-name-ink)", 30),
+  FADE65v_fill: FILL("var(--color-peer-name-ink)", 65),
+  FADE80v_fill: FILL("var(--color-peer-name-ink)", 80),
+  PAPER: `${TAPE} { background: var(--sheet-washi-neutral) !important; }`,
+});
+const printedPlant = (name: string, project: string, dpr: string): boolean =>
+  name === "PAPER" ||
+  (project === "webkit" && (/^FADE80/.test(name) || (/^FADE65/.test(name) && dpr === "3")));
+
+test("§C the name on the tape is written in its own string, and reads 4.5 on the ground it is painted on", async ({
+  browser,
+}, info) => {
+  for (const [n, id] of NAME_IDS.entries()) await nameOnTape(browser, id, info.project.name, n === 0);
+});
+
+async function nameOnTape(
+  browser: import("@playwright/test").Browser,
+  bId: string,
+  project: string,
+  planted: boolean,
+): Promise<void> {
+  // Two pages in ONE context, so `?wire=local`'s BroadcastChannel is the room — the product's own
+  // invite flow. FROZEN AT THE TEST (emulateMedia before goto): a boil between the photographs is a
+  // second variable; the tape, its paper and the name are not motion-gated.
+  const context = await browser.newContext();
+  const a = await context.newPage();
+  await a.emulateMedia({ reducedMotion: "reduce" });
+  await a.addInitScript((id) => {
+    // THE HOST'S PER-TAB IDENTITY MAP ANSWERS FOR THE ROOM THE ADDRESS BAR NAMES: the invite
+    // writes \`?s=\` synchronously before the page claims its id, so the claim reads this pin
+    // for the room it just opened and stays the room's author (its epoch, its hand 0).
+    const get = Storage.prototype.getItem;
+    Storage.prototype.getItem = function (k: string) {
+      const room = new URL(location.href).searchParams.get("s");
+      if (this === sessionStorage && k === "session-identity-v1" && room)
+        return JSON.stringify({ ...JSON.parse(get.call(this, k) || "{}"), [room]: id });
+      return get.call(this, k);
+    };
+  }, A_ID);
+  await a.goto(SOLO);
+  await settled(a);
+  const verb = a.locator('.controls-card button[aria-label="Play together on this board"]');
+  await expect(verb).toBeEnabled();
+  await verb.click();
+  await expect.poll(() => new URL(a.url()).searchParams.get("s")).not.toBeNull();
+  const room = new URL(a.url()).searchParams.get("s")!;
+  const b = await context.newPage();
+  await b.emulateMedia({ reducedMotion: "reduce" });
+  await b.addInitScript(
+    ([r, id]) => sessionStorage.setItem("session-identity-v1", JSON.stringify({ [r]: id })),
+    [room, bId] as const,
+  );
+  await b.goto(a.url());
+  await settled(b);
+  const inputs = (p: Page) => p.locator(".sudoku-cell input");
+  const board = (p: Page) =>
+    p.evaluate(() =>
+      [...document.querySelectorAll(".sudoku-cell input")]
+        .map((i) => (i as HTMLInputElement).value || ".")
+        .join(""),
+    );
+  expect(await board(a), "the encoded board decoded on A").toBe(GIVENS);
+  expect(await board(b), "the encoded board decoded on B").toBe(GIVENS);
+  const empty = [...GIVENS].flatMap((ch, i) => (ch === "." ? [i] : []));
+  const givenAbove = empty.filter((i) => i >= 9 && GIVENS[i - 9] !== ".");
+  const top = empty.filter((i) => i < 9);
+  // B writes three cells with a given above and the top row's one empty cell (pass 7's four); A
+  // (the host) writes the next two given-above cells. The deal has ONE empty top-row cell, so the
+  // flip below is read on B's subject only.
+  const cellsB = [...givenAbove.slice(0, 3), top[0]];
+  const cellsA = givenAbove.slice(3, 5);
+  expect(top.length, "the deal's empty top-row cells").toBe(1);
+  const write = async (p: Page, q: Page, cells: number[]) => {
+    await p.bringToFront();
+    for (const x of cells) {
+      await inputs(p).nth(x).click();
+      await inputs(p).nth(x).fill("7");
+      await expect.poll(() => inputs(q).nth(x).inputValue()).toBe("7");
+    }
+  };
+  await write(b, a, cellsB);
+  await write(a, b, cellsA);
+  // both cursors parked on a given, off every subject cell
+  await inputs(b).nth(GIVENS.indexOf("3")).click({ force: true });
+  await inputs(a).nth(GIVENS.indexOf("9")).click({ force: true });
+  await a.waitForTimeout(2500); // sleep-ok: the boil parks before a byte is read
+  const dpr = String(await a.evaluate(() => devicePixelRatio));
+  console.log(`[${project}/dpr${dpr}] room ${room}: A ${A_ID}, B ${bId}; B wrote ${cellsB.join(",")}, A wrote ${cellsA.join(",")}`);
+  const aSlug = await a.evaluate(async (id) => {
+    const served = "/src/games/shared/playerIdentity.ts";
+    const m = (await import(/* @vite-ignore */ served)) as {
+      slugFor: (p: string, t: ReadonlySet<string>) => string;
+    };
+    return m.slugFor(id, new Set());
+  }, A_ID);
+  for (const [page, cells, index, who] of [
+    [a, cellsB, 1, `B ${bId}`],
+    [b, cellsA, 0, `A ${A_ID} (hand 0, the host) on B's page`],
+  ] as const) {
+    // THE READ PAGE IS BROUGHT FORWARD: a page behind another in its context gets no rendering
+    // update, and every photograph below waits on two of them.
+    await page.bringToFront();
+    const label = page.locator(TAPE);
+    const hover = async (x: number) => {
+      // Re-made until the tape mounts: under load WebKit can drop the first pointer move.
+      await expect(async () => {
+        await page.mouse.move(2, 2);
+        await page.locator(".game-cell").nth(x).hover();
+        await expect(label).toBeVisible({ timeout: 3000 });
+      }).toPass({ timeout: 30000 });
+    };
+    const withCss = async (css: string, read: () => Promise<Pop>): Promise<Pop> => {
+      const tag = await page.addStyleTag({ content: css });
+      await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+      const t = await read();
+      await tag.evaluate((e) => (e as Element).remove());
+      await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+      return t;
+    };
+    const pop = async (): Promise<Pop> => (await glyphPopulation(page, { subject: TAPE })) as Pop;
+    for (const arm of ["light", "dark"] as const) {
+      await theme(page, arm);
+      for (const x of cells) {
+        await hover(x);
+        // The name string the cascade hands the tape, resolved OUTSIDE the product's DOM (LAWS P7
+        // §F: an e2e row never writes into a Vue-owned node): the token and its band read off the
+        // tape's own computed style, painted on a probe in <body>.
+        const own = await label.evaluate((l) => {
+          const cs = getComputedStyle(l);
+          const raw = cs.getPropertyValue("--color-peer-name-ink").trim();
+          const band = cs.getPropertyValue("--peer-name-l").trim();
+          const probe = document.createElement("span");
+          probe.style.color = raw.replace(/var\(\s*--peer-name-l\s*\)/g, band);
+          document.body.appendChild(probe);
+          const c = getComputedStyle(probe).color;
+          probe.remove();
+          return c;
+        });
+        const spec = await label.evaluate((l) => getComputedStyle(l).color);
+        const text = (await label.textContent())?.trim() ?? "";
+        const at = `[${project}/${arm}/dpr${dpr}] ${who} cell ${x}${x < 9 ? " (top row, below)" : " (given above)"} "${text}"`;
+        // The whole plant set on the first payload's first and last cell; FADE65 (the probe's and
+        // the name-var twin) at EVERY cell of BOTH payloads — the thinnest pass-8 margin sat at a
+        // cell that spec never planted (`…002e` cell 12, WebKit DPR 2, 0.001).
+        const full = planted && (x === cells[0] || x === cells[cells.length - 1]);
+        const P = PLANTS();
+        const g = (await glyphGate(page, {
+          subject: TAPE,
+          payload: `${who}/${arm}/cell${x}`,
+          plants: full ? P : { FADE65_fill: P.FADE65_fill, FADE65v_fill: P.FADE65v_fill },
+        })) as Gate;
+        const head = await withCss(`${TAPE} { color: ${HEAD_INK(index, arm)} !important; }`, pop);
+        const ring = await withCss(`${TAPE} { color: var(--color-peer-cursor-ink) !important; }`, pop);
+        const rung = G2_RUNG.has(`${project}/${dpr}`);
+        // ONE verdict for the clean read AND every plant: on the rung G2 is printed for both, so a
+        // plant never reds on the clause the clean read is already excused from (a plant red only
+        // by G2 at the rung would be a gate that cannot fail).
+        const verdict = (r: Pop): string[] => r.why.filter((w) => !(rung && /^G2/.test(w)));
+        const why = verdict(g.clean);
+        console.log(
+          `${at} name ${spec} · bound ${g.bound?.toFixed(3)} · ${popFmt(g.clean)}${rung && why.length !== g.clean.why.length ? " · G2 PRINTED (rung T9-R8)" : ""}\n` +
+            `${at} HEAD same-index ${HEAD_INK(index, arm)} · ${popFmt(head)}\n` +
+            `${at} ring string (pass 6) · ${popFmt(ring)}\n` +
+            `${at} B-TAPE name − HEAD = ${(g.clean.coreMedian - head.coreMedian).toFixed(3)}`,
+        );
+        expect(spec, "the tape writes the name string").toBe(own);
+        if (index === 0) expect(text, "the host's pinned name").toBe(aSlug);
+        expect.soft(why, `the name, ${who}, ${arm} cell ${x}`).toEqual([]);
+        expect
+          .soft(g.clean.coreMedian, `B-TAPE: the name against HEAD's same-index ink, ${who}, ${arm} cell ${x}`)
+          .toBeGreaterThanOrEqual(head.coreMedian);
+        for (const [name, r] of Object.entries(g.plants)) {
+          const required = !printedPlant(name, project, dpr);
+          console.log(
+            `${at} ${required ? "PLANT" : "READING"} ${name} · ${popFmt(r)} · median ×${(r.coreMedian / g.clean.coreMedian).toFixed(3)} · G3 margin ${g.bound === null ? "—" : (r.fracUnder - g.bound).toFixed(3)} → ${verdict(r).length ? `RED ${verdict(r).map((w) => w.split(" ")[0]).join("+")}` : required ? "GREEN (a hole)" : "GREEN"}`,
+          );
+          if (required) expect.soft(verdict(r).length, `plant ${name} reds the gate, ${who}, ${arm} cell ${x}`).toBeGreaterThan(0);
+        }
+        await page.mouse.move(2, 2);
+        await expect(label).toHaveCount(0);
+      }
+    }
+  }
+  await context.close();
+}
