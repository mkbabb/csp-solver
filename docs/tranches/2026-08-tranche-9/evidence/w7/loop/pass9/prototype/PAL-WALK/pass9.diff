+                kind: `${kind}-setProperty-param`,
+                prelude: "setProperty",
+                value: c.value,
+                line: L(c.at),
+              });
+        } else
+          push({
+            file,
+            kind: `${kind}-setProperty-computed`,
+            prelude: k,
+            value: v,
+            line: L(m.index),
