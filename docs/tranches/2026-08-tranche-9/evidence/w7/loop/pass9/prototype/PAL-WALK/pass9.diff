+    if (!ok) failures.push(`[SABOTAGE] deleting ${id} left the self-test green`);
+  }
+  console.log(`  SABOTAGE BATTERY ${bite}/${total} clauses bite`);
+}
+
+if (failures.length) {
+  console.error(`\n${failures.length} failure(s):\n`);
+  for (const f of failures) console.error(`  • ${f}\n`);
+  process.exit(1);
+}
+console.log(
+  `\nOK — the arcs playerIdentity.ts walks around are the arcs index.css actually reserves, the bands it bisects its chroma at are the bands the sheet paints, and every player's ink has one publisher.`,
+);
