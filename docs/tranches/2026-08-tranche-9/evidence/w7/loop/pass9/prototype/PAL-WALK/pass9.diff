+/** THE PER-PAYLOAD GATE (WALK W4): read the clean subject for THIS payload, bound G3 at its own
+ *  fraction + `slack`, then read every plant against that bound. `payload` names what the page holds
+ *  (a board, a deal, a peer id) and is REQUIRED — a bound is never pooled across payloads. */
+export async function glyphGate(page, { subject, payload, plants = null, slack = 0.05, img = null, control = null, ...opts }) {
+  if (!payload) throw new Error("glyphGate: `payload` is required (a G3 bound is per payload, never pooled)");
+  const first = await glyphPopulation(page, { subject, ...opts });
+  // anchor (the chair p9; COUNT gap 1 / LAWS P8 §F): with `control` — the CONTROL tree's read of the
+  // SAME payload ({fracUnder, g4Lows}) — G3 is bound at the control's fraction + slack and G4
+  // tolerates only the control's low columns; a bound cut from this run's own clean read cannot see a
+  // shipped regression (OPA80F: frac 1.000 against its own 1.050)
+  const ref = control && gOn("anchor") ? control : first;
+  const bound = boundOf(ref.fracUnder, slack, ref.population ?? Infinity, opts.minPop ?? 40);
+  opts = { ...opts, tolerate: control && gOn("anchor") ? (control.g4Lows ?? []) : opts.tolerate };
