+// shape-census.d.mts — the TYPES of the ONE browserless shape-census library (`./shape-census.mjs`), so a
+// TypeScript caller (`vite.config.ts`'s face-stamp, a `.spec.ts`) imports it strict. An ambient `declare
+// module` cannot name a relative path, so the declaration sits beside the module, as `e2e/lib/*.d.mts` do.
+// Every export is typed with its option names (LAWS P8 §I: never `[k: string]: unknown`); CTRL-FACE's
+// pass-8 narrow copy (`followImports`) is folded in.
+// NOT-A-LANE: the chair's home (T9-W7 pass 9, homes v2).
+
+/** The option bag every tree reader takes: an explicit file list (followed through `@import` and the
+ *  module graph) or the disk walk under `fe`; `read`/`exists`/`ls` swap the disk for a virtual tree. */
+export interface TreeOptions {
+  files?: string[];
+  read?: (f: string) => string;
+  exists?: (f: string) => boolean;
+  extra?: string[];
+}
+export type Ls = (dir: string) => { name: string; dir: boolean }[] | null;
+export interface Fixture {
+  fe: string;
+  files: string[];
+  read: (f: string) => string;
+  exists: (f: string) => boolean;
+  ls: Ls;
+}
+export interface Decl {
+  prop: string;
+  value: string;
+  important: boolean;
+  line: number;
+}
+export interface Rule {
+  ctx: string[];
+  prelude: string;
+  /** an at-rule's own declarations read as a selector (`@utility x` → `.x`, `@theme` → `:root`) */
+  as?: string;
+  decls: Decl[];
+  line: number;
+  kind?: string;
+}
+/** A declaration SITE: a stylesheet rule, a template attribute, a script write, a token publisher. */
+export interface Site {
+  file?: string;
+  kind?: string;
+  ctx?: string;
+  prelude?: string;
+  prop?: string;
+  value: string;
+  important?: boolean;
+  line: number;
+  varLed?: boolean;
+  /** the regimes it may hold in (media EVALUATED; a false @supports dead) */
+  regimes?: string[];
+  /** the regimes it is SURE to hold in (an unproven @supports or @ container query dead) */
+  sure?: string[];
+  unresolved?: boolean;
+  stem?: boolean | string | null;
+  bad?: boolean;
+}
+export interface SfcBlock {
+  attrs: string;
+  line: number;
+}
+export interface Sfc {
+  styles: (SfcBlock & { css: string })[];
+  scripts: (SfcBlock & { text: string })[];
+  template: { text: string; line: number } | null;
+}
+export interface TemplateElement {
+  i: number;
+  tag: string;
+  id: string | null;
+  /** every class it may carry (static `class=` and the literals of a `:class` binding) */
+  classes: Set<string>;
+  /** the static `class=` only: the classes it CERTAINLY carries */
+  sure: Set<string>;
+  dynClass: boolean;
+  attrs: Map<string, string | null>;
+  parent: number | null;
+  line: number;
+}
+export interface Regime {
+  width: number;
+  height: number;
+  pointer: "fine" | "coarse";
+  hover: "hover" | "none";
+  [feature: string]: string | number;
+}
+export interface Rgba {
+  rgb: [number, number, number];
+  a: number;
+}
+export interface Registration {
