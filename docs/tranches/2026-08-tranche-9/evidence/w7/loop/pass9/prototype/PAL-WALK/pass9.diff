+export function constBindings(js: string): Map<string, string>;
+export function foldConcat(
+  expr: string,
+  consts?: Map<string, string>,
+  o?: { hole?: string | null },
+): string | null;
+export function foldText(
+  js: string,
+  o?: { consts?: Map<string, string> | null; hole?: string },
+): string;
+
+// ── Tailwind, templates, scripts ────────────────────────────────────────────────────────────────
+export function twPalette(): Map<string, string>;
+export function TAILWIND_ALL(tw: string): [prop: string, value: string][];
+export function TAILWIND(tw: string): [prop: string, value: string][];
+export function candidates(classes: string): string[];
+export function attrsOf(attrText: string): { name: string; value: string | null }[];
+export function templateSites(tpl: string, cls: string, baseLine?: number): Site[];
+export function consumerSites(text: string): Site[];
+export function hasCompound(sels: string[], tail: string): boolean;
+export function scriptWrites(text: string, prop: string, baseLine?: number): Site[];
+export function classWrites(
+  text: string,
+  baseLine?: number,
+): (Site & { classes: string[] })[];
+export function scriptCss(js: string, baseLine?: number): Rule[];
+export function cssBlocks(
+  f: string,
+  text: string,
+  fe?: string,
+): { css: string; line: number; kind: string }[];
+export function rulesOf(f: string, text: string, fe?: string): Rule[];
+
+// ── the census, tokens, registrations ───────────────────────────────────────────────────────────
+export function census(fe: string, cls: string, prop: string, o?: TreeOptions): Site[];
+export function tokens(
+  fe: string,
+  o?: TreeOptions,
+): { map: Map<string, string>; all: Site[] };
+export function tokenConflicts(all: Site[]): { name: string; sites: Site[] }[];
+export function stemMatches(name: string, names: Iterable<string>): string[];
+export function resolve(
+  value: string,
+  map: Map<string, string>,
+  depth?: number,
+): string;
+export function varRefs(
+  value: string,
+  names?: string[],
+  o?: { values?: string[] },
+): {
