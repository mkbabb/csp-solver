index 00000000..77d5f5c5
--- /dev/null
+++ b/web/frontend/e2e/lib/edge-bands.mjs
@@ -0,0 +1,536 @@
+// edge-bands.mjs — THE four-band edge probe (T9-W7; registry-v6 §2.9, LAWS P6 §E, P7 §E; registry-v7
+// §2.4 PRODUCT HOME). "Existence is not visibility": a drawn-edge paint gate reads ALL FOUR BANDS (top,
+// right, bottom, left) against edge-OFF. A top-band-only row passed a clip-path that erased the bottom edge
+// (SELF's X6); a computed-style ring gate passed a 15 % ink (FACE); LIVE's ring stayed green at 0.15 (X4).
+//
+// The read, per band: a strip `out` px outside and `inn` px inside the subject's border box, photographed
+// ON and with the edge OFF (`<edge>, <edge> * { visibility: hidden }`, or the caller's `off` sheet — an
+// outline ring whose edge IS the subject turns only its outline colour off). A STATION is one DEVICE
+// column (top/bottom) or row (left/right) inside the middle `span` of the side (corners excluded, default
+// 10–90 %): STATION 1, estate-wide (pass8/CHAIR-RULINGS §2.7 — a stride that pools eight stations cannot
+// see a 1-in-8 dash). A station's value = the MAX over the strip's depth of contrast(ON pixel, OFF pixel).
+// A station where ON == OFF reads 1.00 and is COUNTED (a dropped station is a miss, never a skip).
+// Clauses (every one RED on breach):
+//   B0  the subject exists and is visible, and the edge selector matches ≥ 1 element
+//   B1  each band has ≥ 8 CSS px of stations (8 × DPR device stations; an EMPTY band is RED — at
+//       DPR 2 a 6 px side holds 10 device stations, so a device count let it through)
+//   B2  each band's core median ≥ `floor` (3.0)
+//   B3  THICKNESS (FACE; LAWS P7 §E): each band's median painted depth ≥ `thick` (2) css px ×
+//       `thickTol` (0.9). A station's depth = Σ over its pixels of |gON − gOFF| / |gINK − gOFF| (the
+//       coverage the ink paints there; gINK = the darkest-against-ground painted colour of an edge
+//       element meeting the strip — stroke, fill, outline, border, background — at its own alpha ×
+//       opacity chain to the edge root; the band's p99 |gON − gOFF| when none resolves), over the DPR.
+//       An `outline-width: 1px` ring read 4.289 GREEN on four bands without it.
+//   B4  HOLES (TAPE, CHAIR-RULINGS §2.7): the fraction of a band's stations reading ≤ 1.05 (dropped)
+//       ≤ `holes` (0.02); the hole runs and the longest run are printed (a notch is one run, a dash many)
+//   B6  RELATIVE BAND (the chair, pass 9; MRK-LIVE's FCSIDE, LAWS P8 §E per band): each band's painted
+//       depth ≥ `relBand` (0.5) × the deepest band's — one side drawn thin among thick ones reds even where
+//       it clears B3's absolute floor
+//   ownfill (the chair, pass 9; LAWS P8 §E "the depth statistic excludes the subject's own fill tint"):
+//       a pixel whose ON−OFF move is no more than the edge's own FILL tint explains (backgrounds, svg
+//       fills, × 1.25 + 1 grey level) is not edge ink and adds no depth (LIVE's tier 2 counted a 0.08 fill)
+//   B5  RELATIVE (RULE; LAWS P7 §E): with `above` (the previous ink's reading), each band's core median
+//       ≥ above × 1.02 — the reference ink replayed through stroke-opacity / path opacity / filter
+//       opacity() (INK_PLANTS) must red it
+// The legacy TOP-ONLY and STATION-8 (max-pool of eight stations) readings print beside, so the hole each
+// left is visible. `EDGE_SABOTAGE=B2,B3,…` switches clauses off (the clause-sabotage battery).
+//   node e2e/lib/edge-bands.mjs --self-test [--engine chromium|webkit] [--dprs 1,2]
+//   node e2e/lib/edge-bands.mjs --sabotage-battery [--engine chromium]
+//   node e2e/lib/edge-bands.mjs --url <u> --subject <sel> --edge <sel> [--off <css>] [--plants]
+//        [--scheme dark] [--dpr 2] [--viewport 1280x800] [--ready <sel>] [--hover <sel>] [--click <sel>]
+//        [--touch] [--prm 0] [--contrast more] [--above <n>] [--holes <f>] [--regimes all]
+// Exit: 0 clean GREEN and every plant RED · 1 clean RED · 3 a plant GREEN (a hole) · 4 both.
+import process from "node:process";
+import { fileURLToPath } from "node:url";
+import { resolve as resolvePath } from "node:path";
+import { onOff, lum, grey, ratio, median, quantile, settle, args, load, playwright, openCell, cellsOf } from "./paint-lib.mjs";
+
+export const EDGE_CLAUSES = ["B0", "B1", "B2", "B3", "B4", "B5", "B6", "ownfill"];
+const OFF_CLAUSES = new Set((process.env.EDGE_SABOTAGE ?? "").split(",").filter(Boolean));
+const on = (c) => !OFF_CLAUSES.has(c);
+
+/** Page-side: the painted inks of the edge elements (and descendants) whose box meets `strip`. */
+function edgeInks({ edge, strip }) {
+  const cv = document.createElement("canvas").getContext("2d");
+  const norm = (c) => {
+    if (!c || c === "none" || c.startsWith("url(")) return null;
+    cv.fillStyle = "#010203";
+    cv.fillStyle = c;
+    const s = cv.fillStyle;
+    if (s === "#010203" && !/^#010203$/i.test(c)) return null;
+    const m = s.match(/^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i);
+    if (m) return [parseInt(m[1], 16), parseInt(m[2], 16), parseInt(m[3], 16), 1];
+    const r = s.match(/rgba?\(([^)]+)\)/);
+    if (!r) return null;
+    const v = r[1].split(/[,\s/]+/).filter(Boolean).map(Number);
+    return [v[0], v[1], v[2], v[3] ?? 1];
+  };
+  const SHAPES = new Set(["path", "rect", "line", "polyline", "polygon", "circle", "ellipse", "use", "text"]);
+  const out = [],
+    fills = [];
+  for (const root of document.querySelectorAll(edge)) {
+    for (const el of [root, ...root.querySelectorAll("*")]) {
+      const b = el.getBoundingClientRect();
+      const grow = 12;
+      if (b.right + grow < strip.x || b.left - grow > strip.x + strip.width || b.bottom + grow < strip.y || b.top - grow > strip.y + strip.height) continue;
+      const cs = getComputedStyle(el);
+      if (cs.visibility === "hidden" || cs.display === "none") continue;
+      let alpha = 1;
+      for (let p = el; p; p = p.parentElement) {
+        const ps = getComputedStyle(p);
+        alpha *= +ps.opacity;
+        for (const m of ps.filter.matchAll(/opacity\(([\d.]+)(%?)\)/g)) alpha *= m[2] ? +m[1] / 100 : +m[1];
+        if (p === root) break;
+      }
+      const push = (c, a = 1, fill = false) => {
+        const n = norm(c);
+        if (!n || n[3] * a * alpha <= 0.02) return;
+        out.push([n[0], n[1], n[2], n[3] * a * alpha]);
+        // a FILL TINT (effective alpha ≤ 0.25; an opaque paper is ground, not tint) is also the ownfill floor
+        if (fill && n[3] * a * alpha <= 0.25) fills.push([n[0], n[1], n[2], n[3] * a * alpha]);
+      };
+      if (el instanceof SVGElement && SHAPES.has(el.tagName.toLowerCase())) {
+        if (cs.stroke !== "none" && parseFloat(cs.strokeWidth) > 0) push(cs.stroke, +cs.strokeOpacity);
+        push(cs.fill, +cs.fillOpacity, true);
+      } else if (!(el instanceof SVGElement)) {
+        if (cs.outlineStyle !== "none" && parseFloat(cs.outlineWidth) > 0) push(cs.outlineColor);
+        for (const s of ["Top", "Right", "Bottom", "Left"])
+          if (cs[`border${s}Style`] !== "none" && parseFloat(cs[`border${s}Width`]) > 0) push(cs[`border${s}Color`]);
+        push(cs.backgroundColor, 1, true);
+      }
+    }
+  }
+  return { inks: out, fills };
+}
+
+export async function fourBands(
+  page,
+  { subject, edge, off = null, out = 8, inn = 8, span = [0.1, 0.9], floor = 3.0, thick = 2, thickTol = 0.9, holes = 0.02, above = null, relBand = 0.5 },
+) {
+  const loc = page.locator(subject).first();
+  const vis = await loc.isVisible().catch(() => false);
+  const edgeCount = await page.locator(edge).count();
+  if (on("B0") && (!vis || edgeCount === 0))
+    return { red: true, why: [`B0 ${!vis ? `subject ${subject} not visible` : `edge ${edge} matches 0 elements`}`], bands: null, edgeCount };
+  if (!vis) return { red: false, why: [], bands: null, edgeCount };
+  const vw = page.viewportSize();
+  const dpr = await page.evaluate(() => devicePixelRatio);
+  const clamp = (c) => {
+    const x = Math.max(0, Math.floor(c.x)),
+      y = Math.max(0, Math.floor(c.y));
+    return { x, y, width: Math.max(1, Math.min(vw.width - x, Math.ceil(c.width))), height: Math.max(1, Math.min(vw.height - y, Math.ceil(c.height))) };
+  };
+  // Each band is photographed with ITS side scrolled into view (a subject taller than the viewport has
+  // its bottom band below the fold). A side still outside the viewport reads 0 stations → B1 RED.
+  const strip = (side, b) =>
+    side === "top"
+      ? { x: b.x, y: b.y - out, width: b.width, height: out + inn }
+      : side === "bottom"
+        ? { x: b.x, y: b.y + b.height - inn, width: b.width, height: out + inn }
+        : side === "left"
+          ? { x: b.x - out, y: b.y, width: out + inn, height: Math.min(b.height, vw.height) }
+          : { x: b.x + b.width - inn, y: b.y, width: out + inn, height: Math.min(b.height, vw.height) };
+  const offCss = off ?? `${edge}, ${edge} * { visibility: hidden !important; }`;
+  const bands = {};
+  const why = [];
+  let b0 = null;
+  const readBand = async (side, block) => {
+    await loc.evaluate((e, block) => e.scrollIntoView({ block, inline: "nearest" }), block);
+    await settle(page);
+    const b = await loc.boundingBox();
+    b0 ??= b;
+    const raw = strip(side, b);
+    const inView = raw.y + raw.height > 0 && raw.y < vw.height && raw.x + raw.width > 0 && raw.x < vw.width;
+    if (!inView) return { stations: 0, coreMedian: 0, fracUnder: 1, dropped: 0, pose: block, occluder: "viewport" };
+    // the OCCLUDER at the band's midpoint on the box edge (LAWS P5: name it); an ancestor is the ground
+    const occluder = await page.evaluate(
+      ({ x, y, sel, edge }) => {
+        const e = document.elementFromPoint(x, y);
+        if (!e) return "none";
+        const subj = document.querySelector(sel);
+        if (e.closest(sel) || e.closest(edge) || (subj && e.contains(subj))) return null;
+        const c = typeof e.className === "string" ? e.className : (e.className?.baseVal ?? "");
+        return `${e.tagName.toLowerCase()}${c ? "." + c.trim().split(/\s+/).slice(0, 2).join(".") : ""}`;
+      },
+      {
+        x: side === "left" || side === "right" ? raw.x + raw.width / 2 : b.x + b.width / 2,
+        y: side === "top" || side === "bottom" ? raw.y + raw.height / 2 : b.y + Math.min(b.height, vw.height - b.y) / 2,
+        sel: subject,
+        edge,
+      },
+    );
+    const clip = clamp(raw);
+    const { inks, fills } = await page.evaluate(edgeInks, { edge, strip: clip });
+    const { on: ON, off: OFF } = await onOff(page, clip, offCss);
+    const horiz = side === "top" || side === "bottom";
+    const len = horiz ? ON.w : ON.h,
+      depth = horiz ? ON.h : ON.w;
+    const s0 = Math.floor(len * span[0]),
+      s1 = Math.ceil(len * span[1]);
+    const deltas = [];
+    for (let i = 0; i < ON.data.length; i += 3) {
+      const d = Math.abs(grey(ON.data, i) - grey(OFF.data, i));
+      if (d >= 2) deltas.push(d);
+    }
+    const p99 = quantile(deltas, 0.99);
+    const st = [],
+      th = [];
+    for (let s = s0; s < s1; s++) {
+      let best = 1,
+        cov = 0;
+      for (let d = 0; d < depth; d++) {
+        const x = horiz ? s : d,
+          y = horiz ? d : s;
+        const i = (y * ON.w + x) * 3;
+        const r = ratio(lum(ON.data, i), lum(OFF.data, i));
+        if (r > best) best = r;
+        const gOff = grey(OFF.data, i);
+        let full = 0;
+        for (const [r8, g8, b8, a] of inks) full = Math.max(full, Math.abs(0.2126 * r8 + 0.7152 * g8 + 0.0722 * b8 - gOff) * a);
+        if (full < 4) full = p99;
+        const mv = Math.abs(grey(ON.data, i) - gOff);
+        if (on("ownfill") && fills.length) {
+          let tint = 0;
+          for (const [r8, g8, b8, a] of fills) tint = Math.max(tint, Math.abs(0.2126 * r8 + 0.7152 * g8 + 0.0722 * b8 - gOff) * a);
+          if (mv <= tint * 1.25 + 1) continue;
+        }
+        if (full >= 2) cov += Math.min(1, mv / full);
+      }
+      st.push(best);
+      th.push(cov / dpr);
+    }
+    // the hole runs (dropped stations) and the STATION-8 legacy (max-pool of eight)
+    const drop = st.map((v) => v <= 1.05);
+    let runs = 0,
+      longest = 0,
+      cur = 0;
+    for (const d of drop) {
+      if (d) {
+        cur++;
+        if (cur === 1) runs++;
+        longest = Math.max(longest, cur);
+      } else cur = 0;
+    }
+    const pooled = [];
+    for (let k = 0; k < st.length; k += 8) pooled.push(Math.max(...st.slice(k, k + 8)));
+    return {
+      stations: st.length,
+      coreMedian: +median(st).toFixed(3),
+      fracUnder: st.length ? +(st.filter((v) => v < floor).length / st.length).toFixed(3) : 1,
+      dropped: drop.filter(Boolean).length,
+      holeFrac: st.length ? +(drop.filter(Boolean).length / st.length).toFixed(3) : 1,
+      holeRuns: runs,
+      longestHole: longest,
+      thickness: +median(th).toFixed(2),
+      ink: inks.length ? "computed" : "p99",
+      station8: { median: +median(pooled).toFixed(3), dropped: pooled.filter((v) => v <= 1.05).length, n: pooled.length },
+      pose: block,
+      occluder,
+    };
+  };
+  for (const side of ["top", "right", "bottom", "left"]) {
+    // scroll POSES: the side's own edge first, then centred; an occluded first pose prints its occluder
+    // and the better-seen pose is the reading (the band must be paintable at SOME reachable pose)
+    const first = await readBand(side, side === "bottom" ? "end" : side === "top" ? "start" : "nearest");
+    let band = first;
+    const tried = [`${first.pose} ${first.coreMedian}${first.occluder ? " occ " + first.occluder : ""}`];
+    for (const pose of side === "bottom" ? ["center", "start"] : side === "top" ? ["center", "end"] : ["center"]) {
+      if (band.coreMedian >= floor) break;
+      const next = await readBand(side, pose);
+      tried.push(`${next.pose} ${next.coreMedian}${next.occluder ? " occ " + next.occluder : ""}`);
+      if (next.coreMedian > band.coreMedian) band = next;
+    }
+    if (tried.length > 1) band = { ...band, firstPose: tried.join(" | ") };
+    bands[side] = band;
+    const occ = band.occluder ? ` (occluder ${band.occluder})` : "";
+    if (on("B1") && band.stations < 8 * dpr) {
+      why.push(`B1 ${side} band EMPTY (${band.stations} stations < ${8 * dpr} = 8 css px at DPR ${dpr})${occ}`);
+      continue;
+    }
+    if (on("B2") && band.coreMedian < floor) why.push(`B2 ${side} core median ${band.coreMedian} < ${floor}${occ}`);
+    if (on("B3") && band.thickness < thick * thickTol)
+      why.push(`B3 ${side} painted depth ${band.thickness} css px < ${(thick * thickTol).toFixed(2)} (${thick} × ${thickTol}; ink ${band.ink})`);
+    if (on("B4") && band.holeFrac > holes)
+      why.push(`B4 ${side} holes ${band.holeFrac} > ${holes} (${band.dropped} stations in ${band.holeRuns} runs, longest ${band.longestHole})`);
+    if (on("B5") && above != null && band.coreMedian < above * 1.02)
+      why.push(`B5 ${side} core median ${band.coreMedian} < ${(above * 1.02).toFixed(3)} (the previous ink ${above} × 1.02)`);
+  }
+  if (on("B6")) {
+    const deep = Math.max(...Object.values(bands).map((b) => b.thickness ?? 0));
+    for (const [side, b] of Object.entries(bands))
+      if (b.stations >= 8 * dpr && b.thickness < relBand * deep)
+        why.push(`B6 ${side} painted depth ${b.thickness} < ${relBand} × the deepest band ${deep} (= ${(relBand * deep).toFixed(2)})`);
+  }
+  return {
+    red: why.length > 0,
+    why,
+    bands,
+    edgeCount,
+    dpr,
+    topOnly: bands.top ? (bands.top.coreMedian >= floor ? "GREEN" : "RED") : "RED",
+    station8: Object.values(bands).every((b) => b.station8 && b.station8.median >= floor && b.station8.dropped === 0) ? "GREEN" : "RED",
+    box: b0 ? { x: +b0.x.toFixed(1), y: +b0.y.toFixed(1), w: +b0.width.toFixed(1), h: +b0.height.toFixed(1) } : null,
+  };
+}
+
+/** The in-run plants every drawn-edge row ships (LAWS P6 §E, P7 §E): each must RED, or print NO-OP when
+ *  it cannot reach this edge's paint (a stroke plant on a CSS outline). A plant is a CSS string, or
+ *  `{ fade: a }` — every painted colour of the edge AND its descendants re-set at `a` × its own alpha
+ *  (RULE: the pass-7 FADE15 set `stroke` on the edge root only, and a path carrying its own `stroke`
+ *  attribute kept its ink). */
+export const EDGE_PLANTS = (edge) => {
+  const all = `${edge}, ${edge} *`;
+  const shapes = ["path", "rect", "line", "polyline", "polygon", "circle", "ellipse", "use"].map((t) => `${edge} ${t}`).join(", ");
+  // 1-in-8: a 2 px gap in every 16 px, both axes, intersected so each band loses 1/8 of its stations;
+  // `no-clip` so an outline outside the border box is masked too
+  // (the gap sits at 6–8 px of each period, so a box edge on a 16 px multiple keeps its ink)
+  const stripe = (dir) => `repeating-linear-gradient(to ${dir}, #000 0 6px, transparent 6px 8px, #000 8px 16px)`;
+  const dash = `${stripe("right")}, ${stripe("bottom")}`;
+  return {
+    X6_bottom_erased: `${edge} { clip-path: inset(-8px -8px 16px -8px) !important; }`,
+    X4_opacity_015: `${edge} { opacity: 0.15 !important; }`,
+    FADE15_desc: { fade: 0.15 },
+    STROKE_OPACITY015: `${all} { stroke-opacity: 0.15 !important; }`,
+    PATH_OPACITY015: `${shapes} { opacity: 0.15 !important; }`,
+    FILTER_OPACITY015: `${edge} { filter: opacity(0.15) !important; }`,
+    THIN_1PX: `${all} { stroke-width: 1px !important; vector-effect: non-scaling-stroke !important; outline-width: 1px !important; border-width: 1px !important; }`,
+    DASH_1IN8: `${edge} { mask-image: ${dash} !important; -webkit-mask-image: ${dash} !important; mask-composite: intersect !important; -webkit-mask-composite: source-in !important; mask-clip: no-clip !important; -webkit-mask-clip: no-clip !important; }`,
+    INFO_X5_opacity_04: `${edge} { opacity: 0.4 !important; }`, // a sensitivity row (SELF's X5): printed, not required
+  };
+};
+/** The previous ink replayed through the three channels M18's token clause missed (RULE): each must RED
+ *  a B5 read whose `above` is that previous ink's reading. */
+export const INK_PLANTS = (edge, a = 0.81) => ({
+  [`REF_STROKE_OPACITY${a}`]: `${edge}, ${edge} * { stroke-opacity: ${a} !important; }`,
+  [`REF_PATH_OPACITY${a}`]: `${["path", "rect", "line", "polyline", "polygon", "circle", "ellipse"].map((t) => `${edge} ${t}`).join(", ")} { opacity: ${a} !important; }`,
+  [`REF_FILTER_OPACITY${a}`]: `${edge} { filter: opacity(${a}) !important; }`,
+});
+
+/** Apply one edge plant; returns its undo. A `{ fade }` plant is written as a STYLESHEET keyed on a
+ *  per-element data attribute (an inline `!important` would outrank the OFF sheet, and the OFF photo
+ *  would then equal the ON photo — a RED for the wrong reason). */
+export async function applyEdgePlant(page, edge, plant) {
+  if (typeof plant === "string") {
+    const tag = await page.addStyleTag({ content: plant });
+    return () => tag.evaluate((e) => e.remove());
+  }
+  const css = await page.evaluate(
+    ({ edge, a }) => {
+      const cv = document.createElement("canvas").getContext("2d");
+      const fade = (c) => {
+        if (!c || c === "none" || c.startsWith("url(")) return null;
+        cv.fillStyle = "#010203";
+        cv.fillStyle = c;
+        const s = cv.fillStyle;
+        const m = s.match(/^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i);
+        const v = m ? [parseInt(m[1], 16), parseInt(m[2], 16), parseInt(m[3], 16), 1] : (s.match(/rgba?\(([^)]+)\)/)?.[1].split(/[,\s/]+/).filter(Boolean).map(Number) ?? null);
+        return v ? `rgba(${v[0]}, ${v[1]}, ${v[2]}, ${((v[3] ?? 1) * a).toFixed(4)})` : null;
+      };
+      const props = [["stroke", "stroke"], ["fill", "fill"], ["color", "color"], ["outlineColor", "outline-color"], ["borderTopColor", "border-top-color"], ["borderRightColor", "border-right-color"], ["borderBottomColor", "border-bottom-color"], ["borderLeftColor", "border-left-color"], ["backgroundColor", "background-color"]];
+      const els = [...document.querySelectorAll(edge)].flatMap((r) => [r, ...r.querySelectorAll("*")]);
+      const reads = els.map((el) => {
+        const cs = getComputedStyle(el);
+        return props.map(([k]) => cs[k]);
+      });
+      return els
+        .map((el, i) => {
+          el.setAttribute("data-edge-fade", String(i));
+          const decl = props.map(([, p], j) => [p, fade(reads[i][j])]).filter(([, v]) => v).map(([p, v]) => `${p}: ${v} !important;`).join(" ");
+          return decl ? `[data-edge-fade="${i}"] { ${decl} }` : "";
+        })
+        .join("\n");
+    },
+    { edge, a: plant.fade },
+  );
+  const tag = await page.addStyleTag({ content: css });
+  return async () => {
+    await tag.evaluate((e) => e.remove());
+    await page.evaluate(() => {
+      for (const el of document.querySelectorAll("[data-edge-fade]")) el.removeAttribute("data-edge-fade");
+    });
+  };
+}
+
+const sig = (r) => (r.bands ? Object.values(r.bands).map((b) => `${b.coreMedian}/${b.thickness}/${b.dropped}`).join(" ") : "none");
+/** Clean, then every plant against it. A plant whose four bands read byte-for-byte the clean numbers
+ *  changed no paint on this edge: NO-OP (printed, not a hole). */
+export async function edgeGate(page, { subject, edge, plants = null, ...opts }) {
+  const clean = await fourBands(page, { subject, edge, ...opts });
+  const out = {};
+  for (const [name, plant] of Object.entries(plants ?? EDGE_PLANTS(edge))) {
+    const undo = await applyEdgePlant(page, edge, plant);
+    await settle(page);
+    const r = await fourBands(page, { subject, edge, ...opts });
+    await undo();
+    await settle(page);
+    r.noop = !r.red && sig(r) === sig(clean);
+    r.info = /^INFO_/.test(name);
+    out[name] = r;
+  }
+  return { clean, plants: out };
+}
+
+export const fmt = (r) =>
+  (r.bands
+    ? Object.entries(r.bands)
+        .map(([k, b]) => `${k} ${b.coreMedian} d${b.thickness} (n${b.stations} <3:${b.fracUnder} holes ${b.dropped}/${b.holeRuns}r${b.longestHole ? "≤" + b.longestHole : ""} s8 ${b.station8?.median}/${b.station8?.dropped}${b.occluder ? " occ " + b.occluder : ""}${b.firstPose ? " [first " + b.firstPose + "]" : ""})`)
+        .join(" · ") + ` | topOnly ${r.topOnly} station8 ${r.station8}`
+    : `[edge elements ${r.edgeCount}]`) + ` → ${r.red ? "RED " + r.why.join("; ") : r.noop ? "NO-OP (the plant changed no paint on this edge)" : "GREEN"}`;
+
+// ------------------------------------------------------------------------------------ self-test
+/** Synthetic subjects (no product surface), light and dark: an svg frame whose path carries its OWN
+ *  stroke attribute (the descendant FADE15 case), a 2 px outline ring whose edge is the subject, a
+ *  reference frame at 81 % of the frame's ink (B5), and born-RED fixtures: a 1-in-8 dashed frame (reads
+ *  GREEN under STATION-8), a 1 px frame, a missing edge, a hidden subject, a 6 px tall frame (its side bands EMPTY). */
+const FIXTURE = (scheme) => {
+  const ink = scheme === "dark" ? "#d8d2c6" : "#3b3833";
+  const ref = scheme === "dark" ? "rgba(216,210,198,0.81)" : "rgba(59,56,51,0.81)";
+  const frame = (id, stroke, w = 2, extra = "") =>
+    `<div id="${id}" class="fx"><svg class="${id}-edge" viewBox="0 0 240 90" preserveAspectRatio="none"><rect x="${w / 2}" y="${w / 2}" width="${240 - w}" height="${90 - w}" fill="none" stroke="${stroke}" stroke-width="${w}" ${extra}/></svg></div>`;
+  return `<!doctype html><html><head><style>
+  body { margin: 0; padding: 30px; background: ${scheme === "dark" ? "#1f1d1a" : "#fbf8f1"}; color: ${ink}; font: 18px/1.3 Georgia, serif; display: grid; grid-template-columns: repeat(3, 240px); gap: 40px; }
+  .fx { position: relative; width: 240px; height: 90px; }
+  .fx.flat { height: 6px; }
+  .fx svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
+  #f-ring { width: 240px; height: 90px; box-sizing: border-box; border: 0; background: transparent; color: inherit; font: inherit; outline: 2px solid ${ink}; outline-offset: 0; }
+</style></head><body>
+  ${frame("f-frame", ink)}
+  <button id="f-ring">ring</button>
+  ${frame("f-ref", ref)}
+  ${frame("f-dash", ink, 2, 'stroke-dasharray="14 2"')}
+  ${frame("f-thin", ink, 1)}
+  <div id="f-bare" class="fx"></div>
+  <div id="f-gone" class="fx" hidden><svg class="f-gone-edge" viewBox="0 0 240 90"><rect x="1" y="1" width="238" height="88" fill="none" stroke="${ink}" stroke-width="2"/></svg></div>
+  <div id="f-uneven" class="fx"><svg class="f-uneven-edge" viewBox="0 0 240 90" preserveAspectRatio="none"><path d="M0 2.5H240M237.5 0V90M0 87.5H240" stroke="${ink}" stroke-width="5" fill="none"/><path d="M1 0V90" stroke="${ink}" stroke-width="2" fill="none"/></svg></div>
+  <div id="f-fill" class="fx" style="outline: 1px solid ${ink}; background: ${scheme === "dark" ? "rgba(216,210,198,0.14)" : "rgba(59,56,51,0.14)"}"></div>
+  <div id="f-flat" class="fx flat"><svg class="f-flat-edge" viewBox="0 0 240 6" preserveAspectRatio="none"><rect x="1" y="1" width="238" height="4" fill="none" stroke="${ink}" stroke-width="2"/></svg></div>
+</body></html>`;
+};
+
+export async function selfTest(browser, { dpr = 1 } = {}) {
+  const rows = [];
+  let hole = false,
+    cleanRed = false;
+  const tagOf = (scheme) => `EDGE self-test ${scheme} dpr${dpr}`;
+  for (const scheme of ["light", "dark"]) {
+    const { ctx, page } = await openCell(browser, { width: 900, height: 420, dpr, colorScheme: scheme });
+    await page.setContent(FIXTURE(scheme));
+    await settle(page);
+    const T = tagOf(scheme);
+    const cases = [
+      { subject: "#f-frame", edge: ".f-frame-edge" },
+      { subject: "#f-ring", edge: "#f-ring", off: "#f-ring { outline-color: transparent !important; }" },
+    ];
+    for (const c of cases) {
+      const g = await edgeGate(page, c);
+      if (g.clean.red) cleanRed = true;
+      rows.push(`${T} ${c.subject} CLEAN ${fmt(g.clean)}`);
+      for (const [k, r] of Object.entries(g.plants)) {
+        if (!r.red && !r.noop && !r.info) hole = true;
+        rows.push(`${T} ${c.subject} PLANT ${k} ${fmt(r)}${r.info ? " [sensitivity row]" : ""}`);
+      }
+    }
+    // B5: the reference frame's reading is `above`; the frame clean beats it, the previous ink replayed
+    // through each channel must not
+    const ref = await fourBands(page, { subject: "#f-ref", edge: ".f-ref-edge" });
+    const above = Math.min(...Object.values(ref.bands).map((b) => b.coreMedian));
+    rows.push(`${T} #f-ref REFERENCE (the previous ink, 81 %) ${fmt(ref)} → above = ${above}`);
+    const g5 = await edgeGate(page, { subject: "#f-frame", edge: ".f-frame-edge", above, plants: INK_PLANTS(".f-frame-edge", 0.81) });
+    if (g5.clean.red) cleanRed = true;
+    rows.push(`${T} #f-frame B5 CLEAN ${fmt(g5.clean)}`);
+    for (const [k, r] of Object.entries(g5.plants)) {
+      if (!r.red && !r.noop) hole = true;
+      rows.push(`${T} #f-frame B5 PLANT ${k} ${fmt(r)}`);
+    }
+    // born-RED fixtures: each must RED (a GREEN is a hole)
+    for (const [label, c, clause] of [
+      ["DASHED 1-in-8 frame", { subject: "#f-dash", edge: ".f-dash-edge" }, "B4"],
+      ["1 px frame", { subject: "#f-thin", edge: ".f-thin-edge" }, "B3"],
+      ["missing edge (B2 reds it too: ON = OFF)", { subject: "#f-bare", edge: ".f-bare-edge" }, "B0"],
+      ["hidden subject (a skip without B0)", { subject: "#f-gone", edge: ".f-gone-edge" }, "B0"],
+      ["6 px tall frame (side bands of 4 stations)", { subject: "#f-flat", edge: ".f-flat-edge" }, "B1"],
+      // the chair, pass 9: B6 alone (the 2 px side clears B3's 1.80 among 5 px sides) and ownfill (a 1 px
+      // ring over a 14 % fill tint: the tint's own move is not ring depth)
+      ["one side thin, 5/5/5/2 px (B6 only)", { subject: "#f-uneven", edge: ".f-uneven-edge" }, "B6"],
+      ["1 px ring over a 14 % fill tint (B3 with ownfill)", { subject: "#f-fill", edge: "#f-fill" }, "ownfill"],
+    ]) {
+      const r = await fourBands(page, c);
+      if (!r.red) hole = true;
+      if (clause === "B6" && !r.why.every((w) => w.startsWith("B6"))) hole = true;
+      rows.push(`${T} ${c.subject} BORN-RED ${label} (${clause}) ${fmt(r)}${label.startsWith("DASHED") ? ` ← STATION-8 reads ${r.station8}` : ""}`);
+    }
+    // the LEGACY FADE15 (the edge root's `stroke` only): the path's own stroke attribute keeps its ink
+    const legacy = await fourBands(page, { subject: "#f-frame", edge: ".f-frame-edge" }).then(async () => {
+      const t = await page.addStyleTag({ content: `.f-frame-edge { color: color-mix(in srgb, currentColor 15%, transparent) !important; stroke: color-mix(in srgb, currentColor 15%, transparent) !important; }` });
+      await settle(page);
+      const r = await fourBands(page, { subject: "#f-frame", edge: ".f-frame-edge" });
+      await t.evaluate((e) => e.remove());
+      await settle(page);
+      return r;
+    });
+    rows.push(`${T} #f-frame LEGACY FADE15 (root stroke only) ${fmt(legacy)} ← the pass-7 form ${legacy.red ? "(read RED here)" : "(GREEN: the descendant form is load-bearing)"}`);
+    await ctx.close();
+  }
+  return { rows, exit: cleanRed ? (hole ? 4 : 1) : hole ? 3 : 0 };
+}
+
+// ------------------------------------------------------------------------------------------ CLI
+if (process.argv[1] && fileURLToPath(import.meta.url) === resolvePath(process.argv[1])) {
+  const A = args();
+  const engine = A.engine ?? "chromium";
+  let exit = 0;
+  if (A["sabotage-battery"]) {
+    // each clause off in turn (a child process per clause): the self-test must RED (exit ≠ 0)
+    const { spawnSync } = await import("node:child_process");
+    for (const c of EDGE_CLAUSES) {
+      const r = spawnSync(process.execPath, [fileURLToPath(import.meta.url), "--self-test", "--engine", engine, "--dprs", A.dprs ?? "1"], { env: { ...process.env, EDGE_SABOTAGE: c }, encoding: "utf8" });
+      const bit = r.status !== 0;
+      if (!bit) exit = 3;
+      const greens = r.stdout.split("\n").filter((l) => / → GREEN/.test(l) && /PLANT|BORN-RED/.test(l)).map((l) => l.replace(/^.*?(#\S+ (?:B5 )?(?:PLANT|BORN-RED) \S+( [^(→]*)?).*$/, "$1").trim());
+      console.log(`EDGE sabotage ${c} off → self-test exit ${r.status} ${bit ? "BITES" : "SILENT (a clause with no plant)"}${greens.length ? ` · GREEN: ${[...new Set(greens)].join(" | ")}` : ""}`);
+    }
+    console.log(`LOAD ${load()}`);
+    process.exit(exit);
+  }
+  const browser = await playwright()[engine].launch();
+  if (A["self-test"]) {
+    for (const dpr of (A.dprs ?? "1,2").split(",").map(Number)) {
+      const r = await selfTest(browser, { dpr });
+      for (const row of r.rows) console.log(`${engine} ${row}`);
+      exit = Math.max(exit, r.exit);
+    }
+  } else {
+    let cleanRed = false,
+      hole = false;
+    for (const cell of cellsOf(A)) {
+      const { ctx, page } = await openCell(browser, cell);
+      await page.goto(A.url);
+      await page.locator(A.ready ?? ".board-cells").first().waitFor({ timeout: 30000 });
+      await page.evaluate(() => document.fonts.ready);
+      await page.waitForFunction(() => document.getAnimations().every((a) => a.playState !== "running" || a.effect?.getTiming().iterations === Infinity), null, { timeout: 8000 }).catch(() => {});
+      if (A.hover) await page.locator(A.hover).first().hover();
+      if (A.click) await page.locator(A.click).first().click();
+      await settle(page);
+      const tag = `${engine} ${cell.label} ${cell.width}x${cell.height} dpr${cell.dpr}`;
+      const opts = { subject: A.subject, edge: A.edge ?? A.subject, ...(A.off ? { off: A.off } : {}), ...(A.above ? { above: +A.above } : {}), ...(A.holes ? { holes: +A.holes } : {}) };
+      if (A.plants) {
+        const g = await edgeGate(page, opts);
+        console.log(`EDGE ${tag} ${A.subject} [edge ${opts.edge}: ${g.clean.edgeCount}] CLEAN ${fmt(g.clean)}`);
+        if (g.clean.red) cleanRed = true;
+        for (const [k, r] of Object.entries(g.plants)) {
+          if (!r.red && !r.noop && !r.info) hole = true;
+          console.log(`EDGE ${tag} ${A.subject} PLANT ${k} ${fmt(r)}${r.info ? " [sensitivity row]" : ""}`);
+        }
+      } else {
+        const r = await fourBands(page, opts);
+        console.log(`EDGE ${tag} ${A.subject} [edge ${opts.edge}: ${r.edgeCount}] CLEAN ${fmt(r)}`);
+        if (r.red) cleanRed = true;
+      }
+      await ctx.close();
+    }
+    exit = cleanRed ? (hole ? 4 : 1) : hole ? 3 : 0;
+  }
+  console.log(`LOAD ${load()}`);
+  await browser.close();
+  process.exit(exit);
+}
