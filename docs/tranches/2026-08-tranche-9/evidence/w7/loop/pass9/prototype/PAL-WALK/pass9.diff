+  const list = files
+    ? followImports([...files, ...extra], { read: rd, exists })
+    : [...sources(fe, { read: rd, exists }), ...extra];
+  for (const f of list) {
+    const file = relative(fe, f);
+    const text = rd(f);
+    if (isCss(f))
