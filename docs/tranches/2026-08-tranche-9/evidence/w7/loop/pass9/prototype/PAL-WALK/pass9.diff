+  line: number;
+  unresolved?: boolean;
+}
+export interface Link {
+  rel: string[];
+  href: string | null;
+  attrs: Map<string, string>;
+}
+
+// ── clauses, files, strippers ───────────────────────────────────────────────────────────────────
+export const CLAUSES: Readonly<Record<string, string>>;
+/** Switch clauses off (the clause-sabotage battery); `[]` restores all. */
