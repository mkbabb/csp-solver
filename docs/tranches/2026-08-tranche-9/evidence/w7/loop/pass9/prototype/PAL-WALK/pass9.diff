+  matches: string[];
+  unresolved: boolean;
+}[];
+export function maskedDefaults(
+  text: string,
+  registered?: string[],
+): {
+  name: string;
+  fallback: string;
+  stem: string | null;
+  at: number;
+  unresolved?: boolean;
+}[];
+export function publishers(sites: Site[]): Site[];
+export function unresolvedSites(sites: Site[]): Site[];
+export function tokenSites(fe: string, token: string, o?: TreeOptions): Site[];
+export function fontFaces(fe: string, o?: TreeOptions): FontBinding[];
+export function propertyRegistrations(fe: string, o?: TreeOptions): Registration[];
+/** `bare`: `root` is an alias bound to a clock (`const W = MOTION.rungs.whisper`), read with no member. */
+export function clockReads(
+  text: string,
+  root?: string,
+  o?: { bare?: boolean },
+): {
+  expr: string;
+  arith: boolean;
+  line: number;
+  how: "math" | "bracket" | "operator" | "read";
+  /** the arithmetic operator beside the read, or null */
+  op: string | null;
+}[];
+export function urlRefs(
+  text: string,
+): { id: string | null; raw: string; unresolved?: boolean }[];
+export function svgRefSites(
+  text: string,
+): { id: string | null; raw: string; line: number; unresolved?: boolean }[];
+export function componentSites(fe: string, o?: TreeOptions): Site[];
+export function pinsBreached(sites: Site[], pins: Record<string, unknown>): Site[];
+
+// ── elements, regimes, lengths ──────────────────────────────────────────────────────────────────
+export function templateElements(tpl: string, baseLine?: number): TemplateElement[];
+export function mayMatch(
+  sel: string,
+  el: TemplateElement,
+  els: TemplateElement[],
+  o?: { outer?: (compound: string) => boolean },
+): boolean;
+export function elementSites(
+  fe: string,
+  o: TreeOptions & {
+    file: string;
+    pick: (el: TemplateElement) => boolean;
+    props: string[];
+    whitelist?: Record<string, string[]>;
+  },
+): {
+  elements: { tag: string; id: string | null; classes: string[]; line: number }[];
+  sites: Site[];
+};
+export const REGIMES: Readonly<Record<string, Regime>>;
+export function ALL_REGIMES(): string[];
+export function evalMedia(query: string, regime: Regime): boolean;
+export function evalSupports(cond: string): boolean | null;
+export function regimesOf(
+  ctx?: string[],
+  regimes?: Record<string, Regime>,
+  o?: { must?: boolean },
+): string[];
+export function lengthPx(
+  value: string,
+  consumer?: { fontSize?: number; lineHeight?: number; rootFontSize?: number },
+  map?: Map<string, string>,
+): number | null;
+export function effectiveAt<S extends Site>(sites: S[], regime: string): S | null;
+
+// ── links, colours ──────────────────────────────────────────────────────────────────────────────
+export function stripInert(html: string): string;
+export function htmlLinks(html: string): Link[];
+export const LINK_ALLOW: Readonly<Record<string, Record<string, string[] | null>>>;
+export function exactlyOneLink(
+  html: string,
+  rel: string,
+  o?: { allow?: Record<string, string[] | null> | null },
