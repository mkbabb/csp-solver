+  const raw = [];
+  for (const h of hues) {
+    const a = h - GUARD;
+    const b = h + GUARD;
+    if (a < 0) raw.push([a + 360, 360], [0, b]);
+    else if (b > 360) raw.push([a, 360], [0, b - 360]);
+    else raw.push([a, b]);
