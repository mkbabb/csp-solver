+    glyphCores: gw,
+    g4Lows: g4Lows.map((x) => x.split(":")[0]),
+    g4Tolerated: tolerated,
+    transientOn,
+    transientOff,
+    outsideRun,
+    clip,
+    dpr,
+  };
+}
