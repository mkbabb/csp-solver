+// ------------------------------------------------------------------------ registrations (ERASE)
+/** Every custom-property REGISTRATION: `@property` in every CSS language and block, and every
+ *  `registerProperty(` in code (ERASE: the name folded through concatenation and same-file consts;
+ *  unfoldable = `?`, UNRESOLVED, never dropped). [{name, inherits, syntax, initial, kind, file, line}] */
+export function propertyRegistrations(fe, { files, read, exists } = {}) {
+  const rd = read ?? ((f) => readFileSync(f, "utf8"));
+  const list = files
+    ? followImports(files, { read: rd, exists })
+    : sources(fe, { read: rd, exists });
+  const out = [];
+  for (const f of list) {
+    const file = relative(fe, f);
+    const text = rd(f);
+    for (const r of rulesOf(f, text, fe)) {
+      const pre = on("prop-escape")
+        ? r.prelude.replace(
+            /\\([0-9a-fA-F]{1,6})\s?|\\([^\n0-9a-fA-F])/g,
+            (x, h, ch) => (h ? String.fromCodePoint(parseInt(h, 16)) : ch),
+          )
+        : r.prelude;
+      const m = /^@property\s+(--[\w-]+)/.exec(pre);
+      if (!m) continue;
+      const get = (p) => r.decls.find((d) => d.prop === p)?.value ?? null;
+      out.push({
+        name: m[1],
+        inherits: get("inherits"),
+        syntax: get("syntax"),
+        initial: get("initial-value"),
+        kind: `@property ${r.kind}`,
+        file,
+        line: r.line,
+      });
+    }
+    const codes = f.endsWith(".vue")
+      ? sfc(text).scripts.map((s) => s.text)
+      : /\.(ts|tsx|js|mjs)$/.test(f)
+        ? [text]
+        : [];
+    for (const code of codes) {
+      let s = stripJs(code);
+      const consts = constBindings(s);
+      if (on("register-script")) {
+        // the chair p9 (the shape law's script clauses): concatenations folded first (TIN's
+        // foldText), `CSS["registerProperty"](…)` read as the call, and every BOUND ALIAS —
+        // `const reg = CSS.registerProperty.bind(CSS)`, `const { registerProperty: rp } = CSS` —
+        // rewritten to the call it is
+        s = foldText(s, { consts }).replace(
+          /\[\s*(["'`])registerProperty\1\s*\]\s*\(/g,
+          ".registerProperty(",
+        );
+        const aliases = new Set();
+        for (const a of s.matchAll(
+          /(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*=\s*(?:(?:window|globalThis)\s*\.\s*)?CSS\s*\.\s*registerProperty\b/g,
+        ))
+          aliases.add(a[1]);
+        for (const a of s.matchAll(
+          /(?:const|let|var)\s*\{([^}]*)\}\s*=\s*(?:(?:window|globalThis)\s*\.\s*)?CSS\b/g,
+        )) {
+          const d = /registerProperty(?:\s*:\s*([A-Za-z_$][\w$]*))?/.exec(a[1]);
+          if (d) aliases.add(d[1] ?? "registerProperty");
+        }
+        for (const a of aliases)
+          if (a !== "registerProperty")
+            s = s.replace(
+              new RegExp(`(?<![\\w$.])${a.replace(/\$/g, "\\$")}\\s*\\(`, "g"),
+              "registerProperty(",
+            );
+        // `@property` TEXT inside a (folded) script string — insertRule, replaceSync, a <style>
+        for (const q of s.matchAll(
+          /(["'`])((?:\\.|(?!\1)[^\\])*?@property[\s\S]*?)\1/g,
+        ))
+          for (const r of cssRules(q[2].replace(/<\/?style[^>]*>/g, " "))) {
+            const pm = /^@property\s+(--[\w-]+)/.exec(r.prelude);
+            if (!pm) continue;
+            const get = (p) => r.decls.find((d) => d.prop === p)?.value ?? null;
+            out.push({
+              name: pm[1],
+              inherits: get("inherits"),
+              syntax: get("syntax"),
+              initial: get("initial-value"),
+              kind: "@property script-string",
+              file,
+              line: lineAt(s, q.index),
+            });
+          }
+      }
+      for (const m of s.matchAll(/registerProperty\s*\(\s*\{([\s\S]*?)\}\s*\)/g)) {
+        const field = (k) => {
+          const x = new RegExp(`(?:^|[,{\\s])${k}\\s*:\\s*([^,}]+)`).exec(m[1]);
+          if (x) return x[1].trim();
+          return new RegExp(`(?:^|[,{\\s])${k}\\s*(?:,|$)`).test(m[1]) ? k : null; // shorthand `{ name }`
+        };
+        const rawName = field("name");
+        // ERASE: a split name (`{ name: W }`, W = "--motion-" + "whisper") folds; the row it
+        // replaces wanted the literal within 240 chars and read the split form as nothing
+        const name =
+          rawName == null
+            ? null
+            : on("register-split")
+              ? foldConcat(rawName, consts)
+              : (/^(["'`])(--[\w-]+)\1$/.exec(rawName)?.[2] ?? null);
+        out.push({
+          name: name ?? `?${rawName}`,
+          unresolved: name == null,
+          inherits: field("inherits"),
+          syntax: field("syntax"),
+          initial: field("initialValue"),
+          kind: "registerProperty",
+          file,
+          line: lineAt(s, m.index),
+        });
+      }
+      // ERASE (pass 8): `registerProperty(opts)`, `registerProperty(...defs)` — an argument that is
+      // not an object literal is a registration whose name nothing can read: UNRESOLVED, never dropped
+      if (on("register-any"))
+        for (const m of s.matchAll(/registerProperty\s*\(\s*(?!\{)([^)]*)\)/g))
+          out.push({
+            name: `?${m[1].trim()}`,
+            unresolved: true,
+            inherits: null,
+            syntax: null,
+            initial: null,
+            kind: "registerProperty",
+            file,
+            line: lineAt(s, m.index),
+          });
+    }
+  }
+  return out;
+}
