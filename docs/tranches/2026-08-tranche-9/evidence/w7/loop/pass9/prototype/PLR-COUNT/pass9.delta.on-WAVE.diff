+<script setup lang="ts">
+import { ref } from "vue";
+import { useResizeObserver } from "@vueuse/core";
+import HandDrawnOutline from "@pencil/grid/HandDrawnOutline.vue";
+
+/**
+ * THE HEAD'S SHEET, ONE POSE FOR BOTH DISCLOSURES (T9-W7 §11 · CH-71 · R6 L5).
+ *
+ * The attribution card and the player lobby both hang `top: 100%; left: 0` off the one fixed
+ * head wrapper, and CH-71's rule is that a pose decision for one is a pose decision for both.
+ * So the pose lives here once: the hang, the fade, the `visibility` delay, and the EDGE.
+ *
+ * THE EDGE IS DRAWN, NEVER A CSS BORDER (R6 L5: one box grammar). Both sheets wore
+ * `border: 2px solid` at 30% of `--color-border`; the edge is now the wells' own frame
+ * (`HandDrawnOutline`, 1.5px, frozen at `:pose="0"` so it enrols no beat and mints one node).
+ * The box does not move: the 2px band the border held is kept as padding, and the frame's
+ * centre line runs 1px inside the edge, in that band.
+ *
+ * THE FRAME'S CORNER IS THE GROUND'S, READ OFF THE GROUND. The frame's radius is the ground's
+ * computed radius less the edge's own inset, both read live whenever the sheet's box changes —
+ * never the literal 15 they make at a 16px root, which a larger root would have left behind. At
+ * the wells' radius 3 it drew square corners past the ground and moved 67–70 of the 106 px
+ * outside the card's rounded corners (pass-5 critic).
+ *
+ * THE EDGE'S INK IS THE OWNER'S (U-10), ONE CONST. `false`: the sheet's own inherited ink, the
+ * wells' weight. `true`: the house's quiet press ink, the rung the sheet's captions use.
+ *
+ * Every attribute a consumer passes (`id`, `data-lobby`, `class`, `@click.stop`) lands on the
+ * root, so each consumer keeps its own ground and its own hooks.
+ */
+defineProps<{ open: boolean }>();
+const EDGE_QUIET = false;
+
+const ground = ref<HTMLElement | null>(null);
+const edge = ref<HTMLElement | null>(null);
+const radius = ref(0);
+useResizeObserver(ground, () => {
+  if (!ground.value || !edge.value) return;
+  radius.value =
+    parseFloat(getComputedStyle(ground.value).borderTopLeftRadius) -
+    edge.value.offsetTop;
+});
+</script>
+
+<template>
+  <div ref="ground" class="head-sheet" :class="{ 'is-open': open }">
+    <span
+      ref="edge"
+      class="head-sheet-edge"
+      :class="{ 'is-quiet': EDGE_QUIET }"
+      aria-hidden="true"
+    >
+      <HandDrawnOutline
+        class="head-sheet-frame"
+        :stroke-width="1.5"
+        :outset="0"
+        :radius="radius"
+        :pose="0"
+      />
+    </span>
+    <slot />
+  </div>
+</template>
+
+<style scoped>
+.head-sheet {
+  position: absolute;
+  top: 100%;
+  left: 0;
+  /* 1rem of air plus the 2px band the CSS border used to take: the box is byte-identical. */
+  padding: calc(1rem + 2px);
+  border-radius: 1rem;
+  min-width: 16rem;
+  opacity: 0;
+  /* UI-6 (WCAG 2.4.7): `visibility: hidden` pulls the sheet's contents out of the tab order and
+     the a11y tree while shut, delayed to the fade's end on close so it still reads as a fade. */
+  visibility: hidden;
+  pointer-events: none;
+  transform: scale(0.9) translateY(8px);
+  transition:
+    opacity var(--motion-whisper) var(--verb-layDown-ease),
+    transform var(--motion-whisper) var(--verb-layDown-ease),
+    visibility 0s linear 150ms;
+  z-index: 50;
+}
+
+.head-sheet.is-open {
+  opacity: 1;
+  visibility: visible;
+  pointer-events: auto;
+  transform: scale(1) translateY(0);
+  transition:
+    opacity var(--motion-whisper) var(--verb-layDown-ease),
+    transform var(--motion-whisper) var(--verb-layDown-ease),
+    visibility 0s linear 0s;
+}
+
+.head-sheet-edge {
+  position: absolute;
+  inset: 1px;
+  pointer-events: none;
+}
+
+.head-sheet-edge.is-quiet {
+  color: var(--ink-press-quiet);
+}
+
+.head-sheet-frame {
+  height: 100%;
