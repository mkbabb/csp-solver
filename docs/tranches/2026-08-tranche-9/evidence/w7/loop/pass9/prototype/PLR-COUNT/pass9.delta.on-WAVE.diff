+  browser: Browser,
+  theme: "light" | "dark",
+  dpr: number,
+  at: { q: Quiet; text: string; left: number; top: number }[],
+) {
+  const ctx = await browser.newContext({
+    baseURL: G14_CONTROL,
+    viewport: { width: 1280, height: 720 },
+    deviceScaleFactor: dpr,
+    colorScheme: theme,
+    reducedMotion: "reduce",
+  });
