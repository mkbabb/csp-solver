+const CUT: Record<Clause, RegExp> = {
+  S1: /(function onClick\(e\) \{\s*const owed = [^\n]*\n\s*)owedAt = -Infinity;/,
+  S2: /(function onPress\(e\) \{\s*)owedAt = -Infinity;/,
+  S3: /(function onKey\(\) \{\s*)owedAt = -Infinity;/,
