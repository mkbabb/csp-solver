+  await settled(page);
+  // three settled: you, r0 and r1
+  await page.evaluate(({ room }) => {
+    const ch = new BroadcastChannel(`board:${room}`);
+    for (const from of ["r0", "r1"]) ch.postMessage({ kind: "hi", data: {}, from });
