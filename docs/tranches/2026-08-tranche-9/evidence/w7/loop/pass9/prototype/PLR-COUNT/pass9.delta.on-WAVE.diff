+<script setup lang="ts">
+import { computed, nextTick, onBeforeUnmount, ref, useId, watch } from "vue";
+import PlayerLobby from "./PlayerLobby.vue";
+import { LOBBY_COPY } from "./copy";
+import type { LobbyLine, MarkRow } from "./types";
+import { laps, takesShort } from "./rowBudget";
+import {
+  claimHeadDisclosure,
+  registerHeadDisclosure,
+  useHoverCard,
+} from "../AttributionCard/useHoverCard";
+import {
+  tallyPose0,
+  useTallyStrokes,
+  type TallyStroke,
+} from "@pencil/composables/useTallyStrokes";
+import { MOTION } from "@pencil/config/pencilConfig";
+
+/**
+ * THE TALLY OF EVERYONE (T9-W7 §11 · M14 · PLR-COUNT, seated on PLR-SELF's substrate).
+ *
+ * One upright per person at this board, you first, each in that person's ink: a count a reader
+ * takes without reading. No diagonal, ever — the gate-five slash is a MAGNITUDE idiom
+ * (`DifficultyTally` owns it) and across five people it is a strike through four of them. From
+ * six the NUMBER replaces the strokes, at the title rung. One threshold, five, shared with the
+ * sheet's tall row budget.
+ *
+ * ONE COUNTING BASE. The strokes, the written number, the accessible name, the rows and
+ * `and N more` count the same people, and the name is computed HERE from the array the strokes
+ * are drawn from — so every digit the glyph paints is a substring of the name (WCAG 2.5.3) in
+ * each `SIX_ARM`, read per arm by `player-tally.spec.ts`'s G7.
+ *
+ * THE POSE IS KEYED TO THE PERSON, not the slot: the seed comes from the id, every `d` is
+ * generated at one local origin, and the slot is a translate. A departure moves the survivors
+ * right of it one pitch left and changes no surviving `d` by a byte.
+ *
+ * Everything else — the disclosure, the one-owner Escape, the head's shared open, the sheet's
+ * furniture and its row budget, the quiet qualifiers read at the open — is the leader's
+ * substrate, taken whole. This component is pencil and knows nothing about sessions; `App.vue`
+ * hands it the rows, your ink, and a reader for how long each peer has been quiet.
+ */
+const props = withDefaults(
+  defineProps<{
+    /** This page's own ink in this room — bound on the mark, spent when the room is ≥2. */
+    ink: Record<string, string>;
+    /** You first, then arrival order. Empty on a board with no room. */
+    rows: MarkRow[];
+    /** Silence past this is worth saying out loud. The session's own `PRESENCE_QUIET_MS`. */
+    quietAfterMs?: number;
+    /** How long a peer has been silent, in ms — read at OPEN, never on a timer. */
+    quietMsOf?: (id: string) => number | null;
+    /** Where the board is, read at OPEN — the one fact the row budget needs from outside pencil. */
+    boardBox?: () => DOMRect | null;
+  }>(),
+  // policy: quiet (the session's PRESENCE_QUIET_MS, passed in by App.vue)
+  { quietAfterMs: 20000, quietMsOf: undefined, boardBox: undefined },
+);
+
+/**
+ * SOLO — the owner's fork, both arms built, one const between them (U-10).
+ *
+ * `keep` (the default): a page with no room is still one person at this board, and that person
+ * is you — one stroke, in graphite, and a sheet with your row. M14's "coloured when a session is
+ * live" presupposes a mark present and uncoloured otherwise; graphite is this estate's
+ * uncoloured. `gate-on-a-room`: nothing mounts until there is a room to count, so the head
+ * grows with the wire and the most-seen board has no mark at all.
+ */
+const SOLO_ARM: "keep" | "gate-on-a-room" = "keep";
+/** Your one row carries the solo stroke's own ink (PLR-SELF's incident 8, taken): with no binding
+ *  the row fell through to the incumbent self-blue beside a graphite stroke, you in two colours. */
+const SOLO: MarkRow[] = [
+  {
+    id: "self",
+    name: "",
+    ink: { "--color-user-ink": "var(--color-pencil-graphite)" },
+    self: true,
+  },
+];
+const people = computed<MarkRow[]>(() =>
+  props.rows.length ? props.rows : SOLO_ARM === "keep" ? SOLO : [],
+);
+const count = computed(() => people.value.length);
+/** The sheet's first line, from the array the strokes count — and the mark's name, which under
+ *  arm (c) below goes on to carry the remainder it paints. */
+const stateLine = computed(() => LOBBY_COPY.count(count.value));
+
+const { isOpen, toggle, close } = useHoverCard();
+const el = ref<HTMLButtonElement | null>(null);
+const lobbyId = useId();
+/** ≥2 at the table. One person is a board you are alone on, and it stays graphite. */
+const live = computed(() => count.value > 1);
+
+// ── The tally ──────────────────────────────────────────────────────────────────────────────
+/** The threshold: five strokes are drawn; from six the count is written. */
+const TALLY_MAX = 5;
+/** viewBox units — `DifficultyTally`'s own geometry: pitch 13, y 9 → 35, in a 44-unit box. */
+const PITCH = 13;
+const BOX_H = 44;
+
+/** FNV-1a, 32-bit — the id's own bits, so the wobble a person is drawn with is theirs on every
+ *  page that draws them and survives every arrival and departure around them. */
+function seedFor(id: string): number {
+  let h = 0x811c9dc5;
+  for (let i = 0; i < id.length; i++) {
+    h ^= id.charCodeAt(i);
+    h = Math.imul(h, 0x01000193) >>> 0;
+  }
+  return 11 + 12 * (h % 97);
+}
+/** YOUR stroke is keyed `self` in both arms of the wire, so joining a room does not read as
+ *  somebody arriving: the stroke re-inks (the 400ms presence colour) and never re-draws. */
+const keyOf = (r: MarkRow) => (r.self ? "self" : r.id);
+
+/** THE SET IS THE FIRST FIVE PEOPLE, painted or not — past the threshold the set is still who
+ *  WOULD be drawn, so a swap at six is a change the watch can see (pass 3's empty-set cure). */
+const tallied = computed(() => people.value.slice(0, TALLY_MAX));
+const ids = computed(() => tallied.value.map(keyOf));
+/**
+ * FROM SIX — the owner's fork (B-COUNT-1), three arms, one const between them (U-10).
+ *
+ * `title` (the default): the count, written, at the title rung. It out-weighs one graphite
+ * stroke and not five, so six people paint lighter than five (G16, below).
+ * `heading`: pass 3's rung, lighter than one stroke in light.
+ * `remainder`: no swap. The five strokes stay and the rest is written after a drawn plus, `+1`.
+ * What it keeps: from six on, the head paints at least 6/5 of five strokes' ink at every count
+ * to sixteen (G16 reads each one). What it does NOT keep, measured: the ink does not
+ * grow with the room. The written rest is a number, and `11` is lighter than `10`, so the head's
+ * ink falls at six of the ten steps from six to sixteen and the ink per person at nine of them
+ * (46.0 at six, 20.1 at sixteen, light). Its other prices: the head keeps growing past five (97.06 at six, 108.66 at fifteen,
+ * 106.45 at sixteen), and a written `1` is not in `6 players`, so the name is the state line and
+ * then the mark read as painted, `6 players, 5 plus 1` (WCAG 2.5.3: the painted digits are in
+ * it, and it says nothing the sheet counts differently).
+ */
+const SIX_ARM = "title" as "title" | "heading" | "remainder";
+const remainder = computed(() =>
+  SIX_ARM === "remainder" && count.value > TALLY_MAX ? count.value - TALLY_MAX : 0,
+);
+/** The mark's accessible name: the state line, and under arm (c) the tally read as painted. */
+const markName = computed(() =>
+  remainder.value
+    ? `${stateLine.value}, ${LOBBY_COPY.plus(TALLY_MAX, remainder.value)}`
+    : stateLine.value,
+);
+const drawn = computed(
+  () => count.value > 0 && (count.value <= TALLY_MAX || remainder.value > 0),
+);
+/** The plus's slot, in viewBox units, and its two strokes: still, pose 0, in the mark's ink. */
+const PLUS_W = 18;
+const plus = [
+  tallyPose0({ key: "plus-h", x1: 5, y1: 22, x2: 15, y2: 22, seed: 7 }),
+  tallyPose0({ key: "plus-v", x1: 10, y1: 16, x2: 10, y2: 28, seed: 19 }),
+];
+const boxWidth = computed(
+  () => PITCH * tallied.value.length + (remainder.value ? PLUS_W : 0),
+);
+const strokes = computed<TallyStroke[]>(() =>
+  tallied.value.map((r) => ({
+    key: keyOf(r),
+    x1: PITCH / 2,
+    y1: 9,
+    x2: PITCH / 2,
+    y2: 35,
+    seed: seedFor(r.id),
+  })),
+);
+const { poses, boilFrame, reducedMotion, drawIn, forget, settle, dashOffset } =
+  useTallyStrokes(() => strokes.value);
+
+/**
+ * THE CROSSING IS A SET DIFFERENCE, and it says only what it does. Gone keys are forgotten
+ * (their tween stops with them); fresh keys draw in; every other stroke is left exactly as it
+ * is — including one still mid-draw (pass-4 gap 3: pass 3 `settle`d the survivors here, which
+ * jumped a drawing stroke to inked for one frame and then let its live tween overwrite it).
+ *
+ * THE LAW, RESTATED (pass-4 gap 2): a departure re-draws no SURVIVOR; the only stroke that ever
+ * draws is one the tally did not hold a tick ago. At six that is real: an inner leaver promotes
+ * the sixth person into the five, and that person's stroke draws in because it was never drawn.
+ */
+watch(
+  ids,
+  (now, was) => {
+    const before = was ?? [];
+    forget(before.filter((k) => !now.includes(k)));
+    const fresh = now.filter((k) => !before.includes(k));
+    if (fresh.length) drawIn(fresh);
+  },
+  { flush: "post" },
+);
+// A mid-draw PRM engage would strand a reveal (the chain force-clears, never finishes):
+// `DifficultyTally`'s own repair, one line.
+watch(reducedMotion, (reduced) => reduced && settle(ids.value));
+
+/** The slot, in viewBox units. A departure moves this and nothing else. */
+const slotAt = (i: number) => `translate(${PITCH * i} 0)`;
+
+/**
+ * THE SEAM (PLR-PLACE pass 4; the leader's ballot, both arms built behind ONE const).
+ *
+ * A mouse press never moves focus: the cell you were writing in keeps it, so `onGridFocusout`
+ * never fires and the room is not told you looked away. The question is a TAP.
+ *   (a) `false`: a tap moves focus like any other tap. Honest, and the room hears `null` — your
+ *       ring leaves every other board while you read who is here.
+ *   (b) `true`: the tap is a look too. The touch is prevented like the mouse press, and because a
+ *       cancelled WebKit `pointerdown` cancels the tap's CLICK with it, the sheet toggles on the
+ *       touch's own `pointerup`. The same holds on the open sheet: a tap on it keeps the cell
+ *       and shuts the sheet on its release.
+ * A keyed open is neither: Tab leaves the cell before the mark is reached, in both arms.
+ *
+ * THE TAP'S OWN CLICK IS KNOWN BY ITS PLACE IN THE SEQUENCE, NEVER BY ITS LABEL. Chromium sends a
+ * touch's click as `pointerType: "touch"`, WebKit labels the same click `"mouse"`, and emulated
+ * WebKit sends none at all after a prevented press. So a release that toggled owes the NEXT click,
+ * whatever it says it is; a new press or a key starts a new sequence and forgives the debt.
+ *
+ * AND THE DEBT ENDS. It is owed for `TAP_CLICK_MS` after the release, read off the two events'
+ * own time stamps. 350ms is ASSERTED, NOT MEASURED: it is WebKit's documented double-tap wait
+ * (Chromium's is 300), taken as the longest a tap's own click can trail its release. No real iOS
+ * tap has been read against it (M19; the RUNSHEET carries the line). If a real tap's own click
+ * lands at or past 350ms, the strict `<` reads it as a new click and the sheet toggles back shut.
+ * The mark's own `touch-action: manipulation` (below) takes the double-tap wait off this button,
+ * so a real tap's click has no zoom gesture to wait out. Unbounded, a WebKit tap (no click follows
+ * it) swallowed the next click that came without a press, however late: the shape of an
+ * assistive-technology activation, which then took two to toggle. What (b) still costs: a
+ * press-less click inside 350ms of a tap is read as that tap's own.
+ *
+ * THE THREE FORGIVENESS CLAUSES ARE THE SEQUENCE LAW, and each is a row (player-mark.spec.ts,
+ * each with its own deletion as the negative): a press forgives (`onPress`: a real mouse click
+ * 111–120ms after a tap was swallowed without it), a key forgives (`onKey`: Enter 117–143ms
+ * after), and a click pays (`onClick`: Chromium's own click for the tap, then a press-less click
+ * 109ms after, was swallowed without it).
+ */
+const TAP_IS_A_LOOK = true;
+// policy: debt
+const TAP_CLICK_MS = 350;
+let owedAt = -Infinity;
+
+function onPress(e: PointerEvent): void {
+  owedAt = -Infinity;
+  if (e.pointerType !== "touch" || TAP_IS_A_LOOK) e.preventDefault();
+}
+function onRelease(e: PointerEvent): void {
+  if (!TAP_IS_A_LOOK || e.pointerType !== "touch") return;
+  toggle();
+  owedAt = e.timeStamp;
+}
+function onClick(e: MouseEvent): void {
+  const owed = e.timeStamp - owedAt < TAP_CLICK_MS;
+  owedAt = -Infinity;
+  if (!owed) toggle();
+}
+function onKey(): void {
+  owedAt = -Infinity;
+}
+function onSheetPress(e: PointerEvent): void {
+  if (e.pointerType !== "touch" || TAP_IS_A_LOOK) e.preventDefault();
+}
+function onSheetRelease(e: PointerEvent): void {
+  if (TAP_IS_A_LOOK && e.pointerType === "touch") close();
+}
+
+// ── Escape, window-bound, one owner — AND THE PHASE IS THE WHOLE OF IT ──────────────────────
+// GameGallery.vue:696-721's paragraph, applied: a key belongs to ONE surface at a time, so the
+// listener exists only while this sheet is open.
+//
+// Pass 3 wrote `preventDefault` and called that ownership. It was not (pass-4 gap 5).
+// `useAnswerKeyPeek.ts:56` answers Escape UNCONDITIONALLY on a `window` keydown registered at
+// mount — earlier than this one, and in the same bubble phase — so with the answer-key peek up
+// and the sheet open the peek read the key FIRST and `defaultPrevented` was still false when it
+// did. `stopImmediatePropagation` cannot reach backwards past a listener that already ran.
+//
+// The cure is the phase. This listener is registered in CAPTURE on `window`, which is the first
+// thing the event touches on its way down, and it stops propagation outright: while this sheet
+// is open, nothing else on the page reads Escape. That is what "one owner" has to mean, and it
+// costs nothing when the sheet is shut because the listener is not there.
+
+const ESCAPE_CAPTURE = { capture: true } as const;
+function onWindowEscape(e: KeyboardEvent): void {
+  if (e.key !== "Escape" || e.defaultPrevented) return;
+  e.preventDefault();
+  e.stopPropagation();
+  e.stopImmediatePropagation();
+  // AND MOVES NOTHING ELSE (PLR-COUNT pass 4, grafted back). Nothing inside the sheet can hold
+  // focus, so there is nothing to return focus FROM: after a keyboard open focus is already on
+  // the mark, and after a mouse open it is in the cell, where it stays.
+  close();
+}
+// FOCUS GOING ANYWHERE ELSE IS A LEAVE (PLR-COUNT pass 4, grafted back). A document `focusin`,
+// bound only while the sheet is open, hears a leave from a cell as well as from the mark, and
+// needs no `relatedTarget` (WebKit hands `null` for a press and for a Tab alike).
+function onDocFocusin(e: FocusEvent): void {
+  if (!el.value?.contains(e.target as Node | null)) close();
+}
+function unbind(): void {
+  window.removeEventListener("keydown", onWindowEscape, ESCAPE_CAPTURE);
+  document.removeEventListener("focusin", onDocFocusin);
+  window.removeEventListener("resize", refit);
+  document.removeEventListener("transitionend", onSettle);
+  cancelAnimationFrame(refitFrame);
+}
+watch(isOpen, (open) => {
+  if (!open) return unbind();
+  window.addEventListener("keydown", onWindowEscape, ESCAPE_CAPTURE);
+  document.addEventListener("focusin", onDocFocusin);
+  window.addEventListener("resize", refit);
+  document.addEventListener("transitionend", onSettle);
+});
+onBeforeUnmount(unbind);
+
+// The head's disclosures share one origin, so they share one open (the module Set in
+// `useHoverCard`). The mark is not a descendant of the card in either head arm, which is why
+// this is a Set and not an injection.
+const unregister = registerHeadDisclosure(close);
+onBeforeUnmount(unregister);
+watch(isOpen, (open) => {
+  if (!open) return;
+  claimHeadDisclosure(close);
+  // THE QUALIFIERS ARE READ AT THE OPEN AND NEVER AGAIN. A held-open sheet that counted
+  // upwards would need a clock the estate does not keep, and would rewrite a line under a
+  // reader who is reading it. What it says is true of the moment they asked.
+  quietAt.value = Object.fromEntries(
+    people.value.map((r) => [r.id, r.self ? null : (props.quietMsOf?.(r.id) ?? null)]),
+  );
+});
+
+const quietAt = ref<Record<string, number | null>>({});
+
+/**
+ * THE SHEET NEVER SCROLLS, SO THE SPACE DECIDES HOW MANY ROWS IT HOLDS — AND THE SPACE IS READ.
+ *
+ * Two budgets: `tall` draws four rows and `and N more`, `short` draws your row and `and N more`.
+ * Both facts are MEASURED, never keyed on a media query (the pass-5 key drew four rows at 390×800
+ * over seven cells where one row lapped none):
+ *   · each sheet's box is read off the sheet ITSELF, laid out and untransformed (the offset box,
+ *     so the 150ms scale-in is not in it) — a wrapped 29-character slug is in it too;
+ *   · the board's box comes from `App.vue`, because pencil may not import a board.
+ * The pose is `rowBudget.ts`'s one predicate, PLR-PLACE's NO-GROWTH rule: the three more rows are
+ * added only where they draw no more of the board than your row alone does (the overlap's area,
+ * both axes). A tall sheet that laps nothing keeps its names untried (390×844 coarse, 1280×900+
+ * fine); one whose added rows lap the board takes one row wherever it hangs, so the desk's corner
+ * (CH-71's pose, 1280×800 fine) laps two cells, not four, and no width between two others flips
+ * the count while the board moves continuously (pass 8's fitted 0.7 flipped at 1040 → 1048 × 768
+ * coarse). What the names cost is now never paid in cells; it is paid in names, and that is the
+ * ballot (B-NAMES): pass 8's priced key is its other arm, by sha, with every cell it flips.
+ * Both reads and the flip happen in one microtask chain, so neither trial budget is ever painted.
+ *
+ * THE SPACE IS READ AGAIN WHEN IT CHANGES UNDER AN OPEN SHEET: on a resize, and when a
+ * transition outside the head comes to rest, one frame later, so a board still sliding is read
+ * where it stops. A read that finds the same board in the same window changes nothing.
+ */
+const ROWS = { tall: 5, short: 2 } as const;
+const cramped = ref(false);
+const budget = computed(() => (cramped.value ? ROWS.short : ROWS.tall));
+
+async function sheetAt(short: boolean) {
+  cramped.value = short;
+  await nextTick();
+  const sheet = document.getElementById(lobbyId);
+  const host = sheet?.offsetParent;
+  if (!sheet || !(host instanceof HTMLElement)) return null;
+  const at = host.getBoundingClientRect();
+  return new DOMRect(
+    at.left + sheet.offsetLeft,
+    at.top + sheet.offsetTop,
+    sheet.offsetWidth,
+    sheet.offsetHeight,
+  );
+}
+
+let fits = 0;
+let space = "";
+async function fit(again = false): Promise<void> {
+  const board = props.boardBox?.();
+  const seen = board
+    ? `${board.left} ${board.top} ${board.right} ${board.bottom} ${innerWidth} ${innerHeight}`
+    : "";
+  if (again && seen === space) return;
+  const run = ++fits;
+  space = seen;
+  const tall = await sheetAt(false);
+  if (run !== fits || !board || !tall || !laps(tall, board)) return;
+  const short = await sheetAt(true);
+  if (run !== fits) return;
+  cramped.value = takesShort(tall, short, board);
+}
+watch([isOpen, () => people.value.length], ([open]) => {
+  if (open) void fit();
+});
+
+let refitFrame = 0;
+function refit(): void {
+  cancelAnimationFrame(refitFrame);
+  refitFrame = requestAnimationFrame(() => void fit(true));
+}
+function onSettle(e: TransitionEvent): void {
+  const t = e.target as Node | null;
+  if (!el.value?.contains(t) && !document.getElementById(lobbyId)?.contains(t)) refit();
+}
+
+const shown = computed(() =>
+  people.value.length <= budget.value
+    ? people.value
+    : people.value.slice(0, budget.value - 1),
+);
+const overflow = computed(() =>
+  people.value.length > shown.value.length
+    ? LOBBY_COPY.more(people.value.length - shown.value.length)
+    : "",
+);
+
+const lines = computed<LobbyLine[]>(() =>
+  shown.value.map((r) => {
+    const quiet = quietAt.value[r.id];
+    return {
+      id: r.id,
+      name: r.name,
+      ink: r.ink,
+      qualifier: r.self
+        ? LOBBY_COPY.self
+        : quiet !== null && quiet !== undefined && quiet >= props.quietAfterMs
+          ? LOBBY_COPY.quiet(Math.floor(quiet / 1000))
+          : "",
+    };
+  }),
+);
+</script>
+
+<template>
+  <!-- `onPress` / `onRelease` are the seam (`TAP_IS_A_LOOK`). Enter and Space are a native
+       button's click and nothing else: the `@keydown.enter` that used to sit beside it ran the
+       handler AND the synthesised click, netting zero (CH-70). -->
+  <button
+    v-if="count"
+    ref="el"
+    type="button"
+    data-player-mark
+    class="player-mark"
+    :class="{ 'is-live': live }"
+    :style="[live ? ink : null, { '--presence-ink-dur': `${MOTION.presenceInkMs}ms` }]"
+    :aria-label="markName"
+    :aria-expanded="isOpen"
+    :aria-controls="lobbyId"
+    @click.stop="onClick"
+    @pointerdown="onPress"
+    @pointerup="onRelease"
+    @keydown="onKey"
+    @focusout="close"
+  >
+    <svg
+      v-if="drawn"
+      class="pt-marks"
+      :class="{ 'is-solo': !live }"
+      :viewBox="`0 0 ${boxWidth} ${BOX_H}`"
+      :style="{ width: `${(boxWidth * 36) / BOX_H}px` }"
+      aria-hidden="true"
+      xmlns="http://www.w3.org/2000/svg"
+    >
+      <!-- Grain-baked pose siblings, opacity-swapped on the shared beat: zero live filters. -->
+      <g
+        v-for="(pose, f) in poses"
+        :key="'pose-' + f"
+        class="pt-pose"
+        :class="{ 'is-active': boilFrame === f }"
+      >
+        <path
+          v-for="(d, i) in pose"
+          :key="ids[i]"
+          :d="d"
+          :transform="slotAt(i)"
+          class="pt-stroke"
+          :style="tallied[i]?.ink"
+          fill="none"
+          stroke-linecap="round"
+          stroke-linejoin="round"
+          pathLength="100"
+          stroke-dasharray="100 100"
+          :stroke-dashoffset="dashOffset(ids[i])"
+        />
+      </g>
+      <g v-if="remainder" class="pt-plus" :transform="slotAt(TALLY_MAX)">
+        <path v-for="d in plus" :key="d" :d="d" fill="none" stroke-linecap="round" />
+      </g>
+    </svg>
+    <span v-if="remainder" class="pt-count is-rest">{{ remainder }}</span>
+    <!-- From six: the count, written, at the TITLE rung. The rung is the price of the swap; the
+         ink table that chose it is in the style block. -->
+    <span
+      v-else-if="!drawn"
+      class="pt-count"
+      :class="{ 'at-heading': SIX_ARM === 'heading' }"
+      >{{ count }}</span
+    >
+  </button>
+  <PlayerLobby
+    v-if="count"
+    :id="lobbyId"
+    :open="isOpen"
+    :state-line="stateLine"
+    :lines="lines"
+    :overflow="overflow"
+    @pointerdown="onSheetPress"
+    @pointerup="onSheetRelease"
+  />
+</template>
+
+<style scoped>
+/* THE BOX IS THE TALLY'S. The `@mbabb` trigger's inline rung and no block padding, so the mark
+   is its strokes plus 2 × 9.888: 44 · 44 · 51.66 · 62.28 · 72.92 at N = 1…5 and 44 from six
+   (the width table, G3). The floor is two-dimensional at a coarse pointer and inline-only at a
+   fine one, where the 36px floor holds the head line still across the 5↔6 swap. */
+.player-mark {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: transparent;
+  border: none;
+  padding: 0 0.618rem;
+  min-width: var(--tap-floor);
+  min-height: 36px;
+  cursor: pointer;
+  font-family: var(--font-hand);
+  line-height: 1;
+  /* THE INK IS BOUND ONCE, HERE: the ring and the written count read it. */
+  --mark-ink: var(--ink-press-quiet);
+  color: var(--mark-ink);
+  transition: color var(--presence-ink-dur) var(--ease-standard);
+  /* The tap debt's bound (`TAP_CLICK_MS`) assumes a tap's own click follows its release
+     promptly. `index.css` scopes `manipulation` to `.board-cells`; the mark is outside it, so
+     it says so on its own hit box: no double-tap zoom here, so no wait before the click. */
+  touch-action: manipulation;
+}
+
+/* Your own index in the room's `k` is bound on this button by `App.vue`, so from two people on
+   `--color-user-ink` here is the colour every other page paints you. */
+.player-mark.is-live {
+  --mark-ink: var(--color-user-ink);
+}
+
+/* The ring takes `currentColor`, so it is the mark's own ink at whatever the room made it — the
+   form is `DrawerTab`'s (R6 law 39); §6's chrome token is adopted the day one ships. */
+.player-mark:focus-visible {
+  outline: 2px dashed currentColor;
+  outline-offset: 3px;
+}
+
+/* `--tap-floor` CONSUMED BARE: T9-W2 §2.6's one static declaration on `.page-root`. */
+@media (pointer: coarse) {
+  .player-mark {
+    min-height: var(--tap-floor);
+  }
+}
+
+.pt-marks {
+  display: block;
+  height: 36px;
+  overflow: visible;
+}
+
+/* Boil: each pose is its own compositing layer, so the beat is a compositor blend. */
+.pt-pose {
+  opacity: 0;
+  will-change: opacity;
+}
+.pt-pose.is-active {
+  opacity: 1;
+}
+
+/* THE STROKE IS THE PERSON'S INK — a peer's inline rebinding of `--color-user-ink` reaches it.
+   Alone, the one stroke is the page's graphite; when a second person arrives YOUR stroke takes
+   your room ink over the leader's 400ms presence beat, and never re-draws to do it. */
+.pt-stroke {
+  stroke: var(--color-user-ink);
+  stroke-width: 3.2;
+  stroke-opacity: 0.95;
+  transition: stroke var(--presence-ink-dur) var(--ease-standard);
+}
+.pt-marks.is-solo .pt-stroke {
+  stroke: var(--color-pencil-graphite);
+}
+
+/* The ink lift, fine pointers only, and only where it cannot dim a colour: the solo stroke. */
+@media (hover: hover) and (pointer: fine) {
+  .player-mark:hover .pt-marks.is-solo .pt-stroke {
+    stroke-opacity: 1;
+  }
+}
+
+/* THE WRITTEN COUNT TAKES THE TITLE RUNG (32.9px), and the reason is a number (G16). ONE run
+   (PLR-COUNT pass 5, `p5-strip`): ink weight, one normaliser per engine and theme, 390 coarse,
+   dpr 3, reduced motion, chromium / webkit.
+     light: one stroke 64.98 / 60.77 · the `6` at heading 53.67 / 53.17 · at title 84.96 / 84.38 ·
+     five strokes 229.78 / 226.44. dark: 60.18 / 62.20 · 75.28 / 73.40 · 118.77 / 116.53 ·
+     263.30 / 264.32.
+   The title rung is the smallest that out-weighs one stroke in both themes and both engines
+   (the heading rung does not, in light), and the 36px floor still holds the head line. It does
+   NOT make the swap monotone: six people paint 0.37 to 0.45 of five, and lighter than two in
+   light. `SIX_ARM` builds the owner's other two answers (U-10); `player-tally.spec.ts` holds the
+   floor on painted bytes. */
+.pt-count {
+  font-size: var(--type-title);
+  font-weight: 500;
+  color: var(--mark-ink);
+}
+.pt-count.at-heading,
+.pt-count.is-rest {
+  font-size: var(--type-heading);
+}
+.pt-plus path {
+  stroke: var(--mark-ink);
+  stroke-width: 3.2;
+  stroke-opacity: 0.95;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .player-mark,
+  .pt-stroke {
+    transition-duration: 0s;
+  }
+}
+</style>
