+<script setup lang="ts">
+import { tallyPose0 } from "@pencil/composables/useTallyStrokes";
+import HeadSheet from "../AttributionCard/HeadSheet.vue";
+import type { LobbyLine } from "./types";
+
+defineProps<{
+  id: string;
+  open: boolean;
+  stateLine: string;
+  lines: LobbyLine[];
+  /** `and 3 more` — the compression line, or empty. */
+  overflow: string;
+}>();
+
+/** The tally's upright at row scale, still — pose 0, no beat inside a sheet. Every row draws
+ *  the same stroke; what differs between rows is whose ink writes it. */
+const rowPose = tallyPose0({ key: "row", x1: 6.5, y1: 9, x2: 6.5, y2: 35, seed: 11 });
+</script>
+
+<template>
+  <!-- THE HEAD'S ONE SHEET (`HeadSheet`: the @mbabb card's hang, fade and drawn edge, shared
+       with it, CH-71), `min-width: 16rem`. Hung off the wrapper rather than off the mark, it
+       opens at the PAGE's left edge — right edge 256, which clears the sun's x = 326 on a phone
+       and 1072 on the desk.
+
+       WHY THE GROUND IS THE ONE THING THAT DEPARTS FROM THE CARD. The card holds two lines over
+       whatever is behind it; this holds a LIST down the page, and what is behind it is the
+       wordmark's own bleed — measured rgb(204,203,203) over 8.9% of the desk sheet's box and
+       27.7% of the state line's. At 80% the quiet rung composites to 91 on that bleed, which is
+       4.23:1 against a local ground of 204: under the AA floor, and true today only because the
+       wordmark's strokes and a 3-to-13-character slug have not yet landed on each other. Luck is
+       not a design, so the arm the estate already wrote for `prefers-reduced-transparency` is
+       promoted to the default and the arm itself is deleted (it would be a no-op). The @mbabb
+       card's ground is untouched. Declared as this family's one DELTA; the owner disposes.
+
+       NO `role`, NO `aria-live`. The room's one `role="log"` stays mounted in the controls card
+       where it can speak whether this sheet is open or shut; a region inside a closed disclosure
+       announces nothing. These rows are plain markup — a disclosure, not a dialog.
+
+       NO `@click.stop`, and that is the phone's dismissal. There is nothing focusable in this
+       box and nothing in it to press, so a tap on it can only mean "I am done reading": it
+       reaches the page root's `closeAll` and shuts the sheet. That is what prices the lap —
+       whatever this sheet covers, one tap uncovers. Shut, it is `pointer-events: none`, so it
+       can never swallow a press meant for the board. -->
+  <HeadSheet :id="id" data-lobby class="player-lobby" :open="open">
+    <p class="pl-state">{{ stateLine }}</p>
+    <ul v-if="lines.length" class="pl-rows">
+      <li v-for="p in lines" :key="p.id" class="pl-row" :style="p.ink">
+        <svg
+          class="pl-stub"
+          viewBox="3.5 7 6 30"
+          aria-hidden="true"
+          xmlns="http://www.w3.org/2000/svg"
+        >
+          <path
+            :d="rowPose"
+            fill="none"
+            stroke="currentColor"
+            stroke-linecap="round"
+            stroke-linejoin="round"
+            stroke-width="3.2"
+            stroke-opacity="0.95"
+          />
+        </svg>
+        <span class="pl-name">{{ p.name }}</span>
+        <span v-if="p.qualifier" class="pl-qual">{{ p.qualifier }}</span>
+      </li>
+    </ul>
+    <p v-if="overflow" class="pl-more">{{ overflow }}</p>
+  </HeadSheet>
