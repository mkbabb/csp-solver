index 00000000..6b35c48d
--- /dev/null
+++ b/web/frontend/src/pencil/chrome/PlayerMark/rowBudget.ts
@@ -0,0 +1,47 @@
+/**
+ * THE ROW BUDGET'S ONE PREDICATE (T9-W7 §11; PLR-PLACE's no-growth rule, registry-v7 §3.3 and
+ * registry-v8 §2: "the fitted 0.7 dies").
+ *
+ * Two trial sheets are drawn and read: `tall` (four rows and `and N more`) and `short` (your row
+ * and `and N more`). The cheaper pose is decided on what each draws over the board, and the three
+ * more rows are added ONLY where they do not grow that: the overlap's AREA, both axes, so a sheet
+ * whose added rows sit beside the board keeps its names and one whose added rows lap a single
+ * more pixel of it does not. There is no fraction and no threshold: pass 8 kept the four rows
+ * while their added share over the board was at most a fitted 0.7, and that constant cliffed at
+ * one width where the board moves continuously (1040 → 1048 × 768 coarse: one row over three
+ * cells, then four over six), read the same fraction on a 9×9 and a 16×16 (three times the cells
+ * on the wider board), and crossed on PLR-PLACE's sheet at 1056 × 768.
+ *
+ * The bound is zero and it is strict: equal areas keep `tall` (the added rows lap nothing), any
+ * growth takes `short`. Its two sides are the unit rows beside this file.
+ */
+export interface Box {
+  left: number;
+  top: number;
+  right: number;
+  bottom: number;
+}
+
+/** An overlap on BOTH axes. */
+export const laps = (a: Box, b: Box): boolean =>
+  a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;
+
+/** How much of `a` the board `b` runs under: the overlap's area. */
+const covered = (a: Box, b: Box): number =>
+  Math.max(0, Math.min(a.right, b.right) - Math.max(a.left, b.left)) *
+  Math.max(0, Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top));
+
+/**
+ * `true` takes the short sheet. A tall sheet that laps nothing is never tried (the caller keeps
+ * it without a second read). A SECOND READ THAT RETURNS NOTHING takes `short`: the sheet's node
+ * or its offset parent was gone between the two reads, the growth cannot be shown to be zero,
+ * and the pose that laps less is the one that cannot cost a cell. Pass 7 kept `tall` there
+ * (`!!short && …`); pass 8 flipped it undeclared (its critic's gap 7). The cell it changes is
+ * any open sheet whose lobby unmounts between the reads, and `short` is the side the room loses
+ * names on, never cells.
+ */
+export function takesShort(tall: Box, short: Box | null, board: Box): boolean {
+  if (!laps(tall, board)) return false;
+  if (!short) return true;
+  return covered(tall, board) > covered(short, board);
+}
