+    const cp = await ctx.newPage();
+    await cp.goto("/?size=3&difficulty=EASY");
+    await settled(cp);
+    const bundle = await cp.evaluate(
+      () => [...document.scripts].map((s) => s.src).find((s) => s.includes("/assets/index-")) ?? "",
+    );
+    const style = await cp.evaluate(
+      ({ at, rung }) => {
+        const host = document.createElement("div");
+        host.style.cssText =
+          "position:fixed;inset:0;z-index:2147483647;pointer-events:none;background:var(--color-popover)";
+        document.body.append(host);
+        return at.map((l, i) => {
+          const p = document.createElement("p");
+          p.id = `g14-anchor-${i}`;
+          p.textContent = l.text;
+          p.style.cssText = `position:absolute;margin:0;white-space:nowrap;left:${l.left}px;top:${l.top}px;${rung[i]}`;
+          host.append(p);
+          const cs = getComputedStyle(p);
+          return [cs.fontFamily, cs.fontSize, cs.fontWeight, cs.lineHeight].join(" | ");
+        });
+      },
+      { at, rung: at.map((l) => TAG_RUNG(l.q)) },
+    );
