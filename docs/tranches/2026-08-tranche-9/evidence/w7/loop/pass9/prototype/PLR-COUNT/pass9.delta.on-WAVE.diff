+      const D = Math.max(...all.map((p) => p.core));
+      const ink = (p: Painted) => inkOf(p.hist, D, 2);
+      const table = Object.fromEntries(
+        Object.keys(at).map((k) => {
+          const N = Number(k);
+          return [N, { ink: ink(at[N]), perPerson: +(ink(at[N]) / N).toFixed(2), planted: ink(planted[N]) }];
+        }),
+      ) as Record<number, { ink: number; perPerson: number; planted: number }>;
+      const falls = Object.keys(table)
+        .map(Number)
+        .filter((N) => N > 6 && table[N].ink < table[N - 1].ink)
+        .map((N) => `${N - 1}→${N}`);
+      const r = {
+        one: ink(one),
+        onePoses: oneAt.map(ink),
+        ground: ink(ground),
+        five: ink(five),
+        fivePerPerson: +(ink(five) / 5).toFixed(2),
