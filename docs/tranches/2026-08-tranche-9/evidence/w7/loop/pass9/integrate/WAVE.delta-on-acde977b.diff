+/** The tap, then `act` as soon as the tap's own click (if the delivery sends one) has landed. */
+async function debtRow(browser: Browser, delivery: Delivery, cut: Clause | null, act: (page: Page) => Promise<void>) {
+  const { ctx, page, read, hits } = await debtPage(browser, delivery, cut);
+  await mark(page).tap();
