+  await settled(page);
+  const T = Date.now();
+  await page.clock.setFixedTime(T);
+  await page.evaluate(({ room }) => {
+    const ch = new BroadcastChannel(`board:${room}`);
+    ch.postMessage({ kind: "hi", data: {}, from: "quiet-peer" });
+    setTimeout(() => ch.close(), 0);
+  }, { room });
+  await expect.poll(() => page.locator(".players-roster .player-row").count()).toBe(2);
+  const qual = async (at: number) => {
+    await page.clock.setFixedTime(T + at);
+    await mark(page).click();
+    await settle(page);
+    const q = await page
+      .locator("[data-lobby]:visible .pl-row")
+      .nth(1)
+      .locator(".pl-qual")
+      .allTextContents();
+    await page.keyboard.press("Escape");
+    // A CLOSE IS A POSE: every sheet is shut when every sheet reads `visibility: hidden`
+    await expect
+      .poll(() =>
+        page.evaluate(() =>
+          [...document.querySelectorAll("[data-lobby]")].every(
+            (e) => getComputedStyle(e).visibility === "hidden",
+          ),
+        ),
+      )
+      .toBe(true);
+    return q;
+  };
+  const early = await qual(5000);
+  const late = await qual(26000);
+  console.log("QUIET", JSON.stringify({ early, late }));
+  expect(early).toEqual([]);
+  expect(late).toEqual(["26 seconds ago"]);
+});
