+      g3b: c3b.length,
+      g4: g4.findings.length,
+    },
+  };
+}
+
+/**
+ * GATE 4 — ONE PUBLISHER, AND EACH ARM SITS AT ITS LIGHTNESS.
+ *
+ * A tin is a TABLE, so it cannot drift at runtime the way a formula does; it drifts AT REST,
+ * when a second hand writes a copy somewhere else and the two part company. The pass-5 cut keyed
+ * a copy on a variable's NAME and on six-digit hexes EQUAL to the sheet, and ten of fourteen
+ * fresh second publishers walked through it (a scalar, a nested neutral key, a drifted table
+ * under a neutral name, a templated `setProperty`, oklch / rgb / 3- and 8-digit literals, a CSS
+ * alias, a `.js` file). This cut keys on the COLOUR, whatever it is called and however spelled:
+ *
+ *   4a  NO SECOND PUBLISHER. Every `.css/.vue/.ts/.mts/.js/.mjs/.html` under `src/` and `e2e/`,
+ *       plus `index.html`, read with comments stripped. RED:
+ *         · a `--color-peer-N[-ring|-name]` or `--peer-*-l` DECLARED anywhere but index.css — a
+ *           rule, a quoted style key, a `setProperty`, and a TEMPLATED name (`--color-peer-${…}`)
+ *           in either of the last two, which is a token minted where no gate can read it;
+ *         · ANY colour literal (hex 3/4/6/8, `rgb[a]()`, `hsl[a]()`, `oklch()`) within ΔE_ok
+ *           `COPY_DE` of a published arm, whatever the name around it. `COPY_DE` is 0.03: the
+ *           section's own pair moving (0.295 → 0.32) is ΔE 0.025–0.027, and the nearest innocent
+ *           literal in the estate is the sun's outline `#D16A32` at 0.0315 (printed every run);
+ *         · a table (array or object literal) of ≥2 colour literals under a peer/ring/hand/player
+ *           /tin/stick name, whatever the colours — a second tin, drifted or new;
+ *         · a lightness-shaped name (`RING_L`, `ringL`, `peerInkLightness`, `tinL`…) bound to a
+ *           number in (0, 1] or to a table of them — a scalar or a nested key, whatever its value.
+ *       In index.css itself: each peer token declared once per arm, and no `--peer-*-l` at all.
+ *   4b  THE LIGHTNESS. Every ring arm's OKLab L sits within `SCALAR_EPS` of `RING_PAIR` (the
+ *       section's pair, registry-v4 §2.4) and every name arm's of `NAME_PAIR` (by day the ring
+ *       arm itself; at night 0.86: 0.84 cleared 4.5 on every pixel over the tape's darkest painted
+ *       ground, but its pink's glyph-text median lost to HEAD's own ink on the flipped top-row
+ *       tape at DPR 1, and 0.86 is the band where no arm does).
+ */
+const RING_PAIR = { light: 0.295, dark: 0.79 };
+const NAME_PAIR = { light: 0.295, dark: 0.86 };
+const SCALAR_EPS = TH.SCALAR_EPS ?? 0.005; // the 8-bit round trip of an authored arm (worst measured 0.0015)
+const COPY_DE = TH.COPY_DE ?? 0.03;
+const PEER_TOKEN = /(--color-peer-\d+(?:-ring|-name)?|--peer-(?:ink|ring|name)-l)/;
+/** a lightness-shaped identifier: RING_L, ringL, ring_l, peerInkL, ringLightness, TIN_L… */
+const L_NAME =
+  /^(?:[A-Za-z]*?)(?:ring|peer|tin|stick|hand|band|name)(?:[-_]?ink)?(?:[-_]?(?:l|lightness|light|lightnesses))$/i;
+
+/** Comments out, strings kept, by the library's STRING-AWARE stripper for the file's language
+ *  (a `/*` inside `accept="image/*"` or a CSS string never opens a comment): a sentence ABOUT a
+ *  band is prose, never a publisher. */
+const uncomment = (text, rel = "x.ts") =>
+  /\.(css|pcss|postcss)$/.test(rel)
+    ? SHAPE.stripCss(text)
+    : /\.(html|svg)$/.test(rel)
+      ? SHAPE.stripCss(SHAPE.stripHtml(text))
