+          // BOTH ENGINES SERIALISE IT AS `color(srgb r g b / a)` WITH 0–1 CHANNELS, which is
+          // the trap this line exists for: read as bytes it is a near-black ground and the
+          // tape's whole reading inverts (measured — 1.626 light where the paper reads 6.5).
+          const m = b.match(/[\d.]+/g)!.map(Number);
