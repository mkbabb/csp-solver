+      let who = null;
+      for (const r of arms[a].cell) {
+        const e = dE(s.hex, r.hex);
+        if (e < m) {
+          m = e;
+          who = r.name;
+        }
+      }
+      worstDe = Math.min(worstDe, m);
+      if (m < ABS_FLOOR && on("g1b"))
