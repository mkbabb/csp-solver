+  const up = r.ev.find((e) => e.k === 'pointerup:touch')!.t;
+  const last = r.ev.filter((e) => e.k.startsWith('click')).pop()!.t;
+  await ctx.close();
+  return { states: r.states, gap: +(last - up).toFixed(1), hits: hits(), ev: r.ev.map((e) => `${e.k}@${(e.t - up).toFixed(0)}`).join(' ') };
