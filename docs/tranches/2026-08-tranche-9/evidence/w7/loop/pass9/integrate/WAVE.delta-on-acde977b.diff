+// ── the read context: the disk, or the self-test's planted tree ─────────────────────────────
+/** Every file the census reads, as absolute paths: the library's `sources` (src/ with tests,
+ *  public/** sheets, index.html, every @import) plus e2e/ and public/** scripts and pages. */
+function makeCtx(plants = new Map(), added = []) {
+  const read = (f) => (plants.has(f) ? plants.get(f) : readFileSync(f, "utf8"));
+  const exists = (f) => plants.has(f) || existsSync(f);
