+      const r = await debtRow(browser, delivery, cut, act);
+      const tag = `${clause} ${delivery} ${cut ? 'CUT' : 'clean'} gap ${r.gap} ms · ${r.ev}`;
+      console.log(`[debt] ${tag} → ${JSON.stringify(r.states)}`);
+      // the activation came inside the debt's window, or the negative proves nothing
+      expect(r.gap, tag).toBeLessThan(350);
