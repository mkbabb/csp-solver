+/** The sibling's stop: the critic's MORE2S/COARSE2S site, later in the walk than the plant stop. */
+const SIBLING_STOP = "button.logo-trigger";
+
+/** One regime's kit: the reads, the probe's verdict with the admissions, the plants, the record. */
+async function g23Kit(page: Page, regime: string) {
+  const edge = await instrument(EDGE_BANDS);
+  const engine = test.info().project.name;
+  const lines: string[] = [];
+  const log = (l: string) => {
+    lines.push(l);
+    console.log(`[G-LIVE-23 ${engine} ${regime}] ${l}`);
+  };
+  const fails: string[] = [];
+  const stale: string[] = [];
+  const brief = (r: Row) =>
+    r.bands
+      ? (Object.entries(r.bands) as [Side, Band][])
+          .map(([s, b]) => `${s} ${b.coreMedian}/${b.stations} u${under(b)} t${b.thickness}${b.dropped ? ` drop ${b.dropped}` : ""}`)
+          .join(" · ")
+      : r.why.join("; ");
+  const read = async (subject: string, edgeSel: string, out: number, inn: number, key: string): Promise<Row> => {
+    // Under `reduce` the beat is frozen and nothing is held; outside it, the read holds the beat.
+    const hold = regime === "reduce" ? null : await holdPoses(page, edgeSel);
+    try {
+      const r = await edge.fourBands(page, { subject, edge: edgeSel, out, inn });
+      return { key, red: r.red, why: r.why, bands: r.bands };
+    } catch (e) {
+      return { key, red: true, why: [`B0 the subject was lost mid-read: ${String(e).split("\n")[0]}`], bands: null };
+    } finally {
+      await hold?.undo();
+    }
+  };
+  /** Focus a stop by key with keyboard modality; the subject is what the RING frames (the declared
+   *  owner first), addressed by id where it has one (the deck re-renders its card's attributes). */
+  const chrome = async (key: string, label = key): Promise<Row | null> => {
+    const f = await focusKey(key);
+    return f ? readKey(f, label) : null;
+  };
+  const readKey = (f: { subject: string; outset: number }, label: string) =>
+    read(f.subject, ".focus-ring", Math.max(6, Math.ceil(f.outset) + 6), Math.max(4, Math.ceil(-f.outset) + 6), label);
+  const focusKey = async (key: string) => {
+    await page.keyboard.press("Shift");
+    const f = await page.evaluate(async (key) => {
+      document.querySelectorAll("[data-gl23]").forEach((e) => e.removeAttribute("data-gl23"));
+      const [tag, cls] = key.split(".");
+      // first class first; a stop keyed by a later home name (the union's `icon-btn info-btn`) by
+      // that name on a laid-out box
+      const all = [...document.querySelectorAll<HTMLElement>(tag)];
+      const el =
+        all.find((n) => (n.getAttribute("class") || "").trim().split(/\s+/)[0] === cls) ??
+        all.find((n) => n.classList.contains(cls) && n.getBoundingClientRect().width > 0);
+      if (!el) return null;
+      (document.activeElement as HTMLElement | null)?.blur();
+      await new Promise((r) => requestAnimationFrame(r));
+      el.scrollIntoView({ block: "center", inline: "nearest" });
+      el.focus();
+      await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
+      const owned = el.getAttribute("aria-activedescendant");
+      const t = (owned && document.getElementById(owned)) || el;
+      t.setAttribute("data-gl23", "");
+      return {
+        took: document.activeElement === el && el.matches(":focus-visible"),
+        subject: owned ? `#${CSS.escape(owned)}` : "[data-gl23]",
+        outset: parseFloat(getComputedStyle(t).getPropertyValue("--focus-ring-outset")) || 0,
+      };
+    }, key);
+    if (!f?.took) return null;
+    await docSettled(page);
+    return f;
+  };
+  /** THE GRID'S BAKED POSES (pass 9, gap 4). Outside `reduce` the board's grid steps through its
+   *  `frameCount` baked bitmaps on the beat, and the frame rule beside the 16×16 frame cell sits at a
+   *  different place in each: pinned one by one on this tree, poses 0–2 read 16 stations under 3:1 and
+   *  pose 3 reads more in chromium (the control reads more again at pose 3). A free read photographs
+   *  ON and OFF at whatever poses the beat deals, so its count drew 16–25 by the clock. The read now
+   *  HOLDS each pose in turn (a read-time sheet, never a product change) and judges every one against
+   *  its own admitted count: `<label> @pose<k>`. */
+  const posed = async (cell: number, label: string, theme: string) => {
+    // by class: an svg `<image>` on this tree, a masked `<div>` beside the svg on the WAVE union
+    const bake = ".board-shell .boil-frame-bitmap";
+    const n = await page.evaluate((s) => document.querySelectorAll(s).length, bake);
+    if (n !== BOIL_CONFIG.frameCount) fails.push(`${theme} ${label}: the grid carries ${n} baked poses, not ${BOIL_CONFIG.frameCount}`);
+    await focusCell(cell);
+    for (let k = 0; k < n; k++) {
+      const hold = await page.addStyleTag({
+        content: `${bake} { opacity: 0 !important; } ${bake}:nth-of-type(${k + 1}) { opacity: 1 !important; }`,
+      });
+      await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+      judge(theme, await read("[data-gl23]", T2, 8, 16, `${label} @pose${k}`));
+      await hold.evaluate((e) => (e as HTMLElement).remove());
+    }
+  };
+  const tier2 = async (cell: number, label: string): Promise<Row> => {
+    await focusCell(cell);
+    return read("[data-gl23]", T2, 8, 16, label);
+  };
+  const focusCell = async (cell: number) => {
+    await page.locator(".board-shell .game-cell .cell-native-input").nth(cell).focus();
+    await page.keyboard.press("Shift");
+    await expect.poll(() => page.evaluate(() => document.querySelectorAll(".game-cell:has(input:focus-visible)").length)).toBe(1);
+    await docSettled(page);
+    await page.evaluate((cell) => {
+      document.querySelectorAll("[data-gl23]").forEach((e) => e.removeAttribute("data-gl23"));
+      document.querySelectorAll(".board-shell .game-cell")[cell].setAttribute("data-gl23", "");
+    }, cell);
+  };
+  /** The verdict is the PROBE's (its `why`); an admitted side forgives only its own B2 line, and only
+   *  at or above its floor. B1/B3/B4 are never forgiven. */
+  const verdict = (r: Row, admittedAs: string, theme: string) => {
+    const adm = G23_ADMITTED[admittedAs];
+    const floors: Floors = adm?.floors[`${engine}/${theme}`] ?? {};
+    if (!r.bands) return { ok: false, stale: [] as string[], say: `${r.key}: ${r.why.join("; ")}` };
+    const kept = r.why.filter((w) => {
+      const m = /^B2 (\w+) core median ([\d.]+)/.exec(w);
+      const f = m ? floors[m[1] as Side] : undefined;
+      return !m || f == null || +m[2] < f;
+    });
+    // THE COUNT (the frame cells): the stations under 3:1 on all four bands, held at the shipped count.
+    const cap = adm?.regimeCounts?.[`${regime}:${engine}/${theme}`] ?? adm?.counts?.[`${engine}/${theme}`];
+    const n = (Object.values(r.bands) as Band[]).reduce((a, b) => a + under(b), 0);
+    if (cap != null && n > cap) kept.push(`COUNT ${n} stations under 3:1 > the admitted ${cap}`);
+    const staleSides: string[] = (Object.keys(floors) as Side[]).filter((s) => r.bands![s].coreMedian >= 3);
+    // THE CAP IS PINNED AT ITS BOUNDARY (pass 9, LAWS P8 §F): the shipped read sits ON the cap
+    // (margin 0); a read under it means the admission is loose by the margin and must be cut to it.
+    if (cap != null && n < cap) staleSides.push(`count ${n} < the admitted ${cap} (loose by ${cap - n})`);
