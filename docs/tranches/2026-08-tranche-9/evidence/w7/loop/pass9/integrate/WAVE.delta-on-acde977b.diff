+// ── 14 · BOTH SIDES OF THE EDGE, and 16 · THE SIDE EDGE (pass-5 critic; pass-8 critic gaps 1, 4, 5) ──
+type Geo = { left: number; top: number; right: number; bottom: number; gridTop: number; gridLeft: number };
+type Aim = Record<string, (g: Geo) => [number, number]>;
+/** One coarse table, one fresh open per tap: the sheet at rest, then a touch at `aim(g)`. A tap
+ *  READS `cell` when a cell took focus (it reached the board) and `none` when nothing did; every
+ *  tap shuts the sheet, in every arm and every cut. */
+async function edgeReads(browser: Browser, height: number, size: number, aim: Aim, cut?: Disjunct | null, width = 390) {
+  const { ctx, pages } = await coarseTable(browser, height, size, cut === undefined ? SABOTAGE : cut, width);
+  const [a] = pages;
+  await a.bringToFront();
+  const read: Record<string, 'cell' | 'none'> = {};
+  const hit: Record<string, string> = {};
+  for (const [key, at] of Object.entries(aim)) {
+    await a.evaluate(() => (document.activeElement as HTMLElement | null)?.blur());
+    await mark(a).tap();
+    const sh = sheet(a);
+    await expect(sh).toBeVisible();
+    await expect.poll(() => sh.evaluate((e) => getComputedStyle(e).opacity)).toBe('1');
+    await stable(() => sh.evaluate((e) => [e.getBoundingClientRect().right, e.getBoundingClientRect().bottom].map((v) => Math.round(v * 10))));
+    const g: Geo = await sh.evaluate((e) => {
+      const r = e.getBoundingClientRect();
+      const cells = [...document.querySelectorAll('.sudoku-cell')].map((c) => c.getBoundingClientRect());
+      const gridTop = Math.min(...cells.map((c) => c.top));
+      const gridLeft = Math.min(...cells.map((c) => c.left));
+      return { left: r.left, top: r.top, right: r.right, bottom: r.bottom, gridTop, gridLeft };
+    });
+    expect(g.bottom, 'this arm laps the board').toBeGreaterThan(g.gridTop);
+    const [x, y] = at(g);
+    // what the page's own hit-test puts under the point (printed): `sheet` when the point is the
+    // sheet's as painted, else the board's (a rounded corner gives its point to what lies beneath)
+    hit[key] = await a.evaluate(([px, py]) => {
+      const t = document.elementFromPoint(px, py);
+      return t?.closest('[data-lobby]') ? 'sheet' : t?.closest('.sudoku-cell') ? 'cell' : (t?.tagName.toLowerCase() ?? 'none');
+    }, [x, y]);
+    await a.touchscreen.tap(x, y);
+    await expect(mark(a)).toHaveAttribute('aria-expanded', 'false');
+    const active = await a.evaluate(() => document.activeElement?.getAttribute('aria-label') ?? '');
+    read[key] = /^Row \d+,/.test(active) ? 'cell' : 'none';
+  }
+  await ctx.close();
+  return { read, hit };
+}
+const BELOW: Aim = Object.fromEntries(
+  [-3, -2, -1, 1, 2, 3, 4, 6, 10].map((d) => [d < 0 ? `in ${-d}px` : `below ${d}px`, (g: Geo) => [60, g.bottom + d] as [number, number]]),
+);
+/** The side band: a touch level with the middle of the lap, 1–3px inside the sheet's right edge
+ *  and 1–6px outside it, where the board runs on to 376. */
+const SIDE: Aim = Object.fromEntries(
+  [-3, -2, -1, 1, 2, 3, 6].map((d) => [d < 0 ? `in ${-d}px` : `out ${d}px`, (g: Geo) => [g.right + d, (Math.max(g.top, g.gridTop) + g.bottom) / 2] as [number, number]]),
+);
+/** The top band (pass 9): on a coarse LANDSCAPE phone the board starts at the top of the page (16)
+ *  and the sheet hangs from 56, overlapping the board's left columns, so the band above the sheet's
+ *  top runs over the board. A touch 2px into the board's first column, 1–3px inside the top and
+ *  1–6px above it. Not the overlap's middle: the overlap is 15px wide and the sheet's corner is
+ *  rounded 16px, so a point 7.5px in from its right and 1px down is the board's as painted (the
+ *  page's own hit-test, printed as `hit`, puts the cell there). */
+const ABOVE: Aim = Object.fromEntries(
+  [-3, -2, -1, 1, 2, 3, 6].map((d) => [d < 0 ? `in ${-d}px` : `above ${d}px`, (g: Geo) => [Math.max(g.left, g.gridLeft) + 2, g.top - d] as [number, number]]),
+);
+const want = (aim: Aim) => Object.fromEntries(Object.keys(aim).map((k) => [k, k.startsWith('in') ? 'none' : 'cell']));
