+          return { n: ps.length, off: last ? Number(last.getAttribute("stroke-dashoffset")) : NaN };
+        };
+        ch.postMessage({ kind: "hi", data: {}, from: "lwp" });
+        // sleep-ok: the elapsed time IS the subject, the leave lands mid-draw and the return after
+        setTimeout(() => ch.postMessage({ kind: "bye", data: {}, from: "lwp" }), 150);
+        setTimeout(() => {
+          ch.postMessage({ kind: "hi", data: {}, from: "lwp" });
+          back = true;
+        }, 250);
+        const tick = () => {
+          out.push({ t: performance.now() - t0, ...read(), back });
+          // sleep-ok: the elapsed window IS the subject, the return's whole draw-in and the first's end
+          if (performance.now() - t0 < 1500) requestAnimationFrame(tick);
+          else {
+            ch.close();
+            done(out);
+          }
+        };
+        requestAnimationFrame(tick);
+      }),
+    { room },
+  );
+  const midFirst = trace.filter((s) => !s.back && s.n === 3).map((s) => s.off);
+  const left = trace.some((s) => !s.back && s.n === 2 && s.t > 150);
+  const ret = trace.filter((s) => s.back && s.n === 3).map((s) => s.off);
+  const start = ret.findIndex((v) => v > 0);
+  const tail = ret.slice(Math.max(0, start));
+  const rises = tail.filter((v, i) => i > 0 && v > tail[i - 1] + 0.01).length;
+  console.log(
+    "LEAVE WHILE PENDING",
+    JSON.stringify({
+      frames: trace.length,
+      firstLastOff: midFirst[midFirst.length - 1],
+      left,
+      returnHead: tail.slice(0, 8).map((v) => +v.toFixed(1)),
+      rises,
+      last: tail[tail.length - 1],
+    }),
+  );
+  expect(midFirst[midFirst.length - 1], "the first draw-in was cut mid-flight").toBeGreaterThan(0);
+  expect(left, "the leave landed").toBe(true);
+  expect(start, "the return draws in").toBeGreaterThanOrEqual(0);
+  expect(rises, "the return's dash only ever falls").toBe(0);
+  expect(tail[tail.length - 1], "and lands").toBe(0);
+});
+
+// ── G16 · the written count's weight, ON PAINTED BYTES, per arm and per theme, EVERY count ─────
+// Ink weight, one normaliser for every crop compared, reduced motion so every stroke is inked, and
+// THE POSE PARKED: the boil beat swaps four grain poses under reduced motion too, and `one` read
+// ±4.5 % with the pose index (pass-6 critic), so every crop shows pose 0 only and the spread over
+// the four poses is printed beside it. A ground arm (the mark's ink hidden) must read no ink, so
+// nothing but the mark is in the crop.
+// KEYED ON `SIX_ARM`, and read at EVERY count the design names, 6 to 16 (LAWS P6 §E: pass 6 read
+// six alone, and arm (c)'s clause was false at six of the ten later steps):
+//   (a) title / (b) heading — the FLOOR: every written count out-weighs one graphite stroke.
+//       Plant: a rung the floor must see as lighter than one, at six AND at seven (the thinnest
+//       numeral: ×1.19 of one against six's ×1.41). In light that is the rung below title
+//       (heading); in dark the heading rung clears one stroke, so the dark plant is the body rung.
+//       Arm (b) is RED in light by design: that is its ballot price.
+//   (c) remainder — every count from six paints at least 6/5 of five strokes' ink. It does NOT
+//       promise the ink grows with the room: a written number is not monotone in its value, and
+//       the table printed here is the ballot's (ink and ink per person at every count). Plant: the
+//       remainder and its plus hidden, read at every count, must fall under the bar.
+const G16_PLANT = (theme: "light" | "dark"): string =>
+  SIX_ARM === "remainder"
+    ? ".pt-count.is-rest, .pt-plus { visibility: hidden !important; }"
+    : SIX_ARM === "title" && theme === "light"
+      ? ".pt-count { font-size: var(--type-heading) !important; }"
+      : ".pt-count { font-size: var(--type-body) !important; }";
+const parkPose = (k: number) =>
+  `.pt-marks > g.pt-pose { opacity: 0 !important; } .pt-marks > g.pt-pose:nth-of-type(${k}) { opacity: 1 !important; }`;
+for (const theme of ["light", "dark"] as const)
+  test.describe(`the written count's weight · ${theme}`, () => {
+    test.use({
+      viewport: { width: 1280, height: 800 },
+      deviceScaleFactor: 2,
+      colorScheme: theme,
+      contextOptions: { reducedMotion: "reduce" },
+    });
+    test(`every count from six against one and five, and the plant that breaks the promise (${SIX_ARM}, ${theme})`, async ({
+      page,
+    }) => {
+      test.setTimeout(240_000);
+      const room = `tally-ink-${theme}-${Date.now()}`;
+      // THE STROKE IS PINNED, not only the pose: `one` is this page's own stroke, seeded by its id
+      // over 97 poses, so an unpinned run draws a different `one` every time (pass-7 critic: 4.2
+      // ink units between ids). B's id and the peers' `tally-n` fix every stroke on the page.
+      await pinId(page, room);
+      await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+      await settled(page);
+      expect(
+        await page.evaluate(() => document.documentElement.classList.contains("dark")),
+      ).toBe(theme === "dark");
+      expect(await boundId(page, room), "the page is B").toBe(B_ID);
+      await page.mouse.move(640, 790);
+      const crop = async (css?: string) => {
+        const t = css ? await page.addStyleTag({ content: css }) : null;
+        await stable(() => mark(page).evaluate((e) => e.getBoundingClientRect().width));
+        const p = await painted(page, await mark(page).screenshot({ animations: "disabled" }));
+        if (t) await t.evaluate((e) => (e as HTMLElement).remove());
+        return p;
+      };
+      const oneAt: Painted[] = [];
+      for (const k of [1, 2, 3, 4]) oneAt.push(await crop(parkPose(k)));
+      const one = oneAt[0];
+      const park = await page.addStyleTag({ content: parkPose(1) });
+      const ground = await crop(".pt-marks, .pt-count { visibility: hidden !important; }");
+      await peers(page, room, 4);
+      const five = await crop();
+      const at: Record<number, Painted> = {};
+      const planted: Record<number, Painted> = {};
+      for (let N = 6; N <= 16; N++) {
+        await peers(page, room, 1);
+        at[N] = await crop();
+        planted[N] = await crop(G16_PLANT(theme));
+      }
+      await park.evaluate((t) => (t as HTMLElement).remove());
+      const all = [...oneAt, ground, five, ...Object.values(at), ...Object.values(planted)];
+      const D = Math.max(...all.map((p) => p.core));
+      const ink = (p: Painted) => inkOf(p.hist, D, 2);
+      const table = Object.fromEntries(
+        Object.keys(at).map((k) => {
+          const N = Number(k);
+          return [N, { ink: ink(at[N]), perPerson: +(ink(at[N]) / N).toFixed(2), planted: ink(planted[N]) }];
+        }),
+      ) as Record<number, { ink: number; perPerson: number; planted: number }>;
+      const falls = Object.keys(table)
+        .map(Number)
+        .filter((N) => N > 6 && table[N].ink < table[N - 1].ink)
+        .map((N) => `${N - 1}→${N}`);
+      const r = {
+        one: ink(one),
+        onePoses: oneAt.map(ink),
+        ground: ink(ground),
+        five: ink(five),
+        fivePerPerson: +(ink(five) / 5).toFixed(2),
+      };
+      // the plant's margin under its bar, at six and seven, printed (the row's thinnest reads)
+      const bar = SIX_ARM === "remainder" ? (6 / 5) * r.five : Math.min(...r.onePoses);
+      const margin = Object.fromEntries(
+        [6, 7].map((N) => [N, +(1 - table[N].planted / bar).toFixed(4)]),
+      );
+      console.log(
+        "G16",
+        JSON.stringify({
+          engine: test.info().project.name,
+          arm: SIX_ARM,
+          theme,
+          ids: `${B_ID} + tally-0…14`,
+          D,
+          ...r,
+          table,
+          falls,
+          margin,
+        }),
+      );
+      // THE CROP IS THE MARK: with its ink hidden it reads (nearly) nothing
+      expect(r.ground, "the ground arm reads no ink").toBeLessThan(0.02 * r.one);
+      for (let N = 6; N <= 16; N++) {
+        if (SIX_ARM === "remainder") {
+          const bar = (6 / 5) * r.five;
+          expect(table[N].ink, `${N} paints 6/5 of five`).toBeGreaterThanOrEqual(bar);
+          expect(table[N].planted, `${N} with the remainder hidden is SEEN under the bar`).toBeLessThan(bar);
+        } else {
+          // against one's HEAVIEST pose, so no pose of one is ever heavier than a written count
+          expect(table[N].ink, `${N} out-weighs one`).toBeGreaterThanOrEqual(Math.max(...r.onePoses));
+        }
+      }
+      if (SIX_ARM !== "remainder")
+        for (const N of [6, 7])
+          // against one's LIGHTEST pose: the plant is seen whatever pose one is drawn in
+          expect(table[N].planted, `the planted rung at ${N} is SEEN as lighter than one`).toBeLessThan(
+            Math.min(...r.onePoses),
+          );
+    });
+  });
+
+// ── LOBBY_ARIA_ONLY's behavioural twin (SHAPE law iii; the pass-8 critic's gap 8) ─────────────
+// `check-font-coverage.mjs` drops `LOBBY_COPY.plus` from the painted corpus by name, on the claim
+// that its line reaches ONLY the mark's `:aria-label`. A source claim owes its twin on the page: at
+// six and at sixteen people, under the arm the source ships, no text on the page outside an
+// `aria-label` holds a `plus` line (every text node under <body>, every `title`, every ::before /
+// ::after `content`), and under arm (c) the mark's accessible name does. The plant paints the line
+// into the mark in the run, the shape a `{{ markName }}` paint would ship, and the row must SEE it.
+const PLUS = /plus:\s*\([^)]*\)\s*=>\s*`\$\{\w+\}([^`$]*)\$\{\w+\}`/.exec(
+  readFileSync(
+    fileURLToPath(new URL("../src/pencil/chrome/PlayerMark/copy.ts", import.meta.url)),
+    "utf8",
+  ),
+)![1];
+const PLUS_LINE = new RegExp(`\\d+${PLUS.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}\\d+`);
+/** Every string the page shows outside an accessible name. */
+const shown = (page: Page) =>
+  page.evaluate(() => {
+    const out: string[] = [];
+    const tw = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
+    for (let n = tw.nextNode(); n; n = tw.nextNode()) {
+      if (n.parentElement?.closest("script, style, template, noscript")) continue;
+      if (n.textContent?.trim()) out.push(n.textContent);
+    }
+    for (const el of document.body.querySelectorAll("*")) {
+      const t = el.getAttribute("title");
+      if (t) out.push(t);
+      for (const p of ["::before", "::after"]) {
+        const c = getComputedStyle(el, p).content;
+        if (c && c !== "none" && c !== "normal") out.push(c);
+      }
+    }
+    return out.join("\n");
+  });
+test("the `plus` line reaches only the mark's accessible name (LOBBY_ARIA_ONLY's twin)", async ({
+  page,
+}) => {
+  const room = `tally-plus-${Date.now()}`;
+  await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+  await settled(page);
+  const reads: { N: number; name: string | null; shown: string | null }[] = [];
+  for (const [k, N] of [
+    [5, 6],
+    [10, 16],
+  ] as const) {
+    await peers(page, room, k);
+    const name = await mark(page).getAttribute("aria-label");
+    reads.push({ N, name, shown: PLUS_LINE.exec(await shown(page))?.[0] ?? null });
+  }
+  await mark(page).evaluate((el, s) => {
+    const t = document.createElement("span");
+    t.textContent = s;
+    el.append(t);
+  }, `5${PLUS}11`);
+  const plantSeen = PLUS_LINE.exec(await shown(page))?.[0] ?? null;
+  console.log("PLUS", JSON.stringify({ engine: test.info().project.name, arm: SIX_ARM, PLUS, reads, plantSeen }));
+  expect(plantSeen, "the planted plus line is SEEN").toBe(`5${PLUS}11`);
+  for (const r of reads) {
+    expect(r.shown, `no shown text holds a plus line at ${r.N}`).toBeNull();
+    expect(PLUS_LINE.test(r.name ?? ""), `the name holds the plus line at ${r.N} under arm (c) only`).toBe(
+      SIX_ARM === "remainder",
+    );
+  }
+});
+
+// ── G4 · the board's own ink, with a room on it (two pages, one context) ───────────────────
+// F1 is the head's; the BOARD is not moved by it. `authorInk` binds a cell only for a PEER's
+// write, so with the room live: no write binds 0 cells, your own write binds 0, a peer's binds
+// exactly 1. The peer half is read by `expect.poll` on the page that did NOT write — both
+// engines, never `bringToFront` (a focus change is not a transport).
+test("the board binds no ink for your own writes and one cell for a peer's", async ({
+  browser,
+}) => {
+  const ctx = await browser.newContext();
+  const a = await ctx.newPage();
+  await a.goto("/?size=3&difficulty=EASY&wire=local");
+  await settled(a);
+  // B joins through the PRODUCT's own invite: `shareSession` stamps `?s=` AND the encoded
+  // `?board=` payload, so both pages hold one grid (the chair's codec addendum).
+  const verb = a.locator('.controls-card button[aria-label="Play together on this board"]');
+  await expect(verb).toBeEnabled();
+  if (!(await verb.isVisible())) {
+    await a.locator(".drawer-tab").first().click();
+    await a.waitForTimeout(700); // the dock SLIDES — settle the pose
+  }
+  await verb.click();
+  await expect.poll(() => new URL(a.url()).searchParams.get("board")).not.toBeNull();
+  const b = await ctx.newPage();
+  await b.goto(a.url());
+  await settled(b);
+  await expect.poll(() => a.locator(".players-roster .player-row").count()).toBe(2);
+
+  const bound = (p: Page) =>
+    p.evaluate(
+      () =>
+        [...document.querySelectorAll(".sudoku-cell")].filter((c) =>
+          (c as HTMLElement).style.getPropertyValue("--color-user-ink"),
+        ).length,
+    );
+  const empties = await a.evaluate(() =>
+    [...document.querySelectorAll(".sudoku-cell input")]
+      .map((i, n) => ((i as HTMLInputElement).value ? -1 : n))
+      .filter((n) => n >= 0),
+  );
+  const cells = await a.locator(".sudoku-cell").count();
+  const write = (p: Page, index: number, digit: number) =>
+    p.evaluate(
+      ([i, d]) => {
+        const el = document.querySelectorAll(".sudoku-cell input")[i] as HTMLInputElement;
+        el.focus();
+        el.value = String(d);
+        el.dispatchEvent(new Event("input", { bubbles: true }));
+      },
+      [index, digit],
+    );
+  const digitAt = (p: Page, i: number) =>
+    p.evaluate((i) => (document.querySelectorAll(".sudoku-cell input")[i] as HTMLInputElement).value, i);
+
+  const none = await bound(a);
+  await write(a, empties[0], 1);
+  await expect.poll(() => digitAt(b, empties[0])).toBe("1");
+  const selfWrite = await bound(a);
+  // B moves its caret OFF the cell it writes, so a cursor binding cannot pose as authorship.
+  await write(b, empties[1], 2);
+  await b.evaluate(() => (document.activeElement as HTMLElement | null)?.blur());
+  await expect.poll(() => digitAt(a, empties[1])).toBe("2");
+  await expect.poll(() => bound(a)).toBe(1);
+  const peerWrite = await bound(a);
+  console.log("AUTHOR INK", JSON.stringify({ cells, none, selfWrite, peerWrite }));
+  expect(cells).toBe(81);
+  expect([none, selfWrite, peerWrite]).toEqual([0, 0, 1]);
+  await ctx.close();
+});
+
+// ── G15 · M19-whole: a third person arrives while you are writing ──────────────────────────
+// The mark is the one thing in the head that changes on a join, and it changes WITHOUT taking
+// anything from the reader: the caret stays in the cell, the sheet stays shut, the name moves.
+test("a third join re-names the mark and moves nothing else", async ({ page }) => {
+  const room = `tally-m19-${Date.now()}`;
+  await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+  await settled(page);
+  await peers(page, room, 1); // two at the table
+  const cell = page.locator(".sudoku-cell input").nth(40);
+  await cell.focus();
+  const before = await page.evaluate(() => {
+    const m = [...document.querySelectorAll("[data-player-mark]")].find(
+      (e) => e.getBoundingClientRect().width > 0,
+    )!;
+    return {
+      label: m.getAttribute("aria-label"),
+      expanded: m.getAttribute("aria-expanded"),
+      focus: (document.activeElement as HTMLElement | null)?.closest(".sudoku-cell") !== null,
+      pos: [...document.querySelectorAll(".sudoku-cell input")].indexOf(
+        document.activeElement as HTMLInputElement,
+      ),
+    };
+  });
+  await peers(page, room, 1); // the third
+  const after = await page.evaluate(() => {
+    const m = [...document.querySelectorAll("[data-player-mark]")].find(
+      (e) => e.getBoundingClientRect().width > 0,
+    )!;
+    return {
+      label: m.getAttribute("aria-label"),
+      expanded: m.getAttribute("aria-expanded"),
+      focus: (document.activeElement as HTMLElement | null)?.closest(".sudoku-cell") !== null,
+      pos: [...document.querySelectorAll(".sudoku-cell input")].indexOf(
+        document.activeElement as HTMLInputElement,
+      ),
+    };
+  });
+  console.log("M19", JSON.stringify({ before, after }));
+  expect(before).toEqual({ label: "2 players", expanded: "false", focus: true, pos: 40 });
+  expect(after).toEqual({ label: "3 players", expanded: "false", focus: true, pos: 40 });
+});
+
+// ── The quiet qualifier, on a fixed clock ──────────────────────────────────────────────────
+// `N seconds ago` is read at the OPEN against the moment the peer was last heard. A fixed clock
+// makes the number a fact rather than a race: heard at T, opened at T + 26 s, reads 26. The
+// negative control is the same peer opened at T + 5 s — under the 20 s threshold, no qualifier.
+test("a peer quiet for 26 seconds reads '26 seconds ago', and one quiet for 5 reads nothing", async ({
+  page,
+}) => {
+  await page.setViewportSize({ width: 1280, height: 800 });
+  const room = `tally-quiet-${Date.now()}`;
