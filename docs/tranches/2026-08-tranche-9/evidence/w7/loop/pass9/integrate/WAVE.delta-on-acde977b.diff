+const pending: Record<string, number | null> = {};
+const timers: Record<string, ReturnType<typeof setTimeout>> = {};
+function stopTimers(): void {
+  for (const id of Object.keys(timers)) {
+    clearTimeout(timers[id]);
+    delete timers[id];
+  }
+}
+// NOT `deep`. The session replaces the `cur` map on every change, so identity IS the change; a
+// deep watch re-ran this on every re-run of the getter, and `App.vue` rebuilds `place` whenever
+// your own cell moves, so your own walk re-armed the room's clocks as well.
+watch([isOpen, () => props.place?.cursors], ([open, now], [wasOpen]) => {
+  if (!open || !now) return stopTimers();
+  if (!wasOpen) {
+    stopTimers();
+    settled.value = { ...now };
+    return;
+  }
+  for (const [id, pos] of Object.entries(now)) {
+    if (id in timers && pending[id] === pos) continue;
+    clearTimeout(timers[id]);
+    delete timers[id];
+    if (settled.value[id] === pos) continue;
+    pending[id] = pos;
+    timers[id] = setTimeout(() => {
+      delete timers[id];
+      settled.value = { ...settled.value, [id]: pos };
+    }, props.place!.settleMs);
+  }
+  // THE LEAVE WALKS EVERY CLOCK, not the settled set alone (pass-5 critic, THE GHOST): a peer
+  // whose FIRST move since the open is still pending has a timer and no settled cell, and a leave
+  // or a deal (the session empties the map) that skipped them let the timer fire later and draw
+  // them on a cell of a board that is gone.
+  for (const id of new Set([...Object.keys(settled.value), ...Object.keys(timers)])) {
+    if (id in now) continue;
+    clearTimeout(timers[id]);
+    delete timers[id];
+    if (!(id in settled.value)) continue;
+    const { [id]: _gone, ...rest } = settled.value;
+    settled.value = rest;
+  }
+});
+/** YOUR RING, READ WHILE THE SHEET IS OPEN AND HELD WHILE IT IS SHUT. The chart stays mounted
+ *  through the close's fade, so nothing on it may move once the sheet is going (a shut sheet
+ *  that redraws your ring as you write is a mutation nobody can see, on a head that is still). */
+const selfAt = ref<number | null>(null);
+watch([isOpen, () => props.place?.self ?? null], ([open, at]) => {
+  if (open) selfAt.value = at;
+});
+onBeforeUnmount(stopTimers);
+
+const placed = (id: string) => typeof settled.value[id] === "number";
+
+/** A seating chart of a room with nobody else in it is not a chart, so it draws only when the
+ *  room is ≥2. A peer with no settled cell, or with no ink, has a row and no dot: BoardHost's
+ *  law, an unknown author gets no colour, and a fallback here would draw a stranger in yours. */
+const chart = computed<PlaceChartInput | null>(() => {
+  const p = props.place;
+  if (!p || !live.value || yielded.value) return null;
+  return {
+    size: p.size,
+    subgrid: p.subgrid,
+    self: selfAt.value,
+    // YOUR RING IS YOUR MARK'S INK. Unbound, the ring inherited the estate's default
+    // `--color-user-ink` (the incumbent blue) while the mark beside it wore the room's colour
+    // for you: two colours for one person on one sheet (pass 4, frame 2).
+    selfInk: props.ink,
+    peers: props.rows
+      .filter((r) => !r.self && placed(r.id) && r.ink["--color-user-ink"])
+      .map((r) => ({
+        id: r.id,
+        ink: r.ink["--color-user-ink"],
+        pos: settled.value[r.id] as number,
+      })),
+  };
+});
+
+const lines = computed<LobbyLine[]>(() =>
+  shown.value.map((r) => {
+    const quiet = quietAt.value[r.id];
+    return {
+      id: r.id,
+      name: r.name,
+      ink: r.ink,
+      qualifier: r.self
+        ? LOBBY_COPY.self
+        : quiet !== null && quiet !== undefined && quiet >= props.quietAfterMs
+          ? LOBBY_COPY.quiet(Math.floor(quiet / 1000))
+          : chart.value && !placed(r.id)
+            ? LOBBY_COPY.unplaced
+            : "",
+    };
+  }),
+);
+</script>
+
+<template>
+  <!-- `onPress` / `onRelease` are the seam (`TAP_IS_A_LOOK`). Enter and Space are a native
+       button's click and nothing else: the `@keydown.enter` that used to sit beside it ran the
+       handler AND the synthesised click, netting zero (CH-70). -->
+  <button
+    v-if="count"
+    ref="el"
+    type="button"
+    data-player-mark
+    class="player-mark"
+    :class="{ 'is-live': live }"
+    :style="[live ? ink : null, { '--presence-ink-dur': `${MOTION.presenceInkMs}ms` }]"
+    :aria-label="markName"
+    :aria-expanded="isOpen"
+    :aria-controls="lobbyId"
+    @click.stop="onClick"
+    @pointerdown="onPress"
+    @pointerup="onRelease"
+    @keydown="onKey"
+    @focusout="close"
+  >
+    <svg
+      v-if="drawn"
+      class="pt-marks"
+      :class="{ 'is-solo': !live }"
+      :viewBox="`0 0 ${boxWidth} ${BOX_H}`"
+      :style="{ width: `${(boxWidth * 36) / BOX_H}px` }"
+      aria-hidden="true"
+      xmlns="http://www.w3.org/2000/svg"
+    >
+      <!-- Grain-baked pose siblings, opacity-swapped on the shared beat: zero live filters. -->
+      <g
+        v-for="(pose, f) in poses"
+        :key="'pose-' + f"
+        class="pt-pose"
+        :class="{ 'is-active': boilFrame === f }"
+      >
+        <path
+          v-for="(d, i) in pose"
+          :key="ids[i]"
+          :d="d"
+          :transform="slotAt(i)"
+          class="pt-stroke"
+          :style="tallied[i]?.ink"
+          fill="none"
+          stroke-linecap="round"
+          stroke-linejoin="round"
+          pathLength="100"
+          stroke-dasharray="100 100"
+          :stroke-dashoffset="dashOffset(ids[i])"
+        />
+      </g>
+      <g v-if="remainder" class="pt-plus" :transform="slotAt(TALLY_MAX)">
+        <path v-for="d in plus" :key="d" :d="d" fill="none" stroke-linecap="round" />
+      </g>
+    </svg>
+    <span v-if="remainder" class="pt-count is-rest">{{ remainder }}</span>
+    <!-- From six: the count, written, at the TITLE rung. The rung is the price of the swap; the
+         ink table that chose it is in the style block. -->
+    <span
+      v-else-if="!drawn"
+      class="pt-count"
+      :class="{ 'at-heading': SIX_ARM === 'heading' }"
+      >{{ count }}</span
+    >
+  </button>
+  <!-- THE SHEET ANSWERS ITS OWN TAP, AND THE TAP ENDS ON IT (pass-4 critic, the thin lap; pass 7).
+       A touch on the open sheet is prevented at its press and shuts the sheet at its release (the
+       seam, above). The release shuts it before Chromium's tap gesture has finished, and the tap
+       then ended on the cell under the sheet (row 7, Chromium: focus reached that cell; WebKit sends
+       no click after a prevented press and was never affected). A prevented `touchend` asks for
+       no click at all, so the tap ends on the sheet in both engines. `@click="close"` stays for
+       Chromium's taps 1–3px inside the bottom edge (rows 12 and 14 red there without it; no `.stop`:
+       the page root still hears it). A mouse press on the sheet is shut by the page root alone.
+       A touch from OUTSIDE the box (Chromium's aim, 1–3px below the edge) prevents nothing and
+       passes to the board (`onSheetPress`, pass 8; row 14). -->
+  <PlayerLobby
+    v-if="count"
+    :id="lobbyId"
+    :open="isOpen"
+    :state-line="stateLine"
+    :lines="lines"
+    :overflow="overflow"
+    :chart="chart"
+    @click="close"
+    @touchend="onSheetTouchEnd"
+    @pointerdown="onSheetPress"
+    @pointerup="onSheetRelease"
+  />
+</template>
+
+<style scoped>
+/* THE BOX IS THE TALLY'S. The `@mbabb` trigger's inline rung and no block padding, so the mark
+   is its strokes plus 2 × 9.888: 44 · 44 · 51.66 · 62.28 · 72.92 at N = 1…5 and 44 from six
+   (the width table, G3). The floor is two-dimensional at a coarse pointer and inline-only at a
+   fine one, where the 36px floor holds the head line still across the 5↔6 swap. */
+.player-mark {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: transparent;
+  border: none;
+  padding: 0 0.618rem;
+  min-width: var(--tap-floor);
+  min-height: 36px;
+  cursor: pointer;
+  font-family: var(--font-hand);
+  line-height: 1;
+  /* THE INK IS BOUND ONCE, HERE: the ring and the written count read it. */
+  --mark-ink: var(--ink-press-quiet);
+  color: var(--mark-ink);
+  transition: color var(--presence-ink-dur) var(--ease-standard);
+  /* The tap debt's bound (`TAP_CLICK_MS`) assumes a tap's own click follows its release
+     promptly. `index.css` scopes `manipulation` to `.board-cells`; the mark is outside it, so
+     it says so on its own hit box: no double-tap zoom here, so no wait before the click. */
+  touch-action: manipulation;
+}
+
+/* Your own index in the room's `k` is bound on this button by `App.vue`, so from two people on
+   `--color-user-ink` here is the colour every other page paints you. */
+.player-mark.is-live {
+  --mark-ink: var(--color-user-ink);
+}
+
+/* The ring takes `currentColor`, so it is the mark's own ink at whatever the room made it — the
+   form is `DrawerTab`'s (R6 law 39); §6's chrome token is adopted the day one ships. */
+.player-mark:focus-visible {
+  outline: 2px dashed currentColor;
+  outline-offset: 3px;
+}
+
+/* `--tap-floor` CONSUMED BARE: T9-W2 §2.6's one static declaration on `.page-root`. */
+@media (pointer: coarse) {
+  .player-mark {
+    min-height: var(--tap-floor);
+  }
+}
+
+.pt-marks {
+  display: block;
+  height: 36px;
+  overflow: visible;
+}
+
+/* Boil: each pose is its own compositing layer, so the beat is a compositor blend. */
+.pt-pose {
+  opacity: 0;
+  will-change: opacity;
+}
+.pt-pose.is-active {
+  opacity: 1;
+}
+
+/* THE STROKE IS THE PERSON'S INK — a peer's inline rebinding of `--color-user-ink` reaches it.
+   Alone, the one stroke is the page's graphite; when a second person arrives YOUR stroke takes
+   your room ink over the leader's 400ms presence beat, and never re-draws to do it. */
+.pt-stroke {
+  stroke: var(--color-user-ink);
+  stroke-width: 3.2;
+  stroke-opacity: 0.95;
+  transition: stroke var(--presence-ink-dur) var(--ease-standard);
+}
+.pt-marks.is-solo .pt-stroke {
+  stroke: var(--color-pencil-graphite);
+}
+
+/* The ink lift, fine pointers only, and only where it cannot dim a colour: the solo stroke. */
+@media (hover: hover) and (pointer: fine) {
+  .player-mark:hover .pt-marks.is-solo .pt-stroke {
+    stroke-opacity: 1;
+  }
+}
+
+/* THE WRITTEN COUNT TAKES THE TITLE RUNG (32.9px), and the reason is a number (G16). ONE run
+   (PLR-COUNT pass 5, `p5-strip`): ink weight, one normaliser per engine and theme, 390 coarse,
+   dpr 3, reduced motion, chromium / webkit.
+     light: one stroke 64.98 / 60.77 · the `6` at heading 53.67 / 53.17 · at title 84.96 / 84.38 ·
+     five strokes 229.78 / 226.44. dark: 60.18 / 62.20 · 75.28 / 73.40 · 118.77 / 116.53 ·
+     263.30 / 264.32.
+   The title rung is the smallest that out-weighs one stroke in both themes and both engines
+   (the heading rung does not, in light), and the 36px floor still holds the head line. It does
+   NOT make the swap monotone: six people paint 0.37 to 0.45 of five, and lighter than two in
+   light. `SIX_ARM` builds the owner's other two answers (U-10); `player-tally.spec.ts` holds the
+   floor on painted bytes. */
+.pt-count {
+  font-size: var(--type-title);
+  font-weight: 500;
+  color: var(--mark-ink);
+}
+.pt-count.at-heading,
+.pt-count.is-rest {
+  font-size: var(--type-heading);
+}
+.pt-plus path {
+  stroke: var(--mark-ink);
+  stroke-width: 3.2;
+  stroke-opacity: 0.95;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .player-mark,
+  .pt-stroke {
+    transition-duration: 0s;
+  }
+}
+</style>
