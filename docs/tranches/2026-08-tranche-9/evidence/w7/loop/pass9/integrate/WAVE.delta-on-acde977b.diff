+    await ctx.addInitScript(() => {
+      let pending: ReturnType<typeof setTimeout> | null = null;
+      const fire = (t: EventTarget, x: number, y: number) =>
+        t.dispatchEvent(new PointerEvent('click', { bubbles: true, cancelable: true, composed: true, pointerType: 'mouse', clientX: x, clientY: y, button: 0 }));
+      addEventListener('pointerup', (e) => {
+        if (!e.isTrusted || e.pointerType !== 'touch') return;
+        const t = e.target!, x = e.clientX, y = e.clientY;
+        pending = setTimeout(() => ((pending = null), fire(t, x, y)), 60);
+      }, { capture: true });
+      addEventListener('click', (e) => {
+        if (!e.isTrusted || (e as PointerEvent).pointerType !== 'touch') return;
+        if (pending) {
+          clearTimeout(pending);
+          pending = null;
+        }
+        e.stopImmediatePropagation();
+        e.preventDefault();
+        const t = e.target!, x = e.clientX, y = e.clientY;
+        queueMicrotask(() => fire(t, x, y));
