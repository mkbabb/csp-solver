+/** The PNG's per-pixel ink coverage against the light paper and ink, in the encoded channels (the
+ *  rasteriser composites there), and its fit to the analytic raster: mean |Δ| and IoU at 0.5. */
+export function tie(img, ras, paper, ink) {
+  const P = paper.rgb.map((v) => v * 255);
+  const I = ink.rgb.map((v) => v * 255);
+  let sum = 0;
+  let inter = 0;
+  let union = 0;
+  const off = new Uint8Array(img.rgba.length); // |Δcoverage| > 0.5: a pixel the path does not explain
+  for (let i = 0; i < img.rgba.length; i++) {
+    const a =
+      [0, 1, 2].reduce((s, c) => s + (P[c] - img.rgba[i][c]) / (P[c] - I[c]), 0) / 3;
+    const got = Math.min(1, Math.max(0, a));
+    const want = ras.cov[i];
+    sum += Math.abs(got - want);
+    off[i] = Math.abs(got - want) > 0.5 ? 1 : 0;
+    if (got >= 0.5 || want >= 0.5) union++;
+    if (got >= 0.5 && want >= 0.5) inter++;
+  }
+  // the largest 4-connected component of unexplained pixels: a mark, not a rasteriser's fringe
+  const n = img.w;
+  let blob = 0;
+  for (let i = 0; i < off.length; i++) {
+    if (off[i] !== 1) continue;
+    let size = 0;
+    const stack = [i];
+    off[i] = 2;
+    while (stack.length) {
+      const j = stack.pop();
+      size++;
+      for (const k of [j - n, j + n, j % n ? j - 1 : -1, (j + 1) % n ? j + 1 : -1])
+        if (k >= 0 && k < off.length && off[k] === 1) {
+          off[k] = 2;
+          stack.push(k);
+        }
+    }
+    blob = Math.max(blob, size);
+  }
+  return { meanDelta: sum / img.rgba.length, iou: union ? inter / union : 0, blob };
+}
+
+/* ── the audit: one model in, a list of [clause, id, reason] out ─────────────── */
