+// right at 390×664 read `cell` with NO_BOTTOM or NO_RIGHT cut), so there is no band to cure there:
+// the 16×16 rows gate the reach and PRINT their negative, which no cut of this clause can red.
+for (const size of [3, 4]) {
+  const n = size * size;
+  const bites = size === 3;
+  // THE BAND IS CURED, NOT PRICED (pass 8): one expectation. Pass 7 pinned Chromium's 1–3px below
+  // as `none` (the touch aimed at the sheet shut it and reached nothing). At 16×16 the chart laps
+  // 79.30px of the board here (pass-8 table), so the band runs over the board's fourth row.
+  test(`14 · both sides of the sheet edge at ${n}×${n}: inside reaches no cell, and 1px below already reaches the cell`, async ({
+    browser,
+  }, info) => {
+    test.slow();
+    await edgeRow(browser, info, 'edge', 844, size, BELOW, 'NO_BOTTOM', 'below 1px', bites);
+  });
+  // THE SIDE EDGE (pass-8 critic gap 1): the sheet is 256 wide at the page's left edge and the
+  // board runs on to 376, so the band right of the sheet is a real one at every lapping phone cell.
+  // In Chromium a touch 1–3px right of it is aimed at the sheet; with NO_RIGHT cut it shut the sheet
+  // and reached nothing (the critic's 3/3).
+  test(`16 · the side edge at ${n}×${n}: 1px right of the sheet already reaches the cell`, async ({
+    browser,
+  }, info) => {
+    test.slow();
+    await edgeRow(browser, info, 'side', 664, size, SIDE, 'NO_RIGHT', 'out 1px', bites);
+  });
+  // THE TOP EDGE (pass 9, found by the lane's geometry read): on a coarse landscape phone (844×390)
+  // the board's top is 16 and the sheet's top 56, and the sheet's right 15px lie over the board's
+  // first columns (board left 241), so the band above the sheet is over the board there. At 9×9
+  // Chromium aims a touch 1–3px above it at the sheet, and with NO_TOP cut it reached nothing; at
+  // 16×16 it aims them at the cell, as rows 14 and 16 read.
+  test(`17 · the top edge at ${n}×${n}, 844×390: 1px above the sheet already reaches the cell`, async ({
+    browser,
+  }, info) => {
+    test.slow();
+    await edgeRow(browser, info, 'top', 390, size, ABOVE, 'NO_TOP', 'above 1px', bites, 844);
+  });
+}
+
+// ── 15 · OPEN, THEN RESIZE AT REST (pass-6 critic 1.1; LAWS P6 §D) ──────────────────────────────
+// The sheet's regime (how many rows; under `CHART_YIELDS`, whether the chart is drawn) is decided
+// by a measurement, so the measurement is taken again when the space changes under an open sheet.
+// The row is arm-agnostic: whatever the arm decides on a FRESH open at the new size is what the
+// open sheet must read once the resize has come to rest. Two cells: two at the table, opened at
+// 390×860 where the chart laps nothing (the yield's cell: it keeps the chart there and must give it
+// up at 390×664), and three at the table, opened at 390×1000 (the chart arm's cell: three rows
+// there, one row and `and 2 more` at 390×664). The negative control is a file plant (the resize
+// listener struck): the open sheet then keeps the pose it opened on.
+const lapRead = (p: Page) =>
+  sheet(p).evaluate((el) => {
+    const s = el.getBoundingClientRect();
+    const cells = [...document.querySelectorAll('.sudoku-cell')]
+      .map((c) => c.getBoundingClientRect())
+      .filter((c) => c.width > 0);
+    const top = Math.min(...cells.map((c) => c.top));
+    const lapped = cells.filter(
+      (c) => c.left < s.right && c.right > s.left && c.top < s.bottom && c.bottom > s.top,
+    ).length;
+    return {
+      open: el.classList.contains('is-open'),
+      rows: el.querySelectorAll('.pl-row').length,
+      chart: !!el.querySelector('.place-chart'),
+      lap: lapped ? Math.round(Math.max(0, s.bottom - top) * 10) / 10 : 0,
+      lapped,
+    };
+  });
+
+for (const [n, from] of [
+  [2, 860],
+  [3, 1000],
+] as const) {
+  test(`15 · open at 390×${from}, resize to 390×664 at rest: the open sheet reads what a fresh open there reads (${n} at the table)`, async ({
+    browser,
+  }, info) => {
+    test.slow();
+    const ctx = await browser.newContext({
+      viewport: { width: 390, height: from },
+      hasTouch: true,
+      isMobile: true,
+      deviceScaleFactor: 1,
+    });
+    const pages = await table(ctx, n);
+    const [a] = pages;
+    expect(await a.evaluate(() => matchMedia('(pointer: coarse)').matches)).toBe(true);
+    await a.bringToFront();
+    // the dock SLIDES shut after the invite: the board's settled pose is its own box holding still,
+    // AND no animation left running (pass 9: one run under load read 7 cells lapped at the 390×860
+    // open, where the at-rest census reads 0 at the same cell; two equal box reads are not a rest)
+    await stable(() => cell(a, 0).evaluate((e) => e.getBoundingClientRect().top));
+    await quiet(a);
+    await mark(a).tap();
+    await expect(mark(a)).toHaveAttribute('aria-expanded', 'true');
+    await quiet(a);
+    await stable(() => lapRead(a));
+    const opened = await lapRead(a);
+    expect(opened, `390×${from}: the sheet opens clear of the board`).toMatchObject({ open: true, lapped: 0 });
+    await a.setViewportSize({ width: 390, height: 664 });
+    await expect.poll(() => a.evaluate(() => innerHeight)).toBe(664);
+    await stable(() => lapRead(a));
+    const atRest = await lapRead(a);
+    await mark(a).tap();
+    await expect(mark(a)).toHaveAttribute('aria-expanded', 'false');
+    await mark(a).tap();
+    await expect(mark(a)).toHaveAttribute('aria-expanded', 'true');
+    await stable(() => lapRead(a));
+    const fresh = await lapRead(a);
+    info.annotations.push({ type: 'resize', description: JSON.stringify({ opened, atRest, fresh }) });
+    expect(fresh.lapped, 'at 390×664 the sheet laps the board in every arm').toBeGreaterThan(0);
+    expect(atRest, 'at rest after the resize = a fresh open at 390×664').toEqual(fresh);
+    await ctx.close();
+  });
+}
