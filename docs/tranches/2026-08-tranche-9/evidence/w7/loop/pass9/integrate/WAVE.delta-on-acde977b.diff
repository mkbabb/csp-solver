+/** A row's two arms in ONE run: the clean read gates in Chromium, and the in-run negative (its
+ *  clause cut) must red there on the band's nearest pixel WHERE THE BAND EXISTS (`bites`). WebKit
+ *  prints both (print-only for aim). */
+async function edgeRow(browser: Browser, info: TestInfo, name: string, height: number, size: number, aim: Aim, clause: Disjunct, nearest: string, bites: boolean, width = 390) {
+  const c = await edgeReads(browser, height, size, aim, undefined, width);
+  const clean = c.read;
+  const negative = SABOTAGE ? null : (await edgeReads(browser, height, size, aim, clause, width)).read;
+  info.annotations.push({ type: name, description: JSON.stringify({ size, width, height, sabotage: SABOTAGE, clean, [clause]: negative, hit: c.hit }) });
+  if (info.project.name === 'webkit') return; // print-only for aim (CHAIR pass 9 §11)
+  expect(clean, `${name}: the clean read`).toEqual(want(aim));
+  if (negative && bites) expect(negative[nearest], `${name}: ${clause} cut in the run reaches nothing at ${nearest}`).toBe('none');
+}
