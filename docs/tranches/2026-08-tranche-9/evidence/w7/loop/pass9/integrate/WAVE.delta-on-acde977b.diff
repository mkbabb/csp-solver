+        );
+    }
+  const score = worstDe / ceil.floor;
+  if (score < RATIO_FLOOR && on("g1b"))
+    c1b.push(
+      `  UNDER THE PAPER peer set scores ${score.toFixed(2)} of this sheet's own ceiling (ΔE ${ceil.floor.toFixed(3)}) < ${RATIO_FLOOR}`,
+    );
+  if (c1b.length) console.log(c1b.join("\n"));
+  console.log(
+    `GATE 1b THE READER'S LAW: ${c1b.length ? `RED — ${c1b.length} findings` : "GREEN"} · worst ΔE to a CELL ink ${worstDe.toFixed(3)} · this paper's five-stick ceiling ΔE ${ceil.floor.toFixed(3)} at ≥${SPREAD}deg, AA ≥4.5 (hues ${ceil.hues ? ceil.hues.join("/") : "none"}) · score ${score.toFixed(2)}`,
+  );
+  for (const a of A) {
+    const rows = arms[a].sticks.map((s) => {
+      let m = Infinity;
+      let who = null;
+      for (const r of arms[a].cell) {
+        const e = dE(s.hex, r.hex);
+        if (e < m) {
+          m = e;
+          who = r.name;
+        }
+      }
+      return `peer-${s.i} ${s.hex} ΔE ${m.toFixed(3)} (${who})`;
+    });
+    console.log(
+      `  ${a} band L ${band[a].toFixed(3)} · chroma cap ${cap[a].toFixed(3)} · ${rows.join(" · ")}`,
+    );
+  }
+
+  // GATE 2 — two players, in the STICK and in the NAME ARM. The name arm is a player's identity ink
+  // too (the tape writes the author in it), so it keeps the players' floor wherever it is its own
+  // colour. By day it is not: it IS the ring arm (`var(--color-peer-N-ring)`), whose lightness is
+  // the section's pair (§2.4, the chair's), and at L 0.295 sRGB cannot hold five hues 0.10 apart
+  // (green–teal needs a common L ≥ 0.38; printed below every run). THE EXEMPTION, AND ITS ARGUMENT:
+  // the tape shows ONE name at a time and prints the slug beside the ink, so two names are never
+  // told apart by colour on one surface; the exemption holds only while every light name resolves
+  // to its own ring arm, and even then no pair may fall under EXEMPT_FLOOR (the shipped 0.0769 less
+  // the 8-bit slack) — a light name that becomes its own colour is gated at MIN_DE like the dark.
+  const c2 = [];
+  let worstPair = Infinity;
+  const worstName = {};
+  const worstRing = {};
+  for (const a of A) {
+    const aliased =
+      !on("g2-exempt") ||
+      arms[a].names.every((n) => {
+        const r = arms[a].rings.find((q) => q.i === n.i);
+        return r && n.hex === r.hex;
+      });
+    for (const [kind, s, floor] of [
+      ["stick", arms[a].sticks, MIN_DE],
+      ["name", arms[a].names.filter((n) => n.hex), aliased ? EXEMPT_FLOOR : MIN_DE],
+      ["ring", arms[a].rings.filter((r) => r.hex), a === "light" ? RING_FLOOR : MIN_DE],
+    ]) {
+      if (!on(`g2-${kind}`)) continue;
+      for (let i = 0; i < s.length; i++)
+        for (let j = i + 1; j < s.length; j++) {
+          const e = dE(s[i].hex, s[j].hex);
+          if (kind === "stick") worstPair = Math.min(worstPair, e);
+          else if (kind === "ring")
+            worstRing[a] = Math.min(worstRing[a] ?? Infinity, e);
+          else worstName[a] = Math.min(worstName[a] ?? Infinity, e);
+          if (e < floor)
+            c2.push(
+              `  TOO CLOSE ${kind} peer-${s[i].i} ${s[i].hex} vs peer-${s[j].i} ${s[j].hex} (${a}): ΔE ${e.toFixed(3)} < ${floor}` +
+                (kind === "name" && floor === EXEMPT_FLOOR
+                  ? " (the ring-alias exemption's own floor)"
+                  : kind === "ring" && floor === RING_FLOOR
+                    ? " (the light ring pair's floor)"
+                    : ""),
+            );
+        }
+      if (kind === "name")
+        console.log(
+          `  REPORT name arms (${a}): ${aliased ? `the ring arm by alias — EXEMPT from ${MIN_DE}, floored at ${EXEMPT_FLOOR}` : `their own colour — gated at ${MIN_DE}`} · worst pair ΔE ${worstName[a]?.toFixed(4)}`,
+        );
+      if (kind === "ring")
+        console.log(
+          `  REPORT ring arms (${a}): gated at ${floor}${a === "light" ? " (the light ring pair's floor, argued at RING_FLOOR)" : ""} · worst pair ΔE ${worstRing[a]?.toFixed(4)}`,
+        );
+    }
+  }
+  // the exemption's price, re-derived: the common lightness at which the five sticks' hues first
+  // hold MIN_DE apart by day, against the ring pair's 0.295
+  let needL = null;
+  for (let L = 0.2; L <= 0.6 && needL === null; L += 0.005) {
+    const hs = arms.light.sticks.map((q) => paint(L, 0.215, hueOf(q.hex)).hex);
+    let m = Infinity;
+    for (let i = 0; i < hs.length; i++)
+      for (let j = i + 1; j < hs.length; j++) m = Math.min(m, dE(hs[i], hs[j]));
+    if (m >= MIN_DE) needL = L;
+  }
+  console.log(
+    `  REPORT the light names would hold ${MIN_DE} apart only at a common L ≥ ${needL?.toFixed(3)} (the ring pair sits at ${RING_PAIR.light})`,
+  );
+  if (c2.length) console.log(c2.join("\n"));
+  console.log(
+    `GATE 2 THE SEPARATION LAW: ${c2.length ? `RED — ${c2.length} pairs under the floor` : "GREEN"} · worst stick pair ΔE ${worstPair.toFixed(3)} · worst name pair ΔE ${(worstName.light ?? NaN).toFixed(3)} light / ${(worstName.dark ?? NaN).toFixed(3)} dark · worst ring pair ΔE ${(worstRing.light ?? NaN).toFixed(4)} light (floor ${RING_FLOOR}) / ${(worstRing.dark ?? NaN).toFixed(4)} dark (floor ${MIN_DE})`,
+  );
+
+  // GATE 3 — a stick that IS an anchor, and a tin that is not WHOLE
+  const c3 = [];
+  for (const a of A) {
+    const anchors = new Map(arms[a].reserved.map((r) => [r.hex, r.name]));
+    for (const s of [...arms[a].sticks, ...arms[a].rings])
+      if (anchors.has(s.hex) && on("g3"))
+        c3.push(`  peer-${s.i} (${a}) ${s.hex} IS --color-${anchors.get(s.hex)}`);
+    // THE MISSING ARM. Every stick has a ring; an absent one does not fail loudly on the
+    // surface, it inherits the digit ink through `gameCell.css:230` and reads 2.28 again.
+    for (const st of arms[a].sticks)
+      if (!arms[a].rings.some((r) => r.i === st.i) && on("g3"))
+        c3.push(
+          `  peer-${st.i} (${a}) has no --color-peer-${st.i}-ring — the ring inherits the digit ink`,
+        );
+    for (const r of arms[a].rings)
+      if (!arms[a].sticks.some((st) => st.i === r.i))
+        c3.push(`  --color-peer-${r.i}-ring (${a}) names a stick that does not exist`);
+    // THE MISSING NAME. `inkFor` binds `--color-peer-N-name` for every stick; an absent or
+    // unresolvable one leaves the tape's `--color-user-ink` unset and the name in the house blue.
+    for (const st of arms[a].sticks) {
+      const nm = arms[a].names.find((r) => r.i === st.i);
+      if (!nm || !nm.hex)
+        c3.push(
+          `  peer-${st.i} (${a}) has no resolvable --color-peer-${st.i}-name — the tape writes the house ink`,
+        );
+    }
+  }
+  if (c3.length) console.log(c3.join("\n"));
+  console.log(
+    `GATE 3 THE ANCHOR TEST + THE WHOLE TIN: ${c3.length ? `RED — ${c3.length} findings` : "GREEN"} · ` +
+      A.map(
+        (a) =>
+          `${a} ${arms[a].sticks.length} sticks + ${arms[a].rings.length} rings + ${arms[a].names.length} names`,
+      ).join(" · "),
+  );
+
+  // GATE 3b — a ring arm IS its stick, pressed harder: same hue, other lightness
+  const c3b = [];
+  let worstDh = 0;
+  for (const a of A)
+    for (const st of arms[a].sticks)
+      for (const [kind, set] of [
+        ["ring", arms[a].rings],
+        ["name", arms[a].names],
+      ]) {
+        const r = set.find((x) => x.i === st.i);
+        if (!r || !r.hex) continue; // gate 3 has it
+        const d = gap(hueOf(st.hex), hueOf(r.hex));
+        worstDh = Math.max(worstDh, d);
+        if (d > RING_DH && on("g3b"))
+          c3b.push(
+            `  NOT THE SAME PENCIL peer-${st.i} (${a}) stick ${st.hex} h ${hueOf(st.hex).toFixed(2)} vs ${kind} ${r.hex} h ${hueOf(r.hex).toFixed(2)}: ${d.toFixed(2)}deg > ${RING_DH}deg`,
+          );
+      }
+  if (c3b.length) console.log(c3b.join("\n"));
+  console.log(
+    `GATE 3b THE SAME PENCIL: ${c3b.length ? `RED — ${c3b.length} arms off hue` : "GREEN"} · worst |Δh| ${worstDh.toFixed(3)}deg (cap ${RING_DH}deg, the 8-bit round trip of a low-chroma arm)`,
+  );
+  for (const a of A) {
+    const rows = arms[a].rings.map(
+      (r) =>
+        `peer-${r.i}-ring ${r.hex} L ${lOf(r.hex).toFixed(3)} C ${chromaOf(r.hex).toFixed(3)}`,
+    );
+    console.log(`  REPORT ring arms (${a}): ${rows.join(" · ")}`);
+    const names = arms[a].names.map(
+      (r) =>
+        `peer-${r.i}-name ${r.hex} L ${r.hex ? lOf(r.hex).toFixed(3) : "?"} Y ${r.hex ? lum(r.hex).toFixed(3) : "?"}`,
+    );
+    console.log(`  REPORT name arms (${a}): ${names.join(" · ")}`);
+  }
+
+  // Reported, never failing.
+  for (const a of A) {
+    const gamut = arms[a].sticks.map((s) => {
+      const c = chromaOf(s.hex);
+      const ceiling = chromaAt(lOf(s.hex), hueOf(s.hex));
+      return `peer-${s.i} C ${c.toFixed(3)}${c >= ceiling - 0.002 ? "=ceiling" : `/${ceiling.toFixed(3)}`}`;
+    });
+    console.log(`  REPORT gamut (${a}): ${gamut.join(" · ")}`);
+    const trip = arms[a].sticks.map((s) => {
+      const again = paint(lOf(s.hex), chromaOf(s.hex), hueOf(s.hex)).hex;
+      return `peer-${s.i} ${gap(hueOf(s.hex), hueOf(again)).toFixed(3)}deg`;
+    });
+    console.log(
+      `  REPORT 8-bit round trip (${a}): ${trip.join(" · ")} — zero because the tin is AUTHORED IN BYTES, not computed at paint time`,
+    );
+    const prog = arms[a].sticks
+      .map((s) => `peer-${s.i} ${dE(s.hex, arms[a].progress).toFixed(3)}`)
+      .join(" · ");
+    console.log(
+      `  REPORT ΔE to --color-progress-ink (the frame trace, not a cell): ${prog}`,
+    );
+  }
+
+  // GATE 4 — ONE PUBLISHER (§11c's leader duty, registry §2.4)
+  const g4 = gate4(css, arms, sources);
+  console.log(g4.line);
+  for (const f of g4.findings) console.log(`  ${f}`);
+
+  return {
+    code:
+      c1a.length ||
+      c1b.length ||
+      c2.length ||
+      c3.length ||
+      c3b.length ||
+      g4.findings.length
+        ? 1
+        : 0,
+    // COUNTS, not flags: a control proves its gate only by adding a finding to the baseline's,
+    // so a tree already red on a gate cannot pass that gate's control by being red.
+    red: {
+      g1a: c1a.length,
+      g1b: c1b.length,
+      g2: c2.length,
+      // per floor (row 3's boundary controls key the floor they pin, not the gate)
+      "g2-stick": c2.filter((l) => / stick /.test(l)).length,
+      "g2-name": c2.filter((l) => / name /.test(l)).length,
+      "g2-ring": c2.filter((l) => / ring /.test(l)).length,
