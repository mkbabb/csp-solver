@@ -0,0 +1,161 @@
+import { describe, expect, it, vi } from "vitest";
+import { MOTION, handStroke } from "@pencil/config/pencilConfig";
+
+// The master subscription is driven by hand: `raw` is the rAF timeline over the span.
+let drive: ((eased: number, raw: number) => void) | null = null;
+vi.mock("@mkbabb/pencil-boil", async (orig) => ({
+  ...(await orig<typeof import("@mkbabb/pencil-boil")>()),
+  createSequenceSubscription: (o: { onProgress: (e: number, r: number) => void }) => {
+    drive = o.onProgress;
+    return { start() {}, stop() {} };
+  },
+}));
+const { enrollStroke, beginRuling, afterRuling } = await import("./bootHand");
+const SPAN = 600_000;
+
+describe("the hand's clock (T9-M20 D1)", () => {
+  it("a healthy frame is never slowed; a stall pauses the hand one cap", () => {
+    const seen: number[] = [];
+    enrollStroke((c) => {
+      seen.push(c);
+      return seen.length >= 4;
+    });
+    for (const t of [0, 16, 316, 332]) drive!(0, t / SPAN);
+    // 16 ms passes whole; the 300 ms stall advances one CAP (1.5 × 16 = 24, above the 17 ms floor);
+    // the next frame is whole again
+    const cap = Math.max(16 * MOTION.hand.paceSlack, MOTION.hand.stepMs);
+    expect(seen).toEqual([0, 16, 16 + cap, 32 + cap]);
+  });
+});
+
+/** A fresh clock (the pace is module state), driven through `dts` frame intervals from t = 0;
+ *  returns the hand's clock on every tick. */
+async function drawAt(dts: number[]): Promise<number[]> {
+  vi.resetModules();
+  const m = await import("./bootHand");
+  const seen: number[] = [];
+  m.enrollStroke((c) => {
+    seen.push(c);
+    return seen.length > dts.length;
+  });
+  let t = 0;
+  drive!(0, 0);
+  for (const d of dts) drive!(0, (t += d) / SPAN);
+  return seen;
+}
+const frames = (ms: number, n: number) => Array.from({ length: n }, () => ms);
+
+describe("the hand is a RATE on every panel (T9-W7 §13 pass 8, LAWS P7 §F)", () => {
+  // hand time per wall second, once the pace is observed: 1.0 is the page drawn in the time the
+  // design says on any display; pass 7's flat 17 ms cap read 0.515 at 30 Hz (a stall every frame)
+  for (const [hz, ms] of [
+    [125, 8],
+    [60, 1000 / 60],
+    [30, 1000 / 30],
+    [25, 40], // WebKit's '30 Hz' shim arm runs at 25 Hz (pass 9): pass 8's 34 ms cap read 0.85 here
+  ] as const)
+    it(`${hz} Hz: the hand keeps the wall's pace (≥ 0.95 of it over one second)`, async () => {
+      const n = Math.round(1000 / ms);
+      const seen = await drawAt(frames(ms, n));
+      const rate = seen[seen.length - 1] / (ms * n);
+      expect(rate).toBeGreaterThanOrEqual(0.95);
+      expect(rate).toBeLessThanOrEqual(1 + 1e-9);
+    });
+  /** The most one lost frame moves the hand on a panel of period `p`. */
+  const capAt = (p: number) =>
+    Math.min(
+      Math.max(p * MOTION.hand.paceSlack, MOTION.hand.stepMs),
+      MOTION.hand.maxStepMs,
+    );
+  it("a stall pauses the hand for at most one and a half frames at the panel's own rate", async () => {
+    const at30 = await drawAt([...frames(1000 / 30, 10), 300, 1000 / 30]);
+    expect(at30[11] - at30[10]).toBeCloseTo(capAt(1000 / 30), 3);
+    expect(at30[11] - at30[10]).toBeLessThanOrEqual(1.5 * (1000 / 30) + 1e-9);
+    const at60 = await drawAt([...frames(1000 / 60, 10), 300, 1000 / 60]);
+    expect(at60[11] - at60[10]).toBeCloseTo(capAt(1000 / 60), 3);
+    expect(at60[11] - at60[10]).toBeLessThanOrEqual(1.5 * (1000 / 60) + 1e-9);
+  });
+  it("a jittery shimmed 60 Hz panel (15.6/23.4 ms, chromium's) travels whole", async () => {
+    const dts = Array.from({ length: 60 }, (_, i) => (i % 3 === 2 ? 23.4 : 15.6));
+    const seen = await drawAt(dts);
+    expect(
+      seen[seen.length - 1] / dts.reduce((a, b) => a + b, 0),
+    ).toBeGreaterThanOrEqual(0.999);
+  });
+  // THE STALL-RUN ROWS (LAWS P8 §D, ACC-FIVE's graft): the pace keys on the window's SHORTEST tick,
+  // so every stall of a run shorter than the window travels one cap (1.5 × the panel's frame). Pass
+  // 8's median let the third consecutive 150 ms stall of five travel its cap (34 ms at 60 Hz).
+  it("every stall of a run shorter than the window travels one cap (≤ 1.5 frames)", async () => {
+    const n = MOTION.hand.paceWindow - 1;
+    const seen = await drawAt([...frames(1000 / 60, 10), ...frames(150, n)]);
+    for (let k = 11; k <= 10 + n; k++)
+      expect(seen[k] - seen[k - 1]).toBeCloseTo(capAt(1000 / 60), 6);
+  });
+  it("a run that fills the window is read as the panel, never past maxStepMs", async () => {
+    const n = MOTION.hand.paceWindow;
+    const seen = await drawAt([...frames(1000 / 60, 10), ...frames(150, n + 1)]);
+    // the stall before the window fills still travels one frame; the one that fills it, the cap
+    expect(seen[9 + n] - seen[8 + n]).toBeCloseTo(capAt(1000 / 60), 6);
+    expect(seen[10 + n] - seen[9 + n]).toBeCloseTo(MOTION.hand.maxStepMs, 6);
+    expect(seen[11 + n] - seen[10 + n]).toBeCloseTo(MOTION.hand.maxStepMs, 6);
+  });
+  it("a jittery fast panel never crawls (the stepMs floor)", async () => {
+    // 125 Hz with 4/12 ms jitter: the minimum is 4, the floor keeps every 12 ms frame whole
+    const dts = Array.from({ length: 125 }, (_, i) => (i % 2 ? 12 : 4));
+    const seen = await drawAt(dts);
+    expect(
+      seen[seen.length - 1] / dts.reduce((a, b) => a + b, 0),
+    ).toBeGreaterThanOrEqual(0.99);
+  });
+  it("a run of stalls is never read as the pace (capped at maxStepMs)", async () => {
+    const seen = await drawAt([...frames(1000 / 60, 10), ...frames(150, 10)]);
+    for (let k = 11; k <= 20; k++)
+      expect(seen[k] - seen[k - 1]).toBeLessThanOrEqual(MOTION.hand.maxStepMs + 1e-9);
+  });
+});
+
+describe("the wave waits for the last lift (T9-M20 D15)", () => {
+  it("nothing to wait for when no ruling is in flight", () => {
+    expect(afterRuling()).toBeNull();
+  });
+  it("releases every waiter at the last ruling's lift, once", async () => {
+    const a = beginRuling();
+    const b = beginRuling();
+    const order: string[] = [];
+    void afterRuling()!.then(() => order.push("wave"));
+    a();
+    a(); // idempotent: a second release of one ruling does not end the other
+    await Promise.resolve();
+    expect(order).toEqual([]);
+    b();
+    await Promise.resolve();
+    expect(order).toEqual(["wave"]);
+    expect(afterRuling()).toBeNull();
+  });
+});
+
+describe("handStroke (the ledger string, solved in JS)", () => {
+  const bez = (a: number, b: number, t: number) =>
+    3 * a * (1 - t) ** 2 * t + 3 * b * (1 - t) * t * t + t ** 3;
+  it("agrees with the parametric curve at 41 samples to 1e-4", () => {
+    const [x1, y1, x2, y2] = (MOTION.curves.handStroke.match(/-?[\d.]+/g) ?? []).map(
+      Number,
+    );
+    for (let i = 0; i <= 40; i++) {
+      const t = i / 40;
+      expect(handStroke(bez(x1, x2, t))).toBeCloseTo(bez(y1, y2, t), 4);
+    }
+  });
+  it("touches down slow, peaks near a third, and stops (G-D4: ≤ 25 % drawn at 20 % of the time)", () => {
+    const speed = (x: number, h = 1e-4) =>
+      (handStroke(x + h) - handStroke(x - h)) / (2 * h);
+    expect(speed(1e-3)).toBeLessThan(0.3);
+    let [peak, at] = [0, 0];
+    for (let x = 0.01; x < 1; x += 0.001)
+      if (speed(x) > peak) [peak, at] = [speed(x), x];
+    expect(at).toBeGreaterThan(0.2);
+    expect(at).toBeLessThan(0.4);
+    expect(handStroke(0.2)).toBeLessThan(0.25);
+    expect(handStroke(0.9)).toBeGreaterThan(0.99);
+  });
+});
