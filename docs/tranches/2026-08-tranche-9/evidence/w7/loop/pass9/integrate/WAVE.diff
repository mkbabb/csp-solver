+  visibility: hidden;
+  pointer-events: none;
+  transform: scale(0.9) translateY(8px);
+  transition:
+    opacity var(--motion-whisper) var(--verb-layDown-ease),
+    transform var(--motion-whisper) var(--verb-layDown-ease),
+    visibility 0s linear 150ms;
+  z-index: 50;
+}
+
+.head-sheet.is-open {
+  opacity: 1;
+  visibility: visible;
+  pointer-events: auto;
+  transform: scale(1) translateY(0);
+  transition:
+    opacity var(--motion-whisper) var(--verb-layDown-ease),
+    transform var(--motion-whisper) var(--verb-layDown-ease),
+    visibility 0s linear 0s;
+}
