+  // the board's top is 16 and the sheet's top 56, and the sheet's right 15px lie over the board's
+  // first columns (board left 241), so the band above the sheet is over the board there. At 9×9
+  // Chromium aims a touch 1–3px above it at the sheet, and with NO_TOP cut it reached nothing; at
+  // 16×16 it aims them at the cell, as rows 14 and 16 read.
+  test(`17 · the top edge at ${n}×${n}, 844×390: 1px above the sheet already reaches the cell`, async ({
+    browser,
+  }, info) => {
+    test.slow();
+    await edgeRow(browser, info, 'top', 390, size, ABOVE, 'NO_TOP', 'above 1px', bites, 844);
+  });
+}
