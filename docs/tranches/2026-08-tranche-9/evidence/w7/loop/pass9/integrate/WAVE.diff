+            ["CLIP0 the ring painted to zero", ".focus-ring { clip-path: inset(50%) !important; }", "chrome"],
+            ["THIN_1PX the ring at 1 px", C.THIN_1PX, "chrome"],
+            ["DASH_1IN8 a hole in every eight stations", C.DASH_1IN8, "chrome"],
+            ["NOTCH one notch through the top and bottom bands (B4 alone)", NOTCH10, "chrome", "B4"],
+            ["SQUAT6 the stop 6 px tall (B1 alone: its side bands under 8 px)", SQUAT6, "chrome", "B1"],
+            ["X4b tier 2 at 0.2", ".cell-ghost.is-active { opacity: 0.2 !important; }", "tier2"],
+            ["FADE15 tier 2's every painted colour at 15 %", G.FADE15_desc, "tier2"],
+            ["X6 tier 2's bottom clipped away", G.X6_bottom_erased, "tier2"],
+            ["THIN_1PX tier 2 at 1 px", G.THIN_1PX, "tier2"],
+          ]
+        : [
+            ["X4 the ring at 0.15", C.X4_opacity_015, "chrome"],
