+        durationMs: DRAW_IN_PRESETS.glyph.duration,
+        delayMs: pos * MOTION.tallyStaggerMs,
+        easing: easeOutCubic,
+        onProgress: (eased) => {
+          reveal[k] = eased;
+        },
+        onComplete: () => {
+          reveal[k] = 1;
+          draws.delete(k);
+        },
+      });
+      seq.start();
+      draws.set(k, seq);
+    });
+  }
