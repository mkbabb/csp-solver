+let blind = 0;
+if (args.includes("--self-test")) {
+  console.log("\nself-test — one planted defect per check:");
+  if (violations > 0) {
+    console.log(
+      "  SKIPPED — the gate is already red; a plant on a red tree proves nothing.",
+    );
+  } else {
+    blind = selfTest(censuses);
+  }
+}
+
+console.log(
+  `\n${violations === 0 && blind === 0 ? "PASS" : "FAIL"} — ${violations} violation(s)` +
+    (args.includes("--self-test") ? `, ${blind} blind check(s)` : ""),
+);
+process.exit(violations === 0 && blind === 0 ? 0 : 1);
