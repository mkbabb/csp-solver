+  // pass 8 — the pass-7 critic's plant: a file OUTSIDE the old hand list, in the build's graph
+  // (`scene.css`), edited after the build with its mtime restored. Overlaid in memory: the tree's
+  // digest moves, the build's does not.
+  const scene = "src/games/shared/scene.css";
+  if (!GRAPH?.includes(scene)) {
+    console.log(
+      `  BLIND  ${scene} is not in the build's graph — the graph read is short`,
+    );
+    blind++;
+  }
+  const bytes = (p) => fs.readFileSync(p);
+  const sceneStamp = graphStamp(GRAPH, FRONTEND, (p) =>
+    p.endsWith(scene)
+      ? Buffer.concat([
+          bytes(p),
+          Buffer.from("\n.controls-card { letter-spacing: 1px }\n"),
+        ])
+      : bytes(p),
+  );
+  plant(
+    "scene.css edited after the build (letter-spacing on the card; a file the hand list missed)",
+    withServed,
+    f0,
+    sceneStamp,
+  );
+  // pass 9 — the pass-8 critic's three font plants, overlaid in memory (the CLI battery plants
+  // them on disk with the mtime restored): a byte appended, a face replaced by another face's
+  // bytes, one byte flipped where utf8 decoding hid it. Each face must be IN the graph first.
+  for (const f of FACE_ASSETS)
+    if (!GRAPH?.includes(f)) {
+      console.log(
+        `  BLIND  ${f} is not in the build's graph — a url() asset the stamp cannot see`,
+      );
+      blind++;
+    }
+  const [ph, fc, fr] = FACE_ASSETS;
+  const overlay = (name, fn) =>
+    plant(
+      name,
+      withServed,
+      f0,
+      graphStamp(GRAPH, FRONTEND, (p) =>
+        p.endsWith(name.split(" ")[0]) ? fn(bytes(p)) : bytes(p),
+      ),
+    );
+  overlay(`${ph} one byte appended`, (b) => Buffer.concat([b, Buffer.from([0])]));
+  overlay(`${fc} replaced whole by the Fraunces bytes`, () =>
+    bytes(path.join(FRONTEND, fr)),
+  );
+  overlay(`${fr} offset 127 flipped`, (b) => {
+    const c = Buffer.from(b);
+    c[127] ^= 0x01;
+    return c;
+  });
+  plant(
+    "a file the build read has gone missing",
+    withServed,
+    f0,
+    graphStamp(GRAPH, FRONTEND, (p) => {
+      if (p.endsWith(GRAPH[0])) throw new Error("gone");
+      return bytes(p);
+    }),
+  );
+  plant("no build graph at all", withServed, f0, null);
+  plant("a chip renamed on one engine", (c) => {
+    c.webkit.words[0].text += "-renamed";
+  });
+  plant("the two censuses taken at different dpr", (c) => {
+    c.webkit.dpr = c.webkit.dpr === 1 ? 2 : 1;
+  });
