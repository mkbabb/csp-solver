+  // 1 · THE WORD, ±0.5px. Every chip, by its own text, so a renamed chip is a RED and not a
+  //     silently shorter list.
+  const names = [...new Set([...a.words, ...b.words].map((w) => w.text))].sort();
+  for (const name of names) {
+    const wa = a.words.find((w) => w.text === name);
+    const wb = b.words.find((w) => w.text === name);
+    if (!wa || !wb) {
+      result["the word is one width"].push(
+        `"${name}" is on ${wa ? ENGINES[0] : ENGINES[1]} only — the two cards do not carry the same chips`,
+      );
+      continue;
+    }
+    if (wa.wordW === null || wb.wordW === null) continue; // a chip with no word box carries no mark
+    const d = Math.abs(wa.wordW - wb.wordW);
+    if (d > WORD_BAND_CSS_PX)
+      result["the word is one width"].push(
+        `"${name}" ${wa.wordW} vs ${wb.wordW} = ${d.toFixed(3)}px apart (band ${WORD_BAND_CSS_PX})`,
+      );
+  }
+
+  // 2 · THE PAINT, ±3 device px at the run's own dpr. Both runs must be at one dpr or the
+  //     comparison is between two different instruments.
+  if (a.dpr !== b.dpr)
+    result["the painted mark is one width"].push(
+      `dpr ${a.dpr} vs ${b.dpr} — the two censuses were taken with different raster resolutions`,
+    );
+  else {
+    const band = PAINT_BAND_DEVICE_PX / a.dpr;
+    const d = Math.abs(a.paintedMark - b.paintedMark);
+    const devicePx = (d * a.dpr).toFixed(2);
+    if (d > band)
+      result["the painted mark is one width"].push(
+        `${a.paintedMark} vs ${b.paintedMark} = ${d.toFixed(3)}px = ${devicePx} device px ` +
+          `(band ${PAINT_BAND_DEVICE_PX} device px = ${band.toFixed(3)}px at dpr ${a.dpr}); ` +
+          `mark cols ${JSON.stringify(a.markCols)} vs ${JSON.stringify(b.markCols)}`,
+      );
+  }
+  return result;
+}
+
+function selfTest(censuses) {
+  let blind = 0;
