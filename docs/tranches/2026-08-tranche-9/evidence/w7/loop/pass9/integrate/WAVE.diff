+  const room = `tally-prm-mid-${Date.now()}`;
+  await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+  await settled(page);
+  await peers(page, room, 1);
+  // a third person arrives; 80ms into the draw-in the reader switches reduced motion on
+  await page.evaluate(
+    ({ room }) => {
+      const ch = new BroadcastChannel(`board:${room}`);
+      ch.postMessage({ kind: "hi", data: {}, from: "prm-new" });
+      setTimeout(() => ch.close(), 0);
+    },
+    { room },
+  );
+  await page.waitForTimeout(80); // sleep-ok: the elapsed time IS the subject, 80ms into a 600ms draw-in
+  const before = await page.evaluate(() => {
+    const ps = [...document.querySelectorAll("[data-player-mark]")]
+            .find((m) => m.getBoundingClientRect().width > 0)!
+            .querySelectorAll(".pt-pose.is-active path");
+    return Number(ps[ps.length - 1]?.getAttribute("stroke-dashoffset"));
+  });
+  await page.emulateMedia({ reducedMotion: "reduce" });
+  const trace = await page.evaluate(
+    () =>
+      new Promise<number[]>((done) => {
+        const out: number[] = [];
+        const t0 = performance.now();
+        const tick = () => {
+          const ps = [...document.querySelectorAll("[data-player-mark]")]
+            .find((m) => m.getBoundingClientRect().width > 0)!
+            .querySelectorAll(".pt-pose.is-active path");
+          out.push(Number(ps[ps.length - 1]?.getAttribute("stroke-dashoffset")));
+          // sleep-ok: the elapsed window IS the subject, 900ms in which the landed stroke may not rise
