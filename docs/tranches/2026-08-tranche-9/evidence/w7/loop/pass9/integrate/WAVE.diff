+  if (!new URL(url, "http://x").searchParams.get("s")) expect(givens, "the encoded board decoded").toBe(GIVENS);
+}
+
+async function invite(page: Page): Promise<string> {
+  const verb = page.locator(
+    '.controls-card button[aria-label="Play together on this board"]',
+  );
+  await expect(verb).toBeEnabled();
+  await verb.click();
+  await expect.poll(() => new URL(page.url()).searchParams.get("s")).not.toBeNull();
+  return page.url();
+}
+
+const roster = (page: Page) =>
+  page.locator(".controls-card .players-roster .player-row");
+
+/** A room of `n` pages on one board, the product's own invite path. `pins` seats EVERY page under a
+ *  FIXED peer id the way the product re-seats a tab (`session-identity-v1`, the per-tab map keyed by
+ *  the room the link names), so every slug on the page and every stroke an id seeds is part of the
+ *  payload rather than a random variable (LAWS P6 §C, P7 §C: the pin reaches every id on the page).
+ *  The host is pinned the way PAL-WALK pins it: its map answers for the room the address bar names,
+ *  because the invite writes `?s=` before the page claims its id. */
+async function room(browser: import("@playwright/test").Browser, n: number, pins?: readonly string[]) {
+  const ctx = await browser.newContext();
+  const a = await ctx.newPage();
+  if (pins?.[0])
+    await a.addInitScript((id) => {
+      const get = Storage.prototype.getItem;
+      Storage.prototype.getItem = function (k: string) {
+        const r = new URL(location.href).searchParams.get("s");
+        if (this === sessionStorage && k === "session-identity-v1" && r)
+          return JSON.stringify({ ...JSON.parse(get.call(this, k) || "{}"), [r]: id });
+        return get.call(this, k);
+      };
+    }, pins[0]);
+  await boot(a, LOCAL);
+  const link = await invite(a);
+  const pages = [a];
+  for (let i = 1; i < n; i++) {
+    const p = await ctx.newPage();
+    if (pins?.[i])
+      await p.addInitScript(
+        ([r, id]) => sessionStorage.setItem("session-identity-v1", JSON.stringify({ [r]: id })),
+        [new URL(link).searchParams.get("s")!, pins[i]] as const,
+      );
+    await boot(p, link);
+    pages.push(p);
+    // the ink index is the room's ARRIVAL order, so each seat lands before the next boots: unsequenced,
+    // the fifth and sixth joins swapped once under load (pass 9, chromium §2c: B seated at index 4)
+    await expect(roster(a)).toHaveCount(i + 1, { timeout: 60000 });
+  }
+  for (const p of pages) await expect(roster(p)).toHaveCount(n, { timeout: 60000 });
+  return { ctx, pages };
+}
+
+/** WCAG 2.x contrast off two `rgb()` strings the engine itself produced. */
+const CONTRAST = `(a, b) => {
+  const px = (s) => s.match(/[\\d.]+/g).slice(0, 3).map(Number).map((v) => {
+    const c = v / 255;
+    return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
+  });
+  const L = (p) => 0.2126 * p[0] + 0.7152 * p[1] + 0.0722 * p[2];
+  const [x, y] = [L(px(a)), L(px(b))].sort((p, q) => q - p);
+  return (x + 0.05) / (y + 0.05);
+}`;
+
+/** src-over composite, in the engine's own bytes. */
+const OVER = `(fg, alpha, bg) => {
+  const n = (s) => s.match(/[\\d.]+/g).slice(0, 3).map(Number);
+  const f = n(fg), b = n(bg);
+  return 'rgb(' + f.map((v, i) => alpha * v + (1 - alpha) * b[i]).join(', ') + ')';
+}`;
+
+/** The product's own key — `useTheme` writes the `dark` CLASS on `<html>` (`useTheme.ts:9-13`),
+ *  so the arm is switched the way a reader switches it, then settled over two frames. */
+async function setTheme(page: Page, mode: "light" | "dark") {
+  await page.evaluate((m) => {
+    document.documentElement.classList.toggle("dark", m === "dark");
+    return new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
+  }, mode);
+}
+
+/** Every roster row's children, as `class:x,width` — the no-move guard's reading, in one place
+ *  so the five-player and seven-player captures cannot drift apart. */
+const ROW_CHILDREN = () =>
+  [...document.querySelectorAll(".players-roster .player-row .player-row-cells > *")].map((e) => {
+    const r = e.getBoundingClientRect();
+    return `${e.className}:${r.x.toFixed(2)},${r.width.toFixed(2)}`;
+  });
+
+/** A screenshot's bytes, decoded BY THE BROWSER THAT TOOK IT (PAL-WALK's form): the page holds
+ *  a canvas, so the decoder is the engine's own and this file carries none. */
+async function rawOf(
+  page: Page,
+  png: { toString: (enc: string) => string },
+): Promise<{ data: number[]; w: number; h: number }> {
+  return page.evaluate(async (b64) => {
+    const img = new Image();
+    img.src = `data:image/png;base64,${b64}`;
+    await img.decode();
+    const c = document.createElement("canvas");
+    c.width = img.naturalWidth;
+    c.height = img.naturalHeight;
+    const g = c.getContext("2d", { willReadFrequently: true })!;
+    g.drawImage(img, 0, 0);
+    return { data: Array.from(g.getImageData(0, 0, c.width, c.height).data), w: c.width, h: c.height };
+  }, png.toString("base64"));
+}
+
+const lin = (v: number) => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
+const lumAt = (d: number[], k: number) =>
+  0.2126 * lin(d[k] / 255) + 0.7152 * lin(d[k + 1] / 255) + 0.0722 * lin(d[k + 2] / 255);
+const ratio = (x: number, y: number) => (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
+const q = (r: number[], f: number) => r[Math.min(r.length - 1, Math.floor(r.length * f))];
+
+/** Seat a peer cursor on cell 40 the product's way — its class and its var — bound to `ink`,
+ *  held against the session's own re-render; `null` lifts it. */
+async function seat(page: Page, ink: string | null) {
+  await page.evaluate((v) => {
+    const w = window as unknown as { __tin?: MutationObserver };
+    const cell = document.querySelectorAll<HTMLElement>(".game-cell")[40];
+    w.__tin?.disconnect();
+    if (v === null) {
+      cell.classList.remove("is-peer-cursor");
+      cell.style.removeProperty("--color-peer-cursor-ink");
+      return;
+    }
+    const set = () => {
+      cell.style.setProperty("--color-peer-cursor-ink", v);
+      cell.classList.add("is-peer-cursor");
+    };
+    set();
+    const o = new MutationObserver(() => {
+      if (!cell.classList.contains("is-peer-cursor")) set();
+    });
+    o.observe(cell, { attributes: true, attributeFilter: ["class", "style"] });
+    w.__tin = o;
+  }, ink);
+  await expect
+    .poll(() =>
+      page.evaluate(() => {
+        const p = document.querySelectorAll(".game-cell")[40]?.querySelector(".cell-ghost-path");
+        return !p || p.getAnimations().every((a) => a.playState !== "running");
+      }),
+    )
+    .toBe(true);
+}
+
+/** The ring photographed OFF / ON / OFF: the core is every pixel the ring moved at ≥ 50 % of
+ *  the most-moved one (boil noise — a pixel the two OFF shots disagree on — dropped), each read
+ *  against the median of eight fill samples. The sensitivity row walks 50/70/90/100 %. */
+async function ringCore(page: Page, ink: string) {
+  const box = (await page.locator(".game-cell").nth(40).boundingBox())!;
+  const clip = {
+    x: Math.floor(box.x - 6),
+    y: Math.floor(box.y - 6),
+    width: Math.ceil(box.width + 12),
+    height: Math.ceil(box.height + 12),
+  };
+  await seat(page, null);
+  const A = await rawOf(page, await page.screenshot({ clip }));
+  await seat(page, ink);
+  const B = await rawOf(page, await page.screenshot({ clip }));
+  await seat(page, null);
+  const C = await rawOf(page, await page.screenshot({ clip }));
+  const s = B.w / clip.width;
+  const fills: number[] = [];
+  for (const [fx, fy] of [[0.3, 0.2], [0.7, 0.2], [0.2, 0.3], [0.8, 0.3], [0.2, 0.7], [0.8, 0.7], [0.3, 0.8], [0.7, 0.8]]) {
+    const x = Math.round((box.x - clip.x + box.width * fx) * s);
+    const y = Math.round((box.y - clip.y + box.height * fy) * s);
+    fills.push(lumAt(B.data, (y * B.w + x) * 4));
+  }
+  fills.sort((p, r) => p - r);
+  const fillL = fills[fills.length >> 1];
+  const mv: [number, number][] = [];
+  let top = 0;
+  let noise = 0;
+  const dist = (X: number[], Y: number[], i: number) =>
+    Math.abs(X[i] - Y[i]) + Math.abs(X[i + 1] - Y[i + 1]) + Math.abs(X[i + 2] - Y[i + 2]);
+  for (let i = 0; i < B.data.length; i += 4) {
+    if (dist(A.data, C.data, i) > 8) {
+      noise++;
+      continue;
+    }
+    const d = dist(A.data, B.data, i);
+    mv.push([d, i]);
+    top = Math.max(top, d);
+  }
+  const row = (f: number) => {
+    const r = mv
+      .filter(([d]) => d >= f * top && top > 0)
+      .map(([, i]) => ratio(lumAt(B.data, i), fillL))
+      .sort((p, t) => p - t);
+    return { n: r.length, max: r[r.length - 1], p30: q(r, 0.3), med: q(r, 0.5), under: r.filter((v) => v < 3).length / r.length };
+  };
+  const core = row(0.5);
+  const sens = [0.5, 0.7, 0.9, 1.0]
+    .map((f) => {
+      const x = row(f);
+      return `${f * 100}%: med ${x.med?.toFixed(3)} <3 ${(x.under * 100).toFixed(1)}% (${x.n})`;
+    })
+    .join(" | ");
+  return { core, sens, noise, top };
+}
+
+// ── 1 · THE RING, PHOTOGRAPHED ────────────────────────────────────────────────────────────
+// The section's statistic on the one line the product draws. ITS NEGATIVE CONTROL IS IN THE
+// SAME RUN: the stick's own lightness in the same ring is why the arms exist (2.28–2.44 by
+// arithmetic), so the instrument must read it UNDER the floor; an instrument that passed both
+// would be reading paper.
+test("§1 the ring arm clears the core-median floor on every stick, and the stick's own lightness does not", async ({
+  page,
+}, info) => {
+  test.slow();
+  await boot(page, SOLO);
+  const dpr = await page.evaluate(() => devicePixelRatio);
+  for (const arm of ["light", "dark"] as const) {
+    await setTheme(page, arm);
+    const sticks: number[] = [];
+    for (let k = 1; k <= 5; k++) {
+      const ring = await ringCore(page, `var(--color-peer-${k}-ring)`);
+      const stick = await ringCore(page, `var(--color-peer-${k})`);
+      sticks.push(stick.core.med);
+      console.log(
+        `RING ${info.project.name} dpr ${dpr} ${arm} peer-${k}: core px ${ring.core.n} max ${ring.core.max.toFixed(3)} ` +
+          `p30 ${ring.core.p30.toFixed(3)} MEDIAN ${ring.core.med.toFixed(3)} <3 ${(ring.core.under * 100).toFixed(1)}% · ` +
+          `noise ${ring.noise} · sens ${ring.sens} || the stick in the same ring: MEDIAN ${stick.core.med.toFixed(3)}`,
+      );
+      expect(ring.top, "the ring painted").toBeGreaterThan(8);
+      expect(ring.core.med, `${arm} peer-${k} ring arm, core median`).toBeGreaterThanOrEqual(CORE_FLOOR);
+    }
+    expect(Math.min(...sticks), `${arm}: the stick's own lightness, the row's negative control`).toBeLessThan(3.0);
+  }
+});
+
+// ── 2 · AA, TEN ARMS × FOUR GROUNDS ───────────────────────────────────────────────────────
+test("§2 every stick clears 4.5 on the page's grounds, and every name arm on the tape's paper", async ({ page }) => {
+  await boot(page, SOLO);
+  for (const arm of ["light", "dark"] as const) {
+    await setTheme(page, arm);
+    const rows = await page.evaluate(
+      ([contrast, over]) => {
+        const probe = document.createElement("div");
+        document.body.appendChild(probe);
+        // a token name or a whole `var(…)`: the tin's arms are passed as `var(…)` so that no
+        // peer token is ever NAMED by arithmetic outside `var(` (check-peer-tin GATE 4a)
+        const read = (v: string) => {
+          probe.style.color = v.startsWith("var(") ? v : `var(${v})`;
+          return getComputedStyle(probe).color;
+        };
+        const C = eval(contrast) as (a: string, b: string) => number;
+        const O = eval(over) as (f: string, a: number, b: string) => string;
+        const bg = read("--color-background");
+        const card = read("--color-card");
+        const pop = read("--color-popover");
+        // the attribution tape's paper and the hint laminate, composited as the estate does
+        const tape = (() => {
+          const t = document.createElement("div");
+          t.style.background = "var(--sheet-washi-neutral)";
+          document.body.appendChild(t);
+          const b = getComputedStyle(t).backgroundColor;
+          t.remove();
+          // `color-mix(in srgb, fg 6%, hsl(0 0% 100% / 0.82))` resolves to a PARTLY
+          // TRANSPARENT colour, so the tape's paper is that composited over the page's ground.
+          // BOTH ENGINES SERIALISE IT AS `color(srgb r g b / a)` WITH 0–1 CHANNELS, which is
+          // the trap this line exists for: read as bytes it is a near-black ground and the
+          // tape's whole reading inverts (measured — 1.626 light where the paper reads 6.5).
+          const m = b.match(/[\d.]+/g)!.map(Number);
+          const k = /^color\(/.test(b) ? 255 : 1;
+          const al = m.length > 3 ? m[3] : 1;
+          const rgb = `rgb(${m[0] * k}, ${m[1] * k}, ${m[2] * k})`;
+          return al < 1 ? O(rgb, al, bg) : rgb;
+        })();
+        const laminate = O(read("--color-teacher-red"), 0.15, bg);
+        const out = [];
+        for (let i = 1; i <= 5; i++) {
+          const ink = read(`var(--color-peer-${i})`);
+          out.push({
+            i,
+            bg: C(ink, bg),
+            card: C(ink, card),
+            pop: C(ink, pop),
+            tape: C(ink, tape),
+            // the NAME on the tape is written in the name arm (GameBoard.vue's `hoveredAuthor`)
+            tapeRing: C(read(`var(--color-peer-${i}-name)`), tape),
+            laminate: C(ink, laminate),
+          });
+        }
+        const blue = read("--color-user-ink");
+        out.push({ i: 0, bg: C(blue, bg), card: C(blue, card), pop: C(blue, pop), tape: C(blue, tape), tapeRing: 0, laminate: C(blue, laminate) });
+        probe.remove();
+        return out;
+      },
+      [CONTRAST, OVER],
+    );
+    const sticks = rows.filter((r) => r.i > 0);
+    const head = rows.find((r) => r.i === 0)!;
+    const worst = Math.min(...sticks.flatMap((r) => [r.bg, r.card, r.pop]));
+    const tapeRing = Math.min(...sticks.map((r) => r.tapeRing));
+    console.log(
+      `AA ${arm}: worst over bg/card/popover ${worst.toFixed(3)} · ` +
+        `the NAME ARM on the tape's paper ${sticks.map((r) => r.tapeRing.toFixed(3)).join(" ")} (worst ${tapeRing.toFixed(3)}) · ` +
+        `REPORTED the stick on the same paper ${sticks.map((r) => r.tape.toFixed(3)).join(" ")} (HEAD's own blue ${head.tape.toFixed(3)}) · ` +
+        `REPORTED laminate worst ${Math.min(...sticks.map((r) => r.laminate)).toFixed(3)} (blue ${head.laminate.toFixed(3)})`,
+    );
+    expect(worst).toBeGreaterThanOrEqual(4.5);
+    expect(tapeRing, `${arm}: the name's ink on the tape's flat paper`).toBeGreaterThanOrEqual(4.5);
+  }
+});
+
+// ── 2b · THE NAME ON THE TAPE, AND ITS TALLY, PAINTED ───────────────────────────────────────
+/** THE FLAT STATISTIC (the pass-5 critic's): the SPEC colour against the ground PAINTED under
+ *  every pixel the text changed — its minimum and its count under 4.5. The label photographed as
+ *  drawn, TWICE with its colour transparent (a pixel the two bare shots disagree on is a transient
+ *  ground and is dropped) and once more as drawn (the noise control); a Range over the text bounds
+ *  the clip. It reads what the ink COULD paint on this ground, which is the in-run negative's
+ *  statistic; what the glyphs DID paint is the chair's glyph-population probe below (§2b). */
+async function paintedName(page: Page, label: ReturnType<Page["locator"]>) {
+  const box = await label.evaluate((l) => {
+    const r = document.createRange();
+    r.selectNodeContents(l.firstChild!);
+    const b = r.getBoundingClientRect();
+    return { x: b.x, y: b.y, width: b.width, height: b.height };
+  });
+  const clip = { x: box.x - 1, y: box.y - 1, width: box.width + 2, height: box.height + 2 };
+  const ink = await rawOf(page, await page.screenshot({ clip }));
+  const spec = await label.evaluate((l) => getComputedStyle(l).color);
+  // a STYLESHEET, never a write into the Vue-owned label (LAWS P7 §F)
+  const off = await page.addStyleTag({ content: `${TAPE} { color: transparent !important; }` });
+  await expect.poll(() => label.evaluate((l) => getComputedStyle(l).color)).toBe("rgba(0, 0, 0, 0)");
+  const bare = await rawOf(page, await page.screenshot({ clip }));
+  const bare2 = await rawOf(page, await page.screenshot({ clip }));
+  await off.evaluate((e) => (e as Element).remove());
+  await expect.poll(() => label.evaluate((l) => getComputedStyle(l).color)).toBe(spec);
+  const again = await rawOf(page, await page.screenshot({ clip }));
+  const specRgb = await page.evaluate((css) => {
+    const c = document.createElement("canvas");
+    c.width = c.height = 1;
+    const g = c.getContext("2d", { willReadFrequently: true })!;
+    g.fillStyle = css;
+    g.fillRect(0, 0, 1, 1);
+    return Array.from(g.getImageData(0, 0, 1, 1).data.slice(0, 3));
+  }, spec);
+  const specL = lumAt(specRgb, 0);
+  const dist = (X: number[], Y: number[], k: number) =>
+    Math.abs(X[k] - Y[k]) + Math.abs(X[k + 1] - Y[k + 1]) + Math.abs(X[k + 2] - Y[k + 2]);
+  let top = 0;
+  let noise = 0;
+  const moved: number[] = [];
+  for (let k = 0; k < ink.data.length; k += 4) {
+    if (dist(ink.data, again.data, k) > 8 || dist(bare.data, bare2.data, k) > 8) {
+      noise++;
+      moved.push(0);
+      continue;
+    }
+    const d = dist(ink.data, bare.data, k);
+    moved.push(d);
+    top = Math.max(top, d);
+  }
+  const text: number[] = [];
+  moved.forEach((d, n) => {
+    if (d <= 0.2 * top) return;
+    text.push(ratio(specL, lumAt(bare.data, n * 4)));
+  });
+  // an EMPTY population is RED at the call site (worst = 0), never `Math.min()` of nothing
+  return {
+    spec,
+    textPx: text.length,
+    worst: text.length ? Math.min(...text) : 0,
+    under45: text.length ? text.filter((r) => r < 4.5).length : Infinity,
+    noise,
+  };
+}
+
+/** THE TALLY ON THE TAPE, PAINTED — the ring statistic on a stroke (§2.4 / §2.11): the tick
+ *  photographed ON, OFF (`visibility: hidden`), OFF again and ON again; a pixel either pair
+ *  disagrees on is dropped; the core is every pixel the tick moved at ≥ 50 % of the most-moved,
+ *  read as the painted pixel against the ground under it. */
+async function paintedTick(page: Page) {
+  const tick = page.locator(".attribution-tape .roster-tick");
+  const b = (await tick.boundingBox())!;
+  const clip = { x: Math.floor(b.x - 2), y: Math.floor(b.y - 2), width: Math.ceil(b.width + 4), height: Math.ceil(b.height + 4) };
+  const frames = () => page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+  const on = await rawOf(page, await page.screenshot({ clip }));
+  const hide = await page.addStyleTag({ content: ".attribution-tape .roster-tick { visibility: hidden !important; }" });
+  await frames();
+  const off = await rawOf(page, await page.screenshot({ clip }));
+  const off2 = await rawOf(page, await page.screenshot({ clip }));
+  await hide.evaluate((e) => (e as Element).remove());
+  await frames();
+  const on2 = await rawOf(page, await page.screenshot({ clip }));
+  const dist = (X: number[], Y: number[], k: number) =>
+    Math.abs(X[k] - Y[k]) + Math.abs(X[k + 1] - Y[k + 1]) + Math.abs(X[k + 2] - Y[k + 2]);
+  let top = 0;
+  const mv: [number, number][] = [];
+  for (let k = 0; k < on.data.length; k += 4) {
+    if (dist(on.data, on2.data, k) > 8 || dist(off.data, off2.data, k) > 8) continue;
+    const d = dist(on.data, off.data, k);
+    mv.push([d, k]);
+    top = Math.max(top, d);
+  }
+  const r = mv
+    .filter(([d]) => top > 0 && d >= 0.5 * top)
+    .map(([, k]) => ratio(lumAt(on.data, k), lumAt(off.data, k)))
+    .sort((u, v) => u - v);
+  return { top, n: r.length, med: r[r.length >> 1] ?? 0, p10: q(r, 0.1) ?? 0, under3: r.filter((v) => v < 3).length / Math.max(1, r.length) };
+}
+
+/** THE ESTATE'S ONE GLYPH-POPULATION PROBE at its PRODUCT HOME (`./lib/glyph-pop.mjs`, registry-v7
+ *  §2.4): the WHOLE glyph population clipped to the TEXT RUN (the tally's svg is never text), kept
+ *  only where two ON and two OFF photographs agree (the OFF-pair compare: a pixel that moved between
+ *  the OFF photographs of one pair is transient ground, never ink), G1 an empty or thin population
+ *  RED, G2 an ABSOLUTE core median, G3 the fraction under 4.5 bounded PER PAYLOAD (`glyphGate`: this
+ *  read's clean fraction + 0.05, never a pooled stamp), G4 columns scaled to the ink span, G5 per
+ *  glyph. This file carries no reader of its own. */
+type Pop = {
+  red: boolean;
+  why: string[];
+  population: number;
+  coreMedian: number;
+  fracUnder: number;
+  transientOn?: number;
+  transientOff?: number;
+};
+type Gate = { payload: string; bound: number | null; clean: Pop; plants: Record<string, Pop> };
+
+/** EVERY ID ON THE PAGE, PINNED (LAWS P7 §C): A the host (hand 0), four joiners, and B — the sixth
+ *  player, index 5, stick 1 on its second lap, so the tape carries a tick. The tape reads
+ *  "quickest-rodent" for B and A's own slug for A in every run and both engines. */
+const IDS = [
+  "p-0000000a0a0a",
+  "p-00000000c1c1",
+  "p-00000000c2c2",
+  "p-00000000c3c3",
+  "p-00000000c4c4",
+  "p-0000000b0b0b",
+] as const;
+const TAPE = ".attribution-tape .washi-label";
+/** THE AUTHORED ARM (LAWS P8 §E: a 'one publisher' row reads the AUTHORED value; the pass-8 critic's
+ *  §1.2): \`index.css\` as written, per arm, through the sheet's own \`var()\` chain — never
+ *  \`getComputedStyle\`, which resolves whatever the cascade ships (a \`.pcss\` re-declaration moved the
+ *  reference with the paint and every 'one publisher' row stayed GREEN). */
+const SHEET = readFileSync(fileURLToPath(new URL("../src/assets/index.css", import.meta.url)), "utf8").replace(/\/\*[\s\S]*?\*\//g, "");
+const authored = (ref: string, arm: "light" | "dark"): string => {
+  // \`ref\` is written as a consumer, \`var(--color-peer-N-name)\`: a token named in value position
+  const token = /^var\(\s*(--[\w-]+)\s*\)$/.exec(ref)?.[1] ?? ref;
+  const at = SHEET.indexOf("\n.dark");
+  const look = (t: string) => {
+    const re = new RegExp(`(?<![\\w-])${t}:\\s*([^;]+);`);
+    return (re.exec(arm === "dark" ? SHEET.slice(at) : SHEET.slice(0, at)) ?? (arm === "dark" ? re.exec(SHEET.slice(0, at)) : null))?.[1].trim() ?? null;
+  };
+  let v = look(token);
+  for (let d = 0; v && d < 5 && /^var\(/.test(v); d++) v = look(/^var\(\s*(--[\w-]+)\s*\)$/.exec(v)?.[1] ?? "--none");
+  if (!v || !/^#[0-9a-f]{6}$/i.test(v)) throw new Error(`index.css's ${arm} ${token} is not an authored hex (${v})`);
+  return `rgb(${[1, 3, 5].map((k) => parseInt(v!.slice(k, k + 2), 16)).join(", ")})`;
+};
+/** the name token the product BINDS on the tape (\`GameBoard\`'s anchor rebinds \`--color-user-ink\`); its
+ *  value is the authored arm above, never the cascade's */
+const tapeToken = (page: Page) =>
+  page.locator(".attribution-tape").evaluate((e) => (e as HTMLElement).style.getPropertyValue("--color-user-ink").trim());
+const nameIndex = (binding: string): number => {
+  const m = /^var\(\s*--color-peer-(\d+)-name\s*\)$/.exec(binding);
+  if (!m) throw new Error(`the tape binds --color-user-ink to ${binding || "nothing"}, not a name arm`);
+  return +m[1];
+};
+/** HEAD's ink for index i — `74a2b5d9`'s `inkFor`: hue i × 137.5°, chroma 0.11, band 0.5 / 0.8. The
+ *  ballot's control is THIS, the SAME INDEX (LAWS P7 §G, registry-v7 §2.13a); pass 7's control was
+ *  HEAD's best hue (i = 1, 137.5°), printed beside it so the chair holds both numbers. */
+const HEAD_INK = (i: number, arm: "light" | "dark"): string =>
+  `oklch(${arm === "light" ? 0.5 : 0.8} 0.11 ${((i * 137.5) % 360).toFixed(2)}deg)`;
