--- /dev/null
+++ b/web/frontend/src/pencil/composables/bootHand.ts
@@ -0,0 +1,102 @@
+import { ref } from "vue";
+import { createSequenceSubscription, type SequenceHandle } from "@mkbabb/pencil-boil";
+import { MOTION } from "@pencil/config/pencilConfig";
+
+/**
+ * T9-M20 · THE HAND'S CLOCK. The ruling used to read the wall clock, so a frame the main
+ * thread lost painted every line wherever the clock said (the grid's own four pose bakes landed
+ * inside its draw-in and moved one line 72–100 % in a single painted frame). Here one master
+ * `sequence` subscription carries the rAF timeline, and on each tick the hand's clock advances by
+ * that frame's interval, but never by more than `paceSlack` × the interval the display is
+ * KEEPING: the SHORTEST of the last `MOTION.hand.paceWindow` frames (a lost frame only lengthens an
+ * interval, so the minimum is the panel; the slack passes a shimmed or loaded panel's jitter whole),
+ * never below `stepMs` (one 60 Hz frame) and never above `maxStepMs` (one 24 Hz frame). So the hand is a RATE on every panel: a 60, a 30 and a 25 Hz
+ * display draw the page in the same time, and a stall pauses the hand for at most one and a half
+ * frames' travel at the panel's own rate instead of teleporting it, for every stall in a run
+ * shorter than the window. (Pass 7 capped the step at 17 ms outright, which a 30 Hz panel reads as a stall on
+ * every frame; pass 8's MEDIAN let the third consecutive stall of five travel as the pace,
+ * ACC-FIVE's critic's trap.) The
+ * library form (the pace on the sequence itself, pencil-boil 0.12.1, LEDGER T9-R4) deletes the
+ * clock half of this file.
+ */
+type Stroke = (clock: number) => boolean;
+
+const SPAN_MS = 600_000;
+let clock = 0;
+let last = -1;
+let master: SequenceHandle | null = null;
+const strokes = new Set<Stroke>();
+/** The last few frame intervals (the display's, observed). No seed: the first frame is observed. */
+const intervals: number[] = [];
+
+/** The most one frame may move the hand: `paceSlack` × the SHORTEST recent frame (a delivered
+ *  interval within that slack is the panel's own jitter and travels whole; a longer one is a lost
+ *  frame), so a run of stalls shorter than the window never moves it and a 30 Hz panel reads
+ *  33 ms, not 17; floored at one 60 Hz frame and capped, so a longer run is never a faster pace. */
+function pace(dt: number): number {
+  intervals.push(dt);
+  if (intervals.length > MOTION.hand.paceWindow) intervals.shift();
+  const shortest = Math.min(...intervals);
+  const floored = Math.max(shortest * MOTION.hand.paceSlack, MOTION.hand.stepMs);
+  return Math.min(floored, MOTION.hand.maxStepMs);
+}
+
+function tick(_eased: number, raw: number): void {
+  const t = raw * SPAN_MS;
+  if (last >= 0) {
+    const dt = Math.max(0, t - last);
+    clock += Math.min(dt, pace(dt));
+  }
+  last = t;
+  for (const s of [...strokes]) if (s(clock)) strokes.delete(s);
+  if (strokes.size === 0) {
+    master?.stop();
+    master = null;
+    last = -1;
+  }
+}
+
+/** Enroll a stroke on the hand clock (it returns `true` when finished); returns its withdrawal. */
+export function enrollStroke(stroke: Stroke): () => void {
+  strokes.add(stroke);
+  if (!master) {
+    master = createSequenceSubscription({ durationMs: SPAN_MS, onProgress: tick });
+    master.start();
+  }
+  return () => {
+    strokes.delete(stroke);
+  };
+}
+
+/**
+ * T9-M20 D15 · THE WAVE WAITS FOR THE LAST LIFT. A ruling in flight (from the moment the grid
+ * starts waiting for its poses to the hand's last lift) holds the deal's reveal wave, so no digit
+ * is inked on a page that is not yet ruled. `beginRuling` returns the release, idempotent; an
+ * interrupted ruling (an erase, an unmount) releases too, so the wave can never be stranded.
+ */
+let rulings = 0;
+let waiters: (() => void)[] = [];
+
+export function beginRuling(): () => void {
+  rulings++;
+  let open = true;
+  return () => {
+    if (!open) return;
+    open = false;
+    rulings--;
+    if (rulings > 0) return;
+    const run = waiters;
+    waiters = [];
+    for (const w of run) w();
+  };
+}
+
+/** Resolves at the last lift of every ruling in flight; `null` when none is. */
+export function afterRuling(): Promise<void> | null {
+  if (rulings === 0) return null;
+  return new Promise((resolve) => waiters.push(resolve));
+}
+
+/** The wordmark's pose stack has landed once (the boot's ruling waits for it, so its encodes
+ *  never run under the hand). Latched: a later re-bake (a game's label) does not re-arm it. */
+export const wordmarkResident = ref(false);
diff --git a/web/frontend/src/pencil/composables/useTallyStrokes.ts b/web/frontend/src/pencil/composables/useTallyStrokes.ts
