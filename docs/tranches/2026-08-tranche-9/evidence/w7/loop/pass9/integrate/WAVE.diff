+export async function samplerSelfTest(browser, { reps = 3 } = {}) {
+  const u = unitSelfTest();
+  const rows = [...u.rows];
+  let hole = u.hole,
+    cleanRed = false;
+  const run = async (key, plant) => {
+    const { ctx, page } = await openCell(browser, { width: 800, height: 300, reducedMotion: "no-preference" });
