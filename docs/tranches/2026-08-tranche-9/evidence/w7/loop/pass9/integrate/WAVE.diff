+console.log(`check-face-engine-identity — ${DIR}`);
+for (const e of ENGINES)
+  console.log(
+    `  ${e}: ${censuses[e] && !censuses[e]._bad ? `${censuses[e].words.length} chips, painted mark ${censuses[e].paintedMark} @dpr${censuses[e].dpr}` : "ABSENT"}`,
