+// `generateCellRects`, not from the product's recipe, so the pass-6 graft (inset 0.86, 5.4 u)
+// shipped as the default reds it at every board.
+describe("gridPaths — the shipped ring is 74a2b5d9's", () => {
+  it("every resident ring at 4×4, 9×9 and 16×16 is HEAD's recipe byte for byte", () => {
+    expect(RING_GEOMETRY.arm).toBe("head");
+    for (const n of [4, 9, 16]) {
+      const cs = 1000 / n;
+      const rects = generateCellRects(n, Math.sqrt(n), 1000, 42);
+      let same = 0;
+      for (let pos = 0; pos < n * n; pos++) {
+        const head = wobbleRect((pos % n) * cs, Math.floor(pos / n) * cs, cs, cs, {
