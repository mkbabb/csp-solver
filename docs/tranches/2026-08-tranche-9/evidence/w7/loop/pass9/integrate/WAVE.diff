+    }
+    return {
+      band,
+      ringBand: ringBandNow,
+      ring: ringGeom,
+      hands,
+      nearest,
+      houseReference,
+      underReference,
+      houseShare,
+      houseTokens: tokens.length,
+      aa,
+      ringArithmetic,
+      arcs,
+      ringAlpha,
+      digitVsRing,
+      alphaOnly: { first, under065 },
+      peerVsPeer,
+    };
+  });
+  await seatCursor(page, null);
+  return out;
