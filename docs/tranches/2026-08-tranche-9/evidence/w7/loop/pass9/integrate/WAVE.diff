+  await page.evaluate(installClipRead);
+  const m = await readMover(page, { sel: SUBJECT, key: 'g' });
+  const clip = await page.evaluate(() => {
+    const w = window as unknown as { __clipMin: number; __clipFrames: number };
+    return { clipMin: w.__clipMin, clipFrames: w.__clipFrames };
+  });
+  const lastW = await page.evaluate((sel) => document.querySelector(sel)?.getBoundingClientRect().width ?? 0, SUBJECT);
+  if (cell.game !== 'sudoku')
+    expect(
+      await page.locator('.game-card.is-center .board-peek-host').count(),
+      'the centre card lost the live board (the deck re-centred under the fold)',
+    ).toBe(1);
+  await ctx.close();
+  return { m, ...clip, restW, lastW };
+}
+
+/** The gate's clauses — the sampler's F1 and CI, BOTH engines at ±3 px / ±2 ms (LAWS P7 §D; the
+ *  FRAME clock binds, pass8/CHAIR-RULINGS §2.4). Returns every failure (empty = GREEN). */
+function failures(m: Mover): string[] {
+  const out = [...m.post.why];
+  if (m.kPaint < 0) out.push(`the mover never reported its first painted frame (io ${m.io})`);
+  return out;
+}
+
+for (const cell of CELLS) {
+  test(`GA1 · the fold's first painted frame is its first pose · ${cell.name}`, async ({
+    browser,
+  }) => {
+    const r = await readFold(browser, cell);
+    console.log(
+      `GA1 ${test.info().project.name} ${cell.name}: kPaint ${r.m.kPaint} (rAF-time key ${r.m.kStamp}) io ${r.m.io} | POST ${fmtArm(r.m.post)} | rAF-TIME KEY ${fmtArm(r.m.byStamp)} | inRAF ${fmtArm(r.m.inRAF)} | GA2 visible min ${r.clipMin.toFixed(3)} over ${r.clipFrames} frames; load ${loadavg()[0].toFixed(1)}`,
+    );
+    expect(failures(r.m)).toEqual([]);
+    // the glide MOVES after frame 1 (a hold that never releases would pass the rows above)
+    expect(r.m.post.frames ?? 0, 'the fold ran fewer than three frames').toBeGreaterThanOrEqual(3);
+    expect(r.lastW, 'the fold never shrank the board').toBeLessThan(r.restW - 3);
+    // GA2: never clipped while it folds
+    expect(r.clipFrames, 'GA2 read no folding frame').toBeGreaterThan(0);
+    expect(r.clipMin, `the folding board is clipped (visible ${r.clipMin.toFixed(3)})`).toBeGreaterThanOrEqual(0.999);
+  });
+}
+
+// THE NEGATIVES, in-run, both engines: PLANT skip (frame 1 painted 150 ms in) must red F1, PLANT skip16
+// (one frame in, 16 ms: the pass-8 critic's WebKit frame-1 clock) must red F1ct, and the pass-7 critic's
+// PLANT f2 (frame 1 at rest, then the clock jumps 150 ms on the second rAF) must red CI. In WebKit the
+// fold's frame-1 post read is stale on every run (pass 9), so skip and skip16 red there only through the
+// ONE sampler's stale-rebase (MOT-VERB pass 9, PROPOSED to the home).
+for (const [plant, clause] of [
+  ['skip', 'f1red'],
+  ['skip16', 'f1ct'],
+  ['f2', 'ciRed'],
+] as const)
+  test(`GA1 · PLANT ${plant} reds the post-paint read · ${CELLS[0].name}`, async ({ browser }) => {
+    const r = await readFold(browser, CELLS[0], plant);
+    console.log(
+      `GA1 PLANT ${plant} ${test.info().project.name}: POST ${fmtArm(r.m.post)} → ${r.m.post[clause] ? `RED (${clause})` : 'GREEN (the gate is blind)'}`,
+    );
+    expect(r.m.post[clause], `PLANT ${plant} painted and the ${clause} clause stayed green`).toBe(true);
+  });
