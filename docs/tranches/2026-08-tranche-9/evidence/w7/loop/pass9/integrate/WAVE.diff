+/** Clause switches for the postpaint sabotage battery (POSTPAINT_SABOTAGE=a,b; LAWS P7 §F (ii)). */
+export const PP_CLAUSES = ["F1", "F1ct", "CI", "key-inraf", "stale"];
+const PP_OFF = new Set((process.env.POSTPAINT_SABOTAGE ?? "").split(",").filter(Boolean));
+const ppOn = (c) => !PP_OFF.has(c);
+/** The frame that first painted the mover: the last frame whose rAF time is at or before the entry,
+ *  CAPPED at the first frame whose IN-RAF read already holds the animation (the chair, pass 9,
+ *  key-inraf): that read is taken before the frame's rendering update, so frame k paints what it saw.
+ *  Under load Chromium can stamp the entry after the NEXT frame's (back-dated) rAF time, and the
+ *  rAF-time key alone dropped a clean frame 1 (the s13 integrator's ~1 in 8, ct 8.3 c 49.8). */
+export const kPaintByStamp = (pp) => (pp.io == null || pp.io < 0 ? -1 : pp.stamps.reduce((k, r, i) => (r <= pp.io ? i : k), -1));
+export const kPaintOf = (pp) => {
+  const k = kPaintByStamp(pp);
+  if (k < 0 || !ppOn("key-inraf")) return k;
+  const seen = (pp.inRAF ?? []).find((x) => x.ct !== null)?.k;
+  return seen != null && seen < k ? seen : k;
+};
+
+/** Frames with the animation present, keyed on `kPaint` (reads before it DROPPED); F1 + CI verdicts. */
+export function analyse(frames, rest, { kPaint = -1, tolPx = 3, tolMs = 2, ks = [2, 3], ctTol = 4, inRAF = null } = {}) {
+  // STALE (the chair, pass 9): a post read whose timeline moved past its frame's is the NEXT frame's
+  // read; frame k's own pre-update read (inRAF) stands in for it, marked, never silently kept
+  let stale = 0;
+  const byK = new Map((inRAF ?? []).map((x) => [x.k, x]));
+  const fixed = frames.map((x) => {
+    if (!ppOn("stale") || x.tlNow == null || x.tlNow === x.tl || x.ct === null) return x;
+    stale++;
+    const s = byK.get(x.k);
+    return s ? { ...s, stale: true } : { ...x, ct: null };
+  });
+  const all = fixed.filter((x) => x.ct !== null).sort((a, b) => a.k - b.k);
+  const f = kPaint >= 0 ? all.filter((x) => x.k >= kPaint) : all;
+  const dropped = all.length - f.length;
+  if (!f.length) return { red: true, f1red: true, ciRed: false, why: ["EMPTY: the subject never animated"], f1: null, ci: [], dropped };
+  const c = (s) => Math.hypot(s.x - rest.x, s.y - rest.y),
+    dw = (s) => s.w - rest.w;
+  const why = [];
+  const f1pos = ppOn("F1") && (c(f[0]) > tolPx || Math.abs(dw(f[0])) > tolPx);
+  // F1ct (LAWS P8 §D, the frame-1 clause): frame 1 paints at ct ≤ ctTol (4 ms, a quarter frame at
+  // 60 Hz). A 3 px position tolerance alone passes WebKit's 11–33 ms started clock on an eased foot
+  const f1ct = ppOn("F1ct") && Math.abs(f[0].ct) > ctTol;
+  const f1red = f1pos || f1ct;
+  if (f1pos) why.push(`F1 frame 1 at ct ${f[0].ct.toFixed(1)}: centre ${c(f[0]).toFixed(2)} px, dw ${dw(f[0]).toFixed(2)} px (> ${tolPx})`);
+  if (f1ct) why.push(`F1ct frame 1 at ct ${f[0].ct.toFixed(1)} ms (> ${ctTol})`);
+  const ci = [];
+  let ciRed = false;
+  for (const k of ks) {
+    const fk = f[k - 1];
+    if (!fk) {
+      why.push(`CI frame ${k} missing`);
+      ciRed = true;
+      continue;
+    }
+    const want = fk.tl - f[0].tl;
+    const off = fk.ct - want; // the law: ct(frame k) = tl(k) − tl(frame 1), frame 1 at ct 0
+    ci.push({ k, ct: +fk.ct.toFixed(1), tlDelta: +want.toFixed(1), off: +off.toFixed(1) });
+    if (ppOn("CI") && Math.abs(off) > tolMs) {
+      why.push(`CI ct(frame ${k}) ${fk.ct.toFixed(1)} vs tl(${k})−tl(1) ${want.toFixed(1)} (off ${off.toFixed(1)} ms > ${tolMs})`);
+      ciRed = true;
+    }
+  }
+  return { red: why.length > 0, f1red, f1pos, f1ct, ciRed, why, f1: { k: f[0].k, ct: +f[0].ct.toFixed(1), c: +c(f[0]).toFixed(2), dw: +dw(f[0]).toFixed(2), ps: f[0].ps, stale: !!f[0].stale }, ci, frames: f.length, dropped, stale };
+}
