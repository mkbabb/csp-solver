+    await page.keyboard.press('Escape');
+    await expect(mark(page)).toHaveAttribute('aria-expanded', 'false');
+    return r;
+  };
+  const r16 = await at('16px');
+  const r18 = await at('18px');
+  expect(r16.want, JSON.stringify({ r16, r18 })).toBe(15);
+  expect(r18.want, JSON.stringify({ r16, r18 })).toBe(17);
+  expect(Math.abs(r16.mean - r16.want), JSON.stringify({ r16, r18 })).toBeLessThanOrEqual(1);
+  expect(Math.abs(r18.mean - r18.want), JSON.stringify({ r16, r18 })).toBeLessThanOrEqual(1);
+  expect(r18.mean - r16.mean, JSON.stringify({ r16, r18 })).toBeGreaterThanOrEqual(1);
+});
