+  rows.push(`POSTPAINT unit U4 bounds: ct 3.99 ${at(3.99, 0).f1ct ? "RED" : "GREEN"} / 4.01 ${at(4.01, 0).f1ct ? "RED" : "GREEN"} · dx 2.99 ${at(0, 2.99).f1pos ? "RED" : "GREEN"} / 3.01 ${at(0, 3.01).f1pos ? "RED" : "GREEN"} ${u4 ? "OK (margins ±0.01)" : "← a hole"}`);
