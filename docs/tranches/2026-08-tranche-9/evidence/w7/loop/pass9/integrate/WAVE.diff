+/** A row's two arms in ONE run: the clean read gates in Chromium, and the in-run negative (its
+ *  clause cut) must red there on the band's nearest pixel WHERE THE BAND EXISTS (`bites`). WebKit
+ *  prints both (print-only for aim). */
+async function edgeRow(browser: Browser, info: TestInfo, name: string, height: number, size: number, aim: Aim, clause: Disjunct, nearest: string, bites: boolean, width = 390) {
+  const c = await edgeReads(browser, height, size, aim, undefined, width);
