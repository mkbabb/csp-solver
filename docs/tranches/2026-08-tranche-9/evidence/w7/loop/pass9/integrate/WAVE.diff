+  // in main.ts made the reveal AND DarkModeToggle's `scale … var(--ease-anticipatePop)` transition
+  // compute `ease-in` in both engines while this map read stylesheets only (pass-7 critique §2.5,
+  // E1). Every script write of a curve token — `setProperty`, `.style[…]`, `Object.assign`,
+  // `cssText` — is read through the ONE library's `scriptWrites` and joins the token's values; a
+  // value that is not a string literal, or a computed name that could spell a curve token, is
+  // UNRESOLVED and reds (B8 cannot read the curve it publishes).
+  const blind = [];
