+/** FROM40 (the chair, pass 9): the subject's first keyframe sits 40 px off its rest pose at ct 0 —
+ *  a frame-1 POSITION defect only F1's position clause can see (F1ct reads ct 0). */
+export const FROM_PLANT = (sel) => {
+  const animate = Element.prototype.animate;
+  Element.prototype.animate = function (kf, ...rest) {
+    if (this.matches?.(sel) && Array.isArray(kf) && kf[0]?.transform)
+      kf = [{ ...kf[0], transform: "translateX(40px)" }, ...kf.slice(1)];
+    return animate.call(this, kf, ...rest);
+  };
