+/** The DETERMINISTIC rows (pure; no browser, no clock): each pins one clause on a recorded shape. */
+export function unitSelfTest() {
+  const rows = [];
+  let hole = false;
+  const rest = { x: 70, y: 110, w: 60 };
+  const fr = (k, tl, ct, dx = 0, tlNow = tl) => ({ k, tl, tlNow, ct, ps: "running", x: rest.x + dx, y: rest.y, w: 60 });
