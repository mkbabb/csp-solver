+/**
+ * THE SHEET'S BOX, ONE DISJUNCT AT A TIME (pass-8 critic gap 1; LAWS P8 §F, every disjunct of a box
+ * predicate reds a landed row or states why it cannot be reached). `outside()` in PlayerMark.vue is
+ * five clauses; each is cut from the dev server's own module, in the run, landing once per page:
+ *   NO_BOTTOM    row 14's negative: a touch 1px below the sheet, over the board, reaches nothing
+ *   NO_RIGHT     row 16's negative: a touch 1px right of the sheet, over the board, reaches nothing
+ *   NO_LEFT      UNREACHABLE: the sheet hangs at the page's left edge (left 0 at every phone cell),
+ *                so the band left of it is off the viewport and no touch can be delivered there
+ *   NO_TOP       row 17's negative: on a PORTRAIT phone the sheet's top sits under the mark, above
+ *                the board's first row (131.73 at 9×9 390×664), but on a coarse LANDSCAPE phone
+ *                (844×390) the board starts at 16 and the sheet's top (56) runs over its first
+ *                columns: a touch 1px above the sheet there, over the board, reaches nothing
+ *   NO_TOUCHKEY  UNREACHABLE: a mouse or pen press is delivered at its own point (no touch
+ *                adjustment), so every non-touch press the sheet hears is inside its box and
+ *                `outside()` is false for it with the key or without
+ * `PLACE_SABOTAGE=<clause>` cuts that clause in every coarse table of this file (the battery).
+ * WEBKIT IS PRINT-ONLY FOR AIM (CHAIR pass 9 §11; §11 law 7): emulated WebKit aims a touch at its
+ * own point and never delivers one from outside to the sheet, so no plant can red its column. Its
+ * reads are printed; real iOS aim is the RUNSHEET's (M19).
+ */
+type Disjunct = 'NO_LEFT' | 'NO_RIGHT' | 'NO_TOP' | 'NO_BOTTOM' | 'NO_TOUCHKEY';
+const DISJUNCT: Record<Disjunct, RegExp> = {
+  NO_LEFT: /e\.clientX\s*<\s*r\.left\s*\|\|\s*/,
+  NO_RIGHT: /e\.clientX\s*>\s*r\.right\s*\|\|\s*/,
+  NO_TOP: /e\.clientY\s*<\s*r\.top\s*\|\|\s*/,
+  NO_BOTTOM: /\s*\|\|\s*e\.clientY\s*>\s*r\.bottom/,
+  NO_TOUCHKEY: /e\.pointerType\s*===\s*"touch"\s*&&\s*(?=outside\(e\))/,
+};
+const SABOTAGE = (process.env.PLACE_SABOTAGE || null) as Disjunct | null;
+if (SABOTAGE && !(SABOTAGE in DISJUNCT)) throw new Error(`PLACE_SABOTAGE=${SABOTAGE}: no such clause`);
+
+async function coarseTable(browser: Browser, height: number, size = 3, cut: Disjunct | null = SABOTAGE, width = 390) {
+  const ctx = await browser.newContext({
+    viewport: { width, height },
+    hasTouch: true,
+    isMobile: true,
+    deviceScaleFactor: 1,
+  });
+  const hits = { n: 0 };
+  if (cut)
+    await ctx.route(/\/src\/pencil\/chrome\/PlayerMark\/PlayerMark\.vue(\?[^#]*)?$/, async (route) => {
+      const res = await route.fetch();
+      const body = (await res.text()).replace(DISJUNCT[cut], () => (hits.n++, ''));
+      await route.fulfill({ response: res, body });
+    });
+  const pages = await table(ctx, 2, size);
+  for (const p of pages) {
+    expect(await p.evaluate(() => matchMedia('(pointer: coarse)').matches)).toBe(true);
+  }
+  // each page of the table loads the module once, and the cut lands once in each
+  if (cut) expect(hits.n, `${cut}: the cut landed exactly once per page`).toBe(pages.length);
+  return { ctx, pages, hits };
+}
