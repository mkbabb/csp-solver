+ *  the window where the fraction under 4.5 is past 0.5 and still inside G3's bound (the control's
+ *  fraction + the slack). Where that bound is at or under 0.5, G2 is a strict subset of G3 and has
+ *  no plant of its own: stated, never asserted. */
+const G2SWEEP = (subject: string) =>
+  Array.from({ length: 14 }, (_, k) => 99.5 - k / 2).map(
+    (f) =>
+      [
+        `G2win_${f}`,
+        `${subject}, ${subject} * { -webkit-text-fill-color: color-mix(in srgb, currentColor ${f}%, transparent) !important; }`,
+      ] as const,
