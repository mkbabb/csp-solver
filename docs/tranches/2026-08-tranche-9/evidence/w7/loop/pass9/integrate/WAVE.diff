+/** GA2's read, beside the sampler (which reads the mover's pose, never its clip): on every frame the
+ *  mover animates, the fraction of the board no ancestor's overflow clips. */
+function installClipRead(): void {
+  const w = window as unknown as { __clipMin: number; __clipFrames: number };
+  w.__clipMin = 1;
+  w.__clipFrames = 0;
+  const tick = () => {
+    const board = document.querySelector('.board-peek-host');
+    const live = board
+      ?.getAnimations()
+      .some((a) => !(a instanceof CSSTransition) && !(a instanceof CSSAnimation));
