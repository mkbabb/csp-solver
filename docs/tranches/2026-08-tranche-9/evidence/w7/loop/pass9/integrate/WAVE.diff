+/* ══ 6 · THE TAPE COVENANT, AT THE CONSUMER ════════════════════════════════════════════════ */
+
+test.describe("the tape covenant", () => {
+  test.use(coarse(390, 844));
+
+  test("a printed tape still costs its well ZERO height", async ({ page }) => {
