+/** `linear(<stops>)` is the identity when every stop, placed by the CSS rules (first 0 %, last
+ *  100 %, a missing position spread evenly between its neighbours), sits on y = x. */
+function linearIsIdentity(body) {
+  const pts = [];
+  for (const stop of body.split(",")) {
+    const [y, ...xs] = stop.trim().split(/\s+/);
+    if (!xs.length) pts.push({ y: Number(y), x: null });
+    for (const x of xs)
+      pts.push({ y: Number(y), x: /%$/.test(x) ? Number(x.slice(0, -1)) / 100 : NaN });
+  }
+  if (pts.length < 2) return false;
+  if (pts[0].x === null) pts[0].x = 0;
+  if (pts[pts.length - 1].x === null) pts[pts.length - 1].x = 1;
+  for (let i = 1; i < pts.length; i++) {
+    if (pts[i].x !== null) continue;
+    let j = i;
+    while (pts[j].x === null) j++;
+    const x0 = pts[i - 1].x;
+    for (let k = i; k < j; k++)
+      pts[k].x = x0 + ((pts[j].x - x0) * (k - i + 1)) / (j - i + 1);
