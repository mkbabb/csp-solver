+  page,
+}) => {
+  const room = `tally-base-${Date.now()}`;
+  await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+  await settled(page);
+
+  let at = 1;
+  const widths: Record<number, number | null> = {};
+  for (const N of [1, 2, 3, 4, 5, 6, 9, 10, 14, 15, 16]) {
+    await peers(page, room, N - at);
+    at = N;
+    await stable(() => mark(page).evaluate((e) => e.getBoundingClientRect().width));
+    const h = await head(page);
+    widths[N] = h.width;
+    expect(h.label).toBe(nameAt(N));
+    // ONE REFERENT: `and N more` is the sheet's rows it could not draw, so no name borrows it
+    expect(h.label).not.toMatch(/\bmore\b/);
+    expect(h.strokes).toBe(N <= 5 ? N : SIX_ARM === "remainder" ? 5 : 0);
