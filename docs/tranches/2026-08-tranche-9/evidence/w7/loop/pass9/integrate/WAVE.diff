+      ["gate evaluate (pass 8's text match)", () => verdict(["evaluate"])],
+      ["gate logical", () => verdict(["logical"])],
+      ["gate own-pad", () => verdict(["own-pad"])],
+      ["gate shift", () => verdict(["shift"])],
+    ] as const) {
+      const v = (run as () => Record<string, boolean>)();
+      battery[clause] = Object.entries(v).filter(([, red]) => !red).map(([n]) => n);
+    }
+    console.log(`[RULE row 28 source] sabotage → rows no longer read as the law ${JSON.stringify(battery)}`);
+    for (const [clause, greens] of Object.entries(battery)) expect(greens.length, `clause ${clause} bites`).toBeGreaterThan(0);
+  });
+
+  /** The SERVED cascade at the element (the behavioural twin of the source arm; LAWS P7 §F (iii)):
+   *  every CSSOM style rule the engine says MATCHES `#card-foot` (selector matching by the engine,
+   *  media by `matchMedia`, layers and nesting walked) plus the inline style, each declaration of a
+   *  PAD name (`padding-bottom`, `padding-block-end`, the `padding` / `padding-block` shorthands —
+   *  CSSOM's `padding-bottom` is blind to a logical longhand, and a shorthand holding an `env()`
+   *  serialises its longhands empty) or a DISPLACEMENT name (`margin-bottom` / `margin-block(-end)`
+   *  / `margin`, `bottom` / `inset-block(-end)` / `inset`). Pass 9: each site is EVALUATED BY THE
+   *  ENGINE at inset 0 and 34 — a probe beside the foot takes the value with the `env()` replaced
+   *  and the engine computes the block-end side — so a net-zero stack, a logical longhand or an
+   *  `em` is read as the engine reads it, never matched as text (LAWS P8 §F; both engines). */
+  const SERVED_PAD = (page: Page) =>
+    page.evaluate(() => {
+      const el = document.getElementById("card-foot")!;
+      const PAD = ["padding-bottom", "padding-block-end", "padding", "padding-block"];
+      const SHIFT = ["margin-bottom", "margin-block-end", "margin", "margin-block", "bottom", "inset-block-end", "inset", "inset-block"];
+      const ENV = /env\(\s*safe-area-inset-bottom\s*(?:,[^()]*(?:\([^()]*\)[^()]*)*)?\)/g;
+      const side = (p: string) => (/^padding/.test(p) ? "paddingBottom" : /^margin/.test(p) ? "marginBottom" : "bottom");
+      const evalAt = (p: string, v: string, inset: number) => {
+        const probe = document.createElement("div");
+        probe.style.cssText = "position: relative; visibility: hidden; height: 0; overflow: hidden";
+        el.parentElement!.insertBefore(probe, el);
+        // `important`: an inline !important outranks any sheet !important, so a planted universal
+        // cannot reach the probe and re-value the site under evaluation (first run: the shipped site
+        // read 0 / 0 under the `* { padding-bottom: 0 !important }` plant)
+        probe.style.setProperty(p, v.replace(ENV, `${inset}px`), "important");
+        const set = probe.style.getPropertyValue(p) !== "";
+        const n = parseFloat(getComputedStyle(probe)[side(p) as "paddingBottom"]);
+        probe.remove();
+        return set && Number.isFinite(n) ? +n.toFixed(3) : null;
+      };
+      const out: { site: string; prop: string; pad: boolean; v0: number | null; v34: number | null }[] = [];
+      const take = (where: string, decl: CSSStyleDeclaration) => {
+        for (const p of [...PAD, ...SHIFT]) {
+          const v = decl.getPropertyValue(p);
+          if (!v) continue;
+          const imp = decl.getPropertyPriority(p) ? " !important" : "";
+          out.push({ site: `${where} { ${p}: ${v}${imp} }`, prop: p, pad: PAD.includes(p), v0: evalAt(p, v, 0), v34: evalAt(p, v, 34) });
+        }
+      };
+      const walk = (rules: CSSRuleList, live: boolean) => {
+        for (const r of Array.from(rules)) {
+          if (r instanceof CSSMediaRule) walk(r.cssRules, live && matchMedia(r.conditionText).matches);
+          else if (r instanceof CSSStyleRule) {
+            let hit: boolean;
+            try {
+              hit = el.matches(r.selectorText);
+            } catch {
+              hit = false;
+            }
+            // a UNIVERSAL reset (Tailwind's preflight `*, ::after, ::before`, specificity 0 in the base
+            // layer) matches every element and loses to every class: not a site that can decide the
+            // foot's block end — unless a declaration in it is `!important` (a plant below)
+            const universal = !r.selectorText.replace(/::?(before|after|backdrop|marker|placeholder|file-selector-button)|\*|,|\s/g, "");
+            const anyImp = [...PAD, ...SHIFT].some((p) => r.style.getPropertyPriority(p));
+            if (live && hit && (!universal || anyImp)) take(r.selectorText, r.style);
+            if ((r as unknown as { cssRules?: CSSRuleList }).cssRules?.length) walk((r as unknown as { cssRules: CSSRuleList }).cssRules, live);
+          } else if ((r as unknown as { cssRules?: CSSRuleList }).cssRules) walk((r as unknown as { cssRules: CSSRuleList }).cssRules, live);
+        }
+      };
+      for (const sh of Array.from(document.styleSheets)) {
+        try {
+          walk(sh.cssRules, true);
+        } catch {
+          out.push({ site: `UNREADABLE ${sh.href}`, prop: "", pad: true, v0: null, v34: null });
+        }
+      }
+      take("style=", el.style);
+      return out;
+    });
+  type Served = Awaited<ReturnType<typeof SERVED_PAD>>;
+  /** The served law: ≥ 1 pad site; every pad site Δ = 34 (± FOOT_EPS) with a pad of its own at 0;
+   *  every displacement site 0 at both insets; nothing unevaluable. Returns the offending sites. */
+  const SERVED_BAD = (sites: Served) => [
+    ...(sites.some((x) => x.pad) ? [] : ["no pad site"]),
+    ...sites
+      .filter((x) =>
+        x.v0 === null || x.v34 === null
+          ? true
+          : x.pad
+            ? Math.abs(x.v34 - x.v0 - 34) > FOOT_EPS || !(x.v0 > 0)
+            : x.v0 !== 0 || x.v34 !== 0,
+      )
+      .map((x) => `${x.site} → ${x.v0} @0 / ${x.v34} @34`),
+  ];
+  const SERVED_OK = (sites: Served) => SERVED_BAD(sites).length === 0;
+  /** The served arm's clause-sabotage (LAWS P7 §F ii): `logical` off keeps the physical names only
+   *  (pass 8's read set), `evaluate` off matches the pass-8 text instead of the engine's two values,
+   *  `shift` off drops the displacement names. Each must let ≥ 1 plant read GREEN. */
+  const SERVED_OK_OFF = (sites: Served, off: "logical" | "evaluate" | "shift") => {
+    const kept = sites.filter((x) =>
+      off === "logical" ? ["padding-bottom", "padding", ""].includes(x.prop) : off === "shift" ? x.pad : true,
+    );
+    if (off !== "evaluate") return SERVED_OK(kept);
+    return kept.some((x) => x.pad) && kept.every((x) => !x.pad || /\{ [a-z-]+: calc\([^;]*\+\s*env\(safe-area-inset-bottom\)\) \}$/.test(x.site));
+  };
+  /** A SYNTHETIC INSET in either engine (WebKit has no inset emulation): every SERVED stylesheet is
+   *  routed with `env(safe-area-inset-bottom[, …])` rewritten to `<inset>px` before the page sees it,
+   *  so the engine mounts and lays the page out as it would under that inset from the first frame.
+   *  (A CSSOM rewrite after mount read 10 css low against CDP: the sheet's pose is measured as it
+   *  mounts, so the rewrite must be in the bytes.) Calibrated against the chromium CDP inset in the
+   *  row below (same pad, same lowest ink). Call before the page loads; returns the rewrite count. */
+  const FOOT_ENV = /env\(\s*safe-area-inset-bottom\s*(?:,[^()]*(?:\([^()]*\)[^()]*)*)?\)/g;
+  //  ONE route for the whole test, the inset a switch on it (`null` = the bytes as served): a route
+  //  dropped and re-added let the HTTP cache hand the next load the REWRITTEN sheet (the first run's
+  //  served arm read `calc(34px + .15rem)` on a page that never asked for the inset).
+  const SYNTH_ROUTE = async (page: Page) => {
+    const st: { inset: number | null; n: number } = { inset: null, n: 0 };
+    await page.route(/\.css(\?.*)?$/, async (route) => {
+      const r = await route.fetch();
+      let body = await r.text();
