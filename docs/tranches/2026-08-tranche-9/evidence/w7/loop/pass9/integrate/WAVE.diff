+
+/**
+ * THE LIVING MARK'S POSE (T9-W7 §5) — a mark under the reader's hand breathes ONCE.
+ *
+ * `useBeatFrame` is the perpetual form: enrol and the poses cycle for as long as the surface
+ * lives. This is the one-shot form. When `landed` names something new the pose steps the
+ * shared beat for `markSettleBeats` beats and then rests on pose 0 — and since that count
+ * equals `frameCount`, the revolution's last step IS pose 0, so the mark settles on the pose
+ * it started from and nothing moves while nobody's hand is on it.
+ *
+ * `landed` returns the IDENTITY of whatever holds the hand (a cell index, an element, an armed
+ * ribbon's card) or null for nothing. A re-measure of the same target is not a landing and
+ * never restarts the breath.
+ *
+ * PRM is inherited whole: the library force-clears the beat driver, so the counter never
+ * advances, `elapsed` stays 0, and the mark is born at pose 0 with zero swaps.
+ */
+export function useMarkPose(landed: () => unknown): Readonly<Ref<number>> {
+  const sharedBeat = useBoilBeat();
+  const start = ref(-1);
+  watch(landed, (v) => {
+    start.value = v == null ? -1 : sharedBeat.value;
+  });
+  return computed(() => {
+    if (start.value < 0) return 0;
+    const elapsed = sharedBeat.value - start.value;
+    if (elapsed <= 0 || elapsed >= BOIL_CONFIG.markSettleBeats) return 0;
+    return elapsed % Math.max(1, BOIL_CONFIG.frameCount);
+  });
+}
