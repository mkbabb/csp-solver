+  const dashOffset = (k: string): number => 100 * (1 - (reveal[k] ?? 1));
+
+  onUnmounted(stop);
+
+  return {
+    poses,
+    boilFrame,
+    reducedMotion,
+    drawIn,
+    settle,
+    forget,
+    stop,
+    dashOffset,
+  };
+}
