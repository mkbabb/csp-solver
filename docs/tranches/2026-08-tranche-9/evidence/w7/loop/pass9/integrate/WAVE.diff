+// ── LEAVE-WHILE-PENDING (PLR-PLACE's critic, registry-v5 §3.14): a key that leaves mid-draw ─
+// The tween map is per key, so its cleanup must reach a key whose first draw-in has not landed.
+// A person arrives, leaves 150ms into the draw-in, and returns 100ms later. Their stroke must
+// draw from nothing ONCE: the dash only falls from the return and lands. If `forget` leaves the
+// first tween running, it lands first, deletes the SECOND tween's handle and writes 1; the
+// second then writes its own progress back over it — the dash jumps to 0 and rises.
+// (A key pending on its STAGGER delay is not reachable from the wire: every message is its own
+// task, so each arrival reaches `drawIn` alone, at position 0.)
+test("a person who leaves mid-draw and comes back draws once, from nothing", async ({ page }) => {
+  const room = `tally-lwp-${Date.now()}`;
+  await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+  await settled(page);
+  await peers(page, room, 1);
+  const trace = await page.evaluate(
+    ({ room }) =>
+      new Promise<{ t: number; n: number; off: number; back: boolean }[]>((done) => {
+        const ch = new BroadcastChannel(`board:${room}`);
+        const out: { t: number; n: number; off: number; back: boolean }[] = [];
+        let back = false;
+        const t0 = performance.now();
+        const read = () => {
+          const ps = [...document.querySelectorAll("[data-player-mark]")]
+            .find((m) => m.getBoundingClientRect().width > 0)!
+            .querySelectorAll(".pt-pose.is-active path");
+          const last = ps[ps.length - 1];
+          return { n: ps.length, off: last ? Number(last.getAttribute("stroke-dashoffset")) : NaN };
+        };
+        ch.postMessage({ kind: "hi", data: {}, from: "lwp" });
+        // sleep-ok: the elapsed time IS the subject, the leave lands mid-draw and the return after
+        setTimeout(() => ch.postMessage({ kind: "bye", data: {}, from: "lwp" }), 150);
+        setTimeout(() => {
+          ch.postMessage({ kind: "hi", data: {}, from: "lwp" });
+          back = true;
+        }, 250);
+        const tick = () => {
+          out.push({ t: performance.now() - t0, ...read(), back });
+          // sleep-ok: the elapsed window IS the subject, the return's whole draw-in and the first's end
+          if (performance.now() - t0 < 1500) requestAnimationFrame(tick);
+          else {
+            ch.close();
+            done(out);
+          }
+        };
+        requestAnimationFrame(tick);
+      }),
+    { room },
+  );
