+/* ══ 12b · ONE RING ON EVERY CARD CONTROL (pass 9, charter row 5; CHAIR-RULINGS §5) ══════════
+   The ring row above reads two sites. The card renders every button, tab and tab stop its children
+   carry, and the fold shipped a second, dashed form on all of those (s10's generic rule) beside
+   DrawerTab's dashed `currentColor`: a reader of two sites cannot see either. So the census walks
+   EVERY focusable the visible card renders, plus the drawer's tab, by the keyboard's road, and
+   each must read the ONE form (solid, 2px, `--ring-ink`) AND paint it on four bands, off the hole
+   ledger below (each entry still red on its named band somewhere, or the row reds). The negative
+   in the same run: a control given a second form (a dashed `currentColor` ring) reds the census. */
+const RING_FOCUSABLE = 'button, [role="tab"], [tabindex="0"]';
+/** THE HOLE LEDGER: a band the ONE ring cannot paint for a reason this family does not own, named
+ *  with its owner and its band. It is CONTROL-ANCHORED, never an excuse: each entry must still hold
+ *  (red on a listed band) on at least one control it names, so a cure reds the row until the entry
+ *  is struck, and a red on any other band reds at once. Off the ledger, every band paints. */
+const RING_HOLES: readonly { at: string; bands: readonly string[]; owner: string; cells?: readonly string[] }[] = [
+  // On the union the case's `#card-foot` lays the bar outside the scrollport: the verbs' clip is
+  // gone (four bands whole at 390×844), and at 1280 a verb's own note, revealed by the same
+  // `:focus-visible`, hangs over the ring's bottom band from the foot's berth.
+  {
+    at: "#card-foot .action-verbs button",
+    bands: ["bottom"],
+    owner: "the verb's own note, hung in the foot's berth (CTRL-TAPE's berth)",
+    cells: ["1280 fine"],
+  },
+  // WAVE union (pass 9): `.drawer-tab` struck, as this ledger orders ("a cure reds the row until the
+  // entry is struck"): with MRK-LIVE's ring on the union the tongue paints all four bands, so the
+  // entry no longer holds on any control (`face-law:2260` paint, 390×844 and 1280, both red until now).
+];
+for (const [label, use] of [
+  ["390×844 coarse", coarse(390, 844)],
+  ["1280 fine", {}],
+] as const) {
+  test.describe(`one ring on every card control — ${label}`, () => {
+    test.use(use);
+    // Two rows on one census: the FORM (CHAIR-RULINGS §5: one ring form per card) and the PAINT
+    // (station 1, off the hole ledger), so a paint hole never hides the form's verdict or the reverse.
+    for (const clause of ["form", "paint"] as const)
+    test(`every focusable in the card, and the drawer's tab, ${clause === "form" ? "wears" : "paints"} the ONE ring; a second form reds`, async ({ page }) => {
+      test.setTimeout(150_000);
+      // `reduce`: the chips' 150 ms colour transition carries `outline-color` and snaps under it
+      // (row 9); a read inside the fade is the transition's, not the ring's
+      await page.emulateMedia({ reducedMotion: "reduce" });
+      await loadCard(page);
+      const ringInk = await page.evaluate(() => {
+        const d = document.createElement("div");
+        d.style.color = "var(--ring-ink)";
+        document.body.appendChild(d);
+        const c = getComputedStyle(d).color;
+        d.remove();
+        return c;
+      });
+      const tag = () =>
+        page.evaluate(
+          ({ card, sel }) => {
+            const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!;
+            const live = (e: Element) => e.getClientRects().length > 0 && !e.closest("[inert]") && !(e as HTMLButtonElement).disabled;
+            // the card, its foot (the case's `#card-foot`, where the bar is laid outside the scrollport
+            // once the foot lands) and the drawer's tab: every control the card's face answers for
+            const foot = document.querySelector("#card-foot");
+            const els = [...root.querySelectorAll(sel), ...(foot ? foot.querySelectorAll(sel) : []), ...document.querySelectorAll(".drawer-tab")].filter(live);
+            document.querySelectorAll("[data-ring-census]").forEach((e) => e.removeAttribute("data-ring-census"));
+            els.forEach((e, i) => e.setAttribute("data-ring-census", String(i)));
+            return els.map((e) => `${e.tagName.toLowerCase()}.${[...e.classList].slice(0, 2).join(".")}`);
+          },
+          { card: CARD, sel: RING_FOCUSABLE },
+        );
+      const census = async () => {
+        const names = await tag();
+        const out: { name: string; fv: boolean; form: string; ok: boolean; bands: string; red: boolean; occ: string | null; whole: string | null }[] = [];
+        for (const [i, name] of names.entries()) {
+          await page.keyboard.press("Shift");
+          await page.keyboard.press("Tab");
+          await page.evaluate((i) => {
+            document.querySelectorAll("[data-ring-probe]").forEach((e) => e.removeAttribute("data-ring-probe"));
+            const el = document.querySelector<HTMLElement>(`[data-ring-census="${i}"]`)!;
+            el.setAttribute("data-ring-probe", "");
+            el.focus();
+          }, i);
+          await flushRing(page);
+          const r = await page.evaluate(() => {
+            const el = document.activeElement as HTMLElement;
+            const cs = getComputedStyle(el);
+            return { fv: el.matches(":focus-visible") && el.hasAttribute("data-ring-probe"), style: cs.outlineStyle, width: cs.outlineWidth, color: cs.outlineColor };
+          });
+          const b = await fourBands(page, RING_OPTS);
+          const ok = r.fv && r.style === "solid" && r.width === "2px" && r.color === ringInk;
+          // an entry scoped to named cells (`cells`) applies only there
+          const hole = await page.evaluate(
+            (list) => list.findIndex((o) => o.on && document.querySelector("[data-ring-probe]")!.matches(o.at)),
+            RING_HOLES.map((h) => ({ at: h.at, on: !h.cells || h.cells.includes(label) })),
+          );
+          const thinnest = b.bands ? (Object.entries(b.bands).sort((x, y) => x[1].thickness - y[1].thickness)[0][0] as string) : null;
+          // on the ledger: the hole must still be there, on a listed band; off it: every band paints
+          const occ = hole >= 0 ? RING_HOLES[hole].owner : null;
+          const held = hole >= 0 && b.red && !!thinnest && RING_HOLES[hole].bands.includes(thinnest);
+          // on a ledger control a green read is no offence (one note may clear its verb where its
+          // sibling's does not); a red read off the listed bands is; the ENTRY must hold somewhere
+          const offLedger = hole >= 0 && b.red && !held;
+          out.push({ name, fv: r.fv, form: `${r.style} ${r.width} ${r.color}`, ok, bands: sayBands(b), red: hole >= 0 ? offLedger : b.red, occ, whole: hole >= 0 ? (held ? `held on ${thinnest}` : b.red ? `RED OFF THE LEDGER on ${thinnest}` : "whole") : null });
+        }
+        return out;
+      };
+      const clean = await census();
+      const off = (c: { ok: boolean; red: boolean }) => (clause === "form" ? !c.ok : c.red);
+      const bad = clean.filter(off);
+      test.info().annotations.push({
+        type: "ring-census",
+        description: `${clean.length} controls, ${clean.length - bad.length} on the ONE ring · ink ${ringInk} · ${clean.map((c) => `${c.name}: ${c.form}${c.red ? " BANDS RED " + c.bands : ""}`).join(" | ")}`,
+      });
+      const named = clean.filter((c) => c.occ);
+      // a ledger entry no control matches is stale: strike it or it hides the next hole
+      if (clause === "paint")
+        for (const h of RING_HOLES.filter((x) => !x.cells || x.cells.includes(label)))
+          expect(
+            clean.some((c) => c.occ === h.owner && /^held/.test(c.whole ?? "")),
+            `the hole ledger's entry for ${h.at} still holds on a control (else strike it)`,
+          ).toBe(true);
+      test.info().annotations.push({
+        type: "ring-census-ledger",
+        description: named.length ? named.map((c) => `${c.name}: ${c.bands} · ledger ${c.whole} · ${c.occ}`).join(" | ") : "none",
+      });
+      expect(clean.length, "the census found the card's controls").toBeGreaterThan(5);
+      expect(clean.some((c) => /drawer-tab/.test(c.name)), "the drawer's tab is in the census").toBe(true);
+      // THE NEGATIVE, same run: a second form on one control (the shape the fold shipped)
+      const t = await page.addStyleTag({ content: '[data-ring-census="0"]:focus-visible { outline: 2px dashed currentColor !important; }' });
+      const planted = await census();
+      await t.evaluate((e) => (e as Element).remove());
+      const caught = planted.filter(off).length;
+      test.info().annotations.push({ type: "ring-census-plant", description: `a second form on control 0: ${caught} control(s) off the ONE ring` });
+      expect(caught, "the planted second form reds the census").toBeGreaterThan(0);
+      expect(bad.map((c) => `${c.name}: ${c.form} fv ${c.fv}${c.red ? " · " + c.bands : ""}`), `every card control ${clause === "form" ? "wears" : "paints"} the ONE ring`).toEqual([]);
+    });
+  });
+}
+
+/* ══ 12 · M17 SHIPS WITH ITS GATES (T9-M17, INTAKE rows 7, 8, 13 — pass 6) ════════════════════
+   Pass 5 cured the owner's "poor usage of space" and left every number in an evidence
+   instrument (`gpanel.mjs`): the column could come back and this file would read the same. The
+   four rows below are the instrument's G1–G5, each beside the plant that reds it IN THE SAME
+   RUN. One encoded payload (LAWS P4), the given-set read back through the aria-label corpus. */
+const M17_PAYLOAD =
+  "size=3&difficulty=MEDIUM&board=ATMuNTMwMDcwMDAwNjAwMTk1MDAwMDk4MDAwMDYwODAwMDYwMDAzNDAwODAzMDAxNzAwMDIwMDA2MDYwMDAwMjgwMDAwNDE5MDA1MDAwMDgwMDc5";
+const M17_GIVENS = "530070000600195000098000060800060003400803001700020006060000280000419005000080079";
+const BAR_FADE = 32; // the fallback only: the card's sentinel height is read live (§10 integration)
+
+/** The zone's geometry on the VISIBLE card (the desk keeps a hidden drawer twin). */
+const M17_READ = ({ card, fade }: { card: string; fade: number }) => {
+  const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!;
+  const zone = root.querySelector(".new-game-zone") as HTMLElement;
+  const text = (el: Element | null) => {
+    if (!el) return null;
+    const rg = document.createRange();
+    rg.selectNodeContents(el);
+    const qs = [...rg.getClientRects()].filter((q) => q.width > 0 && q.height > 0);
+    return qs.length ? { top: Math.min(...qs.map((q) => q.top)), bottom: Math.max(...qs.map((q) => q.bottom)) } : null;
+  };
+  const r2 = (n: number) => Math.round(n * 100) / 100;
+  const tag = zone.querySelector(".washi-tag")!.getBoundingClientRect();
+  const h2 = text(zone.querySelector(".staged-section h2"));
+  const deal = zone.querySelector(".deal-btn")!.getBoundingClientRect();
+  // §10 INTEGRATION: the bar left the card for the case's foot and its `::before` fade went with
+  // it; the fade at this scrollport's bottom edge is the card's own sentinel (`scene.css`
+  // `.controls-card::after`, `2rem + --card-pad-b`), so G3 reads THAT band's top.
+  const clipBottom = root.getBoundingClientRect().top + root.clientTop + root.clientHeight;
+  const sentinel = parseFloat(getComputedStyle(root, "::after").height) || fade;
+  const lines = [...zone.querySelectorAll(".staged-section .ctrl-options")].map((o) => {
+    const tops = new Set(
+      [...o.querySelectorAll(":scope > .ctrl-btn")].map((b) => Math.round(b.getBoundingClientRect().top)),
+    );
+    return tops.size;
+  });
+  return {
+    scrollTop: (root as HTMLElement).scrollTop,
+    zoneH: r2(zone.getBoundingClientRect().height),
+    tapeToName: h2 ? r2(h2.top - tag.bottom) : null,
+    dealBottom: r2(deal.bottom),
+    fadeTop: r2(clipBottom - sentinel),
+    lines,
+  };
+};
+
+test.describe("M17 — the new-game zone, one line per question (1280×800 fine)", () => {
+  test("G1 zone ≤ 320 · G2 one line per staged group · G3 Deal above the fade · G4 tape→name ≥ 13.6 — each reds under its plant", async ({
+    page,
+  }) => {
+    await loadCard(page, M17_PAYLOAD);
+    // the payload is the board (LAWS P5: read back through the aria-label corpus, not innerText)
+    const givens = await page.evaluate(() =>
+      [...document.querySelectorAll('[role="gridcell"] input')].map((i) => (i as HTMLInputElement).value || "0").join(""),
+    );
+    expect(givens, "both arms deal the encoded payload").toBe(M17_GIVENS);
+    const read = () => page.evaluate(M17_READ, { card: CARD, fade: BAR_FADE });
+    await page.evaluate((card) => {
+      const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length) as HTMLElement;
+      root.scrollTop = 0;
+    }, CARD);
+    const clean = await read();
+    test.info().annotations.push({ type: "m17", description: `clean ${JSON.stringify(clean)}` });
+    expect(clean.zoneH, "G1: the new-game zone ≤ 320 at 1280×800 fine (HEAD 503.19)").toBeLessThanOrEqual(320);
+    expect(clean.lines, "G2: every staged group on ONE line").toEqual(clean.lines.map(() => 1));
+    expect(clean.dealBottom, "G3: Deal's bottom clears the bar's fade at scrollTop 0").toBeLessThanOrEqual(clean.fadeTop);
+    expect(clean.tapeToName, "G4: tape → first name ≥ 13.6 (the rule air)").toBeGreaterThanOrEqual(13.6);
+
+    // THE PLANTS, same run, each asserted to red its own row.
+    for (const [row, css, reds] of [
+      ["G1", ".new-game-zone { padding-bottom: 200px !important }", (m: typeof clean) => m.zoneH > 320],
+      ["G2", ".new-game-zone .options-line { flex-direction: column !important }", (m: typeof clean) => m.lines.some((n) => n > 1)],
+      ["G3", ".new-game-zone .deal-row { margin-top: 200px !important }", (m: typeof clean) => m.dealBottom > m.fadeTop],
+      ["G4", ".new-game-zone { --zone-step: 0px !important }", (m: typeof clean) => (m.tapeToName ?? 99) < 13.6],
+    ] as const) {
+      const h = await page.addStyleTag({ content: css });
+      await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+      const planted = await read();
+      await h.evaluate((n) => (n as unknown as HTMLElement).remove());
+      test.info().annotations.push({ type: "m17-plant", description: `${row} ${css} → ${JSON.stringify(planted)}` });
+      expect(reds(planted), `${row}'s plant (${css}) reds its row`).toBe(true);
+    }
+  });
+});
+
+/* PASS 7 (charter row 3; INTAKE row 11) — G3 AT THE COARSE RAIL. Pass 6's arm A put Deal −9.81 px
+   under the fade on WebKit at 1280×800 coarse (+7.14 chromium): the card's `overflow-y: auto` made
+   `overflow-x` auto too, the hover notes overhang its box by 64 px, and WebKit's classic 17 px
+   sideways bar lifted the fade. The card takes no sideways range now. The row reads G3 at both rail
+   cells in both engines; its plants are G3's own (the deal row pushed down) and the pass-6 shape (the
+   sideways range given back), which reds where the harness paints a classic bar (WebKit). */
+for (const vp of [
+  { width: 1280, height: 800 },
+  { width: 1440, height: 900 },
+] as const) {
+  test.describe(`M17 G3 at the coarse rail — ${vp.width}×${vp.height} hasTouch`, () => {
+    test.use({ viewport: vp, hasTouch: true, isMobile: false });
+    test("Deal clears the fade at scrollTop 0, and both plants red", async ({ page, browserName }) => {
+      await loadCard(page, M17_PAYLOAD);
+      const read = () => page.evaluate(M17_READ, { card: CARD, fade: BAR_FADE });
+      const top0 = () =>
+        page.evaluate((card) => {
+          const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length) as HTMLElement;
+          root.scrollTop = 0;
+          root.scrollLeft = 0;
+        }, CARD);
+      await top0();
+      const clean = await read();
+      // Where the bar sits IN the card (this page), its `::before` fade rides 17 px up on WebKit's
+      // classic sideways bar; on the §10 fold the bar is the case's foot and the card's own sentinel
+      // clears Deal by 26 px with or without it (measured), so the plant reds only where it was red:
+      // WebKit, 1280×800 (1440×900 cleared by 21.47 even with the bar, pass 6), the bar in the card.
+      const barInCard = await page.evaluate(
+        (card) => !![...document.querySelectorAll(card)].find((c) => c.getClientRects().length)?.querySelector(".action-bar"),
+        CARD,
+      );
+      const plants: [string, string, boolean][] = [
+        ["G3's own", ".new-game-zone .deal-row { margin-top: 200px !important }", true],
+        // PASS 8 (charter row 11) — the range is gone at its ROOT: the two notes are capped at their
+        // row, so `overflow-x: auto` alone mints no range (read below). The plant gives back the
+        // pass-6 shape WHOLE: the overhang (the notes' 15rem uncapped) AND the sideways scrollport.
+        [
+          "the overhang given back",
+          ".tray-well .zone-hint, .action-bar .washi-label { max-width: 15rem !important } .controls-card { overflow-x: auto !important }",
+          browserName === "webkit" && vp.width === 1280 && barInCard,
+        ],
+      ];
+      const range = await page.evaluate((card) => {
+        const c = [...document.querySelectorAll(card)].find((x) => x.getClientRects().length) as HTMLElement;
+        return { sw: c.scrollWidth, cw: c.clientWidth, ox: getComputedStyle(c).overflowX };
+      }, CARD);
+      const got: string[] = [];
+      for (const [name, css, mustRed] of plants) {
+        const h = await page.addStyleTag({ content: css });
+        await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+        await top0();
+        const m = await read();
+        await h.evaluate((n) => (n as unknown as HTMLElement).remove());
+        got.push(`${name}: Deal ${m.dealBottom} vs fade ${m.fadeTop}`);
+        if (mustRed) expect(m.dealBottom, `the plant "${name}" reds G3`).toBeGreaterThan(m.fadeTop);
+      }
+      test.info().annotations.push({
+        type: "m17-g3-coarse",
+        description: `clean Deal ${clean.dealBottom} vs fade ${clean.fadeTop} (clear ${(clean.fadeTop - clean.dealBottom).toFixed(2)}) · range ${range.sw}/${range.cw} overflow-x ${range.ox} · ${got.join(" · ")}`,
+      });
+      expect(range.sw, "the card has no sideways range: its content is no wider than its box").toBeLessThanOrEqual(range.cw);
+      expect(clean.dealBottom, "G3: Deal's bottom clears the fade at scrollTop 0 on the coarse rail").toBeLessThanOrEqual(clean.fadeTop);
+    });
+  });
+}
+
+const RAIL_COARSE = { viewport: { width: 1280, height: 800 }, hasTouch: true, isMobile: false };
+for (const [label, use, armed] of [
+  ["1280 fine, rest", {}, false],
+  ["1280×800 coarse (hasTouch), rest", RAIL_COARSE, false],
+  // §10 INTEGRATION: the ARMED cell is struck. Under TAPE's question grammar (`ConfirmRibbon`) an
+  // armed Deal is no longer a `sure?` sublabel beside its receipt: the ribbon takes the deal row
+  // and the receipt steps out (`askingAct !== 'deal'`), so the two words this row measures are
+  // not both on screen when armed. The ribbon's own rows (`mobile-affordances`, `zone-grammar`)
+  // carry the armed pose.
+  ["390×844 coarse, settled", coarse(390, 844), false],
+] as const) {
+  test.describe(`M17 G5 — Deal and its receipt stand on one line (${label})`, () => {
+    test.use(use);
+    test("the two words' PAINTED glyph bottoms are within 1.5px, and a 3px drop reds", async ({ page }) => {
+      await loadCard(page, M17_PAYLOAD);
+      if (armed) {
+        const blank = await page.evaluate(() => {
+          const cells = document.querySelectorAll(".game-cell");
+          for (let i = 0; i < cells.length; i++) if (!cells[i].querySelector(".glyph-svg")) return i;
+          return -1;
+        });
+        expect(blank).toBeGreaterThanOrEqual(0);
+        await page.locator(".game-cell").nth(blank).click();
+        await page.evaluate((idx) => {
+          const input = document.querySelectorAll(".game-cell input")[idx] as HTMLInputElement;
+          Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value")!.set!.call(input, "1");
+          input.dispatchEvent(new Event("input", { bubbles: true }));
+        }, blank);
+        // a mouse press at the verb's centre (locator.click scrolls a sticky scrollport, LAWS P5)
+        const c = await page.evaluate((card) => {
+          const root = [...document.querySelectorAll(card)].find((x) => x.getClientRects().length)!;
+          const b = root.querySelector(".deal-btn")!.getBoundingClientRect();
+          return [b.x + b.width / 2, b.y + b.height / 2];
+        }, CARD);
+        await page.touchscreen.tap(c[0], c[1]);
+        await expect(page.locator(`${CARD}:visible .deal-btn .icon-sublabel`)).toHaveText("sure?");
+      }
+      const row = page.locator(`${CARD}:visible .deal-row`);
+      await row.scrollIntoViewIfNeeded();
+      const dpr = await page.evaluate(() => devicePixelRatio);
+      const bottoms = async () => {
+        const deal = await paintedExtent(page, row, ".deal-btn .icon-sublabel { color: transparent !important }", true);
+        const dealt = await paintedExtent(page, row, ".deal-row .dt-label { color: transparent !important }", true);
+        return { deal: deal.hi / dpr, dealt: dealt.hi / dpr };
+      };
+      const b = await bottoms();
+      expect(Number.isFinite(b.deal) && Number.isFinite(b.dealt), "both words painted").toBe(true);
+      const d = Math.abs(b.deal - b.dealt);
+      test.info().annotations.push({ type: "m17-g5", description: `${label}: Deal ${b.deal.toFixed(2)} · dealt ${b.dealt.toFixed(2)} · |Δ| ${d.toFixed(2)} (dpr ${dpr})` });
+      expect(d, "G5: Deal and dealt share a painted baseline").toBeLessThanOrEqual(1.5);
+      if (armed) {
+        await expect(page.locator(`${CARD}:visible .deal-btn .icon-sublabel`), "the arm held across the read").toHaveText("sure?", { timeout: 50 });
+        return; // the plant runs on the rest cells; a second read would outlive the 2.5 s arm
+      }
+      const h = await page.addStyleTag({ content: ".deal-row .dt-label { position: relative; top: 3px }" });
+      const p = await bottoms();
+      await h.evaluate((n) => (n as unknown as HTMLElement).remove());
+      test.info().annotations.push({ type: "m17-g5-plant", description: `dealt dropped 3px → |Δ| ${Math.abs(p.deal - p.dealt).toFixed(2)}` });
+      expect(Math.abs(p.deal - p.dealt), "G5's plant (dealt 3px low) reds").toBeGreaterThan(1.5);
+    });
+  });
+}
