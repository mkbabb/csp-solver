+import { test, expect } from '@playwright/test';
+import { loadavg } from 'node:os';
+import { encodeSudoku } from './wire';
+import { readMover, SKIP_PLANT, F2_PLANT, fmtArm, type Mover } from './lib/postpaint.mjs';
+
+// PRM: live, because the subject is the fold's motion: under reduce both verbs are a same-frame
+// cut and there is no first frame to read.
+
+/**
+ * T9-M19 · THE FOLD'S FIRST PAINTED FRAME IS ITS FIRST POSE (GA1, INTAKE row 30; T9-W7 §13
+ * MOT-VERB pass 6, charter row 8).
+ *
+ * THE DEFINITION (pass-6 chair §1.4, written here so the gate carries it): enter frame 1 = the
+ * first frame after the reparent on which the fold's mover exists; on it the board's centre is
+ * within 3 px of its rest pose (the playing board it left, read before the press) AND its width
+ * within 3 px — the RAW delta, never a residual against a fitted curve. READ POST-PAINT (pass 7,
+ * LAWS P6 §D): each frame is read in a task queued from its rAF, with the frame's rAF time and its
+ * `document.timeline` time captured in the rAF, frame 1 keyed on the mover's first
+ * IntersectionObserver entry — THE ONE SAMPLER at its product home (`./lib/postpaint.mjs`,
+ * `readMover`; registry-v7 §2.4). This file carries no reader of its own since pass 8. The pass-6
+ * reader sampled IN rAF, registered before the product's own, so it read the pre-callback state: a
+ * runtime plant that painted frame 1 at ct 150, 142.9 px off, passed it 8/8.
+ * The CLOCK IDENTITY rides the same frames: ct(frame k) = tl(k) − tl(frame 1) ± 2 ms for k = 2, 3
+ * (a first frame that is at rest but whose clock then jumps is the same skip one frame later).
+ * GATED IN BOTH ENGINES since pass 8 (LAWS P7 §D; the FRAME clock binds, pass8/CHAIR-RULINGS §2.4):
+ * pass 7 gated it in Chromium only, and the pass-7 critic's PLANT f2 (frame 1 at rest, then its
+ * clock jumps 150 ms on the second rAF) passed WebKit 6/6 while WebKit's own CI column read 150.0.
+ * Both engines; 1280 fine (light and dark), 390×844 coarse, and kenken at deck index 4. PLANT skip
+ * (every explicit `startTime` write lands 150 ms early) and PLANT f2 are the negatives, in this file,
+ * and each must RED its clause. A residual gate would pass a verb that starts part-way in on the
+ * right curve, which is the defect: at 74a2b5d9 frame 1 sits 92.9 px off at 1280 in Chromium, and in
+ * WebKit the UA's own resolution of a pending start put it 3.76 px off and 7.37 px narrow (pass 5).
+ *
+ * GA2 rides the same fold (its own rAF read of the clip, beside the sampler): while the fold runs,
+ * the board is never clipped by an ancestor
+ * (the visible fraction, every ancestor's overflow on each axis, is 1.0 on every frame; 0.235 at
+ * 74a2b5d9). Born RED on the control (74a2b5d9) at every cell and engine.
+ */
