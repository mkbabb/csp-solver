+    await k.walkWhole(w, theme, theme === "light"
+      ? () => k.planted(theme, "WORSE the ring at 0.8 on the deck card (admitted)", ".focus-ring { opacity: 0.8 !important; }", ".focus-ring", "div.gallery-viewport", "deck div.gallery-viewport")
+      : undefined);
+    await w.board(theme);
+    const clean = PLANT_STOP;
+    const C = k.P(".focus-ring");
+    const G = k.P(T2);
+    // The confined pair (gap 5): NOTCH clips a 2 % slit through the middle of the ring, so the
+    // top and bottom bands each lose one run of their stations (B4) while their medians and depths
+    // hold (a 10 % stripe took a quarter of the bottom band's stations and moved its depth median: B3); SQUAT6 sets the stop 6 px tall, so its side bands fall under 8 css px (B1), and
+    // an EMPTY band is judged by B1 alone.
+    // The slit is a CLIP, not a mask: any mask on the ring (this notch, DASH_1IN8) halves the
+    // bottom band's painted depth (1.25 against 2.5 clean, both engines), so a masked notch reds B3
+    // too. An even-odd clip keeps every band's depth and cuts one 2 % slit through top and bottom.
+    const slit = "polygon(evenodd, -50% -50%, 150% -50%, 150% 150%, -50% 150%, -50% -50%, 49% -50%, 51% -50%, 51% 150%, 49% 150%, 49% -50%)";
+    const NOTCH10 = `.focus-ring { clip-path: ${slit} !important; }`;
+    const SQUAT6 = "[data-gl23] { height: 6px !important; min-height: 0 !important; max-height: 6px !important; padding-block: 0 !important; overflow: hidden !important; }";
+    const plants: [string, unknown, "chrome" | "tier2", string?][] =
