+        for (const d of r.decls)
+          if (CURVE_TOKEN.test(d.prop))
+            map.set(d.prop, [...(map.get(d.prop) ?? []), d.value]);
+    if (f.endsWith(".vue"))
+      for (const sc of sfc(text).scripts) code.push([f, sc.text, sc.line]);
