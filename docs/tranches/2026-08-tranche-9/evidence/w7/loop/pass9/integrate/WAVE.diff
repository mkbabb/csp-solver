+describe("frontGate — the cadence at every refresh rate (pass 8: a rate floor, not only a ceiling)", () => {
+  // THE FLOOR (the chair's, registry-v7 §2.7b): every burst ≥ 0.9 × min(panel Hz, 62.5). THE
+  // CEILING: ≤ 62.5/s, the k-th commit never before the first + k·FRONT_MIN_MS. A.6: no two
+  // frames' commits closer than FRONT_GAP_MS. A.6 alone caps a panel at Hz / ⌈15.5 · Hz / 1000⌉
+  // (every k-th frame), and the chair's formula is reachable only where that is ≥ 56.25/s:
+  // Hz ≤ 64.5, 112.5–129, 168.75–193.5, ≥ 225. Between them no gate that honours A.6 meets it —
+  // 75 Hz commits every second frame (13.3 ms < 15.5), 37.5/s; 90 Hz 45.0; 100 Hz 50.0; 144 Hz
+  // every third, 48.0; 165 Hz every third, 55.0 — so those rows' floor is 0.9 × A.6's best and
+  // says so. The contradiction is the chair's to rule (A.6's 15.5 ms or the formula), not a
+  // gate this file re-words: the rows print both numbers.
+  const CHAIR = (hz: number) => 0.9 * Math.min(hz, 1000 / FRONT_MIN_MS);
+  const A6_BEST = (hz: number) =>
+    1000 / (Math.ceil((FRONT_GAP_MS * hz) / 1000) * (1000 / hz));
+  const ceilingHeld = (hits: number[]) =>
+    hits.every((x, k) => x - hits[0] >= k * FRONT_MIN_MS - 1e-9);
+  it.each([
+    ["60 Hz, whole-ms stamps (a Safari panel)", 60, true, CHAIR(60)],
+    ["60 Hz, fine stamps", 60, false, CHAIR(60)],
+    ["30 Hz, whole-ms stamps", 30, true, CHAIR(30)],
+    ["30 Hz, fine stamps", 30, false, CHAIR(30)],
+    ["120 Hz, whole-ms stamps (ProMotion)", 120, true, CHAIR(120)],
+    ["125 Hz, fine stamps (the driven clock, vsync-exact)", 125, false, CHAIR(125)],
+    ["128 Hz, fine stamps (this box's chromium panel)", 128, false, CHAIR(128)],
+    [
+      "75 Hz, fine stamps (A.6 caps it: every second frame)",
+      75,
+      false,
+      0.9 * A6_BEST(75),
+    ],
+    [
+      "90 Hz, fine stamps (A.6 caps it: every second frame)",
+      90,
+      false,
+      0.9 * A6_BEST(90),
+    ],
+    [
+      "100 Hz, fine stamps (A.6 caps it: every second frame)",
+      100,
+      false,
+      0.9 * A6_BEST(100),
+    ],
+    [
+      "144 Hz, fine stamps (A.6 caps it: every third frame)",
+      144,
+      false,
+      0.9 * A6_BEST(144),
+    ],
+    [
+      "165 Hz, fine stamps (A.6 caps it: every third frame)",
+      165,
+      false,
+      0.9 * A6_BEST(165),
+    ],
+    ["240 Hz, fine stamps (every fourth frame clears A.6)", 240, false, CHAIR(240)],
+    ["1000 Hz, fine stamps (the ceiling under load)", 1000, false, CHAIR(1000)],
+  ] as const)("%s: floor, ceiling and A.6 hold", async (_name, hz, quant, floor) => {
+    const r = await stream(hz, Math.round(hz * 2), quant);
+    // the gate reaches A.6's arithmetic best wherever the panel is exact (it keeps every frame A.6
+    // admits), and where the chair's formula is below that best, the formula binds
+    expect(r.perS).toBeGreaterThanOrEqual(
+      Math.min(0.999 * A6_BEST(hz), 1000 / FRONT_MIN_MS) - 0.6,
+    );
+    expect(r.perS).toBeGreaterThanOrEqual(floor);
+    expect(r.perS).toBeLessThanOrEqual(1000 / FRONT_MIN_MS);
+    expect(ceilingHeld(r.hits)).toBe(true);
+    expect(r.minGap).toBeGreaterThanOrEqual(FRONT_GAP_MS);
+  });
+
+  it("a pump that runs 0–1.5 ms late keeps the ceiling and A.6; its rate is A.6's, not the gate's", async () => {
+    // Two frames 16 ms apart on the schedule read 16 + (u₂ − u₀): A.6 refuses the pair whenever
+    // the lateness falls by > 0.5 ms (22 % of pairs under uniform 0–1.5), and each refusal costs
+    // one 8 ms frame, so no A.6 gate beats ~56/s on this stream. Printed, not floored.
+    const r = await stream(125, 250, false, 1.5);
