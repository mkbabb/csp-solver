+      last = null;
+    for (let i = 1; i < reads.length; i++) {
+      const a = reads[i - 1].r,
+        b = reads[i].r;
+      if (a.x !== b.x || a.y !== b.y || a.w !== b.w || a.h !== b.h) {
+        if (first == null) {
+          first = reads[i - 1].e;
