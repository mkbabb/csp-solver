+ * was never painted: the owner saw the sides at their full weight and the top and bottom at half.
+ *
+ * THE READ, in paint, through THE ONE four-band probe (`./lib/edge-bands.mjs`, pass 9; the pass-8 private
+ * `depth()`/`cov()` reader is deleted, LAWS P8 §I): the board is photographed with the grid's ink ON and
+ * OFF, one device station per column/row, and each band's painted depth is B3's statistic. Keyed on the
+ * board's DEVICE-PIXEL span (printed), never on the pointer.
+ *   B6  (was F1) every band paints ≥ 0.85 of the deepest band's depth: top and bottom against the sides
+ *   B3  (was F2) every band paints ≥ 0.9 × the frame's AUTHORED stroke (12 units × the scale)
+ *   B2/B4  the probe's own contrast and hole clauses, at its defaults
+ * PLANT (in-run, must RED): the baked ink cut to the box's inner 99 % vertically, which takes the outer
+ * part of the top and bottom strokes away as the edge bake used to.
+ * Born RED on the control (`74a2b5d9`): top and bottom read about half the sides at every rig.
+ */
+// prettier-ignore
+const SOLVED_9 = [
+  5, 3, 4, 6, 7, 8, 9, 1, 2,  6, 7, 2, 1, 9, 5, 3, 4, 8,  1, 9, 8, 3, 4, 2, 5, 6, 7,
+  8, 5, 9, 7, 6, 1, 4, 2, 3,  4, 2, 6, 8, 5, 3, 7, 9, 1,  7, 1, 3, 9, 2, 4, 8, 5, 6,
+  9, 6, 1, 5, 3, 7, 2, 8, 4,  2, 8, 7, 4, 1, 9, 6, 3, 5,  3, 4, 5, 2, 8, 6, 1, 7, 9,
+];
+const BLANKS = new Set([0, 4, 10, 22, 36, 40, 55, 61, 73, 80]);
+const BOARD = encodeSudoku(
+  3,
+  Object.fromEntries(SOLVED_9.map((v, i) => [i, BLANKS.has(i) ? 0 : v])),
+  81,
+);
+
+/** Desk, phone and the three 1× touch boards (registry-v7 §2.2 (iii)). */
+const RIGS = [
+  { name: 'desk 1280x800 fine dpr1', w: 1280, h: 800, dpr: 1, touch: false },
+  { name: 'phone 390x844 coarse dpr2', w: 390, h: 844, dpr: 2, touch: true },
+  { name: 'tablet 768x1024 coarse dpr1', w: 768, h: 1024, dpr: 1, touch: true },
+  { name: 'tablet 1024x768 coarse dpr1', w: 1024, h: 768, dpr: 1, touch: true },
+  { name: 'laptop 1280x800 coarse dpr1', w: 1280, h: 800, dpr: 1, touch: true },
+] as const;
+const SCHEMES = ['light', 'dark'] as const;
+const PLANT_CSS = '.grid-ink { clip-path: inset(0.9% 0 0.9% 0); }';
+const OFF_CSS = '.grid-ink, .hand-drawn-grid { visibility: hidden !important; }';
+// the grid's own box on every tree (the baked ink is a masked HTML box here and an svg `<image>` on
+// `74a2b5d9`: the edge list names both, so the control's read is a paint read, never a missing node)
+const SUBJECT = 'svg.hand-drawn-grid';
+const EDGE = 'svg.hand-drawn-grid, .grid-ink';
+const UNITS = 1000;
+const STROKE = 12;
+const BAND = 26; // the inner rules start 26 units in: the band reads the frame alone
+
+type Reading = { span: number; box: string; top: number; bottom: number; left: number; right: number; want: number; bands: FourBands };
+
+/** The frame's four bands through THE ONE probe (`./lib/edge-bands.mjs`, pass 9: the private depth reader
+ *  is gone). The subject is the grid's box, the edge its ink (both forms); the strip runs 8 px outside to just short of the
+ *  first inner rule (`BAND` units in), so a band reads the frame alone. B3's floor is the frame's
+ *  AUTHORED stroke (12 units × the scale) × 0.9 (pass9/CHAIR-RULINGS §7: a drawn frame floors at its
+ *  authored width × 0.9); B6 at 0.85 is F1's relative clause (top and bottom vs the deepest band). */
+async function readFrame(
+  browser: Browser,
+  rig: (typeof RIGS)[number],
+  colorScheme: 'light' | 'dark',
+  plant: boolean,
+): Promise<Reading> {
+  const ctx = await browser.newContext({
+    viewport: { width: rig.w, height: rig.h },
+    deviceScaleFactor: rig.dpr,
+    hasTouch: rig.touch,
+    colorScheme,
+    reducedMotion: 'no-preference',
+  });
+  const page = await ctx.newPage();
+  await page.goto('/?game=sudoku&board=' + BOARD);
+  await page.locator('.board-cells').first().waitFor();
+  expect(await page.locator('.board-cells [aria-label*="given clue"]').count()).toBe(71);
+  // the steady look: the draw-in done and all four poses baked (the live stack is the fallback)
+  await expect(page.locator('.boil-frame-bitmap')).toHaveCount(4, { timeout: 30000 });
+  if (plant) await page.addStyleTag({ content: PLANT_CSS });
+  await page.evaluate(() => document.fonts.ready);
+  const g = await page.evaluate((sel) => {
+    const r = document.querySelector(sel)!.getBoundingClientRect();
+    return { w: r.width, h: r.height };
+  }, SUBJECT);
+  const side = Math.min(g.w, g.h);
+  const want = (STROKE * side) / UNITS; // css px
+  const bands = await fourBands(page, {
+    subject: SUBJECT,
+    edge: EDGE,
+    off: OFF_CSS,
+    out: 8,
+    inn: Math.max(4, Math.floor((BAND * side) / UNITS) - 1),
+    thick: want,
+    thickTol: 0.9,
+    relBand: 0.85,
+  });
+  await ctx.close();
+  const depth = (k: 'top' | 'bottom' | 'left' | 'right') => bands.bands?.[k]?.thickness ?? 0;
+  return {
+    span: Math.round(side * rig.dpr),
+    box: `${g.w.toFixed(1)}×${g.h.toFixed(1)}`,
+    top: depth('top'),
+    bottom: depth('bottom'),
+    left: depth('left'),
+    right: depth('right'),
+    want,
+    bands,
+  };
+}
+
+/** The gate: the ONE probe's verdict (B0–B6), and the relative read printed as the pass-8 F1 ratio. */
+function failures(r: Reading): string[] {
+  return [...r.bands.why];
+}
+
+const fmt = (r: Reading) =>
+  `box ${r.box} · span ${r.span} dpx · depth t ${r.top.toFixed(2)} b ${r.bottom.toFixed(2)} l ${r.left.toFixed(2)} r ${r.right.toFixed(2)} css px · stroke ${r.want.toFixed(2)} · t/b÷sides ${(Math.min(r.top, r.bottom) / ((r.left + r.right) / 2)).toFixed(3)} · min÷deepest ${(Math.min(r.top, r.bottom, r.left, r.right) / Math.max(r.top, r.bottom, r.left, r.right)).toFixed(3)} · ${fmtBands(r.bands)}`;
+
+for (const rig of RIGS)
+  for (const scheme of SCHEMES)
+    test(`the frame paints whole · ${rig.name} · ${scheme}`, async ({ browser }) => {
+      const r = await readFrame(browser, rig, scheme, false);
+      console.log(`FRAME ${test.info().project.name} ${rig.name} ${scheme}: ${fmt(r)}`);
+      expect(failures(r)).toEqual([]);
+    });
+
+// THE NEGATIVE, in-run: the outer edge of the top and bottom strokes cut away must RED.
+for (const rig of [RIGS[0], RIGS[1]])
+  test(`PLANT half-stroke reds the frame read · ${rig.name}`, async ({ browser }) => {
+    const r = await readFrame(browser, rig, 'light', true);
+    const red = failures(r);
+    console.log(`FRAME PLANT ${test.info().project.name} ${rig.name}: ${fmt(r)} → ${red.join(' · ') || 'GREEN (the gate is blind)'}`);
+    expect(red.length, 'the half-stroke plant painted and the gate stayed green').toBeGreaterThan(0);
+  });
