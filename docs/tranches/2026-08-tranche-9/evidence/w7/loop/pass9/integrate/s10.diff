+          file,
+          kind: `${kind}-key-stem`,
+          prelude: `[\`${m[1]}\`]`,
+          value: m[2].trim(),
+          line: L(m.index),
+          stem: true,
+        });
+    for (const m of js.matchAll(
+      /(?<=[{,(]\s*)\[\s*([^\]`'"][^\]]*)\]\s*:\s*([^,}\n]+)/g,
+    )) {
+      const k = foldConcat(m[1], consts);
+      if (k === token)
+        push({
+          file,
+          kind: `${kind}-key-computed`,
+          prelude: `[${m[1]}]`,
+          value: m[2].trim(),
+          line: L(m.index),
+        });
+      else if (k == null && on("style-computed-key"))
