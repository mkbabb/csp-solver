+  const FOOT_BEHAVIOUR_PLANTS: [string, string, boolean, boolean][] = [
+    ["E4 !important max() in a coarse block", "@media (pointer: coarse) { .card-foot { padding-bottom: max(0.15rem, env(safe-area-inset-bottom)) !important; } }", false, true],
+    ["E3 the compound override", "#card-foot.card-foot { padding-bottom: 0.15rem; }", false, true],
+    ["a shadowing declaration in one block", ".card-foot { padding-bottom: calc(0.15rem + env(safe-area-inset-bottom)); padding-bottom: 0.15rem; }", false, false], // loses to the scoped `.card-foot[data-v]` (0,2,0): a served site, never paint
+    ["a structural selector", "div:nth-last-child(n)[id='card-foot'] { padding-bottom: 0 !important; }", true, true],
+    ["an !important universal", "* { padding-bottom: 0 !important; }", true, true],
+    ["K1b the net-zero stack", "#card-foot.card-foot { padding-bottom: calc(0.15rem - env(safe-area-inset-bottom) + env(safe-area-inset-bottom)); }", false, true],
+    ["K13b the logical longhand", "#card-foot.card-foot { padding-block-end: 0.15rem; }", false, true],
+    ["K14 the logical shorthand", "#card-foot.card-foot { padding-block: 0 0.15rem; }", false, true],
+  ];
+  const FOOT_READ = async (page: Page, inset: number) => {
+    const pad = await page.evaluate(() => parseFloat(getComputedStyle(document.getElementById("card-foot")!).paddingBottom));
+    const ink = await LOWEST_INK(page);
+    return { pad, ink, clears: ink === null ? null : +(844 - inset - ink).toFixed(2) };
+  };
+
+  test("row 28 · behaviour, both engines: the served cascade EVALUATES at inset 0 and 34, the flat phone's lowest ink clears the edge, and under a SYNTHETIC 34 it clears the inset line", async ({
+    page,
+    browserName,
+  }) => {
+    // eighteen page loads (a fresh page per plant, flat and synthetic): the default 30 s is one
+    // WebKit load's budget under a box load of 60–70 (the first WAVE run timed out at plant 4)
+    test.setTimeout(240_000);
+    const st = await SYNTH_ROUTE(page);
+    await OPEN(page);
+    const served = await SERVED_PAD(page);
+    console.log(`[RULE row 28 served] ${browserName} ${JSON.stringify(served)}`);
+    expect(SERVED_BAD(served), "served sites evaluated at 0 and 34").toEqual([]);
+    const f0 = await FOOT_READ(page, 0);
+    console.log(`[RULE row 28 flat] ${browserName} inset 0 ${JSON.stringify(f0)}`);
+    expect(f0.pad, "no inset: the foot keeps a pad of its own").toBeGreaterThan(0);
+    expect(f0.clears, "the lowest ink clears the screen's edge by ≥ 2 css").toBeGreaterThanOrEqual(2);
+    st.inset = 34;
+    await OPEN(page);
+    st.inset = null;
+    const n = st.n;
+    const f34 = await FOOT_READ(page, 34);
+    console.log(`[RULE row 28 synth] ${browserName} inset 34 (${n} declarations rewritten) ${JSON.stringify(f34)}`);
+    expect(n, "the synthetic inset rewrote the served env()").toBeGreaterThan(0);
+    expect(f34.pad - f0.pad, `the inset STACKS on the pad (${f0.pad} → ${f34.pad})`).toBeCloseTo(34, 1);
+    expect(f34.clears, "the lowest ink clears the inset line by ≥ 2 css").toBeGreaterThanOrEqual(2);
+    const greens: Record<string, string[]> = { logical: [], evaluate: [], shift: [] };
+    // NEGATIVE CONTROLS, each on a fresh page: the served arm reds on every plant, the flat paint on
+    // the ones that move ink at inset 0, and the synthetic 34 on every one that gives the inset away.
+    for (const [name, css, paints0, paints34] of FOOT_BEHAVIOUR_PLANTS) {
+      await OPEN(page, () => page.addStyleTag({ content: css }));
+      const s = await SERVED_PAD(page);
+      const p0 = paints0 ? await FOOT_READ(page, 0) : null;
+      if (paints34) {
+        st.inset = 34;
+        await OPEN(page, () => page.addStyleTag({ content: AT_INSET(css, 34) }));
+        st.inset = null;
+      }
+      const p34 = paints34 ? await FOOT_READ(page, 34) : null;
+      console.log(`[RULE row 28 plant] ${browserName} ${name}: served ${JSON.stringify(SERVED_BAD(s))}${p0 ? ` flat ${JSON.stringify(p0)}` : ""}${p34 ? ` synth34 ${JSON.stringify(p34)}` : ""}`);
+      expect(SERVED_OK(s), `negative control ${name} (served)`).toBe(false);
+      for (const off of ["logical", "evaluate", "shift"] as const) if (SERVED_OK_OFF(s, off)) greens[off].push(name);
+      if (p0) expect(p0.clears ?? 0, `negative control ${name} (flat paint)`).toBeLessThan(2);
+      if (p34) expect(p34.clears ?? 0, `negative control ${name} (synthetic 34 paint)`).toBeLessThan(2);
+    }
+    // the runtime write no source reader sees
+    await OPEN(page);
+    await page.evaluate(() => (document.getElementById("card-foot")!.style.paddingBottom = "0px"));
+    const inline = await SERVED_PAD(page);
+    console.log(`[RULE row 28 plant] ${browserName} inline write: served ${JSON.stringify(SERVED_BAD(inline))}`);
+    expect(SERVED_OK(inline), "negative control: an inline write").toBe(false);
+    // the served arm's own displacement plant (a margin that takes the inset back), then the battery
+    await OPEN(page, () => page.addStyleTag({ content: "#card-foot.card-foot { margin-block-end: calc(0px - env(safe-area-inset-bottom)); }" }));
+    const shift = await SERVED_PAD(page);
+    console.log(`[RULE row 28 plant] ${browserName} margin-block-end takes the inset back: served ${JSON.stringify(SERVED_BAD(shift))}`);
+    expect(SERVED_OK(shift), "negative control: a displacement site").toBe(false);
+    for (const off of ["logical", "evaluate", "shift"] as const) if (SERVED_OK_OFF(shift, off)) greens[off].push("margin-block-end");
+    console.log(`[RULE row 28 served] ${browserName} sabotage → plants read GREEN ${JSON.stringify(greens)}`);
+    for (const [off, g] of Object.entries(greens)) expect(g.length, `served clause ${off} bites`).toBeGreaterThan(0);
+  });
+
+  test("row 28 · paint under a real inset (chromium CDP): the lowest ink clears the inset line by ≥ 2 css, and max() reds it", async ({
+    page,
+    browserName,
+  }) => {
+    test.skip(browserName !== "chromium", "the inset override is a chromium CDP method; WebKit's arm is the flat phone above");
+    // THE PAINTED ARM (chromium, DPR 2): under a 34px inset the foot's lowest ink sits ≥ 2 css
+    // above the inset line (innerHeight − 34); with no inset the pad is the foot's own (2.4px here).
+    const cdp = await page.context().newCDPSession(page);
+    const at = async (bottom: number) => {
+      await cdp.send("Emulation.setSafeAreaInsetsOverride" as never, {
+        insets: { top: 0, left: 0, right: 0, bottom },
+      } as never);
+      await OPEN(page);
+      const padB = await page.evaluate(() => getComputedStyle(document.getElementById("card-foot")!).paddingBottom);
+      const ink = await LOWEST_INK(page);
+      return { padB, ink, clears: ink === null ? null : +(844 - bottom - ink).toFixed(2) };
+    };
+    const i34 = await at(34);
+    console.log(`[RULE row 28] inset 34 ${JSON.stringify(i34)}`);
+    expect(i34.clears, `the lowest ink against the inset line ${JSON.stringify(i34)}`).toBeGreaterThanOrEqual(2);
+    // NEGATIVE CONTROL, same page and inset: the pass-6 shape (the inset REPLACES the pad).
+    const tag = await page.addStyleTag({ content: "#card-foot { padding-bottom: max(0.15rem, env(safe-area-inset-bottom)) !important; }" });
+    await SHEET_SETTLED(page);
+    const ink = await LOWEST_INK(page);
+    const red = ink === null ? null : +(844 - 34 - ink).toFixed(2);
+    console.log(`[RULE row 28] inset 34, max() planted: clears ${red}`);
+    expect(red, "negative control: max() gives the band away").toBeLessThan(2);
+    await tag.evaluate((n) => (n as Element).remove());
+    // pass 9: the pass-8 critic's K-plants under the REAL inset (each reds here, as on the synthetic arm)
+    for (const [name, css] of FOOT_BEHAVIOUR_PLANTS.filter(([n]) => /^K1/.test(n))) {
+      const k = await page.addStyleTag({ content: css });
+      await SHEET_SETTLED(page);
+      const r = await FOOT_READ(page, 34);
+      console.log(`[RULE row 28] inset 34, ${name}: ${JSON.stringify(r)}`);
+      expect(r.clears ?? 0, `negative control ${name} under CDP 34`).toBeLessThan(2);
+      await k.evaluate((n) => (n as Element).remove());
+    }
+    const i0 = await at(0);
+    // CALIBRATION of the synthetic arm (the one WebKit reads): at CDP 0, the CSSOM rewrite to 34 lands
+    // the same pad and the same lowest ink as the real 34 above (|Δpad| ≤ 0.01, |Δink| ≤ 0.5 css).
+    const st = await SYNTH_ROUTE(page);
+    st.inset = 34;
+    await OPEN(page);
+    const s34 = await FOOT_READ(page, 34);
+    console.log(`[RULE row 28] synthetic 34 at CDP 0 ${JSON.stringify(s34)} against CDP 34 ${JSON.stringify(i34)}`);
+    expect(Math.abs(s34.pad - parseFloat(i34.padB)), "synthetic pad = CDP pad").toBeLessThanOrEqual(0.01);
+    expect(Math.abs((s34.ink ?? 0) - (i34.ink ?? 0)), "synthetic lowest ink = CDP lowest ink").toBeLessThanOrEqual(0.5);
+    console.log(`[RULE row 28] inset 0 ${JSON.stringify(i0)}`);
+    expect(parseFloat(i0.padB), "no inset: the foot keeps a pad of its own").toBeGreaterThan(0);
+    expect(parseFloat(i34.padB) - parseFloat(i0.padB), `the inset STACKS on the pad (${i0.padB} → ${i34.padB})`).toBeCloseTo(34, 1);
+    expect(i0.clears).toBeGreaterThanOrEqual(2);
+  });
+});
