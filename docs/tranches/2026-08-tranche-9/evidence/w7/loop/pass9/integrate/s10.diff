+        if (lit === token)
+          push({
+            file,
+            kind: `${kind}-setProperty`,
+            prelude: "setProperty",
+            value: v,
+            line: L(m.index),
+          });
+      } else if (/^`[^`]*\$\{/.test(k)) {
+        if (stemOf(k.slice(1)))
+          push({
+            file,
+            kind: `${kind}-setProperty-stem`,
+            prelude: k,
+            value: v,
+            line: L(m.index),
+            stem: true,
+          });
+      } else {
+        // WAVE union (pass 8, PROPOSED · tok-param-carried): TAPE's param-carried resolution landed
+        // in `scriptWrites` only, so this, the estate's SECOND setProperty reader, read CTRL-FACE's
+        // `put(name, v)` publisher as an UNRESOLVED write of every token (lint:bands B3 red on the
+        // measured fit at GameControlPanel.vue). One class, every reader (registry-v7 §2.5): a
+        // parameter resolved at ALL-literal call sites names its tokens; any computed call site
+        // keeps the write UNRESOLVED.
+        const carried = on("tok-param-carried")
+          ? paramCarried(js, k, m.index, consts)
+          : null;
+        if (carried) {
+          for (const c of carried)
+            if (c.name === token)
+              push({
+                file,
+                kind: `${kind}-setProperty-param`,
+                prelude: "setProperty",
+                value: c.value,
+                line: L(c.at),
+              });
+        } else
+          push({
+            file,
+            kind: `${kind}-setProperty-computed`,
+            prelude: k,
+            value: v,
+            line: L(m.index),
+            unresolved: true,
+          });
+      }
+    }
+    for (const m of js.matchAll(
+      /(?:\.style\s*\.\s*cssText\s*\+?=(?!=)|setAttribute\(\s*(["'`])style\1\s*,)\s*([^;\n]+)/g,
+    )) {
+      if (!on("csstext")) break;
+      const v = foldConcat(m[2].replace(/\)\s*$/, ""), consts);
+      if (v == null)
+        push({
+          file,
+          kind: `${kind}-cssText-computed`,
+          prelude: "cssText",
+          value: m[2].trim(),
+          line: L(m.index),
+          unresolved: true,
+        });
+      else
+        for (const d of decls(v))
+          if (d.prop === token)
+            push({
+              file,
+              kind: `${kind}-cssText`,
+              prelude: "cssText",
+              value: d.value,
+              line: L(m.index),
+            });
+    }
+    for (const m of js.matchAll(/(['"`])((?:\\.|(?!\1)[^\\])*?)\1/g))
+      if (new RegExp(`${esc}\\s*:`).test(m[2]) && !new RegExp(`^${esc}$`).test(m[2])) {
+        // WALK (pass 8, tok-string-rule; the chair p9): a string holding a whole RULE —
+        // `insertRule(".peer { --x: v }")`, a `<style>` textContent, `replaceSync(…)` — is read
+        // as rules, so the last declaration before `}` is a site; a bare declaration list stays decls
+        const rules =
+          on("tok-string-rule") && /\{/.test(m[2])
+            ? cssRules(m[2].replace(/<\/?style[^>]*>/g, " "))
+            : [{ prelude: "'…'", decls: decls(m[2]) }];
+        for (const r of rules)
+          for (const d of r.decls)
+            if (d.prop === token)
+              push({
+                file,
+                kind: `${kind}-css-string`,
+                prelude: r.prelude === "'…'" ? "'…'" : `'${r.prelude} {…}'`,
+                value: d.value,
+                important: d.important,
+                line: L(m.index),
+              });
+      }
+    if (on("typed-om"))
+      for (const w of scriptWrites(js, token, 1))
+        if (/typed-om/.test(w.kind))
+          push({
+            file,
+            kind: `${kind}-${w.kind.replace(/^script-/, "")}`,
+            prelude: "attributeStyleMap",
+            value: w.value,
+            line: L(0) + w.line - 1,
+            ...(w.unresolved ? { unresolved: true } : {}),
+          });
+  };
+  const list = files
+    ? followImports([...files, ...extra], { read: rd, exists })
+    : [...sources(fe, { read: rd, exists }), ...extra];
+  for (const f of list) {
+    const file = relative(fe, f);
+    const text = rd(f);
+    if (isCss(f))
+      cssSites(text, 1, file.startsWith("public") ? "public-css" : "stylesheet", file);
+    else if (f.endsWith(".vue")) {
+      const b = sfc(text);
+      for (const s of b.styles)
+        cssSites(
+          s.css,
+          s.line,
+          /scoped/.test(s.attrs) ? "sfc-style-scoped" : "sfc-style",
+          file,
+        );
+      if (b.template) {
+        const t = stripHtml(b.template.text);
+        attrSites(t, b.template.line, "template-style", file);
+        jsSites(t, b.template.line, "template", file);
+      }
+      for (const sc of b.scripts) jsSites(stripJs(sc.text), sc.line, "script", file);
+    } else if (f.endsWith(".html")) {
+      for (const m of text.matchAll(/<style[^>]*>([\s\S]*?)<\/style>/g))
+        cssSites(m[1], lineAt(text, m.index), "index-html-style", file);
