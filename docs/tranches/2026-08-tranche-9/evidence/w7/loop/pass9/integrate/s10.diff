+      expect(clean.some((c) => /drawer-tab/.test(c.name)), "the drawer's tab is in the census").toBe(true);
+      // THE NEGATIVE, same run: a second form on one control (the shape the fold shipped)
+      const t = await page.addStyleTag({ content: '[data-ring-census="0"]:focus-visible { outline: 2px dashed currentColor !important; }' });
+      const planted = await census();
+      await t.evaluate((e) => (e as Element).remove());
+      const caught = planted.filter(off).length;
+      test.info().annotations.push({ type: "ring-census-plant", description: `a second form on control 0: ${caught} control(s) off the ONE ring` });
+      expect(caught, "the planted second form reds the census").toBeGreaterThan(0);
+      expect(bad.map((c) => `${c.name}: ${c.form} fv ${c.fv}${c.red ? " · " + c.bands : ""}`), `every card control ${clause === "form" ? "wears" : "paints"} the ONE ring`).toEqual([]);
+    });
+  });
+}
