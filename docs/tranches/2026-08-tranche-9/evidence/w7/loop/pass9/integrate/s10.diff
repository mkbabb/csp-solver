+
+console.log(
+  `\n${violations === 0 && blind === 0 ? "PASS" : "FAIL"} — ${violations} violation(s)` +
+    (args.includes("--self-test") ? `, ${blind} blind check(s)` : ""),
+);
+process.exit(violations === 0 && blind === 0 ? 0 : 1);
