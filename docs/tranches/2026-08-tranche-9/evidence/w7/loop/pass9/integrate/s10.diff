+        ])
+      : bytes(p),
+  );
+  plant(
+    "scene.css edited after the build (letter-spacing on the card; a file the hand list missed)",
+    withServed,
+    f0,
+    sceneStamp,
+  );
+  // pass 9 — the pass-8 critic's three font plants, overlaid in memory (the CLI battery plants
+  // them on disk with the mtime restored): a byte appended, a face replaced by another face's
+  // bytes, one byte flipped where utf8 decoding hid it. Each face must be IN the graph first.
+  for (const f of FACE_ASSETS)
+    if (!GRAPH?.includes(f)) {
+      console.log(
+        `  BLIND  ${f} is not in the build's graph — a url() asset the stamp cannot see`,
+      );
+      blind++;
+    }
