+        continue;
+      }
+      if (q === "`" && c === "$" && js[i + 1] === "{") {
+        d++;
+        o += js[++i];
+        continue;
+      }
+      if (c === q && d === 0) q = null;
+      else if (q === "`" && c === "}" && d > 0) d--;
+      continue;
+    }
+    if (c === '"' || c === "'" || c === "`") {
+      q = c;
+      o += c;
+      continue;
+    }
+    if ("([{".includes(c)) d++;
+    else if (")]}".includes(c)) {
+      if (d === 0) break;
+      d--;
+    } else if ((c === "," || c === "\n") && d === 0) break;
+    o += c;
+  }
+  return o.trim();
+};
+/** Every site that DECLARES the custom property `token`: CSS declarations in every block, `@property`
+ *  initial-values, Tailwind arbitrary properties `[ --tok:v ]`, `style="…"` attributes, quoted keys of
+ *  any object literal, `.style['--x'] =`, `setProperty` with a literal or a folded concatenation,
+ *  `cssText`/`setAttribute('style')`, CSS text inside a string, and a template literal whose static
+ *  head is a stem of the token (`stem: true`). A key that is an expression is `unresolved: true`,
+ *  never dropped. [{file, kind, ctx, prelude, value, important, line}] */
+/** GRAPHITE (pass 8, publisher-split; the chair p9): the sites that PUBLISH a token are the RESOLVED
+ *  ones. An UNRESOLVED site (a computed object key `[sizeField]: v`, `setProperty(k, …)`) is printed,
+ *  never counted as a publisher (lint:ink's wash gate read 14 such keys as publishers). */
+export function publishers(sites) {
+  return on("publisher-split") ? sites.filter((s) => !s.unresolved) : sites;
+}
+/** The UNRESOLVED remainder, for a gate to PRINT (never drop, never count). */
+export function unresolvedSites(sites) {
+  return sites.filter((s) => s.unresolved);
+}
+export function tokenSites(fe, token, { files, read, exists, extra = [] } = {}) {
+  const out = [];
+  if (!on("tok-sites")) return out;
+  const rd = read ?? ((f) => readFileSync(f, "utf8"));
+  const esc = token.replace(/[.*+?^${}()|[\]\\-]/g, "\\$&");
+  const push = (s) => out.push({ ctx: "", prelude: "", important: false, ...s });
+  const cssSites = (css, line, kind, file) => {
+    for (const r of cssRules(css, line)) {
+      const reg = /^@property\s+(--[\w-]+)/.exec(r.prelude);
+      for (const d of r.decls)
+        if (d.prop === token)
+          push({
+            file,
+            kind,
+            ctx: r.ctx.join(" "),
+            prelude: r.as ?? r.prelude,
+            value: d.value,
+            important: d.important,
+            line: d.line,
+          });
+        else if (
+          on("at-property-site") &&
+          reg?.[1] === token &&
+          d.prop === "initial-value"
+        )
+          push({
+            file,
+            kind: "at-property",
+            prelude: r.prelude,
+            value: d.value,
+            line: d.line,
+          });
+    }
+  };
+  const attrSites = (html, line, kind, file) => {
+    for (const m of html.matchAll(/(?:^|\s)style\s*=\s*("([^"]*)"|'([^']*)')/g))
+      for (const d of decls(decodeEntities(m[2] ?? m[3])))
+        if (d.prop === token)
+          push({
+            file,
+            kind,
+            prelude: "style=",
+            value: d.value,
+            important: d.important,
+            line: line + lineAt(html, m.index) - 1,
+          });
