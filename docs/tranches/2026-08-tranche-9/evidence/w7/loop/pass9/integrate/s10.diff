+      // classic sideways bar; on the §10 fold the bar is the case's foot and the card's own sentinel
+      // clears Deal by 26 px with or without it (measured), so the plant reds only where it was red:
+      // WebKit, 1280×800 (1440×900 cleared by 21.47 even with the bar, pass 6), the bar in the card.
+      const barInCard = await page.evaluate(
+        (card) => !![...document.querySelectorAll(card)].find((c) => c.getClientRects().length)?.querySelector(".action-bar"),
+        CARD,
+      );
+      const plants: [string, string, boolean][] = [
+        ["G3's own", ".new-game-zone .deal-row { margin-top: 200px !important }", true],
+        // PASS 8 (charter row 11) — the range is gone at its ROOT: the two notes are capped at their
+        // row, so `overflow-x: auto` alone mints no range (read below). The plant gives back the
+        // pass-6 shape WHOLE: the overhang (the notes' 15rem uncapped) AND the sideways scrollport.
+        [
+          "the overhang given back",
+          ".tray-well .zone-hint, .action-bar .washi-label { max-width: 15rem !important } .controls-card { overflow-x: auto !important }",
+          browserName === "webkit" && vp.width === 1280 && barInCard,
+        ],
+      ];
+      const range = await page.evaluate((card) => {
+        const c = [...document.querySelectorAll(card)].find((x) => x.getClientRects().length) as HTMLElement;
+        return { sw: c.scrollWidth, cw: c.clientWidth, ox: getComputedStyle(c).overflowX };
+      }, CARD);
+      const got: string[] = [];
+      for (const [name, css, mustRed] of plants) {
+        const h = await page.addStyleTag({ content: css });
+        await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+        await top0();
+        const m = await read();
+        await h.evaluate((n) => (n as unknown as HTMLElement).remove());
+        got.push(`${name}: Deal ${m.dealBottom} vs fade ${m.fadeTop}`);
+        if (mustRed) expect(m.dealBottom, `the plant "${name}" reds G3`).toBeGreaterThan(m.fadeTop);
+      }
+      test.info().annotations.push({
+        type: "m17-g3-coarse",
+        description: `clean Deal ${clean.dealBottom} vs fade ${clean.fadeTop} (clear ${(clean.fadeTop - clean.dealBottom).toFixed(2)}) · range ${range.sw}/${range.cw} overflow-x ${range.ox} · ${got.join(" · ")}`,
+      });
+      expect(range.sw, "the card has no sideways range: its content is no wider than its box").toBeLessThanOrEqual(range.cw);
+      expect(clean.dealBottom, "G3: Deal's bottom clears the fade at scrollTop 0 on the coarse rail").toBeLessThanOrEqual(clean.fadeTop);
+    });
+  });
+}
+
+const RAIL_COARSE = { viewport: { width: 1280, height: 800 }, hasTouch: true, isMobile: false };
+for (const [label, use, armed] of [
+  ["1280 fine, rest", {}, false],
+  ["1280×800 coarse (hasTouch), rest", RAIL_COARSE, false],
+  // §10 INTEGRATION: the ARMED cell is struck. Under TAPE's question grammar (`ConfirmRibbon`) an
+  // armed Deal is no longer a `sure?` sublabel beside its receipt: the ribbon takes the deal row
+  // and the receipt steps out (`askingAct !== 'deal'`), so the two words this row measures are
+  // not both on screen when armed. The ribbon's own rows (`mobile-affordances`, `zone-grammar`)
+  // carry the armed pose.
+  ["390×844 coarse, settled", coarse(390, 844), false],
+] as const) {
+  test.describe(`M17 G5 — Deal and its receipt stand on one line (${label})`, () => {
+    test.use(use);
+    test("the two words' PAINTED glyph bottoms are within 1.5px, and a 3px drop reds", async ({ page }) => {
+      await loadCard(page, M17_PAYLOAD);
+      if (armed) {
+        const blank = await page.evaluate(() => {
+          const cells = document.querySelectorAll(".game-cell");
