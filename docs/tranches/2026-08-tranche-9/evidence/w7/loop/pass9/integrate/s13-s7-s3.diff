@@ -0,0 +1,161 @@
+import { describe, expect, it, vi } from "vitest";
+import { MOTION, handStroke } from "@pencil/config/pencilConfig";
+
+// The master subscription is driven by hand: `raw` is the rAF timeline over the span.
+let drive: ((eased: number, raw: number) => void) | null = null;
+vi.mock("@mkbabb/pencil-boil", async (orig) => ({
+  ...(await orig<typeof import("@mkbabb/pencil-boil")>()),
+  createSequenceSubscription: (o: { onProgress: (e: number, r: number) => void }) => {
+    drive = o.onProgress;
+    return { start() {}, stop() {} };
+  },
+}));
+const { enrollStroke, beginRuling, afterRuling } = await import("./bootHand");
+const SPAN = 600_000;
+
+describe("the hand's clock (T9-M20 D1)", () => {
+  it("a healthy frame is never slowed; a stall pauses the hand one cap", () => {
+    const seen: number[] = [];
+    enrollStroke((c) => {
+      seen.push(c);
+      return seen.length >= 4;
+    });
+    for (const t of [0, 16, 316, 332]) drive!(0, t / SPAN);
+    // 16 ms passes whole; the 300 ms stall advances one CAP (1.5 × 16 = 24, above the 17 ms floor);
+    // the next frame is whole again
+    const cap = Math.max(16 * MOTION.hand.paceSlack, MOTION.hand.stepMs);
+    expect(seen).toEqual([0, 16, 16 + cap, 32 + cap]);
+  });
+});
+
+/** A fresh clock (the pace is module state), driven through `dts` frame intervals from t = 0;
+ *  returns the hand's clock on every tick. */
+async function drawAt(dts: number[]): Promise<number[]> {
+  vi.resetModules();
+  const m = await import("./bootHand");
+  const seen: number[] = [];
+  m.enrollStroke((c) => {
+    seen.push(c);
+    return seen.length > dts.length;
+  });
+  let t = 0;
+  drive!(0, 0);
+  for (const d of dts) drive!(0, (t += d) / SPAN);
+  return seen;
+}
+const frames = (ms: number, n: number) => Array.from({ length: n }, () => ms);
+
+describe("the hand is a RATE on every panel (T9-W7 §13 pass 8, LAWS P7 §F)", () => {
+  // hand time per wall second, once the pace is observed: 1.0 is the page drawn in the time the
+  // design says on any display; pass 7's flat 17 ms cap read 0.515 at 30 Hz (a stall every frame)
+  for (const [hz, ms] of [
+    [125, 8],
+    [60, 1000 / 60],
+    [30, 1000 / 30],
+    [25, 40], // WebKit's '30 Hz' shim arm runs at 25 Hz (pass 9): pass 8's 34 ms cap read 0.85 here
+  ] as const)
+    it(`${hz} Hz: the hand keeps the wall's pace (≥ 0.95 of it over one second)`, async () => {
+      const n = Math.round(1000 / ms);
+      const seen = await drawAt(frames(ms, n));
+      const rate = seen[seen.length - 1] / (ms * n);
+      expect(rate).toBeGreaterThanOrEqual(0.95);
+      expect(rate).toBeLessThanOrEqual(1 + 1e-9);
+    });
+  /** The most one lost frame moves the hand on a panel of period `p`. */
+  const capAt = (p: number) =>
+    Math.min(
+      Math.max(p * MOTION.hand.paceSlack, MOTION.hand.stepMs),
+      MOTION.hand.maxStepMs,
+    );
+  it("a stall pauses the hand for at most one and a half frames at the panel's own rate", async () => {
