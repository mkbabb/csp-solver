+    await nextTick();
+    expect(line(w)).toBe(null);
+    w.unmount();
+  });
+
+  it("an undo back to empty does NOT consume the lesson — the same lesson resumes and still lifts", async () => {
+    // Pass 4, the critique's §2.4: the behaviour is decided here and the name says what the
+    // row asserts. The count follows the board, so an undo to empty takes the line away and
+    // the next write lays the SAME lesson down again; `taught` is set at the lift, so the
+    // deal's own third write still ends it. Only a new deal un-teaches (the row below).
+    const w = mountBoard();
+    await write(w, 1);
+    expect(line(w)).toBe("1 of 16 on the board");
+    await write(w, 0);
+    expect(line(w)).toBe(null);
+    await write(w, 1);
+    expect(line(w)).toBe("1 of 16 on the board");
+    // …and it still lifts on this deal's OWN third write, rather than stalling forever.
+    await write(w, 3);
+    vi.advanceTimersByTime(REST_MS);
+    await nextTick();
+    expect(line(w)).toBe(null);
+    w.unmount();
+  });
+
+  it("a YIELD ends the lesson: the count does not come back on the next write (pass 7)", async () => {
+    // The strip had no room for the count beside a long voice line, and `MarginNote` said so.
+    // Pass 6 clipped the count for as long as the voice was long, so it came back on the next
+    // short line and blinked, press for press. The yield is the lesson's end, like the lift.
+    const w = mountBoard();
+    await write(w, 1);
+    expect(line(w)).toBe("1 of 16 on the board");
+    w.findComponent(MarginNote).vm.$emit("yielded");
+    await nextTick();
+    expect(line(w)).toBe(null);
+    await write(w, 2);
+    expect(line(w)).toBe(null);
+    // and the lift timer it cleared never fires a late toggle
+    vi.advanceTimersByTime(REST_MS * 4);
+    await nextTick();
+    expect(line(w)).toBe(null);
+    // a NEW deal still un-teaches it
+    await w.setProps({ givenCells: new Set(["15"]), values: emptyValues() });
+    await nextTick();
+    await write(w, 1);
+    expect(line(w)).toBe("1 of 15 on the board");
+    w.unmount();
+  });
+
+  it("a session restored at two fills opens with no line", async () => {
+    const values = emptyValues();
+    values["0"] = 1;
+    values["1"] = 1;
+    const w = mountBoard({ values });
+    await nextTick();
+    expect(line(w)).toBe(null);
+    await write(w, 3);
+    expect(line(w)).toBe(null);
+    w.unmount();
+  });
+
+  it("a NEW DEAL un-teaches it — a fresh board of the same size gets the lesson again", async () => {
+    const w = mountBoard();
+    await write(w, 3);
+    vi.advanceTimersByTime(REST_MS);
+    await nextTick();
+    expect(line(w)).toBe(null);
+    // Same size, different givens: the board key moves, so the deal is new.
+    await w.setProps({ givenCells: new Set(["15"]), values: emptyValues() });
+    await nextTick();
+    await write(w, 1);
+    expect(line(w)).toBe("1 of 15 on the board");
+    w.unmount();
+  });
+
+  it("the debug tally outranks the count when both exist", async () => {
+    // `:meta="… tally || countLine"` — the tally is DEBUG ink and wins the one line.
+    const w = mountBoard();
+    await write(w, 1);
+    expect(line(w)).toBe("1 of 16 on the board");
+    w.unmount();
+  });
+});
