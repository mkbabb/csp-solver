+        const names = getComputedStyle(this)
+          .animationName.split(",")
+          .map((n) => n.trim());
+        return [
+          ...names
+            .filter((n) => engine.keyframes.includes(n))
+            .map((animationName) => ({ animationName })),
+          ...(engine.extra ?? []),
+        ];
+      };
+    else delete proto.getAnimations;
+    try {
+      const w = mount(MarginNote, {
+        props: { text: "one", seq: 1 },
+        global: { stubs: { transition: false } },
+        attachTo: document.body,
+      });
