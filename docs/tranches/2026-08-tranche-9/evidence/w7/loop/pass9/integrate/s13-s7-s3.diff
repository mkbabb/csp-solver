+  }
+  // R at the law's 0.9 (LAWS P8 §D): pace = native ruling / arm ruling; the arm named at the rate it DELIVERS
+  for (const r of RATES.slice(1)) {
+    const k = got[r.name].ruling / got.native.ruling;
+    const hz = 1000 / got[r.name].interval;
+    console.log(`BOOT ${project} R ${r.name} (delivers ${hz.toFixed(1)} Hz): ${k.toFixed(3)}× native, pace ${(1 / k).toFixed(3)} (floor ${R_FLOOR}, margin ${(1 / k - R_FLOOR).toFixed(3)})`);
+    if (1 / k < R_FLOOR) bad.push(`R ${r.name} (${hz.toFixed(1)} Hz): the hand kept ${(1 / k).toFixed(3)} of its native pace (${got[r.name].ruling.toFixed(0)} vs ${got.native.ruling.toFixed(0)} ms), under the law's ${R_FLOOR}`);
+  }
+  console.log(`BOOT ${project} verdict: ${bad.join(' · ') || 'GREEN'}`);
+  expect(bad).toEqual([]);
+});
+
+test(`a lost frame never teleports the hand (L, the stall leg)`, async ({ browser }) => {
+  test.setTimeout(120000);
+  const project = test.info().project.name;
+  const b = await boot(browser, 0, true);
+  console.log(`BOOT ${project} L: ${fmt(b)}; load ${loadavg()[0].toFixed(1)}`);
+  for (const s of b.stalls)
+    console.log(
+      `BOOT ${project} L stall: gap ${s.gap.toFixed(1)} ms · step ${(100 * s.step).toFixed(2)} % vs neighbours ${(100 * s.near).toFixed(2)} % → ${s.ratio.toFixed(2)}× (bound ${L_BOUND}, margin ${(L_BOUND - s.ratio).toFixed(2)}) · ${(100 * s.rate).toFixed(0)} %/s`,
+    );
+  expect(b.stalls.length, 'the leg injected no lost frame inside the ruling (vacuous)').toBeGreaterThanOrEqual(2);
+  const worst = Math.max(...b.stalls.map((s) => s.ratio));
+  expect(worst, `a lost frame moved the ruling ${worst.toFixed(2)}× its neighbours' step`).toBeLessThanOrEqual(L_BOUND);
+});
