+const L_BOUND = Number(process.env.BOOT_L_BOUND ?? 4);
+const RATES = [
+  { name: 'native', hz: 0 },
+  { name: '60 Hz', hz: 60 },
+  { name: '30 Hz', hz: 30 },
+] as const;
