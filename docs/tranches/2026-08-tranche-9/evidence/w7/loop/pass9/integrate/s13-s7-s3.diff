+  for (const m of css.matchAll(
+    /(html\.theme-turning\.ink-(hinge|sheet)[^{]*)\{([^}]*)\}/g,
+  )) {
+    const dir = /:not\(\.dark\)/.test(m[1]) ? "light" : "dark";
+    seen.add(`${m[2]}:${dir}`);
+    const want = Math.round(dusk * (frac[dir] ?? NaN));
+    const tr = m[3].match(/transition\s*:\s*([^;]+)/i)?.[1] ?? "";
+    for (const term of tr.replace(/!important/g, "").split(",")) {
+      const t = term.trim().split(/\s+/);
+      if (t.length < 3 || !mon("hinge-derive")) continue;
+      const delay = t[t.length - 1];
+      const ms = /ms$/.test(delay)
+        ? parseFloat(delay)
+        : /s$/.test(delay)
+          ? parseFloat(delay) * 1000
+          : NaN;
+      const ease = t.slice(2, -1).join(" ");
+      if (t[1] !== "0s" || ms !== want || ease !== "var(--verb-dusk-ease)")
