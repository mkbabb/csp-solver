+    // `--motion-whisper: 900ms` or an author `animation-duration: … !important` held the node for
+    // 904 ms while the transition fence above stood green (pass-6 critique §1B).
+    expect(clock.duration).toBe(`${MOTION.rungs.whisper}ms|important`);
+    // Vue's fallback clock is delay + duration: the delay is the third longhand of the same fence.
+    expect(clock.delay).toBe("0s|important");
+  });
