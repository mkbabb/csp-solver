+  houseAxis: "row",
+};
+
+function makeDomain(): Domain {
+  return {
+    initial: {
+      difficulty: "EASY",
+      source: "fresh",
+      persisted: null,
+      boardLink: "absent",
+    },
+    initialSize: 3,
+    boardSizeOf: (raw) => raw * raw,
+    getRandomBoard: async () => DEALT,
+    applyDealFurniture: () => {},
+    resetFurniture: () => {},
+    grade: () => ({ hardestTechnique: null, solved: true }),
+    solve: async (values) => ({
+      solved: true,
+      values,
+      backtracks: 0,
+      nodesExplored: 0,
+      propagations: 0,
