+    sheet: string,
+    engine: { keyframes: string[]; extra?: object[] } | false = {
+      keyframes: ["ink-rub-out", "ink-rub-out-fade"],
+    },
+  ) {
+    const st = document.createElement("style");
+    st.textContent = sheet;
+    document.head.append(st);
