+  const texts =
+    files ??
+    sources(ROOT)
+      .map((f) => [relative(ROOT, f), f])
+      .filter(
+        ([rel]) =>
+          /\.(ts|tsx|js|vue)$/.test(rel) &&
+          !/\.(test|spec)\.[jt]sx?$/.test(rel) &&
+          !rel.includes("/pencil/dev/"),
+      )
+      .map(([rel, f]) => [rel, readFileSync(f, "utf8")]);
