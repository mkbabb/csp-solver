+
+/** B6 · 5 — the roster ratchet. A banked read (`file :: path` at n reads, value ms) that the tree
+ *  holds FEWER of has left its line: lawful when the same file gained reads of paths worth at
+ *  least ms (a move up, a rename), RED when the file gained a SHORTER one (the swap), RED when it
+ *  gained nothing (it left — a DELETED/MOVED row `{ consumer, ms }` with a cite), unless a RETUNE
+ *  `{ consumer, to }` licenses the one swap it names. */
+function consumerRatchet(bank, roster, ledger = LEDGER) {
+  if (!mon("consumer-roster")) return [];
+  const bad = [];
+  const banked = bank?.consumers;
+  if (!banked)
+    return [
+      "motion-bank.json carries no `consumers` roster — the TS consumers of the ladder are unratcheted (charter row 3).",
+    ];
+  const esc = (k) => ledger.find((r) => r.consumer === k);
+  for (const [k, [n, ms]] of Object.entries(banked)) {
+    if (ms === null) continue;
+    const now = roster[k]?.[0] ?? 0;
+    if (now >= n) continue;
+    const file = k.split(" :: ")[0];
+    const gained = Object.entries(roster).filter(
+      ([g, [gn, gms]]) =>
+        g !== k &&
+        g.split(" :: ")[0] === file &&
+        gms !== null &&
+        gn > (banked[g]?.[0] ?? 0),
+    );
+    const lower = gained.filter(([, [, gms]]) => gms < ms);
+    const row = esc(k);
+    if (row) {
+      if (row.cls === "RETUNE" && lower.some(([, [, gms]]) => gms === row.to)) continue;
+      if (
+        (row.cls === "DELETED" || row.cls === "MOVED") &&
+        row.ms === ms &&
+        !lower.length
+      )
+        continue;
+    }
+    if (lower.length)
+      bad.push(
+        `${k}  banked ${n}× at ${ms}ms, now ${now}× — and ${file} gained ${lower.map(([g, [, gms]]) => `${g.split(" :: ")[1]} (${gms}ms)`).join(", ")}: a consumer SWAPPED to a shorter rung. A RETUNE \`{ consumer: "${k}", to: <ms> }\` citing its census, or read the rung it read.`,
+      );
+    else if (!gained.some(([, [, gms]]) => gms >= ms))
+      bad.push(
+        `${k}  banked ${n}× at ${ms}ms, now ${now}× — a consumer LEFT. A DELETED or MOVED row \`{ consumer: "${k}", ms: ${ms} }\` with a cite.`,
+      );
+  }
+  return bad;
+}
