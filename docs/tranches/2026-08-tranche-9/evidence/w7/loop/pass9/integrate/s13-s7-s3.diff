+          `index.css  ink-${m[2]} ${dir}: \`${term.trim()}\` — the hinge steps at 0s on var(--verb-dusk-ease) after round(${dusk} × ${frac[dir]}) = ${want}ms.`,
+        );
+    }
+  }
+  if (mon("hinge-present"))
+    for (const k of ["hinge:dark", "hinge:light", "sheet:dark", "sheet:light"])
+      if (!seen.has(k))
+        bad.push(
+          `index.css carries no html.theme-turning.ink-${k.replace(":", " ")} rule — the arm has no instant.`,
+        );
+  return bad;
+}
