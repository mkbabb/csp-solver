+function poseGeometry(frames: string[]): PoseGeometry[] {
+  const hit = poseGeometryCache.get(frames);
+  if (hit) return hit;
+  const built = frames.map((d) => {
+    const single = poseIsLinearSinglePath(d);
+    const pts = single ? posePoints(d) : [];
+    const cum: number[] = pts.length ? [0] : [];
+    for (let i = 1; i < pts.length; i++)
+      cum.push(
+        cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]),
+      );
+    return { pts, cum, single };
+  });
+  if (import.meta.env.DEV && built.some((g) => !g.single))
+    console.warn(
+      "[gridPaths] poseFronts: a pose is not a single linear polyline and was handed back uncut " +
+        "(gridPaths §poseIsLinearSinglePath).",
+    );
+  poseGeometryCache.set(frames, built);
+  return built;
+}
+
+/**
+ * Each pose CUT at `fraction` of its own arc length — the fill gauge's front, as geometry.
+ *
+ * THE DASH IS GONE, AND THAT IS THE CURE (T9-W7 §4). The gauge used to draw its front with
+ * `stroke-dasharray` over `pathLength="1000"`, and in WebKit it read 92% filled at a quarter.
+ * The pass-2 synthesis named `pathLength` as the cause; on the built prototype that is FALSE.
+ * Measured on this ring, both engines, four declaration arms (attribute dash, CSS dash, a
+ * period equal to the path, an offset of zero): every arm reads 4 runs at 0.215 share in
+ * WebKit for a requested 0.05. Decimating the same pose walks it back — 492 segments → 4 runs,
+ * 123 → 1, and a perfectly straight 599-segment rectangle breaks identically, so it is not the
+ * wobble either. WebKit restarts the dash phase every ~128 segments of a polyline; Chromium
+ * dashes the path whole. A hand-drawn ring is ~490 segments by construction.
+ *
+ * So the front is not dashed. It is DRAWN: the pose is truncated at `fraction · length`, with
+ * the final point interpolated, and the renderer paints a path that ends exactly where the
+ * player's work has got to. Engine-independent by construction, because there is no dash
+ * pattern for an engine to restart, and it cannot regress when a board size or a grain setting
+ * moves the segment count past somebody's chunk boundary.
+ *
+ * The price, declared and then PAID: `stroke-dashoffset` was tweenable and a truncated `d` is
+ * not, so a bare swap would STEP the front ~31px per digit at 9x9 and ~158px at 4x4. The tween
+ * moved up one level instead — the consumer eases the FRACTION on the boil scheduler's sequence
+ * chain and calls this on a RATE-GATED subset of its frames (HandDrawnGrid, T9-W7 §5), never
+ * once per vsync: the budget is re-cuts per SECOND, because a per-event frame count is the
+ * reviewer's display talking (29 on a 120 Hz panel against 15 on a 60 Hz one — pass-3 critique
+ * §3.1). The step survives as the PRM arm and as the fallback should the rung ever read 0.
+ *
+ * PRECONDITION: one subpath per pose, enforced at the parse (`poseIsLinearSinglePath` above); a
+ * multi-subpath pose comes back uncut and unchanged.
+ */
+export function poseFronts(frames: string[], fraction: number): string[] {
+  const f = Math.max(0, Math.min(1, fraction));
+  if (f >= 1) return frames;
+  if (f <= 0) return frames.map(() => "");
+  const geom = poseGeometry(frames);
+  return frames.map((d, i) => {
+    const { pts, cum, single } = geom[i];
+    if (!single) return d;
+    const target = cum.length ? cum[cum.length - 1] * f : 0;
+    if (!pts.length || target <= 0) return "";
+    const out = [pts[0]];
+    for (let k = 1; k < pts.length; k++) {
+      if (cum[k] >= target) {
+        const seg = cum[k] - cum[k - 1];
+        const t = seg === 0 ? 0 : (target - cum[k - 1]) / seg;
+        out.push([
+          pts[k - 1][0] + (pts[k][0] - pts[k - 1][0]) * t,
+          pts[k - 1][1] + (pts[k][1] - pts[k - 1][1]) * t,
+        ]);
+        break;
+      }
+      out.push(pts[k]);
+    }
+    return pointsToLinear(out);
+  });
+}
+
+/**
+ * THE FRONT'S RATE BUDGET, and every `poseFronts` consumer rides it (T9-W7 §5).
+ *
+ * A `sequence` subscriber holds the continuous rAF chain while it runs, so "one re-cut per
+ * frame" is the panel's refresh rate wearing a budget's clothes: ungated, the tally re-cut at
+ * 134.2/s on a 128 Hz panel and 60.9/s on a 63 Hz one (pass-4 critique §3.1). The budget is a
+ * declared constant instead: one re-cut per FRONT_MIN_MS slot, ≤62.5 re-cuts per second at any
+ * refresh rate, the forced end included, and no two frames' re-cuts closer than FRONT_GAP_MS.
+ * It is the hand's displacement clause less one millisecond (`MOTION.hand.stepMs`, the one
+ * home). `e2e/front-rate.spec.ts` counts it on every consumer, prints each burst's shortest gap
+ * on both clocks, and holds every burst to a floor as well as the ceiling.
+ */
+// policy: rate
+export const FRONT_MIN_MS = MOTION.hand.stepMs - 1;
+/** A.6's floor on the gap between two re-cut FRAMES: the budget read to the half millisecond. */
+export const FRONT_GAP_MS = FRONT_MIN_MS - 0.5;
+
+// A clock that has only ever read whole-millisecond gaps is 1 ms-quantised (WebKit's
+// `performance.now()` and its rAF timestamps both are). The first fractional gap anywhere on
+// the page proves a finer clock (chromium's reads 0.1 ms). Only a WALL reading pays for the
+// grain (a forced write's timer, a write with no frame): a reading of 16 there may be 15.01 ms,
+// so it asks for one more millisecond. A FRAME's reading does not: frames are vsync-quantised,
+// so its gap is a whole number of panel frames, and a 60 Hz panel's 16.67 ms frame reads 16 as
+// often as 17. Charged the extra millisecond, that panel re-cut on 17/33 ms and lost one frame
+// in three (40.2/s against 60, WebKit, pass-7 critique §1.3).
+let clockSeen = NaN;
+let wholeMsClock = true;
+function readClock(): number {
+  const now = performance.now();
+  const gap = now - clockSeen;
+  if (gap > 0 && Math.abs(gap - Math.round(gap)) > 1e-6) wholeMsClock = false;
+  clockSeen = now;
+  return now;
+}
+
+/**
+ * Leading-edge rate gate on a front's commit: a write lands now when its slot is open (the
+ * front never lags the act by more than one slot), and never faster than the budget.
+ *
+ * THE BUDGET IS A RATE ON A GRID, NOT A GAP FROM THE LAST COMMIT. A run's k-th commit is never
+ * before its first + k·FRONT_MIN_MS (so no burst beats 62.5/s, the end included), and no two
+ * frames' commits are closer than FRONT_GAP_MS (A.6). A frame that lands late on its slot keeps
+ * the grid, so the next slot is not pushed back by the lateness: a gap-from-last gate at 16 ms
+ * swallowed every pair of frames that read 15.6–15.99 ms apart and re-cut at 49–53/s on a driven
+ * 125 Hz clock and 42.7/s on a 128 Hz panel, where the grid keeps two frames in most slots. A
+ * commit a whole slot late restarts the grid there: a pause banks no credit.
+ *
+ * Two clocks, one per kind of write. A frame's write passes its FRAME's time (`at`, the rAF
+ * timestamp `frontTween` hands its `onProgress`), and the grid and A.6 are read on it: read from
+ * the callback instead, the gap took the drift of the callback's place in its frame (pass 7). A
+ * write with no frame (a forced end in a timer, a snap from a watcher) is timed on the wall from
+ * where the last re-cut LANDED, with the grain's millisecond: a frame's commit reaches the DOM
+ * after the rest of that frame's work (0–9 ms, pass 7), so timed from the request a forced end
+ * landed 14.0–15.4 ms after it. A `force`d write is never dropped and never lands early: it is
+ * owed, and lands when the wall's window clears. A write that arrives while one is owed replaces
+ * its value (the latest is the truth). The frame's clock never runs ahead of the wall's, so
+ * mixing them only ever widens a gap, and a wall commit ≥ FRONT_MIN_MS after the last is always
+ * on or past its slot.
+ */
+export function frontGate(commit: (v: number) => void) {
+  let last = -Infinity;
+  let landed = -Infinity; // when the last re-cut reached the DOM (read after the render's flush)
+  let slot = -Infinity; // the next slot on the run's grid
+  let owed: { v: number } | null = null;
+  let timer: ReturnType<typeof setTimeout> | null = null;
+  const wallFloor = () => FRONT_MIN_MS + (wholeMsClock ? 1 : 0);
+  const cancel = () => {
+    owed = null;
+    if (timer !== null) clearTimeout(timer);
+    timer = null;
+  };
+  const land = (v: number, now: number, framed: boolean) => {
+    cancel();
+    slot = now >= slot + FRONT_MIN_MS ? now + FRONT_MIN_MS : slot + FRONT_MIN_MS;
+    last = now;
+    commit(v);
+    // queued after the render's flush (the commit queued it), so this reads the landing; a
+    // write with no frame IS its landing, so the next frame is timed from there
+    queueMicrotask(() => {
+      landed = readClock();
+      if (!framed) last = Math.max(last, landed);
+    });
+  };
+  const from = (force: boolean) => (force ? Math.max(last, landed) : last);
+  const open = (now: number, framed: boolean, force: boolean) =>
+    framed
+      ? now >= slot && now - last >= FRONT_GAP_MS
+      : now - from(force) >= wallFloor();
+  const flush = () => {
+    timer = null;
+    if (!owed) return;
+    const now = readClock();
+    const wait = from(true) + wallFloor() - now;
+    if (wait > 0) timer = setTimeout(flush, wait);
+    else land(owed.v, now, false);
+  };
+  return {
+    write(v: number, force = false, at?: number) {
+      const wall = readClock(); // read on every write: the grain detector sees each one
+      const now = at ?? wall;
+      if (open(now, at !== undefined, force)) return land(v, now, at !== undefined);
+      if (owed) owed.v = v;
+      else if (force) {
+        owed = { v };
+        timer = setTimeout(flush, Math.max(0, from(true) + wallFloor() - wall));
+      }
+    },
+    /** A new run drops an owed end it supersedes. The grid stands: the run's first write lands
+     *  at once if its slot is open, and is owed (forced) or folded into the next frame's write
+     *  otherwise, never landed early. */
+    rearm: cancel,
+  };
+}
+
+// THE PANEL'S FRAME, OBSERVED (LAWS P7 §F: a cap is keyed on the observed frame interval, never
+// a per-frame constant). The SHORTEST of the page's last PANEL_WINDOW tween ticks (LAWS P8 §D: a
+// stall cap keys on the shortest recent tick, never a median). A panel's frame is its shortest
+// interval and a stall only ever lengthens one, so a run of stalls cannot become the panel until
+// it fills the whole window: the median of nine did at the fifth consecutive stall, and from there
+// every stall travelled the wall clock (17 ms × 4, then 150 ms × 5; pass-8 critique §0.1). A 30 Hz
+// panel reads 33 ms on every tick, so it is still not a stall. Capped at a constant 17 ms, a 30 Hz
+// panel read EVERY frame as a stall and ran each front at half speed (the class VERB's hand showed
+// at 4.7 s to its digits).
+// THE WINDOW'S TWO COSTS, both declared: a run of PANEL_WINDOW consecutive stalls is read as the
+// panel (31 are capped, the 32nd travels: the cliff the unit rows pin from both sides), and a panel
+// that drops from 60 to 30 Hz mid-page runs its fronts at the hand's step until 32 of its frames
+// have filled the window (~1.07 s at half speed).
+// Until five ticks are seen the panel is unknown and the cap is the hand's own step: a stalled
+// first frame would land the front wherever the wall says (the displacement clause, D10). The cost
+// is a 30 Hz panel's first tween: four frames at the hand's step, ~65 ms late on a 240 ms front.
+// ONE READING A FRAME, keyed on the frame's time: every tween ticks in the same frame (the reveal
+// wave runs 61), and fed per tick the window took a stall 61 times in one frame (pass 8).
+const PANEL_MIN_TICKS = 5;
+export const PANEL_WINDOW = 32;
+const ticks: number[] = [];
+let tickAt = -Infinity;
+function panelFrameMs(dt: number, at: number): number {
+  if (dt > 0 && Math.abs(at - tickAt) >= 1) {
+    tickAt = at;
+    ticks.push(dt);
+    if (ticks.length > PANEL_WINDOW) ticks.shift();
+  }
+  if (ticks.length < PANEL_MIN_TICKS) return MOTION.hand.stepMs;
+  return Math.min(...ticks);
+}
+
+/**
+ * A front's tween on the hand's clock (T9-M20 D10, the displacement clause): one pencil-boil
+ * `sequence` carries the rAF timeline and the tween's own clock advances by at most one of the
+ * panel's frames per tick (`MOTION.hand.stepMs` at 60 Hz and above, the observed frame below),
+ * so a frame the main thread lost pauses the front for one frame's travel instead of landing it
+ * wherever the wall clock says. A healthy frame at any refresh rate is never slowed.
+ * `onComplete` fires when the tween's clock, not the wall's, reaches `durationMs`. Under reduced
+ * motion the sequence never starts: the consumer lands its value itself, as before.
+ */
+export function frontTween(o: {
+  durationMs: number;
+  easing: (t: number) => number;
+  /** `at`: this frame's rAF timestamp, for `frontGate.write(v, force, at)` */
+  onProgress: (eased: number, at: number) => void;
+  onComplete: (at: number) => void;
+}) {
+  const SPAN_MS = 600_000; // the carrier's span: the tween ends on its own clock long before
+  let clock = 0;
+  let prev = 0;
+  let origin = 0; // the carrier's start on the rAF clock (pencil-boil reads performance.now() there)
+  const seq = createSequenceSubscription({
+    durationMs: SPAN_MS,
+    onProgress: (_eased, raw) => {
+      const t = raw * SPAN_MS;
+      const dt = Math.max(0, t - prev);
+      clock += Math.min(dt, Math.max(MOTION.hand.stepMs, panelFrameMs(dt, origin + t)));
+      prev = t;
+      if (clock < o.durationMs)
+        return o.onProgress(o.easing(clock / o.durationMs), origin + t);
+      seq.stop();
+      o.onComplete(origin + t); // the end is written in a frame too, and is timed on it
+    },
+  });
+  return {
+    start() {
+      origin = performance.now();
+      seq.start();
+    },
+    stop: seq.stop,
+  };
+}
