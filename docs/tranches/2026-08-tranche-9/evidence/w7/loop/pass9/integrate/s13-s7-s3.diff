+function b13Arith(lad, sites = arithSites(), admitted = ADMITTED_ARITH) {
+  const bad = [];
+  const used = new Set();
+  for (const s of sites) {
+    const v = arithValue(s, lad);
+    const row = admitted.find((r) => r.file === s.rel && r.expr === s.expr);
+    if (!row) {
+      bad.push(
+        `${s.rel}:${s.line}  ${s.expr} — arithmetic on a clock${v === null ? "" : ` computing ${v}ms`}; the consumer's value is the subject: an ADMITTED_ARITH row with its \`expr\` and \`ms\`, or read the rung bare.`,
+      );
+      continue;
+    }
+    used.add(row);
+    const same =
+      v === null || row.ms === null ? v === row.ms : Math.abs(v - row.ms) < 1e-9;
+    if (!same)
+      bad.push(
+        `${s.rel}:${s.line}  ${s.expr} computes ${v}; its ADMITTED_ARITH row says ms: ${row.ms} — the row licenses ONE value.`,
+      );
+  }
+  for (const r of admitted)
+    if (!used.has(r) && !(r.ctx && !LIB_CTX))
+      bad.push(`ADMITTED_ARITH ${r.file} :: ${r.expr} admits nothing — STALE.`);
