+// ── 2a″. The union's two lines: the SWAP and line two's own rub-out (pass 8, §7's fence) ─
+//
+// HOLD's default path: a hint is answered (the record is held), the next hint displaces it, and
+// line one gives the record to line two in the same write. The old line-one node leaves as
+// `note-swap` (`animation: none`): a sentence displacing another is not an exit, and line two
+// already paints it, so that node must not outlive a frame or two. Pass 7's hook wrote the rung on
+// it and held it ~160 ms with the sentence on both lines for 16–20 frames (every gate green,
+// because the drop-clock rows read `.note-leave-active` only). This leg reads BOTH leaves of a
+// pushed record, post-paint, in both themes: the swap (zero-length) and line two's later
+// rub-out (the rung, whatever an author says), with the fence blinded and pass 6's hook as the
+// in-run negatives.
+const HOLD_GIVENS: Record<number, number> = {
+  0: 5, 1: 3, 4: 7, 9: 6, 12: 1, 13: 9, 14: 5, 19: 9, 20: 8, 25: 6, 27: 8, 31: 6, 35: 3, 36: 4,
+  39: 8, 41: 3, 44: 1, 45: 7, 49: 2, 53: 6, 55: 6, 60: 2, 61: 8, 66: 4, 67: 1, 68: 9, 71: 5,
+  76: 8, 79: 7, 80: 9,
+};
+const HOLD_BOARD = encodeSudoku(3, HOLD_GIVENS, 81);
+const HOLD_SOLUTION =
+  '534678912672195348198342567859761423426853791713924856961537284287419635345286179';
+const lineOne = (page: Page) =>
+  page.evaluate(() => (document.querySelector('.margin-note')?.textContent ?? '').trim());
+const lineTwo = (page: Page) =>
+  page.evaluate(() => (document.querySelector('.margin-note-previous')?.textContent ?? '').trim());
+
+/** Ask for a hint at the first empty cell (the `h` key), and wait for line one to change. */
+async function ask(page: Page) {
+  const before = await lineOne(page);
+  await page.evaluate(() =>
+    ([...document.querySelectorAll('.board-cells input')] as HTMLInputElement[])
+      .find((i) => !i.value)
+      ?.focus(),
+  );
+  await page.keyboard.press('h');
+  await expect.poll(() => lineOne(page), { timeout: 5000 }).not.toBe(before);
+}
+
+/** Answer the hint on line one: the digit it names, typed into the one cell it marks. */
+async function answer(page: Page) {
+  const said = await lineOne(page);
+  const digit = (/(?:only|is)\s+(\S+)\s/.exec(said) ?? [])[1] ?? (/^(\S+)\s+goes/.exec(said) ?? [])[1];
+  expect(digit, `a digit in "${said}"`).toBeTruthy();
+  const target = await page.evaluate(
+    ([d, sol]) =>
+      [...document.querySelectorAll('.game-cell')]
+        .map((c, i) => ({ c, i }))
+        .filter(
+          ({ c, i }) =>
+            c.querySelector('.cell-because') &&
+            !(c.querySelector('input') as HTMLInputElement).value &&
+            sol[i] === d,
+        )
+        .map(({ i }) => i),
+    [digit!, HOLD_SOLUTION] as const,
+  );
+  expect(target, `one cell for "${said}"`).toHaveLength(1);
+  await page.locator('.game-cell input').nth(target[0]).focus();
+  await page.keyboard.type(digit!);
+}
+
+/** The pinned deal, in `scheme`, with `arm` applied after the deal lands. */
+async function holdDeal(page: Page, scheme: 'light' | 'dark', arm?: (page: Page) => Promise<void>) {
+  await page.emulateMedia({ colorScheme: scheme });
+  await loadSudoku(page, '?board=' + HOLD_BOARD);
+  await arm?.(page);
+  await ask(page);
+  await answer(page);
+  await page.waitForTimeout(MOTION.rungs.note * 2);
+}
