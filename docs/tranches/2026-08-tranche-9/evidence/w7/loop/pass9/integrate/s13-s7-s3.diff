+/**
+ * G-HINGE (pass 8, MOT-VERB charter row 3) — the hinge is DERIVED, never re-typed. Its two delays
+ * are B9's literals, so no ratchet ever read them: a retune of `dusk` moved the ink's instant off
+ * the crossing with every gate green (the pass-7 critic's gap). Here each `html.theme-turning.ink-*`
+ * rule's transition terms are read and held to 0s on `var(--verb-dusk-ease)` after
+ * round(MOTION.rungs.dusk × MOTION.hinge.<direction>) ms, and the dusk verb's curve to the one the
+ * crossing was derived under (`MOTION.hinge.curve`). One frame of drift is a red.
+ */
+function gHinge(src, css, rungs) {
+  const bad = [];
+  const leaves = tsLeaves(src, "MOTION");
+  const frac = { dark: leaves["hinge.dark"], light: leaves["hinge.light"] };
+  const dusk = rungs.find((r) => r.key === "dusk")?.value;
+  if (mon("hinge-present") && (frac.dark == null || frac.light == null || dusk == null))
+    bad.push(
+      "MOTION.hinge.{dark, light} or the `dusk` rung is not declared — the hinge has no home.",
+    );
+  const curve = src.match(/\bhinge:\s*\{[^}]*?\bcurve:\s*"([^"]+)"/)?.[1];
+  const duskEase = src.match(
+    /\bdusk:\s*\{\s*(?:\/\*[^]*?\*\/\s*)?ease:\s*"([^"]+)"/,
+  )?.[1];
+  if (mon("hinge-curve") && (curve == null || curve !== duskEase))
+    bad.push(
+      `the dusk verb eases on ${duskEase ?? "(none)"} and the hinge was derived under ${curve ?? "(none)"} — re-derive the crossing (MOTION.hinge) before the curve moves.`,
+    );
