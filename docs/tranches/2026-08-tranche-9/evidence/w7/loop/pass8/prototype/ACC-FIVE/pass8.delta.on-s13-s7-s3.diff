+/**
+ * G10-PANEL — THE SERVED `frontGate` ON A TRUE PANEL, IN THIS ENGINE (pass 8, registry-v7 §2.7a).
+ * The driven clock above is a timer and jitters, so it cannot stand for a vsync-quantised panel.
+ * This row loads the served tree's own module (the dev server's graph, no copy) and drives it with
+ * EXACT frame streams — k·(1000/Hz) ms, stamped whole-ms and fine — one non-forced write per frame
+ * on its frame's time, the way `frontTween` writes. The gate's grain detector is the ENGINE's own
+ * (`performance.now()` inside `write`), so WebKit reads its whole-millisecond clock for real.
+ * Asserts: a 60 Hz stream keeps EVERY frame (≥ 59/s: pass 7's whole-ms +1 re-cut WebKit at 40.2/s
+ * on 17/33 ms and is this row's born-RED); every stream ≥ 0.9 × min(Hz, 62.5) where A.6 admits it;
+ * ≤ 62.5/s; no two commits < 15.5 ms.
+ * A.6 ALONE caps a panel at Hz / ⌈15.5 · Hz / 1000⌉ (every k-th frame), so the chair's formula is
+ * unreachable by ANY gate that honours A.6 at 75, 90, 100, 144 and 165 Hz (37.5, 45.0, 50.0, 48.0,
+ * 55.0/s against 56.25). Those streams run too, gated at 0.9 × A.6's best, and print the chair's
+ * formula's verdict beside it: the contradiction is the chair's to rule, never re-worded here.
+ */
+test("G10-panel: the served frontGate keeps every frame of a true 60 Hz panel, and every rate's floor", async ({ page }, testInfo) => {
+  await page.goto("/?size=3&difficulty=EASY");
+  await page.waitForSelector(".sudoku-cell", { timeout: 60000 });
+  const rows = await page.evaluate(async ([streams, mod]) => {
+    const m = await import(/* @vite-ignore */ mod);
+    return streams.map(([hz, quant]) => {
+      const hits: number[] = [];
+      let cur = 0;
+      const g = m.frontGate(() => hits.push(cur));
+      const t0 = Math.round(performance.now()) + 5000;
+      const n = Math.round(hz * 2);
+      for (let k = 0; k < n; k++) {
+        const t = t0 + (k * 1000) / hz;
+        cur = quant ? Math.round(t) : t;
+        g.write(k / n, false, cur);
+      }
+      const gaps = hits.slice(1).map((x, i) => x - hits[i]);
+      return { hz, quant, frames: n, commits: hits.length, perS: ((hits.length - 1) / (hits[hits.length - 1] - hits[0])) * 1000, minGap: Math.min(...gaps) };
+    });
+  }, [[[60, true], [60, false], [30, true], [30, false], [120, true], [125, true], [125, false], [75, false], [90, false], [100, false], [144, false], [165, false], [240, false]] as [number, boolean][], "/src/pencil/grid/gridPaths.ts"] as const);
+  const a6Best = (hz: number) => Math.min(BUDGET_PER_S, hz / Math.ceil((MIN_GAP_MS * hz) / 1000));
+  const grain = await page.evaluate(() => {
+    const a = performance.now();
+    let b = a;
+    while (b === a) b = performance.now();
+    return Math.abs(b - a - Math.round(b - a)) < 1e-9 ? "whole-ms" : "fine";
+  });
+  const lines = rows.map((r) => {
+    const chair = FLOOR_SHARE * Math.min(r.hz, BUDGET_PER_S);
+    return `${r.hz} Hz ${r.quant ? "whole-ms" : "fine"} stamps: ${r.commits}/${r.frames} frames committed, ${r.perS.toFixed(1)}/s, min gap ${r.minGap.toFixed(2)} ms · A.6's best ${a6Best(r.hz).toFixed(1)}/s · chair's floor ${chair.toFixed(1)} ${r.perS >= chair ? "met" : a6Best(r.hz) < chair ? "UNREACHABLE under A.6" : "RED"}`;
+  });
+  for (const l of lines) console.log(`G10-PANEL ${testInfo.project.name} (engine clock ${grain}) ${l}`);
+  testInfo.annotations.push({ type: "G10-panel", description: `engine clock ${grain} · ` + lines.join(" · ") });
+  const sixty = rows.find((r) => r.hz === 60 && r.quant)!;
+  expect(sixty.perS, `a true 60 Hz whole-ms stream re-cut ${sixty.perS.toFixed(1)}/s: the gate swallowed a healthy frame`).toBeGreaterThanOrEqual(59);
+  for (const r of rows) {
+    const floor = FLOOR_SHARE * Math.min(r.hz, BUDGET_PER_S, a6Best(r.hz));
+    expect(r.perS, `${r.hz} Hz (${r.quant ? "whole-ms" : "fine"}) re-cut ${r.perS.toFixed(1)}/s under ${floor.toFixed(1)}`).toBeGreaterThanOrEqual(floor);
+    expect(r.perS).toBeLessThanOrEqual(BUDGET_PER_S);
+    expect(r.minGap).toBeGreaterThanOrEqual(MIN_GAP_MS);
+  }
+});
