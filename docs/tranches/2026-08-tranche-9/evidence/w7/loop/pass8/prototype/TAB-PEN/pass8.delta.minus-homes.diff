+      { ids: ["b.cap"] },
+    ),
+    plant(
+      "S7 mitre joins",
+      (s) => s.replace('stroke-linejoin="round"', 'stroke-linejoin="miter"'),
+      "b",
+      { ids: ["b.join"] },
+    ),
+    plant(
+      "S8 a rule under a foreign @media",
+      inStyle("@media(min-width:1px){path{stroke:#0a0a0a}}"),
+      "bc",
+      { ids: ["b.context"] },
+    ),
+    plant(
+      "S9 the file padded past 600 B",
+      (s) => s.replace("</svg>", `${" ".repeat(200)}</svg>`),
+      "b",
+      { ids: ["b.bytes"] },
+    ),
+    plant("S10 relative commands (m/c)", (s) => s.replace(/ d="M/, ' d="m'), "de", {
+      ids: ["d.unreadable"],
+    }),
+    plant(
+      "S11 an arm drawn at 0.6 scale (in the table, PNG from its path)",
+      pathTo(movePath(PEN[ARM], 0, 0, 0.6)),
+      "de",
+      {
+        arm: { name: "small", width: WIDTH, d: movePath(PEN[ARM], 0, 0, 0.6) },
+        png: pngOf(movePath(PEN[ARM], 0, 0, 0.6), WIDTH),
+        ids: ["d.extent"],
+      },
+    ),
+    plant(
+      "S12 an arm moved 2 units right (in the table, PNG from its path)",
+      pathTo(movePath(PEN[ARM], 2, 0)),
+      "d",
+      {
+        arm: { name: "moved", width: WIDTH, d: movePath(PEN[ARM], 2, 0) },
+        png: pngOf(movePath(PEN[ARM], 2, 0), WIDTH),
+        ids: ["d.centre"],
+      },
+    ),
+    plant("S13 public/icon.svg missing", (s) => s, "e", {
+      patch: { iconExists: false },
+      ids: ["e.icon-file"],
+    }),
+    plant("S14 the touch icon missing", (s) => s, "e", {
+      patch: { png: null },
+      ids: ["e.png-file"],
+    }),
+    plant("S15 a re-rastered PNG with the old sha in the sidecar", (s) => s, "e", {
+      png: pngOf(PEN[ARM], WIDTH),
+      stalePng: true,
+      ids: ["e.prov-png"],
+    }),
+    plant("S16 a 90 x 90 touch icon", (s) => s, "e", {
+      png: pngN(90, () => PAPER_RGB),
+      ids: ["e.png-size"],
+    }),
+    plant("S17 one transparent pixel in the touch icon", (s) => s, "e", {
+      png: pngOf(PEN[ARM], WIDTH, 180 * 90),
+      ids: ["e.png-opaque"],
+    }),
+    plant(
+      "NN1 the same ink spelled rgb(10 10 10)",
+      (s) => s.replace("path{stroke:#0a0a0a}", "path{stroke:rgb(10 10 10)}"),
+      "",
+    ),
+    plant(
+      "NN2 a decoy rule inside a CSS comment",
+      (s) =>
+        s.replace(
+          "path{stroke:#0a0a0a}",
+          "path{stroke:#0a0a0a/* path{stroke-width:9px} */}",
+        ),
+      "",
+    ),
+    plant("NN3 a decoy second rel=icon inside an HTML comment", (s) => s, "", {
+      html: (h) =>
+        h.replace(
+          /(<link rel="apple-touch-icon"[^>]*>)/,
+          '$1\n    <!-- <link rel="icon" href="/thick.svg" /> -->',
+        ),
+    }),
+    plant(
+      "NN8 the icon link's href spelled with an entity (/icon&#46;svg) is the same link",
+      (s) => s,
+      "",
+      { html: (h) => h.replace('href="/icon.svg"', 'href="/icon&#46;svg"') },
+    ),
+    plant("NN4 a second @theme paper that AGREES with index.css", (s) => s, "", {
+      files: withFile(
+        "src/zz-agree.css",
+        "@theme { --color-background: hsl(48 15% 98%); }",
+      ),
+    }),
+    plant(
+      "NN5 the owner's arm B by one const (WIDTH 5), its PNG rastered from the path",
+      (s) => s.replace('stroke-width="4"', 'stroke-width="5"'),
+      "",
+      {
+        arm: { name: ARM, width: 5, d: PEN[ARM] },
+        png: pngOf(PEN[ARM], 5),
+      },
+    ),
+    plant(
+      "NN6 the owner's arm H by one const, its PNG rastered from the path",
+      pathTo(PEN.H),
+      "",
+      { arm: { name: "H", width: WIDTH, d: PEN.H }, png: pngOf(PEN.H, WIDTH) },
+    ),
+    plant(
+      "NN7 the shipped PNG against a raster of the same path (a W PNG from the analytic raster)",
+      (s) => s,
+      "",
+      { png: pngOf(PEN[ARM], WIDTH) },
+    ),
+  ];
+  return results.every(Boolean);
+}
+
+const model = readTree(ROOT);
+
+if (process.argv.includes("--sabotage-battery")) {
+  // Every check id the self-test names, and the library clauses this gate reads: each switched off
+  // alone must red the self-test (LAWS P7 §F (ii)).
+  const ids = [
+    "a.junk",
+    "a.count",
+    "a.element",
+    "a.attr",
+    "a.dupe",
+    "a.root",
+    "a.ns",
+    "a.viewbox",
+    "a.paper",
+    "a.paper-xy",
+    "a.order",
+    "b.fill",
+    "b.cap",
+    "b.join",
+    "b.width",
+    "b.at-rule",
+    "b.context",
+    "b.selector",
+    "b.prop",
+    "b.important",
+    "b.bytes",
+    "c.unplaced",
+    "c.unresolved",
+    "c.conflict",
+    "c.tokens",
+    "c.opaque",
+    "c.delta",
+    "c.fallback",
+    "d.arm",
+    "d.unreadable",
+    "d.extent",
+    "d.centre",
+    "d.window",
+    "d.mass",
+    "e.link-icon",
+    "e.link-touch",
+    "e.icon-file",
+    "e.favicon",
+    "e.prov-svg",
+    "e.png-file",
+    "e.prov-png",
+    "e.png-size",
+    "e.png-opaque",
+    "e.png-paper",
+    "e.png-coverage",
+    "e.png-darkest",
+    "e.png-tie",
+  ];
+  const lib = [
+    "html-comment",
+    "one-link",
+    "token-conflict",
+    "tok-sites",
+    "at-own",
+    "collect-walk",
+    "decode",
+  ];
+  let bite = 0;
+  const rows = [];
+  for (const id of ids) {
+    OFF.clear();
+    OFF.add(id);
+    const ok = selfTest(model, { quiet: true });
+    rows.push(`  ${ok ? "HOLE" : "BITE"}  gate  ${id}`);
+    if (!ok) bite++;
+  }
+  OFF.clear();
+  for (const id of lib) {
+    sabotage([id]);
+    fileCache.clear(); // the library's readings under this clause's absence
+    const m2 = readTree(ROOT);
+    const ok = selfTest(m2, { quiet: true });
+    rows.push(`  ${ok ? "HOLE" : "BITE"}  lib   ${id}`);
+    if (!ok) bite++;
+  }
+  sabotage([]);
+  fileCache.clear();
+  console.log(
+    `check-favicon --sabotage-battery:\n${rows.join("\n")}\n  ${bite}/${ids.length + lib.length} bite`,
+  );
+  process.exit(bite === ids.length + lib.length ? 0 : 2);
+}
+
+const fails = audit(model);
+console.log(`check-favicon (${ROOT}):`);
+for (const clause of "abcde") {
+  const mine = fails.filter(([c]) => c === clause);
+  console.log(
+    `  ${clause}  ${mine.length ? "RED" : "GREEN"}${mine.map(([, id, w]) => `\n       ${id}: ${w}`).join("")}`,
+  );
+}
+const ras = raster(PEN[ARM], WIDTH);
+const img = decodePng(model.png);
+const pt = pageTokens(model.files);
+if (
+  ras &&
+  img &&
+  pt.tok.light["--color-background"] &&
+  pt.tok.light["--color-foreground"]
+) {
+  const fit = tie(
+    img,
+    ras,
+    pt.tok.light["--color-background"],
+    pt.tok.light["--color-foreground"],
+  );
+  console.log(
+    `  readings: arm ${ARM} width ${WIDTH} · mass ${ras.mass.toFixed(4)} · png tie mean |Δ| ${fit.meanDelta.toFixed(4)} IoU ${fit.iou.toFixed(4)} · unresolved non-setProperty sites ${pt.unresolved.length - pt.unresolved.filter((u) => /setProperty/.test(u.kind)).length} (printed, not red)`,
+  );
+}
+if (process.argv.includes("--self-test") && !selfTest(model)) {
+  console.error(
+    "\ncheck-favicon: a plant did not red its clause (or a negative-negative went red)",
+  );
+  process.exit(2);
+}
+if (fails.length) {
+  console.error(`\ncheck-favicon: ${fails.length} failure(s)`);
+  process.exit(1);
+}
+console.log(
+  "\ncheck-favicon: the tab's s is one pen line, on the page's paper, in its ink",
+);
