@@ -0,0 +1,168 @@
+import { test, expect, type Browser } from '@playwright/test';
+import { encodeSudoku } from './wire';
+import { onOff, grey, median } from './lib/paint-lib.mjs';
+
+// PRM: live, because the read is the steady look the default regime lands on (the draw-in done and
+// the four poses baked); reduce bakes the same poses, and the frame is read at rest either way.
+
+/**
+ * T9-W7 §13 · THE FRAME IS PAINTED WHOLE (INTAKE-23 rows 1–2; registry-v7 §2.2 (i), ACC-GRAPHITE's
+ * unblock). The board frame's four sides are one 12-unit stroke in the grid's 1000-unit box, and the
+ * steady look is the four BAKED poses: coverage bitmaps exactly the box's size. With the ring's top and
+ * bottom on the box's edge (`FRAME_Y_PAD` 0), half of each of those strokes fell outside the bitmap and
+ * was never painted: the owner saw the sides at their full weight and the top and bottom at half.
+ *
+ * THE READ, in paint: the board is photographed with the grid's ink ON and OFF, and the per-pixel
+ * coverage (the OFF grey minus the ON grey, over the OFF grey minus the ink's grey) is summed across each
+ * side's band on the cell-centre lines, where no inner rule crosses it. That sum is the side's painted
+ * depth in device pixels. Keyed on the board's DEVICE-PIXEL span (printed), never on the pointer.
+ *   F1  top and bottom each paint ≥ 0.85 of the sides' mean depth
+ *   F2  every side paints ≥ 0.6 of the stroke's own device width (12 units × the scale), in units of
+ *       the stroke's core ink, read off the sides' own strongest paint (no ink token is trusted)
+ * PLANT (in-run, must RED): the baked ink cut to the box's inner 99 % vertically, which takes the outer
+ * part of the top and bottom strokes away as the edge bake used to.
+ * Born RED on the control (`74a2b5d9`): top and bottom read about half the sides at every rig.
+ */
+// prettier-ignore
+const SOLVED_9 = [
+  5, 3, 4, 6, 7, 8, 9, 1, 2,  6, 7, 2, 1, 9, 5, 3, 4, 8,  1, 9, 8, 3, 4, 2, 5, 6, 7,
+  8, 5, 9, 7, 6, 1, 4, 2, 3,  4, 2, 6, 8, 5, 3, 7, 9, 1,  7, 1, 3, 9, 2, 4, 8, 5, 6,
+  9, 6, 1, 5, 3, 7, 2, 8, 4,  2, 8, 7, 4, 1, 9, 6, 3, 5,  3, 4, 5, 2, 8, 6, 1, 7, 9,
+];
+const BLANKS = new Set([0, 4, 10, 22, 36, 40, 55, 61, 73, 80]);
+const BOARD = encodeSudoku(
+  3,
+  Object.fromEntries(SOLVED_9.map((v, i) => [i, BLANKS.has(i) ? 0 : v])),
+  81,
+);
+
+/** Desk, phone and the three 1× touch boards (registry-v7 §2.2 (iii)). */
+const RIGS = [
+  { name: 'desk 1280x800 fine dpr1', w: 1280, h: 800, dpr: 1, touch: false },
+  { name: 'phone 390x844 coarse dpr2', w: 390, h: 844, dpr: 2, touch: true },
+  { name: 'tablet 768x1024 coarse dpr1', w: 768, h: 1024, dpr: 1, touch: true },
+  { name: 'tablet 1024x768 coarse dpr1', w: 1024, h: 768, dpr: 1, touch: true },
+  { name: 'laptop 1280x800 coarse dpr1', w: 1280, h: 800, dpr: 1, touch: true },
+] as const;
+const SCHEMES = ['light', 'dark'] as const;
+const PLANT_CSS = '.grid-ink { clip-path: inset(0.9% 0 0.9% 0); }';
+const OFF_CSS = '.grid-ink, .hand-drawn-grid { visibility: hidden !important; }';
+const UNITS = 1000;
+const STROKE = 12;
+const BAND = 26; // the inner rules start 26 units in: the band reads the frame alone
+
+type Reading = { span: number; top: number; bottom: number; left: number; right: number; want: number };
+
+async function readFrame(
+  browser: Browser,
+  rig: (typeof RIGS)[number],
+  colorScheme: 'light' | 'dark',
+  plant: boolean,
+): Promise<Reading> {
+  const ctx = await browser.newContext({
+    viewport: { width: rig.w, height: rig.h },
+    deviceScaleFactor: rig.dpr,
+    hasTouch: rig.touch,
+    colorScheme,
+    reducedMotion: 'no-preference',
+  });
+  const page = await ctx.newPage();
+  await page.goto('/?game=sudoku&board=' + BOARD);
+  await page.locator('.board-cells').first().waitFor();
+  expect(await page.locator('.board-cells [aria-label*="given clue"]').count()).toBe(71);
+  // the steady look: the draw-in done and all four poses baked (the live stack is the fallback)
+  // (a box under a coverage mask on this tree; an svg `<image>` on `74a2b5d9`: the read keys on neither)
+  await expect(page.locator('.boil-frame-bitmap')).toHaveCount(4, { timeout: 30000 });
+  if (plant) await page.addStyleTag({ content: PLANT_CSS });
+  await page.evaluate(() => document.fonts.ready);
+  const g = await page.evaluate(() => {
+    const svg = document.querySelector('svg.hand-drawn-grid')!.getBoundingClientRect();
+    const side = Math.min(svg.width, svg.height);
+    return { x: svg.left + (svg.width - side) / 2, y: svg.top + (svg.height - side) / 2, side };
+  });
+  const margin = 16;
+  const clip = {
+    x: Math.max(0, g.x - margin),
+    y: Math.max(0, g.y - margin),
+    width: g.side + 2 * margin,
+    height: g.side + 2 * margin,
+  };
+  const { on, off } = await onOff(page, clip, OFF_CSS);
+  await ctx.close();
+  const d = rig.dpr;
+  const u = (g.side * d) / UNITS; // device px per unit
+  const X0 = (g.x - clip.x) * d;
+  const Y0 = (g.y - clip.y) * d;
+  const centres = Array.from({ length: 9 }, (_, i) => ((i + 0.5) * UNITS) / 9);
+  const inner = Math.round(BAND * u);
+  const outer = Math.round(margin * d);
+  // THE STROKE'S CORE, read off the sides' own paint: the strongest 1 % of the ON−OFF grey step
+  // across their bands (a dark step on light paper, a light one on dark), so one denominator serves
+  // every tree, theme and engine and no ink token is trusted
+  const step = (i: number) => grey(off.data, i) - grey(on.data, i);
+  const steps: number[] = [];
+  for (const c of centres)
+    for (let k = -outer; k < inner; k++) {
+      const along = Math.round(Y0 + c * u);
+      for (const x of [Math.round(X0) + k, Math.round(X0 + g.side * d) - 1 - k])
+        steps.push(step((along * on.w + x) * 3));
+    }
+  const sign = steps.reduce((a, v) => a + v, 0) >= 0 ? 1 : -1;
+  const mags = steps.map((v) => v * sign).sort((p, q) => q - p);
+  const core = mags[Math.floor(mags.length * 0.01)];
+  const cov = (x: number, y: number): number =>
+    core < 8 ? 0 : Math.min(1, Math.max(0, (step((y * on.w + x) * 3) * sign) / core));
+  // one depth per cell-centre line, per side
+  const depth = (side: 'top' | 'bottom' | 'left' | 'right'): number =>
+    median(
+      centres.map((c) => {
+        const along = Math.round(c * u);
+        let s = 0;
+        for (let k = -outer; k < inner; k++) {
+          if (side === 'top') s += cov(Math.round(X0) + along, Math.round(Y0) + k);
+          if (side === 'bottom') s += cov(Math.round(X0) + along, Math.round(Y0 + g.side * d) - 1 - k);
+          if (side === 'left') s += cov(Math.round(X0) + k, Math.round(Y0) + along);
+          if (side === 'right') s += cov(Math.round(X0 + g.side * d) - 1 - k, Math.round(Y0) + along);
+        }
+        return s;
+      }),
+    );
+  return {
+    span: Math.round(g.side * d),
+    top: depth('top'),
+    bottom: depth('bottom'),
+    left: depth('left'),
+    right: depth('right'),
+    want: STROKE * u,
+  };
+}
+
+function failures(r: Reading): string[] {
+  const out: string[] = [];
+  const sides = (r.left + r.right) / 2;
+  for (const k of ['top', 'bottom'] as const)
+    if (r[k] < 0.85 * sides) out.push(`F1 ${k} paints ${r[k].toFixed(2)} px against the sides' ${sides.toFixed(2)} (${(r[k] / sides).toFixed(3)} < 0.85)`);
+  for (const k of ['top', 'bottom', 'left', 'right'] as const)
+    if (r[k] < 0.6 * r.want) out.push(`F2 ${k} paints ${r[k].toFixed(2)} px of a ${r.want.toFixed(2)} px stroke`);
+  return out;
+}
+
+const fmt = (r: Reading) =>
+  `span ${r.span} dpx · t ${r.top.toFixed(2)} b ${r.bottom.toFixed(2)} l ${r.left.toFixed(2)} r ${r.right.toFixed(2)} · stroke ${r.want.toFixed(2)} · t/b÷sides ${(Math.min(r.top, r.bottom) / ((r.left + r.right) / 2)).toFixed(3)}`;
+
+for (const rig of RIGS)
+  for (const scheme of SCHEMES)
+    test(`the frame paints whole · ${rig.name} · ${scheme}`, async ({ browser }) => {
+      const r = await readFrame(browser, rig, scheme, false);
+      console.log(`FRAME ${test.info().project.name} ${rig.name} ${scheme}: ${fmt(r)}`);
+      expect(failures(r)).toEqual([]);
+    });
+
+// THE NEGATIVE, in-run: the outer edge of the top and bottom strokes cut away must RED.
+for (const rig of [RIGS[0], RIGS[1]])
+  test(`PLANT half-stroke reds the frame read · ${rig.name}`, async ({ browser }) => {
+    const r = await readFrame(browser, rig, 'light', true);
+    const red = failures(r);
+    console.log(`FRAME PLANT ${test.info().project.name} ${rig.name}: ${fmt(r)} → ${red.join(' · ') || 'GREEN (the gate is blind)'}`);
+    expect(red.length, 'the half-stroke plant painted and the gate stayed green').toBeGreaterThan(0);
+  });
