+// glyph-pop.d.mts — the TYPE of the ONE glyph-population probe (`./glyph-pop.mjs`), so a TypeScript
+// spec can import it under `typecheck:e2e` (strict, no `allowJs`: a bare `.mjs` import is TS7016).
+// No behaviour lives here. The exports `player-tally.spec.ts` calls are typed; every other export
+// is declared `unknown` until a spec that calls it types it.
+// NOT-A-LANE: a declaration of the chair's home (T9-W7 pass 8, PLR-COUNT's G14), beside PLR-SELF's
+// `edge-bands.d.mts`.
+import type { Page } from "@playwright/test";
+
+export interface GlyphRead {
+  red: boolean;
+  /** one entry per breached clause, each led by its id (`G1` … `G5`) */
+  why: string[];
+  population?: number;
+  coreMedian?: number;
+  fracUnder?: number;
+  columns?: number;
+  slicePop?: number;
+  slices?: (number | null)[];
+  glyphCores?: (number | null)[];
+  transientOn?: number;
+  transientOff?: number;
+  outsideRun?: number;
+  dpr?: number;
+}
+/** A plant is a CSS string, or `{ mask: [a, b] }`: that fraction of the text run at 25 %. */
+export type GlyphPlant = string | { mask: [number, number] };
+
+export function TEXT_PLANTS(subject: string): Record<string, GlyphPlant>;
+export function glyphGate(
+  page: Page,
+  opts: {
+    subject: string;
+    payload: string;
+    plants?: Record<string, GlyphPlant> | null;
+    slack?: number;
+    [k: string]: unknown;
+  },
+): Promise<{
+  payload: string;
+  bound: number | null;
+  clean: GlyphRead;
+  plants: Record<string, GlyphRead>;
+}>;
+export function fmt(r: GlyphRead): string;
+
+export const autoSlices: unknown;
+export const glyphPopulation: unknown;
+export const IMG_PLANTS: unknown;
+export const applyPlant: unknown;
+export const applyTail: unknown;
+export const undoTail: unknown;
+export const applyMask: unknown;
+export const undoMask: unknown;
+export const selfTest: unknown;
