+        )
+        .map(({ i }) => i),
+    [digit!, HOLD_SOLUTION] as const,
+  );
+  expect(target, `one cell for "${said}"`).toHaveLength(1);
+  await page.locator('.game-cell input').nth(target[0]).focus();
+  await page.keyboard.type(digit!);
