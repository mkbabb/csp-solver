+
+/** Answer the hint on line one: the digit it names, typed into the one cell it marks. */
+async function answer(page: Page) {
+  const said = await lineOne(page);
+  const digit = (/(?:only|is)\s+(\S+)\s/.exec(said) ?? [])[1] ?? (/^(\S+)\s+goes/.exec(said) ?? [])[1];
