+/** Ask for a hint at the first empty cell (the `h` key), and wait for line one to change. */
+async function ask(page: Page) {
+  const before = await lineOne(page);
+  await page.evaluate(() =>
+    ([...document.querySelectorAll('.board-cells input')] as HTMLInputElement[])
+      .find((i) => !i.value)
+      ?.focus(),
+  );
