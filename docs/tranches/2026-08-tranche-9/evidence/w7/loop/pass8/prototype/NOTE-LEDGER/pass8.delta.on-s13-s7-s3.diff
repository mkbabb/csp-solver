+        `${face.family} · ${group.where}: declares "${s}" and the tree no longer renders ` +
+          `it. The group is CLOSED (declared == derived): a call site was deleted or ` +
+          `re-worded, so strike the string here or restore the site.`,
+      );
+    else departures.push(`${face.family} · ${group.where}: "${s}"`);
+  return out;
