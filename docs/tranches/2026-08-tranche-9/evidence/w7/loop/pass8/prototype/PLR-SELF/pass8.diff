+/**
+ * THE FRAME'S CORNER IS THE GROUND'S, READ LIVE (pass-7 critic gap 9; registry-v7 §5 row 9). The
+ * frame's radius is the ground's computed radius less the edge's inset, read on a ResizeObserver.
+ * At a 16px root that is the literal 15 the two used to share, so only a larger root can tell a
+ * live read from a literal one. The row reads the DRAWN corner: every path of the edge sampled
+ * every 0.25px, mapped to the page, and at each of the ground's four corners the nearest drawn
+ * point d. A frame of radius r inset i sits d = (i + r)·√2 − r from the corner, so the drawn
+ * radius is r = (d − i·√2) / (√2 − 1). The hand's wobble spreads the four corners by about ±1.3px,
+ * so the row reads their mean: within 1px of (ground − inset) at 16px AND at 18px, and risen by
+ * at least 1px between them. The literal 15 at 18px sits about 2.7px short.
+ */
+test('the frame follows the ground\'s corner at an 18px root', async ({ page }) => {
+  await page.emulateMedia({ reducedMotion: 'reduce' });
+  await page.goto(SOLO);
+  await settled(page);
+  const read = () =>
+    lobby(page).evaluate((el) => {
+      const g = el.getBoundingClientRect();
+      const inset = (el.querySelector('.head-sheet-edge') as HTMLElement).offsetTop;
+      const pts: [number, number][] = [];
+      for (const p of el.querySelectorAll<SVGPathElement>('.head-sheet-edge path')) {
+        const m = p.getScreenCTM()!;
+        for (let s = 0, L = p.getTotalLength(); s <= L; s += 0.25) {
+          const q = p.getPointAtLength(s);
+          pts.push([m.a * q.x + m.c * q.y + m.e, m.b * q.x + m.d * q.y + m.f]);
+        }
+      }
+      const drawn = [
+        [g.left, g.top],
+        [g.right, g.top],
+        [g.right, g.bottom],
+        [g.left, g.bottom],
+      ].map(([cx, cy]) => {
+        const d = Math.min(...pts.map(([x, y]) => Math.hypot(x - cx, y - cy)));
+        return (d - inset * Math.SQRT2) / (Math.SQRT2 - 1);
+      });
+      return {
+        want: parseFloat(getComputedStyle(el).borderTopLeftRadius) - inset,
+        mean: +(drawn.reduce((a, b) => a + b, 0) / 4).toFixed(2),
+      };
+    });
+  const at = async (root: string) => {
+    await page.evaluate((r) => (document.documentElement.style.fontSize = r), root);
+    await mark(page).click();
+    await openSheet(page);
+    await stable(read);
