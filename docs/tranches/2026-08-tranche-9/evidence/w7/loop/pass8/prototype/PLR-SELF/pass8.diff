+/**
+ * ONE TAP, ONE TOGGLE, WHATEVER THE TAP'S CLICK SAYS IT IS (pass-6 critic gap 4; LAWS P6 §D).
+ * WebKit labels a touch's click `pointerType: "mouse"`, and its emulation sends no click at all
+ * after a prevented press, so a guard keyed on the label held in WebKit only because the click
+ * was absent. This context delivers what a real iOS tap may: after every touch release, exactly
+ * one click labelled `mouse` (a trusted touch click is swallowed and re-sent with that label; where
+ * the engine sends none, one is sent 60ms after the release — the chair's RELABEL plant). The
+ * guard keyed on the SEQUENCE toggles once per tap in both engines; a guard keyed on the label
+ * toggles twice and the sheet never stays open.
+ */
+test('one tap is one toggle when the tap\'s click is labelled as a mouse', async ({ browser }) => {
+  const ctx = await browser.newContext({ viewport: { width: 390, height: 844 }, hasTouch: true });
+  await ctx.addInitScript(() => {
+    let pending: ReturnType<typeof setTimeout> | null = null;
+    const fire = (t: EventTarget, x: number, y: number) =>
+      t.dispatchEvent(
+        new PointerEvent('click', { bubbles: true, cancelable: true, composed: true, pointerType: 'mouse', clientX: x, clientY: y, button: 0 }),
+      );
+    addEventListener('pointerup', (e) => {
+      if (!e.isTrusted || e.pointerType !== 'touch') return;
+      const t = e.target!, x = e.clientX, y = e.clientY;
+      pending = setTimeout(() => ((pending = null), fire(t, x, y)), 60);
+    }, { capture: true });
+    addEventListener('click', (e) => {
+      if (!e.isTrusted) return;
+      if (pending) {
+        clearTimeout(pending);
+        pending = null;
+      }
+      if ((e as PointerEvent).pointerType === 'mouse') return;
+      e.stopImmediatePropagation();
+      e.preventDefault();
+      const t = e.target!, x = e.clientX, y = e.clientY;
+      queueMicrotask(() => fire(t, x, y));
+    }, { capture: true });
+  });
+  const page = await ctx.newPage();
+  await page.goto(SOLO);
+  await settled(page);
+  await mark(page).evaluate((el) => {
+    const seen: string[] = [el.getAttribute('aria-expanded')!];
+    (window as any).__states = seen;
+    new MutationObserver(() => {
+      const v = el.getAttribute('aria-expanded')!;
