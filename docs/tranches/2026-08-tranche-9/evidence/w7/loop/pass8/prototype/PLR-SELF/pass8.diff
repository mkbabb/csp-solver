+export function stat(a) {
+  if (!a.length) return null;
+  const s = [...a].sort((p, q) => p - q);
+  return { n: s.length, min: +s[0].toFixed(1), median: +s[s.length >> 1].toFixed(1), p95: +s[Math.floor(s.length * 0.95)].toFixed(1), max: +s[s.length - 1].toFixed(1) };
