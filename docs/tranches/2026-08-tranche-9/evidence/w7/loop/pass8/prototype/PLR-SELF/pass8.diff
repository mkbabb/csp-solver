+    const x = Math.max(0, Math.floor(host.left + el.offsetLeft - 10));
+    const y = Math.max(0, Math.floor(host.top + el.offsetTop - 10));
+    return { x, y, width: el.offsetWidth + 20, height: el.offsetHeight + 20 };
+  });
+  const shot = async () => (await page.screenshot({ clip: b, animations: 'disabled' })).toString('base64');
+  const on = await shot();
+  const again = await shot();
+  const tag = await page.addStyleTag({ content: `${sel} { display: none !important; }` });
+  const gone = await shot();
+  await tag.evaluate((e) => (e as Element).remove());
+  return page.evaluate(
+    async ({ on, again, gone }) => {
+      const px = async (b64: string) => {
+        const bmp = await createImageBitmap(await (await fetch(`data:image/png;base64,${b64}`)).blob());
+        const c = document.createElement('canvas');
+        c.width = bmp.width;
+        c.height = bmp.height;
+        const x = c.getContext('2d')!;
+        x.drawImage(bmp, 0, 0);
+        return x.getImageData(0, 0, c.width, c.height).data;
+      };
+      const [A, A2, G] = [await px(on), await px(again), await px(gone)];
+      const moved = (p: Uint8ClampedArray, q: Uint8ClampedArray, i: number) =>
+        Math.max(Math.abs(p[i] - q[i]), Math.abs(p[i + 1] - q[i + 1]), Math.abs(p[i + 2] - q[i + 2])) >= 6;
+      let n = 0;
+      for (let i = 0; i < A.length; i += 4) if (moved(A, G, i) && !moved(A, A2, i)) n++;
+      return n;
+    },
+    { on, again, gone },
+  );
