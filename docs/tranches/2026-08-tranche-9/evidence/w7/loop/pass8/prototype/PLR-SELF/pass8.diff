+  cramped.value = short;
+  await nextTick();
+  const sheet = document.getElementById(lobbyId);
+  const host = sheet?.offsetParent;
+  if (!sheet || !(host instanceof HTMLElement)) return null;
+  const at = host.getBoundingClientRect();
+  return new DOMRect(
+    at.left + sheet.offsetLeft,
+    at.top + sheet.offsetTop,
+    sheet.offsetWidth,
+    sheet.offsetHeight,
+  );
+}
