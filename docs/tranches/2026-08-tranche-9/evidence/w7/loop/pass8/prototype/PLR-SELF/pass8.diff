+  // The peek up, the sheet open.
+  await page.keyboard.press('k');
+  await expect.poll(peekUp, { timeout: 5000 }).toBe(1);
+  await m.evaluate((el: HTMLElement) => el.focus());
+  await page.keyboard.press('Space');
+  await expect(m).toHaveAttribute('aria-expanded', 'true');
+
+  await page.keyboard.press('Escape');
+  // THE ROW: the sheet took the key, and the peek never saw it.
+  await expect(m).toHaveAttribute('aria-expanded', 'false');
+  expect(await peekUp()).toBe(1);
+
+  // THE NEGATIVE CONTROL: with the sheet shut the peek owns Escape, as it always has.
+  await page.keyboard.press('Escape');
+  await expect.poll(peekUp, { timeout: 5000 }).toBe(0);
+});
