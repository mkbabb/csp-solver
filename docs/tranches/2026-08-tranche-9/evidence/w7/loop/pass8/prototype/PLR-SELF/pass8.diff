+/**
+ * THE HEAD'S DISCLOSURES ARE ONE ANOTHER'S KEEPERS (T9-W7 §11) — a Set at module scope.
+ *
+ * Two surfaces now hang off the same origin — the attribution card and the player lobby, both
+ * `top: 100%; left: 0` off the one fixed head wrapper — so two open at once would be two sheets
+ * in one place. A module Set, not `provide`/`inject`: there is exactly one head per document,
+ * the mark is not a descendant of the card in either the desktop or the mobile arm, and a
+ * disclosure that unmounts takes its own line out. Five lines, three exports, no injection key.
+ */
+const headClosers = new Set<() => void>();
+
+/** Register a `close`. Returns the removal, for a disclosure that unmounts. */
+export function registerHeadDisclosure(close: () => void): () => void {
+  headClosers.add(close);
+  return () => {
+    headClosers.delete(close);
+  };
+}
+
+/** "I am opening" — everyone but the caller shuts. */
+export function claimHeadDisclosure(self: () => void): void {
+  for (const c of headClosers) if (c !== self) c();
