+    why,
+    population: pop.length,
+    coreMedian: +med.toFixed(3),
+    fracUnder: +frac.toFixed(3),
+    columns: n,
+    slicePop: sp,
+    slices: sl,
+    glyphCores: gw,
+    transientOn,
+    transientOff,
+    outsideRun,
+    clip,
+    dpr,
+  };
