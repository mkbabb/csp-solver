+  align-items: center;
+  gap: 0.35rem;
+  min-height: 1.4rem;
+  font-family: var(--font-hand);
+  font-size: var(--type-small);
+  line-height: 1.35;
+  color: var(--color-user-ink);
+}
+
+.pl-stub {
+  flex: 0 0 auto;
+}
+
+.pl-name {
+  color: var(--color-user-ink);
+}
