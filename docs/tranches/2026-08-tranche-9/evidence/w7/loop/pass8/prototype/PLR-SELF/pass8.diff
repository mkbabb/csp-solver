+const on = (id) => !OFF.has(id);
+/** Switch clauses off (the clause-sabotage battery; LAWS P7 §F (ii)). `[]` restores all. */
+export function sabotage(ids = []) {
+  OFF.clear();
+  for (const i of ids) OFF.add(i);
+}
+
+// ---------------------------------------------------------------------------------------- files
+const fsLs = (d) =>
+  existsSync(d)
+    ? readdirSync(d).map((name) => ({
+        name,
+        dir: statSync(join(d, name)).isDirectory(),
+      }))
+    : null;
+/** Every file under `dir` passing `pred` (dot-dirs and node_modules skipped). `ls` lists a directory
+ *  as [{name, dir}] (default: the disk; the self-test passes a virtual tree). */
+export function walk(dir, pred, out = [], ls = fsLs) {
+  const entries = ls(dir);
+  if (!entries) return out;
+  for (const { name: n, dir: isDir } of entries) {
+    if (n === "node_modules" || n.startsWith(".")) continue;
+    const p = join(dir, n);
+    if (isDir) walk(p, pred, out, ls);
+    else if (pred(p)) out.push(p);
+  }
+  return out;
