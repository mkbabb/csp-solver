+// The narrow surface `vite.config.ts` (face-stamp) reads off the ONE shape-census library
+// (registry-v7 §2.4). An ambient `declare module` cannot name a relative path, so the declaration
+// sits beside the module, as `e2e/lib/*.d.mts` do.
+/** The files `files` pull in through CSS `@import` chains, the inputs included. */
+export function followImports(files: string[]): string[];
