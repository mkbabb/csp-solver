@@ -0,0 +1,15 @@
+// Types for the ONE painted-byte library (`paint-lib.mjs`), as the TypeScript specs call it
+// (T9-W7 CTRL-FACE pass 8, PROPOSED to the homes; see edge-bands.d.mts). Narrow on purpose.
+import type { Page } from "@playwright/test";
+
+export interface Raw {
+  w: number;
+  h: number;
+  data: Uint8Array;
+}
+export function onOff(
+  page: Page,
+  clip: { x: number; y: number; width: number; height: number },
+  offCss: string,
+): Promise<{ on: Raw; off: Raw }>;
+export function settle(page: Page): Promise<void>;
