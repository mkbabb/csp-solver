+import { test, expect } from "@playwright/test";
+// @ts-expect-error — the ONE paint library is an .mjs home with no declaration (registry-v7 §2.4)
+import { onOff, lum, ratio } from "./lib/paint-lib.mjs";
+
+// PRM: frozen — emulateMedia({reducedMotion:'reduce'}) before goto. The row reads one painted ground at rest.
+
+/**
+ * T9-W7 ACC-SIX pass 8 · THE WASH, READ AS PAINTED (the behavioural row beside `check-theme-tokens`'
+ * wash reach; LAWS P7 §F (iii): every source law pairs with a paint read on the real surface).
+ *
+ * `.cell-peer` — the selected cell's row / column / box reach — paints ONE ground token whose arm
+ * the const in index.css names. The row selects an empty cell on a real 9x9 deal (`?board=`, 30
+ * givens), photographs the inner 40 % of an empty PEER cell with its wash and with the wash layer
+ * hidden (the SAME pixels, one variable), and reads the step between them (WCAG ratio of the mean
+ * luminances). The step is the wash: it must not fall under HEAD's own painted step (1.078 light /
+ * 1.104 dark, the critic's reading of `74a2b5d9`), less 0.006 for the photograph.
+ *
+ * IN-RUN PLANTS (each must RED, the negative in the same run): W1 the consumer faded
+ * (`.cell-peer { opacity: .2 }`: 1.017-1.026 on GRAPHITE's tree) and W5 an `@property`
+ * re-registration of the token with `initial-value: transparent` (1.000: the consumer never
+ * inherits the const). A source gate reads neither in paint; this row reads both.
+ */
+
+const FLOOR = { light: 1.072, dark: 1.098 };
+const PLANTS = {
+  W1: ".cell-peer { opacity: 0.2 !important; }",
+  W5: "@property --ground-wash-unit { syntax: '<color>'; inherits: false; initial-value: transparent; }",
+};
+
+// A REAL 9x9 payload: a valid solved grid by the band pattern, 30 givens seeded.
+const SOL9 = Array.from({ length: 81 }, (_, i) => {
+  const r = Math.floor(i / 9);
+  return ((3 * (r % 3) + Math.floor(r / 3) + (i % 9)) % 9) + 1;
+});
+const KEEP9 = new Set([0, 4, 8, 10, 13, 16, 20, 22, 24, 27, 31, 35, 37, 39, 41, 43, 45, 49, 53, 56, 58, 60, 64, 67, 70, 72, 76, 80, 2, 78]);
+const PUZ9 = SOL9.map((v, i) => (KEEP9.has(i) ? String(v) : "0")).join("");
+const BOARD9 =
+  "?board=" +
+  btoa(String.fromCharCode(1) + "3." + PUZ9)
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+
+type Page = import("@playwright/test").Page;
+type Px = { data: Uint8Array; w: number; h: number };
+/** The wash's step on ONE clip: mean luminance with the layer vs the same pixels without it. */
+async function step(page: Page, clip: { x: number; y: number; width: number; height: number }) {
+  const { on, off } = (await onOff(page, clip, ".cell-peer { display: none !important; }")) as { on: Px; off: Px };
+  const mean = (p: Px) => {
+    const n = p.w * p.h;
+    let s = 0;
+    for (let k = 0; k < n; k++) s += lum(p.data, k * 3);
+    return s / n;
+  };
+  return +ratio(mean(on), mean(off)).toFixed(3);
+}
+
+for (const scheme of ["light", "dark"] as const) {
+  test(`the wash paints its step over the card, and the plants that fade it red · ${scheme}`, async ({ browser }) => {
+    test.setTimeout(90000);
+    const ctx = await browser.newContext({
+      viewport: { width: 1280, height: 800 },
+      deviceScaleFactor: 1,
+      colorScheme: scheme,
+    });
+    const page = await ctx.newPage();
+    await page.emulateMedia({ reducedMotion: "reduce" });
+    await page.goto("/" + BOARD9);
+    await page.waitForSelector("svg.hand-drawn-grid", { timeout: 60000 });
+    await page.evaluate(() => document.fonts.ready);
+    const empty = await page.evaluate(() =>
+      Array.from(document.querySelectorAll(".game-cell input")).map(
+        (i) => !/given/i.test(i.getAttribute("aria-label") ?? "") && !(i as HTMLInputElement).value,
+      ),
+    );
+    const pick = [40, 30, 50, 21].find((i) => empty[i]);
+    expect(pick, "an empty cell to select").not.toBeUndefined();
+    await page.locator(".game-cell").nth(pick!).click();
+    await page.waitForTimeout(400);
+    const peers = await page.evaluate(() =>
+      Array.from(document.querySelectorAll(".game-cell")).map((c) => !!c.querySelector(".cell-peer")),
+    );
+    const r0 = Math.floor(pick! / 9);
+    const peer = [...Array(81).keys()].find((i) => i !== pick && peers[i] && empty[i] && Math.floor(i / 9) === r0);
+    expect(peer, "an empty peer cell in the selected row").not.toBeUndefined();
+    const b = (await page.locator(".game-cell").nth(peer!).boundingBox())!;
+    const clip = {
+      x: Math.round(b.x + b.width * 0.3),
+      y: Math.round(b.y + b.height * 0.3),
+      width: Math.max(2, Math.round(b.width * 0.4)),
+      height: Math.max(2, Math.round(b.height * 0.4)),
+    };
+    const clean = await step(page, clip);
+    const planted: Record<string, number> = {};
+    for (const [k, css] of Object.entries(PLANTS)) {
+      const tag = await page.addStyleTag({ content: css });
+      await page.waitForTimeout(100);
+      planted[k] = await step(page, clip);
+      await tag.evaluate((e) => (e as Element).remove());
+    }
+    const computed = await page.evaluate(
+      (i) => getComputedStyle(document.querySelectorAll(".game-cell")[i].querySelector(".cell-peer")!).backgroundColor,
+      peer!,
+    );
+    console.log(
+      `WASH ${scheme}: cell ${pick} peer ${peer} step ${clean} (floor ${FLOOR[scheme]}) · W1 ${planted.W1} · W5 ${planted.W5} · computed ${computed}`,
+    );
+    await ctx.close();
+    expect.soft(clean, "the wash's painted step clears HEAD's").toBeGreaterThanOrEqual(FLOOR[scheme]);
+    for (const [k, v] of Object.entries(planted))
+      expect.soft(v, `plant ${k} must read under the floor (the row can fail)`).toBeLessThan(FLOOR[scheme]);
+  });
+}
