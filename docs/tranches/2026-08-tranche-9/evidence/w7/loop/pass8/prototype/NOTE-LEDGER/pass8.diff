+const valueAt = (js, i) => {
+  let d = 0,
+    q = null,
+    o = "";
+  for (; i < js.length; i++) {
+    const c = js[i];
+    if (q) {
+      o += c;
+      if (c === "\\") {
+        o += js[++i] ?? "";
+        continue;
+      }
+      if (q === "`" && c === "$" && js[i + 1] === "{") {
+        d++;
+        o += js[++i];
+        continue;
+      }
+      if (c === q && d === 0) q = null;
+      else if (q === "`" && c === "}" && d > 0) d--;
+      continue;
+    }
+    if (c === '"' || c === "'" || c === "`") {
+      q = c;
+      o += c;
+      continue;
+    }
+    if ("([{".includes(c)) d++;
+    else if (")]}".includes(c)) {
+      if (d === 0) break;
+      d--;
+    } else if ((c === "," || c === "\n") && d === 0) break;
+    o += c;
+  }
+  return o.trim();
+};
+/** Every site that DECLARES the custom property `token`: CSS declarations in every block, `@property`
+ *  initial-values, Tailwind arbitrary properties `[ --tok:v ]`, `style="…"` attributes, quoted keys of
+ *  any object literal, `.style['--x'] =`, `setProperty` with a literal or a folded concatenation,
+ *  `cssText`/`setAttribute('style')`, CSS text inside a string, and a template literal whose static
+ *  head is a stem of the token (`stem: true`). A key that is an expression is `unresolved: true`,
+ *  never dropped. [{file, kind, ctx, prelude, value, important, line}] */
+export function tokenSites(fe, token, { files, read, exists, extra = [] } = {}) {
+  const out = [];
+  if (!on("tok-sites")) return out;
