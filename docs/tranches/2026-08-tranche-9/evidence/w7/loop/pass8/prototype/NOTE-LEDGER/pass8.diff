+/** A `${}` template name's spelling as {head, tail} (VERB X15b: the tail after the placeholder is
+ *  part of the name — `--verb-${k}-bogus` is not declared by `--verb-a`). */
+const stemParts = (name) => {
+  const i = name.indexOf("${");
+  const j = name.indexOf("}", i);
+  return {
+    head: name.slice(0, i),
+    tail: on("stem-all") ? name.slice(j + 1).replace(/\$\{[^}]*\}.*$/, "") : "",
+  };
+};
+/** Every declared name a stem template can spell (head … tail), in `names`. */
+export function stemMatches(name, names) {
+  const { head, tail } = stemParts(name);
+  return [...names].filter(
+    (k) =>
+      k.startsWith(head) &&
+      k.endsWith(tail) &&
+      k.length > head.length + tail.length - (on("stem-all") ? 0 : 1),
+  );
+}
+/** Resolve var() with fallbacks against a token map; `var(--stem-${x})` → every token the whole
+ *  template spells (`{a|b}`), its fallback when none, else left as written (unresolved). */
+export function resolve(value, map, depth = 0) {
+  if (depth > 8) return value;
+  return value.replace(
+    /var\(\s*(--[\w-]*(?:\$\{[^}]*\}[\w-]*)*)\s*(?:,\s*((?:[^()]|\([^()]*\))*))?\)/gi,
+    (m, name, fb) => {
+      if (name.includes("${")) {
+        const hits = stemMatches(name, map.keys());
+        return hits.length
+          ? `{${hits.map((k) => resolve(map.get(k), map, depth + 1)).join("|")}}`
+          : fb != null
+            ? resolve(fb, map, depth + 1)
+            : m;
+      }
+      if (map.has(name)) return resolve(map.get(name), map, depth + 1);
+      return fb != null ? resolve(fb.trim(), map, depth + 1) : m;
+    },
+  );
+}
+/** Every var() reference in a value: [{name, fallback, stem, matches, unresolved}] — a stem is
+ *  UNRESOLVED unless `values` names its value set (VERB X15: "declared because some name carries
+ *  the stem" is not the law; the template is every stem it can spell). */
+export function varRefs(value, names = [], { values } = {}) {
+  const out = [];
