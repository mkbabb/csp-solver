+// postpaint.mjs — THE post-paint sampler and THE painted-frame recorder (T9-W7; registry-v6 §2.5,
+// LAWS P6 §D; registry-v7 §2.4 PRODUCT HOME). ONE copy: every first-frame, drift, interval, rate or
+// held-frame row reads this file (the pass-7 `painted-frames.mjs` recorder is folded in below, with
+// MOT-VERB's two PROPOSED extensions).
+//
+// I. THE SAMPLER (`installSampler`, `analyse`). A sampler registered before the product's rAF reads
+// PRE-CALLBACK state (MOT-VERB's GA1 passed 8/8 while frame 1 painted 142.9 px off). Each frame is read
+// three ways, side by side:
+//   inRAF  — in our own rAF callback (the NEGATIVE arm, printed, never gated)
+//   post   — a task queued from that rAF (MessageChannel): THE GATED READ
+//   rAF2   — rAF(() => rAF(read)): the start of frame k+1 (printed so a row that uses it knows what it reads)
+// FRAME 1 is keyed on the mover's first IntersectionObserver entry (MOT-VERB pass 7, PROPOSED → landed
+// here): the post read is a TASK, and a task the page queued earlier (a timeout that starts the mover)
+// can run between a frame's paint and that read — the read then sees a mover the frame never painted.
+// The observer is attached on the subject's first `animate()`; its entry time falls inside the first
+// rendering update the mover exists in, so frame 1 = the last rAF stamped before it, and the reads before
+// frame 1 are DROPPED and counted. A mover that never calls `animate()` (a CSS animation) is keyed on its
+// first read, and the row says so (`io: none`). The gated clauses, post-paint, BOTH engines:
+//   F1  frame 1: |centre − rest| ≤ 3 px AND |w − rest.w| ≤ 3 px
+//   CI  the clock identity for k = 2, 3: ct(frame k) = tl(k) − tl(frame 1) ± 2 ms (the FRAME clock binds,
+//       pass8/CHAIR-RULINGS §2.7d; WebKit is gated too — VERB's IO-keyed reader read CI 0 in 40/40)
+// Plants: SKIP_PLANT (every explicit startTime write lands 150 ms early → F1 reds), F2_PLANT(sel) (the
+// pass-7 critic's: frame 1 at rest, then on the SECOND rAF after the subject's animate() its clock jumps
+// 150 ms → CI reds while F1 stays green).
+//
+// II. THE RECORDER (`installTimeline`, `startPhotos`, `record`, `ladder`). Three tracks on ONE epoch clock:
+//   T  the painted TIMELINE (both engines): each rendering update's rAF stamp + a POST-PAINT read of the
+//      subject (a held frame is a rAF gap). A subject is a selector (its rect + animation currentTime),
+//      `css:<sel>:<prop>` (a computed paint property), or `ruled:<sel>` (MOT-VERB PROPOSED → landed: the
+//      RULED SUM over every match — each line's drawn fraction from its inline dash, 1 − offset/dasharray,
+//      `none` = drawn, summed: a motion spread over many elements, one after another, is one subject)
+//   P  PHOTOGRAPHS: chromium = CDP screencast (every compositor frame); webkit = page.screencast (throttled
+//      ~20/s — a coarse witness, never the frame clock). Per photograph: the mean |Δ| of the ROI against
+//      the previous one; a change is mean |Δ| > `eps` (MOT-VERB PROPOSED → landed: `--eps`, default 0.35;
+//      at 0.35 a thin stroke advancing a few px per frame over a 640 px ROI (≈ 0.005) never counts, so a
+//      slow continuous stroke reads EMPTY)
+//   L  the rAF-FROZEN LADDER: replay K times, pause every animation in rAF k after the trigger, photograph.
+// A painted clause counts only when the engine's self-test clock ≥ 55/s (chromium photographs, webkit rAF).
+//
+//   node e2e/lib/postpaint.mjs --self-test [--engine chromium|webkit]
+//   node e2e/lib/postpaint.mjs --url <u> --sel <mover> [--key g | --click <sel>] [--ready <sel>]
+//        [--plant skip|f2] [--cells desk,phone] [--reps 2] [--scheme dark]
+//   node e2e/lib/postpaint.mjs --recorder --url <u> [--trigger key:<k>|click:<sel>|load] [--roi <sel>]
+//        [--subject <sel>|css:<sel>:<prop>|ruled:<sel>] [--eps 0.35] [--window 1200]
+//        [--plant busy:<ms>@<delay>] [--held 50] [--runs 1] [--ladder K] [--out <json>] [--selftest-only]
+// Exit (sampler): 0 GREEN · 1 RED · 3 a plant GREEN (a hole) · 4 both. Exit (recorder): 0 GREEN ·
+// 1 RED (a held interval ≥ --held, or an EMPTY motion window) · 2 the self-test clock < 55.
+import process from "node:process";
+import fs from "node:fs";
+import crypto from "node:crypto";
+import { Buffer } from "node:buffer";
+import { fileURLToPath } from "node:url";
+import { resolve as resolvePath } from "node:path";
+import { playwright, args, load as loadStr, openCell } from "./paint-lib.mjs";
+
+// ------------------------------------------------------------------------------------ I. sampler
+/** Page-side. `sel` = the subject; the animation = its first WAAPI animation that is neither a CSS
+ *  transition nor a CSS animation (the product's scripted motion), or any when `anyAnim`. */
+export function installSampler({ sel, anyAnim = false, maxFrames = 240, io = true }) {
+  const w = window;
+  w.__pp = { inRAF: [], post: [], rAF2: [], stamps: [], io: null, done: false };
+  if (io) {
+    const animate = Element.prototype.animate;
+    Element.prototype.animate = function (...a) {
+      const anim = animate.apply(this, a);
+      if (w.__pp.io === null && this.matches?.(sel)) {
+        w.__pp.io = -1;
+        const ob = new IntersectionObserver((es) => {
+          w.__pp.io = es[0].time;
+          ob.disconnect();
+        });
+        ob.observe(this);
+      }
+      return anim;
+    };
+  }
+  const read = (k, tl) => {
+    const b = document.querySelector(sel);
+    if (!b) return null;
+    const a = b.getAnimations().find((x) => anyAnim || (!(x instanceof CSSTransition) && !(x instanceof CSSAnimation))) ?? null;
+    const r = b.getBoundingClientRect();
+    return { k, tl, ct: a ? Number(a.currentTime ?? 0) : null, ps: a ? a.playState : null, x: r.left + r.width / 2, y: r.top + r.height / 2, w: r.width };
+  };
+  const mc = new MessageChannel();
+  const q = [];
+  mc.port1.onmessage = () => q.shift()?.();
+  let i = 0,
+    seen = false;
+  const tick = (ts) => {
+    const k = i++;
+    // the FRAME's time (the rAF argument), not performance.now() inside the callback: WebKit stamps an
+    // IntersectionObserver entry with the rendering update's own time, which precedes any in-callback
+    // clock, so a mover started in the sampler's first frame keyed to frame −1 (pass 8, WebKit r1)
+    w.__pp.stamps[k] = ts;
+    const tl = Number(document.timeline.currentTime ?? 0);
+    const s = read(k, tl);
+    if (s) w.__pp.inRAF.push(s);
+    q.push(() => {
+      const p = read(k, tl);
+      if (p) w.__pp.post.push(p);
+    });
+    mc.port2.postMessage(0);
+    requestAnimationFrame(() =>
+      requestAnimationFrame(() => {
+        const p = read(k, tl);
+        if (p) w.__pp.rAF2.push(p);
+      }),
+    );
+    const live = s?.ct != null;
+    seen ||= live;
+    if ((seen && !live) || i >= maxFrames) setTimeout(() => (w.__pp.done = true), 200);
+    else requestAnimationFrame(tick);
+  };
+  requestAnimationFrame(tick);
+}
+
+/** The frame that first painted the mover: the last frame whose rAF time is at or before the entry. */
+export const kPaintOf = (pp) => (pp.io == null || pp.io < 0 ? -1 : pp.stamps.reduce((k, r, i) => (r <= pp.io ? i : k), -1));
+
+/** Frames with the animation present, keyed on `kPaint` (reads before it DROPPED); F1 + CI verdicts. */
+export function analyse(frames, rest, { kPaint = -1, tolPx = 3, tolMs = 2, ks = [2, 3] } = {}) {
+  const all = frames.filter((x) => x.ct !== null).sort((a, b) => a.k - b.k);
+  const f = kPaint >= 0 ? all.filter((x) => x.k >= kPaint) : all;
+  const dropped = all.length - f.length;
+  if (!f.length) return { red: true, f1red: true, ciRed: false, why: ["EMPTY: the subject never animated"], f1: null, ci: [], dropped };
+  const c = (s) => Math.hypot(s.x - rest.x, s.y - rest.y),
+    dw = (s) => s.w - rest.w;
+  const why = [];
+  const f1red = c(f[0]) > tolPx || Math.abs(dw(f[0])) > tolPx;
+  if (f1red) why.push(`F1 frame 1 at ct ${f[0].ct.toFixed(1)}: centre ${c(f[0]).toFixed(2)} px, dw ${dw(f[0]).toFixed(2)} px (> ${tolPx})`);
+  const ci = [];
+  let ciRed = false;
+  for (const k of ks) {
+    const fk = f[k - 1];
+    if (!fk) {
+      why.push(`CI frame ${k} missing`);
+      ciRed = true;
+      continue;
+    }
+    const want = fk.tl - f[0].tl;
+    const off = fk.ct - want; // the law: ct(frame k) = tl(k) − tl(frame 1), frame 1 at ct 0
+    ci.push({ k, ct: +fk.ct.toFixed(1), tlDelta: +want.toFixed(1), off: +off.toFixed(1) });
+    if (Math.abs(off) > tolMs) {
+      why.push(`CI ct(frame ${k}) ${fk.ct.toFixed(1)} vs tl(${k})−tl(1) ${want.toFixed(1)} (off ${off.toFixed(1)} ms > ${tolMs})`);
+      ciRed = true;
+    }
+  }
+  return { red: why.length > 0, f1red, ciRed, why, f1: { k: f[0].k, ct: +f[0].ct.toFixed(1), c: +c(f[0]).toFixed(2), dw: +dw(f[0]).toFixed(2), ps: f[0].ps }, ci, frames: f.length, dropped };
+}
+
+/** Init-script plants. SKIP: every explicit startTime write lands 150 ms early. */
+export const SKIP_PLANT = () => {
+  const d = Object.getOwnPropertyDescriptor(Animation.prototype, "startTime");
+  Object.defineProperty(Animation.prototype, "startTime", {
+    get() {
+      return d.get.call(this);
+    },
+    set(v) {
+      d.set.call(this, typeof v === "number" ? v - 150 : v);
+    },
+    configurable: true,
+  });
+};
+/** F2 (the pass-7 critic's): frame 1 left at its pose; on the SECOND rAF after the subject's animate()
+ *  its clock jumps 150 ms, so frame 2 paints 150 ms in. `sel` = the subject. */
+export const F2_PLANT = (sel) => {
+  const animate = Element.prototype.animate;
+  let armed = false;
+  Element.prototype.animate = function (...a) {
+    const anim = animate.apply(this, a);
+    if (!armed && this.matches?.(sel)) {
+      armed = true;
+      requestAnimationFrame(() =>
+        requestAnimationFrame(() => {
+          anim.currentTime = Number(anim.currentTime ?? 0) + 150;
+        }),
+      );
+    }
+    return anim;
+  };
+};
+
+/** Read one mover: rest pose, install, trigger, wait, analyse the three arms (+ the un-keyed legacy). */
+export async function readMover(page, { sel, key = null, click = null, io = true }) {
+  const rest = await page.evaluate((sel) => {
+    const r = document.querySelector(sel).getBoundingClientRect();
+    return { x: r.left + r.width / 2, y: r.top + r.height / 2, w: r.width };
+  }, sel);
+  await page.evaluate(installSampler, { sel, io });
+  if (key) await page.keyboard.press(key);
+  if (click) await page.locator(click).first().click();
+  await page.waitForFunction(() => window.__pp.done, null, { timeout: 20000 });
+  const pp = await page.evaluate(() => window.__pp);
+  const kPaint = kPaintOf(pp);
+  return {
+    kPaint,
+    io: pp.io == null ? "none" : pp.io < 0 ? "pending" : +pp.io.toFixed(1),
+    post: analyse(pp.post, rest, { kPaint }),
+    legacy: analyse(pp.post, rest),
+    inRAF: analyse(pp.inRAF, rest, { kPaint }),
+    rAF2: analyse(pp.rAF2, rest, { kPaint }),
+  };
+}
+export const fmtArm = (r) =>
+  r.f1
+    ? `F1 k${r.f1.k} ct ${r.f1.ct} c ${r.f1.c} dw ${r.f1.dw} ${r.f1red ? "RED" : "GREEN"} | CI ${r.ci.map((x) => `k${x.k} ct ${x.ct}/tlΔ ${x.tlDelta} off ${x.off}`).join(" ; ")} ${r.ciRed ? "RED" : "GREEN"} | dropped ${r.dropped}`
+    : `→ RED ${r.why.join("; ")}`;
+
+/** Synthetic movers (no product surface). The page runs its own rAF loop from load (so its callbacks
+ *  run before the sampler's). Key `r`: the mover starts INSIDE a rAF with startTime = that frame's time
+ *  (frame 1 paints at rest). Key `t`: it starts in a TASK posted from the page's rAF (startTime = the
+ *  last frame's time), so its first painted frame is one frame in (6 px per ms: a 2 ms WebKit frame gap is 12 px) while the task ran before
+ *  the sampler's post read of the previous frame: the un-keyed reader takes that unpainted read as frame 1. */
+const MOVER = `<!doctype html><html><head><style>
+  body { margin: 0; background: #fbf8f1; }
+  #mv { position: absolute; left: 40px; top: 80px; width: 60px; height: 60px; background: #3b3833; }
+</style></head><body><div id="mv"></div><script>
+  let arm = null;
+  const mc = new MessageChannel();
+  const go = () => {
+    const a = document.getElementById("mv").animate([{ transform: "translateX(0)" }, { transform: "translateX(1200px)" }], { duration: 200, easing: "linear" });
+    a.startTime = document.timeline.currentTime;
+  };
+  mc.port1.onmessage = go;
+  const loop = () => {
+    if (arm === "r") go();
+    if (arm === "t") mc.port2.postMessage(0);
+    arm = null;
+    requestAnimationFrame(loop);
+  };
+  requestAnimationFrame(loop);
+  addEventListener("keydown", (e) => { if (e.key === "r" || e.key === "t") arm = e.key; });
+</script></body></html>`;
+
+export async function samplerSelfTest(browser) {
+  const rows = [];
+  let hole = false,
+    cleanRed = false;
+  const run = async (key, plant) => {
+    const { ctx, page } = await openCell(browser, { width: 800, height: 300, reducedMotion: "no-preference" });
+    await page.setContent(MOVER);
+    // setContent commits no navigation, so an init script would never run: the plant is evaluated in
+    // the page before the trigger (a product row installs it with addInitScript before goto)
+    if (plant === "skip") await page.evaluate(SKIP_PLANT);
+    if (plant === "f2") await page.evaluate(F2_PLANT, "#mv");
+    await page.waitForTimeout(200);
+    const r = await readMover(page, { sel: "#mv", key });
+    await ctx.close();
+    return r;
+  };
+  for (let rep = 1; rep <= 2; rep++) {
+    const clean = await run("r", null);
+    if (clean.post.red) cleanRed = true;
+    rows.push(`POSTPAINT self-test r${rep} RAF-mover CLEAN io ${clean.io} kPaint ${clean.kPaint} | POST ${fmtArm(clean.post)} | inRAF ${fmtArm(clean.inRAF)} → ${clean.post.red ? "RED " + clean.post.why.join("; ") : "GREEN"}`);
+    for (const [plant, want] of [
+      ["skip", "f1red"],
+      ["f2", "ciRed"],
+    ]) {
+      const r = await run("r", plant);
+      if (!r.post[want]) hole = true;
+      rows.push(`POSTPAINT self-test r${rep} RAF-mover PLANT ${plant} | POST ${fmtArm(r.post)} → ${r.post[want] ? "RED (" + want + ")" : "GREEN ← a hole"}`);
+    }
+    // born-RED: the task-started mover's first painted frame is a frame in; the keyed reader must red it
+    const t = await run("t", null);
+    if (!t.post.f1red) hole = true;
+    rows.push(`POSTPAINT self-test r${rep} TASK-mover BORN-RED io ${t.io} kPaint ${t.kPaint} | POST (keyed) ${fmtArm(t.post)} → ${t.post.f1red ? "RED" : "GREEN ← a hole"} | LEGACY (un-keyed) ${fmtArm(t.legacy)} → ${t.legacy.f1red ? "RED (not contaminated this run)" : "GREEN ← the pass-7 hole: frame 1 was a read the frame never painted"}`);
+  }
+  return { rows, exit: cleanRed ? (hole ? 4 : 1) : hole ? 3 : 0 };
+}
+
+// ----------------------------------------------------------------------------------- II. recorder
+export const loadArr = () => loadStr().split(" ").map(Number);
+
+/** Page-side: the painted timeline. `sel` (optional) is read post-paint each frame. */
+export function installTimeline(sel) {
+  const w = window;
+  const read = () => {
+    if (!sel) return null;
+    if (sel.startsWith("ruled:")) {
+      const els = [...document.querySelectorAll(sel.slice(6))];
+      if (!els.length) return null;
+      let s = 0;
+      for (const e of els) {
+        const d = e.style.strokeDasharray,
+          o = parseFloat(e.style.strokeDashoffset);
+        if (d === "none") s += 1;
+        else if (d) s += Math.max(0, Math.min(1, 1 - (isNaN(o) ? 0 : o) / parseFloat(d)));
+      }
+      return { x: +s.toFixed(4), y: 0, w: 0, h: 0, ct: null };
+    }
+    if (sel.startsWith("css:")) {
+      const i = sel.lastIndexOf(":");
+      const el = document.querySelector(sel.slice(4, i));
+      return el ? { x: getComputedStyle(el).getPropertyValue(sel.slice(i + 1)), y: 0, w: 0, h: 0, ct: null } : null;
+    }
+    const el = document.querySelector(sel);
+    if (!el) return null;
+    const r = el.getBoundingClientRect();
+    const a = el.getAnimations?.().find((x) => x.playState === "running" || x.playState === "paused");
+    return { x: +r.left.toFixed(2), y: +r.top.toFixed(2), w: +r.width.toFixed(2), h: +r.height.toFixed(2), ct: a ? Number(a.currentTime ?? NaN) : null };
+  };
+  w.__pf = { rafs: [], post: [], on: true, origin: performance.timeOrigin };
+  const tick = (ts) => {
+    if (!w.__pf.on) return;
+    const k = w.__pf.rafs.length;
+    w.__pf.rafs.push({ k, ts });
+    setTimeout(() => w.__pf.post.push({ k, t: performance.now(), r: read() }), 0);
+    requestAnimationFrame(tick);
+  };
+  requestAnimationFrame(tick);
+}
+
+/** Per-photograph mean |Δ| of the ROI's grey (0.2126 R + 0.7152 G + 0.0722 B on the encoded values)
+ *  against the previous photograph, decoded IN A PAGE of the recording's own browser (createImageBitmap
+ *  → OffscreenCanvas): no image package (the pass-7 copy leaned on `sharp`, which this package does not
+ *  declare). A photograph that fails to decode is skipped as the previous one's ground, never read as 0. */
+async function photoDeltas(browser, frames, roi) {
+  const ctx = await browser.newContext();
+  const page = await ctx.newPage();
+  await page.evaluate(() => (window.__prev = null));
+  const out = [];
+  for (let i = 0; i < frames.length; i += 12) {
+    const batch = frames.slice(i, i + 12).map((f) => f.buf.toString("base64"));
+    const ds = await page.evaluate(
+      async ({ batch, roi }) => {
+        const res = [];
+        for (const b64 of batch) {
+          let g;
+          try {
+            const bin = Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
+            const bmp = await createImageBitmap(new Blob([bin]));
+            const r = roi ?? { left: 0, top: 0, width: bmp.width, height: bmp.height };
+            const w = Math.max(1, Math.min(r.width, bmp.width - r.left)),
+              h = Math.max(1, Math.min(r.height, bmp.height - r.top));
+            const c = new OffscreenCanvas(w, h).getContext("2d");
+            c.drawImage(bmp, -r.left, -r.top);
+            const d = c.getImageData(0, 0, w, h).data;
+            g = new Float32Array(w * h);
+            for (let j = 0, k = 0; j < d.length; j += 4, k++) g[k] = 0.2126 * d[j] + 0.7152 * d[j + 1] + 0.0722 * d[j + 2];
+          } catch {
+            g = null;
+          }
+          const p = window.__prev;
+          let m = null;
+          if (p && g) {
+            if (p.length !== g.length) m = Infinity;
+            else {
+              let t = 0;
+              for (let k = 0; k < g.length; k++) t += Math.abs(p[k] - g[k]);
+              m = t / g.length;
+            }
+          }
+          res.push(m);
+          if (g) window.__prev = g;
+        }
+        return res;
+      },
+      { batch, roi },
+    );
+    out.push(...ds);
+  }
+  await ctx.close();
+  return out;
+}
+
+/** Start the photograph track. Returns stop() → [{t (epoch ms), buf}]. */
+export async function startPhotos(page, engine, size) {
+  const frames = [];
+  if (engine === "chromium") {
+    const cdp = await page.context().newCDPSession(page);
+    cdp.on("Page.screencastFrame", async (f) => {
+      frames.push({ t: f.metadata.timestamp * 1000, buf: Buffer.from(f.data, "base64") });
+      try {
+        await cdp.send("Page.screencastFrameAck", { sessionId: f.sessionId });
+      } catch {
