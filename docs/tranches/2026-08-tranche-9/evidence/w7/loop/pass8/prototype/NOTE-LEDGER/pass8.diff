+ *  are declaration SITES too. */
+export function tokens(fe, { files, read, exists, extra = [] } = {}) {
+  const map = new Map(),
+    all = [];
+  const rd = read ?? ((f) => readFileSync(f, "utf8"));
+  const list = files
+    ? followImports([...files, ...extra], { read: rd, exists })
+    : [...sources(fe, { read: rd, exists }), ...extra];
+  for (const f of list) {
+    const text = rd(f);
+    const file = relative(fe, f);
+    for (const r of rulesOf(f, text, fe)) {
+      const reg = /^@property\s+(--[\w-]+)/.exec(r.prelude);
+      for (const d of r.decls) {
+        if (d.prop.startsWith("--")) {
+          map.set(d.prop, d.value);
+          all.push({ file, prelude: r.as ?? r.prelude, ctx: r.ctx.join(" "), ...d });
+        } else if (reg && d.prop === "initial-value" && on("at-property-site")) {
+          all.push({
+            file,
+            prelude: r.prelude,
+            ctx: r.ctx.join(" "),
+            ...d,
+            prop: reg[1],
+            kind: "at-property",
+          });
+          if (!map.has(reg[1])) map.set(reg[1], d.value);
