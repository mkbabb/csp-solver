+    /var\(\s*(--[\w-]*(?:\$\{[^}]*\}[\w-]*)*)\s*(?:,\s*((?:[^()]|\([^()]*\))*))?\)/gi,
+  )) {
+    const name = m[1];
+    if (!name.includes("${")) {
+      out.push({
+        name,
+        fallback: m[2] ?? null,
+        stem: false,
+        matches: [name],
+        unresolved: false,
+      });
+      continue;
+    }
+    const { head, tail } = stemParts(name);
+    const spelled = values ? values.map((v) => head + v + tail) : null;
+    const matches = spelled ?? stemMatches(name, names);
+    out.push({
+      name,
+      fallback: m[2] ?? null,
+      stem: true,
+      matches,
+      unresolved: on("stem-all") ? !values : matches.length === 0,
+    });
+  }
+  return out;
+}
+/** LIVE (X7–X9): every `var(--x, fallback)` a text carries — matched CASE-INSENSITIVELY (`VAR(`),
+ *  with string concatenation folded first (`"var(--motion-note" + ", 280ms)"`) and `${}` stems
+ *  expanded against the registered names ([{name, fallback, stem, at}]; an unmatched stem is kept
+ *  with `unresolved: true`). */
+export function maskedDefaults(text, registered = []) {
+  let t = String(text);
+  if (on("masked"))
+    for (let k = 0; k < 4; k++)
+      t = t.replace(
+        /(["'`])((?:\\.|(?!\1)[^\\$])*)\1\s*\+\s*(["'`])((?:\\.|(?!\3)[^\\$])*)\3/g,
+        (m, q1, a, q2, b) => `"${a}${b}"`,
+      );
+  const re = on("masked")
+    ? /var\(\s*(--[\w-]*(?:\$\{[^}]*\}[\w-]*)*)\s*,\s*((?:[^()]|\([^()]*\))*)\)/gi
+    : /var\(\s*(--[\w-]+)\s*,\s*((?:[^()]|\([^()]*\))*)\)/g;
+  const out = [];
+  for (const m of t.matchAll(re)) {
+    if (m[1].includes("${")) {
+      const hits = stemMatches(m[1], registered);
+      if (hits.length)
+        for (const h of hits)
+          out.push({ name: h, fallback: m[2].trim(), stem: m[1], at: m.index });
+      else
+        out.push({
+          name: m[1],
+          fallback: m[2].trim(),
+          stem: m[1],
+          at: m.index,
+          unresolved: true,
+        });
+    } else out.push({ name: m[1], fallback: m[2].trim(), stem: null, at: m.index });
+  }
