+// edge-bands.d.mts — the TYPE of the ONE four-band edge probe (`./edge-bands.mjs`), so a TypeScript
+// spec can import it under `typecheck:e2e` (strict, no `allowJs`: a bare `.mjs` import is TS7016).
+// No behaviour lives here. The three exports `player-mark.spec.ts` calls are typed; every other
+// export is declared `unknown` until a spec that calls it types it.
+// NOT-A-LANE: a declaration of the chair's home (T9-W7 pass 8, PLR-SELF's four-band row).
+import type { Page } from "@playwright/test";
+
+export interface Band {
+  stations: number;
+  coreMedian: number;
+  thickness: number;
+  dropped: number;
+  fracUnder: number;
+}
+export interface BandsRead {
+  red: boolean;
+  why: string[];
+  bands: Record<"top" | "right" | "bottom" | "left", Band> | null;
+  edgeCount: number;
+  noop?: boolean;
+  info?: boolean;
+}
+/** A plant is a CSS string, or `{ fade }`: every painted colour of the edge re-set at that alpha. */
+export type EdgePlant = string | { fade: number };
+
+export function EDGE_PLANTS(edge: string): Record<string, EdgePlant>;
+export function edgeGate(
+  page: Page,
+  opts: { subject: string; edge: string; plants?: Record<string, EdgePlant> | null; [k: string]: unknown },
+): Promise<{ clean: BandsRead; plants: Record<string, BandsRead> }>;
+export function fmt(r: BandsRead): string;
+
+export const EDGE_CLAUSES: unknown;
+export const fourBands: unknown;
+export const INK_PLANTS: unknown;
+export const applyEdgePlant: unknown;
+export const selfTest: unknown;
