+/** Run the self-test against library namespace `L` (this file, or `--lib <seed>` for the born-RED
+ *  comparison). → {rows: [{clause, family, name, ok, err}], fails} */
+export function selfTest(L) {
+  const rows = [];
+  const run = (clause, family, name, fn) => {
+    let ok = false,
+      err = null;
+    try {
+      ok = fn(L) === true;
+    } catch (e) {
+      err = String(e?.message ?? e)
+        .split("\n")[0]
+        .slice(0, 120);
+    }
+    rows.push({ clause, family, name, ok, err });
+  };
+  for (const [clause, family, name, fn] of TESTS) run(clause, family, name, fn);
+  for (const [name, family, over, expectRed] of RESERVE_PLANTS)
+    run(null, family, `reserve · ${name} → ${expectRed ? "RED" : "GREEN"}`, (Lx) => {
+      const fails = reserveReading(Lx, plantedFixture(over));
+      return expectRed ? fails.length > 0 : fails.length === 0;
+    });
+  return { rows, fails: rows.filter((r) => !r.ok).length };
+}
+/** The same reserve reading over a REAL tree (`--tree <web/frontend>`): the tree's own MarginNote,
+ *  then each RESERVE_PLANT's rule overlay injected in memory where its anchor exists. The anchor is
+ *  the union's `1lh` seat: a tree without it reads NO ANCHOR (exit 2), never green. */
+export function treeReading(fe) {
+  const file = join(fe, "src/pencil/chrome/MarginNote.vue");
+  if (!existsSync(file)) return { anchor: false, rows: [] };
+  const base = readFileSync(file, "utf8");
+  const anchor =
+    /min-height:\s*1lh;/.test(base) &&
+    /@media \(max-width: 1023\.98px\) \{[\s\S]*?\.margin-note \{\s*min-height: inherit;/.test(
+      base,
+    );
+  const files = sources(fe);
+  const mk = (over) => {
+    const extra = Object.keys(over.files ?? {}).map((k) => join(fe, k));
+    let text = base;
+    if (over.seat && over.seat !== "inherit")
+      text = text.replace(
+        /(@media \(max-width: 1023\.98px\) \{[\s\S]*?\.margin-note \{\s*)min-height: inherit;/,
+        `$1min-height: ${over.seat};`,
+      );
+    if (over.inner)
+      text = text.replace(/(@media \(max-width: 1023\.98px\) \{\n)/, `$1${over.inner}`);
+    if (over.land)
+      text = text.replace(
+        /(@media \(max-width: 1023\.98px\) and \(orientation: landscape\) \{\n)/,
+        `$1${over.land}`,
+      );
+    if (over.tail || over.base)
+      text = text.replace(
+        /<\/style>(?![\s\S]*<\/style>)/,
+        `${over.base ?? ""}${over.tail ?? ""}</style>`,
+      );
+    if (over.extraBlock) text += over.extraBlock;
+    if (over.attr)
+      text = text.replace(
+        /(<p\s+ref="liveEl"\s+class="margin-note")/,
+        `$1${over.attr}`,
+      );
+    if (over.script)
+      text = text.replace(
+        /<script setup lang="ts">\n/,
+        `<script setup lang="ts">\n${over.script}`,
+      );
+    const seatBlock =
+      /@media \(max-width: 1023\.98px\) \{(?=[\s\S]*?\.margin-note \{\s*min-height: inherit;)/;
+    if (over._swap && /^M2/.test(over._name))
+      text = text.replace(seatBlock, "@media not all and (max-width: 1023.98px) {");
+    if (over._swap && /^M8/.test(over._name))
+      text = text.replace(
+        seatBlock,
+        "@media (min-width: 2000px) and (max-width: 1023.98px) {",
+      );
+    if (over._swap && /^M3/.test(over._name))
+      text = text.replace(
+        /(@media \(max-width: 1023\.98px\) \{[\s\S]*?\.margin-note \{\s*)min-height: inherit;/,
+        "$1",
+      );
+    const css = join(fe, "src/assets/index.css");
+    const ov = new Map([
+      [file, text],
+      ...Object.entries(over.files ?? {}).map(([k, v]) => [join(fe, k), v]),
+    ]);
+    if (over.css) ov.set(css, readFileSync(css, "utf8") + over.css);
+    return {
+      fe,
+      files: [...files, ...extra.filter((e) => !files.includes(e))],
+      read: (f) => (ov.has(f) ? ov.get(f) : readFileSync(f, "utf8")),
+      exists: (f) => ov.has(f) || existsSync(f),
+      moved: text !== base || extra.length > 0 || !!over.css,
+    };
+  };
+  const rows = [];
+  for (const [name, family, over, expectRed] of RESERVE_PLANTS) {
+    const fx = mk({ ...over, _name: name });
+    if (name.startsWith("clean") || name.startsWith("NN") || fx.moved) {
+      const fails = reserveReading(LIB, { ...fx }, "src/pencil/chrome/MarginNote.vue");
+      rows.push({
+        name,
+        family,
+        expectRed,
+        red: fails.length > 0,
+        ok: expectRed ? fails.length > 0 : fails.length === 0,
+        why: fails.slice(0, 2).join(" / "),
+      });
+    } else
+      rows.push({
+        name,
+        family,
+        expectRed,
+        red: null,
+        ok: false,
+        why: "PLANT DID NOT MOVE THE SOURCE (anchor absent)",
+      });
+  }
+  return { anchor, rows };
+}
+const LIB = {
+  CLAUSES,
+  sabotage,
+  walk,
+  sources,
+  followImports,
+  isCss,
+  stripCss,
+  stripJs,
+  stripHtml,
+  decodeEntities,
+  decodeCssEscapes,
+  sfc,
+  cssRules,
+  decls,
+  splitTop,
+  subjectCompound,
+  compoundClasses,
+  subjectHas,
+  sets,
+  constBindings,
+  foldConcat,
+  TAILWIND,
+  TAILWIND_ALL,
+  candidates,
+  attrsOf,
+  templateSites,
+  consumerSites,
+  hasCompound,
+  scriptWrites,
+  scriptCss,
+  cssBlocks,
+  rulesOf,
+  census,
+  tokens,
+  tokenConflicts,
+  stemMatches,
+  resolve,
+  varRefs,
+  maskedDefaults,
+  tokenSites,
+  propertyRegistrations,
+  clockReads,
+  urlRefs,
+  svgRefSites,
+  componentSites,
+  pinsBreached,
+  templateElements,
+  mayMatch,
+  elementSites,
+  classWrites,
+  REGIMES,
+  evalMedia,
+  regimesOf,
+  lengthPx,
+  effectiveAt,
+  htmlLinks,
+  exactlyOneLink,
+  parseColor,
+  srgbToOklab,
+  deltaE,
+  colorLiterals,
+  chromaOf,
+  darkArmCensus,
+};
+
+// ========================================================================================= CLI
+//   node scripts/shape-census.mjs --self-test            every plant (exit 0 = all read as the law)
+//   node scripts/shape-census.mjs --sabotage-battery     each clause off in turn: the self-test must RED
+//   node scripts/shape-census.mjs --self-test --lib <seed.mjs>   the same plants on a SEED library
+//                                                        (the born-RED: what the seed cannot see)
+//   node scripts/shape-census.mjs --tree <web/frontend>  the reserve reading + its plants on a real tree
+if (
+  process.argv[1] &&
+  fileURLToPath(import.meta.url) === resolvePath(process.argv[1])
+) {
+  const argv = process.argv.slice(2);
+  const arg = (k) => (argv.includes(k) ? argv[argv.indexOf(k) + 1] : null);
+  let exit = 0;
+  if (argv.includes("--self-test")) {
+    const seed = arg("--lib");
+    const L = seed ? { ...(await import(resolvePath(seed))) } : LIB;
+    const { rows, fails } = selfTest(L);
+    for (const r of rows)
+      console.log(
+        `${r.ok ? "ok  " : "FAIL"} [${r.clause ?? "-"} · ${r.family}] ${r.name}${r.err ? `  (${r.err})` : ""}`,
+      );
+    const clauses = new Set(TESTS.map((t) => t[0]).filter(Boolean));
+    console.log(
+      `SELF-TEST ${seed ? `on the seed ${seed}` : "on this library"}: ${rows.length - fails}/${rows.length} read as the law · ${fails} fail · clauses planted ${clauses.size}/${Object.keys(CLAUSES).length}`,
+    );
+    if (fails) exit = 1;
+    if (!seed && [...Object.keys(CLAUSES)].some((c) => !clauses.has(c))) {
+      console.log(
+        `UNPLANTED CLAUSES: ${Object.keys(CLAUSES)
+          .filter((c) => !clauses.has(c))
+          .join(", ")}`,
+      );
+      exit = 1;
+    }
+  }
+  if (argv.includes("--sabotage-battery")) {
+    const bad = [];
+    for (const id of Object.keys(CLAUSES)) {
+      sabotage([id]);
+      const { rows, fails } = selfTest(LIB);
+      const hit = rows.filter((r) => !r.ok).map((r) => r.name);
+      console.log(
+        `SABOTAGE ${id.padEnd(18)} → ${fails ? `RED (${fails}: ${hit.slice(0, 2).join(" | ")}${hit.length > 2 ? " …" : ""})` : "GREEN — the clause has no plant"}`,
+      );
+      if (!fails) bad.push(id);
+    }
+    sabotage([]);
+    console.log(
+      `SABOTAGE BATTERY: ${Object.keys(CLAUSES).length - bad.length}/${Object.keys(CLAUSES).length} clauses red the self-test when deleted${bad.length ? ` · GREEN: ${bad.join(", ")}` : ""}`,
+    );
+    if (bad.length) exit = 1;
+  }
+  if (arg("--tree")) {
+    const fe = resolvePath(arg("--tree"));
+    const { anchor, rows } = treeReading(fe);
+    console.log(
+      `TREE ${fe} · anchor (the union's 1lh seat) ${anchor ? "PRESENT" : "ABSENT"}`,
+    );
+    for (const r of rows)
+      console.log(
+        `${r.ok ? "ok  " : "FAIL"} reserve · ${r.name}: ${r.red == null ? r.why : r.red ? `RED  ${r.why}` : "GREEN"}`,
+      );
+    if (!anchor) exit = exit || 2;
+    else if (rows.some((r) => !r.ok)) exit = 1;
+  }
+  process.exit(exit);
+}
