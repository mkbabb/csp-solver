+          new RegExp(
+            `\\b${alias.replace(/\$/g, "\\$")}\\(\\s*([A-Za-z_$][\\w$]*)\\s*(?:,\\s*\\{([^}]*)\\})?`,
+            "g",
+          ),
+        )) {
+          const comp = m[1];
+          if (!imports.has(comp)) continue;
+          const body = m[2] ?? "";
+          const keys = splitTop(body, /,/);
+          out.push({
+            file,
+            line: sc.line + lineAt(s, m.index) - 1,
+            tag: comp,
+            target: imports.get(comp) ? relative(fe, imports.get(comp)) : "UNRESOLVED",
+            binds: keys
+              .map((k) =>
+                /^\s*(?:(['"])([^'"]+)\1|([A-Za-z_$][\w$]*))\s*(?::|$)/.exec(k),
+              )
