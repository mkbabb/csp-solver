+            prelude: "setProperty",
+            value: v,
+            line: L(m.index),
+          });
+      } else if (/^`[^`]*\$\{/.test(k)) {
+        if (stemOf(k.slice(1)))
+          push({
+            file,
+            kind: `${kind}-setProperty-stem`,
+            prelude: k,
+            value: v,
+            line: L(m.index),
+            stem: true,
+          });
+      } else
+        push({
+          file,
+          kind: `${kind}-setProperty-computed`,
+          prelude: k,
+          value: v,
+          line: L(m.index),
+          unresolved: true,
+        });
