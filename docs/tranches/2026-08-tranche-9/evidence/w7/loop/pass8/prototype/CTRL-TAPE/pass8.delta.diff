new file mode 100644
index 00000000..d100050c
--- /dev/null
+++ b/web/frontend/e2e/lib/edge-bands.mjs
@@ -0,0 +1,507 @@
+// edge-bands.mjs — THE four-band edge probe (T9-W7; registry-v6 §2.9, LAWS P6 §E, P7 §E; registry-v7
+// §2.4 PRODUCT HOME). "Existence is not visibility": a drawn-edge paint gate reads ALL FOUR BANDS (top,
+// right, bottom, left) against edge-OFF. A top-band-only row passed a clip-path that erased the bottom edge
+// (SELF's X6); a computed-style ring gate passed a 15 % ink (FACE); LIVE's ring stayed green at 0.15 (X4).
+//
+// The read, per band: a strip `out` px outside and `inn` px inside the subject's border box, photographed
+// ON and with the edge OFF (`<edge>, <edge> * { visibility: hidden }`, or the caller's `off` sheet — an
+// outline ring whose edge IS the subject turns only its outline colour off). A STATION is one DEVICE
+// column (top/bottom) or row (left/right) inside the middle `span` of the side (corners excluded, default
+// 10–90 %): STATION 1, estate-wide (pass8/CHAIR-RULINGS §2.7 — a stride that pools eight stations cannot
+// see a 1-in-8 dash). A station's value = the MAX over the strip's depth of contrast(ON pixel, OFF pixel).
+// A station where ON == OFF reads 1.00 and is COUNTED (a dropped station is a miss, never a skip).
+// Clauses (every one RED on breach):
+//   B0  the subject exists and is visible, and the edge selector matches ≥ 1 element
+//   B1  each band has ≥ 8 CSS px of stations (8 × DPR device stations; an EMPTY band is RED — at
+//       DPR 2 a 6 px side holds 10 device stations, so a device count let it through)
+//   B2  each band's core median ≥ `floor` (3.0)
+//   B3  THICKNESS (FACE; LAWS P7 §E): each band's median painted depth ≥ `thick` (2) css px ×
+//       `thickTol` (0.9). A station's depth = Σ over its pixels of |gON − gOFF| / |gINK − gOFF| (the
+//       coverage the ink paints there; gINK = the darkest-against-ground painted colour of an edge
+//       element meeting the strip — stroke, fill, outline, border, background — at its own alpha ×
+//       opacity chain to the edge root; the band's p99 |gON − gOFF| when none resolves), over the DPR.
+//       An `outline-width: 1px` ring read 4.289 GREEN on four bands without it.
+//   B4  HOLES (TAPE, CHAIR-RULINGS §2.7): the fraction of a band's stations reading ≤ 1.05 (dropped)
+//       ≤ `holes` (0.02); the hole runs and the longest run are printed (a notch is one run, a dash many)
+//   B5  RELATIVE (RULE; LAWS P7 §E): with `above` (the previous ink's reading), each band's core median
+//       ≥ above × 1.02 — the reference ink replayed through stroke-opacity / path opacity / filter
+//       opacity() (INK_PLANTS) must red it
+// The legacy TOP-ONLY and STATION-8 (max-pool of eight stations) readings print beside, so the hole each
+// left is visible. `EDGE_SABOTAGE=B2,B3,…` switches clauses off (the clause-sabotage battery).
+//   node e2e/lib/edge-bands.mjs --self-test [--engine chromium|webkit] [--dprs 1,2]
+//   node e2e/lib/edge-bands.mjs --sabotage-battery [--engine chromium]
+//   node e2e/lib/edge-bands.mjs --url <u> --subject <sel> --edge <sel> [--off <css>] [--plants]
+//        [--scheme dark] [--dpr 2] [--viewport 1280x800] [--ready <sel>] [--hover <sel>] [--click <sel>]
+//        [--touch] [--prm 0] [--contrast more] [--above <n>] [--holes <f>] [--regimes all]
+// Exit: 0 clean GREEN and every plant RED · 1 clean RED · 3 a plant GREEN (a hole) · 4 both.
+import process from "node:process";
+import { fileURLToPath } from "node:url";
+import { resolve as resolvePath } from "node:path";
+import { onOff, lum, grey, ratio, median, quantile, settle, args, load, playwright, openCell, cellsOf } from "./paint-lib.mjs";
+
+export const EDGE_CLAUSES = ["B0", "B1", "B2", "B3", "B4", "B5"];
+const OFF_CLAUSES = new Set((process.env.EDGE_SABOTAGE ?? "").split(",").filter(Boolean));
+const on = (c) => !OFF_CLAUSES.has(c);
+
+/** Page-side: the painted inks of the edge elements (and descendants) whose box meets `strip`. */
+function edgeInks({ edge, strip }) {
+  const cv = document.createElement("canvas").getContext("2d");
+  const norm = (c) => {
+    if (!c || c === "none" || c.startsWith("url(")) return null;
+    cv.fillStyle = "#010203";
+    cv.fillStyle = c;
+    const s = cv.fillStyle;
+    if (s === "#010203" && !/^#010203$/i.test(c)) return null;
+    const m = s.match(/^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i);
+    if (m) return [parseInt(m[1], 16), parseInt(m[2], 16), parseInt(m[3], 16), 1];
+    const r = s.match(/rgba?\(([^)]+)\)/);
+    if (!r) return null;
+    const v = r[1].split(/[,\s/]+/).filter(Boolean).map(Number);
+    return [v[0], v[1], v[2], v[3] ?? 1];
+  };
+  const SHAPES = new Set(["path", "rect", "line", "polyline", "polygon", "circle", "ellipse", "use", "text"]);
+  const out = [];
+  for (const root of document.querySelectorAll(edge)) {
+    for (const el of [root, ...root.querySelectorAll("*")]) {
+      const b = el.getBoundingClientRect();
+      const grow = 12;
+      if (b.right + grow < strip.x || b.left - grow > strip.x + strip.width || b.bottom + grow < strip.y || b.top - grow > strip.y + strip.height) continue;
+      const cs = getComputedStyle(el);
+      if (cs.visibility === "hidden" || cs.display === "none") continue;
+      let alpha = 1;
+      for (let p = el; p; p = p.parentElement) {
+        const ps = getComputedStyle(p);
+        alpha *= +ps.opacity;
+        for (const m of ps.filter.matchAll(/opacity\(([\d.]+)(%?)\)/g)) alpha *= m[2] ? +m[1] / 100 : +m[1];
+        if (p === root) break;
+      }
+      const push = (c, a = 1) => {
+        const n = norm(c);
+        if (n && n[3] * a * alpha > 0.02) out.push([n[0], n[1], n[2], n[3] * a * alpha]);
+      };
+      if (el instanceof SVGElement && SHAPES.has(el.tagName.toLowerCase())) {
+        if (cs.stroke !== "none" && parseFloat(cs.strokeWidth) > 0) push(cs.stroke, +cs.strokeOpacity);
+        push(cs.fill, +cs.fillOpacity);
+      } else if (!(el instanceof SVGElement)) {
+        if (cs.outlineStyle !== "none" && parseFloat(cs.outlineWidth) > 0) push(cs.outlineColor);
+        for (const s of ["Top", "Right", "Bottom", "Left"])
+          if (cs[`border${s}Style`] !== "none" && parseFloat(cs[`border${s}Width`]) > 0) push(cs[`border${s}Color`]);
+        push(cs.backgroundColor);
+      }
+    }
+  }
+  return out;
+}
+
+export async function fourBands(
+  page,
+  { subject, edge, off = null, out = 8, inn = 8, span = [0.1, 0.9], floor = 3.0, thick = 2, thickTol = 0.9, holes = 0.02, above = null },
+) {
+  const loc = page.locator(subject).first();
+  const vis = await loc.isVisible().catch(() => false);
+  const edgeCount = await page.locator(edge).count();
+  if (on("B0") && (!vis || edgeCount === 0))
+    return { red: true, why: [`B0 ${!vis ? `subject ${subject} not visible` : `edge ${edge} matches 0 elements`}`], bands: null, edgeCount };
+  if (!vis) return { red: false, why: [], bands: null, edgeCount };
+  const vw = page.viewportSize();
+  const dpr = await page.evaluate(() => devicePixelRatio);
+  const clamp = (c) => {
+    const x = Math.max(0, Math.floor(c.x)),
+      y = Math.max(0, Math.floor(c.y));
+    return { x, y, width: Math.max(1, Math.min(vw.width - x, Math.ceil(c.width))), height: Math.max(1, Math.min(vw.height - y, Math.ceil(c.height))) };
+  };
+  // Each band is photographed with ITS side scrolled into view (a subject taller than the viewport has
+  // its bottom band below the fold). A side still outside the viewport reads 0 stations → B1 RED.
+  const strip = (side, b) =>
+    side === "top"
+      ? { x: b.x, y: b.y - out, width: b.width, height: out + inn }
+      : side === "bottom"
+        ? { x: b.x, y: b.y + b.height - inn, width: b.width, height: out + inn }
+        : side === "left"
+          ? { x: b.x - out, y: b.y, width: out + inn, height: Math.min(b.height, vw.height) }
+          : { x: b.x + b.width - inn, y: b.y, width: out + inn, height: Math.min(b.height, vw.height) };
+  const offCss = off ?? `${edge}, ${edge} * { visibility: hidden !important; }`;
+  const bands = {};
+  const why = [];
+  let b0 = null;
+  const readBand = async (side, block) => {
+    await loc.evaluate((e, block) => e.scrollIntoView({ block, inline: "nearest" }), block);
+    await settle(page);
+    const b = await loc.boundingBox();
+    b0 ??= b;
+    const raw = strip(side, b);
+    const inView = raw.y + raw.height > 0 && raw.y < vw.height && raw.x + raw.width > 0 && raw.x < vw.width;
+    if (!inView) return { stations: 0, coreMedian: 0, fracUnder: 1, dropped: 0, pose: block, occluder: "viewport" };
+    // the OCCLUDER at the band's midpoint on the box edge (LAWS P5: name it); an ancestor is the ground
+    const occluder = await page.evaluate(
+      ({ x, y, sel, edge }) => {
+        const e = document.elementFromPoint(x, y);
+        if (!e) return "none";
+        const subj = document.querySelector(sel);
+        if (e.closest(sel) || e.closest(edge) || (subj && e.contains(subj))) return null;
+        const c = typeof e.className === "string" ? e.className : (e.className?.baseVal ?? "");
+        return `${e.tagName.toLowerCase()}${c ? "." + c.trim().split(/\s+/).slice(0, 2).join(".") : ""}`;
+      },
+      {
+        x: side === "left" || side === "right" ? raw.x + raw.width / 2 : b.x + b.width / 2,
+        y: side === "top" || side === "bottom" ? raw.y + raw.height / 2 : b.y + Math.min(b.height, vw.height - b.y) / 2,
+        sel: subject,
+        edge,
+      },
+    );
+    const clip = clamp(raw);
+    const inks = await page.evaluate(edgeInks, { edge, strip: clip });
+    const { on: ON, off: OFF } = await onOff(page, clip, offCss);
+    const horiz = side === "top" || side === "bottom";
+    const len = horiz ? ON.w : ON.h,
+      depth = horiz ? ON.h : ON.w;
+    const s0 = Math.floor(len * span[0]),
+      s1 = Math.ceil(len * span[1]);
+    const deltas = [];
+    for (let i = 0; i < ON.data.length; i += 3) {
+      const d = Math.abs(grey(ON.data, i) - grey(OFF.data, i));
+      if (d >= 2) deltas.push(d);
+    }
+    const p99 = quantile(deltas, 0.99);
+    const st = [],
+      th = [];
+    for (let s = s0; s < s1; s++) {
+      let best = 1,
+        cov = 0;
+      for (let d = 0; d < depth; d++) {
+        const x = horiz ? s : d,
+          y = horiz ? d : s;
+        const i = (y * ON.w + x) * 3;
+        const r = ratio(lum(ON.data, i), lum(OFF.data, i));
+        if (r > best) best = r;
+        const gOff = grey(OFF.data, i);
+        let full = 0;
+        for (const [r8, g8, b8, a] of inks) full = Math.max(full, Math.abs(0.2126 * r8 + 0.7152 * g8 + 0.0722 * b8 - gOff) * a);
+        if (full < 4) full = p99;
+        if (full >= 2) cov += Math.min(1, Math.abs(grey(ON.data, i) - gOff) / full);
+      }
+      st.push(best);
+      th.push(cov / dpr);
+    }
+    // the hole runs (dropped stations) and the STATION-8 legacy (max-pool of eight)
+    const drop = st.map((v) => v <= 1.05);
+    let runs = 0,
+      longest = 0,
+      cur = 0;
+    for (const d of drop) {
+      if (d) {
+        cur++;
+        if (cur === 1) runs++;
+        longest = Math.max(longest, cur);
+      } else cur = 0;
+    }
+    const pooled = [];
+    for (let k = 0; k < st.length; k += 8) pooled.push(Math.max(...st.slice(k, k + 8)));
+    return {
+      stations: st.length,
+      coreMedian: +median(st).toFixed(3),
+      fracUnder: st.length ? +(st.filter((v) => v < floor).length / st.length).toFixed(3) : 1,
+      dropped: drop.filter(Boolean).length,
+      holeFrac: st.length ? +(drop.filter(Boolean).length / st.length).toFixed(3) : 1,
+      holeRuns: runs,
+      longestHole: longest,
+      thickness: +median(th).toFixed(2),
+      ink: inks.length ? "computed" : "p99",
+      station8: { median: +median(pooled).toFixed(3), dropped: pooled.filter((v) => v <= 1.05).length, n: pooled.length },
+      pose: block,
+      occluder,
+    };
+  };
+  for (const side of ["top", "right", "bottom", "left"]) {
+    // scroll POSES: the side's own edge first, then centred; an occluded first pose prints its occluder
+    // and the better-seen pose is the reading (the band must be paintable at SOME reachable pose)
+    const first = await readBand(side, side === "bottom" ? "end" : side === "top" ? "start" : "nearest");
+    let band = first;
+    const tried = [`${first.pose} ${first.coreMedian}${first.occluder ? " occ " + first.occluder : ""}`];
+    for (const pose of side === "bottom" ? ["center", "start"] : side === "top" ? ["center", "end"] : ["center"]) {
+      if (band.coreMedian >= floor) break;
+      const next = await readBand(side, pose);
+      tried.push(`${next.pose} ${next.coreMedian}${next.occluder ? " occ " + next.occluder : ""}`);
+      if (next.coreMedian > band.coreMedian) band = next;
+    }
+    if (tried.length > 1) band = { ...band, firstPose: tried.join(" | ") };
+    bands[side] = band;
+    const occ = band.occluder ? ` (occluder ${band.occluder})` : "";
+    if (on("B1") && band.stations < 8 * dpr) {
+      why.push(`B1 ${side} band EMPTY (${band.stations} stations < ${8 * dpr} = 8 css px at DPR ${dpr})${occ}`);
+      continue;
+    }
+    if (on("B2") && band.coreMedian < floor) why.push(`B2 ${side} core median ${band.coreMedian} < ${floor}${occ}`);
+    if (on("B3") && band.thickness < thick * thickTol)
+      why.push(`B3 ${side} painted depth ${band.thickness} css px < ${(thick * thickTol).toFixed(2)} (${thick} × ${thickTol}; ink ${band.ink})`);
+    if (on("B4") && band.holeFrac > holes)
+      why.push(`B4 ${side} holes ${band.holeFrac} > ${holes} (${band.dropped} stations in ${band.holeRuns} runs, longest ${band.longestHole})`);
+    if (on("B5") && above != null && band.coreMedian < above * 1.02)
+      why.push(`B5 ${side} core median ${band.coreMedian} < ${(above * 1.02).toFixed(3)} (the previous ink ${above} × 1.02)`);
+  }
+  return {
+    red: why.length > 0,
+    why,
+    bands,
+    edgeCount,
+    dpr,
+    topOnly: bands.top ? (bands.top.coreMedian >= floor ? "GREEN" : "RED") : "RED",
+    station8: Object.values(bands).every((b) => b.station8 && b.station8.median >= floor && b.station8.dropped === 0) ? "GREEN" : "RED",
+    box: b0 ? { x: +b0.x.toFixed(1), y: +b0.y.toFixed(1), w: +b0.width.toFixed(1), h: +b0.height.toFixed(1) } : null,
+  };
+}
+
+/** The in-run plants every drawn-edge row ships (LAWS P6 §E, P7 §E): each must RED, or print NO-OP when
+ *  it cannot reach this edge's paint (a stroke plant on a CSS outline). A plant is a CSS string, or
+ *  `{ fade: a }` — every painted colour of the edge AND its descendants re-set at `a` × its own alpha
+ *  (RULE: the pass-7 FADE15 set `stroke` on the edge root only, and a path carrying its own `stroke`
+ *  attribute kept its ink). */
+export const EDGE_PLANTS = (edge) => {
+  const all = `${edge}, ${edge} *`;
+  const shapes = ["path", "rect", "line", "polyline", "polygon", "circle", "ellipse", "use"].map((t) => `${edge} ${t}`).join(", ");
+  // 1-in-8: a 2 px gap in every 16 px, both axes, intersected so each band loses 1/8 of its stations;
+  // `no-clip` so an outline outside the border box is masked too
+  // (the gap sits at 6–8 px of each period, so a box edge on a 16 px multiple keeps its ink)
+  const stripe = (dir) => `repeating-linear-gradient(to ${dir}, #000 0 6px, transparent 6px 8px, #000 8px 16px)`;
+  const dash = `${stripe("right")}, ${stripe("bottom")}`;
+  return {
+    X6_bottom_erased: `${edge} { clip-path: inset(-8px -8px 16px -8px) !important; }`,
+    X4_opacity_015: `${edge} { opacity: 0.15 !important; }`,
+    FADE15_desc: { fade: 0.15 },
+    STROKE_OPACITY015: `${all} { stroke-opacity: 0.15 !important; }`,
+    PATH_OPACITY015: `${shapes} { opacity: 0.15 !important; }`,
+    FILTER_OPACITY015: `${edge} { filter: opacity(0.15) !important; }`,
+    THIN_1PX: `${all} { stroke-width: 1px !important; vector-effect: non-scaling-stroke !important; outline-width: 1px !important; border-width: 1px !important; }`,
+    DASH_1IN8: `${edge} { mask-image: ${dash} !important; -webkit-mask-image: ${dash} !important; mask-composite: intersect !important; -webkit-mask-composite: source-in !important; mask-clip: no-clip !important; -webkit-mask-clip: no-clip !important; }`,
