+/** The element-keyed table the leader cites: every chain element and the sites that reach it. */
+export function table() {
+  const t = tree();
+  const ch = chain(t);
+  const named = {
+    CASE: ch.CASE,
+    CARD: ch.CARD,
+    FOOT: ch.FOOT,
+    BAR: ch.BAR,
+    VERBS: ch.VERBS,
+    FRAME: ch.FRAME,
+    WELL: ch.WELL,
+  };
+  const S = sitesOf(t, ch, named);
+  return Object.entries(named).map(([n, el]) => ({
+    n,
+    tag: el?.tag,
+    classes: el ? [...el.classes].join(" ") : null,
+    sites: S.get(n).length,
+    files: [...new Set(S.get(n).map((s) => s.file))].length,
+  }));
+}
