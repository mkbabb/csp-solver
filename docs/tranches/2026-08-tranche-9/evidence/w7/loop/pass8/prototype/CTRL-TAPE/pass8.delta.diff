+// paint-lib.d.mts — the TYPE of the ONE painted-byte library (`./paint-lib.mjs`), so a TypeScript spec
+// can import it under `typecheck:e2e` (strict, no `allowJs`: a bare `.mjs` import is TS7016). No
+// behaviour lives here. The exports `zone-grammar.spec.ts` calls are typed; every other export is
+// declared `unknown` until a spec that calls it types it.
+// NOT-A-LANE: a declaration of the chair's home (T9-W7 pass 8, CTRL-TAPE's foot rows).
+import type { Page } from "@playwright/test";
+
+/** A decoded photograph: packed RGB, device pixels. */
+export interface Shot {
+  data: Uint8Array;
+  w: number;
+  h: number;
+}
+export interface Clip {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+
+export function onOff(page: Page, clip: Clip, offCss: string): Promise<{ on: Shot; off: Shot }>;
+export function settle(page: Page): Promise<void>;
+export function maxDelta(d1: Uint8Array, d2: Uint8Array, i: number): number;
+export function grey(d: Uint8Array, i: number): number;
+export function lum(d: Uint8Array, i: number): number;
+export function ratio(a: number, b: number): number;
+export function median(a: number[]): number;
+export function quantile(a: number[], f: number): number;
+
+export const playwright: unknown;
+export const textRunRects: unknown;
+export const args: unknown;
+export const load: unknown;
+export const cellsOf: unknown;
+export const openCell: unknown;
