+
+const sig = (r) => (r.bands ? Object.values(r.bands).map((b) => `${b.coreMedian}/${b.thickness}/${b.dropped}`).join(" ") : "none");
+/** Clean, then every plant against it. A plant whose four bands read byte-for-byte the clean numbers
+ *  changed no paint on this edge: NO-OP (printed, not a hole). */
+export async function edgeGate(page, { subject, edge, plants = null, ...opts }) {
+  const clean = await fourBands(page, { subject, edge, ...opts });
+  const out = {};
+  for (const [name, plant] of Object.entries(plants ?? EDGE_PLANTS(edge))) {
+    const undo = await applyEdgePlant(page, edge, plant);
+    await settle(page);
+    const r = await fourBands(page, { subject, edge, ...opts });
+    await undo();
+    await settle(page);
+    r.noop = !r.red && sig(r) === sig(clean);
+    r.info = /^INFO_/.test(name);
+    out[name] = r;
+  }
+  return { clean, plants: out };
+}
+
+export const fmt = (r) =>
+  (r.bands
+    ? Object.entries(r.bands)
+        .map(([k, b]) => `${k} ${b.coreMedian} d${b.thickness} (n${b.stations} <3:${b.fracUnder} holes ${b.dropped}/${b.holeRuns}r${b.longestHole ? "≤" + b.longestHole : ""} s8 ${b.station8?.median}/${b.station8?.dropped}${b.occluder ? " occ " + b.occluder : ""}${b.firstPose ? " [first " + b.firstPose + "]" : ""})`)
