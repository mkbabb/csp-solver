+ *  attribute kept its ink). */
+export const EDGE_PLANTS = (edge) => {
+  const all = `${edge}, ${edge} *`;
+  const shapes = ["path", "rect", "line", "polyline", "polygon", "circle", "ellipse", "use"].map((t) => `${edge} ${t}`).join(", ");
+  // 1-in-8: a 2 px gap in every 16 px, both axes, intersected so each band loses 1/8 of its stations;
+  // `no-clip` so an outline outside the border box is masked too
+  // (the gap sits at 6–8 px of each period, so a box edge on a 16 px multiple keeps its ink)
+  const stripe = (dir) => `repeating-linear-gradient(to ${dir}, #000 0 6px, transparent 6px 8px, #000 8px 16px)`;
+  const dash = `${stripe("right")}, ${stripe("bottom")}`;
+  return {
+    X6_bottom_erased: `${edge} { clip-path: inset(-8px -8px 16px -8px) !important; }`,
+    X4_opacity_015: `${edge} { opacity: 0.15 !important; }`,
+    FADE15_desc: { fade: 0.15 },
+    STROKE_OPACITY015: `${all} { stroke-opacity: 0.15 !important; }`,
+    PATH_OPACITY015: `${shapes} { opacity: 0.15 !important; }`,
+    FILTER_OPACITY015: `${edge} { filter: opacity(0.15) !important; }`,
+    THIN_1PX: `${all} { stroke-width: 1px !important; vector-effect: non-scaling-stroke !important; outline-width: 1px !important; border-width: 1px !important; }`,
+    DASH_1IN8: `${edge} { mask-image: ${dash} !important; -webkit-mask-image: ${dash} !important; mask-composite: intersect !important; -webkit-mask-composite: source-in !important; mask-clip: no-clip !important; -webkit-mask-clip: no-clip !important; }`,
