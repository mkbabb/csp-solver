+// ------------------------------------------------------------------------ registrations (ERASE)
+/** Every custom-property REGISTRATION: `@property` in every CSS language and block, and every
+ *  `registerProperty(` in code (ERASE: the name folded through concatenation and same-file consts;
+ *  unfoldable = `?`, UNRESOLVED, never dropped). [{name, inherits, syntax, initial, kind, file, line}] */
+export function propertyRegistrations(fe, { files, read, exists } = {}) {
+  const rd = read ?? ((f) => readFileSync(f, "utf8"));
+  const list = files
+    ? followImports(files, { read: rd, exists })
+    : sources(fe, { read: rd, exists });
+  const out = [];
+  for (const f of list) {
+    const file = relative(fe, f);
+    const text = rd(f);
+    for (const r of rulesOf(f, text, fe)) {
+      const m = /^@property\s+(--[\w-]+)/.exec(r.prelude);
+      if (!m) continue;
+      const get = (p) => r.decls.find((d) => d.prop === p)?.value ?? null;
+      out.push({
+        name: m[1],
+        inherits: get("inherits"),
+        syntax: get("syntax"),
+        initial: get("initial-value"),
+        kind: `@property ${r.kind}`,
+        file,
+        line: r.line,
+      });
+    }
+    const codes = f.endsWith(".vue")
+      ? sfc(text).scripts.map((s) => s.text)
+      : /\.(ts|tsx|js|mjs)$/.test(f)
+        ? [text]
+        : [];
+    for (const code of codes) {
+      const s = stripJs(code);
+      const consts = constBindings(s);
+      for (const m of s.matchAll(/registerProperty\s*\(\s*\{([\s\S]*?)\}\s*\)/g)) {
+        const field = (k) => {
+          const x = new RegExp(`(?:^|[,{\\s])${k}\\s*:\\s*([^,}]+)`).exec(m[1]);
+          if (x) return x[1].trim();
+          return new RegExp(`(?:^|[,{\\s])${k}\\s*(?:,|$)`).test(m[1]) ? k : null; // shorthand `{ name }`
+        };
+        const rawName = field("name");
