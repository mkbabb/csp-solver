+// postpaint.d.mts — the TYPE of the ONE post-paint library (`./postpaint.mjs`), so a TypeScript spec
+// can import it under `typecheck:e2e` (strict, no `allowJs`: a bare `.mjs` import is TS7016). No
+// behaviour lives here. `installTimeline` is typed for its page-side use (`page.evaluate(installTimeline,
+// sel)`); every other export is declared `unknown` until a spec that calls it types it.
+// NOT-A-LANE: a declaration of the chair's home (T9-W7 pass 8, NOTE-ERASE's drop-clock row).
+
+/** Page-side: the painted timeline on `window.__pf` ({rafs, post, on}); `sel` is read post-paint each frame. */
+export function installTimeline(sel?: string | null): void;
+
+export const installSampler: unknown;
+export const kPaintOf: unknown;
+export const analyse: unknown;
+export const SKIP_PLANT: unknown;
+export const F2_PLANT: unknown;
+export const readMover: unknown;
+export const fmtArm: unknown;
