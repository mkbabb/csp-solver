+// ── 2a. The drop clock — a note leaves on its own verb's length ─────
+//
+// T9-W7 §7. A note leaves as a verb (`ink-rub-out` on the whisper rung), and Vue drops the
+// leaving node on max(transition, animation) read off that node's computed style. So any
+// transition on the ink (the settle's dusk step, or one a later lane hangs on it) would hold a
+// finished rub-out on the page for its own length. MarginNote writes `transition: none` inline
+// with `!important` at before-leave, which outranks every author rule. This row PLANTS that
+// adversary at (1,1,0) with `!important` and a whole second, proves the plant is live on the
+// resting ink, then reads the clock off the leaving node. Born red on both engines with the hook
+// deleted: the node is held for the plant's full second.
+
+type LeaveRecord = {
+  el?: Element;
+  t0?: number;
+  t1?: number;
+  transitionDuration?: string;
+  animationName?: string;
+  animationDuration?: string;
+  animationDelay?: string;
+};
+
+// Pass 7, BOTH AXES. The transition fence alone left the rub-out's own length open: the rung is
+// read through `var(--motion-whisper)`, registered `inherits: true`, so an ancestor re-declaring
+// it at (0,1,0) with no `!important`, or an author `animation-duration: … !important` on the
+// leave class, held the node for 904 ms with every CI gate at 0. Each adversary proves it is in
+// force before the leave, on its own axis, and the leaving node is read on BOTH longhands.
+const DROP_CLOCK_ADVERSARIES: {
+  name: string;
+  css: string;
+  inForce: (page: Page) => Promise<string>;
+  want: string;
+}[] = [
+  {
+    name: 'a transition at (1,1,0) !important',
+    css: '#app .margin-note-ink { transition: color 1000ms linear !important; }',
+    inForce: (page) =>
+      page.locator('.margin-note-ink').evaluate((el) => getComputedStyle(el).transitionDuration),
+    want: '1s',
+  },
+  {
+    name: 'the rung re-declared on an ancestor at (0,1,0)',
+    css: '.margin-note { --motion-whisper: 900ms; }',
+    inForce: (page) =>
+      page
+        .locator('.margin-note-ink')
+        .evaluate((el) => getComputedStyle(el).getPropertyValue('--motion-whisper').trim()),
+    // The rung is registered `<time>`, so it computes to its canonical unit.
+    want: '0.9s',
+  },
+  {
+    name: 'animation-duration !important on the leave class',
+    css: '.margin-note-ink.note-leave-active { animation-duration: 900ms !important; }',
+    inForce: (page) =>
+      page.locator('.margin-note').evaluate((host) => {
+        const probe = document.createElement('span');
+        probe.className = 'margin-note-ink note-leave-active';
+        host.appendChild(probe);
+        const d = getComputedStyle(probe).animationDuration;
+        probe.remove();
+        return d;
+      }),
+    want: '0.9s',
+  },
+  {
+    // Vue's fallback clock is the longest delay + duration, so the delay is the same attack.
+    name: 'animation-delay !important on the leave class',
+    css: '.margin-note-ink.note-leave-active { animation-delay: 750ms !important; }',
+    inForce: (page) =>
+      page.locator('.margin-note').evaluate((host) => {
+        const probe = document.createElement('span');
+        probe.className = 'margin-note-ink note-leave-active';
+        host.appendChild(probe);
+        const d = getComputedStyle(probe).animationDelay;
+        probe.remove();
+        return d;
+      }),
+    want: '0.75s',
+  },
+];
+
+for (const adversary of DROP_CLOCK_ADVERSARIES) {
+  test(`drop clock: a note leaves on the rub-out's own rung — ${adversary.name}`, async ({
+    page,
+  }) => {
+    await loadSudoku(page, '?board=' + CONFLICT_BOARD);
+    await expect
+      .poll(() => page.locator('.sudoku-cell .glyph-svg').count(), { timeout: 15000 })
+      .toBe(72);
+    await page.addStyleTag({ content: adversary.css });
+
+    // A red verdict: row 0 is blank on the pinned board, so two nines in it are a conflict.
+    await setCellValue(page, 0, '9');
+    await setCellValue(page, 1, '9');
+    await page.locator('.controls-card button[aria-label="Solve puzzle"]').click();
+    await expect(page.locator('.margin-note')).toHaveClass(/teacher-red/, { timeout: 15000 });
+    const ink = page.locator('.margin-note-ink');
+    await expect(ink).toHaveCount(1);
+    // The adversary is in force before the leave, so a green below is the hook's, not a dud.
+    expect(await adversary.inForce(page)).toBe(adversary.want);
+
+    await page.evaluate(() => {
+      const host = document.querySelector('.margin-note')!;
+      const rec: LeaveRecord = {};
+      (window as unknown as { __leave: LeaveRecord }).__leave = rec;
+      new MutationObserver(() => {
+        const el = rec.el ?? host.querySelector('.margin-note-ink.note-leave-active');
+        if (el && !rec.el) {
+          const cs = getComputedStyle(el);
+          Object.assign(rec, {
+            el,
+            t0: performance.now(),
+            transitionDuration: cs.transitionDuration,
+            animationName: cs.animationName,
+            animationDuration: cs.animationDuration,
+            animationDelay: cs.animationDelay,
+          });
+        }
+        if (rec.el && rec.t1 === undefined && !rec.el.isConnected) rec.t1 = performance.now();
+      }).observe(host, {
+        subtree: true,
+        childList: true,
+        attributes: true,
+        attributeFilter: ['class'],
+      });
+    });
+
+    // The next edit reverts the grade, and the red line is rubbed out.
+    await setCellValue(page, 1, '');
+    const read = () =>
+      page.evaluate(() => {
+        const r = (window as unknown as { __leave: LeaveRecord }).__leave;
+        return r.t1 === undefined || r.t0 === undefined
+          ? null
+          : {
+              ms: r.t1 - r.t0,
+              transitionDuration: r.transitionDuration,
+              animationName: r.animationName,
+              animationDuration: r.animationDuration,
+              animationDelay: r.animationDelay,
+            };
+      });
+    await expect.poll(read, { timeout: 5000 }).not.toBeNull();
+    const leave = (await read())!;
+
+    // The transition axis: fenced.
+    expect(leave.transitionDuration).toBe('0s');
+    expect(leave.animationName).toContain('ink-rub-out');
+    // The animation axis: every listed duration IS the whisper rung, from its one home — never
+    // the adversary's 900 ms, never the registered 0ms of an absent publisher.
+    for (const d of leave.animationDuration!.split(','))
+      expect(Math.round(parseFloat(d) * 1000)).toBe(MOTION.rungs.whisper);
+    // ...and no delay in front of it: Vue's fallback clock is delay + duration.
+    for (const d of leave.animationDelay!.split(',')) expect(parseFloat(d)).toBe(0);
+    // The whisper rung plus a frame or two. The bound is the ARRIVAL's rung, because the erase is
+    // shorter than the write-in by design: a whisper/dusk swap (the rub-out on 350 ms, node gone
+    // at ~360) reds here, where the pass-5 '< 500' let it by.
+    expect(leave.ms).toBeLessThan(MOTION.rungs.note);
+  });
+}
+
+// ── 2a′. A leave with no animation has no clock (pass 8, LAWS P7 §F) ─
+//
+// Vue's fallback timer reads the leaving node's `animation-duration` and never its
+// `animation-name`, so a rung written onto a leave whose computed name is `none` holds the node
+// for the rung on an animation that never runs (pass 7's hook did it to the union's `note-swap`:
+// the sentence on both lines for 16–20 frames). The hook keys its length on the COMPUTED name.
+// This leg reads the leave both ways a page can switch the verb off, the site's PRM arm and an
+// author `animation-name: none !important`, and counts the frames the leaving node is PAINTED:
+// each read is a task queued from its frame's rAF (`installTimeline`, the recorder's post-paint
+// track). Its negative runs in the same file on the same dist: the fence BLINDED (the hook's one
+// read is made to answer a running verb, so it writes the rung on every leave, which is the
+// pass-7 hook) holds the node for the rung and more frames than the bound.
+
+/** The in-run negative. Every computed style read off a node wearing a leave class answers a
+ *  running rub-out for `animation-name`; every other property is the real one, so Vue's own
+ *  clock read (duration and delay) is untouched. Only the hook's key is lied to. */
+const BLIND_THE_FENCE = `(() => {
+  const real = window.getComputedStyle;
+  window.getComputedStyle = function (el, pseudo) {
+    const cs = real.call(window, el, pseudo);
+    if (!(el instanceof Element) || !/-leave-active/.test(String(el.getAttribute('class')))) return cs;
+    return new Proxy(cs, {
+      get: (t, k) => (k === 'animationName' ? 'ink-rub-out' : typeof t[k] === 'function' ? t[k].bind(t) : t[k]),
+    });
+  };
+})();`;
+
+type PaintedTrack = { post: { k: number; r: unknown }[]; on: boolean };
+
+/** Watch the next leave of `leaving` (a selector matched once its leave class is on): the node's
+ *  DOM lifetime, its computed clock, and the frames it was painted, read post-paint. */
+async function watchLeave(page: Page, leaving: string) {
+  await page.evaluate(installTimeline, leaving);
+  await page.evaluate((sel) => {
+    const rec: LeaveRecord = {};
+    (window as unknown as { __leave: LeaveRecord }).__leave = rec;
+    new MutationObserver(() => {
+      const el = rec.el ?? document.querySelector(sel);
+      if (el && !rec.el) {
+        const cs = getComputedStyle(el);
+        Object.assign(rec, {
+          el,
+          t0: performance.now(),
+          animationName: cs.animationName,
+          animationDuration: cs.animationDuration,
+        });
+      }
+      if (rec.el && rec.t1 === undefined && !rec.el.isConnected) rec.t1 = performance.now();
+    }).observe(document.body, {
+      subtree: true,
+      childList: true,
+      attributes: true,
+      attributeFilter: ['class'],
+    });
+  }, leaving);
+  return async () => {
+    const read = () =>
+      page.evaluate(() => {
+        const r = (window as unknown as { __leave: LeaveRecord }).__leave;
+        return r.t1 === undefined || r.t0 === undefined ? null : r.t1 - r.t0;
+      });
+    await expect.poll(read, { timeout: 5000 }).not.toBeNull();
+    // Two more frames, so the frame after the removal has its post-paint read too.
+    await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+    return page.evaluate(() => {
+      const w = window as unknown as { __leave: LeaveRecord; __pf: PaintedTrack };
+      w.__pf.on = false;
+      const r = w.__leave;
+      return {
+        ms: +(r.t1! - r.t0!).toFixed(1),
+        animationName: r.animationName!,
+        animationDuration: r.animationDuration!,
+        painted: w.__pf.post.filter((p) => p.r !== null).length,
+      };
+    });
+  };
+}
+
+/** A red line on the pinned board, then the edit that rubs it out, with the leave watched. */
+async function redLineLeaves(page: Page, arm?: (page: Page) => Promise<void>) {
+  await loadSudoku(page, '?board=' + CONFLICT_BOARD);
+  await expect
+    .poll(() => page.locator('.sudoku-cell .glyph-svg').count(), { timeout: 15000 })
+    .toBe(72);
+  await arm?.(page);
+  await setCellValue(page, 0, '9');
+  await setCellValue(page, 1, '9');
+  await page.locator('.controls-card button[aria-label="Solve puzzle"]').click();
+  await expect(page.locator('.margin-note')).toHaveClass(/teacher-red/, { timeout: 15000 });
+  const done = await watchLeave(page, '.margin-note .margin-note-ink[class*="leave-active"]');
+  await setCellValue(page, 1, '');
+  return done();
+}
+
+const STILL_LEAVES: { name: string; arm: (page: Page) => Promise<void> }[] = [
+  {
+    name: "the site's PRM arm",
+    arm: (page) => page.emulateMedia({ reducedMotion: 'reduce' }),
+  },
+  {
+    name: 'animation-name: none !important on the leave class',
+    arm: (page) =>
+      page
+        .addStyleTag({
+          content: '.margin-note-ink.note-leave-active { animation-name: none !important; }',
+        })
+        .then(() => undefined),
+  },
+];
+
+for (const still of STILL_LEAVES) {
+  test(`drop clock: a leave with no animation has no clock — ${still.name}`, async ({ page }) => {
+    const leave = await redLineLeaves(page, still.arm);
+    expect(leave.animationName).toBe('none');
+    expect(leave.animationDuration).toBe('0s');
+    // A zero-length leave: gone inside one whisper, painted on at most two frames.
+    expect(leave.ms).toBeLessThan(MOTION.rungs.whisper);
+    expect(leave.painted).toBeLessThanOrEqual(2);
+    console.log(`still leave ${still.name}: ${leave.ms} ms, ${leave.painted} painted frames`);
+  });
+}
+
+test('drop clock (negative, in-run): the fence blinded holds a still leave for the rung', async ({
+  page,
+}) => {
+  await page.addInitScript(BLIND_THE_FENCE);
+  await page.emulateMedia({ reducedMotion: 'reduce' });
+  const leave = await redLineLeaves(page);
+  // The pass-7 hook's reading: the rung written on a leave with no verb, the node held for it.
+  expect(leave.animationDuration).toBe(`${MOTION.rungs.whisper / 1000}s`);
+  expect(leave.ms).toBeGreaterThanOrEqual(MOTION.rungs.whisper);
+  expect(leave.painted).toBeGreaterThan(2);
+  console.log(`drop-clock negative: held ${leave.ms} ms over ${leave.painted} painted frames`);
+});
