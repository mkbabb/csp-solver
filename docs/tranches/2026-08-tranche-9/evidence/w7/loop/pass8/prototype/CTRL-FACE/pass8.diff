+// Types for the ONE painted-byte library (`paint-lib.mjs`), as the TypeScript specs call it
+// (T9-W7 CTRL-FACE pass 8, PROPOSED to the homes; see edge-bands.d.mts). Narrow on purpose.
+import type { Page } from "@playwright/test";
+
+export interface Raw {
+  w: number;
+  h: number;
+  data: Uint8Array;
+}
+export function onOff(
+  page: Page,
+  clip: { x: number; y: number; width: number; height: number },
+  offCss: string,
+): Promise<{ on: Raw; off: Raw }>;
+export function settle(page: Page): Promise<void>;
diff --git a/web/frontend/e2e/lib/paint-lib.mjs b/web/frontend/e2e/lib/paint-lib.mjs
new file mode 100644
index 00000000..b7b2ad13
--- /dev/null
+++ b/web/frontend/e2e/lib/paint-lib.mjs
@@ -0,0 +1,218 @@
+// paint-lib.mjs — the painted-byte reads the estate's paint probes share (T9-W7; LAWS P6 §I, P7 §C;
+// registry-v7 §2.4 PRODUCT HOME). ONE copy: `edge-bands.mjs` (four bands), `glyph-pop.mjs` (the glyph
+// population), `postpaint.mjs` and `rest-probes.mjs` import it by relative path; a spec imports it as
+// `./lib/paint-lib.mjs`. Nothing here is resolved by an absolute path, and nothing leans on an
+// undeclared package: the browsers come from `@playwright/test` (this package's devDependency) and the
+// photographs are decoded HERE (a PNG reader over node:zlib) — the pass-7 copy required `sharp` and
+// `playwright`, which reach node_modules only through wrangler's miniflare and @playwright/test, and
+// knip reds an unlisted dependency.
+//
+// Photographs are DEVICE-scaled (`scale: 'device'`: a DPR 2 read is read at DPR 2's pixels) PNGs decoded
+// to RGB; luminance is WCAG 2.x relative luminance; a contrast is (Lhi + 0.05) / (Llo + 0.05).
+// A photograph of the subject ON and of the subject with its paint OFF (the edge hidden / the text
+// transparent) are compared PIXEL FOR PIXEL: the OFF photo is the painted ground under each pixel, so no
+// ground is guessed and no crop maximum keys anything.
+import os from "node:os";
+import process from "node:process";
+import { Buffer } from "node:buffer";
+import { inflateSync } from "node:zlib";
+import { chromium, webkit, firefox } from "@playwright/test";
+
+/** The browser types, from this package's declared @playwright/test. */
+export const playwright = () => ({ chromium, webkit, firefox });
+
+/** A PNG (8-bit, non-interlaced, colour type 2 RGB or 6 RGBA — what Playwright's screenshots are) to
+ *  packed RGB. Anything else throws: a photograph this cannot read is never read as blank. */
+function decodePng(buf) {
+  if (buf.readUInt32BE(0) !== 0x89504e47) throw new Error("decodePng: not a PNG");
+  let w = 0,
+    h = 0,
+    ct = 0;
+  const idat = [];
+  for (let o = 8; o < buf.length; ) {
+    const len = buf.readUInt32BE(o),
+      type = buf.toString("latin1", o + 4, o + 8),
+      body = buf.subarray(o + 8, o + 8 + len);
+    if (type === "IHDR") {
+      w = body.readUInt32BE(0);
+      h = body.readUInt32BE(4);
+      ct = body[9];
+      if (body[8] !== 8 || (ct !== 2 && ct !== 6) || body[12] !== 0) throw new Error(`decodePng: depth ${body[8]} colour type ${ct} interlace ${body[12]} unsupported`);
+    } else if (type === "IDAT") idat.push(body);
+    else if (type === "IEND") break;
+    o += 12 + len;
+  }
+  const bpp = ct === 6 ? 4 : 3,
+    stride = w * bpp,
+    raw = inflateSync(Buffer.concat(idat)),
+    px = Buffer.alloc(h * stride);
+  for (let y = 0; y < h; y++) {
+    const f = raw[y * (stride + 1)],
+      src = y * (stride + 1) + 1,
+      dst = y * stride;
+    for (let x = 0; x < stride; x++) {
+      const a = x >= bpp ? px[dst + x - bpp] : 0,
+        b = y ? px[dst - stride + x] : 0,
+        c = x >= bpp && y ? px[dst - stride + x - bpp] : 0;
+      let v = raw[src + x];
+      if (f === 1) v += a;
+      else if (f === 2) v += b;
+      else if (f === 3) v += (a + b) >> 1;
+      else if (f === 4) {
+        const p = a + b - c,
+          pa = Math.abs(p - a),
+          pb = Math.abs(p - b),
+          pc = Math.abs(p - c);
+        v += pa <= pb && pa <= pc ? a : pb <= pc ? b : c;
+      }
+      px[dst + x] = v & 255;
+    }
+  }
+  if (bpp === 3) return { data: px, w, h };
+  const data = Buffer.alloc(w * h * 3);
+  for (let i = 0, j = 0; i < px.length; i += 4, j += 3) {
+    data[j] = px[i];
+    data[j + 1] = px[i + 1];
+    data[j + 2] = px[i + 2];
+  }
+  return { data, w, h };
+}
+const rgb = async (png) => decodePng(png);
+
+const lin = (v) => ((v /= 255) <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
+export const lum = (d, i) =>
+  0.2126 * lin(d[i]) + 0.7152 * lin(d[i + 1]) + 0.0722 * lin(d[i + 2]);
+/** The gamma-encoded grey of a pixel (0–255): browsers blend coverage in this space. */
+export const grey = (d, i) => 0.2126 * d[i] + 0.7152 * d[i + 1] + 0.0722 * d[i + 2];
+export const ratio = (a, b) => (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
+export const median = (a) => {
+  if (!a.length) return 0;
+  const s = [...a].sort((p, q) => p - q);
+  return s[s.length >> 1];
+};
+export const quantile = (a, f) => {
+  if (!a.length) return 0;
+  const s = [...a].sort((x, y) => x - y);
+  return s[Math.min(s.length - 1, Math.floor(s.length * f))];
+};
+export const maxDelta = (d1, d2, i) =>
+  Math.max(
+    Math.abs(d1[i] - d2[i]),
+    Math.abs(d1[i + 1] - d2[i + 1]),
+    Math.abs(d1[i + 2] - d2[i + 2]),
+  );
+
+/** Two rendering updates (a style tag or a mask lands before the next photograph). */
+export const settle = (page) =>
+  page.evaluate(
+    () => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))),
+  );
+
+/** Photograph `clip` twice: as is, then with `offCss` injected (removed after). Returns the decoded pair. */
+export async function onOff(page, clip, offCss) {
+  const on = await page.screenshot({ clip, scale: "device", animations: "disabled" });
+  const tag = await page.addStyleTag({ content: offCss });
+  await settle(page);
+  const off = await page.screenshot({ clip, scale: "device", animations: "disabled" });
+  await tag.evaluate((e) => e.remove());
+  await settle(page);
+  return { on: await rgb(on), off: await rgb(off) };
+}
+
+/** Page-side: the rects of the subject's TEXT RUN — its text nodes only, never an svg or a hidden
+ *  descendant (TIN/FIVE: a Range over the element counted the tape's inline svg as run, and TAIL12
+ *  landed on the svg). `chars: true` returns one rect per non-space character (the glyph windows). */
+export function textRunRects({ subject, chars = false }) {
+  const el = document.querySelector(subject);
+  if (!el) return null;
+  const out = [];
+  const tw = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
+    acceptNode(n) {
+      if (!n.textContent.trim()) return NodeFilter.FILTER_REJECT;
+      for (let p = n.parentElement; p && p !== el.parentElement; p = p.parentElement) {
+        if (p instanceof SVGElement) return NodeFilter.FILTER_REJECT;
+        const cs = getComputedStyle(p);
+        if (cs.display === "none" || cs.visibility === "hidden") return NodeFilter.FILTER_REJECT;
+      }
+      return NodeFilter.FILTER_ACCEPT;
+    },
+  });
+  for (let n = tw.nextNode(); n; n = tw.nextNode()) {
+    const r = document.createRange();
+    if (!chars) {
+      r.selectNodeContents(n);
+      for (const q of r.getClientRects())
+        if (q.width > 0) out.push({ l: q.left, t: q.top, r: q.right, b: q.bottom });
+      continue;
+    }
+    const s = n.textContent;
+    for (let i = 0; i < s.length; i++) {
+      if (!s[i].trim()) continue;
+      r.setStart(n, i);
+      r.setEnd(n, i + 1);
+      const q = r.getBoundingClientRect();
+      if (q.width > 0) out.push({ l: q.left, t: q.top, r: q.right, b: q.bottom, ch: s[i] });
+    }
+  }
+  return out;
+}
+
+/** `--key value` / `--flag` argv → an object ("1" for a bare flag). */
+export function args(argv = process.argv.slice(2)) {
+  return Object.fromEntries(
+    argv.reduce((acc, a, i, all) => {
+      if (a.startsWith("--"))
+        acc.push([
+          a.slice(2),
+          all[i + 1]?.startsWith("--") || all[i + 1] == null ? "1" : all[i + 1],
+        ]);
+      return acc;
+    }, []),
+  );
+}
+/** The box load (LAWS P6 §B: a timing row declares it). */
+export const load = () =>
+  os
+    .loadavg()
+    .map((v) => v.toFixed(2))
+    .join(" ");
+
+/** THE REGIME STOPS a paint row reads beyond the one it emulates (LAWS P7 §E (i)): both themes, the
+ *  reduced-motion setting it settles under AND `no-preference`, a coarse pointer, `prefers-contrast:
+ *  more`. Each is a Playwright context option bag plus a label. */
+const PAINT_REGIMES = [
+  { label: "light PRM fine", colorScheme: "light", reducedMotion: "reduce" },
+  { label: "dark PRM fine", colorScheme: "dark", reducedMotion: "reduce" },
+  { label: "light no-preference fine", colorScheme: "light", reducedMotion: "no-preference" },
+  { label: "dark no-preference fine", colorScheme: "dark", reducedMotion: "no-preference" },
+  { label: "light PRM coarse", colorScheme: "light", reducedMotion: "reduce", hasTouch: true },
+  { label: "light PRM contrast-more", colorScheme: "light", reducedMotion: "reduce", contrast: "more" },
+  { label: "dark PRM contrast-more", colorScheme: "dark", reducedMotion: "reduce", contrast: "more" },
+];
+/** The cells a paint CLI reads: `--regimes all` = every PAINT_REGIMES stop at the row's viewport and
+ *  DPR (LAWS P7 §E: the regime it emulates AND the ones it does not); otherwise the one cell the flags
+ *  name. Each is an `openCell` option bag with its label. */
+export function cellsOf(A) {
+  const [width, height] = (A.viewport ?? "1280x800").split("x").map(Number);
+  const dpr = +(A.dpr ?? 1);
+  if (A.regimes === "all") return PAINT_REGIMES.map((r) => ({ width, height, dpr, ...r }));
+  const one = { width, height, dpr, colorScheme: A.scheme ?? "light", reducedMotion: A.prm === "0" ? "no-preference" : "reduce", hasTouch: A.touch === "1", contrast: A.contrast ?? null };
+  return [{ ...one, label: `${one.colorScheme} ${one.reducedMotion === "reduce" ? "PRM" : "no-preference"} ${one.hasTouch ? "coarse" : "fine"}${one.contrast ? " contrast-" + one.contrast : ""}` }];
+}
+/** A context for one cell: viewport, DPR, theme, motion, pointer, contrast (emulated after open). */
+export async function openCell(
+  browser,
+  { width = 1280, height = 800, dpr = 1, colorScheme = "light", reducedMotion = "reduce", hasTouch = false, contrast = null, forcedColors = null } = {},
+) {
+  const ctx = await browser.newContext({
+    viewport: { width, height },
+    deviceScaleFactor: dpr,
+    colorScheme,
+    reducedMotion,
+    hasTouch,
+    ...(forcedColors ? { forcedColors } : {}),
+  });
+  const page = await ctx.newPage();
+  if (contrast) await page.emulateMedia({ contrast });
+  return { ctx, page };
+}
diff --git a/web/frontend/e2e/lib/postpaint.mjs b/web/frontend/e2e/lib/postpaint.mjs
new file mode 100644
index 00000000..958c9f5d
--- /dev/null
+++ b/web/frontend/e2e/lib/postpaint.mjs
@@ -0,0 +1,752 @@
+// postpaint.mjs — THE post-paint sampler and THE painted-frame recorder (T9-W7; registry-v6 §2.5,
+// LAWS P6 §D; registry-v7 §2.4 PRODUCT HOME). ONE copy: every first-frame, drift, interval, rate or
+// held-frame row reads this file (the pass-7 `painted-frames.mjs` recorder is folded in below, with
+// MOT-VERB's two PROPOSED extensions).
+//
+// I. THE SAMPLER (`installSampler`, `analyse`). A sampler registered before the product's rAF reads
+// PRE-CALLBACK state (MOT-VERB's GA1 passed 8/8 while frame 1 painted 142.9 px off). Each frame is read
+// three ways, side by side:
+//   inRAF  — in our own rAF callback (the NEGATIVE arm, printed, never gated)
+//   post   — a task queued from that rAF (MessageChannel): THE GATED READ
+//   rAF2   — rAF(() => rAF(read)): the start of frame k+1 (printed so a row that uses it knows what it reads)
+// FRAME 1 is keyed on the mover's first IntersectionObserver entry (MOT-VERB pass 7, PROPOSED → landed
+// here): the post read is a TASK, and a task the page queued earlier (a timeout that starts the mover)
+// can run between a frame's paint and that read — the read then sees a mover the frame never painted.
+// The observer is attached on the subject's first `animate()`; its entry time falls inside the first
+// rendering update the mover exists in, so frame 1 = the last rAF stamped before it, and the reads before
+// frame 1 are DROPPED and counted. A mover that never calls `animate()` (a CSS animation) is keyed on its
+// first read, and the row says so (`io: none`). The gated clauses, post-paint, BOTH engines:
+//   F1  frame 1: |centre − rest| ≤ 3 px AND |w − rest.w| ≤ 3 px
+//   CI  the clock identity for k = 2, 3: ct(frame k) = tl(k) − tl(frame 1) ± 2 ms (the FRAME clock binds,
+//       pass8/CHAIR-RULINGS §2.7d; WebKit is gated too — VERB's IO-keyed reader read CI 0 in 40/40)
+// Plants: SKIP_PLANT (every explicit startTime write lands 150 ms early → F1 reds), F2_PLANT(sel) (the
+// pass-7 critic's: frame 1 at rest, then on the SECOND rAF after the subject's animate() its clock jumps
+// 150 ms → CI reds while F1 stays green).
+//
+// II. THE RECORDER (`installTimeline`, `startPhotos`, `record`, `ladder`). Three tracks on ONE epoch clock:
+//   T  the painted TIMELINE (both engines): each rendering update's rAF stamp + a POST-PAINT read of the
+//      subject (a held frame is a rAF gap). A subject is a selector (its rect + animation currentTime),
+//      `css:<sel>:<prop>` (a computed paint property), or `ruled:<sel>` (MOT-VERB PROPOSED → landed: the
+//      RULED SUM over every match — each line's drawn fraction from its inline dash, 1 − offset/dasharray,
+//      `none` = drawn, summed: a motion spread over many elements, one after another, is one subject)
+//   P  PHOTOGRAPHS: chromium = CDP screencast (every compositor frame); webkit = page.screencast (throttled
+//      ~20/s — a coarse witness, never the frame clock). Per photograph: the mean |Δ| of the ROI against
+//      the previous one; a change is mean |Δ| > `eps` (MOT-VERB PROPOSED → landed: `--eps`, default 0.35;
+//      at 0.35 a thin stroke advancing a few px per frame over a 640 px ROI (≈ 0.005) never counts, so a
+//      slow continuous stroke reads EMPTY)
+//   L  the rAF-FROZEN LADDER: replay K times, pause every animation in rAF k after the trigger, photograph.
+// A painted clause counts only when the engine's self-test clock ≥ 55/s (chromium photographs, webkit rAF).
+//
+//   node e2e/lib/postpaint.mjs --self-test [--engine chromium|webkit]
+//   node e2e/lib/postpaint.mjs --url <u> --sel <mover> [--key g | --click <sel>] [--ready <sel>]
+//        [--plant skip|f2] [--cells desk,phone] [--reps 2] [--scheme dark]
+//   node e2e/lib/postpaint.mjs --recorder --url <u> [--trigger key:<k>|click:<sel>|load] [--roi <sel>]
+//        [--subject <sel>|css:<sel>:<prop>|ruled:<sel>] [--eps 0.35] [--window 1200]
+//        [--plant busy:<ms>@<delay>] [--held 50] [--runs 1] [--ladder K] [--out <json>] [--selftest-only]
+// Exit (sampler): 0 GREEN · 1 RED · 3 a plant GREEN (a hole) · 4 both. Exit (recorder): 0 GREEN ·
+// 1 RED (a held interval ≥ --held, or an EMPTY motion window) · 2 the self-test clock < 55.
+import process from "node:process";
+import fs from "node:fs";
+import crypto from "node:crypto";
+import { Buffer } from "node:buffer";
+import { fileURLToPath } from "node:url";
+import { resolve as resolvePath } from "node:path";
+import { playwright, args, load as loadStr, openCell } from "./paint-lib.mjs";
+
+// ------------------------------------------------------------------------------------ I. sampler
+/** Page-side. `sel` = the subject; the animation = its first WAAPI animation that is neither a CSS
+ *  transition nor a CSS animation (the product's scripted motion), or any when `anyAnim`. */
+export function installSampler({ sel, anyAnim = false, maxFrames = 240, io = true }) {
+  const w = window;
+  w.__pp = { inRAF: [], post: [], rAF2: [], stamps: [], io: null, done: false };
+  if (io) {
+    const animate = Element.prototype.animate;
+    Element.prototype.animate = function (...a) {
+      const anim = animate.apply(this, a);
+      if (w.__pp.io === null && this.matches?.(sel)) {
+        w.__pp.io = -1;
+        const ob = new IntersectionObserver((es) => {
+          w.__pp.io = es[0].time;
+          ob.disconnect();
+        });
+        ob.observe(this);
+      }
+      return anim;
+    };
+  }
+  const read = (k, tl) => {
+    const b = document.querySelector(sel);
+    if (!b) return null;
+    const a = b.getAnimations().find((x) => anyAnim || (!(x instanceof CSSTransition) && !(x instanceof CSSAnimation))) ?? null;
+    const r = b.getBoundingClientRect();
+    return { k, tl, ct: a ? Number(a.currentTime ?? 0) : null, ps: a ? a.playState : null, x: r.left + r.width / 2, y: r.top + r.height / 2, w: r.width };
+  };
+  const mc = new MessageChannel();
+  const q = [];
+  mc.port1.onmessage = () => q.shift()?.();
+  let i = 0,
+    seen = false;
+  const tick = (ts) => {
+    const k = i++;
+    // the FRAME's time (the rAF argument), not performance.now() inside the callback: WebKit stamps an
+    // IntersectionObserver entry with the rendering update's own time, which precedes any in-callback
+    // clock, so a mover started in the sampler's first frame keyed to frame −1 (pass 8, WebKit r1)
+    w.__pp.stamps[k] = ts;
+    const tl = Number(document.timeline.currentTime ?? 0);
+    const s = read(k, tl);
+    if (s) w.__pp.inRAF.push(s);
+    q.push(() => {
+      const p = read(k, tl);
+      if (p) w.__pp.post.push(p);
+    });
+    mc.port2.postMessage(0);
+    requestAnimationFrame(() =>
+      requestAnimationFrame(() => {
+        const p = read(k, tl);
+        if (p) w.__pp.rAF2.push(p);
+      }),
+    );
+    const live = s?.ct != null;
+    seen ||= live;
+    if ((seen && !live) || i >= maxFrames) setTimeout(() => (w.__pp.done = true), 200);
+    else requestAnimationFrame(tick);
+  };
+  requestAnimationFrame(tick);
+}
+
+/** The frame that first painted the mover: the last frame whose rAF time is at or before the entry. */
+export const kPaintOf = (pp) => (pp.io == null || pp.io < 0 ? -1 : pp.stamps.reduce((k, r, i) => (r <= pp.io ? i : k), -1));
+
+/** Frames with the animation present, keyed on `kPaint` (reads before it DROPPED); F1 + CI verdicts. */
+export function analyse(frames, rest, { kPaint = -1, tolPx = 3, tolMs = 2, ks = [2, 3] } = {}) {
+  const all = frames.filter((x) => x.ct !== null).sort((a, b) => a.k - b.k);
+  const f = kPaint >= 0 ? all.filter((x) => x.k >= kPaint) : all;
+  const dropped = all.length - f.length;
+  if (!f.length) return { red: true, f1red: true, ciRed: false, why: ["EMPTY: the subject never animated"], f1: null, ci: [], dropped };
+  const c = (s) => Math.hypot(s.x - rest.x, s.y - rest.y),
+    dw = (s) => s.w - rest.w;
+  const why = [];
+  const f1red = c(f[0]) > tolPx || Math.abs(dw(f[0])) > tolPx;
+  if (f1red) why.push(`F1 frame 1 at ct ${f[0].ct.toFixed(1)}: centre ${c(f[0]).toFixed(2)} px, dw ${dw(f[0]).toFixed(2)} px (> ${tolPx})`);
+  const ci = [];
+  let ciRed = false;
+  for (const k of ks) {
+    const fk = f[k - 1];
+    if (!fk) {
+      why.push(`CI frame ${k} missing`);
+      ciRed = true;
+      continue;
+    }
+    const want = fk.tl - f[0].tl;
+    const off = fk.ct - want; // the law: ct(frame k) = tl(k) − tl(frame 1), frame 1 at ct 0
+    ci.push({ k, ct: +fk.ct.toFixed(1), tlDelta: +want.toFixed(1), off: +off.toFixed(1) });
+    if (Math.abs(off) > tolMs) {
+      why.push(`CI ct(frame ${k}) ${fk.ct.toFixed(1)} vs tl(${k})−tl(1) ${want.toFixed(1)} (off ${off.toFixed(1)} ms > ${tolMs})`);
+      ciRed = true;
+    }
+  }
+  return { red: why.length > 0, f1red, ciRed, why, f1: { k: f[0].k, ct: +f[0].ct.toFixed(1), c: +c(f[0]).toFixed(2), dw: +dw(f[0]).toFixed(2), ps: f[0].ps }, ci, frames: f.length, dropped };
