+              file: rel,
+              kind: r.kind,
+              ctx: r.ctx.join(" "),
+              prelude: r.prelude,
+              prop: d.prop,
+              value: d.value,
+              important: d.important,
+              line: d.line,
+              varLed: d.prop !== prop && /^\s*var\(/.test(d.value),
+              regimes: regimesOf(r.ctx),
+            });
