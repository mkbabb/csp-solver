+
+/** The verdict of one recording: chromium's primary track = photographs; webkit's = the subject (or rAF). */
+export function verdict(r, engine, { held = 50, subject = null } = {}) {
+  const primary = engine === "chromium" ? r.photos.maxHeldMs : subject ? r.subjectMaxMs : r.timeline.maxGapMs;
+  const empty = engine === "chromium" ? r.photos.changed < 2 : subject ? r.subjectMovedFrames < 1 : r.timeline.rafs < 2;
+  return { red: empty || primary >= held, empty, primary, track: engine === "chromium" ? "photo" : subject ? "subject" : "rAF" };
+}
+
+/** The rAF-frozen photograph ladder: replay, pause every animation in rAF k after the trigger, photograph. */
+export async function ladder(browser, o, K = 4) {
+  const out = [];
+  for (let k = 1; k <= K; k++) {
+    const ctx = await browser.newContext({ viewport: o.viewport, deviceScaleFactor: o.dpr ?? 1, colorScheme: o.scheme ?? "light", reducedMotion: "no-preference", hasTouch: !!o.touch });
+    const page = await ctx.newPage();
+    await page.goto(o.url);
+    if (o.ready) await page.locator(o.ready).first().waitFor({ timeout: 30000 });
+    await page.evaluate(() => document.fonts.ready);
+    await page.waitForTimeout(o.settleMs ?? 1500);
+    await page.evaluate(
+      ({ k, sel }) => {
+        const w = window;
+        w.__lad = null;
+        let n = 0;
+        // frame 1 = the first rAF in which the SUBJECT carries a running or paused (held) animation
+        const live = () => {
+          if (!sel) return true;
+          const el = document.querySelector(sel);
+          return !!el?.getAnimations().some((a) => a.playState === "running" || a.playState === "paused");
+        };
+        const arm = () =>
+          requestAnimationFrame(function f() {
+            if (!live() && n === 0) return requestAnimationFrame(f);
+            if (++n < k) return requestAnimationFrame(f);
+            const anims = document.getAnimations();
+            anims.forEach((a) => a.pause());
+            const el = sel ? document.querySelector(sel) : null;
+            const r = el?.getBoundingClientRect();
+            w.__lad = { k, anims: anims.length, ct: anims.map((a) => Number(a.currentTime ?? NaN)).slice(0, 4), rect: r ? [r.left, r.top, r.width, r.height].map((v) => +v.toFixed(2)) : null };
+          });
+        addEventListener("keydown", arm, { once: true, capture: true });
+        addEventListener("pointerdown", arm, { once: true, capture: true });
+      },
+      { k, sel: o.subject ?? null },
+    );
+    if (o.trigger?.startsWith("key:")) await page.keyboard.press(o.trigger.slice(4));
+    else if (o.trigger?.startsWith("click:")) await page.locator(o.trigger.slice(6)).first().click();
+    await page.waitForFunction(() => window.__lad, null, { timeout: 5000 }).catch(() => {});
+    const lad = await page.evaluate(() => window.__lad);
+    const shot = o.roi ? await page.locator(o.roi).first().screenshot().catch(() => null) : await page.screenshot();
+    out.push({ ...lad, shotBytes: shot?.length ?? 0, shotSha: shot ? crypto.createHash("sha1").update(shot).digest("hex").slice(0, 10) : null });
+    await ctx.close();
+  }
+  return out;
+}
+
+/** The recorder's self-test beyond the clock: VERB's two extensions, each with its plant.
+ *  RULED: 21 lines ruled one after another (inline dash offsets from a rAF loop); `ruled:.rl` must see
+ *  the motion, the legacy subject `.rl` (the first line's rect) reads EMPTY.
+ *  EPS (chromium: photographs are its primary track): a 2 px stroke growing 3 px per frame across a
+ *  640 × 360 ROI; at eps 0.35 the window is EMPTY, at `--eps 0.001` it is seen, and a 150 ms busy plant
+ *  inside it reds the held clause. */
+const RULED = `<!doctype html><html><head><style>body{margin:0;background:#fbf8f1}svg{position:absolute;left:20px;top:20px}</style></head><body>
+<svg width="640" height="360" id="roi">${Array.from({ length: 21 }, (_, i) => `<line class="rl" x1="10" x2="630" y1="${12 + i * 16}" y2="${12 + i * 16}" stroke="#3b3833" stroke-width="2" style="stroke-dasharray: 620; stroke-dashoffset: 620"/>`).join("")}
+<line id="grow" x1="10" x2="10" y1="350" y2="350" stroke="#3b3833" stroke-width="2"/></svg>
+<script>
+  addEventListener("keydown", (e) => {
+    const t0 = performance.now();
+    if (e.key === "r") {
+      const ls = [...document.querySelectorAll(".rl")];
+      const f = () => { const u = (performance.now() - t0) / 30; ls.forEach((l, i) => l.style.strokeDashoffset = String(620 * (1 - Math.max(0, Math.min(1, u - i))))); if (u < ls.length) requestAnimationFrame(f); };
+      requestAnimationFrame(f);
+    }
+    if (e.key === "g") {
+      const g = document.getElementById("grow");
+      const f = () => { const x = 10 + Math.min(600, ((performance.now() - t0) / 16.7) * 3); g.setAttribute("x2", String(x)); if (x < 610) requestAnimationFrame(f); };
+      requestAnimationFrame(f);
+    }
+  });
+</script></body></html>`;
+
+export async function recorderSelfTest(browser, engine) {
+  const rows = [];
+  let hole = false;
+  const base = { html: RULED, viewport: { width: 700, height: 420 }, settleMs: 200, windowMs: 1000, heldMs: 50 };
+  const ruled = await record(browser, engine, { ...base, trigger: "key:r", subject: "ruled:.rl" });
+  const legacy = await record(browser, engine, { ...base, trigger: "key:r", subject: ".rl" });
+  if (ruled.subjectMovedFrames < 10) hole = true;
+  rows.push(`RECORDER self-test ${engine} RULED ruled:.rl moved ${ruled.subjectMovedFrames} frames over ${ruled.motionMs} ms (subject max interval ${ruled.subjectMaxMs} ms) ${ruled.subjectMovedFrames >= 10 ? "SEEN" : "NOT SEEN ← a hole"} | LEGACY .rl moved ${legacy.subjectMovedFrames} ${legacy.subjectMovedFrames < 1 ? "EMPTY ← the hole ruled: closes" : "(seen)"}`);
+  if (engine === "chromium") {
+    const e35 = await record(browser, engine, { ...base, trigger: "key:g", roi: "#roi" });
+    const e1 = await record(browser, engine, { ...base, trigger: "key:g", roi: "#roi", eps: 0.001 });
+    const plant = await record(browser, engine, { ...base, trigger: "key:g", roi: "#roi", eps: 0.001, plant: { busyMs: 150, delayMs: 300 } });
+    const v35 = verdict(e35, engine),
+      v1 = verdict(e1, engine),
+      vp = verdict(plant, engine);
+    if (v1.red || !vp.red) hole = true;
+    rows.push(`RECORDER self-test ${engine} EPS eps 0.35: changed ${e35.photos.changed}/${e35.photos.photos} (Δ median ${e35.photos.deltaMedian}) → ${v35.red ? "RED" + (v35.empty ? " EMPTY" : "") : "GREEN"} ← the legacy threshold | eps 0.001: changed ${e1.photos.changed}/${e1.photos.photos} maxHeld ${e1.photos.maxHeldMs} ms → ${v1.red ? "RED ← a hole (clean)" : "GREEN"} | eps 0.001 + busy 150@300: maxHeld ${plant.photos.maxHeldMs} ms plant seen photo ${plant.plantSeen.photo ? "YES" : "NO"} → ${vp.red ? "RED" : "GREEN ← a hole"}`);
+  }
+  return { rows, exit: hole ? 3 : 0 };
+}
+
+// ------------------------------------------------------------------------------------------ CLI
+if (process.argv[1] && fileURLToPath(import.meta.url) === resolvePath(process.argv[1])) {
+  const A = args();
+  const engine = A.engine ?? "chromium";
+  const browser = await playwright()[engine].launch();
+  let exit;
+  if (A["self-test"]) {
+    const s = await samplerSelfTest(browser);
