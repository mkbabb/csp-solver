+  const cell = async (v, { touch = false, plant = null, w = 390, h = 844 } = {}) => {
+    const { ctx, page } = await openCell(browser, { width: w, height: h, hasTouch: touch });
+    await page.setContent(FIXTURE(v));
+    if (plant === "relabel") await page.evaluate(RELABEL); // setContent commits no navigation: no init script runs
