+  ["1280×800 coarse (hasTouch), armed", RAIL_COARSE, true],
+  ["390×844 coarse, settled", coarse(390, 844), false],
+] as const) {
+  test.describe(`M17 G5 — Deal and its receipt stand on one line (${label})`, () => {
+    test.use(use);
