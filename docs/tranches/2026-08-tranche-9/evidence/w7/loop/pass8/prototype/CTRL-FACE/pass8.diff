index 00000000..6210a821
--- /dev/null
+++ b/web/frontend/e2e/face-law.spec.ts
@@ -0,0 +1,2322 @@
+import { test, expect, devices, type Locator, type Page } from "@playwright/test";
+import { mkdirSync, readdirSync, readFileSync, statSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { fourBands, EDGE_PLANTS, type FourBands as Bands } from "./lib/edge-bands.mjs";
+import { onOff } from "./lib/paint-lib.mjs";
+
+// PRM: frozen — emulateMedia({reducedMotion:'reduce'}) before goto (loadCard, below)
+//
+/**
+ * T9-W7 CTRL-FACE — THE FACE LAW, as gates.
+ *
+ * The family's claim is that the controls card is a PRINTED SHEET A READER HAS WRITTEN ON: its
+ * eight compartment names are the sheet's own printing (Fraunces 800 lowercase at one rung) and
+ * everything under them is the reader's hand (Patrick Hand 400 lowercase). Until this file that
+ * claim lived entirely in a research lane's numbers — the pass-2 critique's blocking finding,
+ * F1: fifteen rows of law, five of which the estate had actually acquired. A rung change on
+ * `--type-group-title` redded nothing. These are the other ten.
+ *
+ * TWO OF THEM REPLACE READINGS THAT COULD NOT FAIL, and that is why they are shaped oddly:
+ *
+ *   · THE MARK. `background-size: 120%` on a span whose content box IS the word's box divides
+ *     a box by itself — 1.200 at any face, any rung, any word. And the estate's other pricing,
+ *     `${label.length + 1}ch`, is not engine-portable here at all: Fira Code's subset carries
+ *     no `0`, so `ch` falls back to 0.5em and measures 12.0016px on chromium against 10.0000 on
+ *     webkit — one chip's mark 48.01 vs 40.00, a 16.7% split shipped today. So the gate is not
+ *     a ratio. It is (a) the mark is derived from the WORD's advance, which is what makes the
+ *     two engines agree, and (b) the mark's PAINTED columns run past the glyph's painted
+ *     columns by 2–8px each side, read off the chip's own bitmap. WebKit's
+ *     `actualBoundingBoxLeft/Right` is the advance box, not the glyph ink, so there is no API
+ *     for (b) and it is measured the only honest way: three screenshots of one chip, differenced.
+ *
+ *   · `-1lh`. Grepping the built CSS for the token cannot fail — Lightning CSS does not
+ *     down-level a unit at any target, so `calc(-1lh - …)` is emitted verbatim whatever the
+ *     floor is. That grep is kept below, LABELLED as a regression guard rather than a gate, and
+ *     the row that can fail moved to `scripts/check-support-floor.mjs` check 6, where the
+ *     browserslist floor is re-derived against the unit the way check 2 re-derives Lightning's.
+ *
+ * EVERY NUMBER HERE IS A DERIVATION OR A FLOOR, never a recorded constant: the printed count is
+ * `tapes + captions + sections.length`, the mark is the word + 8, the paper-over-glyph band is
+ * per-word and measured in place. A constant would pin the card at one rung and call that a law.
+ */
+
+/* Gate (i)'s cross-engine census: each project ATTACHES one of these to its run and
+   `scripts/check-face-engine-identity.mjs` REQUIRES both of them. Two Playwright projects
+   cannot read each other inside one run, so the comparison is a node gate, not a test.
+   It is a FILE and not a `test.info().attach()`: an attachment given a `body` lives in the
+   REPORT and never reaches disk, so the gate would depend on which reporter the caller picked.
+   `e2e/node.d.ts` gains the two write forms with that reason written where the shim is. */
+const ENGINE_DIR = join(fileURLToPath(new URL("../.face-engine", import.meta.url)));
+/* PASS 5 — the census is STAMPED; PASS 8 — with the digest the last BUILD wrote over its own
+   module graph (`.face-engine/dist-stamp.json`, vite.config.ts `face-stamp`; LAWS P7 §F: never a
+   hand list). The gate re-hashes that graph from disk, so a census taken before an edit to ANY file
+   the build read reds. The census lives OUTSIDE `test-results/`, which every Playwright run wipes. */
+const ENGINE_STAMP = (() => {
+  try {
+    return JSON.parse(readFileSync(join(ENGINE_DIR, "dist-stamp.json"), "utf8")).stamp ?? null;
+  } catch {
+    return null; // no build: the gate reds "no build graph"
+  }
+})();
+
+const CARD = ".controls-card";
+/* THE DESK KEEPS A HIDDEN TWIN of the card in the DOM (the drawer's copy), so every read below
+   takes the card that has client rects rather than the first one `querySelector` finds. */
+
+/** The phone descriptor's traits only — `browserName` cannot move inside a describe group. */
+const phone = devices["iPhone 13"];
+const coarse = (w: number, h: number) => ({
+  viewport: { width: w, height: h },
+  deviceScaleFactor: phone.deviceScaleFactor,
+  isMobile: phone.isMobile,
+  hasTouch: phone.hasTouch,
+});
+
+/** Load a board, hide dev chrome, open the dock sheet if there is one, and let it SETTLE. */
+async function loadCard(page: Page, query = "size=3&difficulty=EASY") {
+  await page.emulateMedia({ reducedMotion: "reduce" });
+  await page.goto("./?" + query);
+  await page.waitForSelector("svg.handwritten-logo", { timeout: 20000 });
+  await page.addStyleTag({ content: ".tuner-toggle { display: none !important; }" });
+  // THE CARD IS REACHED TWO WAYS AND THE CELL DECIDES WHICH. On the rail it is already on the
+  // page; on the dock it is behind the sheet the tab opens. The tab EXISTS at both (it is the
+  // rail's fold handle too), so the route is chosen by whether a visible card is already there,
+  // never by the cell's name — and `tap()` is only legal on a context with touch.
+  const visibleCard = page.locator(`${CARD}:visible`).first();
+  if (!(await visibleCard.isVisible().catch(() => false))) {
+    const tab = page.locator(".drawer-tab");
+    const touch = await page.evaluate(
+      () => "ontouchstart" in window || navigator.maxTouchPoints > 0,
+    );
+    await (touch ? tab.tap() : tab.click());
+    await expect(page.locator("#controls-drawer .drawer-case")).toBeVisible();
+    // THE SHEET SLIDES. The Band-D glide's own clock is 520ms and the settle after it is not
+    // instantaneous; every geometry row below is read on the settled pose, never during it.
+    await page.waitForTimeout(700);
+  }
+  await expect(visibleCard).toBeVisible({ timeout: 20000 });
+}
+
+/** One voice = family · rung · weight · casing, the four things a face law is about. */
+const VOICE = `(el) => {
+  const s = getComputedStyle(el);
+  return [s.fontFamily.split(",")[0].replace(/["']/g, "").trim(),
+          Math.round(parseFloat(s.fontSize) * 1000) / 1000,
+          s.fontWeight, s.textTransform].join(" · ");
+}`;
+
+
+/**
+ * THE PAINTED EXTENT OF ONE LAYER, read by differencing two crops of the SAME element: the
+ * element as it ships, and the element with `suppress` applied. Columns (default) or rows
+ * (`byRow`) where the two bitmaps disagree are exactly the pixels that layer painted.
+ *
+ * There is no API for this. WebKit's `actualBoundingBoxLeft/Right` returns the ADVANCE box, so
+ * a glyph-ink question asked through canvas metrics gets the answer to a different question,
+ * and a `Range` box is the font's ascent+descent -- which at the display leading (1.05) sits
+ * OUTSIDE the tape's own paper while every letter is visibly inside it (measured on this tree:
+ * -2.53/-1.36 chromium, -1.91/-1.91 webkit). The bitmap is the only basis that answers what is
+ * actually drawn, and it is the same instrument for a mark and for a word.
+ */
+async function paintedExtent(
+  page: Page,
+  target: Locator,
+  suppress: string,
+  byRow = false,
+): Promise<{ lo: number; hi: number }> {
+  // THE SETTLE IS TWO FRAMES, NOT A CLOCK. A style injected here lands on the frame the engine
+  // schedules next; a fixed wait would be a proxy for that frame, and a proxy that is too short
+  // differences a bitmap against itself and reports "this layer painted nothing".
+  const twoFrames = () =>
+    page.evaluate(
+      () =>
+        new Promise<void>((r) =>
+          requestAnimationFrame(() => requestAnimationFrame(() => r())),
+        ),
+    );
+  const A = await target.screenshot();
+  const handle = await page.addStyleTag({ content: suppress });
+  await twoFrames();
+  const B = await target.screenshot();
+  await handle.evaluate((n) => (n as unknown as HTMLElement).remove());
+  await twoFrames();
+
+  return page.evaluate(
+    async ({ a, b, rowWise }) => {
+      const load = (d: string) =>
+        new Promise<HTMLImageElement>((res) => {
+          const i = new Image();
+          i.onload = () => res(i);
+          i.src = d;
+        });
+      const [ia, ib] = await Promise.all([load(a), load(b)]);
+      const c = document.createElement("canvas");
+      c.width = ia.width;
+      c.height = ia.height;
+      const g = c.getContext("2d")!;
+      g.drawImage(ia, 0, 0);
+      const da = g.getImageData(0, 0, c.width, c.height).data;
+      g.clearRect(0, 0, c.width, c.height);
+      g.drawImage(ib, 0, 0);
+      const db = g.getImageData(0, 0, c.width, c.height).data;
+      let lo = Infinity;
+      let hi = -Infinity;
+      const outer = rowWise ? c.height : c.width;
+      const inner = rowWise ? c.width : c.height;
+      for (let o = 0; o < outer; o++)
+        for (let n = 0; n < inner; n++) {
+          const x = rowWise ? n : o;
+          const y = rowWise ? o : n;
+          const i = (y * c.width + x) * 4;
+          const d =
+            Math.abs(da[i] - db[i]) +
+            Math.abs(da[i + 1] - db[i + 1]) +
+            Math.abs(da[i + 2] - db[i + 2]);
+          if (d > 24) {
+            if (o < lo) lo = o;
+            if (o > hi) hi = o;
+            break;
+          }
+        }
+      return { lo, hi };
+    },
+    {
+      a: `data:image/png;base64,${A.toString("base64")}`,
+      b: `data:image/png;base64,${B.toString("base64")}`,
+      rowWise: byRow,
+    },
+  );
+}
+
+/* ══ 1 · THE EIGHT NAMES ARE ONE VOICE, AND THE COUNT IS A DERIVATION ══════════════════════ */
+
+for (const [label, use] of [
+  ["desk 1280 fine", {}],
+  ["dock 390×844 coarse", coarse(390, 844)],
+  ["landscape 900×500 coarse", coarse(900, 500)],
+] as const) {
+  test.describe(`the printed voice — ${label}`, () => {
+    test.use(use);
+
+    test("one voice over every printed name, and the count derives", async ({ page }) => {
+      await loadCard(page);
+      const read = await page.evaluate(
+        ({ card, voiceSrc }) => {
+          const voice = eval(voiceSrc) as (el: Element) => string;
+          const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!;
+          const tapes = [...root.querySelectorAll(".washi-tag")];
+          const captions = [...root.querySelectorAll(".zone-row-label")];
+          const sections = [...root.querySelectorAll(".section-heading")];
+          const printed = [...tapes, ...captions, ...sections];
+          const chip = root.querySelector(".ctrl-btn");
+          return {
+            voices: [...new Set(printed.map(voice))],
+            n: printed.length,
+            tapes: tapes.length,
+            captions: captions.length,
+            sections: sections.length,
+            ratio: chip
+              ? Math.round(
+                  (parseFloat(getComputedStyle(printed[0]).fontSize) /
+                    parseFloat(getComputedStyle(chip).fontSize)) *
+                    10000,
+                ) / 10000
+              : null,
+          };
+        },
+        { card: CARD, voiceSrc: VOICE },
+      );
+
+      test.info().annotations.push({
+        type: "printed-voice",
+        description: `${read.voices.join(" | ")} · n=${read.n} (${read.tapes} tapes + ${read.captions} captions + ${read.sections} sections) · name/option ${read.ratio}`,
+      });
+
+      // ONE VOICE. Not "one family" — a name that agrees on the face and disagrees on the rung
+      // is two voices to a reader, which is exactly what HEAD ships (three, at the dock).
+      expect(read.voices, "the printed names speak with one voice").toHaveLength(1);
+      expect(read.voices[0]).toMatch(/^Fraunces · [\d.]+ · 800 · lowercase$/);
+
+      // THE COUNT (pass 4 — the pass-3 form could not fail). It asserted
+      // `n === tapes + captions + sections` where `printed = [...tapes, ...captions,
+      // ...sections]` and `n = printed.length`: the same list counted twice, an identity of
+      // arithmetic that no edit to this card could ever red. `sections.length` was never
+      // asserted at all, so the sentence this spec's own header states — "8 dies at a sixth
+      // game" — was in the prose and not in the file.
+      // What is asserted now: the three populations, and THE TOTAL AS A LITERAL 8. All five
+      // games ship exactly two `ControlSection`s, four compartment tapes and two row captions,
+      // so 8 is the card's whole printed roster with zero headroom. A sixth game, a third
+      // compartment or a third row caption moves this number in the commit that adds it —
+      // which is the point: the reader of that commit is told the roster changed.
+      expect(read.tapes, "the four compartment tapes").toBe(4);
+      expect(read.captions, "the two row captions").toBe(2);
+      expect(read.sections, "the two control sections").toBe(2);
+      expect(read.n, "the printed roster is EIGHT names, and 8 dies at a sixth game").toBe(8);
+
+      // ROW 3 — the name over the thing it names. At HEAD the phone reads 1.0175 (a 20.35px
+      // name over a 20px chip): one size for both, which is the mark M03 names.
+      expect(read.ratio!, "the printed name outranks the option it names").toBeGreaterThan(1.2);
+    });
+  });
+}
+
+/* PASS 5 — "8 dies at a sixth game" was asserted on the sudoku card alone. The roster is the
+   card's structure, not the board's, so this row reads each game's own card at the desk by
+   `?game=` (board-independent: no deal is compared, so no `?board=` is owed) and asserts the same
+   three populations and the literal 8 on all five. */
+test.describe("the printed roster — every game, 1280 fine", () => {
+  for (const game of ["sudoku", "futoshiki", "thermo", "killer", "kenken"]) {
+    test(`${game}: four tapes, two captions, two sections — eight names`, async ({ page }) => {
+      await loadCard(page, `game=${game}`);
+      const read = await page.evaluate((card) => {
+        const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!;
+        return {
+          title: document.title,
+          tapes: root.querySelectorAll(".washi-tag").length,
+          captions: root.querySelectorAll(".zone-row-label").length,
+          sections: root.querySelectorAll(".section-heading").length,
+        };
+      }, CARD);
+      test.info().annotations.push({
+        type: "printed-roster",
+        description: `${game}: ${read.tapes} + ${read.captions} + ${read.sections} = ${read.tapes + read.captions + read.sections}`,
+      });
+      expect(read.title, "the route dealt this game's card").toContain(game);
+      expect(read.tapes, `${game}: the four compartment tapes`).toBe(4);
+      expect(read.captions, `${game}: the two row captions`).toBe(2);
+      expect(read.sections, `${game}: the two control sections`).toBe(2);
+      expect(read.tapes + read.captions + read.sections, `${game}: EIGHT printed names`).toBe(8);
+    });
+  }
+});
+
+/* ══ 2 · A CAPTION IS ONE LINE ═════════════════════════════════════════════════════════════ */
+
+for (const [label, use] of [
+  ["320×568", coarse(320, 568)],
+  ["360×740", coarse(360, 740)],
+  ["375×812", coarse(375, 812)],
+  ["390×844", coarse(390, 844)],
+  ["430×932", coarse(430, 932)],
+  ["900×500", coarse(900, 500)],
+] as const) {
+  test.describe(`the caption lane — ${label}`, () => {
+    test.use(use);
+
+    // PASS 4 — THE LINE COUNT IS GONE AND THE USED WIDTH IS THE QUESTION.
+    // Pass 3 asserted `whiteSpace === "nowrap"`, then `lines === 1`, then `h <= lh + 0.5`. Under
+    // `nowrap` the second and third are CONSEQUENCES of the first, so the row could only red by
+    // deleting the rule it had just asserted — and the ablation the lane cited (`white-space:
+    // normal`) tripped the `nowrap` assertion first and never reached them. Worse, the failure
+    // mode `nowrap` actually creates was measured nowhere: `flex: 0 0 3.75rem` is NOT a fixed
+    // width while `min-width: auto` stands, so the column the CSS comment claimed had silently
+    // become min-content (60.00 → 87.00 / 120.69; right edges 33.69px apart where HEAD's shared
+    // one edge). What is gated here now is exactly that: the USED WIDTH against an offscreen
+    // clone of the same computed face at the same rung, the two captions' shared LEFT edge, and
+    // each caption's RIGHT edge against the strip it must not lap. The born-RED for the first is
+    // in this same run — the column is restored by inline style and the row is re-read.
+    const measure = (card: string) => {
+      const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!;
+      const px = (n: number) => Math.round(n * 100) / 100;
+      return [...root.querySelectorAll(".zone-row-label")].map((c) => {
+        const el = c as HTMLElement;
+        const s = getComputedStyle(el);
+        const r = el.getBoundingClientRect();
+        const strip = el.parentElement!.querySelector(".options-row");
+        const chips = el.parentElement!.querySelectorAll(".ctrl-btn").length;
+        // MIN-CONTENT OFF A CLONE, not off a token: the same text through the same computed
+        // face, rung, weight, tracking and transform, laid out with `width: max-content` where
+        // no flex container can touch it. This is the number the flex item's automatic minimum
+        // size resolves to, and it is what makes "the used width is the word" falsifiable.
+        const probe = document.createElement("span");
+        probe.textContent = el.textContent;
+        for (const p of [
+          "font-family",
+          "font-size",
+          "font-weight",
+          "font-style",
+          "letter-spacing",
+          "word-spacing",
+          "text-transform",
+          "font-feature-settings",
+          "font-variant",
+        ])
+          probe.style.setProperty(p, s.getPropertyValue(p));
+        probe.style.cssText +=
+          ";position:absolute;left:-9999px;top:0;width:max-content;white-space:nowrap;";
+        document.body.appendChild(probe);
+        const minContent = px(probe.getBoundingClientRect().width);
+        probe.remove();
+        return {
+          text: el.textContent!.trim(),
+          w: px(r.width),
+          minContent,
+          left: px(r.left),
+          right: px(r.right),
+          whiteSpace: s.whiteSpace,
+          chips,
+          stripLeft: strip ? px(strip.getBoundingClientRect().left) : null,
+          stripW: strip ? px(strip.getBoundingClientRect().width) : null,
+          sameLine: strip ? Math.abs(strip.getBoundingClientRect().top - r.top) < 12 : false,
+        };
+      });
+    };
+
+    test("every row caption's box IS its word, and the two begin on one edge", async ({ page }) => {
+      await loadCard(page);
+      const rows = await page.evaluate(measure, CARD);
+
+      test.info().annotations.push({
+        type: "caption-lane",
+        description: rows
+          .map(
+            (r) =>
+              `"${r.text}" used ${r.w} vs min-content ${r.minContent} · x ${r.left}→${r.right} · ${r.chips} chips at ${r.stripLeft} (w ${r.stripW}, ${r.sameLine ? "same line" : "next line"})`,
+          )
+          .join(" · "),
+      });
+
+      for (const r of rows) {
+        // (a) THE USED WIDTH IS THE WORD. Not a basis, not a rem constant — the rendered word.
+        expect(r.whiteSpace, `"${r.text}" is held to one line by its own rule`).toBe("nowrap");
+        expect(
+          Math.abs(r.w - r.minContent),
+          `"${r.text}" used width ${r.w} IS its min-content ${r.minContent}`,
+        ).toBeLessThanOrEqual(0.5);
+        // (b) THE CAPTION NEVER LAPS ITS CHIPS. The right edge is free to be the word's own, but
+        // only while the strip beside it starts clear of it. This is the row that reds if a
+        // longer caption is ever minted at this rung and the row stops wrapping in time.
+        if (r.stripLeft !== null && r.sameLine)
+          expect(
+            r.stripLeft,
+            `"${r.text}" ends at ${r.right} and its strip starts clear of it`,
+          ).toBeGreaterThanOrEqual(r.right - 0.5);
+        // (c) a row with chips must still hold two at the 44px tap floor plus the row's 0.5rem
+        // gap — 95.2px. Below that the caption has taken room the controls need.
+        if (r.chips >= 2)
+          expect(
+            r.stripW!,
+            `"${r.text}"'s chip strip holds two 44px chips and their gap`,
+          ).toBeGreaterThanOrEqual(95.2);
+      }
+
+      // (d) THE SHARED AXIS IS THE LEFT ONE. Both captions are the first item of their own row,
+      // so they begin together; they end where their words end, 33.69px apart at the printed
+      // rung, and the CSS no longer claims otherwise.
+      if (rows.length >= 2) {
+        const lefts = rows.map((r) => r.left);
+        expect(
+          Math.max(...lefts) - Math.min(...lefts),
+          "the captions begin on one edge",
+        ).toBeLessThanOrEqual(0.5);
+      }
+
+      // ── BORN-RED, in this same run ─────────────────────────────────────────────────────────
+      // Restore the column the comment used to claim (`flex-basis: 3.75rem` with `min-width: 0`,
+      // which is the only form that actually fixes the width) and read (a) again. If this row
+      // does not go red, (a) cannot fail and the gate is struck.
+      const ablated = await page.evaluate((card) => {
+        const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!;
+        for (const el of root.querySelectorAll(".zone-row-label"))
+          (el as HTMLElement).style.cssText += ";flex:0 0 3.75rem;min-width:0;";
+        return [...root.querySelectorAll(".zone-row-label")].map((el) => ({
+          text: el.textContent!.trim(),
+          w: Math.round(el.getBoundingClientRect().width * 100) / 100,
+        }));
+      }, CARD);
+      const widest = rows.reduce((a, b) => (b.minContent > a.minContent ? b : a));
+      const under = ablated.find((a) => a.text === widest.text)!;
+      test.info().annotations.push({
+        type: "caption-lane-ablation",
+        description: `flex:0 0 3.75rem + min-width:0 → ${ablated.map((a) => `"${a.text}" ${a.w}`).join(", ")} (min-content ${rows.map((r) => r.minContent).join("/")})`,
+      });
+      expect(
+        Math.abs(under.w - widest.minContent),
+        `the negative control: a real 60px column makes "${widest.text}" NOT its word`,
+      ).toBeGreaterThan(0.5);
+    });
+  });
+}
+
+/* ══ 3 · THE INK GATE, THE DAYLIGHT, AND THE PAPER OVER EACH TAPE ══════════════════════════ */
+
+for (const [label, use] of [
+  ["390×844", coarse(390, 844)],
+  ["375×812", coarse(375, 812)],
+  ["430×932", coarse(430, 932)],
+  ["900×500", coarse(900, 500)],
+] as const) {
+  test.describe(`the clearances — ${label}`, () => {
+    test.use(use);
+
+    test("a tape's paper clears the ink above it, and clears the tab head", async ({ page }) => {
+      await loadCard(page);
+      const read = await page.evaluate((card) => {
+        const px = (n: number) => Math.round(n * 100) / 100;
+        const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!;
+        /** The INK box — a Range over the text, which is the painted advance, not the line box. */
+        const ink = (el: Element) => {
+          const r = document.createRange();
+          r.selectNodeContents(el);
+          return r.getBoundingClientRect();
+        };
+        const tapes = [...root.querySelectorAll(".washi-tag")] as HTMLElement[];
+        const captions = [...root.querySelectorAll(".zone-row-label")] as HTMLElement[];
+
+        // PAPER OVER GLYPH, PER TAPE. The paper-over-RANGE number is the tape's own padding
+        // (1.36–1.53 across the four, a constant of the component); the GLYPH basis is the one
+        // that moves with the face, 7.73 (`pencils`) to 12.16 (`new game`) at this rung, so a
+        // single band across four words would be a band that admits everything.
+        const perTape = tapes.map((t) => {
+          const p = t.getBoundingClientRect();
+          const i = ink(t);
+          return { text: t.textContent!.trim(), top: px(i.top - p.top), bottom: px(p.bottom - i.bottom) };
+        });
+
+        // THE INK GATE. A tape sits under the row caption above it; its PAPER must clear that
+        // caption's INK, and must still clear it for a word with a descender the caption does
+        // not happen to contain.
+        const gates: Record<string, unknown>[] = [];
+        for (const cap of captions) {
+          const ci = ink(cap);
+          const below = tapes
+            .map((t) => ({ t, b: t.getBoundingClientRect() }))
+            .filter((x) => x.b.top >= ci.bottom - 0.5)
+            .sort((a, b) => a.b.top - b.b.top)[0];
+          if (!below) continue;
+          // THE WORST DESCENDER, AS A FONT METRIC AND NOT A POSITION. Two spans pinned at the
+          // SAME absolute coordinate in the caption's own face and rung — one carrying the
+          // caption's word, one carrying `pgjqy` — and the difference of their ink bottoms is
+          // how much further down this face can draw at this size. Appending one probe into
+          // flow and subtracting the caption's own box (the first form of this) measures the
+          // probe's position instead of the face's depth, and reads a different number in each
+          // engine for that reason.
+          const s = getComputedStyle(cap);
+          const mk = (t: string) => {
+            const el = document.createElement("span");
+            el.textContent = t;
+            el.style.cssText =
+              "position:fixed;top:0;left:0;visibility:hidden;white-space:nowrap;margin:0;padding:0";
+            el.style.font = `${s.fontStyle} ${s.fontWeight} ${s.fontSize}/${s.lineHeight} ${s.fontFamily}`;
+            document.body.appendChild(el);
+            const r = document.createRange();
+            r.selectNodeContents(el);
+            const b = r.getBoundingClientRect().bottom;
+            el.remove();
+            return b;
+          };
+          const drop = Math.max(0, mk("pgjqy") - mk(cap.textContent!.trim()));
+          gates.push({
+            caption: cap.textContent!.trim(),
+            tape: below.t.textContent!.trim(),
+            clearance: px(below.b.top - ci.bottom),
+            worstCase: px(below.b.top - ci.bottom - drop),
+          });
+        }
+
+        // THE TAB HEAD. The first tape is PINNED at rest and the tab row sits over it: the
+        // tape's paper must not reach the head's ink, and the two boxes must not intersect.
+        const heads = [...root.querySelectorAll(".mobile-heading-btn .section-heading")];
+        const first = tapes[0]?.getBoundingClientRect();
+        const daylight = heads.map((h) => {
+          const hi = ink(h);
+          const hb = h.getBoundingClientRect();
+          return {
+            head: h.textContent!.trim(),
+            gap: first ? px(hi.top - first.bottom) : null,
+            area: first
+              ? px(
+                  Math.max(0, Math.min(first.bottom, hb.bottom) - Math.max(first.top, hb.top)) *
+                    Math.max(0, Math.min(first.right, hb.right) - Math.max(first.left, hb.left)),
+                )
+              : null,
+          };
+        });
+        return { perTape, gates, daylight };
+      }, CARD);
+
+      test.info().annotations.push({
+        type: "clearances",
+        description:
+          read.gates
+            .map((g) => `${g.tape}/${g.caption} +${g.clearance} (worst +${g.worstCase})`)
+            .join(" · ") +
+          " | daylight " +
+          read.daylight.map((d) => `${d.head} +${d.gap} ${d.area}px²`).join(" · ") +
+          " | paper/glyph " +
+          read.perTape.map((t) => `${t.text} ${t.top}/${t.bottom}`).join(" · "),
+      });
+
+      for (const g of read.gates as { caption: string; tape: string; clearance: number; worstCase: number }[]) {
+        expect(g.clearance, `${g.tape}'s paper over "${g.caption}"'s ink`).toBeGreaterThanOrEqual(2.0);
+        expect(g.worstCase, `${g.tape}'s paper over a descender in "${g.caption}"`).toBeGreaterThanOrEqual(0.5);
+      }
+      for (const d of read.daylight as { head: string; gap: number; area: number }[]) {
+        expect(d.gap, `the first tape's paper under "${d.head}"`).toBeGreaterThanOrEqual(2.0);
+        expect(d.area, `the first tape does not touch "${d.head}"`).toBe(0);
+      }
+      // NO ASSERTION ON `perTape` HERE, AND THE REASON IS THE READING ITSELF. A `Range` box is
+      // the font's ASCENT+DESCENT box, not the glyph's ink, and at the display leading (1.05,
+      // tighter than Fraunces' natural line box) that box overflows the tape's paper by design:
+      // it reads −2.53/−1.36 on chromium and −1.91/−1.91 on webkit while every letter is
+      // visibly inside its tape. Asserting on it would red a card that is correct. The paper
+      // over the PAINTED glyph is a different measurement and it has its own test below.
+    });
+  });
+}
+
+/* ══ 4 · THE HAND, THE MARK, AND THE MARK'S PAINTED EXTENT ═════════════════════════════════ */
+
+test.describe("the written chips", () => {
+  test.use(coarse(390, 844));
+
+  test("every card chip is the hand at 400, and its mark is priced off the WORD", async ({
+    page,
+  }) => {
+    await loadCard(page);
+    const chips = await page.evaluate((card) => {
+      const px = (n: number) => Math.round(n * 100) / 100;
+      const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!;
+      return [...root.querySelectorAll(".tray-well .ctrl-btn")].map((b) => {
+        const s = getComputedStyle(b);
+        const w = b.querySelector(".ctrl-word") as HTMLElement | null;
+        const ws = w ? getComputedStyle(w) : null;
+        const wb = w ? w.getBoundingClientRect() : null;
+        return {
+          text: b.textContent!.trim(),
+          family: s.fontFamily.split(",")[0].replace(/["']/g, "").trim(),
+          weight: s.fontWeight,
+          transform: s.textTransform,
+          pressed: b.getAttribute("aria-pressed"),
+          hasWord: !!w,
+          wordW: wb ? px(wb.width) : null,
+          markUnit: ws ? ws.backgroundSize.split(" ")[0] : null,
+          painted: ws ? ws.backgroundImage !== "none" : false,
+        };
+      });
+    }, CARD);
+
+    test.info().annotations.push({
+      type: "chips",
+      description: chips
+        // The mark's computed value stays an unresolved `calc()` in BOTH engines, so `markW`
+        // is NaN by construction and printing it says nothing. The TERM is what this row
+        // asserts, and the painted width is the row below's; print those two instead.
+        .map(
+          (c) =>
+            `"${c.text}" ${c.family}/${c.weight}` +
+            (c.painted ? ` mark ${c.markUnit} over word ${c.wordW}` : ""),
+        )
+        .join(" · "),
+    });
+
+    for (const c of chips) {
+      // Patrick Hand ships ONE weight. A `font-bold` on a static face is synthetic bold — the
+      // P1-W3 defect class — so 400 is not a preference here, it is the only honest weight.
+      expect(c.family, `"${c.text}" is written`).toBe("Patrick Hand");
+      expect(c.weight, `"${c.text}" at the hand's one weight`).toBe("400");
+      expect(c.transform, `"${c.text}" is lowercased by CSS, never by its author`).toBe("lowercase");
+      expect(c.hasWord, `"${c.text}" has its own word box for the mark to be priced against`).toBe(true);
+
+      // THE MARK IS DERIVED FROM THE WORD, not from `ch`. Both engines leave the `calc()`
+      // unresolved in the computed value, so this is a structural read and the PAINTED width is
+      // asserted in the bitmap row below: what matters is that the term is the word's own box.
+      // A `ch` term is the failure being fenced out — it measures 12.0016px on chromium against
+      // 10.0000 on webkit at this estate's Fira Code cut, which is 48.01 vs 40.00 on one chip.
+      if (c.painted) {
+        expect(c.markUnit, `"${c.text}"'s mark is priced off the word`).toContain("100%");
+        expect(c.markUnit, `"${c.text}"'s mark is not priced in \`ch\``).not.toContain("ch");
+      }
+    }
+  });
+
+  test("the mark's PAINTED columns run 2–8px past the glyph's, both sides", async ({ page }) => {
+    await loadCard(page);
+    const chip = page.locator(`${CARD} .tray-well .ctrl-btn[aria-pressed="true"]`).first();
+    await expect(chip).toBeVisible();
+
+    const mark = await paintedExtent(
+      page,
+      chip,
+      ".tray-well .ctrl-word { background-image: none !important }",
+    );
+    const glyph = await paintedExtent(
+      page,
+      chip,
+      ".tray-well .ctrl-btn { color: transparent !important }",
+    );
+    const dpr = await page.evaluate(() => window.devicePixelRatio);
+    const left = (glyph.lo - mark.lo) / dpr;
+    const right = (mark.hi - glyph.hi) / dpr;
+    const paintedW = (mark.hi - mark.lo + 1) / dpr;
+    // The word's ADVANCE, not the span's border box: the card's hook gives `.ctrl-word` 0.25rem
+    // of padding on each side (and hands it straight back in margin) so the mark has box to
+    // paint into, and measuring against that box would compare the overhang to itself — the
+    // 120% mistake in another costume.
+    const wordW = await chip.locator(".ctrl-word").evaluate((w) => {
+      const s = getComputedStyle(w);
+      return (
+        w.getBoundingClientRect().width - parseFloat(s.paddingLeft) - parseFloat(s.paddingRight)
+      );
+    });
+
+    test.info().annotations.push({
+      type: "painted-overhang",
+      description:
+        `mark cols [${mark.lo}, ${mark.hi}] glyph cols [${glyph.lo}, ${glyph.hi}] @dpr${dpr} -> ` +
+        `left ${left.toFixed(2)}px right ${right.toFixed(2)}px; painted mark ${paintedW.toFixed(2)} ` +
+        `vs word box ${wordW.toFixed(2)}`,
+    });
+
+    // 2px is a tear a reader can see; 8px is where the mark stops belonging to the word. The
+    // rule that produces it is a FIXED overhang, so a one-letter chip and a six-letter chip
+    // wear the same tear -- which a ratio could never give and is why the ratio died.
+    expect(left, "the mark reaches past the glyph on the left").toBeGreaterThanOrEqual(2);
+    expect(left, "the mark stays the word's mark on the left").toBeLessThanOrEqual(8);
+    expect(right, "the mark reaches past the glyph on the right").toBeGreaterThanOrEqual(2);
+    expect(right, "the mark stays the word's mark on the right").toBeLessThanOrEqual(8);
+
+    // AND THE PAINTED MARK IS THE WORD'S BOX + 8, within one engine.
+    expect(
+      paintedW - wordW,
+      "the painted mark is the word plus its two overhangs",
+    ).toBeCloseTo(8, 0);
+
+    // ── GATE (i), THE CROSS-ENGINE ROW, WRITTEN AT LAST ────────────────────────────────────
+    // The spec's gate (i) is "every card chip's mark width chromium == webkit ± 0.5px". Pass 3
+    // shipped a DIFFERENT row — `paintedW - wordW ≈ 8` inside each engine, on one chip — and
+    // called it engine identity. It is not: the cross-engine number was compared nowhere, and
+    // this lane's own reading was 32.67 chromium vs 32.00 webkit, 0.67px apart and OUTSIDE the
+    // spec's own band. A gate re-worded to pass is the chair's named line; this is the re-cut.
+    // Two projects cannot see each other inside one run, so each writes its census here and
+    // `scripts/check-face-engine-identity.mjs` — which REQUIRES both files — does the comparing,
+    // bare, with its own planted-defect self-test. The band is split there, and each half keeps
+    // its reason: the LAYOUT number (the word's advance, the thing the mark is derived FROM) is
+    // held to the spec's ±0.5 and reads 0.00; the PAINTED number is a raster reading off a
+    // column-thresholded bitmap and is held to its instrument's resolution, stated in px of the
+    // device, not of CSS.
+    const census = await page.evaluate((card) => {
+      const px = (n: number) => Math.round(n * 1000) / 1000;
+      const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!;
+      return [...root.querySelectorAll(".tray-well .ctrl-btn")].map((b) => {
+        const w = b.querySelector(".ctrl-word") as HTMLElement | null;
+        // A chip inside a SHUT section has a `.ctrl-word` with no laid-out box, and subtracting
+        // its padding from zero gave `-8` — a number that compared equal across engines and
+        // meant nothing. An unlaid word carries no mark, so it carries no reading either.
+        const r = w ? w.getBoundingClientRect() : null;
+        if (!w || !r || r.width === 0) return { text: b.textContent!.trim(), wordW: null };
+        const s = getComputedStyle(w);
+        return {
+          text: b.textContent!.trim(),
+          wordW: px(r.width - parseFloat(s.paddingLeft) - parseFloat(s.paddingRight)),
+        };
+      });
+    }, CARD);
+    // PASS 6 — THE CENSUS NAMES THE ARTIFACT IT MEASURED (the critic's stale-dist hole). A src
+    // digest says nothing about a DIST that was built before the last edit; the gate binds a
+    // dist census to `dist/index.html` and to its freshness. Read in-page, never inferred.
+    const served = await page.evaluate(() => {
+      const js = [...document.querySelectorAll<HTMLScriptElement>("script[type=module][src]")]
+        .map((e) => new URL(e.src).pathname)
+        .find((p) => /\/(assets\/index-[^/]+\.js|src\/main\.ts)$/.test(p));
+      const css = [...document.querySelectorAll<HTMLLinkElement>("link[rel=stylesheet][href]")]
+        .map((e) => new URL(e.href).pathname)
+        .find((p) => /\/assets\/index-[^/]+\.css$/.test(p));
+      return { mode: js && /\/src\/main\.ts$/.test(js) ? "dev" : "dist", js: js ?? null, css: css ?? null };
+    });
+    const out = join(ENGINE_DIR, `${test.info().project.name}.json`);
+    mkdirSync(ENGINE_DIR, { recursive: true });
+    writeFileSync(
+      out,
+      JSON.stringify(
+        {
+          engine: test.info().project.name,
+          stamp: ENGINE_STAMP,
+          served,
+          dpr,
+          words: census,
+          paintedMark: Math.round(paintedW * 1000) / 1000,
+          markCols: [mark.lo, mark.hi],
+          glyphCols: [glyph.lo, glyph.hi],
+        },
+        null,
+        2,
+      ),
+    );
+    test.info().annotations.push({
+      type: "engine-identity-census",
+      description: `${out} · ${census.filter((c) => c.wordW !== null).length} words, painted mark ${paintedW.toFixed(3)} @dpr${dpr}`,
+    });
+  });
+
+  /** Is the action strip (the sticky bar in the card, or the §10 foot) STACKED OVER the element's
+   *  centre and PAINTING there? Pass 8 (charter row 12): pass 7 read geometric containment only —
+   *  `elementsFromPoint(...).some(strip)` is true for a strip BEHIND the tape and for a strip at
+   *  opacity 0. Now: the strip's first hit must come before the tape's in the hit stack (topmost
+   *  first), its opacity chain must hold ≥ 0.5, it must be visible, and it (or its hit child) must
+   *  carry an opaque ground (background alpha ≥ 0.5). Both plants below red the old reading. */
+  const underTheStrip = (el: Element) => {
+    const r = el.getBoundingClientRect();
+    const stack = document.elementsFromPoint(r.left + r.width / 2, r.top + r.height / 2);
+    const si = stack.findIndex((e) => !!e.closest(".action-bar, #card-foot"));
+    if (si < 0) return false;
+    const ti = stack.findIndex((e) => e === el || el.contains(e));
+    if (ti >= 0 && ti < si) return false;
+    const strip = stack[si].closest(".action-bar, #card-foot")!;
+    let alpha = 1;
+    for (let q: Element | null = stack[si]; q; q = q.parentElement) alpha *= +getComputedStyle(q).opacity;
+    const groundAlpha = (e: Element) => {
+      const c = getComputedStyle(e).backgroundColor;
+      if (!c || c === "transparent") return 0;
+      const slash = /\/\s*([\d.]+%?)\s*\)$/.exec(c);
+      if (slash) return slash[1].endsWith("%") ? parseFloat(slash[1]) / 100 : +slash[1];
+      const rgba = /^rgba\(([^)]+)\)$/.exec(c);
+      return rgba ? +(rgba[1].split(",")[3] ?? 1) : 1;
+    };
+    const ground = Math.max(groundAlpha(stack[si]), groundAlpha(strip));
+    return alpha >= 0.5 && ground >= 0.5 && getComputedStyle(strip).visibility !== "hidden";
+  };
+
+  test("a tape's paper covers its own PAINTED word, per word", async ({ page }) => {
+    await loadCard(page);
+    const tapes = page.locator(`${CARD} .washi-tag`);
+    const n = await tapes.count();
+    expect(n, "the four compartment tapes").toBe(4);
+    const dpr = await page.evaluate(() => window.devicePixelRatio);
+
+    const read: { text: string; top: number; bottom: number; box: number }[] = [];
+    for (let i = 0; i < n; i++) {
+      const t = tapes.nth(i);
+      const text = (await t.textContent())!.trim();
+      // The card is a SCROLLPORT: a tape below the fold screenshots blank, and a blank crop
+      // differences to nothing, which reads as "no ink" rather than as "not measured". It is
+      // scrolled to first, and an unreadable crop is a RED below, never a silent pass.
+      await t.scrollIntoViewIfNeeded();
+      // PASS 5 — THE EXCLUSION WAS MIS-ATTRIBUTED. Pass 4 wrote "the players tape paints nothing
+      // until somebody joins" and asserted 3 of 4. Read on both trees (pass5 readings/tapes.log):
+      // `players` paints at 0.97 once scrolled to; the tape at opacity 0 was whichever well sat
+      // UNDER THE BAR — the product's own `data-under-bar` gate (W2 §2.3), `checking` on the
+      // control. M17's shorter zone moves every tape out from under the bar at this cell, so the
+      // count went 3 → 4 on a card with nothing wrong with it. The rule now reads the gate it
+      // meant: the opacity is POLLED to rest (a fixed 120 ms read the fade mid-flight, 0.95–0.98),
+      // a tape at 0 is excluded ONLY if the bar's gate names it, and anything else that stops
+      // painting shrinks the measured set and reds below.
+      let opacity = -1;
+      for (let k = 0; k < 20; k++) {
+        const o = await t.evaluate((el) => Number(getComputedStyle(el).opacity));
+        if (o === opacity && (o === 0 || o === 1)) break;
+        opacity = o;
+        await page.waitForTimeout(60);
+      }
+      // PASS 7 (charter row 6) — THE EXCUSE IS READ OFF THE PAINT, NOT OFF AN ATTRIBUTE. The
+      // exclusion keyed on `[data-under-bar]`, which the §10 foot deletes with its writer: on the
+      // merged tree the branch could never fire, so it was vacuous, and on this tree it trusted
+      // the product's own flag. A tape is excused only where the strip (the bar in the card, or
+      // `#card-foot` on the merged page) is actually stacked over its centre; the plant below
+      // hands the old flag to a tape that nothing covers and must be refused.
+      const underBar = await t.evaluate(underTheStrip);
+      if (opacity === 0 && underBar) {
+        read.push({ text, top: NaN, bottom: NaN, box: 0 });
+        continue;
+      }
+      // The ink ROWS of the tape's own crop: the crop's bounds ARE the tape's border box, so
+      // the first and last painted row give the paper over the glyph directly, in the basis
+      // that matters (what is drawn), not the basis a `Range` reports (ascent + descent).
+      const ink = await paintedExtent(
+        page,
+        t,
+        ".washi-tag { color: transparent !important }",
+        true,
+      );
+      const box = await t.evaluate((el) => el.getBoundingClientRect().height);
+      read.push({ text, top: ink.lo / dpr, bottom: box - (ink.hi + 1) / dpr, box });
+    }
+    // RECORDED BEFORE IT IS JUDGED, so a red carries every number rather than the first one.
+    test.info().annotations.push({
+      type: "paper-over-painted-glyph",
+      description: read
+        .map((r) =>
+          Number.isFinite(r.top)
+            ? `${r.text} ${r.top.toFixed(2)}/${r.bottom.toFixed(2)} of ${r.box.toFixed(2)}`
+            : `${r.text} NOT PAINTED (opacity 0, under the bar)`,
+        )
+        .join(" | "),
+    });
+
+    const painted = read.filter((r) => Number.isFinite(r.top));
+    expect(
+      painted.length,
+      "every tape paints except one the bar's own gate holds under it (at most one)",
+    ).toBeGreaterThanOrEqual(n - 1);
+
+    // THE PLANT, same run: the old excuse (the flag, and the tape gone to 0) on a tape the strip
+    // does not cover. The attribute alone would have excused it; the painted stack refuses it.
+    const plant = tapes.first();
+    await plant.scrollIntoViewIfNeeded();
+    // Set and read in ONE task: the scroll above re-renders the card after it settles, and Vue's
+    // patch strips an attribute it does not own (WebKit read the flag gone, pass 8 run fl-wk-1).
+    const flagSays = await plant.evaluate((el) => {
+      el.setAttribute("data-under-bar", "");
+      el.style.setProperty("opacity", "0", "important");
+      return !!el.closest("[data-under-bar]");
+    });
+    const paintSays = await plant.evaluate(underTheStrip);
+    await plant.evaluate((el) => {
+      el.removeAttribute("data-under-bar");
+      el.style.removeProperty("opacity");
+    });
+    expect(flagSays, "the plant carries the old flag").toBe(true);
+    expect(paintSays, "the plant: a flagged tape nothing covers is NOT excused").toBe(false);
+
+    // PASS 8 — THE STACK AND THE PAINT, planted on a tape the strip really covers (every plant a
+    // stylesheet, never a write into a Vue-owned node): the strip BEHIND the tape, and the strip
+    // at opacity 0. The pass-7 reader (containment alone) excuses both; this one refuses both.
+    const containment = (el: Element) => {
+      const r = el.getBoundingClientRect();
+      return document.elementsFromPoint(r.left + r.width / 2, r.top + r.height / 2).some((e) => !!e.closest(".action-bar, #card-foot"));
+    };
+    // The subject is FOUND, not assumed: at scrollTop 0 no tape sits under the strip on this tree
+    // (both engines, pass 8 run fl3), so the card is walked down in 8 px steps to the first pose
+    // where one does. A card on which no tape is ever under the strip has no subject: that is
+    // recorded, and the containment reader is then asserted to excuse nothing either.
+    const poseTo = (y: number) =>
+      page.evaluate(
+        ({ card, y }) => {
+          const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length) as HTMLElement;
+          root.scrollTop = y;
+          return new Promise<number>((r) => requestAnimationFrame(() => requestAnimationFrame(() => r(root.scrollTop))));
+        },
+        { card: CARD, y },
+      );
+    // At 1280×800 the M17 zone keeps every tape clear of the strip at every pose (0–70 px of
+    // range, both engines); a 1280×560 rail makes the card scroll a tape under it.
+    await page.setViewportSize({ width: 1280, height: 560 });
+    await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+    const maxY = await page.evaluate((card) => {
+      const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length) as HTMLElement;
+      return root.scrollHeight - root.clientHeight;
+    }, CARD);
+    let covered = -1,
+      pose = 0;
+    for (let y = 0; y <= maxY && covered < 0; y += 8) {
+      pose = await poseTo(y);
+      for (let i = 0; i < n && covered < 0; i++) if (await tapes.nth(i).evaluate(underTheStrip)) covered = i;
+    }
+    test.info().annotations.push({
+      type: "strip-stack",
+      description: covered < 0 ? `no tape under the strip at any pose 0–${maxY} (the plants have no subject on this card)` : `tape ${covered} under the strip at scrollTop ${pose}`,
+    });
+    if (covered < 0) {
+      for (let i = 0; i < n; i++) expect(await tapes.nth(i).evaluate(containment), `tape ${i}: nothing is under the strip, so nothing is excused`).toBe(false);
+    } else {
+      const t = tapes.nth(covered);
+      for (const [name, css] of [
+        ["the strip BEHIND the tape", ".tray-well .washi-tag { z-index: 2147483000 !important; }"],
+        ["the strip at opacity 0", ".action-bar, #card-foot { opacity: 0 !important; }"],
+      ] as const) {
+        const h = await page.addStyleTag({ content: css });
+        await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+        const old = await t.evaluate(containment);
+        const now = await t.evaluate(underTheStrip);
+        await h.evaluate((e) => (e as Element).remove());
+        test.info().annotations.push({ type: "strip-stack-plant", description: `${name}: containment ${old} · stack+paint ${now}` });
+        expect(old, `${name}: the pass-7 containment read still excuses it (the plant reaches the old hole)`).toBe(true);
+        expect(now, `${name}: the stack+paint read refuses it`).toBe(false);
+      }
+    }
+
+    for (const { text, top, bottom } of painted) {
+      // PER WORD, NOT ONE CONSTANT: an ascender-only word and a word with a descender measure
+      // different depths on the same face at the same rung, so a single band across the four
+      // would admit everything. The floor is what says the word is INSIDE its own tape; the
+      // ceiling is what says the leading has not quietly been re-cut upward under it.
+      //
+      // THE BOTTOM FLOOR IS −0.5 AND NOT 0, AND THAT IS A DECLARED READING, NOT A SOFTENED
+      // GATE. `pencils` measures −0.02 chromium / −0.04 webkit: at the display leading (1.05)
+      // its `p` descender lands exactly ON the tape's bottom edge, and a third of a device
+      // pixel at dpr 3 is the whole of the difference. The floor sits where the bitmap can
+      // still tell an anti-aliased edge from a word hanging out of its paper — the sweep that
+      // priced this rung read −0.59 at leading 0.95, a real overhang, and that reds here. The
+      // zero headroom under that one word is REPORTED, not tuned away.
+      expect(top, `"${text}" has paper above its ink`).toBeGreaterThan(0);
+      expect(bottom, `"${text}" keeps its ink inside its paper`).toBeGreaterThan(-0.5);
+      expect(top + bottom, `"${text}"'s paper band`).toBeLessThanOrEqual(24);
+    }
+  });
+});
+
+/* ══ 5 · THE OPEN HEAD IS INERT, AND TAKES NO AFFORDANCE ═══════════════════════════════════ */
+
+test.describe("law 14 — openness is ink pressure", () => {
+  test.use({ viewport: { width: 820, height: 1000 }, hasTouch: false, isMobile: false });
+
+  test("pressing the OPEN head changes nothing, and nothing promises that it would", async ({
+    page,
+  }) => {
+    await page.emulateMedia({ reducedMotion: "reduce" });
+    await page.goto("./?size=3&difficulty=EASY");
+    await page.waitForSelector("svg.handwritten-logo", { timeout: 20000 });
+    await page.addStyleTag({ content: ".tuner-toggle { display: none !important; }" });
+    const tab = page.locator(".drawer-tab");
+    if (await tab.isVisible().catch(() => false)) {
+      await tab.click();
+      await page.waitForTimeout(700);
+    }
+    const heads = page.locator(`${CARD} .mobile-heading-btn`);
+    const n = await heads.count();
+    test.skip(n < 2, "this cell renders the rail, not the tab row");
+
+    const open = heads.filter({ has: page.locator('[aria-expanded="true"]') });
+    const openBtn = (await open.count()) ? open.first() : heads.first();
+
+    // INERTNESS, MEASURED: the press is a no-op, so the DOM does not move under it. That is
+    // what licenses "the open head takes no affordance" — a hover promise on a control whose
+    // press changes nothing is the tell this family exists to remove.
+    const before = await page.evaluate((card) => [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!.innerHTML.length, CARD);
+    await page.evaluate(() => {
+      (window as unknown as { __mut: number }).__mut = 0;
+      new MutationObserver((recs) => {
+        (window as unknown as { __mut: number }).__mut += recs.length;
+      }).observe(document.querySelector(".controls-card")!, {
+        subtree: true,
+        childList: true,
+        attributes: true,
+        characterData: true,
+      });
+    });
+    const expandedBefore = await openBtn.getAttribute("aria-expanded");
+    await openBtn.click();
+    await page.waitForTimeout(250);
+    const mutations = await page.evaluate(() => (window as unknown as { __mut: number }).__mut);
+    const after = await page.evaluate((card) => [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!.innerHTML.length, CARD);
+
+    test.info().annotations.push({
+      type: "inertness",
+      description: `aria-expanded ${expandedBefore} → ${await openBtn.getAttribute("aria-expanded")}; ${mutations} mutation(s); innerHTML ${before} → ${after}`,
+    });
+
+    expect(await openBtn.getAttribute("aria-expanded"), "the open head stays open").toBe(expandedBefore);
+    expect(mutations, "pressing the open head mutates nothing").toBe(0);
+
+    // NO AFFORDANCE ON THE OPEN HEAD, ONE ON THE SHUT ONE — and the ablation is by DELETING the
+    // hover rule, never by `color: inherit`. Overriding the colour moves the computed value and
+    // the reading comes back "no change" for the wrong reason: this lane made that mistake once
+    // and it is declared here so nobody repeats it.
+    const state = await page.evaluate((card) => {
+      const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!;
+      return [...root.querySelectorAll(".mobile-heading-btn")].map((b) => {
+        const h = b.querySelector(".section-heading")!;
+        const s = getComputedStyle(h);
+        return {
+          expanded: b.getAttribute("aria-expanded"),
+          decoration: s.textDecorationLine,
+          color: s.color,
+          transition: s.transitionDuration,
+        };
+      });
+    }, CARD);
+    for (const s of state)
+      expect(s.decoration, "no head carries an underline — the chips' scribble is the other one").toBe(
+        "none",
+      );
+    // The shut head is muted, the open one is at press (or its tier's crayon): ink RANKS them.
+    const openInk = state.find((s) => s.expanded === "true")!.color;
+    const shutInk = state.find((s) => s.expanded === "false")!.color;
+    expect(openInk, "openness is ink pressure").not.toBe(shutInk);
+  });
+});
