+// ------------------------------------------------------------------------------------- the census
+/** Every CSS block a source carries: [{css, line, kind}] (an SFC's top-level <style>s, a stylesheet
+ *  in any Vite CSS language, a public/ sheet, index.html's <style>, CSS inside script strings). */
+export function cssBlocks(f, text, fe = "") {
+  const rel = fe ? relative(fe, f) : f;
+  if (f.endsWith(".vue"))
+    return sfc(text).styles.map((b) => ({
+      css: b.css,
+      line: b.line,
+      kind: /scoped/.test(b.attrs) ? "sfc-style-scoped" : "sfc-style",
+    }));
+  if (isCss(f))
+    return [
+      {
+        css: text,
+        line: 1,
+        kind: rel.startsWith("public") ? "public-css" : "stylesheet",
+      },
+    ];
+  if (f.endsWith(".html"))
+    return [...stripHtml(text).matchAll(/<style[^>]*>([\s\S]*?)<\/style>/g)].map(
+      (m) => ({
+        css: m[1],
+        line: lineAt(text, m.index),
+        kind: "index-html",
+      }),
+    );
+  return [];
+}
+/** Every rule a source carries, in source order, with the block's kind (script CSS included). */
+export function rulesOf(f, text, fe = "") {
+  const out = [];
+  for (const b of cssBlocks(f, text, fe))
+    for (const r of cssRules(b.css, b.line)) out.push({ ...r, kind: b.kind });
+  if (f.endsWith(".vue"))
+    for (const sc of sfc(text).scripts) out.push(...scriptCss(sc.text, sc.line));
+  else if (/\.(ts|tsx|js|mjs)$/.test(f)) out.push(...scriptCss(text));
+  return out;
+}
+/** Every site that sets `prop` on subject class `cls` (`*` = every subject), tree-wide, in source
+ *  order per file. Returns [{file, kind, ctx, prelude, prop, value, important, line, regimes,
+ *  unresolved?}]; `regimes` = the REGIMES the site's media context holds in (LEDGER). */
+export function census(fe, cls, prop, { files, read, exists, extra = [] } = {}) {
+  const out = [];
+  const rd = read ?? ((f) => readFileSync(f, "utf8"));
+  const list = files
+    ? followImports([...files, ...extra], { read: rd, exists })
+    : [...sources(fe, { read: rd, exists }), ...extra];
+  for (const f of list) {
+    const rel = relative(fe, f);
+    const text = rd(f);
+    for (const r of rulesOf(f, text, fe))
+      if (subjectHas(r.as ?? r.prelude, cls))
+        for (const d of r.decls)
