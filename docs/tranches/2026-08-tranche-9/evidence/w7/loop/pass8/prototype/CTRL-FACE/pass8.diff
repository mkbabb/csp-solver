+    const f = new Function(`return (${stateJs})`);
+    window.__st = [f()];
+    const mo = new MutationObserver(() => {
+      const v = f();
+      if (v !== window.__st[window.__st.length - 1]) window.__st.push(v);
+    });
+    mo.observe(document.body, { subtree: true, attributes: true, childList: true, characterData: true });
+    window.__mo = mo;
+  }, state);
+  await page.locator(target).first().tap();
+  await page.waitForTimeout(400);
+  await atRest(page, 3000);
+  const r = await page.evaluate(() => {
+    window.__mo.disconnect();
+    return { seq: window.__seq, states: window.__st };
+  });
+  return { ...r, toggles: r.states.length - 1 };
+}
+/** (d) focus a cell, open the overlay, tap a row: where is focus? `ok` = the selector focus must match. */
+export async function rowTapFocus(page, { cell, open, row, ok = cell }) {
+  await page.locator(cell).first().tap();
+  await open();
+  await atRest(page, 3000);
+  if (!(await page.locator(row).first().isVisible())) return { focus: null, kept: false, why: `the row ${row} is not visible after open` };
+  await page.locator(row).first().tap();
+  await page.waitForTimeout(300);
+  await atRest(page, 3000);
