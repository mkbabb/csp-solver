+        name,
+        fallback: m[2] ?? null,
+        stem: false,
+        matches: [name],
+        unresolved: false,
+      });
+      continue;
+    }
+    const { head, tail } = stemParts(name);
+    const spelled = values ? values.map((v) => head + v + tail) : null;
+    const matches = spelled ?? stemMatches(name, names);
+    out.push({
+      name,
+      fallback: m[2] ?? null,
+      stem: true,
