+// Types for the ONE four-band edge probe (`edge-bands.mjs`), as the TypeScript specs call it
+// (T9-W7 CTRL-FACE pass 8, PROPOSED to the homes: `tsconfig.e2e.json` has no `allowJs`, so a spec
+// that imports the home by relative path needs its declaration beside it). Narrow on purpose:
+// what a spec calls, in the shapes it calls them.
+import type { Page } from "@playwright/test";
+
+export interface Band {
+  stations: number;
+  coreMedian: number;
+  fracUnder: number;
+  dropped: number;
+  holeFrac: number;
+  holeRuns: number;
+  longestHole: number;
+  thickness: number;
+  ink: "computed" | "p99";
+  occluder: string | null;
+}
+export interface FourBands {
+  red: boolean;
+  why: string[];
+  bands: Record<"top" | "right" | "bottom" | "left", Band> | null;
+  edgeCount: number;
+  topOnly?: "GREEN" | "RED";
+  station8?: "GREEN" | "RED";
+}
+export interface FourBandsOptions {
+  subject: string;
+  edge: string;
+  off?: string | null;
+  out?: number;
+  inn?: number;
+  span?: [number, number];
+  floor?: number;
+  thick?: number;
+  thickTol?: number;
+  holes?: number;
+  above?: number | null;
+}
+export const EDGE_CLAUSES: string[];
+export function fourBands(page: Page, options: FourBandsOptions): Promise<FourBands>;
+export function EDGE_PLANTS(edge: string): Record<
+  | "X6_bottom_erased"
+  | "X4_opacity_015"
+  | "STROKE_OPACITY015"
+  | "PATH_OPACITY015"
+  | "FILTER_OPACITY015"
+  | "THIN_1PX"
+  | "DASH_1IN8"
+  | "INFO_X5_opacity_04",
+  string
+> & { FADE15_desc: { fade: number } };
diff --git a/web/frontend/e2e/lib/edge-bands.mjs b/web/frontend/e2e/lib/edge-bands.mjs
