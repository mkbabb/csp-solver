+    console.log(`REST ${engine} ${A.preset}${A.plant ? " plant=" + A.plant : ""} ${JSON.stringify(out)} → ${red ? "RED" : "GREEN"}`);
+    exit = red ? 1 : 0;
+    await ctx.close();
+  }
+  console.log(`LOAD ${load()}`);
+  await browser.close();
+  process.exit(exit);
+}
