+        const dealt = await paintedExtent(page, row, ".deal-row .dt-label { color: transparent !important }", true);
+        return { deal: deal.hi / dpr, dealt: dealt.hi / dpr };
+      };
+      const b = await bottoms();
+      expect(Number.isFinite(b.deal) && Number.isFinite(b.dealt), "both words painted").toBe(true);
+      const d = Math.abs(b.deal - b.dealt);
+      test.info().annotations.push({ type: "m17-g5", description: `${label}: Deal ${b.deal.toFixed(2)} · dealt ${b.dealt.toFixed(2)} · |Δ| ${d.toFixed(2)} (dpr ${dpr})` });
+      expect(d, "G5: Deal and dealt share a painted baseline").toBeLessThanOrEqual(1.5);
+      if (armed) {
+        await expect(page.locator(`${CARD}:visible .deal-btn .icon-sublabel`), "the arm held across the read").toHaveText("sure?", { timeout: 50 });
+        return; // the plant runs on the rest cells; a second read would outlive the 2.5 s arm
+      }
