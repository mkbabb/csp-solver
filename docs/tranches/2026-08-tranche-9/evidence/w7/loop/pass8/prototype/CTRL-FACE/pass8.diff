+        const c = await page.evaluate((card) => {
+          const root = [...document.querySelectorAll(card)].find((x) => x.getClientRects().length)!;
+          const b = root.querySelector(".deal-btn")!.getBoundingClientRect();
+          return [b.x + b.width / 2, b.y + b.height / 2];
