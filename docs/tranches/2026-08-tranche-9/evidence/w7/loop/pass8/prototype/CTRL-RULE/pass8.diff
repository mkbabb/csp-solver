+    const L = (i) => line + lineAt(js, i) - 1;
+    const consts = constBindings(js);
+    for (const m of js.matchAll(keyRe(esc)))
+      push({
+        file,
+        kind: `${kind}-key`,
+        prelude: "{ key }",
+        value: valueAt(js, m.index + m[0].length),
+        line: L(m.index + m[0].indexOf(m[1])),
+      });
+    for (const m of js.matchAll(
+      /(?<=[{,(]\s*)\[\s*`([^`]*\$\{[^`]*)`\s*\]\s*:\s*([^,}\n]+)/g,
+    ))
+      if (stemOf(m[1]))
