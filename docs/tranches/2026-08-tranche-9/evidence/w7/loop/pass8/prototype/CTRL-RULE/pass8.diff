+ *  unresolved?}]; `regimes` = the REGIMES the site's media context holds in (LEDGER). */
+export function census(fe, cls, prop, { files, read, exists, extra = [] } = {}) {
+  const out = [];
+  const rd = read ?? ((f) => readFileSync(f, "utf8"));
+  const list = files
+    ? followImports([...files, ...extra], { read: rd, exists })
+    : [...sources(fe, { read: rd, exists }), ...extra];
