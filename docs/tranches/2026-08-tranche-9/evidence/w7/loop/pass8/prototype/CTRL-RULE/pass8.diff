+    console.log(`[RULE row 28] inset 34 ${JSON.stringify(i34)}`);
+    expect(i34.clears, `the lowest ink against the inset line ${JSON.stringify(i34)}`).toBeGreaterThanOrEqual(2);
+    // NEGATIVE CONTROL, same page and inset: the pass-6 shape (the inset REPLACES the pad).
+    const tag = await page.addStyleTag({ content: "#card-foot { padding-bottom: max(0.15rem, env(safe-area-inset-bottom)) !important; }" });
+    await SHEET_SETTLED(page);
