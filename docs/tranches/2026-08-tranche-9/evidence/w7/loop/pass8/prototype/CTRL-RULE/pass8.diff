+        family,
+        expectRed,
+        red: fails.length > 0,
+        ok: expectRed ? fails.length > 0 : fails.length === 0,
+        why: fails.slice(0, 2).join(" / "),
+      });
+    } else
+      rows.push({
+        name,
+        family,
+        expectRed,
+        red: null,
+        ok: false,
+        why: "PLANT DID NOT MOVE THE SOURCE (anchor absent)",
+      });
+  }
+  return { anchor, rows };
+}
+const LIB = {
+  CLAUSES,
+  sabotage,
+  walk,
+  sources,
+  followImports,
+  isCss,
+  stripCss,
