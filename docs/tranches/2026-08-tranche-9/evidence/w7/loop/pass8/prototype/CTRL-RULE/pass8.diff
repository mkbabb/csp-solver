+  const map = new Map(),
+    all = [];
+  const rd = read ?? ((f) => readFileSync(f, "utf8"));
+  const list = files
+    ? followImports([...files, ...extra], { read: rd, exists })
+    : [...sources(fe, { read: rd, exists }), ...extra];
+  for (const f of list) {
+    const text = rd(f);
+    const file = relative(fe, f);
+    for (const r of rulesOf(f, text, fe)) {
+      const reg = /^@property\s+(--[\w-]+)/.exec(r.prelude);
+      for (const d of r.decls) {
