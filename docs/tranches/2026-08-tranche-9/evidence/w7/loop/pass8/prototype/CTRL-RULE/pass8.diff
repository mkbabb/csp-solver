+/** The standing question over the WHOLE case: every live control (not inert, rendered, clipped
+ *  to the card's scrollport) against the ribbon's painted extent, plus where it stands relative
+ *  to the verb that asked. */
+const ASK_CENSUS = (verbSel: string) => {
+  const cas = document.querySelector(".drawer-case")!;
+  const card = document.querySelector(".controls-card") as HTMLElement;
+  const rib = document.querySelector(".confirm-ribbon");
+  const verb = document.querySelector(verbSel);
+  if (!rib || !verb) return null;
+  let e = rib.getBoundingClientRect();
+  let ext = { l: e.left, t: e.top, r: e.right, b: e.bottom };
+  for (const d of rib.querySelectorAll("*")) {
+    e = d.getBoundingClientRect();
+    if (!e.width || !e.height) continue;
+    ext = { l: Math.min(ext.l, e.left), t: Math.min(ext.t, e.top), r: Math.max(ext.r, e.right), b: Math.max(ext.b, e.bottom) };
+  }
+  const cb = card.getBoundingClientRect();
+  const clipT = cb.top + card.clientTop;
+  const clipB = clipT + card.clientHeight;
+  let worst = 0;
+  for (const c of cas.querySelectorAll('button,[role="button"],input,a[href],[tabindex="0"]')) {
+    if (rib.contains(c) || c.closest("[inert]")) continue;
+    if (!(c as HTMLElement).checkVisibility?.({ visibilityProperty: true } as never)) continue;
+    const r = c.getBoundingClientRect();
+    let t = r.top;
+    let b = r.bottom;
+    if (card.contains(c)) {
+      t = Math.max(t, clipT);
+      b = Math.min(b, clipB);
+    }
+    const a = Math.max(0, r.right - r.left) * Math.max(0, b - t);
+    if (a < 0.01) continue;
+    const ix = Math.max(0, Math.min(ext.r, r.right) - Math.max(ext.l, r.left));
+    const iy = Math.max(0, Math.min(ext.b, b) - Math.max(ext.t, t));
+    worst = Math.max(worst, (ix * iy) / a);
+  }
+  const row = verb.closest(".deal-row, .action-bar")!.getBoundingClientRect();
+  return { worst: +worst.toFixed(4), inVerbRow: ext.t >= row.top - 0.5 && ext.b <= row.bottom + 0.5 };
+};
+
+test.describe("the standing question (coarse, 390×844)", () => {
