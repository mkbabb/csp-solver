+          .map((e) => ({ id: e.id, t: (e.textContent ?? "").trim(), r: e.getBoundingClientRect() }))
+          .filter((n) => n.r.top >= 0 && n.r.bottom <= innerHeight && n.r.width > 0)
+          .slice(0, 3)
+          .map(({ id, t }) => ({ id, t })),
