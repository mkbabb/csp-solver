+            out.push({
+              file: rel,
+              kind: r.kind,
+              ctx: r.ctx.join(" "),
+              prelude: r.prelude,
+              prop: d.prop,
+              value: d.value,
+              important: d.important,
+              line: d.line,
+              varLed: d.prop !== prop && /^\s*var\(/.test(d.value),
+              regimes: regimesOf(r.ctx),
+            });
+    if (f.endsWith(".vue")) {
+      const b = sfc(text);
+      if (b.template)
+        for (const s of templateSites(b.template.text, cls, b.template.line))
+          if (s.prop === prop || s.unresolved || sets(s, prop))
+            out.push(
+              on("tpl-file")
+                ? {
+                    ctx: "",
+                    prelude: `<template .${cls}>`,
+                    regimes: ALL_REGIMES(),
+                    ...s,
+                    file: rel,
+                  }
+                : { file: rel, ctx: "", prelude: `<template .${cls}>`, ...s },
+            );
+      for (const sc of b.scripts)
+        for (const w of scriptWrites(sc.text, prop, sc.line))
+          out.push({
+            file: rel,
+            ctx: "",
+            prelude: "<script>",
+            regimes: ALL_REGIMES(),
+            ...w,
+          });
+    } else if (/\.(ts|tsx|js|mjs)$/.test(f))
+      for (const w of scriptWrites(text, prop))
+        out.push({
+          file: rel,
+          ctx: "",
+          prelude: "<script>",
+          regimes: ALL_REGIMES(),
+          ...w,
+        });
+  }
+  return out;
+}
+/** Tokens: every `--x: v` declaration tree-wide (last wins per name; all kept in `all`), in every CSS
+ *  block, `@theme` included; (GRAPHITE) `@property` initial-values and Tailwind arbitrary properties
+ *  are declaration SITES too. */
