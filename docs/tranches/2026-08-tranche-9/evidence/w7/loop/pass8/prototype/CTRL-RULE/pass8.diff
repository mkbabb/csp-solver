+/** A `${}` template name's spelling as {head, tail} (VERB X15b: the tail after the placeholder is
+ *  part of the name — `--verb-${k}-bogus` is not declared by `--verb-a`). */
+const stemParts = (name) => {
+  const i = name.indexOf("${");
+  const j = name.indexOf("}", i);
+  return {
+    head: name.slice(0, i),
+    tail: on("stem-all") ? name.slice(j + 1).replace(/\$\{[^}]*\}.*$/, "") : "",
+  };
+};
