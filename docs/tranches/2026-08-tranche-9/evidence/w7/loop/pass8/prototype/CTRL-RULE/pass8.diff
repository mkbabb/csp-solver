+          file,
+          kind: `${kind}-key-stem`,
+          prelude: `[\`${m[1]}\`]`,
+          value: m[2].trim(),
+          line: L(m.index),
+          stem: true,
+        });
+    for (const m of js.matchAll(
+      /(?<=[{,(]\s*)\[\s*([^\]`'"][^\]]*)\]\s*:\s*([^,}\n]+)/g,
+    )) {
+      const k = foldConcat(m[1], consts);
+      if (k === token)
+        push({
+          file,
+          kind: `${kind}-key-computed`,
+          prelude: `[${m[1]}]`,
+          value: m[2].trim(),
+          line: L(m.index),
+        });
+      else if (k == null && on("style-computed-key"))
+        push({
+          file,
+          kind: `${kind}-key-computed`,
+          prelude: `[${m[1]}]`,
+          value: m[2].trim(),
+          line: L(m.index),
+          unresolved: true,
+        });
+    }
+    for (const m of js.matchAll(
+      new RegExp(
+        `\\.style\\[\\s*(['"\`])${esc}\\1\\s*\\]\\s*=(?!=)\\s*([^;\\n]+)`,
+        "g",
+      ),
+    ))
+      push({
+        file,
+        kind: `${kind}-style-index`,
+        prelude: ".style[]",
+        value: m[2].trim(),
+        line: L(m.index),
+      });
+    for (const m of js.matchAll(
+      /setProperty\(\s*((?:[^,()]|\([^()]*\))+?)\s*,\s*([^;\n]*)/g,
+    )) {
+      const k = m[1].trim();
+      const v = m[2].replace(/\)\s*$/, "").trim();
+      const lit = foldConcat(k, consts);
+      if (lit != null) {
+        if (lit === token)
+          push({
+            file,
+            kind: `${kind}-setProperty`,
+            prelude: "setProperty",
+            value: v,
+            line: L(m.index),
+          });
+      } else if (/^`[^`]*\$\{/.test(k)) {
+        if (stemOf(k.slice(1)))
+          push({
+            file,
+            kind: `${kind}-setProperty-stem`,
+            prelude: k,
+            value: v,
+            line: L(m.index),
+            stem: true,
+          });
+      } else
+        push({
+          file,
+          kind: `${kind}-setProperty-computed`,
+          prelude: k,
+          value: v,
+          line: L(m.index),
+          unresolved: true,
+        });
+    }
+    for (const m of js.matchAll(
+      /(?:\.style\s*\.\s*cssText\s*\+?=(?!=)|setAttribute\(\s*(["'`])style\1\s*,)\s*([^;\n]+)/g,
+    )) {
+      if (!on("csstext")) break;
+      const v = foldConcat(m[2].replace(/\)\s*$/, ""), consts);
+      if (v == null)
+        push({
+          file,
+          kind: `${kind}-cssText-computed`,
+          prelude: "cssText",
+          value: m[2].trim(),
+          line: L(m.index),
+          unresolved: true,
+        });
+      else
+        for (const d of decls(v))
+          if (d.prop === token)
+            push({
+              file,
+              kind: `${kind}-cssText`,
+              prelude: "cssText",
+              value: d.value,
+              line: L(m.index),
+            });
+    }
+    for (const m of js.matchAll(/(['"`])((?:\\.|(?!\1)[^\\])*?)\1/g))
+      if (new RegExp(`${esc}\\s*:`).test(m[2]) && !new RegExp(`^${esc}$`).test(m[2]))
+        for (const d of decls(m[2]))
+          if (d.prop === token)
+            push({
+              file,
+              kind: `${kind}-css-string`,
+              prelude: "'…'",
+              value: d.value,
+              important: d.important,
+              line: L(m.index),
+            });
+  };
+  const list = files
+    ? followImports([...files, ...extra], { read: rd, exists })
+    : [...sources(fe, { read: rd, exists }), ...extra];
+  for (const f of list) {
+    const file = relative(fe, f);
+    const text = rd(f);
+    if (isCss(f))
+      cssSites(text, 1, file.startsWith("public") ? "public-css" : "stylesheet", file);
+    else if (f.endsWith(".vue")) {
+      const b = sfc(text);
+      for (const s of b.styles)
+        cssSites(
+          s.css,
+          s.line,
+          /scoped/.test(s.attrs) ? "sfc-style-scoped" : "sfc-style",
+          file,
+        );
+      if (b.template) {
+        const t = stripHtml(b.template.text);
+        attrSites(t, b.template.line, "template-style", file);
+        jsSites(t, b.template.line, "template", file);
+      }
+      for (const sc of b.scripts) jsSites(stripJs(sc.text), sc.line, "script", file);
+    } else if (f.endsWith(".html")) {
+      for (const m of text.matchAll(/<style[^>]*>([\s\S]*?)<\/style>/g))
+        cssSites(m[1], lineAt(text, m.index), "index-html-style", file);
+      const t = stripHtml(
+        text.replace(/<style[^>]*>[\s\S]*?<\/style>/g, (m) => m.replace(/[^\n]/g, " ")),
+      );
+      attrSites(t, 1, "index-html-attr", file);
+      for (const m of t.matchAll(/<script[^>]*>([\s\S]*?)<\/script>/g))
+        jsSites(stripJs(m[1]), lineAt(t, m.index), "index-html-script", file);
+    } else if (f.endsWith(".json")) jsSites(text, 1, "json", file);
+    else if (/\.(ts|tsx|js|mjs)$/.test(f)) jsSites(stripJs(text), 1, "script", file);
+  }
+  return out;
+}
