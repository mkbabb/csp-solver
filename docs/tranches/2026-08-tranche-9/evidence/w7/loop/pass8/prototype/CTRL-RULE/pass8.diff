+test.describe("the coarse rail keeps the control's width (1280×800 hasTouch, chair §6.4)", () => {
+  test.use({ viewport: { width: 1280, height: 800 }, isMobile: true, hasTouch: true });
+  /** THE CONTROL'S NUMBERS, STAMPED WITH ITS COMMIT (pass 7, the pass-6 critic's gap 2). A ruler
+   *  assembled from this tree's own button and foot padding moves with them: `.icon-btn`
+   *  padding-inline .9rem took the case to 275.13 and five surfaces −25.56 with that ruler GREEN.
+   *  So the row reads π against `74a2b5d9` itself: `[left, top, width]` of the case, the masthead,
+   *  the drawer tab and the board host at 1280×800 hasTouch, read on the control's
+   *  dist (`index-CubiZsMVSwTc.js`) in chromium AND webkit (equal on x and width to the hundredth;
+   *  `pass7/prototype/CTRL-RULE/instruments/p7-rail-stamp.mjs`). Only x and width are stamped:
+   *  the tops differ 0.29 css by engine and no row here moves a top. A cell is not stamped: the
+   *  deal's `cell-reveal` scales it from 0, so its box is a pose, not a place (the host is). */
+  const RAIL_74A2B5D9 = { case: [876, 224], masthead: [180, 920], tab: [812, 48], host: [180, 640] };
+  const PI = () => {
+    const at = (s: string) => {
+      const b = document.querySelector(s)!.getBoundingClientRect();
+      return [+b.left.toFixed(2), +b.width.toFixed(2)];
+    };
+    return {
+      case: at(".drawer-case"),
+      masthead: at(".masthead"),
+      tab: at(".drawer-tab"),
+      host: at(".board-peek-host"),
+    };
+  };
+  const PI_DRIFT = (now: Record<string, number[]>) =>
+    Math.max(
+      ...Object.entries(RAIL_74A2B5D9).flatMap(([k, [x, w]]) => [Math.abs(now[k][0] - x), Math.abs(now[k][1] - w)]),
+    );
+  /** The case against the ruler `74a2b5d9` used at this cell: four verbs at the tap gutter
+   *  (each its glyph plus the button's own inline padding, nothing of the face's), plus the
+   *  foot's inline padding. Kept as a DIAGNOSTIC beside the stamp (it names which box grew);
+   *  it is not the π clause. */
+  const RAIL = () => {
+    const cas = document.querySelector(".drawer-case")!.getBoundingClientRect();
+    const foot = getComputedStyle(document.getElementById("card-foot")!);
+    const verbs = [...document.querySelectorAll<HTMLElement>(".action-verbs > .icon-btn")].map((b) => {
+      const cs = getComputedStyle(b);
+      return {
+        w: b.getBoundingClientRect().width,
+        gutter: b.querySelector("svg")!.getBoundingClientRect().width + parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight),
+      };
+    });
+    const card = document.querySelector(".controls-card") as HTMLElement;
+    return {
+      caseW: +cas.width.toFixed(2),
+      ruler: +(verbs.reduce((s, v) => s + v.gutter, 0) + parseFloat(foot.paddingLeft) + parseFloat(foot.paddingRight)).toFixed(2),
+      faceAdds: +Math.max(...verbs.map((v) => v.w - v.gutter)).toFixed(2),
+      n: verbs.length,
+      overflow: card.scrollWidth - card.clientWidth,
+    };
+  };
+  test("the case is the control's ruler to the pixel, the faces add none, and the card never scrolls sideways", async ({
+    page,
+  }) => {
+    await loadSudoku(page);
+    expect(await page.evaluate(() => matchMedia("(pointer: coarse)").matches), "coarse regime").toBe(true);
+    const at = await page.evaluate(RAIL);
+    console.log(`[RULE row 1] ${JSON.stringify(at)}`);
+    expect(at.n, "four verbs").toBe(4);
+    expect(at.faceAdds, `a face adds width inside the gutter ${JSON.stringify(at)}`).toBeLessThanOrEqual(0.5);
+    expect(Math.abs(at.caseW - at.ruler), `case vs the control's ruler ${JSON.stringify(at)}`).toBeLessThan(0.5);
+    expect(at.overflow).toBe(0);
+    const pi = await page.evaluate(PI);
+    console.log(`[RULE row 1] π vs 74a2b5d9 ${JSON.stringify(pi)} drift ${PI_DRIFT(pi)}`);
+    expect(PI_DRIFT(pi), `π against the control's stamp ${JSON.stringify(pi)}`).toBeLessThan(0.5);
+    // NEGATIVE CONTROLS, same run, each alone: the pass-5 face (0.55rem inside the gutter, case
+    // +70.38), and the critic's two widths the old ruler could not see — P1a the button's own
+    // padding, P1b the foot's.
+    for (const [plant, css] of [
+      ["pass-5 face", ".action-verbs .act-face { padding-inline: 0.55rem !important; }"],
+      ["P1a .icon-btn padding-inline .9rem", ".action-verbs > .icon-btn { padding-inline: 0.9rem !important; }"],
+      ["P1b #card-foot padding-inline 1.4rem", "#card-foot { padding-inline: 1.4rem !important; }"],
+    ] as const) {
+      const tag = await page.addStyleTag({ content: css });
+      await expect.poll(async () => PI_DRIFT(await page.evaluate(PI)), { message: `negative control ${plant}` }).toBeGreaterThan(0.5);
+      console.log(`[RULE row 1] plant ${plant} ${JSON.stringify(await page.evaluate(PI))}`);
+      await tag.evaluate((n) => (n as Element).remove());
+      await expect.poll(async () => PI_DRIFT(await page.evaluate(PI))).toBeLessThan(0.5);
+    }
+  });
+});
