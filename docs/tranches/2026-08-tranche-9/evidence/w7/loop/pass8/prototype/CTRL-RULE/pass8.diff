+ *  head is a stem of the token (`stem: true`). A key that is an expression is `unresolved: true`,
+ *  never dropped. [{file, kind, ctx, prelude, value, important, line}] */
+export function tokenSites(fe, token, { files, read, exists, extra = [] } = {}) {
+  const out = [];
+  if (!on("tok-sites")) return out;
+  const rd = read ?? ((f) => readFileSync(f, "utf8"));
+  const esc = token.replace(/[.*+?^${}()|[\]\\-]/g, "\\$&");
+  const push = (s) => out.push({ ctx: "", prelude: "", important: false, ...s });
+  const cssSites = (css, line, kind, file) => {
+    for (const r of cssRules(css, line)) {
+      const reg = /^@property\s+(--[\w-]+)/.exec(r.prelude);
+      for (const d of r.decls)
+        if (d.prop === token)
+          push({
+            file,
+            kind,
+            ctx: r.ctx.join(" "),
+            prelude: r.as ?? r.prelude,
+            value: d.value,
+            important: d.important,
+            line: d.line,
+          });
+        else if (
+          on("at-property-site") &&
+          reg?.[1] === token &&
+          d.prop === "initial-value"
+        )
+          push({
+            file,
+            kind: "at-property",
+            prelude: r.prelude,
+            value: d.value,
+            line: d.line,
+          });
+    }
+  };
+  const attrSites = (html, line, kind, file) => {
+    for (const m of html.matchAll(/(?:^|\s)style\s*=\s*("([^"]*)"|'([^']*)')/g))
+      for (const d of decls(decodeEntities(m[2] ?? m[3])))
+        if (d.prop === token)
+          push({
+            file,
+            kind,
+            prelude: "style=",
+            value: d.value,
+            important: d.important,
+            line: line + lineAt(html, m.index) - 1,
+          });
