+        console.log(`[RULE names] ${theme} '${n.t}' CLEAN ${glyphFmt(g.clean)} (bound ${g.bound})`);
+        expect(g.clean.red, `'${n.t}' ${glyphFmt(g.clean)}`).toBe(false);
