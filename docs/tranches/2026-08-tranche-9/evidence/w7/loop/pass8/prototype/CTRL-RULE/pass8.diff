+/** Every horizontal DRAWN line in the case, painted extent (the path's bbox on screen): the
+ *  groups' rules, the zone's BoilDivider, the foot's rule. Card lines in CONTENT coordinates so
+ *  the in-card pairs are read once for every scroll offset. */
+const DRAWN_LINES = () => {
+  const card = document.querySelector(".controls-card") as HTMLElement;
+  const foot = document.getElementById("card-foot");
+  const top0 = card.getBoundingClientRect().top - card.scrollTop;
+  const box = (svg: Element) => {
+    const path = svg.querySelector("path") as SVGGraphicsElement | null;
+    const m = path?.getScreenCTM();
+    if (!path || !m) return null;
+    const bb = path.getBBox();
+    const a = new DOMPoint(bb.x, bb.y).matrixTransform(m);
+    const b = new DOMPoint(bb.x + bb.width, bb.y + bb.height).matrixTransform(m);
+    return { t: Math.min(a.y, b.y), b: Math.max(a.y, b.y), w: Math.abs(b.x - a.x) };
+  };
+  const card_ = [
+    ...card.querySelectorAll("svg.ruled-line"),
+    ...card.querySelectorAll(".peek-hold-surface svg"),
+  ]
+    .map((s) => box(s))
+    .filter((x): x is { t: number; b: number; w: number } => !!x && x.w > 100)
+    .map((x) => ({ t: x.t - top0, b: x.b - top0 }))
+    .sort((p, q) => p.t - q.t);
+  const inCard: number[] = [];
+  for (let i = 1; i < card_.length; i++) inCard.push(+(card_[i].t - card_[i - 1].b).toFixed(2));
+  // THE FOLD PAIR at the scroll END, the one pose where both lines are fixed and the fade is off
+  card.scrollTop = card.scrollHeight;
+  // NO `?? foot` (pass 6, the critic's 1.5): with the foot's rule deleted that fallback measured
+  // the foot's BOX (fold 101.08 → 130.23) and the row stayed green. A missing rule is a red.
+  const footRule = foot?.querySelector("svg.ruled-line") ?? null;
+  const footLine = footRule ? box(footRule) : null;
+  const last = card_.length ? card_[card_.length - 1] : null;
+  const endTop0 = card.getBoundingClientRect().top - card.scrollTop;
+  const fold = footLine && last ? +(footLine.t - (last.b + endTop0)).toFixed(2) : null;
+  card.scrollTop = 0;
+  const floor = parseFloat(getComputedStyle(card.querySelector(".rp-name")!).lineHeight);
+  return { floor, inCard, fold, n: card_.length };
+};
