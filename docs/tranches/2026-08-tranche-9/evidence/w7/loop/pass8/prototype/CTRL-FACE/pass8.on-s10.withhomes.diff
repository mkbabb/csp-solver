+// ------------------------------------------------------------------------ media regimes (LEDGER)
+/** The regime set a media clause is EVALUATED over (the estate's cells: W2 §2.2, LAWS P7 §E). */
+export const REGIMES = {
+  "phone-portrait-390x844": {
+    width: 390,
+    height: 844,
+    pointer: "coarse",
+    hover: "none",
+  },
+  "phone-portrait-375x812": {
+    width: 375,
+    height: 812,
+    pointer: "coarse",
+    hover: "none",
+  },
+  "phone-landscape-844x390": {
+    width: 844,
+    height: 390,
+    pointer: "coarse",
+    hover: "none",
+  },
+  "phone-landscape-812x375": {
+    width: 812,
+    height: 375,
+    pointer: "coarse",
+    hover: "none",
+  },
+  "tablet-1024x768-coarse": {
+    width: 1024,
+    height: 768,
+    pointer: "coarse",
+    hover: "none",
+  },
+  "desk-1280x800": { width: 1280, height: 800, pointer: "fine", hover: "hover" },
+  "desk-1440x900": { width: 1440, height: 900, pointer: "fine", hover: "hover" },
+};
