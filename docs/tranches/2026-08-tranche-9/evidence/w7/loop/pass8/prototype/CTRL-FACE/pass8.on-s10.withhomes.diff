+    const drop = st.map((v) => v <= 1.05);
+    let runs = 0,
+      longest = 0,
+      cur = 0;
+    for (const d of drop) {
+      if (d) {
+        cur++;
+        if (cur === 1) runs++;
+        longest = Math.max(longest, cur);
+      } else cur = 0;
+    }
