+}
+
+// --------------------------------------------------------------------- component census (SIX)
+const BUILTIN = new Set([
+  "Transition",
+  "TransitionGroup",
+  "KeepAlive",
+  "Teleport",
+  "Suspense",
+  "component",
+  "slot",
+  "template",
+  "RouterView",
+  "RouterLink",
+]);
+const NATIVE =
+  /^(a|abbr|address|area|article|aside|audio|b|bdi|bdo|blockquote|body|br|button|canvas|caption|cite|code|col|colgroup|data|datalist|dd|del|details|dfn|dialog|div|dl|dt|em|embed|fieldset|figcaption|figure|footer|form|h[1-6]|head|header|hgroup|hr|html|i|iframe|img|input|ins|kbd|label|legend|li|link|main|map|mark|menu|meta|meter|nav|noscript|object|ol|optgroup|option|output|p|param|picture|pre|progress|q|rp|rt|ruby|s|samp|script|search|section|select|slot|small|source|span|strong|style|sub|summary|sup|table|tbody|td|textarea|tfoot|th|thead|time|title|tr|track|u|ul|var|video|wbr|svg|g|path|circle|ellipse|line|polyline|polygon|rect|text|tspan|defs|use|symbol|clipPath|mask|filter|linearGradient|radialGradient|stop|pattern|image|marker|foreignObject|feTurbulence|feDisplacementMap|feGaussianBlur|feColorMatrix|feComposite|feMerge|feMergeNode|feOffset|feFlood|feBlend|feMorphology|feComponentTransfer|feFuncA|feFuncR|feFuncG|feFuncB|animate|animateTransform|set|desc|metadata|view|textPath)$/;
+const pascal = (t) => t.replace(/(^|-)([a-z])/g, (m, d, c) => c.toUpperCase());
+/** The file a module specifier + imported name reaches, following barrels (SIX F8:
+ *  `export { default as Band } from "./StagingBand.vue"`). null = UNRESOLVED. */
+function resolveImport(fromFile, spec, name, rd, ex, depth = 0) {
+  if (depth > 5 || !/^\.{1,2}\//.test(spec)) return null;
+  const base = resolvePath(dirname(fromFile), spec);
+  const cands = [
+    base,
+    `${base}.ts`,
+    `${base}.js`,
+    `${base}.mjs`,
+    `${base}.vue`,
+    join(base, "index.ts"),
+    join(base, "index.js"),
+  ];
+  const f = cands.find((c) => ex(c) && /\.(vue|ts|js|mjs)$/.test(c));
+  if (!f) return null;
+  if (f.endsWith(".vue")) return name === "default" ? f : null;
+  if (!on("barrel")) return null;
+  const s = stripJs(rd(f));
+  for (const m of s.matchAll(/export\s*\{([^}]*)\}\s*from\s*(["'])([^"']+)\2/g))
+    for (const part of m[1].split(","))
+      if (part.trim()) {
+        const [orig, alias] = part.trim().split(/\s+as\s+/);
+        if ((alias ?? orig).trim() === name)
+          return resolveImport(f, m[3], orig.trim(), rd, ex, depth + 1);
+      }
+  for (const m of s.matchAll(/import\s+([A-Za-z_$][\w$]*)\s+from\s*(["'])([^"']+)\2/g))
+    if (
+      new RegExp(`export\\s*\\{[^}]*\\b${m[1]}\\s+as\\s+${name}\\b`).test(s) ||
+      (new RegExp(`export\\s*\\{[^}]*\\b${m[1]}\\b`).test(s) && m[1] === name)
+    )
+      return resolveImport(f, m[3], "default", rd, ex, depth + 1);
+  return null;
+}
+/** Every component USE in the estate's SFCs and scripts: [{file, line, tag, target: file |
+ *  "UNRESOLVED", binds: [names], spread, via: "template" | "h" | "createVNode"}]. A tag that resolves
+ *  to no file is UNRESOLVED, never a non-painter (SIX F9); `v-bind="obj"`, a spread or a computed key
+ *  in h()/createVNode (aliased too) is `spread: true` (F5–F7); a barrel alias is followed (F8). */
+export function componentSites(fe, { files, read, exists } = {}) {
+  const rd = read ?? ((f) => readFileSync(f, "utf8"));
+  const ex = exists ?? existsSync;
+  const list = files ?? sources(fe, { read: rd, exists: ex });
+  const out = [];
+  for (const f of list) {
+    if (!/\.(vue|ts|tsx|js|mjs)$/.test(f)) continue;
+    const file = relative(fe, f);
+    const text = rd(f);
+    const b = f.endsWith(".vue")
+      ? sfc(text)
+      : { scripts: [{ text, line: 1 }], template: null };
+    const imports = new Map();
+    const hNames = new Set();
+    for (const sc of b.scripts) {
+      const s = stripJs(sc.text);
+      for (const m of s.matchAll(
+        /import\s+([A-Za-z_$][\w$]*)\s*(?:,\s*\{[^}]*\})?\s+from\s*(["'])([^"']+)\2/g,
+      ))
+        imports.set(m[1], resolveImport(f, m[3], "default", rd, ex));
+      for (const m of s.matchAll(
+        /import\s*(?:[A-Za-z_$][\w$]*\s*,\s*)?\{([^}]*)\}\s*from\s*(["'])([^"']+)\2/g,
+      ))
+        for (const part of m[1].split(",")) {
+          const [orig, alias] = part
+            .trim()
+            .split(/\s+as\s+/)
+            .map((x) => x?.trim());
+          if (!orig) continue;
+          if (m[3] === "vue" && (orig === "h" || orig === "createVNode"))
+            hNames.add(`${alias ?? orig}\u0000${orig}`);
+          else imports.set(alias ?? orig, resolveImport(f, m[3], orig, rd, ex));
+        }
+      for (const m of s.matchAll(
+        /defineAsyncComponent\(\s*\(\)\s*=>\s*import\(\s*(["'])([^"']+)\1\s*\)\s*\)/g,
+      )) {
+        const d = /(?:const|let)\s+([A-Za-z_$][\w$]*)\s*=\s*$/.exec(
+          s.slice(0, m.index),
+        );
+        if (d) imports.set(d[1], resolveImport(f, m[2], "default", rd, ex));
+      }
+    }
+    if (b.template)
+      for (const m of stripHtml(b.template.text).matchAll(TAG_RE)) {
+        const tag = m[1];
+        if (NATIVE.test(tag) || BUILTIN.has(tag) || BUILTIN.has(pascal(tag))) continue;
+        if (!/[A-Z]/.test(tag[0]) && !tag.includes("-")) continue;
+        const key = imports.has(tag) ? tag : pascal(tag);
+        let target = imports.has(key) ? (imports.get(key) ?? "UNRESOLVED") : null;
+        if (target == null) target = on("tag-unresolved") ? "UNRESOLVED" : "native";
+        const attrs = attrsOf(m[2] ?? "");
+        out.push({
+          file,
+          line: b.template.line + lineAt(b.template.text, m.index) - 1,
+          tag,
+          target:
+            target === "UNRESOLVED" || target === "native"
+              ? target
+              : relative(fe, target),
+          binds: attrs
+            .filter(
+              (a) =>
+                !/^(v-(if|else|else-if|for|show|slot|model)|#|@|v-on|ref|key|class|style|:class|:style|:key)/.test(
+                  a.name,
+                ) && a.name !== "v-bind",
+            )
+            .map((a) => a.name.replace(/^(:|v-bind:)/, "")),
+          spread: attrs.some((a) => a.name === "v-bind"),
+          via: "template",
+        });
+      }
+    for (const sc of b.scripts) {
+      const s = stripJs(sc.text);
+      const callees = [...hNames].map((x) => x.split("\u0000"));
+      if (!on("h-spread"))
+        callees.splice(
+          0,
+          callees.length,
+          ...callees.filter(([a, o]) => a === o && a === "h"),
+        );
+      for (const [alias, orig] of callees)
+        for (const m of s.matchAll(
+          new RegExp(
+            `\\b${alias.replace(/\$/g, "\\$")}\\(\\s*([A-Za-z_$][\\w$]*)\\s*(?:,\\s*\\{([^}]*)\\})?`,
+            "g",
+          ),
+        )) {
+          const comp = m[1];
+          if (!imports.has(comp)) continue;
+          const body = m[2] ?? "";
+          const keys = splitTop(body, /,/);
+          out.push({
+            file,
+            line: sc.line + lineAt(s, m.index) - 1,
+            tag: comp,
+            target: imports.get(comp) ? relative(fe, imports.get(comp)) : "UNRESOLVED",
+            binds: keys
+              .map((k) =>
+                /^\s*(?:(['"])([^'"]+)\1|([A-Za-z_$][\w$]*))\s*(?::|$)/.exec(k),
+              )
+              .filter(Boolean)
+              .map((x) => x[2] ?? x[3]),
+            spread: on("h-spread")
+              ? keys.some((k) => /^\.\.\.|^\[/.test(k.trim()))
+              : false,
+            via: orig,
+          });
+        }
+    }
+  }
+  return out;
+}
+/** SIX F10: a PIN admits a site with its bind SET, never the site alone — every site the pins name
+ *  whose binds (or a spread) exceed the pinned set. pins: [{file, tag, binds: [...]}] */
+export function pinsBreached(sites, pins) {
+  const out = [];
+  for (const p of pins)
+    for (const s of sites.filter((x) => x.file === p.file && x.tag === p.tag)) {
+      if (!on("pin-binds")) continue;
+      const extra = s.binds.filter((b) => !p.binds.includes(b));
+      if (extra.length || s.spread) out.push({ ...s, extra, pinned: p.binds });
+    }
+  return out;
+}
+
+// -------------------------------------------------------------------- template ELEMENTS (TAPE)
+const VOID = /^(area|base|br|col|embed|hr|img|input|link|meta|source|track|wbr)$/i;
+/** A template's elements as a tree: [{i, tag, id, classes: Set, dynClass, attrs: Map, parent, line}].
+ *  `dynClass` = the element carries a `:class` whose names are not all literal (it may carry any). */
+export function templateElements(tpl, baseLine = 1) {
+  const t = stripHtml(tpl);
+  const els = [];
+  const stack = [];
+  const re =
+    /<\/([a-zA-Z][\w.-]*)\s*>|<([a-zA-Z][\w.-]*)((?:\s+(?:"[^"]*"|'[^']*'|[^\s>"'])+)*)\s*(\/?)>/g;
+  for (const m of t.matchAll(re)) {
+    if (m[1]) {
+      const k = stack.map((x) => els[x].tag).lastIndexOf(m[1]);
+      if (k >= 0) stack.length = k;
+      continue;
+    }
+    const attrs = new Map(attrsOf(m[3] ?? "").map((a) => [a.name, a.value]));
+    const classes = new Set();
+    for (const c of (attrs.get("class") ?? "").split(/\s+/)) if (c) classes.add(c);
+    const dyn = attrs.get(":class") ?? attrs.get("v-bind:class");
+    let dynClass = false;
+    if (dyn != null) {
+      for (const lit of dyn.matchAll(/(['"`])([\w\s-]+)\1/g))
+        for (const c of lit[2].split(/\s+/)) if (c) classes.add(c);
+      for (const key of dyn.matchAll(/(?:[{,]\s*)([\w-]+)\s*:/g)) classes.add(key[1]);
+      dynClass =
+        !/^\s*(\{[^}]*\}|\[[^\]]*\]|(['"`])[^'"`]*\2)\s*$/.test(dyn) ||
+        /\$\{/.test(dyn);
+    }
+    const el = {
+      i: els.length,
+      tag: m[2],
+      id: attrs.get("id") ?? null,
+      classes,
+      dynClass,
+      attrs,
+      parent: stack.at(-1) ?? null,
+      line: baseLine + lineAt(t, m.index) - 1,
+    };
+    els.push(el);
+    if (!m[4] && !VOID.test(m[2])) stack.push(el.i);
+  }
+  return els;
+}
+/** Does compound `c` MAY-match element `el` (conservative: an unknowable clause is a yes)? */
+function compoundMayMatch(c, el) {
+  let rest = c.trim();
+  if (!rest || rest === "&") return true;
+  let ok = true;
+  rest = rest.replace(/:not\(((?:[^()]|\([^()]*\))*)\)/g, (m, inner) => {
+    if (splitTop(inner, /,/).some((a) => compoundCertain(a, el))) ok = false;
+    return "";
+  });
+  rest = rest.replace(
+    /:(?:is|where|matches)\(((?:[^()]|\([^()]*\))*)\)/g,
+    (m, inner) => {
+      if (!splitTop(inner, /,/).some((a) => compoundMayMatch(subjectCompound(a), el)))
+        ok = false;
+      return "";
+    },
+  );
+  rest = rest.replace(
+    /\[\s*([\w:-]+)\s*(?:([~|^$*]?=)\s*(["']?)([^\]"']*)\3\s*)?\]/g,
+    (m, name, op, q, val) => {
+      const v =
+        name === "class"
+          ? [...el.classes].join(" ")
+          : (el.attrs.get(name) ?? el.attrs.get(`:${name}`) ?? null);
+      const bound =
+        el.attrs.has(`:${name}`) ||
+        el.attrs.has("v-bind") ||
+        (name === "class" && el.dynClass);
+      if (v == null && !bound) ok = false;
+      else if (op && v != null && !bound) {
+        const hit =
+          op === "="
+            ? v === val
+            : op === "~="
+              ? v.split(/\s+/).includes(val)
+              : op === "^="
+                ? v.startsWith(val)
+                : op === "$="
+                  ? v.endsWith(val)
+                  : op === "*="
+                    ? v.includes(val)
+                    : v === val || v.startsWith(val + "-");
+        if (!hit) ok = false;
+      }
+      return "";
+    },
+  );
+  rest = rest.replace(/::?[\w-]+(\((?:[^()]|\([^()]*\))*\))?/g, ""); // structural and state pseudos: may match
+  const tag = /^([a-zA-Z][\w-]*|\*)/.exec(rest)?.[1];
+  if (tag && tag !== "*" && tag.toLowerCase() !== el.tag.toLowerCase()) ok = false;
+  for (const idm of rest.matchAll(/#([\w-]+)/g))
+    if (el.id !== idm[1] && !el.attrs.has(":id")) ok = false;
+  for (const cm of rest.matchAll(/\.([\w-]+)/g))
+    if (!el.classes.has(cm[1]) && !el.dynClass && !el.attrs.has("v-bind")) ok = false;
+  return ok;
+}
+/** Does compound `c` CERTAINLY match `el` (used under :not())? Classes/id/tag only. */
+function compoundCertain(c, el) {
+  const s = c.trim();
+  if (/[:[]/.test(s)) return false;
+  const tag = /^([a-zA-Z][\w-]*)/.exec(s)?.[1];
+  if (tag && tag.toLowerCase() !== el.tag.toLowerCase()) return false;
+  for (const idm of s.matchAll(/#([\w-]+)/g)) if (el.id !== idm[1]) return false;
+  for (const cm of s.matchAll(/\.([\w-]+)/g)) if (!el.classes.has(cm[1])) return false;
+  return /[.#a-zA-Z]/.test(s);
+}
+/** TAPE: may selector `sel` (one complex selector, or a list) match element `el` of `els`? The
+ *  subject compound against the element, each earlier compound against its ancestor chain (`>` its
+ *  parent, ` ` any ancestor, `+`/`~` a may-sibling); past the template's root the context is
+ *  unknown, so the rest may match. An extra class, a structural pseudo, an attribute selector and
+ *  an id attribute all reach the element (S1–S5). */
+export function mayMatch(sel, el, els) {
+  return splitTop(sel, /,/).some((one) => {
+    const s = one
+      .replace(/:deep\(([^)]*)\)/g, " $1")
+      .replace(/::v-deep/g, " ")
+      .replace(/::[\w-]+(\([^)]*\))?$/, "");
+    const toks = [];
+    let cur = "",
+      d = 0;
+    for (const c of s) {
+      if (c === "(" || c === "[") d++;
+      if (c === ")" || c === "]") d--;
+      if (d === 0 && /[\s>+~]/.test(c)) {
+        if (cur) toks.push(cur);
+        cur = "";
+        if (c !== " " && c !== "\n") {
+          if (toks.at(-1) === " ") toks.pop();
+          toks.push(c);
+        } else if (toks.length && !/^[>+~]$/.test(toks.at(-1))) toks.push(" ");
+        continue;
+      }
+      cur += c;
+    }
+    if (cur) toks.push(cur);
+    while (toks.length && toks.at(-1) === " ") toks.pop();
+    const walkUp = (ti, node) => {
+      if (ti < 0) return true;
+      const comb = toks[ti];
+      const comp = toks[ti - 1];
+      if (comp == null) return true;
+      if (comb === ">") {
+        const p = node.parent == null ? null : els[node.parent];
+        if (!p) return true;
+        return compoundMayMatch(comp, p) && walkUp(ti - 2, p);
+      }
+      if (comb === " ") {
+        for (
+          let p = node.parent == null ? null : els[node.parent];
+          p;
+          p = p.parent == null ? null : els[p.parent]
+        )
+          if (compoundMayMatch(comp, p) && walkUp(ti - 2, p)) return true;
+        return true; // the context above the template's root is unknown
+      }
+      return true; // `+` / `~`: a sibling relation, may hold
+    };
+    const subj = toks.at(-1) ?? "";
+    return compoundMayMatch(subj, el) && walkUp(toks.length - 2, el);
+  });
+}
+/** TAPE: every declaration of `props` that may reach the elements `pick` selects in `file`'s
+ *  template, from EVERY rule in the estate (keyed on the element, never on a class name), plus the
+ *  element's own style=/utility candidates; `whitelist` {prop: [values]} marks a value outside the
+ *  list `bad`. pick: (el) => boolean. */
+export function elementSites(
+  fe,
+  { file, pick, props, whitelist = {}, files, read, exists },
+) {
+  const rd = read ?? ((f) => readFileSync(f, "utf8"));
+  const list = files
+    ? followImports(files, { read: rd, exists })
+    : sources(fe, { read: rd, exists });
+  const own = list.find((f) => relative(fe, f) === file || f === file);
+  if (!own) return { elements: [], sites: [] };
+  const b = sfc(rd(own));
+  const els = b.template ? templateElements(b.template.text, b.template.line) : [];
+  const targets = els.filter(pick);
+  const sites = [];
+  const add = (s) => {
+    const allowed = whitelist[s.prop];
+    sites.push({
+      ...s,
+      bad: allowed ? !allowed.includes(String(s.value).trim()) : false,
+    });
+  };
+  const legacyCls = [...(targets[0]?.classes ?? [])][0];
+  for (const f of list) {
+    const text = rd(f);
+    for (const r of rulesOf(f, text, fe)) {
+      const sel = r.as ?? r.prelude;
+      if (sel.startsWith("@")) continue;
+      const hit = on("element-keyed")
+        ? targets.some((el) => mayMatch(sel, el, els))
+        : legacyCls != null && subjectHas(sel, legacyCls);
+      if (!hit) continue;
+      for (const dd of r.decls)
+        if (props.some((p) => sets(dd, p)))
+          add({
+            file: relative(fe, f),
+            kind: r.kind,
+            ctx: r.ctx.join(" "),
+            prelude: sel,
+            prop: dd.prop,
+            value: dd.value,
+            important: dd.important,
+            line: dd.line,
+            regimes: regimesOf(r.ctx),
+          });
+    }
+  }
+  for (const el of targets) {
+    for (const d of decls(el.attrs.get("style") ?? ""))
+      if (props.some((p) => sets(d, p)))
+        add({
+          file,
+          kind: "style-attr",
+          prelude: `<${el.tag}>`,
+          ...d,
+          line: el.line,
+          regimes: ALL_REGIMES(),
+        });
+    for (const c of el.classes)
+      for (const [p, v] of TAILWIND_ALL(c))
+        if (props.some((q) => sets({ prop: p }, q)))
+          add({
+            file,
+            kind: "tailwind",
+            prelude: `<${el.tag} .${c}>`,
+            prop: p,
+            value: v,
+            line: el.line,
+            regimes: ALL_REGIMES(),
+          });
+  }
+  return {
+    elements: targets.map((e) => ({
+      tag: e.tag,
+      id: e.id,
+      classes: [...e.classes],
+      line: e.line,
+    })),
+    sites,
+  };
+}
