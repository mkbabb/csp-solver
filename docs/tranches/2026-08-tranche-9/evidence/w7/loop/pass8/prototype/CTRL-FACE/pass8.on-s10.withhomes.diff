+ *  (frame 1 paints at rest). Key `t`: it starts in a TASK posted from the page's rAF (startTime = the
+ *  last frame's time), so its first painted frame is one frame in (6 px per ms: a 2 ms WebKit frame gap is 12 px) while the task ran before
+ *  the sampler's post read of the previous frame: the un-keyed reader takes that unpainted read as frame 1. */
+const MOVER = `<!doctype html><html><head><style>
+  body { margin: 0; background: #fbf8f1; }
+  #mv { position: absolute; left: 40px; top: 80px; width: 60px; height: 60px; background: #3b3833; }
+</style></head><body><div id="mv"></div><script>
+  let arm = null;
+  const mc = new MessageChannel();
+  const go = () => {
+    const a = document.getElementById("mv").animate([{ transform: "translateX(0)" }, { transform: "translateX(1200px)" }], { duration: 200, easing: "linear" });
