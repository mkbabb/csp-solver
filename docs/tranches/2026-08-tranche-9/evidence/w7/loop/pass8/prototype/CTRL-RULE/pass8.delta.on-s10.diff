+    await page.evaluate(() => (document.getElementById("card-foot")!.style.paddingBottom = "0px"));
+    const inline = await SERVED_PAD(page);
+    console.log(`[RULE row 28 flat] ${browserName} plant inline write: served ${JSON.stringify(inline)}`);
+    expect(SERVED_OK(inline), "negative control: an inline write").toBe(false);
