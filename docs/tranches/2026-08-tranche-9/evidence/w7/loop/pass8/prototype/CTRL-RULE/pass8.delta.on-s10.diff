+    // NEGATIVE CONTROLS, same page — the served arm reds on each; the paint arm on the ones that move ink.
+    for (const [name, css, paints] of [
+      ["E4 !important max() in a coarse block", "@media (pointer: coarse) { .card-foot { padding-bottom: max(0.15rem, env(safe-area-inset-bottom)) !important; } }", false],
+      ["E3 the compound override", "#card-foot.card-foot { padding-bottom: 0.15rem; }", false],
+      ["a shadowing declaration in one block", ".card-foot { padding-bottom: calc(0.15rem + env(safe-area-inset-bottom)); padding-bottom: 0.15rem; }", false],
+      ["a structural selector", "div:nth-last-child(n)[id='card-foot'] { padding-bottom: 0 !important; }", true],
+      ["an !important universal", "* { padding-bottom: 0 !important; }", true],
+    ] as const) {
+      const tag = await page.addStyleTag({ content: css });
+      await SHEET_SETTLED(page);
+      const s = await SERVED_PAD(page);
+      const low = paints ? await LOWEST_INK(page) : null;
+      console.log(`[RULE row 28 flat] ${browserName} plant ${name}: served ${JSON.stringify(s)}${paints ? ` clears ${low === null ? null : +(844 - low).toFixed(2)}` : ""}`);
+      expect(SERVED_OK(s), `negative control ${name}`).toBe(false);
+      if (paints) expect(low === null ? 0 : 844 - low, `negative control ${name} on paint`).toBeLessThan(2);
+      await tag.evaluate((n) => (n as Element).remove());
+    }
