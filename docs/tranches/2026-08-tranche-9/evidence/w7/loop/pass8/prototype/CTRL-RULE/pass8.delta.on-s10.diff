+  /** The SERVED cascade at the element (the behavioural twin of the source arm; LAWS P7 §F (iii)):
+   *  every CSSOM style rule the engine says MATCHES `#card-foot` (selector matching by the engine,
+   *  media by `matchMedia`, layers and nesting walked) plus the inline style, each `padding-bottom`
+   *  it declares. Sees what no source reader can: a runtime inline write, a structural selector. */
+  const SERVED_PAD = (page: Page) =>
+    page.evaluate(() => {
+      const el = document.getElementById("card-foot")!;
+      const out: string[] = [];
+      const walk = (rules: CSSRuleList, live: boolean) => {
+        for (const r of Array.from(rules)) {
+          if (r instanceof CSSMediaRule) walk(r.cssRules, live && matchMedia(r.conditionText).matches);
+          else if (r instanceof CSSStyleRule) {
+            let hit = false;
+            try {
+              hit = el.matches(r.selectorText);
+            } catch {
+              hit = false;
+            }
+            const v = r.style.getPropertyValue("padding-bottom");
+            // a UNIVERSAL reset (Tailwind's preflight `*, ::after, ::before`, specificity 0 in
+            // the base layer) matches every element and loses to every class: it is not a site
+            // that can decide the foot's pad, and it is the only selector the arm sets aside —
+            // unless it is `!important`, which outranks every normal declaration (a plant below)
+            const imp = !!r.style.getPropertyPriority("padding-bottom");
+            const universal = !r.selectorText.replace(/::?(before|after|backdrop|marker|placeholder|file-selector-button)|\*|,|\s/g, "");
+            if (live && hit && v && (!universal || imp)) out.push(`${r.selectorText} { ${v}${r.style.getPropertyPriority("padding-bottom") ? " !important" : ""} }`);
+            if ((r as unknown as { cssRules?: CSSRuleList }).cssRules?.length) walk((r as unknown as { cssRules: CSSRuleList }).cssRules, live);
+          } else if ((r as unknown as { cssRules?: CSSRuleList }).cssRules) walk((r as unknown as { cssRules: CSSRuleList }).cssRules, live);
+        }
+      };
+      for (const sh of Array.from(document.styleSheets)) {
+        try {
+          walk(sh.cssRules, true);
+        } catch {
+          out.push(`UNREADABLE ${sh.href}`);
+        }
+      }
+      if (el.style.paddingBottom) out.push(`style="padding-bottom: ${el.style.paddingBottom}"`);
+      return out;
+    });
+  const SERVED_OK = (sites: string[]) =>
+    sites.length > 0 && sites.every((x) => /\{ calc\([^;]*\+\s*env\(safe-area-inset-bottom\)\) \}$/.test(x));
