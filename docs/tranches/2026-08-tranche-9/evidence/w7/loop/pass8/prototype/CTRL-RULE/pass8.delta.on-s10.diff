+  test("row 28 · source: every site that may pad #card-foot at the dock stacks the inset, through the ONE library — eight plants red, three decoys green, and each clause bites", () => {
+    const shipped = FOOT_PAD();
+    console.log(`[RULE row 28 source] shipped ${JSON.stringify(shipped)}`);
+    expect(shipped.bad, "the shipped foot").toEqual([]);
+    expect(shipped.sites).toBeGreaterThan(0);
+    // RED is the verdict a plant owes and GREEN the one a decoy owes: `ok` is "read as the law".
+    const verdict = (off: string[] = []) =>
+      Object.fromEntries([
+        ...FOOT_PAD_PLANTS.map(([name, p]) => [name, FOOT_PAD(p, off).bad.length > 0]),
+        ...FOOT_PAD_DECOYS.map(([name, p]) => [`decoy ${name}`, FOOT_PAD(p, off).bad.length === 0]),
