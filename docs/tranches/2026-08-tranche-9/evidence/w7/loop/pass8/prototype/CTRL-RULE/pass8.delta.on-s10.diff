+    const battery: Record<string, string[]> = {};
+    for (const [clause, run] of [
+      ["library element-keyed", () => { sabotage(["element-keyed"]); try { return verdict(); } finally { sabotage([]); } }],
+      ["library media-eval", () => { sabotage(["media-eval"]); try { return verdict(); } finally { sabotage([]); } }],
+      ["gate every-site", () => verdict(["every-site"])],
