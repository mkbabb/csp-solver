+  /** ROW 28's SOURCE ARM, through the ONE library (pass 8; LAWS P7 §F (i)): every declaration that
+   *  may reach `#card-foot`'s `padding-bottom` — keyed on the TEMPLATE ELEMENT (`GameScene.vue`),
+   *  never on a class name — read in every DOCK regime its media context holds in (the library's
+   *  cells under 1024 wide: W2's sheet, whose foot IS the screen's bottom edge, the only place an
+   *  inset reaches it; at the rail the case stands clear of the edge), and EVERY live site must
+   *  stack the inset on the pad. Every site, not the source-order winner: a non-stacked site
+   *  with the higher specificity wins the real cascade from anywhere in the file. `plant` is CSS
+   *  appended to `scene.css` (`{ prepend }` puts it first; `{ shadow }` writes a second
+   *  `padding-bottom` into the shipped block itself), read through the library's `read` seam, so
+   *  no file on disk is touched. `off` switches this gate's own clauses off (the sabotage row). */
+  const DOCK = Object.entries(REGIMES as Record<string, { width: number }>)
+    .filter(([, r]) => r.width < 1024)
+    .map(([k]) => k);
+  const STACKED = /^calc\(\s*[^;]*\+\s*env\(\s*safe-area-inset-bottom\s*\)\s*\)$/;
+  type Plant = { css?: string; prepend?: string; shadow?: string } | null;
+  const FOOT_PAD = (plant: Plant = null, off: string[] = []) => {
+    const scene = join(FE, "src/games/shared/scene.css");
+    const read = (f: string) => {
+      let t = readFileSync(f, "utf8");
+      if (!plant || f !== scene) return t;
+      if (plant.shadow)
