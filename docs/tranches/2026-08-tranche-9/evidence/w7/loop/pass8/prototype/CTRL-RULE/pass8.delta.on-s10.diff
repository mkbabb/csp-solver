+    ["E3 the #card-foot.card-foot compound override", { css: "#card-foot.card-foot { padding-bottom: 0.15rem; }" }],
+    ["a shadowing padding-bottom in the SAME block", { shadow: "0.15rem" }],
+    ["the compound override PREPENDED (wins on specificity, loses on source order)", { prepend: "#card-foot.card-foot { padding-bottom: 0.15rem; }" }],
+    ["an id-only selector (no class to key on)", { css: "#card-foot { padding-bottom: 0.15rem; }" }],
+    ["a phone-only block", { css: "@media (max-width: 480px) { .card-foot { padding-bottom: 0.15rem; } }" }],
+    ["a landscape-only block", { css: "@media (max-width: 1023.98px) and (orientation: landscape) { .card-foot { padding-bottom: 0.15rem; } }" }],
+    ["the shorthand", { css: ".card-foot { padding: 0 0 0.15rem; }" }],
+  ];
+  /** DECOYS: declarations that can never reach the foot in any regime — each must stay GREEN, so the
+   *  law is not a text match that reds on a dead block (LAWS P7 §F: a media query EVALUATED). */
+  const FOOT_PAD_DECOYS: [string, Plant][] = [
+    ["an unsatisfiable media block", { css: "@media (min-width: 5000px) { .card-foot { padding-bottom: 0.15rem; } }" }],
+    ["`not all and` a live query", { css: "@media not all and (min-width: 1px) { .card-foot { padding-bottom: 0.15rem; } }" }],
+    ["a rail-only berth (the case clear of the edge)", { css: "@media (min-width: 1024px) and (hover: hover) and (pointer: fine) { .card-foot { padding-bottom: max(3.5rem, env(safe-area-inset-bottom)); } }" }],
+  ];
