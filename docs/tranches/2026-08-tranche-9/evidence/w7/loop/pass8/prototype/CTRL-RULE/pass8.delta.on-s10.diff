+test.describe("the foot stands on the safe-area inset (chair §6.1)", () => {
+  test.use({ viewport: { width: 390, height: 844 }, isMobile: true, hasTouch: true, deviceScaleFactor: 2 });
+  /** The foot's LOWEST PAINTED INK, in css px: the foot photographed ON and with every child
+   *  hidden, the lowest device row where any pixel moved. A computed `34px` is not paint. */
+  const LOWEST_INK = async (page: Page) => {
+    const g = await page.evaluate(() => {
+      const b = document.getElementById("card-foot")!.getBoundingClientRect();
+      return { x: Math.max(0, Math.floor(b.left)), y: Math.floor(b.top), w: Math.floor(Math.min(b.width, innerWidth - b.left)), h: Math.ceil(Math.min(b.bottom, innerHeight) - Math.floor(b.top)) };
+    });
+    const clip = { x: g.x, y: g.y, width: g.w, height: g.h };
+    // TWO ON photographs: a pixel counts only where both agree, so a boil tick between shots (the
+    // case frame's pose swap — CTRL-TAPE's 4-of-7 red on the correct tree) is not read as ink.
+    const on = (await page.screenshot({ clip })).toString("base64");
+    const on2 = (await page.screenshot({ clip })).toString("base64");
+    const hide = await page.addStyleTag({ content: "#card-foot * { visibility: hidden !important; }" });
+    const off = (await page.screenshot({ clip })).toString("base64");
+    await hide.evaluate((n) => (n as Element).remove());
+    const lowestRow = await page.evaluate(
+      async ({ on, on2, off, ch }) => {
+        const px = async (b64: string) => {
+          const bmp = await createImageBitmap(await (await fetch(`data:image/png;base64,${b64}`)).blob());
+          const c = new OffscreenCanvas(bmp.width, bmp.height);
+          const x = c.getContext("2d")!;
+          x.drawImage(bmp, 0, 0);
+          return x.getImageData(0, 0, bmp.width, bmp.height);
+        };
+        const [a, a2, b] = [await px(on), await px(on2), await px(off)];
+        const d = (p: ImageData, q: ImageData, o: number) =>
+          Math.max(Math.abs(p.data[o] - q.data[o]), Math.abs(p.data[o + 1] - q.data[o + 1]), Math.abs(p.data[o + 2] - q.data[o + 2]));
+        for (let y = a.height - 1; y >= 0; y--)
