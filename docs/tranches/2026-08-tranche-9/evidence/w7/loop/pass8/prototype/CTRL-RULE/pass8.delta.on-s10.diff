+      return `${plant.prepend ?? ""}\n${t}\n${plant.css ?? ""}`;
+    };
+    const r = elementSites(FE, {
+      file: "src/games/shared/GameScene.vue",
+      pick: (el: { id?: string }) => el.id === "card-foot",
+      props: ["padding-bottom"],
+      read,
+    });
+    // `regimes` off = the one portrait cell (what a row that reads one emulated cell sees)
+    const regimes: string[] = off.includes("regimes") ? ["phone-portrait-390x844"] : DOCK;
+    const bad: string[] = [];
+    if (!r.elements.length) bad.push("no #card-foot in GameScene's template");
+    for (const regime of regimes) {
+      const live = r.sites.filter((x: { regimes?: string[] }) => (x.regimes ?? DOCK).includes(regime));
+      const read1 = off.includes("every-site") ? [effectiveAt(r.sites, regime)].filter(Boolean) : live;
+      if (!read1.length) bad.push(`${regime}: no site pads the foot`);
+      for (const x of read1)
+        if (!(off.includes("shape") ? /env\(\s*safe-area-inset-bottom/ : STACKED).test(String(x.value).trim()))
+          bad.push(`${regime}: ${x.file}:${x.line} ${x.prelude} { ${x.prop}: ${x.value}${x.important ? " !important" : ""} }`);
+    }
+    return { sites: r.sites.length, bad };
+  };
+  const FOOT_PAD_PLANTS: [string, Plant][] = [
