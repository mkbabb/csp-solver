+// shape-census.mjs — THE ESTATE'S ONE shape-census library (T9-W7; LAWS P6 §I, P7 §C/§F/§I;
+// registry-v7 §2.4 PRODUCT HOME). Every source gate reads the SHAPE through this file, never the
+// spelling, and never through a second reader: a lane that needs a shape this file does not read
+// extends THIS file with the plant that reds it (`--self-test` below), never its own copy.
+// NOT-A-LANE: an importable library plus its browserless self-test; its callers are the source gates that import it (lint:bands, lint:theme-tokens, lint:ink, test:font-coverage on the §13+§7+§3 union) and the pass-8 lanes, cited at docs/tranches/2026-08-tranche-9/evidence/w7/loop/pass7/registry-v7.md §2.4 and pass8/instruments/README.md.
+//
+// LINEAGE. Seeded from MOT-LADDER's product copy on the §13+§7+§3 union (itself the chair's pass-7
+// `instruments/shape-census.mjs`, sha1 3ba7738ee8d4, prettier-formatted, with LADDER's at-rule own
+// declarations), which the union kept as the superset of three vendored copies. Pass 8's batch 0
+// folded every PROPOSED extension registry-v7 §2.4 names into it. Each extension is a CLAUSE with an
+// id: `--self-test` carries the plant that reds it, and `--sabotage-battery` switches each clause off
+// in turn and demands the self-test red (LAWS P7 §F (ii)). The clause ids, by family:
+//   FACE     sfc-toplevel · at-own · wildcard · tw-split · tpl-file · script-css
+//   GRAPHITE tok-sites · tw-arbitrary · at-property-site · r1-dark-arm
+//   TIN      strip-regex · rel-color
+//   LIVE     masked
+//   VERB     is-where-arms · stem-all · setprop-computed · const-carried
+//   SIX      url-dyn · decode · tag-unresolved · h-spread · barrel · pin-binds
+//   WALK     csstext · style-computed-key · import-chain
+//   LADDER   collect-walk · longhand · semicolon-less · clock-arith
+//   ERASE    pcss · register-split
+//   TAPE     element-keyed · tw-utility
+//   LEDGER   media-eval · em-lh · r4-bound
+//   TAB-PEN  html-comment · one-link · token-conflict
+//
+// What it reads (every site a declaration can reach a subject from):
+//   · every TOP-LEVEL <style> block of every SFC (a `<style>` inside a <script> string is never a
+//     stylesheet), every stylesheet in a Vite CSS language (.css .pcss .postcss) under src/ and
+//     public/**, index.html's <style>, and every file an `@import` chain reaches wherever it sits;
+//     comments stripped by a STRING-AWARE (and, for JS, REGEX-LITERAL-AWARE) stripper per language
+//   · nested rules at any depth with their at-rule context, an at-rule's OWN declarations (`@theme`
+//     as :root, `@utility x` as `.x`, `@font-face`/`@property` descriptors), every declaration in
+//     SOURCE ORDER with `!important` read, the last one semicolon-less; a shorthand is a hit on its
+//     longhands and a longhand a hit on its shorthand
+//   · the SUBJECT COMPOUND of each selector: positive classes (incl. :is()/:where() arms) vs negated
+//     ones (:not()); a tail holds under :is()/:where() only when EVERY arm carries it; the wildcard
+//     subject `*` reads every rule; a subject can also be RESOLVED TO TEMPLATE ELEMENTS and every
+//     rule that may match the element read (an extra class, a structural selector, an attribute)
+//   · template `style="…"` attributes, `:style` objects (quoted, unquoted, COMPUTED keys), `:style`
+//     strings, and Tailwind candidates (arbitrary values and arbitrary properties `[ --tok:v ]` whole)
+//   · script style writes anywhere (.vue/.ts/.tsx/.js/.mjs): `.style.prop =`, `.style['prop'] =`,
+//     `.style[expr] =` and `setProperty(<non-literal>, …)` as UNRESOLVED sites (never dropped),
+//     concatenated names and values folded (`"a" + "b"`, `[…].join()`, `.concat()`, same-file
+//     consts), `cssText =` and `setAttribute("style", …)`, `Object.assign(x.style, {…})`, and CSS
+//     text inside script strings
+//   · tokens: `--x:` declarations everywhere (+ script publishers `tokenSites`, `@property`
+//     `initial-value`, Tailwind arbitrary properties); `resolve(value)` evaluates var() with
+//     fallbacks; `var(--stem-${x})` is EVERY name the whole template can spell, else UNRESOLVED
+//   · media queries EVALUATED over the regime set (never matched as text); em/lh/rem RESOLVED at
+//     the consumer; a lower bound through calc/clamp/min/max
+//   · colours: ONE parser (hex, rgb, hsl, hwb, lab, lch, oklab, oklch, color(), named, transparent,
+//     color-mix, and RELATIVE colour syntax with literal channels) → sRGB; ΔE in OKLab
+//   · components: template tags and h()/createVNode calls resolved to files through imports and
+//     barrels (a tag that resolves to nothing is UNRESOLVED), spreads and computed keys as
+//     `v-bind=obj`; svg `url(#id)` references with entities and CSS escapes decoded
+import { readFileSync, readdirSync, statSync, existsSync } from "node:fs";
+import { join, relative, dirname, resolve as resolvePath } from "node:path";
+import { fileURLToPath } from "node:url";
+import process from "node:process";
+
+// -------------------------------------------------------------------------------------- clauses
+/** Every folded clause, keyed by id → the family whose PROPOSED diff or critic row it came from. */
+export const CLAUSES = {
+  "sfc-toplevel":
+    "FACE · sfc() reads top-level blocks only (no <style> inside <script>)",
+  "at-own":
+    "FACE/GRAPHITE/LADDER · an at-rule's own declarations (@utility as .x, @theme as :root)",
+  wildcard: "FACE · the wildcard subject `*`",
+  "tw-split": "FACE · Tailwind arbitrary values kept whole (font-[ … ])",
+  "tpl-file": "FACE · template sites attributed to their file",
+  "script-css": "FACE · CSS text inside script strings",
+  "tok-sites": "GRAPHITE · tokenSites: every publisher of a custom property",
+  "tw-arbitrary":
+    "GRAPHITE · Tailwind arbitrary properties [ --tok:v ] as declaration sites",
+  "at-property-site":
+    "GRAPHITE · @property preludes (initial-value) as declaration sites",
+  "r1-dark-arm": "GRAPHITE · R1's second path (a chromatic token with no dark arm)",
+  "strip-regex": "TIN · the JS stripper is regex-literal aware",
+  "rel-color": "TIN · relative colour syntax with literal channels",
+  masked: "LIVE · maskedDefaults (case-insensitive var(, stems, concatenation)",
+  "is-where-arms":
+    "VERB · a tail holds under :is()/:where() only when every arm carries it",
+  "stem-all":
+    "VERB · a ${} stem is every name the whole template spells, else unresolved",
+  "setprop-computed": "VERB · setProperty(<non-literal>) is a `?` consumer site",
+  "const-carried": "VERB · a same-file const carries its value to a write",
+  "url-dyn": "SIX · url(${base}#${id}) and every interpolated url( is UNRESOLVED",
+  decode: "SIX · HTML entities and CSS escapes decoded before any id regex",
+  "tag-unresolved": "SIX · a tag that resolves to no file is UNRESOLVED",
+  "h-spread": "SIX · spread/computed keys in h()/createVNode (aliased) as v-bind=obj",
+  barrel: "SIX · a barrel alias is followed to its file",
+  "pin-binds": "SIX · a pin carries its bind set",
+  csstext: "WALK · concatenated cssText and setAttribute('style') writes",
+  "style-computed-key": "WALK · a computed :style key is a `?` site",
+  "import-chain": "WALK · @import chains followed wherever they lead",
+  "collect-walk": "LADDER · index.html and public/** walked",
+  longhand: "LADDER · a longhand answers for its shorthand",
+  "semicolon-less": "LADDER · a semicolon-less declaration before a nested rule",
+  "clock-arith":
+    "LADDER · Math.min/max, bracket and bitwise clock reads are arithmetic",
+  pcss: "ERASE · .pcss/.postcss sheets walked",
+  "register-split": "ERASE · a split-name registerProperty is resolved or UNRESOLVED",
+  "element-keyed": "TAPE · the subject resolved to template ELEMENTS",
+  "tw-utility":
+    "TAPE · utility classes that move paint (opacity-[…], sr-only, blur, contain, translate)",
+  "media-eval": "LEDGER · media queries EVALUATED over the regime set",
+  "em-lh": "LEDGER · em/lh/rem resolved at the consumer",
+  "r4-bound": "LEDGER · a lower bound through calc/clamp/min/max",
+  "html-comment": "TAB-PEN · HTML comments stripped before links are read",
+  "one-link": "TAB-PEN · exactly one uncommented link per rel",
+  "token-conflict": "TAB-PEN · two placed sites of one token that disagree",
+};
+const OFF = new Set(
+  (process.env.SHAPE_SABOTAGE ?? "")
+    .split(",")
+    .map((s) => s.trim())
+    .filter(Boolean),
+);
+const on = (id) => !OFF.has(id);
+/** Switch clauses off (the clause-sabotage battery; LAWS P7 §F (ii)). `[]` restores all. */
+export function sabotage(ids = []) {
+  OFF.clear();
+  for (const i of ids) OFF.add(i);
+}
+
+// ---------------------------------------------------------------------------------------- files
+const fsLs = (d) =>
+  existsSync(d)
+    ? readdirSync(d).map((name) => ({
+        name,
+        dir: statSync(join(d, name)).isDirectory(),
+      }))
+    : null;
+/** Every file under `dir` passing `pred` (dot-dirs and node_modules skipped). `ls` lists a directory
+ *  as [{name, dir}] (default: the disk; the self-test passes a virtual tree). */
+export function walk(dir, pred, out = [], ls = fsLs) {
+  const entries = ls(dir);
+  if (!entries) return out;
+  for (const { name: n, dir: isDir } of entries) {
+    if (n === "node_modules" || n.startsWith(".")) continue;
+    const p = join(dir, n);
+    if (isDir) walk(p, pred, out, ls);
+    else if (pred(p)) out.push(p);
+  }
+  return out;
+}
+const isTest = (p) =>
+  /\.(test|spec)\.[cm]?[jt]sx?$/.test(p) || /[\\/]__tests__[\\/]/.test(p);
+/** A Vite CSS language (ERASE: `.pcss`/`.postcss` ship through the same pipeline as `.css`). */
+export const isCss = (p) => (on("pcss") ? /\.(css|pcss|postcss)$/ : /\.css$/).test(p);
+/** Every source a declaration can come from, under the frontend root `fe`: src/ (code and every
+ *  CSS language), public/** stylesheets, index.html, and every file an `@import` chain reaches. */
+export function sources(fe, { tests = false, read, exists, ls = fsLs } = {}) {
+  const ex = exists ?? existsSync;
+  const src = walk(
+    join(fe, "src"),
+    (p) => (isCss(p) || /\.(vue|ts|tsx|js|mjs|json)$/.test(p)) && (tests || !isTest(p)),
+    [],
+    ls,
+  );
+  // LADDER: `collect()` walked src/ alone — a `<style>` in index.html or a public/** sheet
+  // shortened the reveal with every gate at 0
