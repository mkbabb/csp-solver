index 00000000..a19fea4c
--- /dev/null
+++ b/web/frontend/scripts/check-favicon.mjs
@@ -0,0 +1,1405 @@
+#!/usr/bin/env node
+/**
+ * THE FAVICON GATE (T9-M22, TAB-PEN). The tab's s is one pen line on the page's paper, in the page's
+ * ink. It reads the SHAPE, not the spelling (LAWS P6 §F): the markup against an allowlist, every
+ * `<style>` rule in source order with the last one winning, the page's links and tokens through the
+ * estate's ONE library (`shape-census.mjs`: `htmlLinks`, `tokenSites`, `tokenConflicts`, colours
+ * scored by ΔE), the path rastered analytically, and the touch icon's own pixels. Browserless.
+ *
+ *   a  the markup     exactly one each of svg, style, rect, path, and nothing else: no comment, no
+ *                     entity, no second element, no attribute outside the allowlist (so no filter,
+ *                     clip, rx/ry, transform, opacity, style="", dasharray). viewBox `0 0 32 32`; the
+ *                     rect covers it at 0,0; the rect is painted before the path.
+ *   b  one pen line   the path: fill none, round caps and joins, stroke-width a bare number in
+ *                     [3.6, 5.2] of the 32 viewBox. The `<style>` body holds `rect{fill}` and
+ *                     `path{stroke}` only, at the top level or inside `@media (prefers-color-scheme:
+ *                     dark)`; no other property, selector, at-rule or !important. <= 600 B.
+ *   c  the page's     the painted fill and stroke, resolved per scheme through the cascade (the
+ *      colours        attributes, then every rule in source order), are the page's
+ *                     --color-background / --color-foreground (ΔE <= 0.5, opaque) in light and in
+ *                     dark. The tokens are read at EVERY site the library finds; a site outside
+ *                     `:root`/`@theme` and `.dark` is RED, two placed sites that disagree are RED
+ *                     (never resolved by walk order), and an unresolved `setProperty` is RED. Ink
+ *                     over paper >= 7:1 in each scheme.
+ *   d  the pen        the path and stroke-width are the arm table's (`scripts/icons.mjs`: PEN[ARM],
+ *                     WIDTH); the exact extrema bbox inflated by half the pen is within [0.55, 0.80]
+ *                     of the tile per axis, centred within 0.5 unit; stroke / (bbox H + stroke) is in
+ *                     WINDOWS[WIDTH] (a tab-size legibility window, 2 px at 16 px, keyed to the pen's
+ *                     width so the owner's arm B needs one const, not a gate edit); the path's ink
+ *                     MASS, rastered analytically at 180 (4 × 4 samples a pixel), is in [0.18, 0.32].
+ *   e  the estate     index.html (comments stripped) carries EXACTLY ONE rel~=icon, to /icon.svg, and
+ *                     exactly one apple-touch-icon, to /apple-touch-icon.png; favicon.svg is gone
+ *                     (the rename busts the favicon store); scripts/icons.provenance.json carries both
+ *                     files' sha256; the PNG decodes to 180 x 180, opaque, its paper the light token
+ *                     (ΔE <= 2), its ink coverage in [0.18, 0.32], its darkest pixel the light ink
+ *                     (ΔE <= 4), and it IS the path: its per-pixel coverage against the analytic
+ *                     raster reads mean |Δ| <= 0.02 and IoU >= 0.97. A PNG that isn't the s reds on
+ *                     content, whatever the sidecar says.
+ *
+ * `--self-test` plants defects in memory; each must RED exactly its clause set (and the check ids it
+ * names), and the negative-negatives must stay GREEN. `--sabotage-battery` switches each check off in
+ * turn, and each of the library clauses this gate reads, and the self-test must red every time.
+ * Run: `node scripts/check-favicon.mjs [--self-test | --sabotage-battery] [--root <web/frontend>]`.
+ */
+import { createHash } from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+import process from "node:process";
+import zlib from "node:zlib";
+import { ARM, PEN, WIDTH, WINDOWS } from "./icons.mjs";
+import {
+  cssRules,
+  deltaE,
+  exactlyOneLink,
+  parseColor,
+  resolve,
+  sabotage,
+  sources,
+  stripCss,
+  tokenConflicts,
+  tokenSites,
+  tokens,
+} from "./shape-census.mjs";
+
+const argRoot = process.argv.indexOf("--root");
+const ROOT =
+  argRoot > 0
+    ? path.resolve(process.argv[argRoot + 1])
+    : path.join(import.meta.dirname, "..");
+const TOKENS = ["--color-background", "--color-foreground"];
+const sha256 = (b) => createHash("sha256").update(b).digest("hex");
+const OFF = new Set(); // the gate's own sabotage switch (check ids)
+
+/* ── colour ─────────────────────────────────────────────────────────────────── */
+const lum = ({ rgb }) =>
+  rgb
+    .map((v) => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4))
+    .reduce((s, v, i) => s + v * [0.2126, 0.7152, 0.0722][i], 0);
+const contrast = (a, b) => {
+  const [hi, lo] = [lum(a), lum(b)].sort((p, q) => q - p);
+  return (hi + 0.05) / (lo + 0.05);
+};
+const opaque = (c) => c && (c.a ?? 1) >= 0.999;
+
+/** The page's two tokens through the ONE library, placed light (`:root`, which `@theme` reads as) /
+ *  dark (`.dark`) / unplaced, with the library's conflicts. The library reads each file once (cached
+ *  on its path and text; a plant that adds a file pays for that file alone); memoised per list. */
+const siteCache = new WeakMap();
+const fileCache = new Map();
+function fileTokens({ file, text }) {
+  const key = `${file}\u0000${text}`;
+  if (!fileCache.has(key)) {
+    const abs = path.join(ROOT, file);
+    const io = {
+      files: [abs],
+      read: (p) => (p === abs ? text : fs.readFileSync(p, "utf8")),
+      exists: (p) => p === abs || fs.existsSync(p),
+    };
+    const mine = (x) => x.file === file; // an @import's target is read at its own entry
+    fileCache.set(key, {
+      sites: TOKENS.flatMap((prop) =>
+        tokenSites(ROOT, prop, io)
+          .filter(mine)
+          .map((x) => ({ ...x, prop })),
+      ),
+      decls: tokens(ROOT, io).all.filter(mine),
+    });
+  }
+  return fileCache.get(key);
+}
+function pageTokens(files) {
+  if (siteCache.has(files)) return siteCache.get(files);
+  const per = files.map(fileTokens);
+  const sites = per.flatMap((f) => f.sites);
+  const map = new Map(per.flatMap((f) => f.decls.map((x) => [x.prop, x.value])));
+  const placed = sites.filter((s) => !s.unresolved);
+  const home = (s) =>
+    s.ctx || s.important
+      ? null
+      : s.prelude.replace(/\s+/g, "") === ":root"
+        ? "light"
+        : s.prelude.replace(/\s+/g, "") === ".dark"
+          ? "dark"
+          : null;
+  const tok = { light: {}, dark: {} };
+  for (const s of placed)
+    if (home(s)) tok[home(s)][s.prop] = parseColor(resolve(s.value, map));
+  const conflicts = tokenConflicts(placed);
+  // A token whose placed sites disagree has no value this gate can know (the build's order decides):
+  // it resolves to nothing, in whichever order the walk met the sites.
+  for (const c of conflicts) if (home(c.sites[0])) tok[home(c.sites[0])][c.name] = null;
+  const out = {
+    tok,
+    unplaced: placed.filter((s) => !home(s)),
+    unresolved: sites.filter((s) => s.unresolved),
+    conflicts,
+  };
+  siteCache.set(files, out);
+  return out;
+}
+
+/* ── the markup ─────────────────────────────────────────────────────────────── */
+const ALLOWED = {
+  svg: ["xmlns", "viewBox"],
+  style: [],
+  rect: ["width", "height", "fill", "x", "y"],
+  path: ["d", "fill", "stroke", "stroke-width", "stroke-linecap", "stroke-linejoin"],
+};
+function parseSvg(svg) {
+  const els = [];
+  let styleText = "";
+  const tag =
+    /<(\/?)([A-Za-z][\w:.-]*)((?:\s+[^\s=>/]+\s*=\s*(?:"[^"]*"|'[^']*'))*)\s*(\/?)>/y;
+  const junk = [];
+  let i = 0;
+  let inStyle = false;
+  while (i < svg.length) {
+    if (inStyle) {
+      const end = svg.indexOf("</style>", i);
+      if (end < 0) return { els, styleText, junk: ["an unclosed <style>"] };
+      styleText += svg.slice(i, end);
+      i = end;
+      inStyle = false;
+      continue;
+    }
+    const lt = svg.indexOf("<", i);
+    const text = svg.slice(i, lt < 0 ? svg.length : lt);
+    if (text.trim()) junk.push(`text "${text.trim().slice(0, 20)}"`);
+    if (lt < 0) break;
+    tag.lastIndex = lt;
+    const m = tag.exec(svg);
+    if (!m) {
+      junk.push(`markup this gate can't read at "${svg.slice(lt, lt + 12)}"`);
+      break;
+    }
+    i = tag.lastIndex;
+    if (m[1]) continue;
+    const attrs = [...m[3].matchAll(/([^\s=]+)\s*=\s*(?:"([^"]*)"|'([^']*)')/g)].map(
+      (a) => [a[1], a[2] ?? a[3]],
+    );
+    els.push({
+      name: m[2],
+      attrs,
+      dupe: new Set(attrs.map(([k]) => k)).size < attrs.length,
+    });
+    if (m[2] === "style" && !m[4]) inStyle = true;
+  }
+  return { els, styleText, junk };
+}
+
+/* ── geometry: absolute M/L/H/V/C/Q/Z → polylines (curves at 24 steps) and exact extrema ─────── */
+function geometry(d) {
+  const t = d.match(/[A-Za-z]|-?\d*\.?\d+(?:e-?\d+)?/g);
+  if (!t || t.some((x) => /[a-z]/.test(x) || /[^MLHVCQZ\d.e-]/.test(x))) return null;
+  const xs = [];
+  const ys = [];
+  const lines = [];
+  let line = null;
+  const ext = (v) => {
+    const out = [v[0], v[v.length - 1]];
+    const roots = [];
+    if (v.length === 4) {
+      const [a, b, c] = [
+        -v[0] + 3 * v[1] - 3 * v[2] + v[3],
+        2 * (v[0] - 2 * v[1] + v[2]),
+        v[1] - v[0],
+      ];
+      if (Math.abs(a) < 1e-12) {
+        if (Math.abs(b) > 1e-12) roots.push(-c / b);
+      } else if (b * b - 4 * a * c >= 0) {
+        const s = Math.sqrt(b * b - 4 * a * c);
+        roots.push((-b + s) / (2 * a), (-b - s) / (2 * a));
+      }
+    } else if (Math.abs(v[0] - 2 * v[1] + v[2]) > 1e-12)
+      roots.push((v[0] - v[1]) / (v[0] - 2 * v[1] + v[2]));
+    for (const u of roots.filter((r) => r > 0 && r < 1)) out.push(bez(v, u));
+    return out;
+  };
+  const bez = (v, u) =>
+    v.length === 4
+      ? (1 - u) ** 3 * v[0] +
+        3 * (1 - u) ** 2 * u * v[1] +
+        3 * (1 - u) * u * u * v[2] +
+        u ** 3 * v[3]
+      : (1 - u) ** 2 * v[0] + 2 * (1 - u) * u * v[1] + u * u * v[2];
+  let [cx, cy] = [0, 0];
+  let cmd = "";
+  for (let i = 0; i < t.length;) {
+    if (/[A-Z]/.test(t[i])) cmd = t[i++];
+    const n = () => +t[i++];
+    if (cmd === "Z") {
+      if (line) {
+        line.push(line[0]);
+        [cx, cy] = line[0];
+      }
+      continue;
+    }
+    if (cmd === "M") {
+      [cx, cy] = [n(), n()];
+      lines.push((line = [[cx, cy]]));
+      cmd = "L"; // implicit lineto after a moveto's first pair
+    } else if (cmd === "L") [cx, cy] = [n(), n()];
+    else if (cmd === "H") cx = n();
+    else if (cmd === "V") cy = n();
+    else if (cmd === "C" || cmd === "Q") {
+      const p = [[cx, cy]];
+      for (let k = 0; k < (cmd === "C" ? 3 : 2); k++) p.push([n(), n()]);
+      xs.push(...ext(p.map((q) => q[0])));
+      ys.push(...ext(p.map((q) => q[1])));
+      for (let k = 1; k <= 24; k++)
+        line?.push([
+          bez(
+            p.map((q) => q[0]),
+            k / 24,
+          ),
+          bez(
+            p.map((q) => q[1]),
+            k / 24,
+          ),
+        ]);
+      [cx, cy] = p[p.length - 1];
+      continue;
+    } else return null;
+    if (!line) return null;
+    if (cmd !== "L" || line.length > 1 || line[0][0] !== cx || line[0][1] !== cy)
+      line.push([cx, cy]);
+    xs.push(cx);
+    ys.push(cy);
+  }
+  if (!lines.length || xs.some(Number.isNaN)) return null;
+  return {
+    box: [Math.min(...xs), Math.min(...ys), Math.max(...xs), Math.max(...ys)],
+    lines,
+  };
+}
+
+/** Per-pixel ink coverage of a round-capped, round-joined pen of `pen` units along the path, on an
+ *  `n` × `n` raster of the 32 viewBox, `ss` × `ss` samples a pixel (the union of capsules IS the
+ *  round-cap/round-join stroke). Memoised. */
+const rasterCache = new Map();
+function raster(d, pen, n = 180, ss = 4) {
+  const key = `${d}|${pen}|${n}|${ss}`;
+  if (rasterCache.has(key)) return rasterCache.get(key);
+  const g = geometry(d);
+  if (!g) return null;
+  const k = (n * ss) / 32;
+  const S = n * ss;
+  const r = (pen / 2) * k;
+  const ink = new Uint8Array(S * S);
+  for (const line of g.lines)
+    for (let j = 0; j < line.length; j++) {
+      const [ax, ay] = [line[j][0] * k, line[j][1] * k];
+      const [bx, by] =
+        j + 1 < line.length ? [line[j + 1][0] * k, line[j + 1][1] * k] : [ax, ay];
+      const [dx, dy] = [bx - ax, by - ay];
+      const L2 = dx * dx + dy * dy;
+      const x0 = Math.max(0, Math.floor(Math.min(ax, bx) - r));
+      const x1 = Math.min(S - 1, Math.ceil(Math.max(ax, bx) + r));
+      const y0 = Math.max(0, Math.floor(Math.min(ay, by) - r));
+      const y1 = Math.min(S - 1, Math.ceil(Math.max(ay, by) + r));
+      for (let y = y0; y <= y1; y++)
+        for (let x = x0; x <= x1; x++) {
+          const [px, py] = [x + 0.5 - ax, y + 0.5 - ay];
+          const u = L2 ? Math.max(0, Math.min(1, (px * dx + py * dy) / L2)) : 0;
+          const [ex, ey] = [px - u * dx, py - u * dy];
+          if (ex * ex + ey * ey <= r * r) ink[y * S + x] = 1;
+        }
+    }
+  const cov = new Float64Array(n * n);
+  for (let y = 0; y < S; y++)
+    for (let x = 0; x < S; x++)
+      if (ink[y * S + x])
+        cov[Math.floor(y / ss) * n + Math.floor(x / ss)] += 1 / (ss * ss);
+  const out = { cov, mass: cov.reduce((s, v) => s + v, 0) / (n * n) };
+  rasterCache.set(key, out);
+  return out;
+}
