+    Math.abs(d1[i] - d2[i]),
+    Math.abs(d1[i + 1] - d2[i + 1]),
+    Math.abs(d1[i + 2] - d2[i + 2]),
+  );
+
+/** Two rendering updates (a style tag or a mask lands before the next photograph). */
+export const settle = (page) =>
+  page.evaluate(
+    () => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))),
+  );
+
+/** Photograph `clip` twice: as is, then with `offCss` injected (removed after). Returns the decoded pair. */
+export async function onOff(page, clip, offCss) {
+  const on = await page.screenshot({ clip, scale: "device", animations: "disabled" });
+  const tag = await page.addStyleTag({ content: offCss });
+  await settle(page);
+  const off = await page.screenshot({ clip, scale: "device", animations: "disabled" });
+  await tag.evaluate((e) => e.remove());
+  await settle(page);
+  return { on: await rgb(on), off: await rgb(off) };
+}
+
+/** Page-side: the rects of the subject's TEXT RUN — its text nodes only, never an svg or a hidden
+ *  descendant (TIN/FIVE: a Range over the element counted the tape's inline svg as run, and TAIL12
+ *  landed on the svg). `chars: true` returns one rect per non-space character (the glyph windows). */
+export function textRunRects({ subject, chars = false }) {
+  const el = document.querySelector(subject);
+  if (!el) return null;
+  const out = [];
+  const tw = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
+    acceptNode(n) {
+      if (!n.textContent.trim()) return NodeFilter.FILTER_REJECT;
+      for (let p = n.parentElement; p && p !== el.parentElement; p = p.parentElement) {
+        if (p instanceof SVGElement) return NodeFilter.FILTER_REJECT;
+        const cs = getComputedStyle(p);
+        if (cs.display === "none" || cs.visibility === "hidden") return NodeFilter.FILTER_REJECT;
+      }
+      return NodeFilter.FILTER_ACCEPT;
