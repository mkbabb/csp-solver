+#!/usr/bin/env node
+/**
+ * THE TAB'S PEN (T9-M22, TAB-PEN). Writes `public/icon.svg` from one pen line, rasters its light arm
+ * to `public/apple-touch-icon.png` (180 × 180, square paper: iOS rounds the corners itself, palette
+ * PNG), and records both files' sha256 in `scripts/icons.provenance.json`. CI never rasters: the PNG
+ * is vendored, and `check-favicon.mjs` (d, e) re-derives the path's coverage analytically and holds
+ * the PNG to it.
+ *
+ * THE ARM TABLE. Two owner ballots, one const each; flip one, run `npm run icons`, and the gate reads
+ * the pair against that arm's own windows:
+ *   ARM   (T9-B27, the hand): `W` the written monoline s (the default), `H` the house hand (the same
+ *         box, pen and paper with the 5's grammar borrowed: a short down-tick into a flat, slightly
+ *         tilted top stroke, one hard join at 94.5°).
+ *   WIDTH (T9-B28, the pen's width in the 32 viewBox): `4` (arm A, the default) or `5` (arm B).
+ * Arm P (a Fraunces outline) is not a pen line: choosing it re-cuts clause b, not a const.
+ *
+ * `sharp` is NOT a dependency of this package. It is miniflare's transitive (package-lock.json,
+ * `node_modules/sharp`), resolved through createRequire only when this file runs as a script, so the
+ * gate can import the table without it; a wrangler/miniflare bump can move it.
+ *
+ * NOT-A-LANE: it rides an undeclared transitive (sharp via miniflare) and writes committed binaries, so its cadence is a re-cut of the pen, run by hand; CI holds the pair through lint:favicon, which reads this file's arm table, the sidecar and the PNG's own pixels with no rasteriser (scripts/check-favicon.mjs).
+ *
+ * Run: `node scripts/icons.mjs` (write) · `node scripts/icons.mjs --check` (re-derive; exit 1 on
+ * any drift: the SVG's bytes, the PNG's decoded pixels, the sidecar). cwd web/frontend.
+ */
+import { createHash } from "node:crypto";
+import { createRequire } from "node:module";
+import fs from "node:fs";
+import path from "node:path";
+import process from "node:process";
+import { pathToFileURL } from "node:url";
+
+export const ARM = "W";
+export const WIDTH = 4;
+export const PEN = {
+  W: "M22.6,9.6C21.4,7.1 18.6,6 15.8,6C12,6 9.6,7.9 9.6,10.6C9.6,13.4 12.4,14.6 16.2,15.8C21,17.3 24,18.4 24,21.2C24,24.4 20.4,26 15.8,26C11.6,26 8,24.6 8,22.6",
+  H: "M23.6,8.7L23.9,6.3L15.2,5.9C11.2,5.8 9.3,8.1 9.6,10.9C10,13.9 12.8,14.7 16.6,16C21.4,17.5 24.2,18.9 23.8,21.7C23.5,24.7 19.9,26.3 15.4,26.1C11.4,25.9 8.4,24.2 8.1,22.2",
+};
+/** Clause d's stroke / (bbox H + stroke) window per pen width: each arm's own reading ± 0.01. */
+export const WINDOWS = { 4: [0.15, 0.17], 5: [0.19, 0.21] };
+// The page's tokens (index.css @theme / .dark), byte-copied; lint:favicon (c) reds any drift.
+const [PAPER, INK, DARK_PAPER, DARK_INK] = ["#fbfaf9", "#0a0a0a", "#110f0e", "#edece9"];
+
+const style = (paper, ink) => `rect{fill:${paper}}path{stroke:${ink}}`;
+export const icon = (d, width = WIDTH, dark = true) =>
+  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><style>${style(PAPER, INK)}${
+    dark ? `@media(prefers-color-scheme:dark){${style(DARK_PAPER, DARK_INK)}}` : ""
+  }</style><rect width="32" height="32" fill="${PAPER}"/><path d="${d}" fill="none" stroke="${INK}" stroke-width="${width}" stroke-linecap="round" stroke-linejoin="round"/></svg>\n`;
+
+async function main() {
+  const ROOT = path.join(import.meta.dirname, "..");
+  const SVG = path.join(ROOT, "public", "icon.svg");
+  const PNG = path.join(ROOT, "public", "apple-touch-icon.png");
+  const SIDECAR = path.join(ROOT, "scripts", "icons.provenance.json");
+  const SIZE = 180;
+  const sha = (b) => createHash("sha256").update(b).digest("hex");
+  const sharp = createRequire(path.join(ROOT, "package.json"))("sharp");
+  const svg = icon(PEN[ARM]);
+  // The light arm, explicitly: the rasteriser's own prefers-color-scheme is not a thing to rely on.
+  const raster = () =>
+    sharp(Buffer.from(icon(PEN[ARM], WIDTH, false)), { density: (72 * SIZE) / 32 })
+      .resize(SIZE, SIZE)
+      .png({ palette: true, compressionLevel: 9 })
+      .toBuffer();
+  const pixels = (buf) => sharp(buf).ensureAlpha().raw().toBuffer();
+  const sidecar = (png) =>
+    `${JSON.stringify({ arm: ARM, width: WIDTH, "icon.svg": sha(svg), "apple-touch-icon.png": sha(png) }, null, 2)}\n`;
+
+  if (process.argv.includes("--check")) {
+    const kept = fs.readFileSync(PNG);
+    const [fresh, old] = [await pixels(await raster()), await pixels(kept)];
+    let maxDelta = fresh.length === old.length ? 0 : 255;
+    for (let i = 0; i < Math.min(fresh.length, old.length); i++)
+      maxDelta = Math.max(maxDelta, Math.abs(fresh[i] - old[i]));
+    const svgOk = fs.readFileSync(SVG, "utf8") === svg;
+    const sideOk = fs.readFileSync(SIDECAR, "utf8") === sidecar(kept);
+    console.log(
+      `icons --check (arm ${ARM}, width ${WIDTH}): svg ${svgOk ? "current" : "STALE"}, png decoded max Δ ${maxDelta}, sidecar ${sideOk ? "current" : "STALE"}`,
+    );
+    process.exit(svgOk && maxDelta === 0 && sideOk ? 0 : 1);
+  }
+
+  const png = await raster();
+  fs.writeFileSync(SVG, svg);
+  fs.writeFileSync(PNG, png);
+  fs.writeFileSync(SIDECAR, sidecar(png));
+  console.log(
+    `icon.svg (arm ${ARM}, width ${WIDTH}) ${sha(svg)} · apple-touch-icon.png ${SIZE}×${SIZE}, ${png.length} B`,
+  );
+}
+
+if (
+  process.argv[1] &&
+  import.meta.url === pathToFileURL(path.resolve(process.argv[1])).href
+)
+  await main();
