+function readTree(root) {
+  const read = (...p) => {
+    try {
+      return fs.readFileSync(path.join(root, ...p));
+    } catch {
+      return null;
+    }
+  };
+  const html = String(read("index.html") ?? "");
+  const one = exactlyOneLink(html, "icon").links[0]?.href;
+  const href = one?.startsWith("/") ? one.slice(1) : "icon.svg";
+  let provenance;
+  try {
+    provenance = JSON.parse(String(read("scripts", "icons.provenance.json")));
+  } catch {
+    provenance = null;
+  }
+  return {
+    svg: String(read("public", href) ?? ""),
+    html,
+    files: sources(root).map((f) => ({
+      file: path.relative(root, f),
+      text: fs.readFileSync(f, "utf8"),
+    })),
+    png: read("public", "apple-touch-icon.png"),
+    provenance,
+    iconExists: read("public", "icon.svg") !== null,
+    faviconExists: read("public", "favicon.svg") !== null,
