+        ]);
+      return acc;
+    }, []),
+  );
+}
+/** The box load (LAWS P6 §B: a timing row declares it). */
+export const load = () =>
+  os
+    .loadavg()
+    .map((v) => v.toFixed(2))
+    .join(" ");
