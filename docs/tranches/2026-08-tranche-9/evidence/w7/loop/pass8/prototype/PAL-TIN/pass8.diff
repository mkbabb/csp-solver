+              `${tag} name peer-${k} ${t.spec} · flat worst ${t.worst.toFixed(3)} (${t.under45}/${t.textPx} px <4.5) · ${popFmt(gk.clean)}` +
+                ` || B-TAPE vs HEAD same-index (i=${k - 1}, ${HEAD_INK(k - 1, arm)}) ${sk.coreMedian.toFixed(3)} Δ ${(gk.clean.coreMedian - sk.coreMedian).toFixed(3)}` +
+                ` · vs HEAD best-hue ${best.coreMedian.toFixed(3)} Δ ${(gk.clean.coreMedian - best.coreMedian).toFixed(3)}`,
+            );
+            if (t.worst < 4.5 || t.under45 > 0) fail.push(`${key} name peer-${k}: flat ${t.worst.toFixed(3)}, ${t.under45} px`);
+            const gj = verdict(gk.clean);
+            if (gj.length) fail.push(`${key}·peer-${k}: ${gj.join("; ")}`);
+            if (rung && gk.clean.coreMedian < 4.5 && sk.coreMedian >= 4.5)
+              fail.push(`${key}·peer-${k}: G2 on the rung, HEAD's same-index ink clears (${sk.coreMedian})`);
+            const n = await withCss(`${TAPE} { --color-user-ink: ${NEG(k)} !important; }`, () => paintedName(page, label));
+            neg[arm] = Math.min(neg[arm], n.worst);
+            rows.push(`${tag} neg peer-${k} ${n.spec} · flat worst ${n.worst.toFixed(3)} (${n.under45}/${n.textPx} px <4.5)`);
+          }
+        }
+        // THE TALLY, at B's first cell only (its ground is the same paper everywhere): the name arms
+        // and the pass-5 binding, then X1 / X2 / FAINT — the existence and visibility plants
+        if (index === 5 && x === cells[0]) {
+          const TICK = ".attribution-tape .roster-tick";
+          const tick: [string, string, string | null][] = [
+            ...[1, 2, 3, 4, 5].map((k) => [`name peer-${k}`, `var(--color-peer-${k}-name)`, null] as [string, string, null]),
+            [`stick peer-5 (the pass-5 binding)`, `var(--color-peer-5)`, null],
+            ["X1 opacity 0", "var(--color-peer-5-name)", `${TICK} { opacity: 0 !important; }`],
+            ["X2 stroke transparent", "var(--color-peer-5-name)", `${TICK} path { stroke: transparent !important; }`],
