+// ── 2c · GATE 4 ON THE SURFACE ─────────────────────────────────────────────────────────────
+/** THE SOURCE LAW'S BEHAVIOURAL ROW (LAWS P7 §F (iii)): `check-peer-tin` says `index.css` is the one
+ *  publisher of a player's ink; this reads what PAINTS. B's tape (pinned) on A's page, both themes:
+ *  the name's glyphs and the tally's strokes photographed ON and OFF (a stylesheet), the pixels that
+ *  moved ≥ 0.9 × the most-moved (the fully covered core), their median colour in OKLab against the
+ *  published name arm the cascade resolves — within COPY_DE (0.03, the gate's own copy distance).
+ *  Plants no source reader can see, each in-run and each required RED: another arm's ink written
+ *  onto the label and onto the tally by a stylesheet, and a relative colour 0.05 darker. */
+test("§2c gate 4 on the surface: the tape and its tally paint the published name arm", async ({ browser }, info) => {
+  test.setTimeout(600_000);
+  const { ctx, pages } = await room(browser, 6, IDS);
+  const a = pages[0];
+  const b = pages[5];
+  const x = [...GIVENS].flatMap((ch, i) => (ch === "." && i >= 9 && GIVENS[i - 9] !== "." ? [i] : []))[0];
+  await b.locator(".sudoku-cell input").nth(x).click();
+  await b.locator(".sudoku-cell input").nth(x).fill("7");
+  await expect.poll(() => a.locator(".sudoku-cell input").nth(x).inputValue()).toBe("7");
+  await a.bringToFront();
+  const label = a.locator(TAPE);
+  const TICK = ".attribution-tape .roster-tick";
+  const lab = (css: string) => {
+    const c = parseColor(css);
+    return srgbToOklab(c.rgb) as number[];
+  };
+  const dE = (p: number[], q: number[]) => Math.hypot(p[0] - q[0], p[1] - q[1], p[2] - q[2]);
+  /** the painted core colour of `sel` against `off` (a stylesheet that removes its ink) */
+  const core = async (sel: string, off: string) => {
+    const bb = (await a.locator(sel).first().boundingBox())!;
+    const clip = { x: Math.floor(bb.x - 1), y: Math.floor(bb.y - 1), width: Math.ceil(bb.width + 2), height: Math.ceil(bb.height + 2) };
+    const p = (await onOff(a, clip, off)) as { on: { data: number[] }; off: { data: number[] } };
+    let top = 0;
+    const moved: number[] = [];
+    for (let i = 0; i < p.on.data.length; i += 3) {
+      const d = maxDelta(p.on.data, p.off.data, i);
+      moved.push(d);
+      top = Math.max(top, d);
+    }
+    const px: number[][] = [];
+    moved.forEach((d, n) => {
+      if (top > 0 && d >= 0.9 * top) px.push([p.on.data[3 * n], p.on.data[3 * n + 1], p.on.data[3 * n + 2]]);
+    });
+    const med = [0, 1, 2].map((c) => {
+      const v = px.map((q) => q[c]).sort((u, w) => u - w);
+      return v[v.length >> 1] ?? 0;
+    });
+    return { n: px.length, rgb: `rgb(${med.join(" ")})` };
+  };
+  const COPY_DE = 0.03;
+  const fail: string[] = [];
+  for (const arm of ["light", "dark"] as const) {
+    await setTheme(a, arm);
+    await a.mouse.move(2, 2);
+    await a.locator(".game-cell").nth(x).hover();
+    await expect(label).toBeVisible();
+    const want = await label.evaluate((l) => getComputedStyle(l).color);
+    const other = await a.evaluate(() => {
+      const p = document.createElement("span");
+      p.style.color = "var(--color-peer-3-name)";
+      document.body.appendChild(p);
+      const c = getComputedStyle(p).color;
+      p.remove();
+      return c;
+    });
+    const read = async (what: string, plant: string) => {
+      const tag = plant ? await a.addStyleTag({ content: plant }) : null;
+      await a.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+      const name = await core(TAPE, `${TAPE} { color: transparent !important; -webkit-text-fill-color: transparent !important; }`);
+      const tick = await core(TICK, `${TICK} { visibility: hidden !important; }`);
+      if (tag) await tag.evaluate((e) => (e as Element).remove());
+      const dn = dE(lab(name.rgb), lab(want)),
+        dt = dE(lab(tick.rgb), lab(want));
+      console.log(
+        `§2c ${info.project.name} ${arm} ${what}: the arm ${want} · name core ${name.rgb} (${name.n} px) ΔE ${dn.toFixed(4)} · tally core ${tick.rgb} (${tick.n} px) ΔE ${dt.toFixed(4)}`,
+      );
+      return { dn, dt };
+    };
+    const clean = await read("clean", "");
+    if (!(clean.dn <= COPY_DE)) fail.push(`${arm} clean: the name paints ΔE ${clean.dn.toFixed(4)} from its arm`);
+    if (!(clean.dt <= COPY_DE)) fail.push(`${arm} clean: the tally paints ΔE ${clean.dt.toFixed(4)} from its arm`);
+    const plants: [string, string, "dn" | "dt"][] = [
+      ["P1 another arm onto the label", `${TAPE} { color: ${other} !important; }`, "dn"],
+      ["P2 another arm onto the tally", `${TICK} path { stroke: ${other} !important; }`, "dt"],
+      ["P3 the arm 0.05 darker (relative colour)", `${TAPE} { color: oklch(from ${want} calc(l - 0.05) c h) !important; }`, "dn"],
+    ];
+    for (const [what, css, k] of plants) {
+      const r = await read(what, css);
+      if (r[k] <= COPY_DE) fail.push(`${arm} ${what}: stayed GREEN (ΔE ${r[k].toFixed(4)})`);
+    }
+  }
+  expect(fail, fail.join("\n")).toEqual([]);
+  await ctx.close();
+});
