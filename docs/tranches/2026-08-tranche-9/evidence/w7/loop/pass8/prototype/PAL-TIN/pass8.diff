+        out.push({ rel: path.relative(ROOT, p), text: fs.readFileSync(p, "utf8") });
+    }
+  };
+  for (const d of ["src", "e2e", "public"]) walk(path.join(ROOT, d));
+  const html = path.join(ROOT, "index.html");
