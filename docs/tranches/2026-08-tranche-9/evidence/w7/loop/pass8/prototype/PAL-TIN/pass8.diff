+#!/usr/bin/env node
+/**
+ * THE TIN, PRICED (T9-W7 PAL-TIN) — six gates over the twenty player declarations in
+ * `index.css`, read PER ARM, resolved through `var()` and `hsl()` before anything is measured.
+ *
+ * The walk this replaced was a FORMULA, so an instrument could read the step out of
+ * `playerIdentity.ts` and re-derive every hue. A tin is a TABLE, so the gate reads the table —
+ * and reading it is the point: the tin cannot move without the numbers moving with it, and the
+ * day somebody adds a sixth stick this says which law it broke.
+ *
+ * WHAT THE FIRST CUT GOT WRONG, and why this file is longer than it was:
+ *   · one flat regex over the whole file mixed the two themes, so its headline "nearest anchor
+ *     13.3°" was a DARK stick measured against a LIGHT ink — two colours never on a screen
+ *     together;
+ *   · `--color-teacher-red` and `--color-gold-star` are `var()` aliases and were therefore in
+ *     no arm's set at all, though both paint in a cell beside a player's digit;
+ *   · degrees answered "is this stick a named ink of the house" and were then asked to answer
+ *     "can a reader tell a player's hand from the machine's", which is a ΔE question;
+ *   · only gate 2 could be shown failing.
+ *
+ *   GATE 1a  THE FAMILY LAW.   No stick within MIN_SEP degrees of any of the 19 reserved inks,
+ *            within its own arm. A player is never assigned wax, never the solver's rainbow.
+ *   GATE 1b  THE READER'S LAW. No stick within ΔE ABS_FLOOR of one of the NINE inks that paint
+ *            in a cell — and the same run re-derives what this paper can actually hold, so the
+ *            floor is quoted as a RATIO of the ceiling as well as an absolute. A bare number is
+ *            gameable by lowering it; a ratio alone lets a drifting reserved set hide a
+ *            drifting tin. Both print, both must pass.
+ *   GATE 2   THE SEPARATION LAW. No two sticks, no two name arms and no two ring arms closer
+ *            than MIN_DE in OKLab, per arm — the light names EXEMPT while they are the ring arms by
+ *            alias, and the light rings floored at RING_FLOOR, each with its argument written at
+ *            the gate.
+ *   GATE 3   THE ANCHOR TEST.  No stick IS a reserved ink, said in hexes rather than degrees.
+ *   GATE 3b  THE SAME PENCIL.   A ring arm and a name arm sit within RING_DH of their stick's hue.
+ *   GATE 4   ONE PUBLISHER.     `index.css` is the only place a player's ink is written, agree
+ *            or disagree, whatever the name and whatever the colour syntax (4a), and each arm
+ *            sits at its lightness: the rings at the section's pair, the names at theirs (4b).
+ *            Every source is read the way the bundler ships it, through the ONE library: comments
+ *            out (string- and regex-literal-aware), literal expressions folded in place, entities
+ *            and CSS escapes decoded, Tailwind palette utilities resolved; `--dist` reads the
+ *            built bundle the same way.
+ *
+ * Two rows print and never fail: the GAMUT CEILING per stick (six of the ten arms sit exactly
+ * on `chromaAt(L, h)` — that is sRGB's own limit at that lightness, not a chosen number), and
+ * the 8-BIT ROUND TRIP, which is 0.000° on every stick because a table is authored in bytes.
+ * Printed so nobody later mistakes the absent tax for an absent check.
+ *
+ * `--self-test` mints EIGHTY-FIVE negative controls (NINETY with `--dist`), at least one per clause:
+ * gate 4's include the pass-5 critic's C1–C11, the pass-6 critic's D1–D17, the pass-7 critic's fresh
+ * publishers D23–D39 and this lane's D41–D51 (packed ints, `.join`, templates, escapes, Tailwind
+ * palette utilities, derivation through an indirection token, minted names by split template /
+ * `.concat` / `.join`, relative colour syntax, same-file consts), a one-line bundle whose literal sits
+ * after two regex literals, and — with `--dist` — the pink name planted INSIDE the shipped entry
+ * chunk at four offsets; gate 2's the name arms' D20/D22, both halves of the light exemption and the
+ * ring arms by day and by night. One GREEN control (a consumer, a concatenated consumer, a comment,
+ * a script helper named `lab(…)` and a bundle's own sheet must not red gate 4, nor throw). `--sabotage-battery [--dist <dir>]` deletes every
+ * clause in turn, this file's and the library's it reads through, and the self-test must red each.
+ * A gate that cannot be shown failing is not a gate.
+ *
+ * RUN IT BARE. `node check-peer-tin.mjs | tail` prints RED and exits 0 — the pipe eats the
+ * exit code, and this file's whole output is the exit code.
+ */
+import fs from "node:fs";
+import path from "node:path";
+import process from "node:process";
+
+/** THE SHAPE LAW'S ONE LIBRARY (LAWS P6 §F/§I, P7 §I; registry-v7 §2.4), at its PRODUCT HOME by
+ *  relative path: its colour parser (every CSS `<color>` syntax, relative colour syntax included, to
+ *  sRGB), its string- and regex-literal-aware strippers, its escape decoders and its literal folder.
+ *  This file keys the tin's rows on it and hand-rolls none of them. */
+import * as SHAPE from "./shape-census.mjs";
+
+/** THE CLAUSES (LAWS P7 §F (ii)): every finding site below is keyed by one id, and
+ *  `--sabotage-battery` deletes each in turn (`TIN_SABOTAGE=<id>`) — the self-test must RED every
+ *  time, or the clause has no plant. The library clauses gate 4 rests on are deleted the same way
+ *  through the library's own switch (`SHAPE_SABOTAGE`). */
+const TIN_CLAUSES = {
+  g1a: "GATE 1a the family law (degrees to a reserved ink)",
+  g1b: "GATE 1b the reader's law (ΔE to a cell ink, and the paper's ceiling ratio)",
+  "g2-stick": "GATE 2 the sticks at MIN_DE",
+  "g2-name": "GATE 2 the name arms (MIN_DE, or the alias exemption's floor)",
+  "g2-exempt": "GATE 2 the light-name exemption is conditional on the ring alias",
+  "g2-ring":
+    "GATE 2 the ring arms (dark at MIN_DE, light at RING_FLOOR with its argument)",
+  g3: "GATE 3 no stick IS an anchor; the tin is whole",
+  g3b: "GATE 3b a ring/name arm is its stick's hue",
+  "g4-light": "4b every ring/name arm at its lightness",
+  "g4-home": "4a index.css declares each token once per arm and no scalar",
+  "g4-holed": "4a a --color- name with a hole after the library's fold",
+  "g4-derived": "4a a colour derived from an arm or an indirection token",
+  "g4-tw": "4a a Tailwind palette utility within COPY_DE of an arm",
+  "g4-copy": "4a a colour literal within COPY_DE of an arm (after the fold)",
+  "g4-int": "4a a packed 24-bit int read as a colour",
+  "g4-triple": "4a a numeric byte triple read as a colour",
+  "g4-decl": "4a a peer token declared outside index.css",
+  "g4-lname": "4a a lightness-shaped name bound to a number",
+  "g4-band": "4a a band table under a ring/peer/hand name",
+  "g4-table": "4a a second tin (a table of ≥2 colours)",
+  "g4-dist": "--dist reads the BUILT bundle",
+};
+const TIN_OFF = new Set(
+  (process.env.TIN_SABOTAGE ?? "")
+    .split(",")
+    .map((x) => x.trim())
+    .filter(Boolean),
+);
+const on = (id) => !TIN_OFF.has(id);
+/** The library clauses gate 4 reads through (deleted by the library's own switch). */
+const LIB_CLAUSES = [
+  "strip-regex",
+  "rel-color",
+  "decode",
+  "const-carried",
+  "fold-hole",
+  "fold-int",
+  "fold-text",
+  "tw-palette",
+  "channel-arity",
+];
+
+const ROOT = path.join(import.meta.dirname, "..");
+const INDEX_CSS = path.join(ROOT, "src", "assets", "index.css");
+const MIN_SEP = 12; // degrees, the r0 instrument's own floor
+const MIN_DE = 0.1; // OKLab, between two PLAYERS
+/** the light name arms' floor while they ARE the ring arms (gate 2's exemption): the shipped
+ *  green–teal 0.0769 less the 8-bit slack of a low-chroma arm */
+const EXEMPT_FLOOR = 0.075;
+/** THE LIGHT RING PAIR'S FLOOR (registry-v7 §2.13f: TIN's gate-2 row). The five light ring arms ARE
+ *  the light names, so they share the 0.0769 green–teal pair; unlike the names they paint AT ONCE,
+ *  one ring per peer on one board, so the tape's one-at-a-time argument does not cover them. Their
+ *  argument is their own: (1) the ring's lightness is the section's pair (§2.4, L 0.295 by day), the
+ *  lightness its painted core statistic is measured at, and at 0.295 sRGB cannot hold five hues 0.10
+ *  apart (the common L that can, ≥ 0.380, is printed every run) — so 0.10 by day moves the chair's
+ *  pair, not a TIN number; (2) a ring never carries identity alone: it rings the cell a peer is ON,
+ *  and that peer's digits on the board are the STICK (worst pair 0.1162 by day), their roster row
+ *  carries the tick, and the tape prints the slug. The floor is the shipped 0.0769 less the 8-bit
+ *  slack, so the pair may not drift closer; the dark rings are their own colour and hold MIN_DE. */
+const RING_FLOOR = 0.075;
+/** ΔE to the nearest ink that paints in a CELL. Pinned from the prototype's own reading
+ *  (0.082 light / 0.100 dark) with the margin the band move bought, and never raised to pass. */
+const ABS_FLOOR = 0.075;
+/** …as a fraction of what five hue-locked sticks can hold on THIS paper at all. Re-derived
+ *  below from the same `index.css`, in the same run, at the tin's own bands. */
+const RATIO_FLOOR = 0.75;
+const SPREAD = 40; // degrees between berths in the ceiling search — the tin's own rule
+/** how far a RING ARM may sit from its stick's hue. One degree: the arm is authored as a byte
+ *  triple at a different lightness, and quantising a low-chroma colour there costs a fraction
+ *  of a degree (teal, C 0.050 light, is the worst at 0.88). Anything past that is a different
+ *  pencil wearing the stick's name. */
+const RING_DH = 1;
+
+/** The 19 named inks a player's stick must not be mistaken for. */
+const RESERVED = [
+  "user-ink",
+  "focus-sketch",
+  "progress-ink",
+  "teacher-red",
+  "gold-star",
+  "crayon-green",
+  "crayon-orange",
+  "crayon-rose",
+  "crayon-blue",
+  "crayon-gold",
+  "green-ink",
+  "orange-ink",
+  "red-ink",
+  "gold-ink",
+  "solver-ink-1",
+  "solver-ink-2",
+  "solver-ink-3",
+  "solver-ink-4",
+  "solver-ink-5",
+];
+/**
+ * …of which these NINE paint IN A CELL, beside or under a player's digit, and are therefore
+ * the set gate 1b measures against:
+ *   user-ink        the digit itself (`HandwrittenGlyph.vue:85`)
+ *   solver-ink-1…5  a solved digit is the five-stop solver gradient (`SvgFilters.vue:180-184`)
+ *   teacher-red     the conflict ring and the hint laminate (`gameCell.css:144,150,167,170`)
+ *   focus-sketch    the focus ring on the cell (`gameCell.css:246-248`)
+ *   crayon-blue     the dark arm's own cell furniture
+ * `progress-ink` is the frame trace (`HandDrawnGrid.vue:471`) — the same eye, not the same
+ * cell — so it is carried in a reported row that never fails.
+ */
+const CELL = new Set([
+  "user-ink",
+  "solver-ink-1",
+  "solver-ink-2",
+  "solver-ink-3",
+  "solver-ink-4",
+  "solver-ink-5",
+  "teacher-red",
+  "focus-sketch",
+  "crayon-blue",
+]);
+
+// ── OKLab / OKLCH / sRGB, Björn Ottosson's matrices; ΔE Euclidean in OKLab ────────────
+const lin = (c) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
+const gam = (c) => (c <= 0.0031308 ? 12.92 * c : 1.055 * c ** (1 / 2.4) - 0.055);
+const rgbOfHex = (hex) => {
+  const n = parseInt(hex.slice(1), 16);
+  return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
+};
+function oklab(hex) {
+  const [r, g, b] = rgbOfHex(hex).map(lin);
+  const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
+  const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
+  const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
+  return [
+    0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s,
+    1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s,
+    0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s,
+  ];
+}
+function rgbOfOklab([L, a, b]) {
+  const l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3;
+  const m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3;
+  const s = (L - 0.0894841775 * a - 1.291485548 * b) ** 3;
+  return [
+    4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
+    -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
+    -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s,
+  ];
+}
+const rgbOfOklch = (L, C, hDeg) => {
+  const h = (hDeg * Math.PI) / 180;
+  return rgbOfOklab([L, C * Math.cos(h), C * Math.sin(h)]);
+};
+const inGamut = (rgb) => rgb.every((v) => v >= -1e-6 && v <= 1 + 1e-6);
+/** the maximum chroma sRGB holds at (L, h) — bisection, 1e-5 */
+function chromaAt(L, hDeg) {
+  let lo = 0;
+  let hi = 0.5;
+  for (let i = 0; i < 60; i++) {
+    const mid = (lo + hi) / 2;
+    if (inGamut(rgbOfOklch(L, mid, hDeg))) lo = mid;
+    else hi = mid;
+  }
+  return lo;
+}
+const hexOfRgb = (rgb) =>
+  "#" +
+  rgb
+    .map((v) =>
+      Math.round(gam(Math.min(1, Math.max(0, v))) * 255)
+        .toString(16)
+        .padStart(2, "0"),
+    )
+    .join("");
+/** request (L, C, h), clip into gamut, quantise to bytes, read the hex back. */
+function paint(L, C, hDeg) {
+  const ceiling = chromaAt(L, hDeg);
+  const c = Math.min(C, ceiling);
+  return { hex: hexOfRgb(rgbOfOklch(L, c, hDeg)), clipped: C > ceiling, ceiling };
+}
+const hueOf = (hex) => {
+  const [, A, B] = oklab(hex);
+  const h = (Math.atan2(B, A) * 180) / Math.PI;
+  return h < 0 ? h + 360 : h;
+};
+const chromaOf = (hex) => {
+  const [, A, B] = oklab(hex);
+  return Math.hypot(A, B);
+};
+const lOf = (hex) => oklab(hex)[0];
+const gap = (a, b) => {
+  const d = Math.abs(a - b) % 360;
+  return d > 180 ? 360 - d : d;
+};
+const dE = (a, b) => {
+  const A = oklab(a);
+  const B = oklab(b);
+  return Math.hypot(A[0] - B[0], A[1] - B[1], A[2] - B[2]);
+};
+const lum = (hex) => {
+  const [r, g, b] = rgbOfHex(hex).map(lin);
+  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
+};
+const ratio = (a, b) => {
+  const x = lum(a);
+  const y = lum(b);
+  return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
+};
+
+// ── Reading the sheet, PER ARM ────────────────────────────────────────────────────────
+const hslToHex = (h, s, l) => {
+  s /= 100;
+  l /= 100;
+  const c = (1 - Math.abs(2 * l - 1)) * s;
+  const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
+  const m = l - c / 2;
+  const t =
+    h < 60
+      ? [c, x, 0]
+      : h < 120
+        ? [x, c, 0]
+        : h < 180
+          ? [0, c, x]
+          : h < 240
+            ? [0, x, c]
+            : h < 300
+              ? [x, 0, c]
+              : [c, 0, x];
+  return (
+    "#" +
+    t
+      .map((v) =>
+        Math.round((v + m) * 255)
+          .toString(16)
+          .padStart(2, "0"),
+      )
+      .join("")
+  );
+};
+const rawOf = (block, name) => {
+  const m = new RegExp(`--color-${name}:\\s*([^;]+);`).exec(block);
+  return m ? m[1].replace(/\s+/g, " ").trim() : null;
+};
+/** Follow `var(--color-x)` and `hsl()` down to a hex, WITHIN the arm — a dark declaration that
+ *  aliases resolves against the dark block, and a token the dark block never redeclares
+ *  inherits the light one, which is exactly what the browser does. */
+function resolve(block, fallback, name, depth = 0) {
+  let raw = rawOf(block, name);
+  if (raw === null && fallback) raw = rawOf(fallback, name);
+  if (raw === null || depth > 4) return null;
+  let m = /^#([0-9a-fA-F]{6})$/.exec(raw);
+  if (m) return `#${m[1].toLowerCase()}`;
+  m = /^hsl\(\s*([\d.]+)\s+([\d.]+)%\s+([\d.]+)%\s*\)$/.exec(raw);
+  if (m) return hslToHex(+m[1], +m[2], +m[3]);
+  m = /^var\(\s*--color-([a-z0-9-]+)\s*\)$/.exec(raw);
