+    }
+  }
+  for (const r of rows) console.log(r);
+  console.log(
+    `TAPE ${project} the in-run negative (light: the stick · dark: the pass-5 ring arm) flat worst ` +
+      `${neg.light.toFixed(3)} / ${neg.dark.toFixed(3)}`,
