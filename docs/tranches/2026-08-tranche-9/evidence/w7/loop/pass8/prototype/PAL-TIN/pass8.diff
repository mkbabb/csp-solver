+    /** One variable through a STYLESHEET, never a write into the Vue-owned label (LAWS P7 §F). */
+    const withCss = async <T,>(css: string, read: () => Promise<T>): Promise<T> => {
+      const tag = await page.addStyleTag({ content: css });
