+        p.remove();
+        return c;
+      }, v);
+    for (const arm of ["light", "dark"] as const) {
+      await setTheme(page, arm);
+      const names = await Promise.all([1, 2, 3, 4, 5].map((k) => colourOf(`var(--color-peer-${k}-name)`)));
+      const NEG = (k: number) => (arm === "dark" ? `var(--color-peer-${k}-ring)` : `var(--color-peer-${k})`);
+      for (const x of cells) {
