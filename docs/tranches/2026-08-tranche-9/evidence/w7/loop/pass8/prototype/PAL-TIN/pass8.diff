+        const same = await head(HEAD_INK(index, arm));
+        const best = await head(HEAD_INK(1, arm));
+        rows.push(
+          `${tag} PRODUCT ${own.spec} · flat worst ${own.worst.toFixed(3)} (${own.under45} px <4.5) · bound ${g.bound?.toFixed(3)} · ${popFmt(g.clean)}` +
+            ` || HEAD same-index ${HEAD_INK(index, arm)} ${same.coreMedian.toFixed(3)} (Δ ${(g.clean.coreMedian - same.coreMedian).toFixed(3)})` +
+            ` · HEAD best-hue ${best.coreMedian.toFixed(3)} (Δ ${(g.clean.coreMedian - best.coreMedian).toFixed(3)})`,
+        );
+        const pj = verdict(g.clean);
+        if (pj.length) fail.push(`${key} PRODUCT: ${pj.join("; ")}`);
+        if (rung && g.clean.coreMedian < 4.5 && same.coreMedian >= 4.5)
+          fail.push(`${key} PRODUCT: G2 on the rung is excused only while HEAD's same-index ink reads under 4.5 too (${same.coreMedian})`);
+        if (own.worst < 4.5 || own.under45 > 0) fail.push(`${key} PRODUCT flat: ${own.worst.toFixed(3)}, ${own.under45} px`);
+        for (const [name, r] of Object.entries(g.plants)) {
+          const required = !printedPlant(name, project);
+          const v = verdict(r);
+          rows.push(
+            `${tag} ${required ? "PLANT" : "PLANT (printed)"} ${name} · ${popFmt(r)} · median ×${(r.coreMedian / g.clean.coreMedian).toFixed(3)} → ${v.length ? `RED ${v.map((w) => w.split(" ")[0]).join("+")}` : "GREEN"}`,
+          );
+          if (required && !v.length) fail.push(`${key} PLANT ${name} stayed GREEN: ${popFmt(r)}`);
+        }
+        // B-TAPE's ink half: every NAME ARM on B's tape (one variable, `--color-user-ink` on the
+        // label through a stylesheet), each against HEAD's ink for the SAME INDEX — the stick k's
+        // first lap, index k − 1 — and against pass 7's best-hue control, both printed
+        if (index === 5) {
