+
+// ── 4b · THE TAPE, THE SECOND HOME ────────────────────────────────────────────────────────
+// The family's own gate row, which existed only as prose and one frame (critique §2.4): the
+// attribution tape carries the tally when the author shares a stick and nothing when it does not.
+test("the tape carries the tick over a shared stick and nothing over an unshared one", async ({
+  browser,
+}) => {
+  test.slow();
+  const { ctx, pages } = await room(browser, 7);
+  const a = pages[0];
+  const empties = await a.evaluate(() =>
+    [...document.querySelectorAll(".sudoku-cell input")]
+      .map((i, n) => ((i as HTMLInputElement).value ? -1 : n))
+      .filter((n) => n >= 0),
+  );
+  // the SEVENTH player is a lap round the tin (amber again); the SECOND is on its first pass
+  const write = async (page: Page, at: number, digit: string) => {
+    const c = page.locator(".sudoku-cell input").nth(at);
+    await c.click();
+    await c.fill(digit);
+    await expect.poll(() => a.locator(".sudoku-cell input").nth(at).inputValue()).toBe(digit);
+  };
+  await write(pages[6], empties[0], "5");
+  await write(pages[1], empties[1], "5");
+
+  const tape = a.locator(".attribution-tape");
+  const hover = async (at: number) => {
+    await a.locator(".sudoku-cell").nth(at).hover();
+    await expect(tape).toHaveCount(1, { timeout: 15000 });
+  };
+  await hover(empties[0]);
+  const sharedText = await tape.innerText();
+  expect(await tape.locator(".roster-tick").count()).toBe(1);
+  await a.mouse.move(0, 0);
+  await expect(tape).toHaveCount(0);
+
+  await hover(empties[1]);
+  const loneText = await tape.innerText();
+  expect(await tape.locator(".roster-tick").count()).toBe(0);
+  console.log(`TAPE shared "${sharedText}" tick 1 · TAPE unshared "${loneText}" tick 0`);
+  await ctx.close();
+});
+
+// ── 5 · THE PAINTED STROKE ────────────────────────────────────────────────────────────────
+test("the roster tick is drawn at 1.5px, desk and phone", async ({ browser }) => {
+  test.slow();
+  const { ctx, pages } = await room(browser, 7);
+  const a = pages[0];
+  for (const [label, w, h] of [
+    ["desk", 1280, 800],
+    ["phone", 390, 844],
+  ] as const) {
+    await a.setViewportSize({ width: w, height: h });
+    await a.waitForTimeout(400);
+    const px = await a.evaluate(() => {
+      const svg = document.querySelector(".roster-tick") as SVGSVGElement | null;
+      if (!svg) return null;
+      const path = svg.querySelector("path")!;
+      const vb = svg.viewBox.baseVal;
+      const box = svg.getBoundingClientRect();
+      const sw = parseFloat(getComputedStyle(path).strokeWidth);
+      // `vector-effect: non-scaling-stroke` paints the authored width in CSS px, so the
+      // viewBox scale does NOT multiply it. Both numbers are printed; the painted one is the
+      // claim and the scaled one is what an authored width would have given.
+      const nonScaling = getComputedStyle(path).vectorEffect === "non-scaling-stroke";
+      return {
+        painted: nonScaling ? sw : (sw * box.height) / vb.height,
+        ifScaled: (sw * box.height) / vb.height,
+        h: box.height,
+        sw,
+        nonScaling,
+      };
+    });
+    console.log(`TICK STROKE ${label}: ${JSON.stringify(px)}`);
+    expect(px!.painted).toBeGreaterThan(1.3);
+    expect(px!.painted).toBeLessThan(1.7);
+  }
+  await ctx.close();
+});
+
+// ── 6 · PRINT AND FORCED COLOURS ──────────────────────────────────────────────────────────
+test("the roster tick prints black and yields CanvasText", async ({ browser }) => {
+  test.slow();
+  const { ctx, pages } = await room(browser, 7);
+  const a = pages[0];
+  // THE UN-WIDENED CONTROL IS A PATH, not a swatch (pass-3 critique §2.4: `.player-swatch`
+  // reads a `background-color` and was never in the widened selector — a colour reading, not a
+  // control for this rule). The control here is every OTHER `path` the estate ships on this
+  // page: same property, same element kind, outside `index.css:989 / :1012`'s pair. If one of
+  // them moves with the tick, the rule is not scoped and the row reds.
+  const READ = () => {
+    const tick = document.querySelector(".roster-tick path")!;
+    const named = new Set(document.querySelectorAll(".glyph-svg path, .roster-tick path"));
+    const others = [...document.querySelectorAll("path")].filter((p) => !named.has(p));
+    const strokes = new Map<string, string>();
+    for (const p of others) {
+      const s = getComputedStyle(p).stroke;
+      if (s && s !== "none" && !strokes.has(s)) strokes.set(s, p.getAttribute("class") ?? "<no class>");
+    }
+    const probe = document.createElement("div");
+    probe.style.color = "CanvasText";
+    document.body.appendChild(probe);
+    const canvasText = getComputedStyle(probe).color;
+    probe.remove();
+    return {
+      tick: getComputedStyle(tick).stroke,
+      canvasText,
+      others: [...strokes].map(([s, cls]) => `${cls}=${s}`),
+      unmoved: [...strokes.keys()],
+    };
+  };
+
+  await a.emulateMedia({ media: "print" });
+  const print = await a.evaluate(READ);
+  await a.emulateMedia({ media: "screen", forcedColors: "active" });
+  const forced = await a.evaluate(READ);
+  await a.emulateMedia({ media: "screen", forcedColors: "none" });
+  console.log(
+    `PRINT tick ${print.tick} · un-widened paths ${print.others.join(" , ")}\n` +
+      `FORCED tick ${forced.tick} (CanvasText resolves ${forced.canvasText}) · ` +
+      `un-widened paths ${forced.others.join(" , ")}`,
+  );
+  expect(print.tick).toBe("rgb(0, 0, 0)");
+  // …and the forced half ASSERTED rather than printed: the tick takes the system ink
+  expect(forced.tick).toBe(forced.canvasText);
+  // the control: at least one shipped path outside the pair keeps an ink of its own in each mode
+  expect(print.unmoved.filter((s) => s !== "rgb(0, 0, 0)").length).toBeGreaterThan(0);
+  expect(forced.unmoved.filter((s) => s !== forced.canvasText).length).toBeGreaterThan(0);
+  await ctx.close();
+});
