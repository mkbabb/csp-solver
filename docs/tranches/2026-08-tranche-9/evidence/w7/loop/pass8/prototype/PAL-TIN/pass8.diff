+        const key = `${project}·dpr${dpr}·${arm}·${index === 0 ? "A0" : "B"}·cell${x}`;
+        const tag = `TAPE ${key}${x < 9 ? " (top row)" : ""} "${slug}"`;
+        // THE PRODUCT'S OWN BINDING: the author's name is written in a name arm, never the ring or stick
+        const own = await paintedName(page, label);
+        expect(names, `${arm} cell ${x}: the tape's name is one of the five name arms`).toContain(own.spec);
+        expect(await page.locator(".attribution-tape .roster-tick").count(), "B carries its lap; A none").toBe(
+          index === 5 ? 1 : 0,
+        );
+        const plantHere = x === cells[0];
+        const g = (await glyphGate(page, {
+          subject: TAPE,
+          payload: `${who}/${arm}/cell${x}`,
+          plants: plantHere ? TEXT_PLANTS(TAPE) : {},
