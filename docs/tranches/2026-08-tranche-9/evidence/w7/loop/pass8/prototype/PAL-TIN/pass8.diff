+      if (e.isDirectory()) walk(p);
+      else if (
+        /\.(css|vue|ts|mts|cts|tsx|js|mjs|cjs|jsx|json|html|svg|webmanifest)$/.test(
+          e.name,
+        ) &&
+        p !== INDEX_CSS
