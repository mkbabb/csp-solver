+          kind: "script-setProperty",
+          prop,
+          value: carry(m[2]),
+          line: L(m.index),
+        });
+    } else
+      out.push({
+        kind: "script-setProperty-computed",
+        prop: `?${k}`,
+        value: m[2].trim(),
+        line: L(m.index),
+        unresolved: true,
+      });
