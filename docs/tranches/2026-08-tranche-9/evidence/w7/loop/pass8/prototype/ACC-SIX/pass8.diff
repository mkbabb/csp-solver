+/** CSS TEXT inside script strings (FACE: HandwrittenLogo's pose sheet `text{font-family:…}` is a
+ *  shipping stylesheet the census never saw): adjacent literals folded, `${…}` a placeholder,
+ *  `<style>` tags dropped; rules and bare declaration strings both read. */
+export function scriptCss(js, baseLine = 1) {
+  if (!on("script-css")) return [];
+  const s = stripJs(js);
+  const out = [];
+  const chunk =
+    /(["'`])((?:\\.|(?!\1)[^\\])*)\1(?:\s*\+\s*(["'`])((?:\\.|(?!\3)[^\\])*)\3)*/g;
+  for (const m of s.matchAll(chunk)) {
+    const text = [...m[0].matchAll(/(["'`])((?:\\.|(?!\1)[^\\])*)\1/g)]
+      .map((x) => x[2].replace(/\$\{[^}]*\}/g, "\u0000"))
+      .join("")
+      .replace(/<\/?style[^>]*>/g, " ");
+    if (!/[a-zA-Z-]\s*:/.test(text)) continue;
+    const line = baseLine + lineAt(s, m.index) - 1;
+    if (text.includes("{"))
+      for (const r of cssRules(text, line)) out.push({ ...r, kind: "script-css" });
+    else if (/^\s*-{0,2}[a-zA-Z][\w-]*\s*:\s*\S/.test(text))
+      out.push({
+        ctx: [],
+        prelude: "<script string>",
+        decls: decls(text, line),
+        line,
+        kind: "script-css-string",
+      });
+  }
+  return out;
+}
