+  let bare = sels.replace(/:not\((?:[^()]|\([^()]*\))*\)/g, "");
+  const esc = tail.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+  const re = new RegExp(`${esc}(?![\\w-])`);
