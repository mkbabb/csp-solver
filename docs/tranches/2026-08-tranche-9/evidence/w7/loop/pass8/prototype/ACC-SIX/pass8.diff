+      const held = +(A.held ?? 50);
+      const o = { heldMs: held, url: A.url, viewport: { width: vw, height: vh }, dpr: +(A.dpr ?? 1), scheme: A.scheme, trigger: A.trigger, roi: A.roi, subject: A.subject, windowMs: +(A.window ?? 1200), eps: A.eps ? +A.eps : undefined, plant, ready: A.ready, touch: A.touch === "1" };
+      const res = [];
+      for (let i = 0; i < +(A.runs ?? 1); i++) {
+        const r = await record(browser, engine, o);
+        res.push(r);
+        const v = verdict(r, engine, { held, subject: o.subject });
+        console.log(
+          `RECORD ${engine} run${i + 1} ${A.trigger} plant=${A.plant ?? "none"} plantAt+${r.plantRanAt ?? "-"}ms motion ${r.motionMs}ms from +${r.latencyMs}ms (${r.subjectMovedFrames} moved) | photos ${r.photos.photos} changed ${r.photos.changed} (eps ${r.photos.eps}) window ${r.photos.windowMs}ms maxHeld(photo) ${r.photos.maxHeldMs}ms | rAF ${r.timeline.rafs} maxGap(rAF) ${r.timeline.maxGapMs}ms | load ${r.load.join(" ")} | ${v.red ? "RED" : "GREEN"}${v.empty ? " (EMPTY motion window)" : ""} primary=${v.track} | held≥${held}ms [+at,dur] photo ${JSON.stringify(r.held.photo)} subject ${JSON.stringify(r.held.subject)} rAF ${JSON.stringify(r.held.rAF)}${r.plantSeen ? ` | PLANT SEEN photo ${r.plantSeen.photo ? "YES" : "NO"} subject ${r.plantSeen.subject ? "YES" : "NO"} rAF ${r.plantSeen.rAF ? "YES" : "NO"}` : ""}`,
+        );
+        if (exit === 0 && v.red) exit = 1;
+      }
+      if (A.ladder) for (const l of await ladder(browser, o, +A.ladder)) console.log(`LADDER ${engine} ${JSON.stringify(l)}`);
+      if (A.out) fs.writeFileSync(A.out, JSON.stringify({ selftest: st, runs: res.map((r) => ({ ...r, photos: { ...r.photos, deltas: r.photos.deltas.slice(0, 200) } })) }));
+    }
+  } else {
+    // the GA1-shaped row, generic: any mover, any trigger, the cells named
+    const CELLS = { desk: { name: "1280x800 fine", width: 1280, height: 800, hasTouch: false }, phone: { name: "390x844 coarse", width: 390, height: 844, hasTouch: true } };
+    const plant = A.plant ?? "";
+    let red = 0;
+    for (const c of (A.cells ?? "desk,phone").split(",")) {
+      const cell = CELLS[c];
+      for (let rep = 1; rep <= +(A.reps ?? 2); rep++) {
+        const { ctx, page } = await openCell(browser, { ...cell, colorScheme: A.scheme ?? "light", reducedMotion: "no-preference" });
+        if (plant === "skip") await ctx.addInitScript(SKIP_PLANT);
+        if (plant === "f2") await ctx.addInitScript(F2_PLANT, A.sel);
+        await page.goto(A.url);
+        await page.locator(A.ready ?? ".board-cells").first().waitFor({ timeout: 30000 });
+        await page.evaluate(() => document.fonts.ready);
+        await page.waitForTimeout(600);
+        const r = await readMover(page, { sel: A.sel, key: A.key ?? (A.click ? null : "g"), click: A.click ?? null });
+        await ctx.close();
+        if (r.post.red) red = 1;
+        console.log(`POSTPAINT ${engine} ${cell.name} r${rep} plant=${plant || "none"} io ${r.io} kPaint ${r.kPaint} | POST ${fmtArm(r.post)} | LEGACY ${fmtArm(r.legacy)} | inRAF ${fmtArm(r.inRAF)} | rAF2 ${fmtArm(r.rAF2)} → ${r.post.red ? "RED " + r.post.why.join("; ") : "GREEN"}`);
+      }
+    }
+    exit = plant ? (red ? 0 : 3) : red;
+    if (plant) console.log(`PLANT ${plant} ${red ? "RED (bites)" : "GREEN ← a hole"}`);
+  }
+  console.log(`LOAD ${loadStr()}`);
+  await browser.close();
+  process.exit(exit);
+}
diff --git a/web/frontend/e2e/lib/rest-probes.mjs b/web/frontend/e2e/lib/rest-probes.mjs
new file mode 100644
index 00000000..9ae4e289
--- /dev/null
+++ b/web/frontend/e2e/lib/rest-probes.mjs
@@ -0,0 +1,327 @@
+// rest-probes.mjs — THE resize-at-rest, un-park, sequence-guard and row-focus probes (T9-W7; registry-v6
+// §2.11, LAWS P6 §D; registry-v7 §2.4 PRODUCT HOME). Four mechanisms recur across the estate:
+//   (a) UN-PARK — a publisher parked until `transitionend` never un-parks when no transition starts (FACE:
+//       two presses in one task; `--action-bar-h` 121 vs 132 for the page's life). Probe: act, reach REST,
+//       perturb something ELSE that moves the subject (the root font +12.5 %), reach rest, and compare every
+//       PUBLISHED length with its TRUTH (0.5 px).
+//   (b) RESIZE AT REST — a regime measured at OPEN goes stale on a resize at rest (SELF: 390×844 → 390×800
+//       keeps 4 rows / 7 cells lapped). Probe: open at A, resize to B, reach rest, read; close, reopen at
+//       B, read; the two reads must AGREE.
+//   (c) SEQUENCE-KEYED TOUCH GUARD — WebKit labels a touch's click `pointerType: "mouse"`. Probe: one tap,
+//       its event sequence logged, the state toggles counted (exactly one), and under the RELABEL plant
+//       (WebKit's label with iOS's delivery, in any engine) still exactly one.
+//   (d) ROW TAP KEEPS FOCUS — a tap on a row inside an open overlay keeps focus where the reader was
+//       (never BODY).
+// The presets are GENERIC (the chair's pass-7 gap 6: its presets named SELF's and FACE's trees): every
+// subject, state and read is a selector or a JS expression on the command line.
+//   node e2e/lib/rest-probes.mjs --self-test [--engine chromium|webkit]
+//   node e2e/lib/rest-probes.mjs --url <u> --preset resize --toggle <sel> --open <js→bool> --read <js→value>
+//        [--viewport 390x844] [--to 390x800] [--touch 1]
+//   node e2e/lib/rest-probes.mjs --url <u> --preset unpark --act <js> --pairs <name|publishedJs|truthJs;;…>
+//        [--perturb <js>] [--viewport 1280x800]
+//   node e2e/lib/rest-probes.mjs --url <u> --preset touch --target <sel> --state <js> [--plant relabel]
+//   node e2e/lib/rest-probes.mjs --url <u> --preset rowfocus --cell <sel> --toggle <sel> --open <js→bool>
+//        --row <sel> [--focus-ok <sel>]
+//   common: [--ready <sel>] [--engine] [--scheme dark]
+// Exit: 0 GREEN · 1 RED · 3 (self-test) a born-RED fixture or a plant read GREEN (a hole) · 4 both.
+import process from "node:process";
+import { fileURLToPath } from "node:url";
+import { resolve as resolvePath } from "node:path";
+import { args, load, playwright, openCell } from "./paint-lib.mjs";
+
+/** REST: no running/pending animation over two consecutive frames (read post-paint). An infinite
+ *  animation (a boil, a spinner) never rests: its names are printed as `residual`, never hidden. */
+export async function atRest(page, timeout = 6000) {
+  const t0 = Date.now();
+  let quiet = 0;
+  while (Date.now() - t0 < timeout) {
+    const n = await page.evaluate(
+      () =>
+        new Promise((r) =>
+          requestAnimationFrame(() => setTimeout(() => r(document.getAnimations().filter((a) => a.playState === "running" || a.pending).length), 0)),
+        ),
+    );
+    quiet = n === 0 ? quiet + 1 : 0;
+    if (quiet >= 2) return { ms: Date.now() - t0, residual: 0 };
+  }
+  const residual = await page.evaluate(() =>
+    document
+      .getAnimations()
+      .filter((a) => a.playState === "running")
+      .map((a) => a.animationName ?? a.id ?? a.constructor.name)
+      .slice(0, 5),
+  );
+  return { ms: Date.now() - t0, residual };
+}
+
+/** Evaluate a JS expression string in the page. */
+export const js = (page, expr) => page.evaluate((e) => new Function(`return (${e})`)(), expr);
+
+/** (b) open → resize at rest → read, vs a fresh open at the new size. `same(a, b)` decides agreement. */
+export async function openThenResize(page, { open, close, read, to, same = (a, b) => JSON.stringify(a) === JSON.stringify(b) }) {
+  await open();
+  await atRest(page);
+  const before = await read();
+  await page.setViewportSize(to);
+  await page.waitForFunction(({ width, height }) => innerWidth === width && innerHeight === height, to);
+  const rest = await atRest(page);
+  const after = await read();
+  await close();
+  await atRest(page);
+  await open();
+  await atRest(page);
+  const reopened = await read();
+  return { before, after, reopened, rest, agree: same(after, reopened) };
+}
+
+/** (a) act → rest → perturb → rest → published vs truth per pair ([name, publishedJs, truthJs]); 0.5 px. */
+export async function unpark(page, { act, perturb = () => page.evaluate(() => (document.documentElement.style.fontSize = "18px")), pairs }) {
+  const read = () =>
+    page.evaluate(
+      (pairs) =>
+        pairs.map(([name, pubJs, truthJs]) => ({ name, published: new Function(`return (${pubJs})`)(), truth: new Function(`return (${truthJs})`)() })),
+      pairs,
+    );
+  const before = await read();
+  await act();
+  const r1 = await atRest(page);
+  const afterAct = await read();
+  await perturb();
+  const r2 = await atRest(page);
+  const afterPerturb = await read();
+  const stale = afterPerturb.filter((x) => x.published == null || x.published === "" || Math.abs(parseFloat(x.published) - parseFloat(x.truth)) > 0.5);
+  return { before, afterAct, afterPerturb, rest: [r1, r2], stale };
+}
+
+/** (c) the RELABEL plant — WebKit's LABEL with iOS's DELIVERY, in any engine: after a trusted touch
+ *  release exactly one `click` labelled `pointerType: "mouse"` reaches the target. A trusted touch click
+ *  (chromium) is swallowed in capture and re-dispatched as `mouse`; where the engine sends none (WebKit
+ *  after a prevented pointerdown), one is synthesised 60 ms after the release. */
+export const RELABEL = () => {
+  let pending = null;
+  const fire = (target, x, y) => target.dispatchEvent(new PointerEvent("click", { bubbles: true, cancelable: true, composed: true, pointerType: "mouse", clientX: x, clientY: y, button: 0 }));
+  window.addEventListener(
+    "pointerup",
+    (e) => {
+      if (!e.isTrusted || e.pointerType !== "touch") return;
+      const target = e.target,
+        x = e.clientX,
+        y = e.clientY;
+      pending = setTimeout(() => {
+        pending = null;
+        fire(target, x, y);
+      }, 60);
+    },
+    { capture: true },
+  );
+  window.addEventListener(
+    "click",
+    (e) => {
+      if (!e.isTrusted) return;
+      if (pending) {
+        clearTimeout(pending);
+        pending = null;
+      }
+      if (e.pointerType === "mouse") return; // already WebKit's label
+      e.stopImmediatePropagation();
+      e.preventDefault();
+      const t = e.target,
+        x = e.clientX,
+        y = e.clientY;
+      queueMicrotask(() => fire(t, x, y));
+    },
+    { capture: true },
+  );
+};
+/** Tap once; log the event sequence; count toggles of `state` (a JS expression) across the tap. */
+export async function tapToggles(page, { target, state }) {
+  await page.evaluate(() => {
+    window.__seq = [];
+    for (const t of ["pointerdown", "pointerup", "touchend", "click"])
+      window.addEventListener(t, (e) => window.__seq.push(`${t}:${e.pointerType ?? "-"}${e.isTrusted ? "" : "(synthetic)"}`), { capture: true });
+  });
+  await page.evaluate((stateJs) => {
+    const f = new Function(`return (${stateJs})`);
+    window.__st = [f()];
+    const mo = new MutationObserver(() => {
+      const v = f();
+      if (v !== window.__st[window.__st.length - 1]) window.__st.push(v);
+    });
+    mo.observe(document.body, { subtree: true, attributes: true, childList: true, characterData: true });
+    window.__mo = mo;
+  }, state);
+  await page.locator(target).first().tap();
+  await page.waitForTimeout(400);
+  await atRest(page, 3000);
+  const r = await page.evaluate(() => {
+    window.__mo.disconnect();
+    return { seq: window.__seq, states: window.__st };
+  });
+  return { ...r, toggles: r.states.length - 1 };
+}
+/** (d) focus a cell, open the overlay, tap a row: where is focus? `ok` = the selector focus must match. */
+export async function rowTapFocus(page, { cell, open, row, ok = cell }) {
+  await page.locator(cell).first().tap();
+  await open();
+  await atRest(page, 3000);
+  if (!(await page.locator(row).first().isVisible())) return { focus: null, kept: false, why: `the row ${row} is not visible after open` };
+  await page.locator(row).first().tap();
+  await page.waitForTimeout(300);
+  await atRest(page, 3000);
+  return page.evaluate((ok) => {
+    const a = document.activeElement;
+    return { focus: a ? `${a.tagName}${a.id ? "#" + a.id : ""}${a.classList.length ? "." + [...a.classList].slice(0, 2).join(".") : ""}` : null, kept: !!a?.matches(ok) };
+  }, ok);
+}
+
+// ------------------------------------------------------------------------------------ self-test
+/** Synthetic fixtures (no product surface), each a LIVE and a STALE twin: the stale twin is born RED,
+ *  the live twin GREEN. `?v=live|stale` picks the twin. */
+const FIXTURE = (v) => `<!doctype html><html><head><style>
+  body { margin: 0; font: 1rem/1.4 Georgia, serif; background: #fbf8f1; color: #3b3833; }
+  #bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 8px; transition: padding 200ms; background: #eee; }
+  #bar.big { padding: 24px; }
+  #sheet { position: fixed; left: 0; right: 0; top: 40px; background: #fff; display: none; }
+  #tog { position: fixed; top: 0; right: 0; height: 36px; z-index: 2; }
+  #sheet.open { display: block; }
+  .row { display: block; width: 100%; height: 40px; }
+  #cell { margin-top: 300px; }
+</style></head><body>
+  <div id="bar">bar</div>
+  <input id="cell" aria-label="cell">
+  <button id="tog" aria-expanded="false">toggle</button>
+  <div id="sheet"></div>
+<script>
+  const V = ${JSON.stringify(v)};
+  const bar = document.getElementById("bar");
+  const pub = () => document.documentElement.style.setProperty("--bar-h", bar.getBoundingClientRect().height + "px");
+  pub();
+  // the STALE publisher parks on a press and un-parks only on transitionend; two presses in one task
+  // start no transition, so it stays parked while the root font moves the bar (its line box, not its padding)
+  let parked = false;
+  new ResizeObserver(() => { if (V === "live" || !parked) pub(); }).observe(bar);
+  bar.addEventListener("transitionend", () => { parked = false; pub(); });
+  window.act = () => { parked = true; bar.classList.toggle("big"); bar.classList.toggle("big"); };
+  const sheet = document.getElementById("sheet"), tog = document.getElementById("tog");
+  let rows = 0;
+  const measure = () => { rows = Math.floor((innerHeight - 100) / 40); sheet.innerHTML = Array.from({ length: rows }, (_, i) => '<button class="row">row ' + i + "</button>").join(""); wire(); };
+  const wire = () => { for (const r of sheet.querySelectorAll(".row")) {
+    if (V === "live") r.addEventListener("pointerdown", (e) => e.preventDefault()); // the row never takes focus
+    else r.addEventListener("pointerdown", () => r.focus()); // a menu row that takes focus, then hides
+    r.addEventListener("click", () => setOpen(false)); } };
+  const setOpen = (o) => { sheet.classList.toggle("open", o); tog.setAttribute("aria-expanded", String(o)); if (o) measure(); };
+  if (V === "live") addEventListener("resize", () => sheet.classList.contains("open") && measure());
+  let touchSeq = false;
+  tog.addEventListener("pointerdown", (e) => { if (V === "live" && e.pointerType === "touch") { touchSeq = true; e.preventDefault(); } });
+  tog.addEventListener("pointerup", (e) => { if (e.pointerType === "touch") setOpen(!sheet.classList.contains("open")); });
+  tog.addEventListener("click", (e) => {
+    if (V === "live") { if (touchSeq) { touchSeq = false; return; } }
+    else if (e.pointerType === "touch") return; // the guard keyed on the click's LABEL
+    setOpen(!sheet.classList.contains("open"));
+  });
+  window.sheetRows = () => sheet.querySelectorAll(".row").length;
+  window.setOpen = setOpen;
+</script></body></html>`;
+
+export async function selfTest(browser) {
+  const rows = [];
+  let hole = false,
+    liveRed = false;
+  const cell = async (v, { touch = false, plant = null, w = 390, h = 844 } = {}) => {
+    const { ctx, page } = await openCell(browser, { width: w, height: h, hasTouch: touch });
+    await page.setContent(FIXTURE(v));
+    if (plant === "relabel") await page.evaluate(RELABEL); // setContent commits no navigation: no init script runs
+    return { ctx, page };
+  };
+  const expect = (v, red, label, detail) => {
+    const bad = v === "live" ? red : !red;
+    if (bad && v === "live") liveRed = true;
+    if (bad && v === "stale") hole = true;
+    rows.push(`REST self-test ${label} ${v.toUpperCase()} ${detail} → ${red ? "RED" : "GREEN"}${bad ? (v === "live" ? " ← the live twin RED" : " ← a hole (the stale twin GREEN)") : ""}`);
+  };
+  for (const v of ["live", "stale"]) {
+    {
+      const { ctx, page } = await cell(v, { w: 1280, h: 800 });
+      const r = await unpark(page, { act: () => page.evaluate(() => window.act()), pairs: [["--bar-h", `getComputedStyle(document.documentElement).getPropertyValue("--bar-h")`, `document.getElementById("bar").getBoundingClientRect().height + "px"`]] });
+      expect(v, r.stale.length > 0, "UNPARK (two presses in one task, root font +12.5 %)", JSON.stringify(r.afterPerturb));
+      await ctx.close();
+    }
+    {
+      const { ctx, page } = await cell(v);
+      const open = async () => (await js(page, `document.getElementById("sheet").classList.contains("open")`)) || (await page.locator("#tog").click());
+      const close = async () => (await js(page, `document.getElementById("sheet").classList.contains("open")`)) && (await page.locator("#tog").click());
+      const r = await openThenResize(page, { open, close, read: () => js(page, "window.sheetRows()"), to: { width: 390, height: 800 } });
+      expect(v, !r.agree, "RESIZE 390x844 → 390x800 at rest", `rows before ${r.before} after ${r.after} reopened ${r.reopened}`);
+      await ctx.close();
+    }
+    for (const plant of [null, "relabel"]) {
+      const { ctx, page } = await cell(v, { touch: true, plant });
+      const t = await tapToggles(page, { target: "#tog", state: `document.getElementById("tog").getAttribute("aria-expanded")` });
+      // without the plant both guards hold in chromium; the RELABEL plant is the discriminator
+      if (plant) expect(v, t.toggles !== 1, "TOUCH one tap under RELABEL", `seq ${t.seq.join(",")} states ${t.states.join("→")} toggles ${t.toggles}`);
+      else {
+        if (t.toggles !== 1 && v === "live") liveRed = true;
+        rows.push(`REST self-test TOUCH one tap (no plant) ${v.toUpperCase()} seq ${t.seq.join(",")} toggles ${t.toggles} → ${t.toggles === 1 ? "GREEN" : "RED"}`);
+      }
+      await ctx.close();
+    }
+    {
+      const { ctx, page } = await cell(v, { touch: true });
+      // opened by script: the row probe's subject is the ROW tap, not the toggle's guard (WebKit's own
+      // mouse-labelled click double-toggles the stale guard with no plant)
+      const f = await rowTapFocus(page, { cell: "#cell", open: () => page.evaluate(() => window.setOpen(true)), row: "#sheet .row >> nth=1" });
+      expect(v, !f.kept, "ROW TAP inside the open sheet", `focus ${f.focus}${f.why ? " (" + f.why + ")" : ""}`);
+      await ctx.close();
+    }
+  }
+  return { rows, exit: liveRed ? (hole ? 4 : 1) : hole ? 3 : 0 };
+}
+
+// ------------------------------------------------------------------------------------------ CLI
+if (process.argv[1] && fileURLToPath(import.meta.url) === resolvePath(process.argv[1])) {
+  const A = args();
+  const engine = A.engine ?? "chromium";
+  const browser = await playwright()[engine].launch();
+  let exit;
+  if (A["self-test"]) {
+    const r = await selfTest(browser);
+    for (const row of r.rows) console.log(`${engine} ${row}`);
+    exit = r.exit;
+  } else {
+    const [w, h] = (A.viewport ?? "390x844").split("x").map(Number);
+    const touch = A.touch === "1" || ["touch", "rowfocus"].includes(A.preset);
+    const { ctx, page } = await openCell(browser, { width: w, height: h, hasTouch: touch, colorScheme: A.scheme ?? "light", reducedMotion: "no-preference" });
+    if (A.plant === "relabel") await ctx.addInitScript(RELABEL);
+    await page.goto(A.url);
+    await page.locator(A.ready ?? ".board-cells").first().waitFor({ timeout: 30000 });
+    await atRest(page, 4000);
+    const isOpen = () => js(page, A.open);
+    const tapOrClick = (sel) => (touch ? page.locator(sel).first().tap() : page.locator(sel).first().click());
+    let red, out;
+    if (A.preset === "resize") {
+      const [tw, th] = (A.to ?? "390x800").split("x").map(Number);
+      const r = await openThenResize(page, { open: async () => (await isOpen()) || (await tapOrClick(A.toggle)), close: async () => (await isOpen()) && (await tapOrClick(A.toggle)), read: () => js(page, A.read), to: { width: tw, height: th } });
+      red = !r.agree;
+      out = { from: `${w}x${h}`, to: A.to ?? "390x800", before: r.before, afterResizeAtRest: r.after, reopened: r.reopened, rest: r.rest };
+    } else if (A.preset === "unpark") {
+      const pairs = A.pairs.split(";;").map((p) => p.split("|"));
+      const r = await unpark(page, { act: () => js(page, A.act), ...(A.perturb ? { perturb: () => js(page, A.perturb) } : {}), pairs });
+      red = r.stale.length > 0;
+      out = { afterAct: r.afterAct, afterPerturb: r.afterPerturb, rest: r.rest, stale: r.stale };
+    } else if (A.preset === "touch") {
+      const t = await tapToggles(page, { target: A.target, state: A.state });
+      red = t.toggles !== 1;
+      out = { seq: t.seq, states: t.states, toggles: t.toggles };
+    } else if (A.preset === "rowfocus") {
+      const f = await rowTapFocus(page, { cell: A.cell, open: async () => (await isOpen()) || (await tapOrClick(A.toggle)), row: A.row, ok: A["focus-ok"] ?? A.cell });
+      red = !f.kept;
+      out = f;
+    } else throw new Error(`unknown --preset ${A.preset} (resize | unpark | touch | rowfocus)`);
+    console.log(`REST ${engine} ${A.preset}${A.plant ? " plant=" + A.plant : ""} ${JSON.stringify(out)} → ${red ? "RED" : "GREEN"}`);
+    exit = red ? 1 : 0;
+    await ctx.close();
+  }
+  console.log(`LOAD ${load()}`);
+  await browser.close();
+  process.exit(exit);
+}
diff --git a/web/frontend/e2e/rate-clock.ts b/web/frontend/e2e/rate-clock.ts
new file mode 100644
index 00000000..512119c4
--- /dev/null
+++ b/web/frontend/e2e/rate-clock.ts
@@ -0,0 +1,187 @@
+/**
+ * RATE CLOCKS — the ONE copy every rate or budget row ships beside (T9-W7 pass 6, the chair's
+ * instruments lane; registry-v5 §2.3; LAWS P5 "A rate or budget gate proves its ablation reds
+ * under a 60 Hz rAF shim or drives its own clock ≥120 Hz"). From ACC-FIVE's pass-5 critic
+ * (`critique/ACC-FIVE/instruments/front-rate-60hz.CRITIC.spec.ts`): with the budget deleted
+ * (FRONT_MIN_MS 16 → 0) G10 PASSED at 60.2/60.4/60.0 (chromium) and 58.0/61.4/58.4 (webkit) per
+ * second under a 60 Hz clock — a gate whose verdict was the host's display.
+ *
+ * Three init scripts (pass to `context.addInitScript`), each self-contained:
+ *   SIXTY_HZ      the critic's shim verbatim: rAF callbacks fire on the first native frame at or
+ *                 after each 16.667 ms due time — the NEGATIVE CONTROL clock.
+ *   DRIVEN_CLOCK  a JS animation clock at `hz` (default 125): rAF callbacks are dispatched from a
+ *                 setTimeout pump stamped on its vsync grid (pass 8; `stamp: "wall"` keeps the
+ *                 pass-6 `performance.now()` stamps), so a budget ablation reds on ANY host,
+ *                 including a 60 Hz panel and the runner's raster.
+ *   TICK_RECORDER records native rAF timestamps (no change to the clock), for the precondition.
+ * All three leave `window.__ticks` (ms timestamps of animation-clock ticks).
+ *
+ * `clockPrecondition(page)` reads `__ticks` over the window the row measured and returns the
+ * median rate; every rate row asserts it ≥ 1.5 × its budget (93.75 Hz for 62.5/s) BEFORE it
+ * reads its own numbers, so a slow clock REDS LOUDLY instead of passing a broken tree.
+ *
+ * PRODUCT COPY (e2e/, ACC-FIVE pass 6): the chair's pass6/instruments/rate-clock.ts but for three
+ * `export` keywords. The three clocks are reached only through `clockFor`, and knip reds an export
+ * nothing imports.
+ */
+import type { Page } from "@playwright/test";
+
+const SIXTY_HZ = () => {
+  const nat = window.requestAnimationFrame.bind(window);
+  let pending = new Map<number, FrameRequestCallback>();
+  let id = 1,
+    due = -1,
+    scheduled = false;
+  (window as unknown as { __ticks: number[] }).__ticks = [];
+  const pump = (ts: number) => {
+    scheduled = false;
+    if (due < 0) due = ts;
+    if (ts + 0.5 < due) {
+      scheduled = true;
+      nat(pump);
+      return;
+    }
+    due = Math.max(due + 1000 / 60, ts);
+    (window as unknown as { __ticks: number[] }).__ticks.push(ts);
+    const cbs = pending;
+    pending = new Map();
+    for (const cb of cbs.values()) cb(ts);
+  };
+  window.requestAnimationFrame = (cb) => {
+    const i = id++;
+    pending.set(i, cb);
+    if (!scheduled) {
+      scheduled = true;
+      nat(pump);
+    }
+    return i;
+  };
+  window.cancelAnimationFrame = (i) => {
+    pending.delete(i);
+  };
+};
+
+const DRIVEN_CLOCK = (o: { hz: number; stamp: "vsync" | "wall" } = { hz: 125, stamp: "vsync" }) => {
+  const period = 1000 / o.hz;
+  // THE STAMP IS THE FRAME'S VSYNC (ACC-FIVE pass 8). A panel hands every rAF callback of a frame
+  // the frame's own time, on a regular grid, whenever the task runs; a timer pump stamped with
+  // `performance.now()` at fire hands the timer's lateness to every frame (6.1-10.1 ms apart at
+  // 125 Hz, 12-22 ms at 60 Hz under load 40-55), and no A.6 gate can then keep two frames in a
+  // 16 ms slot: over 3 s of such ticks the A.6 optimum was 51.1/s chromium, 54.7/s WebKit at
+  // 125 Hz. So the pump stamps the grid time it was DUE, on the engine's own grain (WebKit's rAF
+  // times are whole milliseconds, floored), and a pump that fires a whole period late stamps
+  // the latest vsync, as a panel that dropped frames does. `stamp: "wall"` keeps the pass-6
+  // stamps for the proof.
+  const a = performance.now();
+  let b = a;
+  while (b === a) b = performance.now();
+  const whole = Math.abs(b - a - Math.round(b - a)) < 1e-9 && Math.abs(a - Math.round(a)) < 1e-9;
+  let pending = new Map<number, FrameRequestCallback>();
+  let id = 1,
+    timer: ReturnType<typeof setTimeout> | null = null,
+    next = -Infinity;
+  (window as unknown as { __ticks: number[] }).__ticks = [];
+  (window as unknown as { __drops: number }).__drops = 0;
+  const pump = () => {
+    timer = null;
+    const now = performance.now();
+    // THE STAMP IS THE LATEST VSYNC AT OR BEFORE THE WALL: a pump a whole period late has missed
+    // those vsyncs (dropped frames) and stamps the panel's current one, so a stamp is never more
+    // than one period old, as a panel's never is (stamped with the SCHEDULED vsync, 5-17 ms behind
+    // the wall in WebKit at load 50-60, a sequence consumer read 0 re-cuts in 3 of 9 WebKit runs,
+    // mechanism unnamed; 0 of 4 with this stamp); a timer may fire a fraction early (chromium:
+    // 0.5 ms), and a frame's time never runs ahead of the wall's
+    if (o.stamp !== "wall" && now - next >= period) {
+      const k = Math.floor((now - next) / period);
+      (window as unknown as { __drops: number }).__drops += k;
+      next += k * period;
+    }
+    const ts = o.stamp === "wall" ? now : Math.min(now, whole ? Math.floor(next) : next);
+    (window as unknown as { __ticks: number[] }).__ticks.push(ts);
+    const cbs = pending;
+    pending = new Map();
+    // each callback in its own guard, as native rAF runs them: one callback's throw must not
+    // drop the frame's other callbacks nor stop the clock (a thrown frame left pencil-boil's
+    // chain waiting on a frame that never came, and every sequence consumer read 0 re-cuts)
+    for (const cb of cbs.values())
+      try {
+        cb(ts);
+      } catch (e) {
+        (window as unknown as { __rafErrors?: string[] }).__rafErrors ??= [];
+        (window as unknown as { __rafErrors: string[] }).__rafErrors.push(String(e));
+        setTimeout(() => {
+          throw e;
+        });
+      }
+    if (pending.size) arm();
+  };
+  const arm = () => {
+    if (timer != null) return;
+    const now = performance.now();
+    if (o.stamp === "wall" || !Number.isFinite(next)) next = Math.max(next + period, now);
+    else {
+      next += period;
+      // the vsyncs a late pump missed are dropped frames; an idle clock resumes on its grid
+      if (next < now) {
+        const k = Math.ceil((now - next) / period);
+        if (pending.size && k < 10) (window as unknown as { __drops: number }).__drops += k;
+        next += k * period;
+      }
+    }
+    timer = setTimeout(pump, Math.max(0, next - now));
+  };
+  window.requestAnimationFrame = (cb) => {
+    const i = id++;
+    pending.set(i, cb);
+    arm();
+    return i;
+  };
+  window.cancelAnimationFrame = (i) => {
+    pending.delete(i);
+  };
+};
+
+const TICK_RECORDER = () => {
+  const nat = window.requestAnimationFrame.bind(window);
+  const w = window as unknown as { __ticks: number[] };
+  w.__ticks = [];
+  const tick = (ts: number) => {
+    w.__ticks.push(ts);
+    nat(tick);
+  };
+  nat(tick);
+};
+
+/** The median animation-clock rate (Hz) over ticks at or after `since` (performance.now()). */
+export async function clockHz(page: Page, since = 0): Promise<{ hz: number; gaps: number }> {
+  return page.evaluate((since) => {
+    const t = ((window as unknown as { __ticks?: number[] }).__ticks ?? []).filter((x) => x >= since);
+    const g = t
+      .slice(1)
+      .map((x, i) => x - t[i])
+      .filter((d) => d < 100)
+      .sort((a, b) => a - b);
+    const med = g.length ? g[g.length >> 1] : Infinity;
+    return { hz: 1000 / med, gaps: g.length };
+  }, since);
+}
+
+/** The init script a row runs under, keyed by CLOCK=60|driven|native (default driven) and, for
+ *  the driven clock, HZ (default 125) and STAMP=vsync|wall (default vsync). A driven clock below
+ *  the budget's 93.75 Hz is a FLOOR row (ACC-FIVE pass 8, LAWS P7 §F: every rate row reads 60 Hz
+ *  AND 30 Hz beside the driven 125): it cannot see the ceiling broken, and it is the one clock
+ *  that sees a gate slow a true 60 Hz panel. `hz` is the rate the row asked for. */
+export function clockFor(
+  env = process.env.CLOCK ?? "driven",
+  hz = Number(process.env.HZ ?? 125),
+  stamp = (process.env.STAMP ?? "vsync") as "vsync" | "wall",
+): {
+  name: string;
+  script: (() => void) | ((o: { hz: number; stamp: "vsync" | "wall" }) => void);
+  arg?: { hz: number; stamp: "vsync" | "wall" };
+  hz?: number;
+} {
+  if (env === "60") return { name: "60 Hz shim (negative control)", script: SIXTY_HZ };
+  if (env === "native") return { name: "native (recorded)", script: TICK_RECORDER };
+  return { name: `driven ${hz} Hz (${stamp} stamps)`, script: DRIVEN_CLOCK, arg: { hz, stamp }, hz };
+}
diff --git a/web/frontend/e2e/tally-flash.spec.ts b/web/frontend/e2e/tally-flash.spec.ts
new file mode 100644
index 00000000..9d0ecd60
--- /dev/null
+++ b/web/frontend/e2e/tally-flash.spec.ts
@@ -0,0 +1,88 @@
+// PRM: live, because the subject IS the draw-in: under reduced motion the tally snaps inked and
+// there is no first frame to read.
+import { test, expect } from "@playwright/test";
+// @ts-expect-error — the ONE post-paint recorder is an .mjs home with no declaration (registry-v7 §2.4)
+import { installTimeline } from "./lib/postpaint.mjs";
+
+/**
+ * THE TALLY NEVER PAINTS A NEW TIER WHOLE BEFORE IT DRAWS IN (T9-W7 ACC-FIVE pass 8; registry-v7
+ * §2.7c; LAWS P7 §F "a consumer that moved its first write out of the inking flush reads
+ * post-paint for a whole-then-empty frame").
+ *
+ * Pass 7 dropped the tally's forced start write and let the frame after the grade write it. The
+ * new tier's strokes took their `inked` class in the render the grade landed in, still at the
+ * reveal the last draw-in left them (whole), and drew in from empty one or two frames later: 4
+ * of 11 tier-changing inks flashed whole on that tree against 0 of 7 on the control (pass-7
+ * critique §1.4). The cure writes the start in the inking flush through the gate and commits the
+ * ink WITH the reveal, so a start the budget owes keeps the last committed tally until it lands.
+ *
+ * THE READ is the chair's painted timeline (`installTimeline`, `len:` subject): after every rAF a
+ * task reads the inked strokes' count and their summed DRAWN length (geometry, or a dash's drawn
+ * fraction on a tree that still dashes). An ink's first frame L is the first read at the settled
+ * count with ≤ 30 % of the settled length; a FLASH is any read before L at the settled count with
+ * ≥ 90 % of it, on an act that changed the count. Acts: fresh loads (HARD / EASY alternating) and
+ * in-app re-deals, until ≥ 10 tier-changing inks have been read or 40 acts have run.
+ *
+ * BORN-RED: pass 7's tally (no start write, the class from the props) flashes; a run that reads
+ * fewer than 10 tier-changing inks reds on the count, so an empty run cannot pass.
+ */
+const MIN_INKS = 10;
+const MAX_ACTS = 40;
+const TALLY = ".difficulty-tally .dt-stroke.inked";
+
+type Read = { k: number; t: number; r: { x: number; y: number } | null };
+
+test("the tally's new strokes never paint whole before they draw in", async ({ browser }, testInfo) => {
+  test.setTimeout(600000);
+  const ctx = await browser.newContext({ viewport: { width: 1280, height: 800 }, reducedMotion: "no-preference" });
+  await ctx.addInitScript(installTimeline, `len:${TALLY}`);
+  const page = await ctx.newPage();
+  const drain = () =>
+    page.evaluate(() => {
+      const w = window as unknown as { __pf: { post: Read[] } };
+      const r = w.__pf.post;
+      w.__pf.post = [];
+      return r;
+    });
+  const count = () => page.evaluate((s) => document.querySelectorAll(s).length, TALLY);
+  const judge = (reads: Read[], n0: number) => {
+    const s = reads.filter((x) => x.r).map((x) => ({ n: x.r!.y, len: x.r!.x, t: x.t }));
+    const settled = s[s.length - 1];
+    const full = settled?.len ?? 0;
+    const nF = settled?.n ?? 0;
+    const L = s.findIndex((x) => x.n === nF && nF > 0 && full > 0 && x.len / full <= 0.3);
+    let flash = 0;
+    if (L > 0 && nF !== n0) for (let k = 0; k < L; k++) if (s[k].n === nF && s[k].len / full >= 0.9) flash++;
+    return { n0, nF, inked: L >= 0, changed: L >= 0 && nF !== n0, flash };
+  };
+  const rows: ReturnType<typeof judge>[] = [];
+  const log = (act: string, r: ReturnType<typeof judge>) => {
+    rows.push(r);
+    console.log(`TALLY-FLASH ${testInfo.project.name} ${act} ${JSON.stringify(r)}`);
+  };
+  for (let i = 0; rows.length < MAX_ACTS && rows.filter((r) => r.changed).length < MIN_INKS; i++) {
+    const diff = i % 2 ? "EASY" : "HARD";
+    await page.goto(`/?size=3&difficulty=${diff}`);
+    await page.waitForSelector(".sudoku-cell", { timeout: 60000 });
+    await page
+      .waitForFunction(() => !document.querySelector(".difficulty-tally")?.classList.contains("is-ungraded"), null, { timeout: 60000 })
+      .catch(() => {});
+    await page.waitForTimeout(2500);
+    log(`load ${diff}`, judge(await drain(), 0));
+    for (let d = 0; d < 2; d++) {
+      const n0 = await count();
+      await drain();
+      await page.locator('button[aria-label="Deal a new board"]').first().click();
+      await page.waitForTimeout(4000);
+      log(`re-deal ${diff}`, judge(await drain(), n0));
+    }
+  }
+  const inks = rows.filter((r) => r.changed);
+  const flashes = inks.filter((r) => r.flash > 0);
+  const line = `${flashes.length} of ${inks.length} tier-changing inks flash whole (${rows.filter((r) => r.inked).length} inks over ${rows.length} acts)`;
+  console.log(`TALLY-FLASH ${testInfo.project.name} SUMMARY ${line}`);
+  testInfo.annotations.push({ type: "tally-flash", description: line });
+  expect(inks.length, `only ${inks.length} tier-changing inks were read: the row saw too little to pass`).toBeGreaterThanOrEqual(MIN_INKS);
+  expect(flashes.length, line).toBe(0);
+  await ctx.close();
+});
diff --git a/web/frontend/e2e/wash-step.spec.ts b/web/frontend/e2e/wash-step.spec.ts
new file mode 100644
index 00000000..71d9352d
--- /dev/null
+++ b/web/frontend/e2e/wash-step.spec.ts
@@ -0,0 +1,113 @@
+import { test, expect } from "@playwright/test";
+// @ts-expect-error — the ONE paint library is an .mjs home with no declaration (registry-v7 §2.4)
+import { onOff, lum, ratio } from "./lib/paint-lib.mjs";
+
+// PRM: frozen — emulateMedia({reducedMotion:'reduce'}) before goto. The row reads one painted ground at rest.
+
+/**
+ * T9-W7 ACC-SIX pass 8 · THE WASH, READ AS PAINTED (the behavioural row beside `check-theme-tokens`'
+ * wash reach; LAWS P7 §F (iii): every source law pairs with a paint read on the real surface).
+ *
+ * `.cell-peer` — the selected cell's row / column / box reach — paints ONE ground token whose arm
+ * the const in index.css names. The row selects an empty cell on a real 9x9 deal (`?board=`, 30
+ * givens), photographs the inner 40 % of an empty PEER cell with its wash and with the wash layer
+ * hidden (the SAME pixels, one variable), and reads the step between them (WCAG ratio of the mean
+ * luminances). The step is the wash: it must not fall under HEAD's own painted step (1.078 light /
+ * 1.104 dark, the critic's reading of `74a2b5d9`), less 0.006 for the photograph.
+ *
+ * IN-RUN PLANTS (each must RED, the negative in the same run): W1 the consumer faded
+ * (`.cell-peer { opacity: .2 }`: 1.017-1.026 on GRAPHITE's tree) and W5 an `@property`
+ * re-registration of the token with `initial-value: transparent` (1.000: the consumer never
+ * inherits the const). A source gate reads neither in paint; this row reads both.
+ */
+
+const FLOOR = { light: 1.072, dark: 1.098 };
+const PLANTS = {
+  W1: ".cell-peer { opacity: 0.2 !important; }",
+  W5: "@property --ground-wash-unit { syntax: '<color>'; inherits: false; initial-value: transparent; }",
+};
+
+// A REAL 9x9 payload: a valid solved grid by the band pattern, 30 givens seeded.
+const SOL9 = Array.from({ length: 81 }, (_, i) => {
+  const r = Math.floor(i / 9);
+  return ((3 * (r % 3) + Math.floor(r / 3) + (i % 9)) % 9) + 1;
+});
+const KEEP9 = new Set([0, 4, 8, 10, 13, 16, 20, 22, 24, 27, 31, 35, 37, 39, 41, 43, 45, 49, 53, 56, 58, 60, 64, 67, 70, 72, 76, 80, 2, 78]);
+const PUZ9 = SOL9.map((v, i) => (KEEP9.has(i) ? String(v) : "0")).join("");
+const BOARD9 =
+  "?board=" +
+  btoa(String.fromCharCode(1) + "3." + PUZ9)
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+
+type Page = import("@playwright/test").Page;
+type Px = { data: Uint8Array; w: number; h: number };
+/** The wash's step on ONE clip: mean luminance with the layer vs the same pixels without it. */
+async function step(page: Page, clip: { x: number; y: number; width: number; height: number }) {
+  const { on, off } = (await onOff(page, clip, ".cell-peer { display: none !important; }")) as { on: Px; off: Px };
+  const mean = (p: Px) => {
+    const n = p.w * p.h;
+    let s = 0;
+    for (let k = 0; k < n; k++) s += lum(p.data, k * 3);
+    return s / n;
+  };
+  return +ratio(mean(on), mean(off)).toFixed(3);
+}
+
+for (const scheme of ["light", "dark"] as const) {
+  test(`the wash paints its step over the card, and the plants that fade it red · ${scheme}`, async ({ browser }) => {
+    test.setTimeout(90000);
+    const ctx = await browser.newContext({
+      viewport: { width: 1280, height: 800 },
+      deviceScaleFactor: 1,
+      colorScheme: scheme,
+    });
+    const page = await ctx.newPage();
+    await page.emulateMedia({ reducedMotion: "reduce" });
+    await page.goto("/" + BOARD9);
+    await page.waitForSelector("svg.hand-drawn-grid", { timeout: 60000 });
+    await page.evaluate(() => document.fonts.ready);
+    const empty = await page.evaluate(() =>
+      Array.from(document.querySelectorAll(".game-cell input")).map(
+        (i) => !/given/i.test(i.getAttribute("aria-label") ?? "") && !(i as HTMLInputElement).value,
+      ),
+    );
+    const pick = [40, 30, 50, 21].find((i) => empty[i]);
+    expect(pick, "an empty cell to select").not.toBeUndefined();
+    await page.locator(".game-cell").nth(pick!).click();
+    await page.waitForTimeout(400);
+    const peers = await page.evaluate(() =>
+      Array.from(document.querySelectorAll(".game-cell")).map((c) => !!c.querySelector(".cell-peer")),
+    );
+    const r0 = Math.floor(pick! / 9);
+    const peer = [...Array(81).keys()].find((i) => i !== pick && peers[i] && empty[i] && Math.floor(i / 9) === r0);
+    expect(peer, "an empty peer cell in the selected row").not.toBeUndefined();
+    const b = (await page.locator(".game-cell").nth(peer!).boundingBox())!;
+    const clip = {
+      x: Math.round(b.x + b.width * 0.3),
+      y: Math.round(b.y + b.height * 0.3),
+      width: Math.max(2, Math.round(b.width * 0.4)),
+      height: Math.max(2, Math.round(b.height * 0.4)),
+    };
+    const clean = await step(page, clip);
+    const planted: Record<string, number> = {};
+    for (const [k, css] of Object.entries(PLANTS)) {
+      const tag = await page.addStyleTag({ content: css });
+      await page.waitForTimeout(100);
+      planted[k] = await step(page, clip);
+      await tag.evaluate((e) => (e as Element).remove());
+    }
+    const computed = await page.evaluate(
+      (i) => getComputedStyle(document.querySelectorAll(".game-cell")[i].querySelector(".cell-peer")!).backgroundColor,
+      peer!,
+    );
+    console.log(
+      `WASH ${scheme}: cell ${pick} peer ${peer} step ${clean} (floor ${FLOOR[scheme]}) · W1 ${planted.W1} · W5 ${planted.W5} · computed ${computed}`,
+    );
+    await ctx.close();
+    expect.soft(clean, "the wash's painted step clears HEAD's").toBeGreaterThanOrEqual(FLOOR[scheme]);
+    for (const [k, v] of Object.entries(planted))
+      expect.soft(v, `plant ${k} must read under the floor (the row can fail)`).toBeLessThan(FLOOR[scheme]);
+  });
+}
