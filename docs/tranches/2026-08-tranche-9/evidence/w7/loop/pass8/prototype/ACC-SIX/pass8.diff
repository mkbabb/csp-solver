+// glyph-pop.mjs — THE glyph-population probe (T9-W7; registry-v5 §2.11 statistic, LAWS P6 §E, P7 §E
+// (v); registry-v7 §2.4 PRODUCT HOME). A painted-text gate reads the WHOLE glyph-coverage population:
+//   the subject photographed ON and with its text transparent (`color` AND `-webkit-text-fill-color`
+//   transparent, text-shadow none; or the caller's `off` sheet for an ink that is not text — TAB-PEN's
+//   favicon <img> photographed as its paper-only twin); every pixel whose RGB moved by ≥ `delta`
+//   (6/255) is a glyph pixel; its value = contrast(ON pixel, OFF pixel), the ink against its own ground.
+// The population is CLIPPED TO THE TEXT RUN (its text nodes' rects, never an svg or hidden descendant:
+// TIN/FIVE) and keeps only pixels STABLE across two ON photographs AND two OFF photographs (TIN: a
+// stray far-right cluster changed between the ON and OFF of one pair and red a clean tree 2 in 4).
+// Clauses (every one RED on breach — never `min(4.5, 0)`, never a skip):
+//   G0  the subject exists and is visible
+//   G1  the population ≥ `minPop` (40) px — an EMPTY or thin population is RED
+//   G2  the core median ≥ `floor` (4.5) — ABSOLUTE, never relative to an in-run photo of the subject
+//   G3  the fraction under `floor` ≤ `fracBound` — the bound is PER PAYLOAD (WALK: a pooled stamp
+//       handed the tighter subject the looser bound and masked a WebKit FADE65); `glyphGate` takes
+//       the clean read of THIS payload + 0.05
+//   G4  x-columns: every column holding ≥ `slicePop` px keeps its CORE (p95) ≥ max(3.0, 0.4 × the
+//       whole population's p95). The column count SCALES TO THE INK SPAN (TAB-PEN/COUNT: 16 columns
+//       over ~10 px of ink hold < 8 px each and G4 went blind) and the grid is read twice, aligned and
+//       shifted by half a column, so a 12 % fade always covers one whole column
+//   G5  glyph windows: the same core clause per CHARACTER (a Range per character of the run — COUNT:
+//       a p95 per x-window is blind to a fade over < ~95 % of it, and the leading digit is the
+//       costliest glyph to lose)
+// Plants (TEXT_PLANTS / IMG_PLANTS; each must RED): FAINT30, FADE65, FADE80 (fill), TAIL12, TAIL35,
+// HEAD12, MID20 (a mask over that fraction of the RUN at 25 %), EMPTY.
+//   node e2e/lib/glyph-pop.mjs --self-test [--engine chromium|webkit]     synthetic subjects, every plant
+//   node e2e/lib/glyph-pop.mjs --url <u> --subject <sel> --payload <name> [--scheme dark] [--dpr 2]
+//        [--viewport 1280x800] [--ready <sel>] [--click <sel>] [--hover <sel>] [--touch] [--prm 0]
+//        [--contrast more] [--regimes all]   (`all` = every paint-lib PAINT_REGIMES stop, LAWS P7 §E)
+// Exit: 0 clean GREEN and every plant RED · 1 clean RED · 3 a plant GREEN (a hole) · 4 both.
+import process from "node:process";
+import { fileURLToPath } from "node:url";
+import { resolve as resolvePath } from "node:path";
+import {
+  onOff,
+  lum,
+  ratio,
+  median,
+  quantile,
+  maxDelta,
+  settle,
+  textRunRects,
+  args,
+  load,
+  playwright,
+  openCell,
+  cellsOf,
+} from "./paint-lib.mjs";
+
+/** The column count for an ink span of `span` device px (G4). The floor is 13, not 8:
+ *  the aligned and half-shifted grids hold a WHOLE column inside any 12 % end run only when 1.5 / n ≤ 0.12
+ *  (at 8 columns a 17 px icon's TAIL12 straddled two columns and read GREEN in WebKit at DPR 1, pass 8). */
+export const autoSlices = (span) =>
+  Math.max(1, Math.min(Math.floor(span), 24, Math.max(13, Math.round(span / 3))));
+const autoSlicePop = (pop, n) => Math.max(3, Math.min(8, Math.round(pop / n / 3)));
+
+export async function glyphPopulation(
+  page,
+  { subject, off = null, floor = 4.5, minPop = 40, fracBound = null, delta = 6, pad = 2, slices = "auto", slicePop = "auto", sliceRatio = 0.4, sliceQ = 0.95, textRun = true, glyphWindows = true, runClip = true },
+) {
+  const loc = page.locator(subject).first();
+  // ACC-SIX pass 8 (PROPOSED → the ONE copy; LAWS P7 §E): a text laid in a ZERO-HEIGHT box (the strip's
+  // yielding meta) paints outside its box, so the box is not the clip: the clip is the box ∪ the text
+  // run, and a box Playwright calls invisible (0 px tall) is visible when its run paints. `runClip:
+  // false` is the legacy box clip (the self-test's ZERO row reads it G0/G1 — the hole this closes).
+  const runCss = textRun && runClip ? await page.evaluate(textRunRects, { subject }) : null;
+  const vis = (await loc.isVisible().catch(() => false)) || !!runCss?.length;
+  if (!vis) return { red: true, why: [`G0 subject ${subject} not visible`] };
+  let b = await loc.boundingBox();
+  if (runCss?.length && b) {
+    const l = Math.min(b.x, ...runCss.map((q) => q.l)),
+      t = Math.min(b.y, ...runCss.map((q) => q.t)),
+      r = Math.max(b.x + b.width, ...runCss.map((q) => q.r)),
+      bt = Math.max(b.y + b.height, ...runCss.map((q) => q.b));
+    b = { x: l, y: t, width: r - l, height: bt - t };
+  }
+  const vw = page.viewportSize();
+  const dpr = await page.evaluate(() => devicePixelRatio);
+  const x = Math.max(0, Math.floor(b.x - pad)),
+    y = Math.max(0, Math.floor(b.y - pad));
+  const clip = {
+    x,
+    y,
+    width: Math.min(vw.width - x, Math.ceil(b.width + 2 * pad)),
+    height: Math.min(vw.height - y, Math.ceil(b.height + 2 * pad)),
+  };
+  const offCss =
+    off ??
+    `${subject}, ${subject} * { color: transparent !important; -webkit-text-fill-color: transparent !important; text-shadow: none !important; }`;
+  // the text run (device px, relative to the clip) — the population's own extent
+  const run = textRun ? await page.evaluate(textRunRects, { subject }) : null;
+  const glyphs = textRun && glyphWindows ? await page.evaluate(textRunRects, { subject, chars: true }) : null;
+  const toDev = (r) => ({
+    l: Math.floor((r.l - clip.x) * dpr) - 1,
+    r: Math.ceil((r.r - clip.x) * dpr) + 1,
+    t: Math.floor((r.t - clip.y) * dpr) - 1,
+    b: Math.ceil((r.b - clip.y) * dpr) + 1,
+  });
+  const runDev = run && run.length ? run.map(toDev) : null;
+  const A = await onOff(page, clip, offCss);
+  const B = await onOff(page, clip, offCss);
+  const W = A.on.w;
+  let transientOn = 0,
+    transientOff = 0,
+    outsideRun = 0;
+  const pop = [],
+    xs = [],
+    ys = [];
+  for (let i = 0; i < A.on.data.length; i += 3) {
+    const px = (i / 3) % W,
+      py = Math.floor(i / 3 / W);
+    if (maxDelta(A.on.data, A.off.data, i) < delta) continue;
+    const tOn = maxDelta(A.on.data, B.on.data, i) >= delta,
+      tOff = maxDelta(A.off.data, B.off.data, i) >= delta;
+    if (tOn) transientOn++;
+    if (tOff) transientOff++;
+    if (tOn || tOff) continue;
+    if (runDev && !runDev.some((q) => px >= q.l && px < q.r && py >= q.t && py < q.b)) {
+      outsideRun++;
+      continue;
+    }
+    pop.push(ratio(lum(A.on.data, i), lum(A.off.data, i)));
+    xs.push(px);
+    ys.push(py);
+  }
+  const why = [];
+  const med = median(pop);
+  const frac = pop.length ? pop.filter((v) => v < floor).length / pop.length : 1;
+  if (pop.length < minPop) why.push(`G1 population ${pop.length} px < ${minPop} (EMPTY/thin is RED)`);
+  else {
+    if (med < floor) why.push(`G2 core median ${med.toFixed(3)} < ${floor}`);
+    if (fracBound != null && frac > fracBound)
+      why.push(`G3 fraction under ${floor} = ${frac.toFixed(3)} > bound ${fracBound.toFixed(3)}`);
+  }
+  const sl = [],
+    gw = [];
+  let n = 0,
+    sp = 0,
+    lim = 0;
+  if (pop.length >= minPop) {
+    const core = quantile(pop, sliceQ);
+    lim = Math.max(3.0, sliceRatio * core);
+    const x0 = Math.min(...xs),
+      x1 = Math.max(...xs) + 1;
+    n = slices === "auto" ? autoSlices(x1 - x0) : slices;
+    sp = slicePop === "auto" ? autoSlicePop(pop.length, n) : slicePop;
+    const w = (x1 - x0) / n;
+    const lows = [];
+    for (const shift of [0, 0.5]) {
+      for (let k = 0; k < n; k++) {
+        const a = x0 + (k + shift) * w,
+          e = a + w;
+        if (e > x1 + 0.001) continue;
+        const v = pop.filter((_, j) => xs[j] >= a && xs[j] < e);
+        const c = v.length >= sp ? +quantile(v, sliceQ).toFixed(2) : null;
+        if (!shift) sl.push(c);
+        if (c != null && c < lim) lows.push(`${shift ? "½" : ""}${k}:${c}`);
+      }
+    }
+    if (lows.length)
+      why.push(`G4 column core (p${Math.round(sliceQ * 100)}) under ${lim.toFixed(2)} (= max(3.0, ${sliceRatio}×whole p${Math.round(sliceQ * 100)} ${core.toFixed(2)}); ${n} columns, ≥${sp} px) at ${lows.join(", ")}`);
+    if (glyphs && glyphs.length) {
+      const glows = [];
+      glyphs.forEach((g, k) => {
+        const q = toDev(g);
+        const v = pop.filter((_, j) => xs[j] >= q.l + 1 && xs[j] < q.r - 1 && ys[j] >= q.t && ys[j] < q.b);
+        const c = v.length >= sp ? +quantile(v, sliceQ).toFixed(2) : null;
+        gw.push(c);
+        if (c != null && c < lim) glows.push(`${k}'${g.ch}':${c}`);
+      });
+      if (glows.length) why.push(`G5 glyph core (p${Math.round(sliceQ * 100)}) under ${lim.toFixed(2)} at ${glows.join(", ")}`);
+    }
+  }
+  return {
+    red: why.length > 0,
+    why,
+    population: pop.length,
+    coreMedian: +med.toFixed(3),
+    fracUnder: +frac.toFixed(3),
+    columns: n,
+    slicePop: sp,
+    slices: sl,
+    glyphCores: gw,
+    transientOn,
+    transientOff,
+    outsideRun,
+    clip,
+    dpr,
+  };
+}
+
+/** THE PER-PAYLOAD GATE (WALK W4): read the clean subject for THIS payload, bound G3 at its own
+ *  fraction + `slack`, then read every plant against that bound. `payload` names what the page holds
+ *  (a board, a deal, a peer id) and is REQUIRED — a bound is never pooled across payloads. */
+export async function glyphGate(page, { subject, payload, plants = null, slack = 0.05, img = null, ...opts }) {
+  if (!payload) throw new Error("glyphGate: `payload` is required (a G3 bound is per payload, never pooled)");
+  const first = await glyphPopulation(page, { subject, ...opts });
+  const bound = first.fracUnder != null && first.population >= (opts.minPop ?? 40) ? first.fracUnder + slack : null;
+  const clean = await glyphPopulation(page, { subject, fracBound: bound, ...opts });
+  const P = plants ?? (img ? IMG_PLANTS(subject, img.ng, img.ink) : TEXT_PLANTS(subject));
+  const out = {};
+  for (const [name, plant] of Object.entries(P)) {
+    const undo = await applyPlant(page, subject, plant);
+    await settle(page);
+    const r = await glyphPopulation(page, { subject, fracBound: bound, ...opts });
+    await undo();
+    await settle(page);
+    out[name] = r;
+  }
+  return { payload, bound, clean, plants: out };
+}
+
+/** The in-run text plants (LAWS P6 §E, P7 §E (v)) — each must RED. FAINT/FADE move only the FILL
+ *  (`color` stays green); `{ mask: [a, b] }` paints the fraction a..b of the TEXT RUN (text nodes
+ *  only) at 25 % through a mask keyed to the run's own pixels: TAIL12 [0.88, 1], TAIL35 [0.65, 1],
+ *  HEAD12 [0, 0.12] (COUNT: the leading digit), MID20 [0.4, 0.6]. */
+export const TEXT_PLANTS = (s) => ({
+  FAINT30_fill: `${s}, ${s} * { -webkit-text-fill-color: color-mix(in srgb, currentColor 30%, transparent) !important; }`,
+  FADE65_fill: `${s}, ${s} * { -webkit-text-fill-color: color-mix(in srgb, currentColor 65%, transparent) !important; }`,
+  FADE80_fill: `${s}, ${s} * { -webkit-text-fill-color: color-mix(in srgb, currentColor 80%, transparent) !important; }`,
+  TAIL12_a25: { mask: [0.88, 1] },
+  TAIL35_a25: { mask: [0.65, 1] },
+  HEAD12_a25: { mask: [0, 0.12] },
+  MID20_a25: { mask: [0.4, 0.6] },
+  EMPTY_hidden: `${s}, ${s} * { color: transparent !important; -webkit-text-fill-color: transparent !important; }`,
+});
+/** TAB-PEN (pass 7 PROPOSED): the plants' twins for an IMAGE subject (a favicon <img>): FAINT/FADE by
+ *  opacity, TAIL/HEAD by a mask over that fraction of the INK's x-extent (`ink` = [x0, x1] as fractions
+ *  of the box), EMPTY by the paper-only twin `ng`. Each must RED. */
+export const IMG_PLANTS = (s, ng, ink = [6 / 32, 26 / 32]) => {
+  const band = (a, bnd) => {
+    const p0 = ((ink[0] + a * (ink[1] - ink[0])) * 100).toFixed(2),
+      p1 = ((ink[0] + bnd * (ink[1] - ink[0])) * 100).toFixed(2);
