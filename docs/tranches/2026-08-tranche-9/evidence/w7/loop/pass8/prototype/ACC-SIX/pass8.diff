+      out.push({ kind: "script-write", prop, value: carry(m[3]), line: L(m.index) });
+  for (const m of s.matchAll(/\.style\[\s*([^\]'"`]+)\s*\]\s*=(?!=)\s*([^;\n]+)/g)) {
+    const k = on("const-carried") ? foldConcat(m[1], consts) : null;
+    if (k != null) {
