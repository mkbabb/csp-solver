+++ b/web/frontend/e2e/count-yield.spec.ts
@@ -0,0 +1,240 @@
+import { test, expect, type Browser, type Page } from "@playwright/test";
+// @ts-expect-error — the ONE post-paint recorder is an .mjs home with no declaration (registry-v7 §2.4)
+import { installTimeline } from "./lib/postpaint.mjs";
+
+// PRM: frozen — emulateMedia({reducedMotion:'reduce'}) before goto, in `open()` below. The row reads
+//   boxes, one text range and a painted timeline of that range, never a tween.
+
+/**
+ * T9-W7 ACC-SIX · THE COUNT YIELDS WHERE IT DOES NOT FIT, STAYS WHERE IT DOES, AND NEVER PAINTS A
+ * SECOND ROW (registry-v6 §2.12, registry-v7 §5 row 1–3; LAWS P7 §F "an e2e row DRIVES THE PRODUCT").
+ *
+ * The count ("N of M on the board") rides the margin strip's meta line beside the voice for the
+ * first three writes of a deal. Where the pair does not fit (a phone, a long hint, the widest 16x16
+ * count) the count gives up its line for the rest of the lesson and the strip stays ONE line, so W2's
+ * drawer tab and everything under the board hold still; where the pair fits it stays.
+ *
+ * The row DRIVES THE PRODUCT and writes nothing into a Vue-owned node (pass 7 set its widest voice
+ * with a hand-made span, the product's next hint patched its own line in beside it — two spans, a
+ * 41.59 px strip, a false gap): a real 16x16 deal (`?board=`, 86 givens, 170 writable) and the
+ * product's own hint button, four presses. Press 1 names a step, press 2 writes it (the count lays
+ * down, "1 of 170"), press 3 names the next step with a 34-character line ("E goes nowhere else in
+ * this column"), press 4 writes it.
+ *
+ * Per cell, four clauses, every pose:
+ *   ABSOLUTE — the strip's height and the drawer tab's y equal the CONTROL's at the same pose
+ *     (`CONTROL=<url>`, the same payload and presses on `74a2b5d9`, which has no count at all):
+ *     the count asks the strip for nothing. Ruling 12's clause, restored.
+ *   ROW — the count's text never sits below the voice's mid-line.
+ *   YIELD (393x699, 812x375 coarse) — from press 3 the count is gone and stays gone.
+ *   FIT (1280x800 fine, 844x390 coarse) — at press 3 the count is still on the voice's row
+ *     ("1 of 170 on the board"): a yield keyed on the hint's LENGTH ends the lesson here.
+ * And across press 3, POST-PAINT (the ONE recorder's `range:` subject, a task queued from every rAF):
+ *   PAINT — 0 frames paint the count's text on a second row ("the same frame, before paint").
+ *
+ * BORN-RED (the same tree served with one in-memory rewrite, `pass8/prototype/ACC-SIX/instruments/
+ * plant.mts`): `overyield` (the yield keyed on the voice's length) reds FIT; `late150` (the report
+ * 150 ms late) reds PAINT; `yieldoff` (no report) reds YIELD, ROW and PAINT.
+ */
+
+type Cell = { name: string; viewport: { width: number; height: number }; coarse: boolean; fits: boolean };
+const cells: Cell[] = [
+  { name: "393x699 coarse", viewport: { width: 393, height: 699 }, coarse: true, fits: false },
+  { name: "812x375 coarse", viewport: { width: 812, height: 375 }, coarse: true, fits: false },
+  { name: "1280x800 fine", viewport: { width: 1280, height: 800 }, coarse: false, fits: true },
+  { name: "844x390 coarse", viewport: { width: 844, height: 390 }, coarse: true, fits: true },
+];
+const CONTROL = process.env.CONTROL;
+
+// A REAL 16x16 payload: a valid solved grid by the band pattern, 86 givens seeded, 170 writable.
+function mulberry(a: number) {
+  return () => {
+    a |= 0;
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+const SOL16 = Array.from({ length: 256 }, (_, i) => {
+  const r = Math.floor(i / 16);
+  return ((4 * (r % 4) + Math.floor(r / 4) + (i % 16)) % 16) + 1;
+});
+const KEEP16 = (() => {
+  const rnd = mulberry(20260923);
+  const idx = [...Array(256).keys()];
+  for (let i = 255; i > 0; i--) {
+    const j = Math.floor(rnd() * (i + 1));
+    [idx[i], idx[j]] = [idx[j], idx[i]];
+  }
+  return new Set(idx.slice(0, 86));
+})();
+const PUZ16 = SOL16.map((v, i) => (KEEP16.has(i) ? v.toString(36) : "0")).join("");
+const BOARD16 =
+  "?board=" +
+  btoa(String.fromCharCode(1) + "4." + PUZ16)
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+
+type Pose = {
+  strip: number;
+  tabY: number | null;
+  voice: string;
+  meta: string | null;
+  /** the count's TEXT (its Range, the box is 0 px tall) sits below the voice's mid-line */
+  metaRow2: boolean;
+  /** the voice's mid-line, the row-two threshold for the painted timeline */
+  voiceMid: number | null;
+  coarse: boolean;
+};
+// Read-only: nothing here writes to the page.
+const SNAP = (): Pose => {
+  const r2 = (n: number) => Math.round(n * 100) / 100;
+  const strip = r2(document.querySelector(".board-margin")?.getBoundingClientRect().height ?? -1);
+  const t = document.querySelector(".drawer-tab");
+  const tabY = t ? r2(t.getBoundingClientRect().y + scrollY) : null;
+  const voice = document.querySelector(".margin-note");
+  const meta = document.querySelector(".margin-note-meta");
+  const v = voice?.getBoundingClientRect();
+  const voiceMid = v ? v.top + v.height / 2 : null;
+  let metaRow2 = false;
+  if (meta && voiceMid !== null) {
+    const r = document.createRange();
+    r.selectNodeContents(meta);
+    metaRow2 = r.getBoundingClientRect().top > voiceMid;
+  }
+  return {
+    strip,
+    tabY,
+    voice: voice?.textContent?.trim() ?? "",
+    meta: meta?.textContent?.trim() ?? null,
+    metaRow2,
+    voiceMid,
+    coarse: matchMedia("(pointer: coarse)").matches,
+  };
+};
+/** A pose is read when two consecutive reads agree (the dock sheet slides ~700 ms). */
+async function settled(page: Page): Promise<Pose> {
+  let prev = "";
+  let pose!: Pose;
+  await expect
+    .poll(
+      async () => {
+        pose = await page.evaluate(SNAP);
+        const k = JSON.stringify(pose);
+        const same = k === prev;
+        prev = k;
+        return same;
+      },
+      { intervals: [250], timeout: 15000 },
+    )
+    .toBe(true);
+  return pose;
+}
+async function open(browser: Browser, cell: Cell, base?: string) {
+  const ctx = await browser.newContext({
+    viewport: cell.viewport,
+    hasTouch: cell.coarse,
+    isMobile: false,
+    ...(base ? { baseURL: base } : {}),
+  });
+  const page = await ctx.newPage();
+  await page.emulateMedia({ reducedMotion: "reduce" });
+  await page.goto("/" + BOARD16);
+  await page.waitForSelector(".sudoku-cell", { timeout: 60000 });
+  await page.evaluate(() => document.fonts.ready);
+  return { ctx, page };
+}
+/** The product's own hint, as `fillByHint` presses it (the first live match in the DOM). */
+const hint = (page: Page) =>
+  page.evaluate(() => {
+    const b = document.querySelector<HTMLButtonElement>('[aria-label*="Hint" i]:not([disabled])');
+    b?.click();
+    return !!b;
+  });
+const fill = (page: Page) =>
+  page.evaluate(() => document.querySelector('[role="progressbar"]')?.getAttribute("aria-valuetext") ?? "");
+const written = (page: Page) =>
+  page.evaluate(() =>
+    Number(document.querySelector('[role="progressbar"]')?.getAttribute("aria-valuetext")?.split(" ")[0] ?? -1),
+  );
+
+type Frame = { k: number; t: number; r: { x: number; y: number; w: number; h: number } | null };
+/** Rest, four presses; press 3 is recorded post-paint (`range:` over the count's text). */
+async function drive(browser: Browser, cell: Cell, base?: string) {
+  const { ctx, page } = await open(browser, cell, base);
+  const poses: Array<[string, Pose]> = [["rest", await settled(page)]];
+  // the control (74a2b5d9) says its fill as a percent and has no count: its presses are waited on
+  // the progressbar's value changing, the tree's on the count it writes
+  const control = !!base;
+  for (let k = 0; k < 2; k++) {
+    const before = await fill(page);
+    expect(await hint(page)).toBe(true);
+    if (control && k === 1) await expect.poll(() => fill(page), { timeout: 10000 }).not.toBe(before);
+    else if (!control) await expect.poll(() => written(page), { timeout: 10000 }).toBeGreaterThanOrEqual(k);
+    poses.push([`press${k + 1}`, await settled(page)]);
+  }
+  if (!control) await expect.poll(() => written(page), { timeout: 10000 }).toBe(1);
+  poses.push(["laid", await settled(page)]);
+  await page.evaluate(installTimeline, "range:.margin-note-meta");
+  expect(await hint(page)).toBe(true);
+  poses.push(["press3", await settled(page)]);
+  const pf = await page.evaluate(() => {
+    const w = window as unknown as { __pf: { on: boolean; post: Frame[] } };
+    w.__pf.on = false;
+    return w.__pf.post;
+  });
+  expect(await hint(page)).toBe(true);
+  // the second write: the tree's count says it; the control's percent cannot (1 and 2 of 170 both
+  // round to 1 %), so the control is given the write's own settle
+  if (!control) await expect.poll(() => written(page), { timeout: 10000 }).toBe(2);
+  else await page.waitForTimeout(1500);
+  poses.push(["press4", await settled(page)]);
+  await ctx.close();
+  return { poses: Object.fromEntries(poses) as Record<string, Pose>, order: poses.map(([n]) => n), frames: pf };
+}
+
+for (const cell of cells) {
+  test(`the count ${cell.fits ? "stays where it fits" : "yields and stays gone"}, on one row, painting no second · ${cell.name}`, async ({
+    browser,
+  }) => {
+    test.setTimeout(180000);
+    expect(CONTROL, "CONTROL=<url of 74a2b5d9> is required: the absolute clause reads the control's strip").toBeTruthy();
+    const tree = await drive(browser, cell);
+    const ctrl = await drive(browser, cell, CONTROL);
+    const P = tree.poses;
+    expect(P.rest.coarse, "the pointer regime is witnessed").toBe(cell.coarse);
+    expect(P.rest.meta, "no count before the first write").toBe(null);
+    expect(P.laid.meta, "the count was laid down (the row's witness)").toBe("1 of 170 on the board");
+    expect(P.press3.voice.length, "press 3 speaks the long line").toBeGreaterThanOrEqual(30);
+
+    // soft from here: a broken tree shows EVERY clause it breaks, not the first
+    for (const n of tree.order) {
+      const p = P[n];
+      const c = ctrl.poses[n];
+      expect.soft(Math.abs(p.strip - c.strip), `${n}: ABSOLUTE strip ${p.strip} vs control ${c.strip}`).toBeLessThanOrEqual(0.5);
+      expect.soft(Math.abs((p.tabY ?? 0) - (c.tabY ?? 0)), `${n}: ABSOLUTE tab ${p.tabY} vs control ${c.tabY}`).toBeLessThanOrEqual(0.5);
+      expect.soft(p.metaRow2, `${n}: ROW the count never sits on a second row`).toBe(false);
+    }
+    if (cell.fits) {
+      expect.soft(P.press3.meta, "FIT: beside the long line the count stays").toBe("1 of 170 on the board");
+      expect.soft(P.press4.meta, "FIT: the next write updates it in place").toBe("2 of 170 on the board");
+    } else {
+      expect.soft(P.press3.meta, "YIELD: beside the long line the count gives up its line").toBe(null);
+      expect.soft(P.press4.meta, "YIELD: once yielded the count stays gone (no blink)").toBe(null);
+    }
+    const mid = P.laid.voiceMid ?? 0;
+    const row2 = tree.frames.filter((f) => f.r && f.r.h > 0 && f.r.y > mid);
+    const withCount = tree.frames.filter((f) => f.r && f.r.h > 0).length;
+    expect.soft(tree.frames.length, "PAINT: the recorder read frames across press 3").toBeGreaterThanOrEqual(10);
+    expect.soft(row2.length, `PAINT: frames painting the count on a second row (of ${tree.frames.length})`).toBe(0);
+    console.log(
+      `YIELD ${cell.name}: ` +
+        tree.order
+          .map((n) => `${n} strip ${P[n].strip}/${ctrl.poses[n].strip} tab ${P[n].tabY}/${ctrl.poses[n].tabY} meta ${P[n].meta ?? "-"}${P[n].metaRow2 ? " ROW2" : ""}`)
+          .join(" · ") +
+        ` · press3 voice "${P.press3.voice}" (${P.press3.voice.length}) · post-paint frames ${tree.frames.length}, with count ${withCount}, row two ${row2.length}`,
+    );
+  });
+}
