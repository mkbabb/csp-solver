+    for (const m of s.matchAll(
+      /(?:\.style\s*\.\s*cssText\s*\+?=(?!=)|setAttribute\(\s*(["'`])style\1\s*,)\s*([^;\n]+)/g,
+    )) {
+      const v = foldConcat(m[2].replace(/\)\s*$/, ""), consts);
+      if (v == null)
