+  durationMs: number;
+  easing: (t: number) => number;
+  /** `at`: this frame's rAF timestamp, for `frontGate.write(v, force, at)` */
+  onProgress: (eased: number, at: number) => void;
+  onComplete: (at: number) => void;
+}) {
+  const SPAN_MS = 600_000; // the carrier's span: the tween ends on its own clock long before
+  let clock = 0;
+  let prev = 0;
+  let origin = 0; // the carrier's start on the rAF clock (pencil-boil reads performance.now() there)
+  const seq = createSequenceSubscription({
+    durationMs: SPAN_MS,
+    onProgress: (_eased, raw) => {
+      const t = raw * SPAN_MS;
+      const dt = Math.max(0, t - prev);
+      clock += Math.min(dt, Math.max(MOTION.hand.stepMs, panelFrameMs(dt, origin + t)));
+      prev = t;
