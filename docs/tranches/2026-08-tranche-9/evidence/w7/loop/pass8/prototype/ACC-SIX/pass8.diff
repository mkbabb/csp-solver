+  [`REF_PATH_OPACITY${a}`]: `${["path", "rect", "line", "polyline", "polygon", "circle", "ellipse"].map((t) => `${edge} ${t}`).join(", ")} { opacity: ${a} !important; }`,
+  [`REF_FILTER_OPACITY${a}`]: `${edge} { filter: opacity(${a}) !important; }`,
+});
