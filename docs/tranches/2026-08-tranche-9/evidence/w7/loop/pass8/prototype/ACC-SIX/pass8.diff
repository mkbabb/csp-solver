+    heldAt = null;
+  const intervals = [];
+  for (let i = 1; i < changed.length; i++) {
+    const h = changed[i].t - changed[i - 1].t;
+    intervals.push([changed[i - 1].t, changed[i].t]);
+    if (h > maxHeld) {
+      maxHeld = h;
+      heldAt = changed[i - 1].t;
+    }
+  }
+  const ds = rows.map((r) => r.d).filter((d) => d != null && Number.isFinite(d));
+  return {
+    photos: rows.length,
+    changed: changed.length,
+    eps,
+    deltaMedian: ds.length ? +[...ds].sort((a, b) => a - b)[ds.length >> 1].toFixed(4) : null,
+    windowMs: changed.length ? +(changed[changed.length - 1].t - changed[0].t).toFixed(1) : 0,
+    firstChange: changed[0]?.t ?? null,
+    gapMs: stat(gaps),
+    maxHeldMs: +maxHeld.toFixed(1),
+    heldAt,
+    intervals,
+    deltas: rows.map((r) => [+(r.t - (rows[0]?.t ?? 0)).toFixed(1), r.d]),
+  };
+}
+
+/** Timeline analysis inside [t0, t1] (epoch ms): rAF gaps, max held gap. */
+export function analyseTimeline(pf, t0, t1) {
+  const rafs = pf.rafs.map((r) => ({ ...r, e: pf.origin + r.ts })).filter((r) => r.e >= t0 && r.e <= t1);
+  const gaps = rafs.slice(1).map((r, i) => r.e - rafs[i].e);
+  let maxGap = 0,
+    at = null;
+  const intervals = [];
+  for (let i = 1; i < rafs.length; i++) {
+    const g = rafs[i].e - rafs[i - 1].e;
+    intervals.push([rafs[i - 1].e, rafs[i].e]);
+    if (g > maxGap) {
+      maxGap = g;
+      at = rafs[i - 1].e;
+    }
+  }
+  return { rafs: rafs.length, gapMs: stat(gaps), maxGapMs: +maxGap.toFixed(1), at, intervals };
+}
