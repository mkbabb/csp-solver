+/** The frame that first painted the mover: the last frame whose rAF time is at or before the entry. */
+export const kPaintOf = (pp) => (pp.io == null || pp.io < 0 ? -1 : pp.stamps.reduce((k, r, i) => (r <= pp.io ? i : k), -1));
+
+/** Frames with the animation present, keyed on `kPaint` (reads before it DROPPED); F1 + CI verdicts. */
+export function analyse(frames, rest, { kPaint = -1, tolPx = 3, tolMs = 2, ks = [2, 3] } = {}) {
+  const all = frames.filter((x) => x.ct !== null).sort((a, b) => a.k - b.k);
+  const f = kPaint >= 0 ? all.filter((x) => x.k >= kPaint) : all;
+  const dropped = all.length - f.length;
+  if (!f.length) return { red: true, f1red: true, ciRed: false, why: ["EMPTY: the subject never animated"], f1: null, ci: [], dropped };
+  const c = (s) => Math.hypot(s.x - rest.x, s.y - rest.y),
+    dw = (s) => s.w - rest.w;
+  const why = [];
+  const f1red = c(f[0]) > tolPx || Math.abs(dw(f[0])) > tolPx;
+  if (f1red) why.push(`F1 frame 1 at ct ${f[0].ct.toFixed(1)}: centre ${c(f[0]).toFixed(2)} px, dw ${dw(f[0]).toFixed(2)} px (> ${tolPx})`);
+  const ci = [];
+  let ciRed = false;
+  for (const k of ks) {
+    const fk = f[k - 1];
+    if (!fk) {
+      why.push(`CI frame ${k} missing`);
+      ciRed = true;
+      continue;
+    }
+    const want = fk.tl - f[0].tl;
+    const off = fk.ct - want; // the law: ct(frame k) = tl(k) − tl(frame 1), frame 1 at ct 0
+    ci.push({ k, ct: +fk.ct.toFixed(1), tlDelta: +want.toFixed(1), off: +off.toFixed(1) });
+    if (Math.abs(off) > tolMs) {
+      why.push(`CI ct(frame ${k}) ${fk.ct.toFixed(1)} vs tl(${k})−tl(1) ${want.toFixed(1)} (off ${off.toFixed(1)} ms > ${tolMs})`);
+      ciRed = true;
+    }
+  }
+  return { red: why.length > 0, f1red, ciRed, why, f1: { k: f[0].k, ct: +f[0].ct.toFixed(1), c: +c(f[0]).toFixed(2), dw: +dw(f[0]).toFixed(2), ps: f[0].ps }, ci, frames: f.length, dropped };
+}
+
+/** Init-script plants. SKIP: every explicit startTime write lands 150 ms early. */
+export const SKIP_PLANT = () => {
+  const d = Object.getOwnPropertyDescriptor(Animation.prototype, "startTime");
+  Object.defineProperty(Animation.prototype, "startTime", {
+    get() {
+      return d.get.call(this);
+    },
+    set(v) {
+      d.set.call(this, typeof v === "number" ? v - 150 : v);
+    },
+    configurable: true,
+  });
+};
+/** F2 (the pass-7 critic's): frame 1 left at its pose; on the SECOND rAF after the subject's animate()
+ *  its clock jumps 150 ms, so frame 2 paints 150 ms in. `sel` = the subject. */
+export const F2_PLANT = (sel) => {
+  const animate = Element.prototype.animate;
+  let armed = false;
+  Element.prototype.animate = function (...a) {
+    const anim = animate.apply(this, a);
+    if (!armed && this.matches?.(sel)) {
+      armed = true;
+      requestAnimationFrame(() =>
+        requestAnimationFrame(() => {
+          anim.currentTime = Number(anim.currentTime ?? 0) + 150;
+        }),
+      );
+    }
+    return anim;
+  };
+};
