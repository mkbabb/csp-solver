+// ------------------------------------------------------------------------------------- the census
+/** Every CSS block a source carries: [{css, line, kind}] (an SFC's top-level <style>s, a stylesheet
+ *  in any Vite CSS language, a public/ sheet, index.html's <style>, CSS inside script strings). */
+export function cssBlocks(f, text, fe = "") {
+  const rel = fe ? relative(fe, f) : f;
+  if (f.endsWith(".vue"))
+    return sfc(text).styles.map((b) => ({
+      css: b.css,
+      line: b.line,
+      kind: /scoped/.test(b.attrs) ? "sfc-style-scoped" : "sfc-style",
+    }));
+  if (isCss(f))
+    return [
+      {
+        css: text,
+        line: 1,
+        kind: rel.startsWith("public") ? "public-css" : "stylesheet",
+      },
+    ];
+  if (f.endsWith(".html"))
+    return [...stripHtml(text).matchAll(/<style[^>]*>([\s\S]*?)<\/style>/g)].map(
+      (m) => ({
+        css: m[1],
+        line: lineAt(text, m.index),
+        kind: "index-html",
+      }),
+    );
+  return [];
+}
+/** Every rule a source carries, in source order, with the block's kind (script CSS included). */
+export function rulesOf(f, text, fe = "") {
+  const out = [];
+  for (const b of cssBlocks(f, text, fe))
+    for (const r of cssRules(b.css, b.line)) out.push({ ...r, kind: b.kind });
+  if (f.endsWith(".vue"))
+    for (const sc of sfc(text).scripts) out.push(...scriptCss(sc.text, sc.line));
+  else if (/\.(ts|tsx|js|mjs)$/.test(f)) out.push(...scriptCss(text));
+  return out;
+}
+/** Every site that sets `prop` on subject class `cls` (`*` = every subject), tree-wide, in source
+ *  order per file. Returns [{file, kind, ctx, prelude, prop, value, important, line, regimes,
+ *  unresolved?}]; `regimes` = the REGIMES the site's media context holds in (LEDGER). */
+export function census(fe, cls, prop, { files, read, exists, extra = [] } = {}) {
+  const out = [];
+  const rd = read ?? ((f) => readFileSync(f, "utf8"));
+  const list = files
+    ? followImports([...files, ...extra], { read: rd, exists })
+    : [...sources(fe, { read: rd, exists }), ...extra];
+  for (const f of list) {
+    const rel = relative(fe, f);
+    const text = rd(f);
+    for (const r of rulesOf(f, text, fe))
+      if (subjectHas(r.as ?? r.prelude, cls))
+        for (const d of r.decls)
+          if (sets(d, prop))
+            out.push({
+              file: rel,
+              kind: r.kind,
+              ctx: r.ctx.join(" "),
+              prelude: r.prelude,
+              prop: d.prop,
+              value: d.value,
+              important: d.important,
+              line: d.line,
+              varLed: d.prop !== prop && /^\s*var\(/.test(d.value),
+              regimes: regimesOf(r.ctx),
+            });
+    if (f.endsWith(".vue")) {
+      const b = sfc(text);
+      if (b.template)
+        for (const s of templateSites(b.template.text, cls, b.template.line))
+          if (s.prop === prop || s.unresolved || sets(s, prop))
+            out.push(
+              on("tpl-file")
+                ? {
+                    ctx: "",
+                    prelude: `<template .${cls}>`,
+                    regimes: ALL_REGIMES(),
+                    ...s,
+                    file: rel,
+                  }
+                : { file: rel, ctx: "", prelude: `<template .${cls}>`, ...s },
+            );
+      for (const sc of b.scripts)
+        for (const w of scriptWrites(sc.text, prop, sc.line))
+          out.push({
+            file: rel,
+            ctx: "",
+            prelude: "<script>",
+            regimes: ALL_REGIMES(),
+            ...w,
+          });
+    } else if (/\.(ts|tsx|js|mjs)$/.test(f))
+      for (const w of scriptWrites(text, prop))
+        out.push({
+          file: rel,
+          ctx: "",
+          prelude: "<script>",
+          regimes: ALL_REGIMES(),
+          ...w,
+        });
+  }
+  return out;
+}
+/** Tokens: every `--x: v` declaration tree-wide (last wins per name; all kept in `all`), in every CSS
+ *  block, `@theme` included; (GRAPHITE) `@property` initial-values and Tailwind arbitrary properties
+ *  are declaration SITES too. */
+export function tokens(fe, { files, read, exists, extra = [] } = {}) {
+  const map = new Map(),
+    all = [];
+  const rd = read ?? ((f) => readFileSync(f, "utf8"));
+  const list = files
+    ? followImports([...files, ...extra], { read: rd, exists })
+    : [...sources(fe, { read: rd, exists }), ...extra];
+  for (const f of list) {
+    const text = rd(f);
+    const file = relative(fe, f);
+    for (const r of rulesOf(f, text, fe)) {
+      const reg = /^@property\s+(--[\w-]+)/.exec(r.prelude);
+      for (const d of r.decls) {
+        if (d.prop.startsWith("--")) {
+          map.set(d.prop, d.value);
+          all.push({ file, prelude: r.as ?? r.prelude, ctx: r.ctx.join(" "), ...d });
+        } else if (reg && d.prop === "initial-value" && on("at-property-site")) {
+          all.push({
+            file,
+            prelude: r.prelude,
+            ctx: r.ctx.join(" "),
+            ...d,
+            prop: reg[1],
+            kind: "at-property",
+          });
+          if (!map.has(reg[1])) map.set(reg[1], d.value);
+        }
+      }
+    }
+    if (f.endsWith(".vue") && on("tw-arbitrary")) {
+      const b = sfc(text);
+      if (b.template)
+        for (const s of templateSites(b.template.text, "*", b.template.line))
+          if (s.kind === "tailwind-arbitrary") {
+            map.set(s.prop, s.value);
+            all.push({ file, prelude: `<template ${s.token}>`, ctx: "", ...s });
+          }
+    }
+  }
+  return { map, all };
+}
+/** TAB-PEN C9: a token with two PLACED sites in one scope (same selector, same context) whose values
+ *  disagree resolves by walk order, not by the cascade the build ships: every such name. */
+export function tokenConflicts(all) {
+  if (!on("token-conflict")) return [];
+  const by = new Map();
+  for (const t of all) {
+    const k = `${t.prop}\u0000${(t.prelude ?? "").replace(/\s+/g, "")}\u0000${t.ctx ?? ""}`;
+    by.set(k, [...(by.get(k) ?? []), t]);
+  }
+  return [...by.values()]
+    .filter((ts) => new Set(ts.map((t) => t.value.trim())).size > 1)
+    .map((ts) => ({ name: ts[0].prop, sites: ts }));
+}
+/** A `${}` template name's spelling as {head, tail} (VERB X15b: the tail after the placeholder is
+ *  part of the name — `--verb-${k}-bogus` is not declared by `--verb-a`). */
+const stemParts = (name) => {
+  const i = name.indexOf("${");
+  const j = name.indexOf("}", i);
+  return {
+    head: name.slice(0, i),
+    tail: on("stem-all") ? name.slice(j + 1).replace(/\$\{[^}]*\}.*$/, "") : "",
+  };
+};
+/** Every declared name a stem template can spell (head … tail), in `names`. */
+export function stemMatches(name, names) {
+  const { head, tail } = stemParts(name);
+  return [...names].filter(
+    (k) =>
+      k.startsWith(head) &&
+      k.endsWith(tail) &&
+      k.length > head.length + tail.length - (on("stem-all") ? 0 : 1),
+  );
+}
+/** Resolve var() with fallbacks against a token map; `var(--stem-${x})` → every token the whole
+ *  template spells (`{a|b}`), its fallback when none, else left as written (unresolved). */
+export function resolve(value, map, depth = 0) {
+  if (depth > 8) return value;
+  return value.replace(
+    /var\(\s*(--[\w-]*(?:\$\{[^}]*\}[\w-]*)*)\s*(?:,\s*((?:[^()]|\([^()]*\))*))?\)/gi,
+    (m, name, fb) => {
+      if (name.includes("${")) {
+        const hits = stemMatches(name, map.keys());
+        return hits.length
+          ? `{${hits.map((k) => resolve(map.get(k), map, depth + 1)).join("|")}}`
+          : fb != null
+            ? resolve(fb, map, depth + 1)
+            : m;
+      }
+      if (map.has(name)) return resolve(map.get(name), map, depth + 1);
+      return fb != null ? resolve(fb.trim(), map, depth + 1) : m;
+    },
+  );
+}
+/** Every var() reference in a value: [{name, fallback, stem, matches, unresolved}] — a stem is
+ *  UNRESOLVED unless `values` names its value set (VERB X15: "declared because some name carries
+ *  the stem" is not the law; the template is every stem it can spell). */
+export function varRefs(value, names = [], { values } = {}) {
+  const out = [];
+  for (const m of String(value).matchAll(
+    /var\(\s*(--[\w-]*(?:\$\{[^}]*\}[\w-]*)*)\s*(?:,\s*((?:[^()]|\([^()]*\))*))?\)/gi,
+  )) {
+    const name = m[1];
+    if (!name.includes("${")) {
+      out.push({
+        name,
+        fallback: m[2] ?? null,
+        stem: false,
+        matches: [name],
+        unresolved: false,
+      });
+      continue;
+    }
+    const { head, tail } = stemParts(name);
+    const spelled = values ? values.map((v) => head + v + tail) : null;
+    const matches = spelled ?? stemMatches(name, names);
+    out.push({
+      name,
+      fallback: m[2] ?? null,
+      stem: true,
+      matches,
+      unresolved: on("stem-all") ? !values : matches.length === 0,
+    });
+  }
+  return out;
+}
+/** LIVE (X7–X9): every `var(--x, fallback)` a text carries — matched CASE-INSENSITIVELY (`VAR(`),
+ *  with string concatenation folded first (`"var(--motion-note" + ", 280ms)"`) and `${}` stems
