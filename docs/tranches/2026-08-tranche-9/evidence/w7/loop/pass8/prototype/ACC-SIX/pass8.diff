+    });
+    await settle(page);
+    const lr = await glyphPopulation(page, { subject: "#g-tape", glyphWindows: false });
+    rows.push(`GLYPH self-test ${scheme} dpr${dpr} #g-tape LEGACY-RANGE TAIL12 (cut at ${legacy.toFixed(1)} px, on the svg) ${fmt(lr)} ← the pass-7 hole ${lr.red ? "(read RED here)" : "(GREEN: the fix is load-bearing)"}`);
+    await ctx.close();
+  }
+  return { rows, exit: cleanRed ? (hole ? 4 : 1) : hole ? 3 : 0 };
+}
+export const fmt = (r) =>
+  `pop ${r.population ?? 0} median ${r.coreMedian ?? "-"} <4.5 ${r.fracUnder ?? "-"} cols ${r.columns ?? "-"}(≥${r.slicePop ?? "-"}px) [${(r.slices ?? []).map((v) => v ?? "·").join(" ")}] glyphs [${(r.glyphCores ?? []).map((v) => v ?? "·").join(" ")}] transient on/off ${r.transientOn ?? "-"}/${r.transientOff ?? "-"} outside-run ${r.outsideRun ?? "-"} → ${r.red ? "RED " + r.why.join("; ") : "GREEN"}`;
