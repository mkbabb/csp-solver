+      expect(leave.painted).toBeLessThanOrEqual(2);
+    } else {
+      expect(leave.animationName).toContain('ink-rub-out');
+      for (const d of leave.animationDuration.split(','))
+        expect(Math.round(parseFloat(d) * 1000)).toBe(MOTION.rungs.whisper);
+      expect(leave.ms).toBeLessThan(MOTION.rungs.note);
+    }
+    console.log(`line two ${adv.name}: ${leave.ms} ms, ${leave.painted} painted frames`);
+  });
+}
+
+for (const adv of LINE_TWO_ADVERSARIES.filter((a) => /layer|shorthand|:root/.test(a.name)))
+  test(`drop clock, line two (negative, in-run): pass 6's hook is held by ${adv.name}`, async ({
+    page,
+  }) => {
+    await page.addInitScript(PASS_SIX_HOOK);
+    const leave = await lineTwoLeaves(page, adv.css);
+    // Without the animation axis the adversary owns the clock: 900 ms and more.
+    expect(leave.ms).toBeGreaterThan(3 * MOTION.rungs.note);
+    console.log(`line two negative ${adv.name}: held ${leave.ms} ms`);
+  });
