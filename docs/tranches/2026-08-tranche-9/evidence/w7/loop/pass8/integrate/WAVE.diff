+    const c = js[i];
+    if (q) {
+      o += c;
+      if (c === "\\") {
+        o += js[++i] ?? "";
+        continue;
+      }
+      if (q === "`" && c === "$" && js[i + 1] === "{") {
+        d++;
+        o += js[++i];
+        continue;
+      }
+      if (c === q && d === 0) q = null;
+      else if (q === "`" && c === "}" && d > 0) d--;
+      continue;
+    }
+    if (c === '"' || c === "'" || c === "`") {
+      q = c;
+      o += c;
+      continue;
+    }
+    if ("([{".includes(c)) d++;
+    else if (")]}".includes(c)) {
+      if (d === 0) break;
+      d--;
