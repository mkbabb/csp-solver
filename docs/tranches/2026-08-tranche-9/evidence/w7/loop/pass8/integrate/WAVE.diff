+  // !important` after a house shorthand wins the cascade and ships ease-in; pass 6 read the
+  // shorthand alone. Every longhand in every stylesheet, and every script write of it, is read
+  // by VALUE through the same resolver — a keyword there is a keyword on a transition.
+  for (const [where, value] of longhands)
+    for (const v of curveValue(value, toks)) {
+      if (UA_KEYWORD.test(v)) {
+        bad.push(
+          `${where}  transition-timing-function: ${value} — computes to \`${v}\`, a UA keyword (the longhand beside the shorthand).`,
+        );
+        continue;
+      }
+      const pts = pointsOf(v);
+      const kw = Object.keys(UA_POINTS).find((k) => UA_POINTS[k] === pts);
+      if (kw)
+        bad.push(
+          `${where}  transition-timing-function: ${value} — \`${kw}\`'s own points; a longhand is never a KEYWORD_TWINS row.`,
+        );
+    }
