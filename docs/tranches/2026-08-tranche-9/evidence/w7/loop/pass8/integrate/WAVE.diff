+            const universal = !r.selectorText.replace(/::?(before|after|backdrop|marker|placeholder|file-selector-button)|\*|,|\s/g, "");
+            if (live && hit && v && (!universal || imp)) out.push(`${r.selectorText} { ${v}${r.style.getPropertyPriority("padding-bottom") ? " !important" : ""} }`);
+            if ((r as unknown as { cssRules?: CSSRuleList }).cssRules?.length) walk((r as unknown as { cssRules: CSSRuleList }).cssRules, live);
+          } else if ((r as unknown as { cssRules?: CSSRuleList }).cssRules) walk((r as unknown as { cssRules: CSSRuleList }).cssRules, live);
+        }
+      };
+      for (const sh of Array.from(document.styleSheets)) {
+        try {
+          walk(sh.cssRules, true);
+        } catch {
+          out.push(`UNREADABLE ${sh.href}`);
+        }
+      }
+      if (el.style.paddingBottom) out.push(`style="padding-bottom: ${el.style.paddingBottom}"`);
+      return out;
+    });
+  const SERVED_OK = (sites: string[]) =>
+    sites.length > 0 && sites.every((x) => /\{ calc\([^;]*\+\s*env\(safe-area-inset-bottom\)\) \}$/.test(x));
+
+  test("row 28 · behaviour, both engines on the FLAT phone (inset 0 — WebKit has no inset emulation): the served cascade stacks and the lowest ink clears the screen's edge", async ({
+    page,
+    browserName,
+  }) => {
+    await OPEN(page);
+    const served = await SERVED_PAD(page);
+    console.log(`[RULE row 28 served] ${browserName} ${JSON.stringify(served)}`);
+    expect(SERVED_OK(served), `served padding-bottom sites ${JSON.stringify(served)}`).toBe(true);
+    const padB = await page.evaluate(() => getComputedStyle(document.getElementById("card-foot")!).paddingBottom);
+    const ink = await LOWEST_INK(page);
+    const clears = ink === null ? null : +(844 - ink).toFixed(2);
+    console.log(`[RULE row 28 flat] ${browserName} inset 0 pad ${padB} lowest ink ${ink} clears ${clears}`);
+    expect(parseFloat(padB), "no inset: the foot keeps a pad of its own").toBeGreaterThan(0);
+    expect(clears, "the lowest ink clears the screen's edge by ≥ 2 css").toBeGreaterThanOrEqual(2);
+    // NEGATIVE CONTROLS, same page — the served arm reds on each; the paint arm on the ones that move ink.
+    for (const [name, css, paints] of [
+      ["E4 !important max() in a coarse block", "@media (pointer: coarse) { .card-foot { padding-bottom: max(0.15rem, env(safe-area-inset-bottom)) !important; } }", false],
+      ["E3 the compound override", "#card-foot.card-foot { padding-bottom: 0.15rem; }", false],
+      ["a shadowing declaration in one block", ".card-foot { padding-bottom: calc(0.15rem + env(safe-area-inset-bottom)); padding-bottom: 0.15rem; }", false],
+      ["a structural selector", "div:nth-last-child(n)[id='card-foot'] { padding-bottom: 0 !important; }", true],
+      ["an !important universal", "* { padding-bottom: 0 !important; }", true],
+    ] as const) {
+      const tag = await page.addStyleTag({ content: css });
+      await SHEET_SETTLED(page);
+      const s = await SERVED_PAD(page);
+      const low = paints ? await LOWEST_INK(page) : null;
+      console.log(`[RULE row 28 flat] ${browserName} plant ${name}: served ${JSON.stringify(s)}${paints ? ` clears ${low === null ? null : +(844 - low).toFixed(2)}` : ""}`);
+      expect(SERVED_OK(s), `negative control ${name}`).toBe(false);
+      if (paints) expect(low === null ? 0 : 844 - low, `negative control ${name} on paint`).toBeLessThan(2);
+      await tag.evaluate((n) => (n as Element).remove());
+    }
+    // the runtime write no source reader sees
+    await page.evaluate(() => (document.getElementById("card-foot")!.style.paddingBottom = "0px"));
+    const inline = await SERVED_PAD(page);
+    console.log(`[RULE row 28 flat] ${browserName} plant inline write: served ${JSON.stringify(inline)}`);
+    expect(SERVED_OK(inline), "negative control: an inline write").toBe(false);
+  });
+
+  test("row 28 · paint under a real inset (chromium CDP): the lowest ink clears the inset line by ≥ 2 css, and max() reds it", async ({
+    page,
+    browserName,
+  }) => {
+    test.skip(browserName !== "chromium", "the inset override is a chromium CDP method; WebKit's arm is the flat phone above");
+    // THE PAINTED ARM (chromium, DPR 2): under a 34px inset the foot's lowest ink sits ≥ 2 css
+    // above the inset line (innerHeight − 34); with no inset the pad is the foot's own (2.4px here).
+    const cdp = await page.context().newCDPSession(page);
+    const at = async (bottom: number) => {
+      await cdp.send("Emulation.setSafeAreaInsetsOverride" as never, {
+        insets: { top: 0, left: 0, right: 0, bottom },
+      } as never);
+      await OPEN(page);
+      const padB = await page.evaluate(() => getComputedStyle(document.getElementById("card-foot")!).paddingBottom);
+      const ink = await LOWEST_INK(page);
+      return { padB, ink, clears: ink === null ? null : +(844 - bottom - ink).toFixed(2) };
+    };
+    const i34 = await at(34);
+    console.log(`[RULE row 28] inset 34 ${JSON.stringify(i34)}`);
+    expect(i34.clears, `the lowest ink against the inset line ${JSON.stringify(i34)}`).toBeGreaterThanOrEqual(2);
+    // NEGATIVE CONTROL, same page and inset: the pass-6 shape (the inset REPLACES the pad).
+    const tag = await page.addStyleTag({ content: "#card-foot { padding-bottom: max(0.15rem, env(safe-area-inset-bottom)) !important; }" });
+    await SHEET_SETTLED(page);
+    const ink = await LOWEST_INK(page);
+    const red = ink === null ? null : +(844 - 34 - ink).toFixed(2);
+    console.log(`[RULE row 28] inset 34, max() planted: clears ${red}`);
+    expect(red, "negative control: max() gives the band away").toBeLessThan(2);
+    await tag.evaluate((n) => (n as Element).remove());
+    const i0 = await at(0);
+    console.log(`[RULE row 28] inset 0 ${JSON.stringify(i0)}`);
+    expect(parseFloat(i0.padB), "no inset: the foot keeps a pad of its own").toBeGreaterThan(0);
+    expect(parseFloat(i34.padB) - parseFloat(i0.padB), `the inset STACKS on the pad (${i0.padB} → ${i34.padB})`).toBeCloseTo(34, 1);
+    expect(i0.clears).toBeGreaterThanOrEqual(2);
