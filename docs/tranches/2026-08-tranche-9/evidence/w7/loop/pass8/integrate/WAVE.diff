+          root.scrollTop = 0;
+          root.scrollLeft = 0;
+        }, CARD);
+      await top0();
+      const clean = await read();
+      // Where the bar sits IN the card (this page), its `::before` fade rides 17 px up on WebKit's
+      // classic sideways bar; on the §10 fold the bar is the case's foot and the card's own sentinel
