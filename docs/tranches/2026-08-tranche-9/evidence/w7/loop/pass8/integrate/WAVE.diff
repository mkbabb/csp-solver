diff --git a/web/frontend/src/pencil/grid/gridPaths.frame.test.ts b/web/frontend/src/pencil/grid/gridPaths.frame.test.ts
new file mode 100644
index 00000000..e651478a
--- /dev/null
+++ b/web/frontend/src/pencil/grid/gridPaths.frame.test.ts
@@ -0,0 +1,137 @@
+import { describe, expect, it } from "vitest";
+import { BOIL_CONFIG } from "@pencil/config/pencilConfig";
+import {
+  generateFrameTraceFrames,
+  generateGridBoilFrames,
+  generateRectBoilFrames,
+} from "./gridPaths";
+
+/**
+ * T9-W7 §13 pass 8 · THE FRAME IS PAINTED WHOLE, in viewBox units (the chair's geometric assertion,
+ * T9-W7 chair §6.2's FRAME_PAD row). The steady grid is four BAKED poses exactly the 1000-unit box,
+ * so any part of the frame's 12-unit stroke outside [0, 1000] is never painted. Every pose of the
+ * frame ring must hold its stroke inside the box on all four sides to within 2 units: the boil's
+ * wobble puts one vertex of a side up to 1.73 units past the half stroke on HEAD's own sides (inset 12
+ * since T4, unmoved here), and in paint every side reads 0.999–1.016 of the stroke
+ * (`e2e/frame-halfstroke.spec.ts`), so a one-vertex overhang is not a clipped stroke. The ring sits the
+ * same distance in on every side. Born RED at `FRAME_Y_PAD` 0: the top and bottom reach ~11 units
+ * past the box (half of each stroke outside). (A frame whose every vertex holds its whole stroke is
+ * an inset of 14 on all four sides — the sides move 2 units; not taken, the chair's §6.2 row.)
+ */
+const SLACK = 2; // units: the wobble's one-vertex overhang (1.73 on HEAD's sides), never a half stroke
+const VB = 1000;
+const HALF = 12 / 2; // the frame's stroke-width in the grid and in its bake (HandDrawnGrid)
+const points = (d: string): [number, number][] => {
+  const n = (d.match(/-?\d+(?:\.\d+)?(?:e-?\d+)?/g) ?? []).map(Number);
+  const out: [number, number][] = [];
+  for (let i = 0; i + 1 < n.length; i += 2) out.push([n[i], n[i + 1]]);
+  return out;
+};
+const box = (d: string) => {
+  const p = points(d);
+  const xs = p.map((q) => q[0]);
+  const ys = p.map((q) => q[1]);
+  return {
+    x0: Math.min(...xs),
+    x1: Math.max(...xs),
+    y0: Math.min(...ys),
+    y1: Math.max(...ys),
+  };
+};
+
+/** Every clause, as findings (empty = whole): the overhang per side and the insets' agreement. */
+function unclipped(poses: string[]): string[] {
+  const bad: string[] = [];
+  const med = (a: number[]) => [...a].sort((u, v) => u - v)[a.length >> 1];
+  poses.forEach((d, f) => {
+    const b = box(d);
+    const over = {
+      top: HALF - b.y0,
+      bottom: b.y1 + HALF - VB,
+      left: HALF - b.x0,
+      right: b.x1 + HALF - VB,
+    };
+    for (const [side, o] of Object.entries(over))
+      if (o > SLACK)
+        bad.push(
+          `pose ${f}: the ${side} stroke leaves the bake by ${o.toFixed(2)} units`,
+        );
+    // the same inset on every side: each side's median coordinate (its wobble averages out)
+    const p = points(d);
+    const inset = {
+      top: med(p.filter((q) => q[1] < 50).map((q) => q[1])),
+      bottom: VB - med(p.filter((q) => q[1] > VB - 50).map((q) => q[1])),
+      right: VB - med(p.filter((q) => q[0] > VB - 50).map((q) => q[0])),
+    };
+    const left = med(p.filter((q) => q[0] < 50).map((q) => q[0]));
+    for (const [side, v] of Object.entries(inset))
+      if (Math.abs(v - left) >= 2)
+        bad.push(
+          `pose ${f}: the ${side} sits ${v.toFixed(2)} in, the left ${left.toFixed(2)}`,
+        );
+  });
+  return bad;
+}
+
+describe("the board frame lies inside its bake (T9-W7 §13, FRAME_PAD)", () => {
+  for (const [size, sub] of [
+    [4, 2],
+    [6, 3],
+    [9, 3],
+    [16, 4],
+  ] as const)
+    it(`${size}×${size}: every pose's frame stroke is inside [0, ${VB}] on all four sides`, () => {
+      const { frame } = generateGridBoilFrames(
+        size,
+        sub,
+        VB,
+        42,
+        BOIL_CONFIG.frameCount,
+        BOIL_CONFIG.frameBoil,
+        BOIL_CONFIG.subgridBoil,
+        BOIL_CONFIG.cellBoil,
+      );
+      expect(frame.length).toBe(BOIL_CONFIG.frameCount);
+      expect(unclipped(frame)).toEqual([]);
+    });
+  it("THE NEGATIVE: HEAD's ring (top and bottom on the box's edge, FRAME_Y_PAD 0) reds every pose", () => {
+    const head = generateRectBoilFrames(
+      12,
+      0,
+      VB - 24,
+      VB,
+      { roughness: 0.5, segments: 6, seed: 42, jagged: true },
+      BOIL_CONFIG.frameBoil,
+      BOIL_CONFIG.frameCount,
+    );
+    const bad = unclipped(head);
+    for (let f = 0; f < head.length; f++) {
+      expect(bad.some((b) => b.startsWith(`pose ${f}: the top stroke leaves`))).toBe(
+        true,
+      );
+      expect(bad.some((b) => b.startsWith(`pose ${f}: the bottom stroke leaves`))).toBe(
+        true,
+      );
+    }
+  });
+  it("the progress trace shares the frame's rect (registration)", () => {
+    const trace = generateFrameTraceFrames(
+      VB,
+      42,
+      BOIL_CONFIG.frameCount,
+      BOIL_CONFIG.frameBoil,
+    );
+    const { frame } = generateGridBoilFrames(
+      9,
+      3,
+      VB,
+      42,
+      BOIL_CONFIG.frameCount,
+      BOIL_CONFIG.frameBoil,
+    );
+    const a = box(trace[0]);
+    const b = box(frame[0]);
+    expect(Math.abs(a.y0 - b.y0)).toBeLessThan(2);
+    expect(Math.abs(a.x0 - b.x0)).toBeLessThan(2);
+  });
+});
diff --git a/web/frontend/src/pencil/grid/gridPaths.poseFronts.test.ts b/web/frontend/src/pencil/grid/gridPaths.poseFronts.test.ts
new file mode 100644
index 00000000..ac82a388
--- /dev/null
+++ b/web/frontend/src/pencil/grid/gridPaths.poseFronts.test.ts
@@ -0,0 +1,539 @@
+import { describe, it, expect, vi, afterEach } from "vitest";
+import {
+  poseFronts,
+  generateFrameTraceFrames,
+  FRONT_MIN_MS,
+  FRONT_GAP_MS,
+} from "./gridPaths";
+import { MOTION } from "../config/pencilConfig";
+
+/**
+ * THE FRONT'S CONTRACT (T9-W7 §1/§4, the cross-family hand-off).
+ *
+ * `poseFronts` is exported to ACC-SIX, the §10 tally and PLR-COUNT, and it carries a
+ * precondition the pass-3 critique found unstated (§3.7): it parses a pose as ONE polyline.
+ * Handed a multi-subpath pose it would count the JUMPS between subpaths as drawn length and
+ * return a single connected path crossing the board — a wrong shape that looks plausible. The
+ * guard hands such a pose back uncut, and these rows are what make that a contract rather than
+ * a comment. The positive rows cut the estate's own grain-baked ring; the two guard rows use
+ * HAND-WRITTEN poses (a two-subpath string and a `catmullRomToBezier`-shaped curve), because on
+ * this tree no estate generator emits either shape: `generateFrameTraceFrames`' un-grained
+ * branch strips each side's leading `M` into one polyline, and `generateGridBoilFrames`' frame
+ * is an array of closed rects. The hazard is real and its named instances were not.
+ */
+const subpaths = (d: string) => (d.match(/[Mm]/g) ?? []).length;
+const points = (d: string) => (d.match(/-?\d*\.?\d+(?:e[-+]?\d+)?/gi) ?? []).length / 2;
+
+// the board gauge's own ring, grain-baked exactly as HandDrawnGrid bakes it (grain-static)
+const RING = generateFrameTraceFrames(1000, 42, 4, 1.5, {
+  baseFrequency: 0.04,
+  numOctaves: 2,
+  scale: 2.5,
+  seed: 7,
+});
+
+describe("poseFronts — the drawn front, as geometry", () => {
+  it("cuts a single-subpath ring at its own arc-length fraction", () => {
+    expect(subpaths(RING[0])).toBe(1);
+    const half = poseFronts(RING, 0.5);
+    expect(half).toHaveLength(RING.length);
+    // a cut pose is shorter than the whole one, and still one subpath
+    expect(points(half[0])).toBeLessThan(points(RING[0]));
+    expect(points(half[0])).toBeGreaterThan(2);
+    expect(subpaths(half[0])).toBe(1);
+    // and the cut is monotone in the fraction
+    expect(points(poseFronts(RING, 0.25)[0])).toBeLessThan(points(half[0]));
+  });
+
+  it("returns the poses UNCHANGED at f >= 1 and empty at f <= 0", () => {
+    expect(poseFronts(RING, 1)).toBe(RING);
+    expect(poseFronts(RING, 1.7)).toBe(RING);
+    expect(poseFronts(RING, 0)).toEqual(RING.map(() => ""));
+    expect(poseFronts(RING, -0.3)).toEqual(RING.map(() => ""));
+  });
+
+  it("hands a MULTI-SUBPATH pose back uncut rather than joining its subpaths", () => {
+    const multi = "M0,0 L100,0 L100,100 M300,300 L400,300 L400,400";
+    expect(subpaths(multi)).toBe(2);
+    expect(poseFronts([multi], 0.5)[0]).toBe(multi);
+  });
+
+  it("hands a CURVE pose back uncut — control points are not vertices", () => {
+    // the shape `catmullRomToBezier` emits: `wobbleLine`'s non-jagged branch, which every
+    // caller avoids today by passing `jagged: true`. Parsed as a polyline its control points
+    // would be counted as points on the line and both the length and the cut would be wrong.
+    const curved = "M0,0 C10,0 20,10 20,20 C20,30 30,40 40,40";
+    expect(subpaths(curved)).toBe(1);
+    expect(poseFronts([curved], 0.5)[0]).toBe(curved);
+  });
+
+  it("BORN-RED CONTROL: the guard discriminates, it does not refuse everything", () => {
+    // a single linear pose of the same family IS cut — so the two rows above fail the moment
+    // `poseIsLinearSinglePath` stops discriminating and starts returning false for everything.
+    const single = RING[0];
+    expect(subpaths(single)).toBe(1);
+    expect(poseFronts([single], 0.5)[0]).not.toBe(single);
+    expect(poseFronts(["M0,0 L100,0 L100,100"], 0.5)[0]).not.toBe(
+      "M0,0 L100,0 L100,100",
+    );
+  });
+
+  it("memoises on the frames array's identity without changing the answer", () => {
+    const a = poseFronts(RING, 0.37);
+    const b = poseFronts(RING, 0.37);
+    expect(b).toEqual(a);
+    // a fresh array of the same strings is a memo MISS and must still agree
+    expect(poseFronts([...RING], 0.37)).toEqual(a);
+  });
+});
+
+// The gate's clock state is the page's (one `performance.now()`), so every row loads a fresh
+// module and drives its own mocked clock.
+async function freshGate(times: { now: number }) {
+  vi.resetModules();
+  vi.spyOn(performance, "now").mockImplementation(() => times.now);
+  return (await import("./gridPaths")).frontGate;
+}
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.useRealTimers();
+});
+
+describe("frontGate — the front's rate budget (A.6: the end included, on the clock's own grain)", () => {
+  it("the budget is the hand's displacement clause less one millisecond: ≤62.5 re-cuts/s", () => {
+    expect(FRONT_MIN_MS).toBe(MOTION.hand.stepMs - 1);
+    expect(1000 / FRONT_MIN_MS).toBe(62.5);
+  });
+
+  it("a fine clock: a 15 ms gap is swallowed and a 16 ms gap commits", async () => {
+    const t = { now: 0.25 };
+    const frontGate = await freshGate(t);
+    const seen: number[] = [];
+    const gate = frontGate((v) => seen.push(v));
+    for (const now of [0.25, 8.35, 15.25, 16.25, 24.35, 31.2, 32.3]) {
+      t.now = now;
+      gate.write(now);
+    }
+    // 15.25 is 15.0 after 0.25 (swallowed), 16.25 is 16.0 (commits); 31.2 is 14.95 after it
+    expect(seen).toEqual([0.25, 16.25, 32.3]);
+  });
+
+  it("a whole-millisecond WALL clock: a reading of 16 is swallowed (it may be 15.01 ms), 17 commits", async () => {
+    const t = { now: 100 };
+    const frontGate = await freshGate(t);
+    const seen: number[] = [];
+    const gate = frontGate((v) => seen.push(v));
+    for (const now of [100, 108, 116, 117, 125, 133, 134]) {
+      t.now = now;
+      gate.write(now);
+    }
+    expect(seen).toEqual([100, 117, 134]);
+  });
+
+  it("a forced end inside the window is owed, and lands at the window's end, never inside it", async () => {
+    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+    const t = { now: 0.5 };
+    const frontGate = await freshGate(t);
+    const seen: [number, number][] = [];
+    const gate = frontGate((v) => seen.push([v, t.now]));
+    gate.write(0.1); // lands at once: 0.5
+    t.now = 8.6; // a fine clock (8.1 ms later)
+    gate.write(1, true); // the tween's exact end, 8.1 ms after the last commit
+    expect(seen).toEqual([[0.1, 0.5]]);
+    t.now = 16.4;
+    vi.advanceTimersByTime(7.8); // a timer that fires early re-checks the clock and waits
+    expect(seen.length).toBe(1);
+    t.now = 16.5;
+    vi.advanceTimersByTime(1);
+    expect(seen).toEqual([
+      [0.1, 0.5],
+      [1, 16.5],
+    ]);
+    const gaps = seen.slice(1).map(([, at], i) => at - seen[i][1]);
+    expect(Math.min(...gaps)).toBeGreaterThanOrEqual(FRONT_MIN_MS);
+  });
+
+  it("a write while an end is owed replaces it; a re-arm drops it and the window holds across runs", async () => {
+    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+    const t = { now: 0.5 };
+    const frontGate = await freshGate(t);
+    const seen: number[] = [];
+    const gate = frontGate((v) => seen.push(v));
+    gate.write(0.2);
+    t.now = 4.7;
+    gate.write(1, true); // owed
+    t.now = 6.9;
+    gate.write(0, true); // the ring unmounts: the latest value is the truth
+    t.now = 16.6;
+    vi.advanceTimersByTime(20);
+    expect(seen).toEqual([0.2, 0]);
+    t.now = 20.1;
+    gate.write(0.4, true); // owed again (3.5 ms after the last commit)
+    gate.rearm(); // a new run supersedes it
+    vi.advanceTimersByTime(40);
+    expect(seen).toEqual([0.2, 0]);
+    gate.write(0.05); // the new run's first frame, 3.5 ms after the last commit: folded
+    t.now = 24.3;
+    gate.write(0, true); // a restart's forced first write: owed to the window's end
+    expect(seen).toEqual([0.2, 0]);
+    t.now = 32.7;
+    vi.advanceTimersByTime(40);
+    expect(seen).toEqual([0.2, 0, 0]);
+    t.now = 49.8;
+    gate.write(0.3); // 17.1 ms later: the window is clear, it lands at once
+    expect(seen).toEqual([0.2, 0, 0, 0.3]);
+  });
+});
+
+describe("frontGate — a forced write is timed from the landing (pass 7)", () => {
+  it("an owed end waits for the last re-cut to LAND, not for its request", async () => {
+    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+    const t = { now: 0.5 };
+    const frontGate = await freshGate(t);
+    const seen: [number, number][] = [];
+    // the render lands the commit 3.2 ms after the request (the rest of the frame + the flush)
+    const gate = frontGate((v) => {
+      seen.push([v, t.now]);
+      queueMicrotask(() => (t.now += 3.2));
+    });
+    gate.write(0.4); // requested at 0.5, lands at 3.7
+    await Promise.resolve();
+    await Promise.resolve();
+    t.now = 8.6;
+    gate.write(1, true); // the end, owed
+    t.now = 16.6; // 16.1 after the request, 12.9 after the landing: still owed
+    vi.advanceTimersByTime(8);
+    expect(seen.length).toBe(1);
+    t.now = 19.8; // 16.1 after the landing
+    vi.advanceTimersByTime(8);
+    expect(seen.map(([v]) => v)).toEqual([0.4, 1]);
+    // an end with no frame IS its landing: the next frame is timed from there (pass 8 — the
+    // row reads a write outside any frame at the DOM, so a frame 13.0 ms after the landing is a
+    // 13.0 ms gap however long ago the request was)
+    await Promise.resolve();
+    await Promise.resolve();
+    gate.write(0.9, false, 36.0); // a frame 16.2 after the end's request, 13.0 after its landing
+    expect(seen.map(([v]) => v)).toEqual([0.4, 1]);
+    gate.write(0.95, false, 39.0); // 16.0 after the landing, on its slot
+    expect(seen.map(([v]) => v)).toEqual([0.4, 1, 0.95]);
+  });
+});
+
+describe("frontGate — a frame's write is timed on its frame (pass 7)", () => {
+  it("two frames 15.6 ms apart are one re-cut, however far apart their callbacks ran", async () => {
+    const t = { now: 100.2 };
+    const frontGate = await freshGate(t);
+    const seen: number[] = [];
+    const gate = frontGate((v) => seen.push(v));
+    gate.write(0.1, false, 100.0); // frame 100.0, its callback at 100.2
+    t.now = 116.3; // the next callback 16.1 ms later (a fine clock) ...
+    gate.write(0.2, false, 115.6); // ... in a frame 15.6 ms after the last: swallowed
+    t.now = 117.0;
+    gate.write(0.3, false, 116.0); // a frame 16.0 ms after: commits
+    expect(seen).toEqual([0.1, 0.3]);
+  });
+
+  it("a tween's end written inside a frame is timed on that frame, and owed when it is early", async () => {
+    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+    const t = { now: 100.2 };
+    const frontGate = await freshGate(t);
+    const seen: number[] = [];
+    const gate = frontGate((v) => seen.push(v));
+    gate.write(0.5, false, 100.0);
+    t.now = 117.1; // the end's callback runs 16.9 ms after the last one ...
+    gate.write(1, true, 115.5); // ... in a frame 15.5 ms after the last re-cut: owed, not landed
+    expect(seen).toEqual([0.5]);
+    t.now = 118.0;
+    vi.advanceTimersByTime(4);
+    expect(seen).toEqual([0.5, 1]);
+  });
+});
+
+// A frame stream through the gate, one non-forced write per frame on its own rAF stamp; returns
+// the commits' stamps. `quant` rounds each stamp to the whole millisecond (WebKit's grain), and
+// the wall clock reads the same grain, so the gate's detector sees the clock the engine has.
+async function stream(hz: number, n: number, quant: boolean, jitter = 0) {
+  const t = { now: quant ? 1000 : 1000.25 };
+  const frontGate = await freshGate(t);
+  const hits: number[] = [];
+  let cur = 0;
+  const gate = frontGate(() => hits.push(cur));
+  let seed = 7;
+  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647; // deterministic
+  for (let k = 0; k < n; k++) {
+    const ideal = 1000.25 + (k * 1000) / hz + rnd() * jitter; // a pump is never early
+    cur = quant ? Math.floor(ideal) : ideal;
+    t.now = cur + (quant ? 0 : 0.35); // the callback runs a little after its frame
+    gate.write(k / n, false, cur);
+  }
+  const gaps = hits.slice(1).map((x, i) => x - hits[i]);
+  return {
+    hits,
+    perS: ((hits.length - 1) / (hits[hits.length - 1] - hits[0])) * 1000,
+    minGap: Math.min(...gaps),
+  };
+}
+
+describe("frontGate — the cadence at every refresh rate (pass 8: a rate floor, not only a ceiling)", () => {
+  // THE FLOOR (the chair's, registry-v7 §2.7b): every burst ≥ 0.9 × min(panel Hz, 62.5). THE
+  // CEILING: ≤ 62.5/s, the k-th commit never before the first + k·FRONT_MIN_MS. A.6: no two
+  // frames' commits closer than FRONT_GAP_MS. A.6 alone caps a panel at Hz / ⌈15.5 · Hz / 1000⌉
+  // (every k-th frame), and the chair's formula is reachable only where that is ≥ 56.25/s:
+  // Hz ≤ 64.5, 112.5–129, 168.75–193.5, ≥ 225. Between them no gate that honours A.6 meets it —
+  // 75 Hz commits every second frame (13.3 ms < 15.5), 37.5/s; 90 Hz 45.0; 100 Hz 50.0; 144 Hz
+  // every third, 48.0; 165 Hz every third, 55.0 — so those rows' floor is 0.9 × A.6's best and
+  // says so. The contradiction is the chair's to rule (A.6's 15.5 ms or the formula), not a
+  // gate this file re-words: the rows print both numbers.
+  const CHAIR = (hz: number) => 0.9 * Math.min(hz, 1000 / FRONT_MIN_MS);
+  const A6_BEST = (hz: number) =>
+    1000 / (Math.ceil((FRONT_GAP_MS * hz) / 1000) * (1000 / hz));
+  const ceilingHeld = (hits: number[]) =>
+    hits.every((x, k) => x - hits[0] >= k * FRONT_MIN_MS - 1e-9);
+  it.each([
+    ["60 Hz, whole-ms stamps (a Safari panel)", 60, true, CHAIR(60)],
