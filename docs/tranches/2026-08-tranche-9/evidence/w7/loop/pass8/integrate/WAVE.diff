+// Types for the TypeScript specs that import the ONE copy (`postpaint.mjs`, registry-v7 §2.4). A
+// declaration, never a second reader: it names the exports a `.spec.ts` imports today, and a spec that
+// needs another one adds its line here. `typecheck:e2e` is strict, so an untyped `.mjs` import reds it.
+import type { Page } from '@playwright/test';
+
+export type Arm = {
+  red: boolean;
+  f1red: boolean;
+  ciRed: boolean;
+  why: string[];
+  f1: { k: number; ct: number; c: number; dw: number; ps: string | null } | null;
+  ci: { k: number; ct: number; tlDelta: number; off: number }[];
+  frames?: number;
+  dropped: number;
+};
+export type Mover = {
+  kPaint: number;
+  /** the frame the rAF time alone keys (the homes' pass-8 key), and the POST frames read from it */
+  kStamp: number;
+  byStamp: Arm;
+  io: number | 'none' | 'pending';
+  post: Arm;
+  legacy: Arm;
+  inRAF: Arm;
+  rAF2: Arm;
+};
+
+/** Read one mover post-paint: F1 (frame 1 at its rest pose) and CI (the clock identity, k = 2, 3). */
+export function readMover(
+  page: Page,
+  o: { sel: string; key?: string | null; click?: string | null; io?: boolean },
+): Promise<Mover>;
+/** Init-script plants: every explicit startTime write 150 ms early (F1 reds) … */
+export function SKIP_PLANT(): void;
+/** … and frame 1 at rest with the clock jumping 150 ms on the second rAF (CI reds, F1 green). */
+export function F2_PLANT(sel: string): void;
+export function fmtArm(r: Arm): string;
+/** Page-side (an init script or `page.evaluate`): the painted timeline — each rendering update's rAF
+ *  stamp in `window.__pf.rafs`, and a post-paint read of `sel` (`ruled:<sel>` = the drawn fraction
+ *  summed over every match) in `window.__pf.post`. */
+export function installTimeline(sel?: string | null): void;
+
+// ── CTRL-TAPE's sampler (§10, keys-crib G3), folded into §13's declaration at the WAVE union ──
+/** One read of the subject: frame index, the timeline time, the scripted animation's clock, the centre. */
+export interface PPRead {
+  k: number;
+  tl: number;
+  ct: number | null;
+  ps: string | null;
+  x: number;
+  y: number;
+  w: number;
+}
+/** `window.__pp` after `installSampler`: in-rAF, POST-PAINT (a task queued from the frame's rAF)
+ *  and rAF+2 reads, the rAF stamps, and the IntersectionObserver key (null when `io: false`). */
+export interface PP {
+  inRAF: PPRead[];
+  post: PPRead[];
+  rAF2: PPRead[];
+  stamps: number[];
+  io: number | null;
+  done: boolean;
+}
+export function installSampler(o: { sel: string; anyAnim?: boolean; maxFrames?: number; io?: boolean }): void;
+export function kPaintOf(pp: PP): number;
+
+export const analyse: unknown;
+export const samplerSelfTest: unknown;
+export const loadArr: unknown;
+export const startPhotos: unknown;
+export const stat: unknown;
+export const analysePhotos: unknown;
+export const analyseTimeline: unknown;
+export const clockSelfTest: unknown;
+export const record: unknown;
+export const verdict: unknown;
+export const ladder: unknown;
+export const recorderSelfTest: unknown;
