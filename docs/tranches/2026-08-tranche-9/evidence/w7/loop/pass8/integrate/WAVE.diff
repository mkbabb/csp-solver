+function b10PinnedCite({ rungDoc, src }) {
+  const bad = [];
+  for (const p of PINNED) {
+    const f = join(ROOT, p.file);
+    const t = existsSync(f) ? readFileSync(f, "utf8") : "";
+    if (!t) {
+      bad.push(`${p.file} is missing — a PINNED site cannot carry its cite.`);
+      continue;
+    }
+    if (!p.cite.test(t))
+      bad.push(
+        `${p.file}  ${p.what} carries no cite (${p.cite.source}) — a PINNED length says its ruling AT the site.`,
+      );
