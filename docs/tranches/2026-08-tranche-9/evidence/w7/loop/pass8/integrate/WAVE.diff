+  // (the token was re-curved, renamed or orphaned — delete the row with it).
+  for (const r of twins)
+    if (!twinUsed.has(r))
+      bad.push(
+        `KEYWORD_TWINS ${r.token} @ (${r.points}) admits nothing — no shipped transition reads it at those points; STALE.`,
+      );
+  // THE LANE'S OWN ADMISSIONS ARE RATCHETED (pass 8, charter row 7). The four twins no chair
+  // admitted (`chair: null`) are FROZEN by name, and each is held to the number of shipped
+  // transition clauses that read it at this bank (`ceiling`): the UA's taste may shrink, never
+  // spread. A new lane-admitted row, a frozen row that loses its ceiling, or a twin read by one
+  // more clause than its ceiling, reds; the chair's row (`chair: "<ruling>"`) is the only door.
+  if (mon("twin-ratchet"))
+    for (const r of twins) {
+      if (r.chair) continue;
+      if (!LANE_TWINS.has(r.token))
+        bad.push(
+          `KEYWORD_TWINS ${r.token} is a NEW lane-admitted twin (chair: null) — a lane may not admit a keyword by value; the chair's row or none.`,
+        );
