+// Line two's own leave: the third record retires the first from line two, through the eraser.
+// The four adversaries pass 7's critic found beyond the author's own (a layered `!important`, the
+// shorthand with a delay, the rung `!important` on :root, an iteration count) plus the verb
+// switched off (`animation-name: none !important`, a zero-length leave).
+const TWO = '.margin-note-previous.note-previous-leave-active';
+const LINE_TWO_ADVERSARIES: { name: string; css: string; still?: boolean }[] = [
+  { name: 'none', css: '' },
+  {
+    name: '@layer duration + delay !important',
+    css: `@layer adv { ${TWO} { animation-duration: 900ms !important; animation-delay: 300ms !important; } }`,
+  },
+  {
+    name: 'the shorthand with a delay !important',
+    css: `${TWO} { animation: ink-rub-out 900ms linear 200ms !important; }`,
+  },
+  { name: 'the rung !important on :root', css: ':root { --motion-whisper: 900ms !important; }' },
+  { name: 'an iteration count !important', css: `${TWO} { animation-iteration-count: 6 !important; }` },
+  {
+    name: 'animation-name: none !important',
+    css: `${TWO} { animation-name: none !important; }`,
+    still: true,
+  },
+];
+
+/** Pass 6's hook: the transition fenced, the animation axis NOT written (its two longhands dropped). */
+const PASS_SIX_HOOK = `(() => {
+  const set = CSSStyleDeclaration.prototype.setProperty;
+  CSSStyleDeclaration.prototype.setProperty = function (p, v, pr) {
+    if (p === 'animation-duration' || p === 'animation-delay') return;
+    return set.call(this, p, v, pr);
+  };
+})();`;
+
+async function lineTwoLeaves(page: Page, css: string) {
+  await holdDeal(page, 'light', css ? (p) => p.addStyleTag({ content: css }).then(() => undefined) : undefined);
+  await ask(page); // the push: line two = the first record
+  await answer(page);
+  await page.waitForTimeout(MOTION.rungs.note * 2);
+  const first = await lineTwo(page);
+  const done = await watchLeave(page, LINE_TWO_LEAVING);
+  await ask(page); // the second push: the first record leaves line two
+  const leave = await done();
+  await expect.poll(() => lineTwo(page)).not.toBe(first);
+  return leave;
+}
+
+for (const adv of LINE_TWO_ADVERSARIES) {
+  test(`drop clock, line two: the second line rubs out on the rung — ${adv.name}`, async ({
+    page,
