diff --git a/web/frontend/src/pencil/chrome/marginNote.motion.test.ts b/web/frontend/src/pencil/chrome/marginNote.motion.test.ts
new file mode 100644
index 00000000..9b922e09
--- /dev/null
+++ b/web/frontend/src/pencil/chrome/marginNote.motion.test.ts
@@ -0,0 +1,322 @@
+import { describe, it, expect } from "vitest";
+import { mount } from "@vue/test-utils";
+import { nextTick } from "vue";
+import { MOTION, publishMotionRungs } from "@pencil/config/pencilConfig";
+import MarginNote from "./MarginNote.vue";
+// The component's own BYTES (vite's `?raw`), not the compiled component: the assertions below
+// are about what the stylesheet says. `node:fs` is not available here — `src/**` is typechecked
+// by the browser tsconfig, which carries no node types (the trap check-ink-pressure's head names).
+import MARGIN_NOTE_SRC from "./MarginNote.vue?raw";
+
+/**
+ * T9-W7 §7 — THE NOTE'S CLOCKS, ITS RUNGS AND ITS REST POSE, asserted where they are decided.
+ *
+ * What the live surface cannot say for itself:
+ *   G-hold  the refusal's hold is long enough to READ the refusal — derived from the house's
+ *           own constants, not picked. It reds if either end re-times.
+ *   G3      no duration literal in the component, and NO `var(--motion-x, fallback)`. The
+ *           fallback was pass 2's shape and chair §6.5 struck it: a byte-equal fallback makes
+ *           a deleted publisher invisible, which is exactly the failure the born-RED row
+ *           exists to catch. The rungs are registered at `initial-value: 0ms` instead.
+ *   G2/G4   the rest pose and the site PRM arm exist as STATIC text — the live halves are the
+ *           probe's, but a stylesheet that lost either would red here first.
+ */
+
+const STYLE = MARGIN_NOTE_SRC.slice(MARGIN_NOTE_SRC.indexOf("<style"));
+
+describe("the margin note's motion (T9-W7 §7)", () => {
+  it("G-hold: the refusal stands long enough to be read", () => {
+    const words = "that's a given clue".split(/\s+/).length;
+    // write-in, then a settle's worth of notice, then the words at 180 wpm (333 ms/word).
+    const need =
+      MOTION.rungs.note + MOTION.note.settleAfterBeats * MOTION.beatMs + words * 333;
+    const hold = MOTION.note.refusalHoldBeats * MOTION.beatMs;
+    expect(need).toBe(2582);
+    expect(hold).toBeGreaterThanOrEqual(need);
+  });
+
+  it("the ballot's slow end is the same derivation at 90 wpm", () => {
+    const words = "that's a given clue".split(/\s+/).length;
+    const slow =
+      MOTION.rungs.note +
+      2 * MOTION.note.settleAfterBeats * MOTION.beatMs +
+      words * 667;
+    // 4,918 ms → 40 beats on the 8-beat settle grid: the band's far end, derived not picked.
+    expect(Math.ceil(slow / MOTION.beatMs / 8) * 8).toBe(40);
+  });
+
+  it("G3: the verbs read rungs BARE — three of them, and no fallback anywhere", () => {
+    expect(STYLE.match(/var\(--motion-[a-z]+\s*,/g) ?? []).toEqual([]);
+    const bare = [...STYLE.matchAll(/var\(--motion-([a-z]+)\)/g)].map((m) => m[1]);
+    for (const rung of ["note", "whisper", "dusk"]) {
+      expect(bare).toContain(rung);
+      expect(MOTION.rungs[rung as keyof typeof MOTION.rungs]).toBeGreaterThan(0);
+    }
+  });
+
+  it("G3: no duration literal in the component", () => {
+    expect(STYLE.match(/\b\d+(\.\d+)?m?s\b/g) ?? []).toEqual([]);
+  });
+
+  it("G2 (static half): the leave has a REST POSE where its keyframe ends", () => {
+    // `ink-rub-out` has no fill, so the frame it releases is the cascade's. `.note-leave-to` IS
+    // that frame: clipped away from the end of the line, fully transparent.
+    const to = /\.note-leave-to\s*\{([^}]*)\}/.exec(STYLE)?.[1] ?? "";
+    expect(to.replace(/\s+/g, " ")).toContain("clip-path: inset(0 100% 0 0)");
+    expect(to).toContain("opacity: 0");
+  });
+
+  it("G16 (static half): the honest clock is an inline !important on the leaving node", () => {
+    // Vue drops the node on max(transition, animation). Pass 4 fenced it with a (0,4,0) selector
+    // and a declaration at (1,1,0) walked past it; an inline `!important` outranks every author
+    // rule, so the bound is the author origin. The live half is `e2e/affordances.spec.ts`'s
+    // drop-clock row, planted at (1,1,0) `!important`.
+    // Pass 8: the hook rides `@leave`, where the leave's classes are ON the node, and reads the
+    // COMPUTED `animation-name` before it writes a length (LAWS P7 §F). On `@before-leave` the
+    // name read is the resting ink's (`runtime-dom` adds `*-leave-active` after that hook).
+    expect(MARGIN_NOTE_SRC).toContain('@leave="stopTheClock"');
+    expect(MARGIN_NOTE_SRC).not.toMatch(/@before-leave="stopTheClock"/);
+    // ONE declared parameter: a hook that declares `done` takes the clock from Vue.
+    expect(MARGIN_NOTE_SRC).toMatch(/function stopTheClock\(el: Element\): void/);
+    expect(MARGIN_NOTE_SRC).toMatch(/getComputedStyle\(el\)\.animationName/);
+    expect(MARGIN_NOTE_SRC).toContain(
+      'style.setProperty("transition", "none", "important")',
+    );
+    expect(MARGIN_NOTE_SRC).toMatch(/style\.setProperty\(\s*"animation-duration",/);
+    expect(MARGIN_NOTE_SRC).toMatch(
+      /style\.setProperty\(\s*"animation-delay",\s*"0s",\s*"important"\)/,
+    );
+    // No selector-side fence left to lose a specificity fight, and none on the leave class.
+    expect(STYLE).not.toContain(".note-leave-active[data-note-age]");
+    expect(/\.note-leave-active\s*\{[^}]*transition:/.test(STYLE)).toBe(false);
+  });
+
+  /** Mount, replace the line, and return the LEAVING node's inline clock as `value|priority`.
+   *  vitest loads no SFC styles, so `sheet` stands in for the leave class's computed name; jsdom
+   *  cascades the `animation-name` LONGHAND (never the shorthand), so the stand-in is a longhand. */
+  async function leaveClock(sheet: string) {
+    const st = document.createElement("style");
+    st.textContent = sheet;
+    document.head.append(st);
+    try {
+      const w = mount(MarginNote, {
+        props: { text: "one", seq: 1 },
+        global: { stubs: { transition: false } },
+        attachTo: document.body,
+      });
+      await nextTick();
+      const leaving = (w.element as HTMLElement).querySelector(
+        ".margin-note-ink",
+      ) as HTMLElement | null;
+      expect(leaving).not.toBeNull();
+      // Before the leave, the ink carries no inline clock: the write below is the hook's.
+      expect(leaving!.style.getPropertyValue("transition")).toBe("");
+      expect(leaving!.style.getPropertyValue("animation-duration")).toBe("");
+      await w.setProps({ text: "two", seq: 2 });
+      await nextTick();
+      const c = leaving!.style;
+      const read = (p: string) =>
+        `${c.getPropertyValue(p)}|${c.getPropertyPriority(p)}`;
+      const out = {
+        name: getComputedStyle(leaving!).animationName,
+        duration: read("animation-duration"),
+        delay: read("animation-delay"),
+        transition: read("transition"),
+      };
+      w.unmount();
+      return out;
+    } finally {
+      st.remove();
+    }
+  }
+
+  it("G16 (CI half): a rub-out leave carries the rung, no delay, no transition", async () => {
+    // The row above reads the hook's TEXT, so a dead hook with its strings intact
+    // (`if (el) return;` as its first line) stayed 11/11 green, and the drop-clock row that sees
+    // it is a browser row — under O-12 a local instrument, never CI. This is the behaviour on the
+    // CI surface: the real <Transition> (unstubbed) runs the real hook on a real replacement, and
+    // the node that is leaving is read.
+    const clock = await leaveClock(
+      ".note-leave-active { animation-name: ink-rub-out, ink-rub-out-fade; }",
+    );
+    expect(clock.name).toBe("ink-rub-out, ink-rub-out-fade");
+    expect(clock.transition).toBe("none|important");
+    // BOTH AXES (pass 7): the rub-out's own length, written from the rung's one home. An ancestor
+    // `--motion-whisper: 900ms` or an author `animation-duration: … !important` held the node for
+    // 904 ms while the transition fence above stood green (pass-6 critique §1B).
+    expect(clock.duration).toBe(`${MOTION.rungs.whisper}ms|important`);
+    // Vue's fallback clock is delay + duration: the delay is the third longhand of the same fence.
+    expect(clock.delay).toBe("0s|important");
+  });
+
+  it("G16 (CI half): a leave whose COMPUTED animation-name is none is a zero-length leave", async () => {
+    // Pass 8 (LAWS P7 §F). Vue's fallback timer reads the duration and never the name, so the
+    // pass-7 hook's rung on a leave with `animation: none` (the site's PRM arm; the union's
+    // `note-swap`; an author `animation-name: none !important`) held the node 150 ms on an
+    // animation that never runs. The fence is the COMPUTED name, so each of those reads 0s here.
+    for (const sheet of [
+      "",
+      ".note-leave-active { animation-name: none; }",
+      ".note-leave-active { animation-name: none, none; }",
+    ]) {
+      const clock = await leaveClock(sheet);
+      expect(clock.name).toMatch(/^none(, none)?$/);
+      expect(clock.duration).toBe("0s|important");
+      expect(clock.delay).toBe("0s|important");
+      expect(clock.transition).toBe("none|important");
+    }
+  });
+
+  it("G16 (CI half, the union): a PUSH's swap leave is zero-length; line two's rub-out keeps the rung", async () => {
+    // HOLD's default path: a record displaced by the next write leaves line one as `note-swap`
+    // (`animation: none`) while line two takes it. The swap must not hold the node (pass-7
+    // critique §1B: 156.9-165.7 ms, the sentence on both lines for 16-20 frames); line two's own
+    // later leave is a real rub-out and must carry the rung.
+    const st = document.createElement("style");
+    st.textContent =
+      ".note-previous-leave-active { animation-name: ink-rub-out, ink-rub-out-fade; }";
+    document.head.append(st);
+    // jsdom has no WAAPI: the push's FLIP mover is stubbed (its clock is not this row's).
+    const realAnimate = Element.prototype.animate;
+    Element.prototype.animate =
+      (() => ({})) as unknown as typeof Element.prototype.animate;
+    try {
+      const w = mount(MarginNote, {
+        props: { text: "only 5 fits here", seq: 1, kind: "record" },
+        global: { stubs: { transition: false } },
+        attachTo: document.body,
+      });
+      await nextTick();
+      const one = (w.element as HTMLElement).querySelector(
+        ".margin-note-ink",
+      ) as HTMLElement;
+      // The push: line one gives its record to line two in the same write.
+      await w.setProps({
+        text: "only 2 fits here",
+        seq: 2,
+        previous: "only 5 fits here",
+        previousSeq: 1,
+      });
+      await nextTick();
+      const swap = one.style;
+      expect(one.className).toContain("note-swap-leave-active");
+      expect(
+        `${swap.getPropertyValue("animation-duration")}|${swap.getPropertyPriority("animation-duration")}`,
+      ).toBe("0s|important");
+      const two = (w.element as HTMLElement).querySelector(
+        ".margin-note-previous",
+      ) as HTMLElement;
+      // A third record: line two's node leaves through the eraser.
+      await w.setProps({
+        text: "only 7 fits here",
+        seq: 4,
+        previous: "only 2 fits here",
+        previousSeq: 3,
+      });
+      await nextTick();
+      const rub = two.style;
+      expect(two.className).toContain("note-previous-leave-active");
+      expect(
+        `${rub.getPropertyValue("animation-duration")}|${rub.getPropertyPriority("animation-duration")}`,
+      ).toBe(`${MOTION.rungs.whisper}ms|important`);
+      expect(
+        `${rub.getPropertyValue("animation-delay")}|${rub.getPropertyPriority("animation-delay")}`,
+      ).toBe("0s|important");
+      w.unmount();
+    } finally {
+      st.remove();
+      Element.prototype.animate = realAnimate;
+    }
+  });
+
+  it("G4 (static half): PRM is answered at the site, both verbs and the settle", () => {
+    const prm = /@media \(prefers-reduced-motion: reduce\)\s*\{([\s\S]*?)\n\}/.exec(
+      STYLE,
+    )?.[1];
+    expect(prm).toBeTruthy();
+    expect(prm).toContain(".note-enter-active");
+    expect(prm).toContain(".note-leave-active");
+    expect(prm).toContain("animation: none");
+    expect(prm).toContain(".margin-note-ink[data-note-age]");
+  });
+
+  it("G5: THE FOLD CARRIES NO LADDER ROW — the rung MAP is §13's, key and value", () => {
+    // Re-cut twice. Pass 4 asserted a banner STRING (minting `erase: 125` stayed green); pass 5
+    // asserted the key SET, and a SET is blind to every value: retuning `whisper` to 125, `step`
+    // to 1, `rise` to 600, or SWAPPING whisper and dusk (the rub-out on 350 ms, the verb doubled)
+    // all stayed 11/11 green. The claim is the MAP: §13's banked ladder (`MOTION.rungs` in
+    // `pass5/prototype/MOT-VERB/pass5.diff`, lines 7005-7068), every key at its value, nothing
+    // else. §7 may neither mint, drop nor retune a rung. If §13 moves its own map (T9-B11's
+    // `rise`), this constant moves in §13's fold commit with it.
+    const LADDER_13 = {
+      whisper: 150,
+      leave: 200,
+      note: 250,
+      dusk: 350,
+      step: 440,
+      throw: 520,
+      rise: 520,
+    };
+    expect({ ...MOTION.rungs }).toEqual(LADDER_13);
+    // §7's own clocks are waits, not rungs, and they are exactly two.
+    expect(Object.keys(MOTION.note).sort()).toEqual([
+      "refusalHoldBeats",
+      "settleAfterBeats",
+    ]);
+    // §7's stylesheet CONSUMES `--motion-*` and DECLARES none. A declaration is `--motion-x:` at
+    // the head of a value; a consumption is `var(--motion-x)`.
+    expect(STYLE.match(/--motion-[a-z]+\s*:/g) ?? []).toEqual([]);
+    expect((STYLE.match(/var\(--motion-[a-z]+\)/g) ?? []).length).toBeGreaterThan(0);
+  });
+
+  it("G7 (row E): the publisher emits VALUES, never the registration it is guarded by", () => {
+    // The @property law's first clause. Pass 3 emitted both the registration and the values from
+    // `publishMotionRungs()`, so deleting the publisher took the TYPE with it: every rung
+    // computed to the empty string, the `animation` shorthand went invalid, `animation-name` read
+    // `none`, and the born-RED fired as row I — a mode the record never declared. The
+    // registration lives in the first static stylesheet (`assets/index.css`, `initial-value:
+    // 0ms`), so a missing publisher leaves every rung at 0ms: row E, asserted LIVE by the probe
+    // that deletes the node (vitest answers a `*.css?raw` import with the empty string).
+    //
+    // Re-cut at pass 5 to the BEHAVIOUR: run the publisher and read what it emits. The pass-4 row
+    // matched this tree's publisher text and redded on §13's, which builds the same values in a
+    // helper — a row keyed on one site's literal, redding the correct fold.
+    const doc = document.implementation.createHTMLDocument("");
+    publishMotionRungs(doc);
+    const nodes = doc.querySelectorAll("style[data-motion-rungs]");
+    expect(nodes.length).toBe(1);
+    const css = nodes[0].textContent ?? "";
+    // No registration in the emitted text: spelled as a pattern, since a bare literal of the
+    // at-rule in script is what `check-motion-bands` B3 reds as a second home.
+    expect(css).not.toMatch(/@\s*property\b/);
+    for (const [rung, ms] of Object.entries(MOTION.rungs))
+      expect(css).toContain(`--motion-${rung}:${ms}ms`);
+  });
+
+  it("EVERY note carries an age, fresh or settled, never a null", () => {
+    // One selector reads both ages (the site's PRM arm); a null left the fresh line outside it.
+    expect(MARGIN_NOTE_SRC).toContain(`:data-note-age="settled ? 'settled' : 'fresh'"`);
+    expect(MARGIN_NOTE_SRC).not.toContain("settled ? 'settled' : null");
+  });
+
+  it("the strip's reserve is DERIVED from the line it reserves, at every width", () => {
+    // `1.3em` was 1.3 of the BLOCK's inherited 16px while the voice inside sets `--type-body`
+    // (clamped, 18.18px at 1280) on `--type-leading-caption` — so the reserve was right at 390
+    // by coincidence and short by 2.81px wherever the clamp had climbed, and the strip grew the
+    // first time the voice spoke. The floor is the two tokens the voice itself reads.
+    //
+    // Pass 7, THE SEATING IN `lh`: the block carries the voice's line box as its own line-height
+    // and reserves `1lh`, so a seat of n lines is n of the voice's lines (a `2lh` read off
+    // `body`'s 24px came out 6.4px over two voice lines at 390). The voice's own line-height must
+    // be the same two tokens, or `1lh` stops being its line.
+    const block = /\.margin-note-block\s*\{([^}]*)\}/.exec(STYLE)?.[1] ?? "";
+    const flat = block.replace(/\/\*[\s\S]*?\*\//g, "").replace(/\s+/g, " ");
+    expect(flat).toContain(
+      "line-height: calc(var(--type-body) * var(--type-leading-caption))",
+    );
+    expect(flat).toContain("min-height: 1lh");
+    const voice = /\n\.margin-note\s*\{([^}]*)\}/.exec(STYLE)?.[1] ?? "";
+    expect(voice).toContain("font-size: var(--type-body)");
+    expect(voice).toContain("line-height: var(--type-leading-caption)");
+  });
+});
diff --git a/web/frontend/src/pencil/composables/bootHand.test.ts b/web/frontend/src/pencil/composables/bootHand.test.ts
new file mode 100644
index 00000000..63f6e825
--- /dev/null
+++ b/web/frontend/src/pencil/composables/bootHand.test.ts
@@ -0,0 +1,118 @@
+import { describe, expect, it, vi } from "vitest";
+import { MOTION, handStroke } from "@pencil/config/pencilConfig";
+
+// The master subscription is driven by hand: `raw` is the rAF timeline over the span.
+let drive: ((eased: number, raw: number) => void) | null = null;
+vi.mock("@mkbabb/pencil-boil", async (orig) => ({
+  ...(await orig<typeof import("@mkbabb/pencil-boil")>()),
+  createSequenceSubscription: (o: { onProgress: (e: number, r: number) => void }) => {
+    drive = o.onProgress;
+    return { start() {}, stop() {} };
+  },
+}));
+const { enrollStroke, beginRuling, afterRuling } = await import("./bootHand");
+const SPAN = 600_000;
+
+describe("the hand's clock (T9-M20 D1)", () => {
+  it("a healthy frame is never slowed; a stall pauses the hand one step", () => {
+    const seen: number[] = [];
+    enrollStroke((c) => {
+      seen.push(c);
+      return seen.length >= 4;
+    });
+    for (const t of [0, 16, 316, 332]) drive!(0, t / SPAN);
+    // 16 ms passes whole; the 300 ms stall advances one `stepMs`; the next frame is whole again
+    expect(seen).toEqual([0, 16, 16 + MOTION.hand.stepMs, 32 + MOTION.hand.stepMs]);
+  });
+});
+
+/** A fresh clock (the pace is module state), driven through `dts` frame intervals from t = 0;
+ *  returns the hand's clock on every tick. */
+async function drawAt(dts: number[]): Promise<number[]> {
+  vi.resetModules();
+  const m = await import("./bootHand");
+  const seen: number[] = [];
+  m.enrollStroke((c) => {
+    seen.push(c);
+    return seen.length > dts.length;
+  });
+  let t = 0;
+  drive!(0, 0);
+  for (const d of dts) drive!(0, (t += d) / SPAN);
+  return seen;
+}
+const frames = (ms: number, n: number) => Array.from({ length: n }, () => ms);
