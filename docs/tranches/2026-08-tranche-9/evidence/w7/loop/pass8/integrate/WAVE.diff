+    const done = await watchLeave(page, LINE_ONE_LEAVING);
+    await ask(page);
+    const leave = await done();
+    // The push happened: line two holds the displaced record, line one the new hint.
+    await expect.poll(() => lineTwo(page)).toBe(held);
+    expect(await lineOne(page)).not.toBe(held);
+    expect(leave.animationName).toBe('none');
+    expect(leave.animationDuration).toBe('0s');
+    expect(leave.ms).toBeLessThan(MOTION.rungs.whisper);
+    // Every frame the old node is painted, line two already paints its sentence: these ARE the
+    // both-line frames.
+    expect(leave.painted).toBeLessThanOrEqual(2);
+    console.log(`swap ${scheme}: ${leave.ms} ms, ${leave.painted} painted frames`);
+  });
+}
