+          `KEYWORD_TWINS ${r.token} carries no \`ceiling\` — a lane's admission is ratcheted by its reads.`,
+        );
+      else if ((twinReads.get(r) ?? 0) > r.ceiling)
+        bad.push(
+          `KEYWORD_TWINS ${r.token} is read by ${twinReads.get(r)} shipped transition clauses, above its ceiling ${r.ceiling} — a lane-admitted keyword SPREAD.`,
+        );
+    }
+  return bad;
+}
