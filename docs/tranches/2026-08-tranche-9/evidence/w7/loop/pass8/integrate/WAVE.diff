diff --git a/web/frontend/src/assets/index.css b/web/frontend/src/assets/index.css
index 9b5b405c..cd5e787c 100644
--- a/web/frontend/src/assets/index.css
+++ b/web/frontend/src/assets/index.css
@@ -1,8 +1,21 @@
 @import "tailwindcss";
 @import "./typography.css";
+/* The gates are not markup. Tailwind mints a utility from any word in any scanned file, and
+   the motion gates' own negative controls spell `duration-300` and `ease-in-out` — which shipped
+   as dead rules in the product's CSS until this line (MOT-LADDER pass 5, the bundle row). */
+@source not "../../scripts";
 
 @custom-variant dark (&:is(.dark *));
 
+/* THE ZONE'S ONE STEP (T9-W7 · M17): the controls card's section air (tape → first name, the
+   rule's air, the air above the commit), four `0.85rem` literals in `GameControlPanel.vue` and a
+   missing fifth before it. Declared once here; REGISTERED in §10's one `@property` block below
+   (initial `0px`: an unset step collapses the zone's air and the rhythm row reds). Consumers read
+   it bare. */
+:root {
+  --zone-step: 0.85rem;
+}
+
 /* ── P5 (Tranche II) — self-hosted subset faces ────────────────────────────
  * Replaces the Google Fonts CDN `<link>` (index.html) + its `fonts.googleapis.com`/
  * `fonts.gstatic.com` CSP clauses (see public/_headers). Each woff2 is
@@ -21,7 +34,7 @@
