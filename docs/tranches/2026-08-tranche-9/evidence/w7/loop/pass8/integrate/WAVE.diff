+              `${d.rel}  var(${name}) — no stylesheet declares it, so the UA's \`ease\` decides.  ${q.clause}`,
+            );
+          for (const v of vals) {
+            if (UA_KEYWORD.test(v)) {
+              bad.push(
+                `${d.rel}  var(${name}) resolves to \`${v}\` — a UA keyword by another name (the spelling cure, un-cured).  ${q.clause}`,
+              );
+              continue;
+            }
+            const pts = pointsOf(v);
+            const kw = Object.keys(UA_POINTS).find((k) => UA_POINTS[k] === pts);
+            if (!kw) continue;
+            const row = twins.find((r) => r.token === name && r.points === pts);
+            if (row) {
+              twinUsed.add(row);
+              twinReads.set(row, (twinReads.get(row) ?? 0) + 1);
+            } else
+              bad.push(
+                `${d.rel}  var(${name}) = ${v} — \`${kw}\`'s own points under a house name, and no KEYWORD_TWINS row admits it by value.  ${q.clause}`,
+              );
+          }
+        }
+        continue;
+      }
+      if ((q.curve !== "bare" && q.curve !== "none") || seen.has(q.clause)) continue;
+      seen.add(q.clause);
+      bad.push(
+        q.curve === "bare"
+          ? `${d.rel}  a bare UA keyword on a transition.  ${q.clause}`
