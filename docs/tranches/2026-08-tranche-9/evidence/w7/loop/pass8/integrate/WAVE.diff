+const LINE_ONE_LEAVING = '.margin-note .margin-note-ink[class*="leave-active"]';
+const LINE_TWO_LEAVING = '.margin-note-previous[class*="leave-active"]';
+
+for (const scheme of ['light', 'dark'] as const) {
+  test(`drop clock, the SWAP: a pushed record's old line leaves in a frame or two — ${scheme}`, async ({
+    page,
+  }) => {
+    await holdDeal(page, scheme);
