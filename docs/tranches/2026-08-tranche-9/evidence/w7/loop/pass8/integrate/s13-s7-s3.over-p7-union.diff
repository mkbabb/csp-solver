+    INFO_X5_opacity_04: `${edge} { opacity: 0.4 !important; }`, // a sensitivity row (SELF's X5): printed, not required
+  };
+};
+/** The previous ink replayed through the three channels M18's token clause missed (RULE): each must RED
+ *  a B5 read whose `above` is that previous ink's reading. */
