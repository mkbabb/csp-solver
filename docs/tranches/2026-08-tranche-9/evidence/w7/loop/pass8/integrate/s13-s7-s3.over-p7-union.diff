+// Types for the TypeScript specs that import the ONE copy (`paint-lib.mjs`, registry-v7 §2.4). A
+// declaration, never a second reader: it names the exports a `.spec.ts` imports today, and a spec that
+// needs another one adds its line here. `typecheck:e2e` is strict, so an untyped `.mjs` import reds it.
+import type { Page } from '@playwright/test';
+
+export type Rgb = { data: Uint8Array; w: number; h: number };
+export type Clip = { x: number; y: number; width: number; height: number };
+
+/** The gamma-encoded grey of a pixel (0–255) at byte offset `i` of packed RGB. */
+export function grey(d: Uint8Array, i: number): number;
+export function median(a: number[]): number;
+export function quantile(a: number[], f: number): number;
+/** Two rendering updates. */
+export function settle(page: Page): Promise<void>;
+/** Photograph `clip` (device scale) as is and with `offCss` injected; both decoded to packed RGB. */
+export function onOff(page: Page, clip: Clip, offCss: string): Promise<{ on: Rgb; off: Rgb }>;
