diff --git a/web/frontend/e2e/tally-flash.spec.ts b/web/frontend/e2e/tally-flash.spec.ts
new file mode 100644
index 00000000..51367278
--- /dev/null
+++ b/web/frontend/e2e/tally-flash.spec.ts
@@ -0,0 +1,87 @@
+// PRM: live, because the subject IS the draw-in: under reduced motion the tally snaps inked and
+// there is no first frame to read.
+import { test, expect } from "@playwright/test";
+import { installTimeline } from "./lib/postpaint.mjs";
+
+/**
+ * THE TALLY NEVER PAINTS A NEW TIER WHOLE BEFORE IT DRAWS IN (T9-W7 ACC-FIVE pass 8; registry-v7
+ * §2.7c; LAWS P7 §F "a consumer that moved its first write out of the inking flush reads
+ * post-paint for a whole-then-empty frame").
+ *
+ * Pass 7 dropped the tally's forced start write and let the frame after the grade write it. The
+ * new tier's strokes took their `inked` class in the render the grade landed in, still at the
+ * reveal the last draw-in left them (whole), and drew in from empty one or two frames later: 4
+ * of 11 tier-changing inks flashed whole on that tree against 0 of 7 on the control (pass-7
+ * critique §1.4). The cure writes the start in the inking flush through the gate and commits the
+ * ink WITH the reveal, so a start the budget owes keeps the last committed tally until it lands.
+ *
+ * THE READ is the chair's painted timeline (`installTimeline`, `len:` subject): after every rAF a
+ * task reads the inked strokes' count and their summed DRAWN length (geometry, or a dash's drawn
+ * fraction on a tree that still dashes). An ink's first frame L is the first read at the settled
+ * count with ≤ 30 % of the settled length; a FLASH is any read before L at the settled count with
+ * ≥ 90 % of it, on an act that changed the count. Acts: fresh loads (HARD / EASY alternating) and
+ * in-app re-deals, until ≥ 10 tier-changing inks have been read or 40 acts have run.
+ *
+ * BORN-RED: pass 7's tally (no start write, the class from the props) flashes; a run that reads
+ * fewer than 10 tier-changing inks reds on the count, so an empty run cannot pass.
+ */
+const MIN_INKS = 10;
+const MAX_ACTS = 40;
+const TALLY = ".difficulty-tally .dt-stroke.inked";
+
+type Read = { k: number; t: number; r: { x: number; y: number } | null };
+
+test("the tally's new strokes never paint whole before they draw in", async ({ browser }, testInfo) => {
+  test.setTimeout(600000);
+  const ctx = await browser.newContext({ viewport: { width: 1280, height: 800 }, reducedMotion: "no-preference" });
+  await ctx.addInitScript(installTimeline, `len:${TALLY}`);
+  const page = await ctx.newPage();
+  const drain = () =>
+    page.evaluate(() => {
+      const w = window as unknown as { __pf: { post: Read[] } };
+      const r = w.__pf.post;
+      w.__pf.post = [];
+      return r;
+    });
+  const count = () => page.evaluate((s) => document.querySelectorAll(s).length, TALLY);
+  const judge = (reads: Read[], n0: number) => {
+    const s = reads.filter((x) => x.r).map((x) => ({ n: x.r!.y, len: x.r!.x, t: x.t }));
+    const settled = s[s.length - 1];
+    const full = settled?.len ?? 0;
+    const nF = settled?.n ?? 0;
+    const L = s.findIndex((x) => x.n === nF && nF > 0 && full > 0 && x.len / full <= 0.3);
+    let flash = 0;
+    if (L > 0 && nF !== n0) for (let k = 0; k < L; k++) if (s[k].n === nF && s[k].len / full >= 0.9) flash++;
+    return { n0, nF, inked: L >= 0, changed: L >= 0 && nF !== n0, flash };
+  };
+  const rows: ReturnType<typeof judge>[] = [];
+  const log = (act: string, r: ReturnType<typeof judge>) => {
+    rows.push(r);
+    console.log(`TALLY-FLASH ${testInfo.project.name} ${act} ${JSON.stringify(r)}`);
+  };
+  for (let i = 0; rows.length < MAX_ACTS && rows.filter((r) => r.changed).length < MIN_INKS; i++) {
+    const diff = i % 2 ? "EASY" : "HARD";
+    await page.goto(`/?size=3&difficulty=${diff}`);
+    await page.waitForSelector(".sudoku-cell", { timeout: 60000 });
+    await page
+      .waitForFunction(() => !document.querySelector(".difficulty-tally")?.classList.contains("is-ungraded"), null, { timeout: 60000 })
+      .catch(() => {});
+    await page.waitForTimeout(2500);
+    log(`load ${diff}`, judge(await drain(), 0));
+    for (let d = 0; d < 2; d++) {
+      const n0 = await count();
+      await drain();
+      await page.locator('button[aria-label="Deal a new board"]').first().click();
+      await page.waitForTimeout(4000);
+      log(`re-deal ${diff}`, judge(await drain(), n0));
+    }
+  }
+  const inks = rows.filter((r) => r.changed);
+  const flashes = inks.filter((r) => r.flash > 0);
+  const line = `${flashes.length} of ${inks.length} tier-changing inks flash whole (${rows.filter((r) => r.inked).length} inks over ${rows.length} acts)`;
+  console.log(`TALLY-FLASH ${testInfo.project.name} SUMMARY ${line}`);
+  testInfo.annotations.push({ type: "tally-flash", description: line });
+  expect(inks.length, `only ${inks.length} tier-changing inks were read: the row saw too little to pass`).toBeGreaterThanOrEqual(MIN_INKS);
+  expect(flashes.length, line).toBe(0);
+  await ctx.close();
+});
diff --git a/web/frontend/e2e/wash-step.spec.ts b/web/frontend/e2e/wash-step.spec.ts
new file mode 100644
index 00000000..71d9352d
--- /dev/null
+++ b/web/frontend/e2e/wash-step.spec.ts
@@ -0,0 +1,113 @@
+import { test, expect } from "@playwright/test";
+// @ts-expect-error — the ONE paint library is an .mjs home with no declaration (registry-v7 §2.4)
+import { onOff, lum, ratio } from "./lib/paint-lib.mjs";
+
+// PRM: frozen — emulateMedia({reducedMotion:'reduce'}) before goto. The row reads one painted ground at rest.
+
+/**
+ * T9-W7 ACC-SIX pass 8 · THE WASH, READ AS PAINTED (the behavioural row beside `check-theme-tokens`'
+ * wash reach; LAWS P7 §F (iii): every source law pairs with a paint read on the real surface).
+ *
+ * `.cell-peer` — the selected cell's row / column / box reach — paints ONE ground token whose arm
+ * the const in index.css names. The row selects an empty cell on a real 9x9 deal (`?board=`, 30
+ * givens), photographs the inner 40 % of an empty PEER cell with its wash and with the wash layer
+ * hidden (the SAME pixels, one variable), and reads the step between them (WCAG ratio of the mean
+ * luminances). The step is the wash: it must not fall under HEAD's own painted step (1.078 light /
+ * 1.104 dark, the critic's reading of `74a2b5d9`), less 0.006 for the photograph.
+ *
+ * IN-RUN PLANTS (each must RED, the negative in the same run): W1 the consumer faded
+ * (`.cell-peer { opacity: .2 }`: 1.017-1.026 on GRAPHITE's tree) and W5 an `@property`
+ * re-registration of the token with `initial-value: transparent` (1.000: the consumer never
+ * inherits the const). A source gate reads neither in paint; this row reads both.
+ */
+
+const FLOOR = { light: 1.072, dark: 1.098 };
+const PLANTS = {
+  W1: ".cell-peer { opacity: 0.2 !important; }",
+  W5: "@property --ground-wash-unit { syntax: '<color>'; inherits: false; initial-value: transparent; }",
+};
+
+// A REAL 9x9 payload: a valid solved grid by the band pattern, 30 givens seeded.
+const SOL9 = Array.from({ length: 81 }, (_, i) => {
+  const r = Math.floor(i / 9);
+  return ((3 * (r % 3) + Math.floor(r / 3) + (i % 9)) % 9) + 1;
+});
+const KEEP9 = new Set([0, 4, 8, 10, 13, 16, 20, 22, 24, 27, 31, 35, 37, 39, 41, 43, 45, 49, 53, 56, 58, 60, 64, 67, 70, 72, 76, 80, 2, 78]);
+const PUZ9 = SOL9.map((v, i) => (KEEP9.has(i) ? String(v) : "0")).join("");
+const BOARD9 =
+  "?board=" +
+  btoa(String.fromCharCode(1) + "3." + PUZ9)
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+
+type Page = import("@playwright/test").Page;
+type Px = { data: Uint8Array; w: number; h: number };
+/** The wash's step on ONE clip: mean luminance with the layer vs the same pixels without it. */
+async function step(page: Page, clip: { x: number; y: number; width: number; height: number }) {
+  const { on, off } = (await onOff(page, clip, ".cell-peer { display: none !important; }")) as { on: Px; off: Px };
+  const mean = (p: Px) => {
+    const n = p.w * p.h;
+    let s = 0;
+    for (let k = 0; k < n; k++) s += lum(p.data, k * 3);
+    return s / n;
+  };
+  return +ratio(mean(on), mean(off)).toFixed(3);
+}
+
+for (const scheme of ["light", "dark"] as const) {
+  test(`the wash paints its step over the card, and the plants that fade it red · ${scheme}`, async ({ browser }) => {
+    test.setTimeout(90000);
+    const ctx = await browser.newContext({
+      viewport: { width: 1280, height: 800 },
+      deviceScaleFactor: 1,
+      colorScheme: scheme,
+    });
+    const page = await ctx.newPage();
+    await page.emulateMedia({ reducedMotion: "reduce" });
+    await page.goto("/" + BOARD9);
+    await page.waitForSelector("svg.hand-drawn-grid", { timeout: 60000 });
+    await page.evaluate(() => document.fonts.ready);
+    const empty = await page.evaluate(() =>
+      Array.from(document.querySelectorAll(".game-cell input")).map(
+        (i) => !/given/i.test(i.getAttribute("aria-label") ?? "") && !(i as HTMLInputElement).value,
+      ),
+    );
+    const pick = [40, 30, 50, 21].find((i) => empty[i]);
+    expect(pick, "an empty cell to select").not.toBeUndefined();
+    await page.locator(".game-cell").nth(pick!).click();
+    await page.waitForTimeout(400);
+    const peers = await page.evaluate(() =>
+      Array.from(document.querySelectorAll(".game-cell")).map((c) => !!c.querySelector(".cell-peer")),
+    );
+    const r0 = Math.floor(pick! / 9);
+    const peer = [...Array(81).keys()].find((i) => i !== pick && peers[i] && empty[i] && Math.floor(i / 9) === r0);
+    expect(peer, "an empty peer cell in the selected row").not.toBeUndefined();
+    const b = (await page.locator(".game-cell").nth(peer!).boundingBox())!;
+    const clip = {
+      x: Math.round(b.x + b.width * 0.3),
+      y: Math.round(b.y + b.height * 0.3),
+      width: Math.max(2, Math.round(b.width * 0.4)),
+      height: Math.max(2, Math.round(b.height * 0.4)),
+    };
+    const clean = await step(page, clip);
+    const planted: Record<string, number> = {};
+    for (const [k, css] of Object.entries(PLANTS)) {
+      const tag = await page.addStyleTag({ content: css });
+      await page.waitForTimeout(100);
+      planted[k] = await step(page, clip);
+      await tag.evaluate((e) => (e as Element).remove());
+    }
+    const computed = await page.evaluate(
+      (i) => getComputedStyle(document.querySelectorAll(".game-cell")[i].querySelector(".cell-peer")!).backgroundColor,
+      peer!,
+    );
+    console.log(
+      `WASH ${scheme}: cell ${pick} peer ${peer} step ${clean} (floor ${FLOOR[scheme]}) · W1 ${planted.W1} · W5 ${planted.W5} · computed ${computed}`,
+    );
+    await ctx.close();
+    expect.soft(clean, "the wash's painted step clears HEAD's").toBeGreaterThanOrEqual(FLOOR[scheme]);
+    for (const [k, v] of Object.entries(planted))
+      expect.soft(v, `plant ${k} must read under the floor (the row can fail)`).toBeLessThan(FLOOR[scheme]);
+  });
+}
