+        if (r.post.red) red = 1;
+        console.log(`POSTPAINT ${engine} ${cell.name} r${rep} plant=${plant || "none"} io ${r.io} kPaint ${r.kPaint} | POST ${fmtArm(r.post)} | LEGACY ${fmtArm(r.legacy)} | inRAF ${fmtArm(r.inRAF)} | rAF2 ${fmtArm(r.rAF2)} → ${r.post.red ? "RED " + r.post.why.join("; ") : "GREEN"}`);
