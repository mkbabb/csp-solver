+    at = null;
+  const intervals = [];
+  for (let i = 1; i < rafs.length; i++) {
+    const g = rafs[i].e - rafs[i - 1].e;
+    intervals.push([rafs[i - 1].e, rafs[i].e]);
+    if (g > maxGap) {
+      maxGap = g;
+      at = rafs[i - 1].e;
+    }
+  }
+  return { rafs: rafs.length, gapMs: stat(gaps), maxGapMs: +maxGap.toFixed(1), at, intervals };
