+import { test, expect, type Browser } from '@playwright/test';
+import { loadavg } from 'node:os';
+import { installTimeline } from './lib/postpaint.mjs';
+
+// PRM: live, because the subject is the boot's draw-in: under reduce the grid stands whole from the
+// first frame and the wave is a same-frame cut, so there is no ruling to time.
+
+/**
+ * T9-M20 · THE BOOT'S ONE HAND, read on the painted timeline (T9-W7 §13 pass 8, MOT-VERB charter
+ * rows 2–3; INTAKE-23 rows 1 and 8). The page is drawn by one hand: the grid's lines on the hand's
+ * clock (`bootHand.enrollStroke`), and the deal's wave held off the page until the last lift
+ * (`afterRuling`). Two clauses, both engines, each at the panel's native rate AND under a 60 Hz and a
+ * 30 Hz display (a rAF shim that runs callbacks only on every second or fourth native frame):
+ *   W  THE WAVE WAITS: the first given digit starts to ink no earlier than the frame on which the
+ *      ruling reaches 95 % (less one frame's interval). Born RED on `74a2b5d9` (digits at 352–479 ms,
+ *      ruled 95 % at 557–579 ms, pass 7) and under the bypass plant (a build whose `afterRuling`
+ *      returns null).
+ *   R  THE HAND IS A RATE: at 60 and 30 Hz the ruling takes no more than 1.2× its time at the native
+ *      rate in the same run (LAWS P7 §F: a rate keyed on the OBSERVED interval, never a per-frame
+ *      constant). Pass 7's clock capped each frame at 17 ms, so a 30 Hz panel read as a stall on every
+ *      frame and ruled at half speed: that build is R's plant.
+ *   S  NOTHING BAKES UNDER THE HAND (`stacksResident`): no pose bake lands (a blob URL minted, which is
+ *      how every raster stack hands its encode over) between the first stroke and the ruling's 95 %,
+ *      and the wait's ceiling never fired (`data-hand-ceiling` absent). Born RED on `74a2b5d9` (its
+ *      four grid encodes land inside its ruling) and under the plant whose `stacksResident` resolves at
+ *      once. W's second plant empties `holdRuling`, so the ruling never holds the wave.
+ * The ruling is the home's `ruled:` subject (the drawn fraction summed over every transition-layer
+ * line, read post-paint per frame); the wave's onset is the first mutation that draws a given digit's
+ * stroke past 5 %. The deal is random (a restore's wave is not the boot's): the row reads timing,
+ * never the givens. Box load printed per line (LAWS P6 §B).
+ */
+const RULED = 'ruled:svg.hand-drawn-grid > g:not(.boil-frame-layer) > path.grid-line';
+const RATES = [
+  { name: 'native', hz: 0 },
+  { name: '60 Hz', hz: 60 },
+  { name: '30 Hz', hz: 30 },
+] as const;
+
+/** Init script: the display at `hz` — rAF callbacks run only on the native frames at least one
+ *  period apart, with that frame's own timestamp. 0 leaves the panel alone. */
+function displayAt(hz: number): void {
+  if (!hz) return;
+  const period = 1000 / hz;
+  const native = window.requestAnimationFrame.bind(window);
+  let queue: [number, FrameRequestCallback][] = [];
+  const live = new Set<number>();
+  let last = -Infinity;
+  let pumping = false;
+  let id = 0;
+  const pump = (ts: number) => {
+    if (ts - last >= period - 2) {
+      last = ts;
+      const run = queue;
+      queue = [];
+      for (const [i, cb] of run) if (live.delete(i)) cb(ts);
+    }
+    if (queue.length) native(pump);
+    else pumping = false;
+  };
+  window.requestAnimationFrame = (cb: FrameRequestCallback) => {
+    const i = ++id;
+    live.add(i);
+    queue.push([i, cb]);
+    if (!pumping) {
+      pumping = true;
+      native(pump);
+    }
+    return i;
+  };
+  window.cancelAnimationFrame = (i: number) => {
+    live.delete(i);
+  };
+}
+
+/** Init script: every pose bake's landing — a raster stack mints one blob URL per encode. */
+function watchBakes(): void {
+  const w = window as unknown as { __bakes: number[] };
+  w.__bakes = [];
+  const mint = URL.createObjectURL.bind(URL);
+  URL.createObjectURL = (o: Blob | MediaSource) => {
+    w.__bakes.push(performance.now());
+    return mint(o);
+  };
+}
+
+/** Init script: the wave's onset — the first time a given digit's stroke is drawn past 5 %. */
+function watchWave(): void {
+  const w = window as unknown as { __wave: number | null };
+  w.__wave = null;
+  new MutationObserver((ms) => {
+    if (w.__wave !== null) return;
+    for (const m of ms) {
+      const el = m.target as SVGPathElement;
+      if (!el.closest?.('.glyph-svg')) continue;
+      const d = parseFloat(el.style.strokeDasharray);
+      const o = parseFloat(el.style.strokeDashoffset);
+      if (d > 0 && o < d * 0.95) {
+        w.__wave = performance.now();
+        return;
+      }
+    }
+  }).observe(document, { subtree: true, attributes: true, attributeFilter: ['style'] });
+}
+
+type Boot = {
+  interval: number;
+  t0: number;
+  t95: number;
+  ruling: number;
+  wave: number | null;
+  worstStep: number;
+  worstRate: number;
+  held: number;
+  /** pose bakes that landed between the first stroke and the ruling's 95 %, and in all */
+  bakesIn: number;
+  bakes: number;
+  ceiling: string | null;
+};
+
+async function boot(browser: Browser, hz: number): Promise<Boot> {
+  const ctx = await browser.newContext({
+    viewport: { width: 1280, height: 800 },
+    reducedMotion: 'no-preference',
+  });
+  await ctx.addInitScript(displayAt, hz);
+  await ctx.addInitScript(watchWave);
+  await ctx.addInitScript(watchBakes);
+  await ctx.addInitScript(installTimeline, RULED);
+  const page = await ctx.newPage();
+  await page.goto('/?game=sudoku');
+  await expect(page.locator('.boil-frame-bitmap')).toHaveCount(4, { timeout: 30000 });
+  await expect
+    .poll(() => page.evaluate(() => (window as unknown as { __wave: number | null }).__wave), { timeout: 15000 })
+    .not.toBeNull();
