+    const st = await clockSelfTest(browser, engine);
+    const clock = engine === "chromium" ? st.photosPerSec : st.rafPerSec;
+    console.log(`${engine} RECORDER clock photos/s ${st.photosPerSec} rAF/s ${st.rafPerSec} clock ${clock} ${clock >= 55 ? "OK" : "BELOW 55"}`);
