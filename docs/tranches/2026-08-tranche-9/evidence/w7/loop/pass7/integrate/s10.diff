+  // 7 · THE REGIME
+  const norm = (q) =>
+    q
+      .replace(/^@media\s+/, "")
+      .replace(/\s+/g, " ")
+      .trim();
+  const regimeTs = t.read(path.join(ROOT, REGIME_TS));
+  const ref = (name) =>
+    norm(
+      new RegExp(`const ${name} = mediaRef\\(\\s*"([^"]+)"`).exec(regimeTs)?.[1] ?? "",
+    );
+  const flank = ref("landscapeFlank");
+  const berthQ = ref("noteBerth");
+  const padCtx = (test) => [
+    ...new Set(
+      rules
+        .filter(
+          (r) =>
+            subjectIs(r.prelude, FOOT) &&
+            r.decls.some((d) => bottomOf(d) !== null) &&
+            test(r.ctx),
+        )
+        .map((r) => norm(r.ctx)),
+    ),
+  ];
+  const landPad = padCtx((c) => /orientation:\s*landscape/.test(c));
+  const berthPad = padCtx((c) => /hover:\s*hover/.test(c));
+  if (!flank || landPad.length !== 1 || landPad[0] !== flank)
+    fails.push(
+      `7 THE REGIME: the foot's landscape pad keys on ${JSON.stringify(landPad)}, the flank on "${flank}"`,
+    );
+  if (!berthQ || berthPad.length !== 1 || berthPad[0] !== berthQ)
+    fails.push(
+      `7 THE REGIME: the note berth's pad keys on ${JSON.stringify(berthPad)}, its mount on "${berthQ}"`,
+    );
+  const tabCtx = [
+    ...new Set(
+      rules
+        .filter((r) => r.file === TAB && /orientation:\s*landscape/.test(r.ctx))
+        .flatMap((r) => r.ctx.split(/,\s*(?![^()]*\))/))
+        .map(norm)
+        .filter((q) => /orientation:\s*landscape/.test(q)),
+    ),
+  ];
+  if (tabCtx.some((q) => q !== flank))
+    fails.push(
+      `7 THE REGIME: the tongue's flank keys on ${JSON.stringify(tabCtx)}, not "${flank}"`,
+    );
+  for (const f of t.files) {
+    const r = t.rel(f);
+    if (
+      r === REGIME_TS ||
+      !/\.(vue|ts)$/.test(r) ||
+      /\.test\.ts$/.test(r) ||
+      !r.startsWith("src/games/shared")
+    )
+      continue;
+    // a component's setup mints one listener PER MOUNT; a module elsewhere may keep its own
+    // singletons, but never a second copy of the foot's regimes (landscape, hover)
+    const text = t.read(f);
+    const perMount =
+      r.endsWith(".vue") &&
+      /\b(?:mediaRef|useMediaQuery|matchMedia)\(\s*(?:[^"'`\s]|["'`][^"'`]*(?:orientation|hover|pointer|width))/.test(
+        text,
+      );
+    const restated =
+      /\b(?:mediaRef|useMediaQuery|matchMedia)\(\s*["'`][^"'`]*(?:orientation:\s*landscape|hover)/.test(
+        text,
+      );
+    if (perMount || restated)
+      fails.push(
+        `7 THE REGIME: ${r} mints its own media query (one MediaQueryList per regime lives in useCoarsePointer.ts)`,
+      );
+  }
+  return fails;
+}
