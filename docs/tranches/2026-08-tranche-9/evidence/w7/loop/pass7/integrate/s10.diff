+/* ══ 9b · THE CASE-WIDE GATE SAMPLES THE CASE'S SCROLL POSES (pass 6, the critic's row) ═══════
+   The rest-only gate above stayed green over W2 §2.5's one live red on this section: at 1440×900
+   the pinned `new game` tape parked 12 px below the paper band over three staged chips at the
+   scroll END, a pose no rest reading visits — and the control carries the same class at
+   mid-scroll poses W2's own row never samples. So the case is walked: every 5 px from the top
+   to the end (and the end itself), two frames after each move so the fold's rAF pass has run,
+   and at each pose every tape's box is intersected with every control in the card, less the
+   paper band the card's fold chrome paints while `data-fold-above` stands (W2's chair ruling,
+   the same subtraction §2.5 makes). A tape is flagged STUCK when its top did not move while the
+   content moved (an in-transit tape is not pinned — TAPE's STUCK predicate); both kinds count,
+   because a control under paper is covered however the paper got there. */
+test.describe("the case-wide occlusion gate, walked", () => {
+  for (const [label, use] of [
+    ["1440×900 fine", { viewport: { width: 1440, height: 900 } }],
+    ["390×844 coarse", coarse(390, 844)],
+  ] as const) {
+    test.describe(label, () => {
+      test.use(use);
+      test("no tape covers a control at ANY scroll pose, top to end", async ({ page }) => {
+        await loadCard(page, M17_PAYLOAD);
+        const POSE = ({ card, sel }: { card: string; sel: string }) => {
+          const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length) as HTMLElement;
+          const cr = root.getBoundingClientRect();
+          const band = root.hasAttribute("data-fold-above")
+            ? cr.top + root.clientTop + parseFloat(getComputedStyle(root).paddingTop)
+            : -Infinity;
+          const controls = [...root.querySelectorAll(sel)].filter((e) => e.getClientRects().length);
+          const tapes = [...root.querySelectorAll(".washi-tag")].filter((t) => {
+            const cs = getComputedStyle(t);
+            return cs.display !== "none" && cs.visibility !== "hidden" && +cs.opacity >= 0.05;
+          });
+          const hits: { tape: string; control: string; px: number; top: number }[] = [];
+          const tops: number[] = [];
+          for (const t of tapes) {
+            const r = t.getBoundingClientRect();
+            tops.push(r.top);
+            for (const c of controls) {
+              if (c.contains(t)) continue;
+              const b = c.getBoundingClientRect();
+              const w = Math.min(b.right, r.right) - Math.max(b.left, r.left);
+              const h = Math.min(b.bottom, r.bottom) - Math.max(b.top, r.top, band, cr.top);
+              if (w > 0 && h > 0 && w * h > 0.5)
+                hits.push({
+                  tape: (t.textContent ?? "").trim(),
+                  control: (c.getAttribute("aria-label") || c.textContent || "").trim().slice(0, 20),
+                  px: Math.round(w * h * 10) / 10,
+                  top: r.top,
+                });
+            }
+          }
+          return { st: root.scrollTop, max: root.scrollHeight - root.clientHeight, hits, tops };
+        };
+        const walk = async (extraCss?: string) => {
+          const h = extraCss ? await page.addStyleTag({ content: extraCss }) : null;
+          const max = await page.evaluate((card) => {
+            const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length) as HTMLElement;
+            return root.scrollHeight - root.clientHeight;
+          }, CARD);
+          const poses = [...new Set([...Array(Math.floor(max / 5) + 1).keys()].map((k) => k * 5).concat(max))];
+          const out: { st: number; hits: { tape: string; control: string; px: number; stuck: boolean }[] }[] = [];
+          let prev: number[] | null = null;
+          for (const st of poses) {
+            await page.evaluate(
+              ({ card, st }) => {
+                const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length) as HTMLElement;
+                root.scrollTop = st;
+                return new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
+              },
+              { card: CARD, st },
+            );
+            const p = await page.evaluate(POSE, { card: CARD, sel: 'button, [role="button"], input, select, a[href]' });
+            out.push({
+              st: p.st,
+              hits: p.hits.map((x) => ({
+                tape: x.tape,
+                control: x.control,
+                px: x.px,
+                stuck: !!prev && prev.some((t) => Math.abs(t - x.top) < 0.5),
+              })),
+            });
+            prev = p.tops;
+          }
+          if (h) await h.evaluate((n) => (n as unknown as HTMLElement).remove());
+          return { max, poses: out };
+        };
+        const clean = await walk();
+        const red = clean.poses.filter((p) => p.hits.length);
+        const worst = red.flatMap((p) => p.hits.map((x) => ({ st: p.st, ...x }))).sort((a, b) => b.px - a.px)[0];
+        test.info().annotations.push({
+          type: "occlusion-walk",
+          description:
+            `${clean.poses.length} poses (range ${clean.max}) → ${red.length} with a covered control` +
+            (worst ? `; worst ${worst.px}px² "${worst.tape}" over "${worst.control}" at st ${worst.st}${worst.stuck ? " (STUCK)" : ""}` : ""),
+        });
+        expect(clean.poses.length, "the walk visits the top, the end and every 5 px between").toBeGreaterThanOrEqual(
+          Math.floor(clean.max / 5) + 1,
+        );
+        expect(
+          red.map((p) => `st ${p.st}: ${p.hits.map((x) => `"${x.tape}" over "${x.control}" ${x.px}px²${x.stuck ? " STUCK" : ""}`).join(", ")}`),
+          "no tape covers a control at any pose",
+        ).toEqual([]);
+        // BORN-RED in the same run: the paper band struck back to 6 px (shallower than any tape the
+        // card lays — the dock utility's own padding, and 14 px under the rail's). A deeper TAPE
+        // is no plant here: the publisher re-reads the tape's box and the band follows it, which is
+        // the cure working (a 16 px deeper tape read 0 of 31 poses covered on the dist).
+        // §10 INTEGRATION: ONE PIN LINE. The band is `--pin-band` (the card's padding-top AND the
+        // pinned tag's offset read the same token); striking the padding alone no longer moves the
+        // pin, so the plant strikes the band itself.
+        const planted = await walk(".controls-card { --pin-band: 6px !important }");
+        const pr = planted.poses.filter((p) => p.hits.length).length;
+        test.info().annotations.push({ type: "occlusion-walk-plant", description: `band struck to 6px → ${pr} of ${planted.poses.length} poses covered` });
+        expect(pr, "the walk's plant (the band struck to 6 px) reds it").toBeGreaterThan(0);
+      });
+    });
+  }
+});
+
+/* ══ 10 · THE TAP FLOOR IS THE BINDING CONSTRAINT, AND THIS IS ITS HEADROOM ════════════════ */
+
+test.describe("the chip's tap box", () => {
+  test.use(coarse(390, 844));
+
+  test("44px is the FLOOR doing the work, and the row says how much is left", async ({ page }) => {
+    await loadCard(page);
+    const read = await page.evaluate((card) => {
+      const px = (n: number) => Math.round(n * 100) / 100;
+      const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!;
+      return [...root.querySelectorAll(".tray-well .ctrl-btn")]
+        .filter((b) => (b as HTMLElement).getClientRects().length)
+        .map((b) => {
+          const s = getComputedStyle(b);
+          const r = b.getBoundingClientRect();
+          const w = b.querySelector(".ctrl-word") as HTMLElement | null;
+          const ws = w ? getComputedStyle(w) : null;
+          const wr = w ? w.getBoundingClientRect() : null;
+          // THE INTRINSIC BOX: what the chip would be if the floor were not there — the word's
+          // own advance plus everything the chip adds around it.
+          const padX = parseFloat(s.paddingLeft) + parseFloat(s.paddingRight);
+          const padY = parseFloat(s.paddingTop) + parseFloat(s.paddingBottom);
+          const wordW = wr && ws ? wr.width - parseFloat(ws.paddingLeft) - parseFloat(ws.paddingRight) : 0;
+          const lh = ws ? parseFloat(ws.lineHeight) : 0;
+          return {
+            text: (b.textContent ?? "").trim(),
+            w: px(r.width),
+            h: px(r.height),
+            intrinsicW: px(wordW + padX),
+            intrinsicH: px(lh + padY),
+            rung: ws ? px(parseFloat(ws.fontSize)) : null,
+            tracking: ws ? ws.letterSpacing : null,
+          };
+        });
+    }, CARD);
+
+    const floor = 44;
+    // THE FLOOR GOVERNS THE CHIPS THAT SIT ON IT, NOT ALL OF THEM. The first form of this row
+    // took the WIDEST intrinsic ("Normal", 75.56) and asserted it under 44, which reds on a card
+    // with nothing wrong with it: a six-letter chip is wider than the floor by design and the
+    // floor never set its width. The chips the floor governs are the ones whose used box IS the
+    // floor (44.00 at every coarse cell — the critic's row 12), and the number that matters is
+    // the LARGEST intrinsic among those: the next rung or tracking change spends that headroom
+    // first, and when it goes the chip rows start setting the card's height instead of the floor.
+    const atFloorW = read.filter((c) => Math.abs(c.w - floor) <= 0.5);
+    const atFloorH = read.filter((c) => Math.abs(c.h - floor) <= 0.5);
+    const worstW = (atFloorW.length ? atFloorW : read).reduce((a, b) =>
+      b.intrinsicW > a.intrinsicW ? b : a,
+    );
+    const worstH = (atFloorH.length ? atFloorH : read).reduce((a, b) =>
+      b.intrinsicH > a.intrinsicH ? b : a,
+    );
+    const headW = Math.round((floor - worstW.intrinsicW) * 100) / 100;
+    const headH = Math.round((floor - worstH.intrinsicH) * 100) / 100;
+
+    test.info().annotations.push({
+      type: "tap-floor-headroom",
+      description:
+        `${read.length} chips · box min ${Math.min(...read.map((c) => c.w))}×${Math.min(...read.map((c) => c.h))} · ` +
+        `rung ${read[0].rung} tracking ${read[0].tracking} · ` +
+        `${atFloorW.length} chips AT the width floor, ${atFloorH.length} at the height floor · ` +
+        `worst at-floor W "${worstW.text}" ${worstW.intrinsicW} (headroom ${headW}) · ` +
+        `worst at-floor H "${worstH.text}" ${worstH.intrinsicH} (headroom ${headH}) · ` +
+        `widest chip overall ${Math.max(...read.map((c) => c.w))}`,
+    });
+
+    // (a) the floor holds — W2's landed token, not this family's.
+    for (const c of read) {
+      expect(c.w, `"${c.text}" meets the 44px tap floor across`).toBeGreaterThanOrEqual(floor - 0.5);
+      expect(c.h, `"${c.text}" meets the 44px tap floor down`).toBeGreaterThanOrEqual(floor - 0.5);
+    }
+    // (b) AND THE FLOOR IS STILL WHAT SETS THOSE BOXES. The pass-3 reading was 44.00×44.00 at
+    // every coarse cell — exactly at the floor, down from HEAD's 48.02–60.02 across — so every
+    // pixel of slack this card had is spent. The numbers below are what is left before the WORD
+    // sets a chip that the floor is currently setting; when they go, the chip rows start setting
+    // the card's height instead. They red on the next rung or tracking change, which is the row
+    // the critic asked for.
+    expect(
+      worstH.intrinsicH,
+      `the tap floor still sets the chip's height: "${worstH.text}" needs ${worstH.intrinsicH}, floor ${floor}, headroom ${headH}`,
+    ).toBeLessThanOrEqual(floor);
+    expect(
+      worstW.intrinsicW,
+      `the tap floor still sets the narrow chips' width: "${worstW.text}" needs ${worstW.intrinsicW}, floor ${floor}, headroom ${headW}`,
+    ).toBeLessThanOrEqual(floor);
+  });
+});
