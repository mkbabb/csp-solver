+/**
+ * `face-stamp` (T9-W7 CTRL-FACE pass 7) — THE BUILD RECORDS WHAT IT WAS BUILT FROM, BY CONTENT.
+ * `scripts/check-face-engine-identity.mjs` bound a dist census to its build by MTIME, and a file
+ * restored with `cp -p` (new bytes, the old mtime) walked past it (the pass-6 critic's plant). The
+ * build hashes the gate's own `STAMP_FILES` (parsed from the gate, so the list is spelled once) and
+ * writes `{ js, stamp }` beside the census, OUTSIDE `dist/` — nothing ships. The gate compares the
+ * served js AND the content digest; a dist whose sidecar names another js, or none, is not this tree.
+ */
+function faceStamp(): Plugin {
+  return {
+    name: 'face-stamp',
+    apply: 'build',
+    writeBundle(_opts, bundle) {
+      const gate = readFileSync(resolve(__dirname, 'scripts/check-face-engine-identity.mjs'), 'utf8')
+      const list = /const STAMP_FILES = \[([\s\S]*?)\];/.exec(gate)
+      if (!list) return this.error('face-stamp: STAMP_FILES not found in the gate')
+      const h = createHash('sha1')
+      for (const rel of [...list[1].matchAll(/"([^"]+)"/g)].map((m) => m[1]))
+        h.update(`${rel}\n${readFileSync(resolve(__dirname, rel), 'utf8')}\n`)
+      const js = Object.keys(bundle).find((k) => /^assets\/index-[^/]+\.js$/.test(k))
+      const dir = resolve(__dirname, '.face-engine')
+      if (!existsSync(dir)) mkdirSync(dir, { recursive: true })
+      writeFileSync(join(dir, 'dist-stamp.json'), JSON.stringify({ js: js ? `/${js}` : null, stamp: h.digest('hex') }))
+    },
+  }
+}
