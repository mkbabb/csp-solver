+import { test, expect, type Page } from "@playwright/test";
+
+// PRM: live, because the owner's T9-M16 defect IS the fold's 200 ms transition: under reduce the old scroll landed and the crib showed
+//
+/**
+ * T9-W7 CTRL-FACE pass 5 — T9-M16, "the 'i' button clicking does not properly scroll the panel".
+ *
+ * THE DEFECT (census `intake-owner-2026-09-22/census/info`, 24/24 desk cells): `toggleKeys()`
+ * issued `scrollIntoView` against the 0 px `#keys-fold` BEFORE its `0fr → 1fr` fold, so the panel
+ * scrolled to a box about to grow and the crib opened UNDER the sticky bar. Under reduced motion
+ * the fold is instant and the old scroll landed, which is why this file runs at full motion.
+ *
+ * THE CURE ON THIS TREE (G-INFO's adjudicated strip): the crib is the bar's first row, directly
+ * above the verbs and the `i`; the press issues no scroll; the verbs never move; the published
+ * `--action-bar-h` grows the scroll range so nothing is parked under the strip.
+ *
+ * THE ROWS (G-INFO gates, re-cut by its critic):
+ *   G1 · SHOWN is a HIT-TEST, not a self-referenced raster ratio: `elementFromPoint` at the centre
+ *        of every `kbd`/`dd` lands inside the legend (the critic's H1 — a crib uniformly under an
+ *        overlay would still read 1.0 against itself 350 ms later).
+ *   G2 · the panel's scrollTop does not move and the press makes 0 `scrollIntoView` calls.
+ *   G3 · the verbs and the `i` hold still on every frame of the open AND the close.
+ *   G5 · with the crib open, focusing every control in the card body parks none of them under the
+ *        strip; the NEGATIVE CONTROL pins the published strip height to its closed value and the
+ *        same walk must park at least one.
+ * Both engines, 1280×800 and 1024×768 fine, from the top and from the end of the panel.
+ */
+
+const CARD = ".controls-card";
+// §10 INTEGRATION: the strip is the case's FOOT (`#card-foot`, CTRL-TAPE's berth), a sibling of the
+// card inside `.drawer-case` — so every read of the bar, the crib and the verbs addresses the CASE,
+// and the card is still the scrollport the press must not move.
+const CASE = ".drawer-case";
+
+async function load(page: Page, w: number, h: number) {
+  await page.setViewportSize({ width: w, height: h });
+  await page.goto("./?size=3&difficulty=EASY");
+  await page.waitForSelector("svg.handwritten-logo", { timeout: 20000 });
+  await page.addStyleTag({ content: ".tuner-toggle { display: none !important; }" });
+  await expect(page.locator(`${CASE} .action-bar .info-btn`).first()).toBeVisible({ timeout: 20000 });
+}
+
+/**
+ * THE PRESS IS A MOUSE CLICK AT THE BUTTON'S OWN CENTRE, never `locator.click()`: Playwright
+ * scrolls its target into view before clicking, and for a target inside a STICKY bar that means
+ * scrolling the panel to the bar's static position — the end. The first run of this file read
+ * "scrollTop 0 → 185" on a tree whose press scrolls nothing (0 `scrollIntoView` calls in the same
+ * run); the instrument, not the product, moved the panel.
+ */
+async function press(page: Page) {
+  const b = await page.evaluate((card) => {
+    const c = [...document.querySelectorAll(card)].find((x) => x.getClientRects().length)!;
+    const r = c.closest(".drawer-case")!.querySelector(".action-bar .info-btn")!.getBoundingClientRect();
+    return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
+  }, CARD);
+  await page.mouse.click(b.x, b.y);
+  await page.mouse.move(2, 2);
+}
+
+/** Sample the verbs' boxes on every frame for `ms`, starting now; resolve with the max drift.
+ *  PASS 7 (CTRL-TAPE; LAWS P6 §D) · READ POST-PAINT. The gated read is a MessageChannel task
+ *  queued from each frame's rAF, which runs after that frame's rendering update (its
+ *  ResizeObservers and layout included) — what the frame painted. The in-rAF read of the same
+ *  frame is kept beside it as `inRaf`, printed and never gated: it reads pre-callback state (the
+ *  §10 integrator read 5.9–30.8 px there against 0.016 px painted). */
+function sampleVerbs(page: Page, ms: number) {
+  return page.evaluate((ms) => {
+    const bar = [...document.querySelectorAll(".action-bar")].find((b) => b.getClientRects().length)!;
+    const verbs = [...bar.querySelectorAll<HTMLElement>(".action-verbs > .icon-btn, .action-bar > .info-btn")].filter(
+      (e) => e.getClientRects().length,
+    );
+    const at0 = verbs.map((e) => e.getBoundingClientRect());
+    const off = () =>
+      verbs.reduce((m, e, k) => {
+        const b = e.getBoundingClientRect();
+        return Math.max(m, Math.abs(b.left - at0[k].left), Math.abs(b.top - at0[k].top));
+      }, 0);
+    return new Promise<{ drift: number; inRaf: number; frames: number }>((res) => {
+      let drift = 0;
+      let inRaf = 0;
+      let frames = 0;
+      const t0 = performance.now();
+      const tick = () => {
+        frames++;
+        drift = Math.max(drift, off());
+        if (performance.now() - t0 < ms) requestAnimationFrame(frame);
+        else res({ drift: Math.round(drift * 100) / 100, inRaf: Math.round(inRaf * 100) / 100, frames });
+      };
+      // pass 7 · POST-PAINT (LAWS P6 §D): an in-rAF read runs before the frame's ResizeObserver
+      // republishes the case's numbers, and on the merged page it read 5.9–30.8 px of drift the
+      // screen never showed (0.016 px painted). The read is a task queued FROM the frame's rAF.
+      const frame = () => {
+        inRaf = Math.max(inRaf, off()); // the in-rAF read: printed beside the gate, never gated
+        const ch = new MessageChannel();
+        ch.port1.onmessage = tick;
+        ch.port2.postMessage(0);
+      };
+      requestAnimationFrame(frame);
+    });
+  }, ms);
+}
+
+for (const [w, h] of [
+  [1280, 800],
+  [1024, 768],
+] as const) {
+  for (const start of ["top", "end"] as const) {
+    test(`the crib opens where it was asked for — ${w}×${h} fine, from the ${start}`, async ({ page }) => {
+      await load(page, w, h);
+      const pre = await page.evaluate(
+        ({ card, start }) => {
+          const c = [...document.querySelectorAll<HTMLElement>(card)].find((x) => x.getClientRects().length)!;
+          if (start === "end") c.scrollTop = c.scrollHeight;
+          (window as unknown as { __siv: number }).__siv = 0;
+          const orig = Element.prototype.scrollIntoView;
+          Element.prototype.scrollIntoView = function (this: Element, o?: boolean | ScrollIntoViewOptions) {
+            (window as unknown as { __siv: number }).__siv++;
+            return orig.call(this, o);
+          };
+          return {
+            st: c.scrollTop,
+            spb: getComputedStyle(c).scrollPaddingBottom,
+            barH: `${document.getElementById("card-foot")?.getBoundingClientRect().height ?? 0}px`, // §10 pass 7: the foot's own box (no length publishes it)
+          };
+        },
+        { card: CARD, start },
+      );
+      await page.waitForTimeout(400); // the end scroll settles; the sticky bar is re-read after it
+
+      // ── OPEN ─────────────────────────────────────────────────────────────────────────────
+      const drifting = sampleVerbs(page, 700);
+      await press(page);
+      const openDrift = await drifting;
+      const open = await page.evaluate((card) => {
+        const c = [...document.querySelectorAll<HTMLElement>(card)].find((x) => x.getClientRects().length)!;
+        const legend = c.closest(".drawer-case")!.querySelector("#keys-fold .keyboard-legend")!;
+        const verbs = c.closest(".drawer-case")!.querySelector(".action-verbs")!.getBoundingClientRect();
+        const dl = legend.getBoundingClientRect();
+        const targets = [...legend.querySelectorAll("kbd, dd")];
+        let hit = 0;
+        for (const t of targets) {
+          const r = t.getBoundingClientRect();
+          const e = document.elementFromPoint(r.left + r.width / 2, r.top + r.height / 2);
+          if (e && legend.contains(e)) hit++;
+        }
+        return {
+          st: c.scrollTop,
+          siv: (window as unknown as { __siv: number }).__siv,
+          hit,
+          of: targets.length,
+          dlAboveVerbs: Math.round((verbs.top - dl.bottom) * 100) / 100,
+          barH: `${document.getElementById("card-foot")?.getBoundingClientRect().height ?? 0}px`,
+          spb: getComputedStyle(c).scrollPaddingBottom,
+        };
+      }, CARD);
+
+      // ── CLOSE ────────────────────────────────────────────────────────────────────────────
+      const stBeforeClose = await page.evaluate(
+        (card) => [...document.querySelectorAll<HTMLElement>(card)].find((x) => x.getClientRects().length)!.scrollTop,
+        CARD,
+      );
+      const closing = sampleVerbs(page, 700);
+      await press(page);
+      const closeDrift = await closing;
+      const closed = await page.evaluate(
+        (card) => [...document.querySelectorAll<HTMLElement>(card)].find((x) => x.getClientRects().length)!.scrollTop,
+        CARD,
+      );
+
+      // re-open for the reachability walk (the walk itself scrolls the panel, so it runs last)
+      await press(page);
+      await page.waitForTimeout(400);
+
+      // ── G5 · every control in the body, focused with the crib open ───────────────────────
+      const parkWalk = () =>
+        page.evaluate(async (card) => {
+          const c = [...document.querySelectorAll<HTMLElement>(card)].find((x) => x.getClientRects().length)!;
+          const bar = c.closest(".drawer-case")!.querySelector(".action-bar")!;
+          const body = [...c.querySelectorAll<HTMLElement>("button, [href], input, [tabindex]")].filter(
+            (e) => !bar.contains(e) && e.getClientRects().length && !(e as HTMLButtonElement).disabled,
+          );
+          let parked = 0;
+          for (const e of body) {
+            e.focus();
+            await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
+            const a = e.getBoundingClientRect();
+            const b = bar.getBoundingClientRect();
+            if (a.bottom > b.top + 0.5 && a.top < b.bottom) parked++;
+          }
+          (document.activeElement as HTMLElement)?.blur();
+          return { parked, of: body.length };
+        }, CARD);
+      const walk = await parkWalk();
+      const blinded = await page.evaluate(
+        ({ card, closedH }) => {
+          const c = [...document.querySelectorAll<HTMLElement>(card)].find((x) => x.getClientRects().length)!;
+          const s = document.createElement("style");
+          s.id = "blind-publisher";
+          // §10 INTEGRATION: the foot is outside the scrollport, so no published height can park a
+          // control under it and the old plant (the closed `--action-bar-h` pinned over the open
+          // one, value ${closedH}) moves nothing. The plant is the failure's own shape instead: the
+          // foot lifted over the card's bottom edge by its own height — a strip that overlaps the
+          // body again — and the same walk must park a control under it.
+          void closedH;
+          s.textContent = `#card-foot { translate: 0 -100% !important; }`;
+          document.head.appendChild(s);
+          return getComputedStyle(c).scrollPaddingBottom;
+        },
+        { card: CARD, closedH: pre.barH },
+      );
+      const walkBlind = await parkWalk();
+      await page.evaluate(() => document.getElementById("blind-publisher")?.remove());
+
+      // G3's NEGATIVE CONTROL, same run: the crib allowed to GROW THE CASE (the case uncapped, so
+      // the card no longer gives the foot its height). The post-paint read must see the verbs ride.
+      await press(page);
+      await page.waitForTimeout(400);
+      await page.evaluate(() => {
+        const s = document.createElement("style");
+        s.id = "grow-the-case";
+        s.textContent = ".drawer-case { max-height: none !important; }";
+        document.head.appendChild(s);
+      });
+      await page.waitForTimeout(100);
+      const growing = sampleVerbs(page, 700);
+      await press(page);
+      const grown = await growing;
+      await page.evaluate(() => document.getElementById("grow-the-case")?.remove());
+
+      test.info().annotations.push({
+        type: "crib",
+        description:
+          `G1 hit ${open.hit}/${open.of}, dl ${open.dlAboveVerbs}px above the verbs · G2 scrollTop ${pre.st}→${open.st}, ` +
+          `scrollIntoView ×${open.siv} · G3 drift (post-paint) open ${openDrift.drift}px/${openDrift.frames}f, close ${closeDrift.drift}px/${closeDrift.frames}f ` +
+            `[in-rAF, not gated: ${openDrift.inRaf} / ${closeDrift.inRaf}] · plant (the crib grows the case) ${grown.drift}px, ` +
+          `close scrollTop ${stBeforeClose}→${closed} · G5 parked ${walk.parked}/${walk.of} (spb ${open.spb}, bar-h ${open.barH}); ` +
+          `publisher blinded (spb ${blinded}) → ${walkBlind.parked}/${walkBlind.of}`,
+      });
+
+      expect(open.hit, "G1: every key and its meaning is the topmost thing at its own centre").toBe(open.of);
+      expect(open.of, "G1: the crib has rows to hit").toBeGreaterThan(0);
+      expect(open.dlAboveVerbs, "G1: the crib ends above the verbs").toBeGreaterThanOrEqual(0);
+      expect(Math.abs(open.st - pre.st), "G2: the panel does not scroll").toBeLessThanOrEqual(0.5);
+      expect(open.siv, "G2: the press makes no scrollIntoView call").toBe(0);
+      expect(openDrift.drift, "G3: the verbs hold still while the crib opens").toBeLessThanOrEqual(0.5);
+      expect(closeDrift.drift, "G3: and while it closes").toBeLessThanOrEqual(0.5);
+      expect(Math.abs(closed - stBeforeClose), "G3: closing does not scroll either").toBeLessThanOrEqual(0.5);
+      expect(walk.parked, "G5: no control is parked under the open strip").toBe(0);
+      expect(walkBlind.parked, "G5's negative control: the foot lifted over the card parks a control under it").toBeGreaterThan(0);
+      expect(grown.drift, "G3's negative control: a crib that grows the case moves the verbs").toBeGreaterThan(0.5);
+    });
+  }
+}
+
+/**
+ * pass 7 · THE PARK HAS AN EXIT (LAWS P6 §D; the pass-6 critic's `park-stuck` row, the chair's
+ * `rest-probes.mjs --preset unpark`). The strip's publisher parks through the crib's 200 ms rung
+ * and the rung's `transitionend` un-parks it. Two presses in ONE task net to no change: no rung
+ * runs, no event comes, and pass 6 stayed parked for the page's life (the root font moved and the
+ * published numbers did not: 121 vs 132 px, both engines). The cure un-parks one frame later when
+ * the fold carries no animation. The PLANT gives the fold a rung that never ends (its
+ * `getAnimations()` is never empty), which is the pass-6 behaviour, and the same read must go stale.
+ * The subject is `--pin-tape-h` (the pin line's quantity, published by the parked publisher on
+ * both this page and the §10 fold's), read against the tapes' own painted boxes.
+ */
+for (const arm of ["cure", "PLANT: a rung that never ends"] as const) {
+  test(`two presses in one task, then the root font moves: the strip's numbers follow — ${arm}`, async ({
+    page,
+  }) => {
+    await load(page, 1280, 800);
+    const rest = () =>
+      page.waitForFunction(
+        () =>
+          new Promise<boolean>((r) =>
+            requestAnimationFrame(() =>
+              requestAnimationFrame(() =>
+                r(!document.getAnimations().some((a) => a.playState === "running" || a.pending)),
+              ),
+            ),
+          ),
+        null,
+        { timeout: 6000, polling: 100 },
+      );
+    const read = () =>
+      page.evaluate((card) => {
+        const c = [...document.querySelectorAll<HTMLElement>(card)].find((x) => x.getClientRects().length)!;
+        let truth = 0;
+        for (const t of c.querySelectorAll<HTMLElement>(".washi-tag"))
+          truth = Math.max(truth, Math.ceil(t.getBoundingClientRect().height));
+        return { published: c.style.getPropertyValue("--pin-tape-h"), truth: `${truth}px` };
+      }, CARD);
+    await rest();
+    const before = await read();
+    await page.evaluate((plant) => {
+      if (plant) {
+        const f = document.querySelector<HTMLElement>("#keys-fold")!;
+        f.getAnimations = () => [{} as Animation];
+      }
+      const b = [...document.querySelectorAll<HTMLButtonElement>(".action-bar .info-btn")].find((x) =>
+        x.getClientRects().length,
+      )!;
+      b.click();
+      b.click();
+    }, arm !== "cure");
+    await rest();
+    await page.evaluate(() => (document.documentElement.style.fontSize = "18px"));
+    await rest();
+    await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => setTimeout(r, 0))));
+    const after = await read();
+    test.info().annotations.push({
+      type: "unpark",
+      description: `${arm}: before ${before.published} (truth ${before.truth}) · two presses, root 18px → ${after.published} (truth ${after.truth})`,
+    });
+    expect(before.published, "published at load").toBe(before.truth);
+    expect(after.truth, "the perturbation moves the truth (or the row cannot tell stale from fresh)").not.toBe(
+      before.truth,
+    );
+    if (arm === "cure") expect(after.published, "the strip's number follows the page").toBe(after.truth);
+    else expect(after.published, "the plant: parked for good, the number is stale").toBe(before.published);
+  });
+}
