+    }
+  }
+  // 1/2/8 · the elements themselves: inline style, :style, utility classes
+  for (const el of elements(t, CHAIN)) {
+    const foot = el.words.includes("card-foot") || /id="card-foot"/.test(el.attrs);
+    const drawn =
+      !el.words.includes("drawer-case") ||
+      foot ||
+      el.words.some((w) => INKED.cls.includes(w));
+    if (/(?:^|\s)(?::style|v-bind:style|style)\s*=/.test(el.attrs))
+      fails.push(
+        `8 THE CLIP: <${el.tag} ${el.words.join(" ")}> in ${el.file} carries an inline style`,
+      );
+    for (const w of el.words) {
+      if (foot && UTIL_PAD.test(w))
+        fails.push(`1 THE INSET: the foot's element in ${el.file} carries \`${w}\``);
+      if (foot && UTIL_LAYER.test(w))
+        fails.push(`2 THE LAYER: the foot's element in ${el.file} carries \`${w}\``);
+      if (UTIL_CLIP.test(w) && (drawn || /overflow|contain|clip|mask/.test(w)))
+        fails.push(`8 THE CLIP: <${el.tag}> in ${el.file} carries \`${w}\``);
+    }
+  }
+  // …and script writes in the foot's owners (element binding unresolved: any write counts)
+  for (const f of [PANEL, SCENE_SFC, RIBBON]) {
+    const text = t.read(path.join(ROOT, f));
+    for (const p of [
+      "padding-bottom",
+      "padding-block-end",
+      "padding",
+      "overflow",
+      "contain",
+      "clip-path",
+      "opacity",
+      "visibility",
+      "z-index",
+    ])
+      for (const w of scriptWrites(text, p))
+        if (
+          !w.unresolved ||
+          /padding|overflow|contain|clip|opacity|visibility|z-?index/i.test(w.prop)
+        )
+          fails.push(`8 THE CLIP: ${f}:${w.line} a script writes \`${w.prop}\``);
+  }
+
+  // 5 · THE FLOOR, BARE
+  const answers = rules.filter(
+    (r) =>
+      r.file === RIBBON && subjectIs(r.prelude, { cls: ["confirm-answer"], id: [] }),
+  );
+  for (const p of ["min-width", "min-height"])
+    if (
+      !answers.some((r) =>
+        r.decls.some((d) => d.prop === p && d.value === "var(--tap-floor)"),
+      )
+    )
+      fails.push(
+        `5 THE FLOOR: \`.confirm-answer\` needs \`${p}: var(--tap-floor)\`, bare`,
+      );
+
+  // 6 · THE BAND
+  const card = rules.filter(
+    (r) =>
+      r.file === SCENE_CSS && selectors(r.prelude).includes(".controls-card") && !r.ctx,
+  );
+  if (
+    !card.some((r) =>
+      r.decls.some((d) => d.prop === "padding-top" && d.value === "var(--pin-band)"),
+    ) ||
+    !card.some((r) =>
+      r.decls.some((d) => d.prop === "--pin-band" && /^calc\(/.test(d.value)),
+    )
+  )
+    fails.push(
+      "6 THE BAND: `.controls-card` must derive `--pin-band` with calc() and spend it as padding-top",
+    );
+  if (/setProperty\(\s*["'`]--(?:pin-band|card-pad-t)["'`]/.test(panelText))
+    fails.push(
+      "6 THE BAND: a script publishes `--pin-band`/`--card-pad-t`; the band is CSS's",
+    );
