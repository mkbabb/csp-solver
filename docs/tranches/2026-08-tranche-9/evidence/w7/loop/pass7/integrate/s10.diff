+//     exempt band, `elementFromPoint` returning `.washi-tag` and not the chip;
+//   · 390×844 dock, frac 0.25: `new game` over `size` — 0.782px², the same class one regime over.
+// Three things this row adds and §2.5 does not have:
+//   1. THE SWEEP. 101 poses (pass 6; five until pass 5), so a pinned tape is read where it pins.
+//      With the STUCK predicate the tree reads 0/101 pinned-out at both cells, both engines; the
+//      control `74a2b5d9` reads 97–98/101 (a tape 5.4–19 px below its band from frac 0.02/0.03).
+//   2. THE DOCK ARM. §2.5 is 1440×900 only; the pin line is `0.6rem − --pin-band` and the dock
+//      derives a different `--pin-band`, so the arithmetic differs by regime.
+//   3. THE SIGN BIT. `elementFromPoint` at the overlap's centre says whether the covered pixel
+//      still belongs to the control. A tape that covers geometry it also lets you press is a
+//      different defect from one that eats the press, and the row prints which it saw.
+// `belowExemptBand` is the number the design turns on: a pinned tape's bottom against
+// `card.top + padding-top`. ≤ 0 means the tape is wholly inside the reserved band — the band no
+// control may enter — and the coverage is 0 by arithmetic rather than by census luck.
+// ─────────────────────────────────────────────────────────────────────────────
+
+// T9-W7 pass 5 — THE BAND IS SUBTRACTED ONLY WHERE §2.5 SUBTRACTS IT, AND THE TAPE IS CLIPPED
+// TO THE PORT (pass5/CHAIR-RULINGS §1.4: §2.5b's condition = §2.5's). Pass 4 took `liveTop` at
+// every offset, so a pinned tape — which lives inside the band by construction — was zeroed
+// before its sign bit was taken and the row printed `[]` by arithmetic (the critic: 2197.1px²
+// over `9×9` at frac 0.25, `elementFromPoint` returning the tape). Now the band is exempt only
+// while `data-fold-above` is set (the card paints it solid then), and what the exemption forgave
+// is PRINTED with its sign bit, so a green is a census and not a subtraction.
+const PIN_CENSUS = (sel: string) => {
+  const card = document.querySelector('.controls-card');
+  if (!card) return { error: 'no card' } as const;
+  const cb = card.getBoundingClientRect();
+  const padTop = parseFloat(getComputedStyle(card).paddingTop) || 0;
+  const clipTop = cb.top + card.clientTop;
+  const clipBottom = clipTop + card.clientHeight;
+  const bandLine = clipTop + padTop;
+  const liveTop = card.hasAttribute('data-fold-above') ? bandLine : -Infinity;
+  const inter = [...card.querySelectorAll(sel)].filter((e) => {
+    const b = e.getBoundingClientRect();
+    return b.width > 0 && b.height > 0;
+  });
+  type Row = { tape: string; target: string; px: number; below: number; hitIsTarget: boolean };
+  const overlaps: Row[] = [];
+  const forgiven: Row[] = [];
+  let worstBelow = -Infinity;
+  for (const tape of card.querySelectorAll('.washi-tag')) {
+    const cs = getComputedStyle(tape);
+    if (cs.display === 'none' || cs.visibility === 'hidden' || +cs.opacity < 0.05) continue;
+    const r = tape.getBoundingClientRect();
+    const t = { left: r.left, right: r.right, top: Math.max(r.top, clipTop), bottom: Math.min(r.bottom, clipBottom) };
+    if (r.width === 0 || t.bottom - t.top <= 0) continue;
+    // PINNED = STUCK (pass 6, the pass-5 critic's 101-pose sweep): a sticky tape rides up
+    // THROUGH the band line before it sticks, and `sticky && !released && top ≤ band` counted
+    // those in-transit tapes (19–33.6 css below the band at 10–12 of 101 poses nobody sampled).
+    // A tape is pinned when it sits AT its sticky offset, |top − stickyTop| < 0.5.
+    // The sticky offset is a LAYOUT position: the port's CONTENT edge (clip + padding-top) plus
+    // the tape's `top`. The tape is painted rotated (its box's bbox grows) and may be translated,
+    // so its laid top is read from the painted centre net of the paint offset, less half its
+    // layout height: a tape drawn lower than it is laid is still stuck, and the painted `below`
+    // is what reads the drop.
+    const stickyTop = bandLine + (parseFloat(cs.top) || 0);
+    const paintY =
+      (parseFloat(cs.translate.split(' ')[1] ?? '0') || 0) +
+      (cs.transform === 'none' ? 0 : new DOMMatrixReadOnly(cs.transform).f);
+    const laidTop = (r.top + r.bottom) / 2 - paintY - (tape as HTMLElement).offsetHeight / 2;
+    const pinned =
+      cs.position === 'sticky' &&
+      !tape.hasAttribute('data-released') &&
+      Math.abs(laidTop - stickyTop) < 0.5;
+    const below = +(r.bottom - bandLine).toFixed(2);
+    // Only a tape that is actually PINNED is asked to stay inside the band; a tape riding its
+    // own well is governed by the well's padding (§1.2) and by §2.5's own census above.
+    if (pinned && below > worstBelow) worstBelow = below;
+    for (const el of inter) {
+      const b = el.getBoundingClientRect();
+      const w = Math.max(0, Math.min(b.right, t.right) - Math.max(b.left, t.left));
+      const whole = Math.max(0, Math.min(b.bottom, t.bottom) - Math.max(b.top, t.top));
+      const h = Math.max(0, Math.min(b.bottom, t.bottom) - Math.max(b.top, t.top, liveTop));
+      if (w * whole <= 0.5) continue;
+      const px = (Math.max(b.left, t.left) + Math.min(b.right, t.right)) / 2;
+      const py = (Math.max(b.top, t.top) + Math.min(b.bottom, t.bottom)) / 2;
+      const hit = document.elementFromPoint(px, py);
+      const row = {
+        tape: (tape.textContent || '').trim().slice(0, 24),
+        // named by its accessible name: aria-label, else the text its aria-labelledby points at
+        // (the dock's two `.mobile-heading-btn` read "" by textContent), else its own text
+        target:
+          el.getAttribute('aria-label') ||
+          (el.getAttribute('aria-labelledby') || '')
+            .split(/\s+/)
+            .map((id) => document.getElementById(id)?.textContent?.trim() ?? '')
+            .join(' ')
+            .trim()
+            .slice(0, 24) ||
+          (el.textContent || '').trim().slice(0, 24),
+        px: +(w * (w * h > 0.5 ? h : whole)).toFixed(1),
+        below,
+        hitIsTarget: hit === el || (hit ? el.contains(hit) : false),
+      };
+      (w * h > 0.5 ? overlaps : forgiven).push(row);
+    }
+  }
+  return {
+    overlaps,
+    forgiven,
+    worstBelow: worstBelow === -Infinity ? null : worstBelow,
+    padTop: +padTop.toFixed(2),
+    foldAbove: card.hasAttribute('data-fold-above'),
+  };
+};
+
+for (const cell of [
+  { name: 'rail 1440×900', w: 1440, h: 900, dock: false },
+  { name: 'dock 390×844', w: 390, h: 844, dock: true },
+]) {
+  test.describe(`§2.5b the pinned tape stays in its band @ ${cell.name}`, () => {
+    test.use({ viewport: { width: cell.w, height: cell.h }, hasTouch: cell.dock });
+
+    test(`§2.5b no pinned tape leaves the pin band at any scroll offset @ ${cell.name}`, async ({
+      page,
+    }) => {
+      test.slow();
+      await boot(page);
+      await loadBoard(page);
+      if (cell.dock) {
+        await page.locator('.drawer-tab').click();
+        await page.waitForSelector('#controls-drawer .drawer-case', { state: 'visible' });
+        // THE SHEET SLIDES (~520ms), so the POSE is polled, never slept on: a fixed wait in
+        // front of a one-shot geometry read is a race with the glide, and the whole of this row
+        // is geometry. The settled pose is the sheet's own top, unchanged across two samples.
+        await expect
+          .poll(
+            async () => {
+              const a = await page.evaluate(
+                () => document.querySelector('#controls-drawer')?.getBoundingClientRect().top ?? null,
+              );
+              await page.waitForTimeout(80);
+              const b = await page.evaluate(
+                () => document.querySelector('#controls-drawer')?.getBoundingClientRect().top ?? null,
+              );
+              return a !== null && b !== null && Math.abs(a - b) < 0.05;
+            },
+            { timeout: 5000 },
+          )
+          .toBe(true);
+      }
+      await expect(page.locator('.controls-card .washi-tag')).toHaveCount(4);
+
+      const range = await page.evaluate(() => {
+        const c = document.querySelector('.controls-card');
+        return c ? c.scrollHeight - c.clientHeight : 0;
+      });
+      expect(range, 'the card must actually scroll, or this row proves nothing').toBeGreaterThan(
+        40,
+      );
+
+      // 101 POSES (pass 6): the row's title says "at any scroll offset", and five offsets let
+      // an in-transit tape pass unsampled. Each pose settles two frames + 20 ms (the release is
+      // published in the scroll event itself), read in-page so the sweep stays cheap.
+      const seen: Record<string, unknown>[] = [];
+      for (let i = 0; i <= 100; i++) {
+        await page.evaluate(async (y) => {
+          const c = document.querySelector('.controls-card');
+          if (c) c.scrollTop = y;
+          await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
+          await new Promise((r) => setTimeout(r, 20));
+        }, Math.round((range * i) / 100));
+        seen.push({ frac: i / 100, ...(await page.evaluate(PIN_CENSUS, INTERACTIVE)) });
+      }
+      const bad = seen.filter(
+        (s) => (s.overlaps as unknown[]).length || (typeof s.worstBelow === 'number' && s.worstBelow > 0),
+      );
+      console.log(
+        `[W7-§2.5b] ${cell.name} poses ${seen.length}, stuck ${seen.filter((x) => x.worstBelow !== null).length}, pinned-out ${bad.length}, forgiven ${JSON.stringify(
+          [...new Map(seen.flatMap((s) => s.forgiven as { tape: string; target: string }[]).map((f) => [`${f.tape}×${f.target}`, f])).values()],
+        )}`,
+      );
+      expect(seen.length).toBe(101);
+      // the predicate must SEE its subject (a stuck tape at some pose), or a green is vacuous
+      expect(
+        seen.filter((x) => x.worstBelow !== null).length,
+        'no pose read a stuck tape: the STUCK predicate has lost its subject',
+      ).toBeGreaterThan(10);
+
+      for (const state of seen) {
+        expect(
+          state.overlaps,
+          `at scrollTop frac ${state.frac} a pinned tape covers a control: ${JSON.stringify(state.overlaps)}`,
+        ).toEqual([]);
+        if (state.worstBelow !== null)
+          expect(
+            state.worstBelow as number,
+            `at frac ${state.frac} the pinned tape hangs ${state.worstBelow}px below the exempt band`,
+          ).toBeLessThanOrEqual(0);
+      }
+
+      // NEGATIVE CONTROL, in the same run, and it is what makes this row a gate rather than
+      // arithmetic about a number nobody can move: ablate the pin band back to the utility
+      // class's own 20px — the value the card carried at HEAD — and the same sweep must find
+      // the tape on a control. HEAD's own reading at this cell is 358.6px² over `9×9` at frac
+      // 0.25 (rail) and 0.782 over `size` at frac 0.25 (dock).
+      const ablation = await page.addStyleTag({
+        content: `.controls-card { padding-top: 20px !important; --pin-band: 20px !important }`,
+      });
+      const broken: Record<string, unknown>[] = [];
+      for (const frac of [0, 0.25, 0.5, 0.75, 1]) {
+        await page.evaluate((y) => {
+          const c = document.querySelector('.controls-card');
+          if (c) c.scrollTop = y;
+        }, Math.round(range * frac));
+        await page.waitForTimeout(280);
+        broken.push({ frac, ...(await page.evaluate(PIN_CENSUS, INTERACTIVE)) });
+      }
+      console.log(`[W7-§2.5b NEG] ${cell.name} ${JSON.stringify(broken)}`);
+      expect(
+        broken.some(
+          (s) =>
+            ((s.overlaps as unknown[]) ?? []).length > 0 ||
+            (typeof s.worstBelow === 'number' && s.worstBelow > 0),
+        ),
+        'the unpaid pin band must put a pinned tape back on a control',
+      ).toBe(true);
+
+      // NEGATIVE CONTROL 2 — THE LAW, NOT THE BAND (pass 5). The ablation above moves the band
+      // line itself, so it proves the subtraction is live and nothing else. This one leaves the
+      // band whole and drops the PINNED tape 24px lower, out of it: a census reds on that; an
+      // arithmetic identity on the band does not.
+      await ablation.evaluate((n) => (n as Element).remove());
+      await page.addStyleTag({
+        content: `.controls-card .washi-tag:not([data-released]) { translate: 0 24px }`,
+      });
+      const dropped: Record<string, unknown>[] = [];
+      for (const frac of [0.25, 0.5, 0.75]) {
+        await page.evaluate((y) => {
+          const c = document.querySelector('.controls-card');
+          if (c) c.scrollTop = y;
+        }, Math.round(range * frac));
+        await page.waitForTimeout(280);
+        dropped.push({ frac, ...(await page.evaluate(PIN_CENSUS, INTERACTIVE)) });
+      }
+      console.log(`[W7-§2.5b NEG-2] ${cell.name} ${JSON.stringify(dropped)}`);
+      expect(
+        dropped.some((s) => typeof s.worstBelow === 'number' && s.worstBelow > 0),
+        'a pinned tape dropped out of an unchanged band must read below it',
+      ).toBe(true);
+    });
+  });
+}
