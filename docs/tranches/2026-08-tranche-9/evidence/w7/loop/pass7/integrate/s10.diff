+        : /^(-webkit-)?mask/.test(p)
+          ? !/^none$/.test(v)
+          : p === "content-visibility"
+            ? !/^visible$/.test(v)
+            : false;
+const INK = (p, v) =>
+  (p === "filter" || p === "backdrop-filter") && !/^none$/.test(v)
+    ? true
+    : p === "opacity" ||
+        p === "visibility" ||
+        p === "color" ||
+        p === "-webkit-text-fill-color"
+      ? true
+      : p === "display" && /^(none|contents)$/.test(v);
+const EDGE = (p, v) =>
+  ((/^border(?:-(?:top|right|bottom|left|block|inline)(?:-(?:start|end))?)?(?:-(?:width|style|image))?$/.test(
+    p,
+  ) ||
+    /^outline(?:-(?:width|style))?$/.test(p) ||
+    p === "box-shadow") &&
+    !/^(none|0|0px|transparent)$/.test(v)) ||
+  /^background(?:-color|-image)?$/.test(p);
+const LAYOUT = /^(position|inset|top|right|bottom|left|pointer-events|z-index)$/;
+const UTIL_CLIP =
+  /^(?:[\w-]+:)*!?(overflow(-[xy])?-(hidden|clip|auto|scroll)|contain-(paint|layout|strict|content)|\[(clip-path|mask|overflow|contain)[^\]]*\]|mask-.+|opacity-\d+|invisible|hidden|contents|bg-.+|border(-[trblxyse])?(-\d+)?|ring(-\d+|-inset)?|shadow(-(sm|md|lg|xl|2xl|inner))?|outline(-(\d+|dashed|dotted|double))?)$/;
