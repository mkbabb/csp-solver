+const UTIL_LAYER = /^(?:[\w-]+:)*!?(z-.+|static)$/;
+
+// ------------------------------------------------------------------------------ the check
+export function check(overlay = {}) {
+  const t = tree(overlay);
+  const fails = [];
+  const rules = allRules(t);
+  // the token map `tokens()` would build, from the rules already parsed (last wins per name)
+  const map = new Map(
+    rules.flatMap((r) =>
+      r.decls.filter((d) => d.prop.startsWith("--")).map((d) => [d.prop, d.value]),
+    ),
+  );
+  const where = (r) => `${r.file} \`${r.ctx ? r.ctx + " " : ""}${r.prelude}\``;
+
+  // 1 · THE INSET
+  let pads = 0;
+  for (const r of rules)
+    if (subjectIs(r.prelude, FOOT))
+      for (const d of r.decls) {
+        const raw = bottomOf(d);
+        if (raw === null) continue;
+        pads++;
+        const v = resolve(raw, map).trim();
+        const berth = /hover:\s*hover/.test(r.ctx) && /pointer:\s*fine/.test(r.ctx);
+        const floor = /orientation:\s*landscape/.test(r.ctx) ? 1.125 : 0.75;
+        const env = /env\(\s*safe-area-inset-bottom/.test(v);
+        if (!env) {
+          fails.push(
+            `1 THE INSET: ${where(r)} ${d.prop}: ${v} spends no env(safe-area-inset-bottom)`,
+          );
+          continue;
+        }
+        if (berth) {
+          const m =
+            /^max\(\s*(\d*\.?\d+)rem\s*,\s*env\(safe-area-inset-bottom\)\s*\)$/.exec(v);
+          if (!m || +m[1] < 3.5)
+            fails.push(
+              `1 THE INSET: ${where(r)} the berth pad \`${v}\` is not max(≥3.5rem, env())`,
+            );
+          continue;
+        }
+        const added =
+          /^calc\(/.test(v) &&
+          /\+\s*env\(safe-area-inset-bottom|env\(safe-area-inset-bottom[^)]*\)\s*\+/.test(
+            v,
+          );
+        const net = netRem(v);
+        if (!added || !(net >= floor))
+          fails.push(
+            `1 THE INSET: ${where(r)} ${d.prop}: \`${v}\` must ADD the inset to a net pad ≥ ${floor}rem (net ${Number.isNaN(net) ? "unreadable" : net.toFixed(3) + "rem"})`,
+          );
+      }
+  if (!pads) fails.push("1 THE INSET: no site sets the foot's bottom pad");
+
+  // 2 · THE LAYER
+  const zOf = (set) =>
+    rules
+      .filter((r) => subjectIs(r.prelude, set))
+      .flatMap((r) =>
+        r.decls
+          .filter((d) => d.prop === "z-index")
+          .map((d) => ({ r, z: parseInt(resolve(d.value, map), 10) })),
+      );
+  const cardZ = Math.max(
+    -1,
+    ...zOf({ cls: ["controls-card"], id: [] }).map((x) => x.z),
+  );
+  const footZ = zOf(FOOT);
+  const footPos = rules
+    .filter((r) => subjectIs(r.prelude, FOOT))
+    .flatMap((r) =>
+      r.decls.filter((d) => d.prop === "position").map((d) => ({ r, v: d.value })),
+    );
+  if (!footPos.length || !footZ.length)
+    fails.push("2 THE LAYER: the foot declares no position or no z-index");
+  for (const { r, v } of footPos)
+    if (!/^(relative|absolute|sticky|fixed)$/.test(v))
+      fails.push(`2 THE LAYER: ${where(r)} position: ${v}`);
+  for (const { r, z } of footZ)
+    if (!(z >= cardZ))
+      fails.push(`2 THE LAYER: ${where(r)} z-index ${z} under the card's ${cardZ}`);
+
+  // 3 · THE PEN
+  const panelText = t.read(path.join(ROOT, PANEL));
+  const tpl = sfc(panelText).template?.text ?? "";
+  const lipTag =
+    /<HandDrawnOutline\s[^>]*class="bar-frame[^"]*"[^>]*>/.exec(stripHtml(tpl))?.[0] ??
+    "";
+  const four = (tag) =>
+    tag
+      ? ["stroke-width", "outset", "radius", "pose"]
+          .map(
+            (p) => `${p}=${(new RegExp(`:${p}="([^"]+)"`).exec(tag) || [])[1] ?? null}`,
+          )
+          .join(" ")
+      : null;
+  const wellTag =
+    /<HandDrawnOutline\s[^>]*class="tray-well[^"]*"[^>]*>/.exec(stripHtml(tpl))?.[0] ??
+    "";
+  if (!lipTag || four(lipTag) !== four(wellTag))
+    fails.push(
+      `3 THE PEN: the bar's frame is \`${four(lipTag)}\`, the wells' \`${four(wellTag)}\``,
+    );
+  if (
+    /\s(?:v-if|v-show|v-else(?:-if)?|v-for|:?style|v-bind:style|:class|v-bind:class)\s*=/.test(
+      lipTag,
+    )
+  )
+    fails.push(`3 THE PEN: the frame's tag is conditional or styled inline`);
+  // the lip's ancestry inside the bar: a template walk (a tag stack over the stripped template)
+  {
+    const s = stripHtml(tpl);
+    const stack = [];
+    let anc = null;
+    const VOID = /^(input|img|br|hr|meta|link|source|col|area|base|wbr)$/i;
+    for (const m of s.matchAll(
+      /<(\/?)([a-zA-Z][\w-]*)((?:\s+(?:"[^"]*"|'[^']*'|[^\s>"'/]|\/(?!>))+)*)\s*(\/?)>/g,
+    )) {
+      const [whole, close, tag, attrs, self] = m;
+      if (close) {
+        const i = stack.map((x) => x.tag).lastIndexOf(tag);
+        if (i >= 0) stack.length = i;
+        continue;
+      }
+      if (
+        whole === lipTag ||
+        (tag === "HandDrawnOutline" && /class="bar-frame/.test(attrs))
+      )
+        anc = [...stack];
+      if (!self && !VOID.test(tag)) stack.push({ tag, attrs: attrs ?? "" });
+    }
+    const barAt = anc
+      ? anc.findIndex((x) => /class="action-bar[\s"]/.test(x.attrs))
+      : -1;
+    if (barAt < 0) fails.push("3 THE PEN: the frame is not inside `.action-bar`");
+    else
+      for (const x of anc.slice(barAt))
+        if (/\s(?:v-if|v-show|v-else(?:-if)?|v-for)\s*=|\sv-else(?:\s|$)/.test(x.attrs))
+          fails.push(
+            `3 THE PEN: the frame mounts under a conditional <${x.tag}> between it and the bar`,
+          );
+  }
+  const outline = sfc(t.read(path.join(ROOT, OUTLINE))).template?.text ?? "";
+  const FRAME_CLS = new Set([
+    "bar-frame",
+    ...[...outline.matchAll(/class="([^"]+)"/g)].flatMap((m) => m[1].split(/\s+/)),
+    ...[...outline.matchAll(/'([\w-]+)'\s*:/g)].map((m) => m[1]),
+  ]);
+  const FRAME_TAG = new Set([...outline.matchAll(/<([a-z][\w-]*)/g)].map((m) => m[1]));
+  for (const r of rules)
+    for (const sel of selectors(r.prelude)) {
+      const { subj, above } = split(sel);
+      if (names(subj, { cls: ["bar-frame"], id: [] })) {
+        for (const d of r.decls)
+          if (!LAYOUT.test(d.prop))
+            fails.push(`3 THE PEN: ${where(r)} { ${d.prop} } reaches the drawn layer`);
+        continue;
+      }
+      if (!names(above, DESCENT)) continue;
+      const pos = [...compoundClasses(subj).pos];
+      const tag = /^([a-zA-Z][\w-]*|\*)/.exec(subj.replace(/^[>+~\s]+/, ""))?.[1];
+      const outside =
+        pos.some((c) => !FRAME_CLS.has(c)) ||
+        (!pos.length && tag && tag !== "*" && !FRAME_TAG.has(tag));
+      if (!outside && r.decls.length)
+        fails.push(
+          `3 THE PEN: ${where(r)} descends from the bar to a subject the frame can be (\`${subj || "*"}\`)`,
+        );
+    }
+
+  // 4 · ONE HAND, and 8 · THE CLIP (rules)
+  for (const r of rules) {
+    const box = subjectIs(r.prelude, BOX);
+    const inked = subjectIs(r.prelude, INKED);
+    const chain = subjectIs(r.prelude, CHAIN);
+    if (!box && !chain) continue;
+    for (const d of r.decls) {
+      const v = resolve(d.value, map).trim();
+      if (box && EDGE(d.prop, v))
+        fails.push(`4 ONE HAND: ${where(r)} { ${d.prop}: ${v} }`);
+      if (box && /^(color|-webkit-text-fill-color)$/.test(d.prop))
+        fails.push(`4 ONE HAND: ${where(r)} { ${d.prop}: ${v} }`);
+      if (chain && CLIP(d.prop, v))
+        fails.push(`8 THE CLIP: ${where(r)} { ${d.prop}: ${v} }`);
+      if (inked && INK(d.prop, v) && d.prop !== "color")
