diff --git a/web/frontend/scripts/check-face-engine-identity.mjs b/web/frontend/scripts/check-face-engine-identity.mjs
new file mode 100644
index 0000000..68d435a
--- /dev/null
+++ b/web/frontend/scripts/check-face-engine-identity.mjs
@@ -0,0 +1,373 @@
+#!/usr/bin/env node
+/**
+ * check-face-engine-identity — T9-W7 CTRL-FACE pass 4, THE SPEC'S GATE (i).
+ *
+ * The spec's row reads: *every card chip's mark width chromium == webkit ± 0.5px*. Pass 3
+ * shipped something else under its name — `paintedW - wordW ≈ 8`, asserted INSIDE each engine,
+ * on ONE chip — and the cross-engine number was compared nowhere. The lane's own reading was
+ * 32.67 chromium against 32.00 webkit: 0.67px apart, OUTSIDE the spec's own band, printed in the
+ * README and asserted by nothing. The chair's line is "never re-word a gate to pass", so this is
+ * the re-cut, and it does the one thing a Playwright project cannot: compare the two engines.
+ *
+ * WHY A NODE GATE. Two Playwright projects run in separate browser contexts inside one run and
+ * neither can read the other's readings. `e2e/face-law.spec.ts` therefore WRITES one census
+ * per engine to `.face-engine/<engine>.json` (stamped, pass 5) and this gate reads both. It REQUIRES
+ * both: a missing engine is a RED, not a skip, because "the row passed because only chromium ran"
+ * is the exact shape of the hole this replaces. A FILE rather than `test.info().attach()`: an
+ * attachment given a `body` lives in the REPORT and never reaches disk, so this gate would have
+ * depended on which reporter the caller picked.
+ *
+ * THE BAND IS SPLIT, AND EACH HALF KEEPS ITS REASON.
+ *
+ *   1 THE WORD  ±0.5px, the spec's own band, on the LAYOUT number. This is the advance of the
+ *               chip's `.ctrl-word` with its padding subtracted — the quantity the mark is
+ *               DERIVED from (`background-size: calc(100% + 0.5rem)`), so if the two engines
+ *               agree here they agree about the mark by construction. Measured on this tree:
+ *               0.000px apart on every chip. This is the row that reds if the mark is ever
+ *               re-priced in `ch` again — Fira Code's subset carries no `0`, so `ch` falls back
+ *               to 0.5em and splits 12.0016 against 10.0000 at the deck's pinned 16px.
+ *
+ *   2 THE PAINT ±3 DEVICE pixels, and the unit is the point. The painted width comes from
+ *               `paintedExtent()`: two crops of one chip differenced, and a column counts as
+ *               painted when the two bitmaps disagree there at all. That threshold sits on an
+ *               antialiased edge, and the two engines do not tail their AA identically — the
+ *               0.67px spread IS 2 device columns at dpr 3 (mark cols [24,121] chromium against
+ *               [24,119] webkit), on a mark whose two LAYOUT inputs are identical to 0.000. So
+ *               the band is the instrument's resolution: one column of slack on each edge plus
+ *               one for the inclusive count. It is stated in device px because a CSS-px band
+ *               would silently loosen on a dpr-1 machine and tighten on a dpr-3 one, which is
+ *               how an instrument's noise gets written down as a law about a card.
+ *
+ * SELF-TEST (`--self-test`): one planted defect per check, on the real censuses, each asserted
+ * to red — a gate that has never been seen to fail is a comment.
+ *
+ * NOT-A-LANE: it reads a census only e2e/face-law.spec.ts produces, and .github/workflows/ci.yml runs no browser (T7-W9 O-12).
+ * Run by `npm run lint:face-engine` beside the Playwright estate. Owner's standing ruling O-12
+ * (docs/tranches/2026-08-tranche-7/ §9, T7 execution record): CI is sixteen lanes, BROWSERLESS;
+ * `e2e`, `e2e-webkit` and `perf-subset` were deleted at `d1daefb3`, the Playwright estate is
+ * LOCAL INSTRUMENTS, and deployment validation is visual on the live site. A CI step calling this
+ * would red on every push for want of a browser, which is a lane that says nothing. The run of
+ * record is banked with the pass's readings. Should CI ever regain a browser lane, this gate
+ * belongs immediately after it and this paragraph is what should be deleted.
+ *
+ * Usage:  node scripts/check-face-engine-identity.mjs [--self-test] [--dir <path>] [--dist <dist dir>]
+ */
+import crypto from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const args = process.argv.slice(2);
+const dirArg = args.indexOf("--dir");
+const FRONTEND = path.join(path.dirname(fileURLToPath(import.meta.url)), "..");
+/* PASS 5 — THE CENSUS LIVES OUTSIDE `test-results/`. Playwright wipes that dir at the start of
+   every run, so the wave's own stall law (chunk Playwright BY PROJECT) erased the first chunk's
+   census before the second wrote its own. `.face-engine/` is ignored by the repo's .gitignore. */
+const DIR = dirArg >= 0 ? args[dirArg + 1] : path.join(FRONTEND, ".face-engine");
+
+/* PASS 5 — THE CENSUS IS STAMPED WITH THE FILES IT DESCRIBES, and a stamp that no longer
+   matches the tree is a RED. Pass 4 compared two JSON files and nothing bound them to the tree:
+   the critic re-priced the mark to `6ch` (`background-size: 53.76px` painted) under a census
+   recording 32.667 / 32.000 and this gate printed PASS. These are the files whose bytes decide a
+   chip's word and its mark; `e2e/face-law.spec.ts` PARSES this literal and writes the same
+   digest into each census, so the list is spelled once. */
+const STAMP_FILES = [
+  "src/pencil/chrome/OptionSelector/OptionSelector.vue",
+  "src/games/shared/GameControlPanel.vue",
+  "src/assets/typography.css",
+  "src/assets/index.css",
+  "src/assets/fonts/patrickhand-subset.woff2",
+  "src/assets/fonts/firacode-subset.woff2",
+  // pass 6: the crib's max-content sizes the rail the chips sit in (the critic's omission)
+  "src/pencil/chrome/KeyboardLegend.vue",
+];
+/** sha1 over each file read as utf8 (the spec's one read form), path-prefixed, in list order. */
+function treeStamp(root = FRONTEND) {
+  const h = crypto.createHash("sha1");
+  for (const rel of STAMP_FILES)
+    h.update(`${rel}\n${fs.readFileSync(path.join(root, rel), "utf8")}\n`);
+  return h.digest("hex");
+}
+const TREE_STAMP = treeStamp();
+
+/* PASS 6 — A DIGEST OF `src/` IS NOT THE ARTIFACT A DIST RUN MEASURED. The critic planted `6ch`
+   in `src/`, re-ran face-law against the UNREBUILT dist, and the spec wrote the planted src's
+   digest over the old dist's numbers: PASS on a tree whose next build paints the plant. So the
+   census records what the page SERVED (`served.mode/js/css`, read in-page) and a dist census is
+   bound twice: (a) its `index-*.js`/`.css` are the ones `dist/index.html` names, and (b) that
+   dist is NEWER than every file under `src/` — a build that predates an edit describes bytes
+   that are no longer on disk. A dev census (`/src/main.ts`) is compiled from `src/` on request,
+   so the src digest is its artifact. A census with no `served` field is refused. */
+const DIST = (() => {
+  const i = args.indexOf("--dist");
+  return i >= 0 ? path.resolve(args[i + 1]) : path.join(FRONTEND, "dist");
+})();
+function distFacts(dist = DIST, root = FRONTEND) {
+  let html;
+  try {
+    html = fs.readFileSync(path.join(dist, "index.html"), "utf8");
+  } catch {
+    return { missing: true };
+  }
+  const js = /\/assets\/index-[^"'/]+\.js/.exec(html)?.[0] ?? null;
+  const css = /\/assets\/index-[^"'/]+\.css/.exec(html)?.[0] ?? null;
+  // PASS 7 — CONTENT, NOT MTIME (the pass-6 critic's `cp -p` plant: new bytes under the old mtime
+  // read fresh). The build's `face-stamp` plugin (vite.config.ts) writes `{ js, stamp }` from the
+  // STAMP_FILES it was built from; the dist is this tree only if that js is the one dist/index.html
+  // names AND that stamp is the tree's digest now.
+  let built = null;
+  try {
+    built = JSON.parse(
+      fs.readFileSync(path.join(root, ".face-engine", "dist-stamp.json"), "utf8"),
+    );
+  } catch {
+    /* absent: read below as "a dist with no build stamp" */
+  }
+  return { js, css, built };
+}
+const ENGINES = ["chromium", "webkit"];
+
+const WORD_BAND_CSS_PX = 0.5; // the spec's own number, on the layout reading
+const PAINT_BAND_DEVICE_PX = 3; // the raster instrument's resolution, stated in device px
+
+/** Every `<engine>.json` census under the census dir, keyed by the engine it names. */
+function load(dir) {
+  const out = {};
+  const walk = (d) => {
+    let names;
+    try {
+      names = fs.readdirSync(d);
+    } catch {
+      return;
+    }
+    for (const n of names) {
+      const p = path.join(d, n);
+      if (fs.statSync(p).isDirectory()) {
+        walk(p);
+        continue;
+      }
+      if (!/\.json$/.test(n)) continue;
+      try {
+        const j = JSON.parse(fs.readFileSync(p, "utf8"));
+        if (ENGINES.includes(j.engine)) out[j.engine] = { ...j, _file: p };
+      } catch (err) {
+        out[`bad:${n}`] = { _bad: String(err) };
+      }
+    }
+  };
+  walk(dir);
+  return out;
+}
+
+function run(censuses, facts = distFacts()) {
+  const result = {
+    "both engines reported": [],
+    "each census describes THIS tree": [],
+    "the word is one width": [],
+    "the painted mark is one width": [],
+  };
+
+  for (const e of ENGINES) {
+    if (!censuses[e])
+      result["both engines reported"].push(
+        `${e}: no census at ${path.join(DIR, `${e}.json`)} — run \`face-law.spec.ts\` on BOTH projects`,
+      );
+    else if (censuses[e]._bad)
+      result["both engines reported"].push(
+        `${e}: unreadable census (${censuses[e]._bad})`,
+      );
+  }
+  if (result["both engines reported"].length) {
+    // NOT GREEN, NOT RUN. Printing the other two checks as GREEN here would be the same lie the
+    // gate exists to stop: they compared nothing.
+    result["the word is one width"].push("NOT RUN — a census is missing");
+    result["the painted mark is one width"].push("NOT RUN — a census is missing");
+    return result;
+  }
+
+  const [a, b] = ENGINES.map((e) => censuses[e]);
+
+  // 0 · THE STAMP. A census taken over other bytes describes a card that is not on disk.
+  for (const c of [a, b])
+    if (c.stamp !== TREE_STAMP)
+      result["each census describes THIS tree"].push(
+        `${c.engine}: census stamp ${c.stamp ?? "(none)"} ≠ the tree's ${TREE_STAMP} — one of ` +
+          `${STAMP_FILES.length} files changed since the census was written; re-run face-law.spec.ts`,
+      );
+
+  // 0b · THE ARTIFACT. What the page served, bound to what is on disk.
+  for (const c of [a, b]) {
+    const sv = c.served;
+    if (!sv || !sv.mode)
+      result["each census describes THIS tree"].push(
+        `${c.engine}: the census names no served artifact — re-run face-law.spec.ts (pass 6 records it)`,
+      );
+    else if (sv.mode === "dist") {
+      if (facts.missing)
+        result["each census describes THIS tree"].push(
+          `${c.engine}: a DIST census and no ${path.join(DIST, "index.html")} to bind it to`,
+        );
+      else {
+        if (sv.js !== facts.js || sv.css !== facts.css)
+          result["each census describes THIS tree"].push(
+            `${c.engine}: the page served ${sv.js} + ${sv.css}; ${DIST} is ${facts.js} + ${facts.css}`,
+          );
+        if (!facts.built || facts.built.js !== facts.js)
+          result["each census describes THIS tree"].push(
+            `${c.engine}: ${DIST} carries no build stamp for ${facts.js} (the sidecar names ${facts.built?.js ?? "nothing"}) — rebuild`,
+          );
+        else if (facts.built.stamp !== TREE_STAMP)
+          result["each census describes THIS tree"].push(
+            `${c.engine}: the served dist was built from other bytes (build stamp ${facts.built.stamp} ≠ the tree's ` +
+              `${TREE_STAMP}) — rebuild, re-serve and re-run; a stale dist is not this tree`,
+          );
+      }
+    }
+  }
+
+  // 1 · THE WORD, ±0.5px. Every chip, by its own text, so a renamed chip is a RED and not a
+  //     silently shorter list.
+  const names = [...new Set([...a.words, ...b.words].map((w) => w.text))].sort();
+  for (const name of names) {
+    const wa = a.words.find((w) => w.text === name);
+    const wb = b.words.find((w) => w.text === name);
+    if (!wa || !wb) {
+      result["the word is one width"].push(
+        `"${name}" is on ${wa ? ENGINES[0] : ENGINES[1]} only — the two cards do not carry the same chips`,
+      );
+      continue;
+    }
+    if (wa.wordW === null || wb.wordW === null) continue; // a chip with no word box carries no mark
+    const d = Math.abs(wa.wordW - wb.wordW);
+    if (d > WORD_BAND_CSS_PX)
+      result["the word is one width"].push(
