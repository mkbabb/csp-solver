+  page,
+}) => {
+  await loadSudoku(page);
+
+  const SPENDERS = () => {
+    const out: { selector: string; media: string; text: string }[] = [];
+    let refused = 0;
+    const walk = (rules: CSSRuleList, media: string) => {
+      for (const rule of rules) {
+        if (rule instanceof CSSMediaRule) {
+          walk(rule.cssRules, media ? `${media} AND ${rule.conditionText}` : rule.conditionText);
+          continue;
+        }
+        // CSSStyleRule FIRST: it also implements CSSGroupingRule under CSS nesting, so a
+        // `"cssRules" in rule` branch ahead of this one swallows every style rule (§(a) above).
+        if (rule instanceof CSSStyleRule && rule.style.cssText.includes("var(--sheet-chrome")) {
+          out.push({ selector: rule.selectorText, media, text: rule.style.cssText });
+        }
+        if ("cssRules" in rule) walk((rule as CSSGroupingRule).cssRules, media);
+      }
+    };
+    for (const sheet of document.styleSheets) {
+      try {
+        walk(sheet.cssRules, "");
+      } catch {
+        refused++;
+      }
+    }
