+    fillForced: () => ({ placements: [] }),
+    hint: () => HINT,
+    snapshotExtra: () => ({}),
+    restoreExtra: () => {},
+    restorePersistedFurniture: () => {},
+    syncToUrl: () => {},
+    persist: () => {},
+    clearPersisted: () => {},
+    dropBoardParam: () => {},
+    writeShareUrl: () => {},
+  };
