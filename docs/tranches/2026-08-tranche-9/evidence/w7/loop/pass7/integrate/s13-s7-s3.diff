@@ -0,0 +1,77 @@
+import { ref } from "vue";
+import { createSequenceSubscription, type SequenceHandle } from "@mkbabb/pencil-boil";
+import { MOTION } from "@pencil/config/pencilConfig";
+
+/**
+ * T9-M20 · THE HAND'S CLOCK. The ruling used to read the wall clock, so a frame the main
+ * thread lost painted every line wherever the clock said (the grid's own four pose bakes landed
+ * inside its draw-in and moved one line 72–100 % in a single painted frame). Here one master
+ * `sequence` subscription carries the rAF timeline and the hand's clock advances by at most
+ * `MOTION.hand.stepMs` per tick: a healthy 60 Hz frame is never slowed, and a stall pauses the
+ * hand for one frame's travel instead of teleporting it. The library form (`stepMs` on the
+ * sequence itself, pencil-boil 0.12.1, LEDGER T9-R4) deletes the clock half of this file.
+ */
+type Stroke = (clock: number) => boolean;
+
+const SPAN_MS = 600_000;
+let clock = 0;
+let last = -1;
+let master: SequenceHandle | null = null;
+const strokes = new Set<Stroke>();
+
+function tick(_eased: number, raw: number): void {
+  const t = raw * SPAN_MS;
+  if (last >= 0) clock += Math.min(Math.max(0, t - last), MOTION.hand.stepMs);
+  last = t;
+  for (const s of [...strokes]) if (s(clock)) strokes.delete(s);
+  if (strokes.size === 0) {
+    master?.stop();
+    master = null;
+    last = -1;
+  }
+}
+
+/** Enroll a stroke on the hand clock (it returns `true` when finished); returns its withdrawal. */
+export function enrollStroke(stroke: Stroke): () => void {
+  strokes.add(stroke);
+  if (!master) {
+    master = createSequenceSubscription({ durationMs: SPAN_MS, onProgress: tick });
+    master.start();
+  }
+  return () => {
+    strokes.delete(stroke);
+  };
+}
+
+/**
+ * T9-M20 D15 · THE WAVE WAITS FOR THE LAST LIFT. A ruling in flight (from the moment the grid
+ * starts waiting for its poses to the hand's last lift) holds the deal's reveal wave, so no digit
+ * is inked on a page that is not yet ruled. `beginRuling` returns the release, idempotent; an
+ * interrupted ruling (an erase, an unmount) releases too, so the wave can never be stranded.
+ */
+let rulings = 0;
+let waiters: (() => void)[] = [];
+
+export function beginRuling(): () => void {
+  rulings++;
+  let open = true;
+  return () => {
+    if (!open) return;
+    open = false;
+    rulings--;
+    if (rulings > 0) return;
+    const run = waiters;
+    waiters = [];
+    for (const w of run) w();
+  };
+}
+
+/** Resolves at the last lift of every ruling in flight; `null` when none is. */
+export function afterRuling(): Promise<void> | null {
+  if (rulings === 0) return null;
+  return new Promise((resolve) => waiters.push(resolve));
+}
+
+/** The wordmark's pose stack has landed once (the boot's ruling waits for it, so its encodes
+ *  never run under the hand). Latched: a later re-bake (a game's label) does not re-arm it. */
+export const wordmarkResident = ref(false);
