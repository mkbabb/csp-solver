+/** The ladder itself: MOTION.rungs, plus whether each rung carries a ruling. */
+function ladder() {
+  const src = readFileSync(CONFIG, "utf8");
+  const start = src.indexOf("rungs: {");
+  const rungs = [];
+  let rungDoc = "";
+  if (start >= 0) {
+    const block = src.slice(start, src.indexOf("\n  },", start));
+    rungDoc = block;
+    // A rung is a key in the object, never a number inside the comment that rules it —
+    // `travel: 302px @844x390` in `rise`'s own docstring is prose, not a ladder entry.
+    const code = block.replace(/\/\*[^]*?\*\//g, "");
+    const doc = src.slice(Math.max(0, start - 9000), start);
+    for (const m of code.matchAll(/([A-Za-z][A-Za-z0-9]*)\s*:\s*(\d+)/g))
+      rungs.push({
+        key: m[1],
+        value: Number(m[2]),
+        // a rung is a named DECISION: its name must appear in a ruling, above or inline
+        documented:
+          new RegExp(`\\*\\s+${m[1]}\\s+${m[2]}\\b`).test(doc) ||
+          new RegExp(`${m[1]}\\b[^]{0,400}?travel:`).test(block),
+      });
+  }
+  const strays = [];
+  const exempt = {};
+  const motion = tsLeaves(src, "MOTION");
+  for (const [key, value] of Object.entries(motion)) {
+    if (key.startsWith("rungs.") || key.startsWith("characters.")) continue;
+    // a count of BEATS is a cadence, never a length: its length is `× MOTION.beatMs` at the
+    // consumer, which B13 reads at its value (§7's `note.settleAfterBeats`, `refusalHoldBeats`)
+    if (/Beats$/.test(key.split(".").pop())) continue;
+    if (key in EXEMPT_KEYS) exempt[key] = value;
+    else strays.push({ key, value });
+  }
+  // TS sets outside MOTION that spend a duration: admitted GRADED classes, or strays.
+  const tsSets = [];
+  for (const m of src.matchAll(/export const ([A-Z_]+) = \{/g))
+    if (/duration:\s*\d+/.test(src.slice(m.index, src.indexOf("} as const;", m.index))))
