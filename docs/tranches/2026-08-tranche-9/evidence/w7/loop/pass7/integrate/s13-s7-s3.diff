+/**
+ * Position-aware read of one declaration body. Returns the ordered time positions per
+ * comma-separated clause, each tagged duration|delay and named|literal.
+ */
+function positions(prop, body) {
+  const longhand = /-duration$/.test(prop)
+    ? "duration"
+    : /-delay$/.test(prop)
+      ? "delay"
+      : null;
+  // 1 · MASK FIRST — a var()'s own comma is not a clause boundary. Rung reads become
+  //     opaque tokens so their fallback text is never mistaken for a bare literal.
+  const toks = [];
+  let masked = body.replace(RUNG_VAR, (_m, name, fb) => {
+    toks.push({ kind: "rung", rung: name, fallback: fb ?? null });
+    return `«${toks.length - 1}»`;
+  });
+  // 2 · a house curve read becomes its own token (B8 reads it); any OTHER var() with a
+  //     time fallback is a LOCAL (--draw-dur), ruled at its own site.
+  masked = masked.replace(OTHER_VAR, (_m, name, fb) => {
+    // A HOUSE CURVE IS EITHER LAYER'S (pass 4, the §13 fold). `--ease-*` is T6's shape
+    // vocabulary; `--verb-*-ease` is MOT-VERB's timing layer and it is the form the estate
+    // ships now. B8 read only the first, so every verb-eased transition on the merged tree
+    // read as "NO curve … the UA's own `ease` by omission" — 50 false reds, the whole of
+    // this lane's exit 1. Both prefixes are a house curve here; which LAYER a curve belongs
+    // to is `lint:verbs`' question, not this gate's.
+    if (name.startsWith("--ease-") || /^--verb-[A-Za-z]+-ease$/.test(name)) {
+      toks.push({ kind: "ease", raw: name });
+      return `«${toks.length - 1}»`;
+    }
+    if (fb) {
+      const [, n, u] = /^(\d+(?:\.\d+)?)(ms|s)$/.exec(fb);
+      toks.push({ kind: "local", ms: toMs(n, u), raw: fb });
+      return `«${toks.length - 1}»`;
+    }
+    return "§";
+  });
+  // 3 · one clause per comma, then walk each clause in order
+  const out = [];
+  for (const clause of masked.split(",")) {
+    const seq = [];
+    let house = false;
+    const eases = [];
+    const re = /«(\d+)»|(\d+(?:\.\d+)?)(ms|s)(?![\w-])/g;
+    for (let m; (m = re.exec(clause));) {
+      if (m[1] !== undefined) {
+        const t = toks[Number(m[1])];
+        if (t.kind === "ease") {
+          house = true;
+          eases.push(t.raw);
+        } else seq.push(t);
+      } else seq.push({ kind: "literal", ms: toMs(m[2], m[3]), raw: m[2] + m[3] });
+    }
+    const pretty = clause
+      .replace(/«(\d+)»/g, (_m, i) => {
+        const t = toks[Number(i)];
+        return t.kind === "rung"
+          ? `var(--motion-${t.rung}, ${t.fallback ?? "—"})`
+          : t.kind === "ease"
+            ? `var(${t.raw})`
+            : `var(…, ${t.raw})`;
+      })
+      .replace(/§/g, "var(…)")
+      .replace(/\s+/g, " ")
+      .trim();
+    // B8's reading of the clause: a house curve, a bare keyword, or nothing at all.
+    const curve = house
+      ? "house"
+      : BARE_EASE.test(clause.replace(/«\d+»/g, ""))
+        ? "bare"
+        : "none";
+    // THE TERM (§2.2's key) — the property a transition moves, or the keyframes an
+    // animation runs. It survives a retune, which a line number and a millisecond do not:
+    // research §7 row 13 measured `file :: line` colliding 15× and `file :: prop :: ms` 23×
+    // over the same rows, against 0 for `file :: selector :: term`.
+    const term = (/^\s*([A-Za-z-]+)/.exec(pretty)?.[1] ?? "—").trim();
+    seq.forEach((t, i) => {
+      let role = longhand ?? (i === 0 ? "duration" : i === 1 ? "delay" : "extra");
+      // NOT A LENGTH: a `0s` visibility swap, the global PRM nuke's 0.01ms. Six at HEAD.
+      if (role === "duration" && t.kind === "literal" && t.ms <= 1) role = "notALength";
+      out.push({ ...t, role, curve, eases, term, clause: pretty.slice(0, 90) });
+    });
+  }
+  return out;
+}
+
+/**
+ * The rule head this declaration sits under — the other half of §2.2's key. Walked back
+ * from the declaration to its own opening brace, so a selector that moves down the file
+ * keeps its identity and a bank row survives a rebase.
+ *
+ * READ OFF THE MASKED TEXT, NEVER THE ORIGINAL (pass-3 critique §2.1, an experiment, not an
+ * argument). When the nearest delimiter behind a rule fell inside a comment or a Vue
+ * template, the "selector" WAS that prose — 17 of 79 banked keys — so a retuner could shorten
+ * a shipped length by 140ms and REWORD THE SENTENCE ABOVE IT, and the ratchet, whose key had
+ * just changed, said nothing. Two clauses close it: the scan is the comment-masked copy
+ * (offsets preserved), and in a `.vue` file the walk-back may not cross the `<style` boundary
+ * into the template. What text can still move the key — a real selector rewrite — is caught
+ * by B6's ORPHAN clause instead, because a key that vanishes is a key that was edited.
+ */
+function selectorOf(text, at) {
+  const before = text.slice(0, at);
+  const open = before.lastIndexOf("{");
+  if (open < 0) return "—";
+  // never walk back past the block the CSS lives in: `</p> <button v-if="retryable"` is not
+  // a selector, and it was one of the 17.
+  const floor = Math.max(before.lastIndexOf("<style"), 0);
+  const head = before.slice(floor, open);
+  const cut = Math.max(
+    head.lastIndexOf("}"),
+    head.lastIndexOf("{"),
+    head.lastIndexOf(";"),
+  );
+  return (
+    head
+      .slice(cut + 1)
+      .replace(/\/\*[^]*?\*\//g, " ")
+      .replace(/\s+/g, " ")
+      .trim()
+      .slice(0, 80) || "—"
+  );
+}
+
+function collectText(text, rel) {
+  const decls = [];
+  // PROSE IS NOT CODE. Comments are masked to spaces — offsets preserved, so every window
+  // and line number still reads against the ORIGINAL text — before the declaration scan. A
+  // sentence about a 520ms transition is a sentence; the pass-3 parser learned this when its
+  // own docstring about the absence row was read as a live rule spending 520ms.
+  const scan = text.replace(/\/\*[^]*?\*\//g, (m) => m.replace(/[^\n]/g, " "));
+  for (const m of scan.matchAll(DECL)) {
+    const prop = m[1] + m[2];
+    const body = m[3];
+    const line = text.slice(0, m.index).split("\n").length;
+    const before = text.slice(0, m.index);
+    const lineStart = before.lastIndexOf("\n") + 1;
+    const head = text.slice(lineStart, m.index).trim();
+    if (head.startsWith("*") || head.startsWith("//") || head.startsWith("/*"))
+      continue; // prose
+    const pos = positions(prop, body);
+    if (!pos.length) continue;
+    decls.push({
+      file: rel,
+      line,
+      rel: `${rel}:${line}`,
+      selector: selectorOf(scan, m.index),
+      prop,
+      body: body.replace(/\s+/g, " ").trim().slice(0, 120),
+      pos,
+      // the text window an ADMITTED row's anchor is read against
+      window: text.slice(
+        Math.max(0, m.index - ANCHOR_BACK),
+        m.index + body.length + ANCHOR_FWD,
+      ),
+      named: pos.some((p) => p.kind === "rung") || MOTION_TS.test(body),
+      dev: rel.includes("/pencil/dev/"),
+      all: /^transition$/.test(prop) && /^\s*all\b/.test(body),
+    });
+  }
+  return decls;
+}
+
+function collect() {
+  const decls = [];
+  for (const file of walk(SRC))
+    decls.push(...collectText(readFileSync(file, "utf8"), relative(ROOT, file)));
+  return decls;
+}
+
+/** The row of the ledger that admits this position, or null. Content anchored. */
+function admits(d, ms, ledger = LEDGER) {
+  for (const row of ledger)
+    if (
+      // MOVED / RETUNE / DELETED rows admit no literal: their `ms` is the SUBJECT's banked
+      // value (a number), never a list of admitted lengths — B6 reads them, B1 never does.
+      Array.isArray(row.ms) &&
+      row.file === d.file &&
+      row.ms.includes(ms) &&
+      row.anchor &&
+      d.window.includes(row.anchor)
+    )
+      return row;
+  return null;
+}
