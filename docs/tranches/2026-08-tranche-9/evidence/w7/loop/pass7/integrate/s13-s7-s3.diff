+import { test, expect } from '@playwright/test';
+import { encodeSudoku } from './wire';
+
+// PRM: live, because the subject only exists with motion on—under reduce the gallery deals a still
+// poster and never mounts the live face whose fit this row strips; the read is a settled pose.
+
+/**
+ * T9-W7 §13 · GC1, THE `--live-fit` ABLATION, AS A ROW (MOT-LADDER pass 6, row 11; INTAKE row 42).
+ *
+ * The gallery's live face scales the one board by `--live-fit`, a number the face MEASURES and
+ * writes inline on its declaring host (`.live-face-fit`). The @property law's visible-failure
+ * clause: the fit is registered `<number>` at `initial-value: 0` and read BARE, so a fit that was
+ * never measured paints NO board — a failure a reader sees — instead of a full board spilling
+ * out of its slot (the `var(--live-fit, 1)` fallback at 74a2b5d9: 672×672 at 1440). Born RED on
+ * the control; the static half is `lint:bands` B3 (`liveFitLaw`, the initial anchored at 0).
+ *
+ * The row strips the inline fit on the declaring host and reads what PAINTS: the board's box
+ * collapses to nothing and the host's transform is the zero scale. The in-run control is the
+ * same host BEFORE the strip — a published fit, a painted board.
+ */
+// prettier-ignore
+const SOLVED_9 = [
+  5, 3, 4, 6, 7, 8, 9, 1, 2,  6, 7, 2, 1, 9, 5, 3, 4, 8,  1, 9, 8, 3, 4, 2, 5, 6, 7,
+  8, 5, 9, 7, 6, 1, 4, 2, 3,  4, 2, 6, 8, 5, 3, 7, 9, 1,  7, 1, 3, 9, 2, 4, 8, 5, 6,
+  9, 6, 1, 5, 3, 7, 2, 8, 4,  2, 8, 7, 4, 1, 9, 6, 3, 5,  3, 4, 5, 2, 8, 6, 1, 7, 9,
+];
+const BLANKS = new Set([0, 4, 10, 22, 36, 40, 55, 61, 73, 80]);
+const BOARD = encodeSudoku(
+  3,
+  Object.fromEntries(SOLVED_9.map((v, i) => [i, BLANKS.has(i) ? 0 : v])),
+  81,
+);
+
+test('GC1 · an unmeasured fit paints no board (the declaring host stripped of its fit)', async ({
+  page,
+}) => {
+  await page.setViewportSize({ width: 1440, height: 900 });
+  await page.goto('/?game=sudoku&board=' + BOARD);
+  await page.locator('.board-cells').first().waitFor();
+  expect(await page.locator('.board-cells [aria-label*="given clue"]').count()).toBe(71);
+  await page.locator('button.logo-trigger').first().click();
+  const host = page.locator('.live-face-fit').first();
+  await host.waitFor();
+
+  const read = () =>
+    page.evaluate(() => {
+      const fit = document.querySelector('.live-face-fit') as HTMLElement;
+      const board = document.querySelector('.board-peek-host') as HTMLElement | null;
+      const b = board?.getBoundingClientRect();
+      return {
+        inline: fit.style.getPropertyValue('--live-fit').trim(),
+        transform: getComputedStyle(fit).transform,
+        w: b ? Math.round(b.width) : -1,
+        h: b ? Math.round(b.height) : -1,
+      };
+    });
+
+  // THE IN-RUN CONTROL: the host publishes a measured fit and the board paints inside it.
+  await expect.poll(async () => (await read()).inline).not.toBe('');
+  const before = await read();
+  expect(before.w, 'a measured fit paints a board').toBeGreaterThan(50);
+
+  // THE ABLATION: the fit is gone from its one declaring host.
+  await page.evaluate(() =>
+    (document.querySelector('.live-face-fit') as HTMLElement).style.removeProperty('--live-fit'),
+  );
+  await expect.poll(async () => [(await read()).w, (await read()).h]).toEqual([0, 0]);
+  expect((await read()).transform).toMatch(/^matrix\(0, 0, 0, 0,/);
+});
