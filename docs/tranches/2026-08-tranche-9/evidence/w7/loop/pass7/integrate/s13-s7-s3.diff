+  const file = [...texts.keys()].find((f) => f.endsWith("DarkModeToggle.vue"));
+  if (!file)
+    return { ok: false, rows: [{ beat: "—", why: "DarkModeToggle.vue is not here" }] };
+  const raw = raws.get(file);
+  const m = /@toggle-beats\s*(\{[\s\S]*?\})\s*\*\//.exec(raw);
+  if (!m)
+    return {
+      ok: false,
+      rows: [
+        {
+          beat: "—",
+          why: "the gesture carries no beat table. Write it beside the gesture.",
+        },
+      ],
+    };
+  let table;
+  try {
+    table = JSON.parse(m[1]);
+  } catch (e) {
+    return {
+      ok: false,
+      rows: [
+        { beat: "—", why: `the beat table is not readable: ${String(e.message)}` },
+      ],
+    };
+  }
+  const text = texts.get(file);
+  const bad = [];
+  const claimed = []; // the character span of every rule a beat names, for the other direction
+  for (const [beat, want] of Object.entries(table)) {
+    // A selector LIST is one rule written over several lines, which is the estate's idiom:
+    // the table names one member and the rule is whatever that member opens.
+    const at = [`\n${want.selector} {`, `\n${want.selector},`]
+      .map((s) => text.indexOf(s))
+      .find((n) => n >= 0);
