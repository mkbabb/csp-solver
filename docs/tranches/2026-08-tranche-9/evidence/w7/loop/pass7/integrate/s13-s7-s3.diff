+function* walk(dir) {
+  for (const name of readdirSync(dir).sort()) {
+    const p = join(dir, name);
+    if (statSync(p).isDirectory()) {
+      if (NO_DEV && name === "dev") continue;
+      yield* walk(p);
+    } else if (/\.(vue|css|ts|html)$/.test(name)) yield p;
