+  for (let i = 0; i < tokens.length; i++)
+    for (let j = i + 1; j < tokens.length; j++)
+      if (
+        tokens[i][1] === tokens[j][1] &&
+        !DECLARED_DUPLICATES.has(`${tokens[i][0]}=${tokens[j][0]}`)
+      )
+        undeclared.push(
+          `${tokens[i][0]} and ${tokens[j][0]} are the same curve, undeclared`,
+        );
