+      bad.push({
+        beat,
+        why: `the table names ${want.selector}, which is not a rule here`,
+      });
+      continue;
+    }
+    const open = text.indexOf("{", at);
+    const shut = text.indexOf("}", open);
+    claimed.push([open, shut]);
+    const body = text.slice(open, shut);
+    const decl =
+      new RegExp(`transition(?:-delay)?\\s*:\\s*([^;]+);`).exec(body)?.[1] ?? "";
+    const term =
+      terms(decl.replace(/\s+/g, " ")).find((t) => t.includes(want.property)) ?? decl;
+    const times = [...term.matchAll(TIME)].map((t) => {
+      const s = String(t[0]);
+      const rung = /var\(--motion-([a-z]+)/.exec(s);
+      if (rung) return rungs.get(rung[1]) ?? -1;
+      return Number(s.replace(/[^\d.]/g, ""));
+    });
+    const dur = want.delayOnly ? 0 : (times[0] ?? -1);
+    const delay = want.delayOnly ? (times[0] ?? -1) : (times[1] ?? 0);
+    if (dur !== want.duration || delay !== want.delay)
+      bad.push({
+        beat,
+        why: `${want.selector} runs ${dur}ms at ${delay}ms; the beat table says ${want.duration}ms at ${want.delay}ms. Fix the declaration or the table, in the same change.`,
+      });
+  }
+  // THE OTHER DIRECTION (pass 3). Pass 2 read the table and never read the SURFACE, so a beat
+  // could be deleted from the character and the ledger would still pass — the record verifying
+  // the record. The predicate is satisfiable and it is the character's own signature: every
+  // `transition`/`transition-delay` in this file's <style> that carries `!important` outside
+  // `@media (prefers-reduced-motion)` is a beat of the gesture and must be named by the table.
+  // PER DECLARATION, said out loud: the 8 declarations carry 10 property terms, and `tuck`'s
+  // opacity and `star1`'s opacity ride their declaration's beat. Per-TERM completeness would be
+  // born RED at 2 on the surface the owner audited most, which is a U-10 question and not a
+  // thing to ship red.
+  const reduce = [];
+  for (const m of text.matchAll(/@media[^{]*prefers-reduced-motion[^{]*\{/g)) {
+    let depth = 0;
+    for (let i = m.index + m[0].length - 1; i < text.length; i++) {
+      if (text[i] === "{") depth++;
+      else if (text[i] === "}" && --depth === 0) {
+        reduce.push([m.index, i]);
+        break;
+      }
+    }
+  }
+  const unnamed = [];
+  let beatsOnSurface = 0;
+  for (const m of text.matchAll(/transition(?:-delay)?\s*:\s*([^;}]+)[;}]/g)) {
+    if (!/!important/.test(m[1])) continue;
+    if (reduce.some(([a, b]) => m.index > a && m.index < b)) continue;
+    beatsOnSurface++;
+    if (claimed.some(([a, b]) => m.index > a && m.index < b)) continue;
+    const line = text.slice(0, m.index).split("\n").length;
+    const t = [...String(m[1]).matchAll(TIME)].map((x) => String(x[0]));
+    unnamed.push({
+      beat: `${relative(src, file)}:${line}`,
+      why: `has a transition of ${t.join(" then ") || "its own"} that no beat in the table names. Add the beat or remove the declaration, in the same change.`,
+    });
+  }
+  bad.push(...unnamed);
+  return {
+    ok: bad.length === 0,
+    rows: bad,
+    size: Object.keys(table).length,
+    onSurface: beatsOnSurface,
+  };
+}
+
+/** The duplicate-pair row: two published curve tokens may share points only where declared. */
+function duplicatePairs(
+  css = readFileSync(join(ROOT, "src/assets/index.css"), "utf8"),
+) {
+  const tokens = [
+    ...css.matchAll(/^\s*(--(?:ease|verb)-[A-Za-z-]+):\s*(cubic-bezier\([^)]*\));/gm),
+  ].map((m) => [m[1], m[2]]);
