+
+test("COST's lapse returns focus only to a reader still in the question (pass 7)", async ({ page }) => {
+  // The window closing is a timer, not an answer. A reader left on `keep` is handed home to the
+  // verb; a reader who has moved on (focus on a control in the panel, the question still
+  // standing) stays where they went. Pass 6's lapse pulled focus back from `Normal` to `Deal a
+  // new board` 2.5 s later (chromium; the pass-6 critic's §3); the pass-6 dist reds arm 2.
+  await dirtyThenOpen(page);
+  const panel = page.locator(".mobile-control-panel");
+  const deal = panel.getByRole("button", { name: "Deal a new board" });
+  const ribbon = page.locator(".confirm-ribbon");
+  const focused = () =>
+    page.evaluate(() => {
+      const a = document.activeElement;
+      return a?.getAttribute("aria-label") ?? a?.textContent?.trim() ?? null;
+    });
+  const lapsed = async () => {
+    await expect(ribbon).toHaveCount(0, { timeout: 6000 });
+    await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+  };
+
+  // ARM 1 · the reader stays on `keep`: the lapse hands focus home.
+  await deal.focus();
+  await page.keyboard.press("Enter");
+  await expect.poll(focused).toBe("keep");
+  await lapsed();
+  await expect.poll(focused, { message: "arm 1: the lapse hands a reader on keep home" }).toBe("Deal a new board");
+
+  // ARM 2 · the reader moves on while the question stands: the lapse leaves them there.
+  await deal.focus();
+  await page.keyboard.press("Enter");
+  await expect.poll(focused).toBe("keep");
+  await panel.getByRole("button", { name: "Normal", exact: true }).focus();
+  await expect(ribbon, "the question still stands after the reader moves on").toHaveCount(1);
+  await lapsed();
+  expect(await focused(), "arm 2: the lapse must not pull a reader who moved on").toBe("Normal");
+});
