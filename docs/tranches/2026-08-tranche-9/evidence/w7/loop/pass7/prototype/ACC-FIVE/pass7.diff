+  const built = frames.map((d) => {
+    const single = poseIsLinearSinglePath(d);
+    const pts = single ? posePoints(d) : [];
+    const cum: number[] = pts.length ? [0] : [];
+    for (let i = 1; i < pts.length; i++)
