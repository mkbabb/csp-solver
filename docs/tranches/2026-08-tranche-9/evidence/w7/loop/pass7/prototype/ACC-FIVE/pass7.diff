+import { describe, it, expect } from "vitest";
+import { mount } from "@vue/test-utils";
+import HandwrittenGlyph from "./HandwrittenGlyph.vue";
+
+/**
+ * THE PEN'S GUARD (T9-W7 §3, gate G6's unit half).
+ *
+ * The four board goldens render no user digit, so a bitmap cannot guard the one mark a player
+ * makes most — and the chair forbids re-minting a golden inside the loop (§6.4). The guard is
+ * therefore a UNIT row on the RESOLVED stroke of the three kinds of digit the glyph draws, and
+ * it exists because of a specific defect: `HandwrittenGlyph` carried `var(--color-user-ink,
+ * #2563eb)`, a second spelling of the pen that stopped being true the moment the token moved.
+ * A fallback nothing can reach is not a safety net; it is a stale copy waiting to be believed.
+ *
+ * The painted-colour half of G6 is in the browser (the digit reads #026FC4 light / #47A7FF dark
+ * on the byte, 0.17° / 0.11° off crayon-blue); this half asserts that the right TOKEN is asked
+ * for, in every state, with no second spelling anywhere in the component.
+ */
+const BASE = {
+  value: "5",
+  position: 0,
+  boardSize: 9,
+  noiseDelay: 0,
+  isGiven: false,
+  isOverridden: false,
+  isSolved: false,
+  isRevealed: false,
+  isHovered: false,
+};
+
+const strokeOf = (props: Partial<typeof BASE>) =>
+  mount(HandwrittenGlyph, { props: { ...BASE, ...props } })
+    .find("path")
+    .attributes("stroke");
+
+describe("HandwrittenGlyph — whose hand wrote this digit", () => {
+  it("writes a player's digit in --color-user-ink, with NO fallback spelling", () => {
+    const stroke = strokeOf({ isGiven: false });
+    expect(stroke).toBe("var(--color-user-ink)");
+    // the tell the defect left behind: a comma means a second colour is named here
+    expect(stroke).not.toContain(",");
+  });
+
+  it("writes an OVERRIDDEN given in the player's ink too — they wrote it, so it is theirs", () => {
+    expect(strokeOf({ isGiven: true, isOverridden: true })).toBe(
+      "var(--color-user-ink)",
+    );
+  });
+
+  it("leaves an original given in the page's own foreground, never the pen", () => {
+    expect(strokeOf({ isGiven: true })).toBe("var(--color-foreground)");
+  });
+
+  it("gives a solved digit the solver's rainbow, which outranks both", () => {
+    expect(strokeOf({ isGiven: false, isSolved: true })).toBe("url(#solver-ink)");
+  });
+});
