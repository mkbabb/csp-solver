+import { test, expect, type Browser, type Page } from "@playwright/test";
+
+// PRM: frozen — emulateMedia({reducedMotion:'reduce'}) before goto, in `open()` below. The row
+//   reads boxes and one text range, never a tween.
+
+/**
+ * T9-W7 ACC-SIX · THE COUNT YIELDS, AND THE YIELD IS THE LESSON'S END (registry-v6 §2.12).
+ *
+ * The count ("N of M on the board") rides the margin strip's meta line beside the voice for the
+ * first three writes of a deal. Where the strip has no room for both (a phone, a long hint, the
+ * widest 16x16 count) the count must give up its line: the strip stays ONE line, so W2's drawer
+ * tab and everything under the board hold still; and it must not come back on the next short
+ * line, or it blinks press for press (pass 6 painted 1829 -> 0 -> 1852 -> 0 -> 1883 px at 393x699).
+ *
+ * Per cell, both W2 §2.2 phone cells coarse (`hasTouch`, witnessed), on a real 16x16 deal
+ * (`?board=`, 86 givens, 170 writable — the widest count the lesson can print, "3 of 170"):
+ *   1. rest: the strip's height and the tab's y;
+ *   2. the product's hint twice: press 1 names a step, press 2 writes it, the count lays down;
+ *   3. the widest voice the lesson meets, set in the voice's own span ("G goes nowhere else in
+ *      this column", a hidden single's line), so the pair cannot fit at either cell;
+ *   4. the product's hint twice more: a new line, a new write, the lesson still inside its three.
+ * At every pose the count asks for nothing: the strip and the tab read the same with the count
+ * as with the count taken out (±0.5 px; the voice itself may wrap on a real hint at 393, and that
+ * is the note's height, not the count's), and the count is absent or on the voice's row. After pose 3 the count is gone and stays gone.
+ * Witnessed on green: the count WAS laid down (pose 2), so the row never passes on a board
+ * that simply never showed one.
+ *
+ * BORN-RED (the negative controls, run against the same tree served with one in-memory rewrite,
+ * `pass7/prototype/ACC-SIX/instruments/plant.mts`): the yield's report deleted reds the row on
+ * the count's row (it wraps to row two, below the strip); the pass-6 yield (the report deleted,
+ * the clip back) reds it on the return; and the report deleted with the meta's zero height
+ * undone reds it on the strip and the tab (+18.18 px, W2's ±9.1 each way).
+ */
+
+const cells = [
+  { name: "393x699", viewport: { width: 393, height: 699 } },
+  { name: "812x375", viewport: { width: 812, height: 375 } },
+];
+
+// A REAL 16x16 payload: a valid solved grid by the band pattern, 86 givens seeded, 170 writable.
+function mulberry(a: number) {
+  return () => {
+    a |= 0;
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+const SOL16 = Array.from({ length: 256 }, (_, i) => {
+  const r = Math.floor(i / 16);
+  return ((4 * (r % 4) + Math.floor(r / 4) + (i % 16)) % 16) + 1;
+});
+const KEEP16 = (() => {
+  const rnd = mulberry(20260923);
+  const idx = [...Array(256).keys()];
+  for (let i = 255; i > 0; i--) {
+    const j = Math.floor(rnd() * (i + 1));
+    [idx[i], idx[j]] = [idx[j], idx[i]];
+  }
+  return new Set(idx.slice(0, 86));
+})();
+const PUZ16 = SOL16.map((v, i) => (KEEP16.has(i) ? v.toString(36) : "0")).join("");
+const BOARD16 =
+  "?board=" +
+  btoa(String.fromCharCode(1) + "4." + PUZ16)
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+const WIDEST_VOICE = "G goes nowhere else in this column";
+
+type Pose = {
+  strip: number;
+  tabY: number | null;
+  /** the same pose with the count taken out (`display: none` on the meta line): the count's
+   *  own contribution is `strip - stripNoCount`, one variable, whatever the voice does */
+  stripNoCount: number;
+  tabYNoCount: number | null;
+  voice: string;
+  meta: string | null;
+  metaRow2: boolean;
+  coarse: boolean;
+};
+const SNAP = (): Pose => {
+  const r2 = (n: number) => Math.round(n * 100) / 100;
+  const stripH = () => r2(document.querySelector(".board-margin")?.getBoundingClientRect().height ?? -1);
+  const tabAt = () => {
+    const t = document.querySelector(".drawer-tab");
+    return t ? r2(t.getBoundingClientRect().y + scrollY) : null;
+  };
+  const strip = stripH();
+  const tabY = tabAt();
+  const m0 = document.querySelector<HTMLElement>(".margin-note-meta");
+  m0?.style.setProperty("display", "none");
+  const stripNoCount = stripH();
+  const tabYNoCount = tabAt();
+  m0?.style.removeProperty("display");
+  const voice = document.querySelector(".margin-note");
+  const meta = document.querySelector(".margin-note-meta");
+  let metaRow2 = false;
+  if (meta && voice) {
+    const r = document.createRange();
+    r.selectNodeContents(meta);
+    const t = r.getBoundingClientRect();
+    const v = voice.getBoundingClientRect();
+    metaRow2 = t.top > v.top + v.height / 2;
+  }
+  return {
+    strip,
+    tabY,
+    stripNoCount,
+    tabYNoCount,
+    voice: voice?.textContent?.trim() ?? "",
+    meta: meta?.textContent?.trim() ?? null,
+    metaRow2,
+    coarse: matchMedia("(pointer: coarse)").matches,
+  };
+};
+/** A pose is read when two consecutive reads agree (the dock sheet slides ~700 ms). */
+async function settled(page: Page): Promise<Pose> {
+  let prev = "";
+  let pose!: Pose;
+  await expect
+    .poll(
+      async () => {
+        pose = await page.evaluate(SNAP);
+        const k = JSON.stringify(pose);
+        const same = k === prev;
+        prev = k;
+        return same;
+      },
+      { intervals: [250], timeout: 15000 },
+    )
+    .toBe(true);
+  return pose;
+}
+async function open(browser: Browser, viewport: { width: number; height: number }) {
+  const ctx = await browser.newContext({ viewport, hasTouch: true, isMobile: false });
+  const page = await ctx.newPage();
+  await page.emulateMedia({ reducedMotion: "reduce" });
+  await page.goto("/" + BOARD16);
+  await page.waitForSelector(".sudoku-cell", { timeout: 60000 });
+  return { ctx, page };
+}
+/** The product's own hint, as `fillByHint` presses it (the first live match in the DOM). */
+const hint = (page: Page) =>
+  page.evaluate(() => {
+    const b = document.querySelector<HTMLButtonElement>('[aria-label*="Hint" i]:not([disabled])');
+    b?.click();
+    return !!b;
+  });
+const written = (page: Page) =>
+  page.evaluate(() =>
+    Number(document.querySelector('[role="progressbar"]')?.getAttribute("aria-valuetext")?.split(" ")[0] ?? -1),
+  );
+
+for (const cell of cells) {
+  test(`the count yields its line and does not come back · ${cell.name} coarse`, async ({
+    browser,
+  }) => {
+    test.setTimeout(120000);
+    const { ctx, page } = await open(browser, cell.viewport);
+    const rest = await settled(page);
+    expect(rest.coarse, "the coarse regime is witnessed").toBe(true);
+    expect(rest.meta, "no count before the first write").toBe(null);
+
+    // press 1 names, press 2 writes: the count lays down on the 0 -> 1 write
+    for (let k = 0; k < 2; k++) {
+      expect(await hint(page)).toBe(true);
+      await expect.poll(() => written(page), { timeout: 10000 }).toBeGreaterThanOrEqual(k);
+      await settled(page);
+    }
+    await expect.poll(() => written(page), { timeout: 10000 }).toBe(1);
+    const laid = await settled(page);
+    expect(laid.meta, "the count was laid down (the row's witness)").toMatch(/^1 of 170 on the board$/);
+    const poses: Array<[string, Pose]> = [["laid", laid]];
+
+    // the widest voice the lesson meets, in the voice's own span
+    // (the voice is silent after a write, so the line is SET as the product sets one: a fresh
+    // `.margin-note-ink` span in the live region, wearing the component's scope attribute)
+    await page.evaluate((line) => {
+      const p = document.querySelector(".margin-note");
+      if (!p) return;
+      p.querySelectorAll(".margin-note-ink").forEach((x) => x.remove());
+      const ink = document.createElement("span");
+      ink.className = "margin-note-ink";
+      for (const a of p.getAttributeNames()) if (a.startsWith("data-v-")) ink.setAttribute(a, "");
+      ink.textContent = line;
+      p.appendChild(ink);
+    }, WIDEST_VOICE);
+    const yielded = await settled(page);
+    poses.push(["widest", yielded]);
+    // soft from here: a broken tree shows EVERY clause it breaks, not the first
+    expect.soft(yielded.meta, "the count yields beside the widest voice").toBe(null);
+
+    // two more presses: a new line and a new write, still inside the lesson's three writes
+    for (let k = 0; k < 2; k++) {
+      expect(await hint(page)).toBe(true);
+      poses.push([`press${k + 3}`, await settled(page)]);
+    }
+    expect(await written(page), "the lesson is still inside its three writes").toBeLessThan(3);
+
+    for (const [name, p] of poses) {
+      // the count asks the strip for nothing: the pose with it equals the pose without it
+      expect.soft(Math.abs(p.strip - p.stripNoCount), `${name}: the count adds no height to the strip`).toBeLessThanOrEqual(0.5);
+      expect.soft(Math.abs((p.tabY ?? 0) - (p.tabYNoCount ?? 0)), `${name}: W2's tab does not move for the count`).toBeLessThanOrEqual(0.5);
+      expect.soft(p.metaRow2, `${name}: the count never paints on a second row, below the strip`).toBe(false);
+    }
+    for (const [name, p] of poses.slice(1))
+      expect.soft(p.meta, `${name}: once yielded the count stays gone (no blink)`).toBe(null);
+    console.log(
+      `YIELD ${cell.name}: rest strip ${rest.strip} tab ${rest.tabY} · ` +
+        poses
+          .map(([n, p]) => `${n} strip ${p.strip}/${p.stripNoCount} tab ${p.tabY}/${p.tabYNoCount} meta ${p.meta ?? "-"}${p.metaRow2 ? " ROW2" : ""}`)
+          .join(" · "),
+    );
+    await ctx.close();
+  });
+}
