+  [2, 860],
+  [3, 1000],
+] as const) {
+  test(`15 · open at 390×${from}, resize to 390×664 at rest: the open sheet reads what a fresh open there reads (${n} at the table)`, async ({
+    browser,
+  }, info) => {
+    test.slow();
+    const ctx = await browser.newContext({
+      viewport: { width: 390, height: from },
+      hasTouch: true,
+      isMobile: true,
+      deviceScaleFactor: 1,
+    });
+    const pages = await table(ctx, n);
+    const [a] = pages;
+    expect(await a.evaluate(() => matchMedia('(pointer: coarse)').matches)).toBe(true);
+    await a.bringToFront();
+    // the dock SLIDES shut after the invite: the board's settled pose is its own box holding still
+    await stable(() => cell(a, 0).evaluate((e) => e.getBoundingClientRect().top));
+    await mark(a).tap();
+    await expect(mark(a)).toHaveAttribute('aria-expanded', 'true');
+    await stable(() => lapRead(a));
+    const opened = await lapRead(a);
+    expect(opened, `390×${from}: the sheet opens clear of the board`).toMatchObject({ open: true, lapped: 0 });
+    await a.setViewportSize({ width: 390, height: 664 });
+    await expect.poll(() => a.evaluate(() => innerHeight)).toBe(664);
+    await stable(() => lapRead(a));
+    const atRest = await lapRead(a);
+    await mark(a).tap();
+    await expect(mark(a)).toHaveAttribute('aria-expanded', 'false');
+    await mark(a).tap();
+    await expect(mark(a)).toHaveAttribute('aria-expanded', 'true');
+    await stable(() => lapRead(a));
+    const fresh = await lapRead(a);
+    info.annotations.push({ type: 'resize', description: JSON.stringify({ opened, atRest, fresh }) });
+    expect(fresh.lapped, 'at 390×664 the sheet laps the board in every arm').toBeGreaterThan(0);
+    expect(atRest, 'at rest after the resize = a fresh open at 390×664').toEqual(fresh);
+    await ctx.close();
