+// ── 15 · OPEN, THEN RESIZE AT REST (pass-6 critic 1.1; LAWS P6 §D) ──────────────────────────────
+// The sheet's regime (how many rows; under `CHART_YIELDS`, whether the chart is drawn) is decided
+// by a measurement, so the measurement is taken again when the space changes under an open sheet.
+// The row is arm-agnostic: whatever the arm decides on a FRESH open at the new size is what the
+// open sheet must read once the resize has come to rest. Two cells: two at the table, opened at
+// 390×860 where the chart laps nothing (the yield's cell: it keeps the chart there and must give it
+// up at 390×664), and three at the table, opened at 390×1000 (the chart arm's cell: three rows
+// there, one row and `and 2 more` at 390×664). The negative control is a file plant (the resize
+// listener struck): the open sheet then keeps the pose it opened on.
+const lapRead = (p: Page) =>
+  sheet(p).evaluate((el) => {
+    const s = el.getBoundingClientRect();
+    const cells = [...document.querySelectorAll('.sudoku-cell')]
+      .map((c) => c.getBoundingClientRect())
+      .filter((c) => c.width > 0);
+    const top = Math.min(...cells.map((c) => c.top));
+    const lapped = cells.filter(
+      (c) => c.left < s.right && c.right > s.left && c.top < s.bottom && c.bottom > s.top,
+    ).length;
+    return {
+      open: el.classList.contains('is-open'),
+      rows: el.querySelectorAll('.pl-row').length,
+      chart: !!el.querySelector('.place-chart'),
+      lap: lapped ? Math.round(Math.max(0, s.bottom - top) * 10) / 10 : 0,
+      lapped,
+    };
+  });
+
