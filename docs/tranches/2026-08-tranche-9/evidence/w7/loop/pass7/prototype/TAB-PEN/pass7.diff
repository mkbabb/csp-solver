index 00000000..79104d3e
--- /dev/null
+++ b/web/frontend/scripts/check-favicon.mjs
@@ -0,0 +1,748 @@
+#!/usr/bin/env node
+/**
+ * THE FAVICON GATE (T9-M22, TAB-PEN). The tab's s is one pen line on the page's paper, in the page's
+ * ink. It reads the SHAPE, not the spelling (LAWS P6 §F): the markup against an allowlist, every
+ * `<style>` rule in source order with the last one winning, every colour through the estate's one
+ * parser (`shape-census.mjs`, scored by ΔE), and the touch icon's own pixels. Browserless.
+ *
+ *   a  the markup     exactly one each of svg, style, rect, path, and nothing else: no comment, no
+ *                     entity, no second element, no attribute outside the allowlist (so no filter,
+ *                     clip, rx/ry, transform, opacity, style="", dasharray). viewBox `0 0 32 32`; the
+ *                     rect covers it at 0,0; the rect is painted before the path.
+ *   b  one pen line   the path: fill none, round caps and joins, stroke-width a bare number in
+ *                     [3.6, 5.2] of the 32 viewBox. The `<style>` body holds `rect{fill}` and
+ *                     `path{stroke}` only, at the top level or inside `@media (prefers-color-scheme:
+ *                     dark)`; no other property, selector, at-rule or !important. <= 600 B.
+ *   c  the page's     the painted fill and stroke, resolved per scheme through the cascade (the
+ *      colours        attributes, then every rule in source order), are the page's
+ *                     --color-background / --color-foreground (ΔE <= 0.5, opaque) in light and in
+ *                     dark. The tokens are read at EVERY site they're declared (src CSS, SFC styles,
+ *                     public CSS, index.html, script writes); a site outside `@theme` and `.dark` is
+ *                     RED until this gate is taught it. Ink over paper >= 7:1 in each scheme.
+ *   d  the pen's box  the exact extrema bbox inflated by half the pen is within [0.55, 0.80] of the
+ *                     tile per axis, centred within 0.5 unit, and stroke / (bbox H + stroke) is in
+ *                     [0.15, 0.17]. That window is a TAB-SIZE LEGIBILITY window (2 px at 16 px), not
+ *                     the digits' line: the board's digits paint stroke/H 0.103-0.115 and the wordmark's
+ *                     skeleton median is 0.171 (spine 0.40). The census's "0.156" was wrong at the source.
+ *   e  the estate     index.html links /icon.svg and /apple-touch-icon.png; favicon.svg is gone (the
+ *                     rename busts the favicon store); scripts/icons.provenance.json carries both
+ *                     files' sha256 (icons.mjs writes it); the PNG decodes to 180 x 180, opaque, its
+ *                     paper the light token (ΔE <= 2), its ink coverage in [0.18, 0.32] and its
+ *                     darkest pixel the light ink (ΔE <= 4). A PNG that isn't the s reds on content,
+ *                     whatever the sidecar says.
+ *
+ * `--self-test` plants defects in memory; each must RED exactly its clause set, and the two
+ * negative-negatives (the same ink spelled another way, a decoy rule inside a comment) must stay GREEN.
+ * Run: `node scripts/check-favicon.mjs [--self-test] [--root <web/frontend dir>]`, cwd web/frontend.
+ */
+import { createHash } from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+import process from "node:process";
+import zlib from "node:zlib";
+import {
+  cssRules,
+  deltaE,
+  parseColor,
+  resolve,
+  scriptWrites,
+  sfc,
+  sources,
+  stripCss,
+} from "./shape-census.mjs";
+
+const argRoot = process.argv.indexOf("--root");
+const ROOT =
+  argRoot > 0
+    ? path.resolve(process.argv[argRoot + 1])
+    : path.join(import.meta.dirname, "..");
+const TOKENS = ["--color-background", "--color-foreground"];
+const sha256 = (b) => createHash("sha256").update(b).digest("hex");
+
+/* ── colour ─────────────────────────────────────────────────────────────────── */
+const lum = ({ rgb }) =>
+  rgb
+    .map((v) => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4))
+    .reduce((s, v, i) => s + v * [0.2126, 0.7152, 0.0722][i], 0);
+const contrast = (a, b) => {
+  const [hi, lo] = [lum(a), lum(b)].sort((p, q) => q - p);
+  return (hi + 0.05) / (lo + 0.05);
+};
+const opaque = (c) => c && (c.a ?? 1) >= 0.999;
+
+/** Every site the page's two tokens are declared, keyed light (@theme) / dark (.dark) / unplaced. */
+function tokenSites(files) {
+  const sites = [];
+  for (const { file, text } of files) {
+    const blocks = file.endsWith(".vue")
+      ? sfc(text).styles.map((b) => b.css)
+      : file.endsWith(".css")
+        ? [text]
+        : file.endsWith(".html")
+          ? [...text.matchAll(/<style[^>]*>([\s\S]*?)<\/style>/g)].map((m) => m[1])
+          : [];
+    for (const css of blocks)
+      for (const r of cssRules(css))
+        for (const d of r.decls)
+          if (TOKENS.includes(d.prop)) {
+            const home =
+              !r.ctx.length && r.prelude === "@theme"
+                ? "light"
+                : !r.ctx.length && r.prelude === ".dark"
+                  ? "dark"
+                  : null;
+            sites.push({ file, home, where: [...r.ctx, r.prelude].join(" "), ...d });
+          }
+    if (/\.(vue|[cm]?[jt]sx?|html)$/.test(file))
+      for (const prop of TOKENS)
+        for (const w of scriptWrites(text, prop))
+          if (!w.unresolved)
+            sites.push({ file, home: null, where: w.kind, prop, value: w.value });
+  }
+  const map = new Map(sites.map((s) => [s.prop, s.value]));
+  const tok = { light: {}, dark: {} };
+  for (const s of sites)
+    if (s.home) tok[s.home][s.prop] = parseColor(resolve(s.value, map));
+  return { sites, tok };
+}
+
+/* ── the markup ─────────────────────────────────────────────────────────────── */
+const ALLOWED = {
+  svg: ["xmlns", "viewBox"],
+  style: [],
+  rect: ["width", "height", "fill", "x", "y"],
+  path: ["d", "fill", "stroke", "stroke-width", "stroke-linecap", "stroke-linejoin"],
+};
+function parseSvg(svg) {
+  const els = [];
+  let styleText = "";
+  const rest = svg;
+  const tag =
+    /<(\/?)([A-Za-z][\w:.-]*)((?:\s+[^\s=>/]+\s*=\s*(?:"[^"]*"|'[^']*'))*)\s*(\/?)>/y;
+  const junk = [];
+  let i = 0;
+  let inStyle = false;
+  while (i < rest.length) {
+    if (inStyle) {
+      const end = rest.indexOf("</style>", i);
