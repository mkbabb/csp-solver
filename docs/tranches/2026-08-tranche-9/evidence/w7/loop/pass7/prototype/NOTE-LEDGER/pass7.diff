+/** HTML/template: removes <!-- … --> (attribute values never open one: `<!--` only starts outside a tag). */
+/** @public — the library's API (LAWS P6 §I: one copy every gate imports) */
+export function stripHtml(s) {
+  let o = "",
+    inTag = false,
+    q = null;
+  for (let i = 0; i < s.length; i++) {
+    const c = s[i];
+    if (inTag) {
+      if (q) {
+        if (c === q) q = null;
+      } else if (c === '"' || c === "'") q = c;
+      else if (c === ">") inTag = false;
+      o += c;
+      continue;
+    }
+    if (s.startsWith("<!--", i)) {
+      const e = s.indexOf("-->", i + 4);
+      const end = e < 0 ? s.length : e + 3;
+      o += s.slice(i, end).replace(/[^\n]/g, " ");
