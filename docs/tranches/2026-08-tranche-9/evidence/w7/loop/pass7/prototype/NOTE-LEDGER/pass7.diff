+++ b/web/frontend/src/pencil/chrome/MarginNote.test.ts
@@ -0,0 +1,73 @@
+import { describe, it, expect, vi, afterEach } from "vitest";
+import { mount } from "@vue/test-utils";
+import { nextTick } from "vue";
+import MarginNote from "./MarginNote.vue";
+
+/**
+ * T9-W7 §7 — THE PUSH, gated where CI can see it.
+ *
+ * The cure was a probe reading with nothing shipping behind it (pass-5 critique §2.1): the push
+ * re-darkened a spent record for one rung. This row reads the push's keyframe 0 through a
+ * stubbed `animate`. The reserve the push reads its `from` out of is a SOURCE row and lives in
+ * `scripts/check-ink-pressure.mjs` (the note's reserve, on the shape-census library), because
+ * it must read every stylesheet in the tree and `src/**` is typechecked without node types.
+ */
+
+// The two inks the push can start from, painted by a sheet jsdom cascades (VTU injects no SFC
+// styles). Distinct values, so the row reads which one keyframe 0 took.
+const SPENT_INK = "rgb(1, 2, 3)";
+const GRAPHITE = "#0a0b0c"; // a custom property reads back as authored
+function paint() {
+  const sheet = document.createElement("style");
+  sheet.textContent =
+    `.margin-note.is-spent { color: ${SPENT_INK}; }` +
+    `.margin-note-previous { --color-pencil-graphite: ${GRAPHITE}; color: rgb(4, 5, 6); }`;
+  document.head.append(sheet);
+  return sheet;
+}
+
+const realAnimate = Element.prototype.animate;
+afterEach(() => {
+  Element.prototype.animate = realAnimate;
+  document.head.querySelectorAll("style").forEach((s) => s.remove());
+});
+
+async function push(spent: boolean) {
+  paint();
+  const calls: Keyframe[][] = [];
+  // jsdom has no WAAPI: the stub records the call and returns nothing the watch reads.
+  Element.prototype.animate = vi.fn(function (kf: Keyframe[]) {
+    calls.push(kf);
+    return {} as Animation;
+  }) as unknown as typeof Element.prototype.animate;
+  const w = mount(MarginNote, {
+    props: { text: "only 4 fits here", seq: 1, spent },
+    attachTo: document.body,
+  });
+  await w.setProps({
+    text: "only 2 fits here",
+    seq: 2,
+    spent: false,
+    previous: "only 4 fits here",
+    previousSeq: 1,
+  });
+  await nextTick();
+  w.unmount();
+  return calls;
+}
+
+describe("MarginNote — the push starts from the ink the record was painted in", () => {
+  it("a SPENT record ages from its own quiet ink, never back up to full graphite", async () => {
+    const calls = await push(true);
+    expect(calls, "one push per displacement").toHaveLength(1);
+    expect(calls[0][0].color, "keyframe 0 is the displaced line's painted ink").toBe(
+      SPENT_INK,
+    );
+  });
+
+  it("an open record ages from full graphite, as it always has", async () => {
+    const calls = await push(false);
+    expect(calls).toHaveLength(1);
+    expect(calls[0][0].color).toBe(GRAPHITE);
+  });
+});
