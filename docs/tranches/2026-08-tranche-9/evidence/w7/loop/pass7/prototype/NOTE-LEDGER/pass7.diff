@@ -0,0 +1,34 @@
+/**
+ * ⚠ §13's (MOT-LADDER), BORROWED — NOT THIS FAMILY'S CUT. Deleted whole when §13 folds.
+ *
+ * §7's prototype consumes two rungs and needs a clock to measure. §13's own pass-3 spec puts
+ * the ladder's registration and its one publisher here-ish (a `<style data-motion-rungs>` node
+ * written before mount); this file is the smallest thing that stands in for it, with §13's row
+ * E honoured exactly: the `@property` registration carries `initial-value: 0ms`, so an ABSENT
+ * publisher reads "every rung instant" and the born-RED row (L13) reds, rather than a `, 250ms`
+ * fallback masking it (chair §6.5: one home, no fallback).
+ *
+ * The reduce arm publishes the same `0ms` the absence reads: PRM and a broken publisher land on
+ * the same page, which is the safe one.
+ */
+import { MOTION } from "./pencilConfig";
+
+const RUNGS = Object.entries(MOTION.rungs) as [string, number][];
+
+/** Synchronously, before first paint — a rung read at computed-value time must already exist.
+ *
+ *  The CSS text was a second exported function in pass 3 with no caller but this one, which is
+ *  `lint:knip` exit 1 (an unused export is a consumer-less substrate, the estate's own rule).
+ *  Inlined: one export, one consumer. */
+export function publishMotionRungs(doc: Document = document): void {
+  if (doc.querySelector("style[data-motion-rungs]")) return;
+  const reg = RUNGS.map(
+    ([n]) => `@property --motion-${n}{syntax:"<time>";inherits:true;initial-value:0ms}`,
+  ).join("");
+  const vals = RUNGS.map(([n, ms]) => `--motion-${n}:${ms}ms`).join(";");
+  const zero = RUNGS.map(([n]) => `--motion-${n}:0ms`).join(";");
+  const style = doc.createElement("style");
+  style.setAttribute("data-motion-rungs", "");
+  style.textContent = `${reg}:root{${vals}}@media (prefers-reduced-motion:reduce){:root{${zero}}}`;
+  doc.head.append(style);
+}
