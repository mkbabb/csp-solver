+import { describe, it, expect } from "vitest";
+import { mount } from "@vue/test-utils";
+import HandwrittenGlyph from "./HandwrittenGlyph.vue";
+
+/**
+ * AUTHORSHIP IS WEIGHT, AND A CARET HAS NO AUTHOR (T9-W7 ACC-GRAPHITE). A printed digit draws
+ * heavier than one you wrote; a caret (the wordmark's `>`, futoshiki's `<`/`>`) keeps the weight
+ * it always had, because no caret has a written twin to be told from. The logo golden cannot see
+ * `span.logo-caret`, so this row is the one that holds the caret's weight.
+ */
+const weight = (value: string, isGiven: boolean, isSolved = false) =>
+  mount(HandwrittenGlyph, {
+    props: {
+      value,
+      isGiven,
+      isOverridden: false,
+      isSolved,
+      isRevealed: true,
+      noiseDelay: 0,
+      position: 0,
+      boardSize: 9,
+      isHovered: false,
+    },
+  })
+    .find("path")
+    .attributes("stroke-width");
+
+describe("HandwrittenGlyph — the stroke weight is authorship", () => {
+  it("draws a printed digit at 6 and a written one at 4.5", () => {
+    expect(weight("5", true)).toBe("6");
+    expect(weight("5", false)).toBe("4.5");
+  });
+
+  it("keeps a printed caret at 5, both directions", () => {
+    expect(weight(">", true)).toBe("5");
+    expect(weight("<", true)).toBe("5");
+  });
+
+  it("keeps the solver's answer at 5", () => {
+    expect(weight("5", false, true)).toBe("5");
+  });
+});
