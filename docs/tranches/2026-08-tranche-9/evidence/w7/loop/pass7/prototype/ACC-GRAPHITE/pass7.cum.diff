+  let landed = -Infinity; // when the last re-cut reached the DOM (read after the render's flush)
+  let owed: { v: number } | null = null;
+  let timer: ReturnType<typeof setTimeout> | null = null;
+  const floor = () => FRONT_MIN_MS + (wholeMsClock ? 1 : 0);
+  const cancel = () => {
+    owed = null;
+    if (timer !== null) clearTimeout(timer);
+    timer = null;
+  };
+  const land = (v: number, now: number) => {
+    cancel();
+    last = now;
+    commit(v);
+    // queued after the render's flush (the commit queued it), so this reads the landing
+    queueMicrotask(() => (landed = readClock()));
+  };
+  const from = (force: boolean) => (force ? Math.max(last, landed) : last);
+  const flush = () => {
+    timer = null;
+    if (!owed) return;
+    const now = readClock();
+    const wait = from(true) + floor() - now;
+    if (wait > 0) timer = setTimeout(flush, wait);
+    else land(owed.v, now);
+  };
