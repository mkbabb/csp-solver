+
+/**
+ * LAW A, ON THE EXPORT THE BOARD RUNS (T9-W7 ACC-GRAPHITE). `HandDrawnGrid` renders
+ * `tallyPaths(traceFrames, writable, written)` and nothing else, so these rows hold the law
+ * where it lives: no constant or formula is restated here. The row that matters is the
+ * DISCONTINUITY — the integer form (`k = ceil(written / ceil(writable/slots))`) fills 56 ticks
+ * at writable 56 and 29 at writable 57 on a 9x9 frame of 56 slots.
+ */
+const RING = generateFrameTraceFrames(
+  1000,
+  42,
+  BOIL_CONFIG.frameCount,
+  BOIL_CONFIG.frameBoil,
+  FILTER_PRESETS["grain-static"]?.grain,
+);
+const ticks = (d: string) => (d.match(/M/g) ?? []).length;
+const counts = (writable: number, written: number) =>
+  tallyPaths(RING, writable, written).map(ticks);
+
+describe("tallyPaths — LAW A, one mark, every board", () => {
+  it("has NO discontinuity at the slot boundary — 56, 57 and 58 writable all fill 56 ticks", () => {
+    for (const writable of [56, 57, 58])
+      expect(counts(writable, writable)).toEqual([56, 56, 56, 56]);
+  });
+
+  it("counts one tick per cell while the frame can hold them, on every pose", () => {
+    for (const [writable, written] of [
+      [4, 1],
+      [4, 4],
+      [9, 9],
+      [20, 3],
+      [20, 20],
+      [46, 46],
+    ] as const)
+      expect(counts(writable, written)).toEqual([written, written, written, written]);
+  });
+
+  it("scales the count into the frame's slots on a board too big to hold one per cell", () => {
+    for (const writable of [64, 146, 172, 240]) {
+      expect(counts(writable, writable)).toEqual([56, 56, 56, 56]);
+      expect(counts(writable, Math.round(writable / 2))).toEqual([28, 28, 28, 28]);
+    }
+  });
+
+  it("rounds a fractional count to the NEAREST tick, never down or up (non-integer ratios)", () => {
+    // 57 writable cells on 56 slots: one written cell is 0.98 of a tick and draws ONE (floor
+    // draws none, so the first cell you write would leave no mark); 29 is 28.49 and draws 28
+    // (ceil draws 29). On 146 cells, 99 is 37.97 and draws 38 (floor draws 37).
+    for (const [writable, written, k] of [
+      [57, 1, 1],
+      [57, 29, 28],
+      [146, 99, 38],
+      [146, 3, 1],
+    ] as const)
+      expect(counts(writable, written)).toEqual([k, k, k, k]);
+  });
+
+  it("cuts every tick at LAW A's 45 units of ink, whatever the board", () => {
+    for (const [writable, written] of [
+      [4, 4],
+      [20, 20],
+      [57, 57],
+      [172, 172],
+    ] as const) {
+      for (const tick of tallyPaths(RING, writable, written)[0].split("M").slice(1)) {
+        const pts = (tick.match(/-?[\d.]+,-?[\d.]+/g) ?? []).map((s) =>
+          s.split(",").map(Number),
+        );
+        let len = 0;
+        for (let i = 1; i < pts.length; i++)
+          len += Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]);
+        expect(len).toBeGreaterThan(44.5);
+        expect(len).toBeLessThan(45.5);
+      }
+    }
+  });
