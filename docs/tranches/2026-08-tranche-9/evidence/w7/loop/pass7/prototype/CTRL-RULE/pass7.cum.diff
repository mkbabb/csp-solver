+ *
+ * WHY `keep` IS DRAWN TOO. The obvious cut is a bare `keep` against a boxed verb — one frame,
+ * maximum contrast between the answers. CTRL-RULE measured the cost: R6 law L5 (the gallery's
+ * `keep` keeps its outline) flips RED at 422 characters against a 400-character window if the
+ * word goes bare. Both answers drawn, ranked by stroke, buys the same discrimination inside
+ * the law instead of against it.
+ *
+ * THE TAP FLOOR is W2's token and both answers clear it on both dimensions.
+ */
+import HandDrawnOutline from "@pencil/grid/HandDrawnOutline.vue";
+import { onMounted, useTemplateRef } from "vue";
+
+const props = defineProps<{
+  /** The sentence. M16: the player's words for the act, ending in a question mark. */
+  ask: string;
+  /** The destructive answer's word — the verb's own name, lowercase by the case's voice. */
+  verb: string;
+  /**
+   * TRUE only when the arm came from the KEYBOARD. A pointer arm must move no focus: the
+   * finger is already where the answer is, and moving focus on WebKit costs a `focusout` that
+   * the two-tap's own disarm then reads as a departure — the measured reason press 2 never
+   * fired there. A keyboard arm has the opposite need: the reader cannot see where to press
+   * next unless focus goes somewhere, and it goes to `keep`, never to the destructive answer,
+   * so a second Enter can only ever CANCEL.
+   */
+  autofocus?: boolean;
+}>();
+
+const emit = defineEmits<{ keep: []; go: [] }>();
+
+const keepEl = useTemplateRef<HTMLButtonElement>("keepEl");
+
+onMounted(() => {
+  // `preventScroll` because the foot is at the bottom of a scrollport: a plain focus() there
+  // scrolls the card to bring the ribbon into view, and the card has already been measured at
+  // a scroll offset this press must not change.
+  if (props.autofocus) keepEl.value?.focus({ preventScroll: true });
+});
+</script>
+
+<template>
+  <!-- No `role="alertdialog"`, no `aria-modal`. A group with the sentence as its name says
+       exactly what is true: two controls that belong together, named by the question. The
+       sentence is rendered text AND the group's name, so nothing is announced twice. -->
+  <div class="confirm-ribbon" role="group" :aria-label="ask">
+    <span class="confirm-ask">{{ ask }}</span>
+    <div class="confirm-answers">
+      <button
+        ref="keepEl"
+        type="button"
+        class="confirm-answer confirm-keep"
+        @click="emit('keep')"
+      >
+        <HandDrawnOutline
+          :stroke-width="1.5"
+          :outset="4"
+          :radius="0"
+          :pose="0"
+          aria-hidden="true"
+        />
+        <span>keep</span>
+      </button>
+      <button type="button" class="confirm-answer confirm-go" @click="emit('go')">
+        <HandDrawnOutline
+          :stroke-width="2.5"
+          :outset="4"
+          :radius="0"
+          :pose="0"
+          aria-hidden="true"
+        />
+        <span>{{ verb }}</span>
+      </button>
+    </div>
+  </div>
+</template>
+
+<style scoped>
+/* FULL WIDTH OF ITS ROW is the geometry that closes RULE's ∩ 0.395: a ribbon that is narrower
+   than its row leaves a live control beside it on the same baseline, and a reader's thumb finds
+   both. The row is the ribbon's while the question stands. */
+.confirm-ribbon {
+  display: flex;
+  width: 100%;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem;
+  padding-block: 0.35rem;
+}
+
+.confirm-ask {
+  font-family: var(--font-hand);
+  font-size: var(--type-verb);
+  line-height: var(--type-leading-heading);
+  text-transform: lowercase;
+  color: var(--color-foreground);
+  /* The sentence yields before the answers do — the answers carry the tap floor. */
+  min-width: 0;
+}
+
+.confirm-answers {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  flex: none;
+}
+
+/* Bare card under both answers (law 17's sibling: the rank is the WEIGHT, never a fill), and
+   the frame is a child at `inset: 0` — the estate's own `HandDrawnOutline` idiom, so the drawn
+   box cannot become the button's containing block and pin it to its own height. */
+.confirm-answer {
+  position: relative;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  /* BARE (§6.5; CTRL-COST's graft): `--tap-floor` is declared once at `.page-root`, so a
+     fallback here could only ever hide its absence. */
+  min-width: var(--tap-floor);
+  min-height: var(--tap-floor);
+  padding-inline: 0.75rem;
+  background: none;
+  border: 0;
+  font-family: var(--font-hand);
+  font-size: var(--type-verb);
+  line-height: 1;
+  letter-spacing: var(--type-tracking-wide);
+  text-transform: lowercase;
+  cursor: pointer;
+}
+
+/* AND THE FRAME NEEDS ITS BOX, which the first cut forgot and the probe caught: a
+   `HandDrawnOutline` with no children draws into its own `.outline-container`, and an
+   `inline-flex` button gives that container no size, so BOTH frames measured `stroke-width:
+   null` / `pathLen: null` — the weight ladder, which is this face's only non-colour channel,
+   was not on the page at all. Laid at `inset: 0` it takes the button's box, which is the
+   estate's own idiom (`.bar-frame`, `.deal-box`) and the one the comment above already named. */
+.confirm-answer > :deep(.outline-container) {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+}
+
+/* BOTH FRAMES ARE DRAWN IN THE CASE'S OWN INK, and that is a correction pass 4 made against
+   a reading rather than a preference. `HandDrawnOutline` strokes in `currentColor`, so
+   `color: var(--color-red-ink)` on the BUTTON painted the frame red too — measured
+   `rgb(208,42,82)` light / `rgb(255,92,124)` dark on the frame path, both engines. The design
+   above says the ink is red "on the destructive word only", and a red box beside a white box
+   at 14px reads as a destructive BUTTON, which is the generic pixel this face exists to avoid:
+   two boxes, one red, is colour doing the ranking that the weight ladder already does. The
+   red moves inward by one element and the ladder carries the rank alone. */
+.confirm-keep,
+.confirm-go {
+  color: var(--color-foreground);
+}
+
+/* The one red word on the card, on bare paper — 4.99:1 light, 6.30:1 dark, the ratios
+   `index.css`'s ink-tier block is the record for. */
+.confirm-go > span {
+  color: var(--color-red-ink);
+}
+</style>
