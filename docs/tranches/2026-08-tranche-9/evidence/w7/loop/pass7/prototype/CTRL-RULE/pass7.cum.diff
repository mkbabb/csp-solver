+  expect(at.n, "the census must see the page's lines").toBeGreaterThanOrEqual(7);
+  expect(at.floor, "the floor is one printed name line").toBeGreaterThan(25);
+  expect(Math.min(...at.inCard), `in-card gaps ${JSON.stringify(at.inCard)}`).toBeGreaterThanOrEqual(
+    at.floor,
+  );
+  expect(at.fold, "the last line against the foot's rule, at the scroll end").not.toBeNull();
+  expect(at.fold!).toBeGreaterThanOrEqual(at.floor);
+  // NEGATIVE CONTROL — the pass-4 band: `new game` ruled again, its line 13.48px over the divider.
+  await page.evaluate(() => {
