+test.describe("mid-scroll, the fold's fade covers an in-card rule at the foot's rule (390×844 coarse)", () => {
+  test.use({ viewport: { width: 390, height: 844 }, isMobile: true, hasTouch: true });
+  /** An in-card rule scrolled to within `k` css of the card's clip line — the band where the
+   *  critic read it crossing the foot's rule (−0.08…−2.46) — photographed shown vs hidden. What
+   *  shows through is the residue the fade leaves. */
+  const RESIDUE = async (page: Page, k: number, fade: "1" | "0") => {
+    const pose = await page.evaluate((k) => {
+      const card = document.querySelector(".controls-card") as HTMLElement;
+      const clipB = card.getBoundingClientRect().top + card.clientTop + card.clientHeight;
+      const max = card.scrollHeight - card.clientHeight;
+      // PASS 7 (the pass-6 critic's gap 6): WebKit's scrollTop is an integer, so "scroll the first
+      // reachable rule to k" landed k 2.5 at 1.53 and never visited the band's worst pose. The pose
+      // is now CHOSEN from what the engine can reach: every rule the scroll can bring to the clip
+      // line, at the floor and the ceiling of its exact offset, and the (rule, scrollTop) pair whose
+      // READ k is nearest the target wins. The last rules cannot reach it (the card runs out of
+      // scroll first), and are skipped by the same test the pass-6 row used.
+      const top0 = card.scrollTop;
+      let pick: { svg: SVGSVGElement; st: number; dk: number } | null = null;
+      for (const s of card.querySelectorAll<SVGSVGElement>("svg.ruled-line")) {
+        card.scrollTop = top0;
+        const want = top0 + s.querySelector("path")!.getBoundingClientRect().bottom - (clipB - k);
+        if (want < 1 || want > max - 8) continue;
+        for (const st of [Math.floor(want), Math.ceil(want), want]) {
+          card.scrollTop = st;
+          const dk = Math.abs(clipB - s.querySelector("path")!.getBoundingClientRect().bottom - k);
+          if (!pick || dk < pick.dk) pick = { svg: s, st, dk };
+        }
+      }
+      card.scrollTop = top0;
+      if (!pick) return null;
+      const svg = pick.svg;
+      document.querySelectorAll("[data-residue]").forEach((e) => e.removeAttribute("data-residue"));
+      svg.setAttribute("data-residue", "");
+      card.scrollTop = pick.st;
+      const r2 = svg.querySelector("path")!.getBoundingClientRect();
+      return { k: +(clipB - r2.bottom).toFixed(2), x: r2.left, w: r2.width, clipB, below: card.hasAttribute("data-fold-below") };
+    }, k);
+    expect(pose, `a rule the scroll can bring to k=${k}`).not.toBeNull();
+    // ≤ 0.1 css, in both engines: the pose is chosen from the reachable set, so it is VISITED
+    expect(Math.abs(pose!.k - k), `the pose reached ${JSON.stringify(pose)}`).toBeLessThanOrEqual(0.1);
+    // the fold's rAF publish, then the fade's own 150ms: poll the painted state it names
+    await expect
+      .poll(() =>
+        page.evaluate(() => getComputedStyle(document.querySelector("#card-foot .action-bar")!, "::before").opacity),
+      )
+      .toBe(fade);
+    const paint = await PAINT_DIFF(
+      page,
+      { x: pose!.x, y: pose!.clipB - 8, width: pose!.w, height: 8 },
+      "svg[data-residue] { visibility: hidden !important; }",
+    );
+    return { ...pose!, ...paint };
+  };
+  test("the residue in the crossing band stays under 1.5:1, and the fade struck shows the line", async ({
+    page,
+  }) => {
+    await loadSudoku(page);
+    if (await page.evaluate(() => document.documentElement.classList.contains("drawer-closed")))
+      await page.locator(".drawer-tab").tap();
+    await SHEET_SETTLED(page);
+    for (const k of [0.5, 1.5, 2.5]) {
+      const at = await RESIDUE(page, k, "1");
+      console.log(`[RULE row 8] fade on ${JSON.stringify({ k: at.k, p98: at.p98, coverage: at.coverage })}`);
+      expect(at.below, "mid-scroll: the fade is live").toBe(true);
+      expect(at.p98, `residue at k=${k} ${JSON.stringify(at)}`).toBeLessThan(1.5);
+    }
+    // NEGATIVE CONTROL — the fade struck: the in-card rule shows at the clip line.
+    await page.addStyleTag({ content: ".action-bar::before { opacity: 0 !important; transition: none !important; }" });
+    const red = await RESIDUE(page, 2.5, "0");
+    console.log(`[RULE row 8] fade struck ${JSON.stringify({ k: red.k, p98: red.p98, coverage: red.coverage })}`);
+    expect(red.p98, `negative control: no fade ${JSON.stringify(red)}`).toBeGreaterThanOrEqual(2.0);
+  });
+});
