--- /dev/null
+++ b/web/frontend/src/games/shared/RuledLine.vue
@@ -0,0 +1,116 @@
+<script setup lang="ts">
+/**
+ * T9-W7 · CTRL-RULE — THE HAND-RULED LINE, and the only place its terms are written.
+ *
+ * `wobbleLine` is the BOARD's own generator (`@mkbabb/pencil-boil`, the grid's roughness and
+ * segment count), rendered as ONE STATIC `<path>`: no beat, no subscriber, no `url(#…)`
+ * filter — the card's filter census does not move (9). The incumbent was a CSS `border-top`,
+ * whose σ is 0 by construction: a printed hairline, not a drawn rule. Measured on THIS tree
+ * (pass 4, `pass4/prototype/CTRL-RULE/readings/rule-arms-*.json`), the painted centroid's σ reads
+ * 0.724–1.218px over 7 rules × 2 themes × 2 engines × 4 phases, inside R3's grid band
+ * [0.722, 2.886] — by 0.002 at its floor, which is stated rather than rounded away.
+ *
+ * THE CHORD IS NOMINAL. The viewBox stretches in X alone (`preserveAspectRatio="none"` with
+ * the svg's CSS height equal to the viewBox's 5 units), so the wobble's PERPENDICULAR
+ * amplitude — the only quantity σ reads — is the amplitude generated at `RULE_CHORD` whatever
+ * width the line resolves to. That is what buys a static path: no observer per rule, no
+ * regeneration on rotate, one `d` per seed for the life of the page.
+ *
+ * THE STROKE IS 3, AND THE SWEEP CHOSE IT. The gate is 1.4.11's 3:1 on the WORST PAINTED COLUMN,
+ * read at rest AND at three forced sub-pixel phases (a 2px stroke astride a device-pixel row
+ * splits its ink across two rows and paints neither whole). Pass 4, same ink (`--ink-press-rule`),
+ * worst over every phase:
+ *   2px   chromium 2.338 light / 2.826 dark · webkit 3.483 / 4.303 — RED in chromium
+ *   2.5px chromium 2.802 / 3.452          · webkit 3.530 / 4.364 — RED in chromium light
+ *   3px   chromium 3.304 / 4.070          · webkit 3.530 / 4.364 — GREEN everywhere
+ * and the ink arm (`--color-muted-foreground` at 2px, 4.40 at rest) reads 2.834 forced — RED.
+ * So the thinnest stroke that clears every phase in both engines is 3, the case's own rung.
+ * `--ink-press-rule` is not moved to buy it: it is `check-ink-pressure`'s ramp.
+ * PASS 6 — THOSE WORST-COLUMN FIGURES ARE BEST-PIXEL READINGS (each column's most-contrasting
+ * pixel), so the sweep chose the WIDTH on a statistic that cannot see antialiasing. Re-read under
+ * the core statistic the width holds (3 over 2) and the INK moves one rung, to `--ink-press-quiet`
+ * (the path rule below).
+ */
+import { computed } from "vue";
+import { wobbleLine } from "@mkbabb/pencil-boil";
+
+const props = defineProps<{
+  /** One seed per rule — a line is that group's line at every mount. */
+  seed: number;
+}>();
+
+/** The span the card's wrap actually resolves to across its three regimes (284.22 desk · 374
+ *  dock · 884 landscape) — the middle of the two the rule is read at, so the x-stretch stays
+ *  near 1 and the rule reads as one hand at every width. The seed sweep clears the band at this
+ *  chord AND at the spec's 284.67; a seed is only pinned if it clears at both. */
+const RULE_CHORD = 300;
+const RULE_H = 5;
+
+const d = computed(() =>
+  wobbleLine(0, RULE_H / 2, RULE_CHORD, RULE_H / 2, {
+    roughness: 0.4,
+    segments: 8,
+    seed: props.seed,
+  }),
+);
+
+/** The page is ruled left to right rather than stamped: each line waits its own beat. ONCE,
+ *  at mount — nothing re-draws on a scroll, an open or a chip. The DURATION is the ladder's
+ *  `--motion-note` rung, not a constant of this component's: pass 2 minted `MOTION.ruleDrawMs`
+ *  at 260 and the rung it was 10ms from is 250. */
+const drawDelay = computed(() => `${(props.seed % 7) * 22}ms`);
+</script>
+
+<template>
+  <svg
+    class="ruled-line"
+    :viewBox="`0 0 ${RULE_CHORD} ${RULE_H}`"
+    preserveAspectRatio="none"
+    aria-hidden="true"
+    focusable="false"
+  >
+    <path
+      :d="d"
+      pathLength="1"
+      class="pencil-draw-on"
+      :style="{ '--draw-dur': 'var(--motion-note)', '--draw-delay': drawDelay }"
+    />
+  </svg>
+</template>
+
+<style scoped>
+.ruled-line {
+  display: block;
+  width: 100%;
+  /* NO NATURAL WIDTH. A replaced `<svg>` offers its viewBox aspect to intrinsic sizing: 300 × 5
+     at 5px tall is a 300px max-content, and that was the desk card's ruler once the field was
+     contained (340 against the control's 324.22, measured). Contained, the line takes the width
+     it is given and asks for none. */
+  contain: inline-size;
+  height: 5px;
+  overflow: visible;
+  pointer-events: none;
+}
+
+.ruled-line path {
+  fill: none;
+  /* THE QUIET RUNG, NOT THE RULE RUNG (pass 6, the critic's 1.3). `--ink-press-rule` (55%)
