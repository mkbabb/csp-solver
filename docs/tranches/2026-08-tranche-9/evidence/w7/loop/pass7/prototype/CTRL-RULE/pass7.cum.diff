+++ b/web/frontend/src/games/shared/RuledGroup.vue
@@ -0,0 +1,222 @@
+<script setup lang="ts">
+/**
+ * T9-W7 · CTRL-RULE, ARM (b) — ONE GROUP OF THE RULED PAGE.
+ *
+ * The card is a worksheet page a pencil ruled by hand: the page came PRINTED with the group's
+ * name in a left MARGIN, the pencil chooses in the wide field beside it, and one graphite rule
+ * runs the full width under both. Seven of these and nothing else — no compartment, no frame,
+ * no tape standing in for a heading.
+ *
+ * ARM (a) IS DEAD AND ITS MECHANISM IS DELETED HERE, not disabled — but THE PIN IS KEPT, and
+ * that correction is pass 3's. Arm (a) pinned the name to the card's top edge in the FIELD'S
+ * OWN COLUMN, and the pin cut `Normal` 38.8% at the dock: a sticky opaque surface over a
+ * control, the class invariant this card has now bitten three times. Pass 2 answered by
+ * deleting the pin outright, and its own instrument then measured the price — `size` orphaned
+ * from its chips at 4 of 14 rail states (chromium; 4 of 13 webkit), a field under the eye with
+ * no name anywhere on screen. The chair refused that trade (§6.3(a)): T9-M03 says the name is
+ * sticky and only the owner retires a mark.
+ *
+ * So the name pins WHERE NO CONTROL CAN BE. Column 1 holds names and nothing else, at every
+ * width and every state, which makes the coverage question arithmetic rather than a promise:
+ * a box that can only ever occupy a column no control occupies covers 0.000 of any control.
+ * `.head-pin`, the release box, the flow spacer, `--rp-head-h` and the scrollport's
+ * `scroll-padding-top` lift stay deleted — those were arm (a)'s machinery for pinning ACROSS
+ * the card, and the margin needs none of it.
+ *
+ * TWO THINGS THIS COMPONENT OWNS, each measured rather than chosen:
+ *
+ *  1 · THE GRID. `[--rp-margin] [0.5rem] [minmax(0,1fr)]`, the name at 1/1, the field at 1/3,
+ *      the rule at 2 spanning 1/-1, every item TOP-aligned. Pass 2 argued `first baseline` here
+ *      (the printed name and the first chip on one baseline); the pin's `align-self: start`
+ *      outranks it, and pass 4 measured what is actually painted (`page-geometry-*.json`,
+ *      chip baseline − name baseline, single-line names): 0.00 at the chromium desk, −1.20
+ *      webkit, +9.0 / +7.8 at 390 coarse, +14.0 / +13.1 at 320. So the claim is struck and
+ *      the row says `start`: a pinned name is a margin heading, not a form label beside its
+ *      field. What still separates the page from a settings form: the name is display type at
+ *      φ/800 where a label is body weight; the rule spans BOTH columns; the field is left-aligned
+ *      TO a margin rather than right-aligned to a label.
+ *
+ *  2 · THE FIELD WRAPS WHEN IT MUST, and that is a property of every field rather than a
+ *      `marks` exception. At 390 with the card's 8px chip padding only `marks` overflows
+ *      (305.22 against 244.53 of field) and it takes one more line; `level` clears by 14.13.
+ *      StagingBand's `nowrap` is that surface's measuring discipline and is not borrowed.
+ */
+import RuledLine from "@games/shared/RuledLine.vue";
+
+defineProps<{
+  /** The group's name — the ONE string: printed ink, document heading and accessible name. */
+  name: string;
+  /** This name's own hand. One seed per name, so a rule is that group's rule at every mount. */
+  seed: number;
+  /** The id the field's `aria-labelledby` points at (the caller mints it with `useId`). */
+  headingId: string;
+  /** A DESCRIPTION, never a second name — the one group that has one is `players`, whose tape
+   *  says what sharing does. `aria-describedby` reads a directly-referenced node whatever its
+   *  hidden state (accname §4.1 step 2A), so the tape stays exactly the tape it is. */
+  describedBy?: string;
+  /** No rule of its own: the group's boundary is already a drawn line (`new game` sits on the
+   *  zone's `BoilDivider`, 13.48px below where its own rule was — two lines read as one band). */
+  unruled?: boolean;
+}>();
+</script>
+
+<template>
+  <div class="ruled-group" data-ruled-group>
+    <h2 :id="headingId" class="rp-name">{{ name }}</h2>
+    <div
+      class="rp-field"
+      role="group"
+      :aria-labelledby="headingId"
+      :aria-describedby="describedBy"
+    >
+      <slot />
+    </div>
+    <RuledLine v-if="!unruled" class="rp-rule" :seed="seed" />
+    <!-- The explication, hung off the NAME (its old seam was the caption that died). Out of
+         flow, so it takes no grid cell and moves no box; the panel authors its copy and places
+         it, as `.tray-well .zone-hint` did before this. -->
+    <slot name="hint" />
+  </div>
+</template>
+
+<style scoped>
+/* The air between groups is the RULE's now, not a frame's: 0.15rem above the name and 0.35rem
+   under the field. The compartment's 0.5rem margin + 0.9rem padding is what this replaces.
+   TWO DRAWN LINES NEVER SIT NEARER THAN ONE PRINTED NAME LINE (pass 5 — `--type-heading` ×
+   1.2, 31.06px), over every horizontal line in the case: rules, the zone's BoilDivider and the
+   foot's rule. Gated in `e2e/zone-grammar.spec.ts` ("the page's lines keep a name line apart"),
+   whose negative control re-rules `new game` (13.48px above the divider, the pass-4 band). */
+.ruled-group {
+  position: relative;
+  display: grid;
+  grid-template-columns: var(--rp-margin) 0.5rem minmax(0, 1fr);
+  align-items: start;
+  padding-block: 0.15rem 0.35rem;
+}
+
+/* THE PRINTED NAME. It reads `--type-heading` DIRECTLY rather than `.section-heading`'s
+   `--type-group-title`: that token and that class are StagingBand's now, and leaving them
+   untouched is how the gallery's five readings are Δ 0.00 BY CONSTRUCTION rather than by a
+   census that has to keep agreeing. One ink for all seven — the crayon leaves the name and
+   lives on the chosen chip, where it is data. */
+.rp-name {
+  /* ROWS 1–2, NOT ROW 1 (pass 5, W2 §2.6). A sticky box travels only inside its grid AREA, and
+     row 1 is the field's height: `size` at the dock (one line of 44px chips) had 13px of travel
+     and read 0.94 visible with its group pushed 40px past the fold. The rule's row is the
+     name's too — at the end of its travel a pinned name sits ON its group's rule, which is
+     what a name on a ruled page does — and the rule row's 9.8px is what buys 0.9 → 1.0. */
+  grid-area: 1 / 1 / 3 / 2;
+  /* ── THE PIN, IN THE MARGIN (pass 3, chair §6.3(a)) ──────────────────────────────────────
+     `top: 0` IS the resting inset, and the spec's `var(--card-pad-t)` was a premise this
+     prototype measured false. A sticky box's offsets are resolved against its scrollport's
+     PADDING BOX, not its border box — and the card's padding box already begins
+     `--card-pad-t` below the case edge. So `top: var(--card-pad-t)` pins a name at TWICE the
+     inset: measured at 1280×800 chromium, `Level` held at y 180.94 against a resting flow
+     position of 163.34, and `size` was pushed 17.6px DOWN from its own resting place at
+     scrollTop 0 — the first name on the page sitting lower than the rule it names. `top: 0`
+     resolves to 160.94, the padding-box edge, which is the resting inset to the pixel and is
+     why the pinned-top gate reads a Δ of 0 rather than a tolerance.
+     The design intent the spec wrote is intact and this is how it is actually spelled: a
+     pinned name is indistinguishable from a resting one, and only its FIELD moves under it.
+
+     `align-self: start` IS THE PIN'S TRAVEL, not a tidy. A grid item stretched to its area's
+     height has zero room between its own top and its area's bottom, and `position: sticky` on
+     a box with no room is a SILENT no-op — it computes, it paints, it never moves. The row's
+     `align-items: start` does not stretch, but it is one edit away from something that does,
+     so the travel is asserted on the item itself. The born-RED ablation is
+     `.rp-name { align-self: stretch }` (4/13 orphans at 1280): `align-items: stretch` on the
+     row never reaches an item that carries its own `align-self`, so that ablation was vacuous.
+
+     `z-index: 31` is ONE above W2's fold sentinel (`.controls-card::before`, z 30), and it is
+     STATED and BOUNDED rather than deleted: that sentinel is a real sticky surface with a real
+     ground — solid card for the first `--card-pad-t`, then a fade over 2rem — and the name has
+     to be read THROUGH it or the pin buys nothing at the one moment it matters. The sentinel
+     keeps its band and keeps covering the field's own first rung; what changes is that one
+     text node in a column no control occupies sits above it. */
+  position: sticky;
+  top: 0;
+  z-index: 31;
+  align-self: start;
+  margin: 0;
+  font-family: var(--font-display);
+  font-size: var(--type-heading);
+  line-height: 1.2;
+  font-weight: 800;
+  text-transform: lowercase;
+  letter-spacing: var(--type-tracking-wide);
+  color: var(--color-muted-foreground);
+  /* ONE LINE, ALWAYS (pass 5). Pass 4 sized the margin to the longest WORD and let `new game`
+     wrap to 62.13px, on the argument that the group was taller than two lines. It was — at
+     rest. A PINNED name's travel is its area minus itself, so a two-line name in a ~70px group
+     had 8px of it and read 0.797–0.851 visible under W2 §2.6's 0.9 (both engines). The margin
+     is now sized to the longest NAME (`--rp-margin`, the panel's), and `nowrap` makes the
+     claim structural: a name that no longer fits overflows into the gutter where a gate can
+     read it (`scrollWidth > clientWidth`), rather than folding silently into a second line. */
+  white-space: nowrap;
+  /* The name is hoverable (the tape hangs off it) but it is not a control: no cursor claim
+     beyond the estate's own `help`, which is what the dead captions wore. */
+  pointer-events: auto;
+  cursor: help;
+}
+
+/* THE FIELD HAS NO INTRINSIC WIDTH (pass 4, chair §6.4 — "the card's width outranks its
+   content"). Without this the field's one-line max-content was the desk card's ruler: margin
+   121.6 + 8 + every chip on one line took the card 324.22 → 373.50 and re-centred the rail, so
+   the wordmark, the masthead, the board and the drawer tab each moved 24.64px on surfaces this
+   family does not claim. Contained, the chips wrap to the width W2 gave the card; CTRL-COST's
+   ruler law, the same idiom on the same kind of row. */
+.rp-field {
+  grid-area: 1 / 3;
+  contain: inline-size;
+}
+
+/* THE RULE SPANS BOTH COLUMNS. A form's rule, when it has one, runs under the field alone;
+   this one runs under the margin too, which is what a ruled page means. */
+.rp-rule {
+  grid-area: 2 / 1 / 3 / -1;
+  align-self: end;
+  margin-top: 0.3rem;
+}
+
+/* ONE MARGIN, NOT TWO. The chips were centred in their own row (`.options-row
+   { justify-content: center }`) — at the landscape dock that is an 884px field centred under a
+   60px word, and the two read as unrelated objects. The field starts where the margin ends,
+   and it carries no padding of its own: the margin IS the offset.
+   THE RULE LIVES HERE because `.rp-field` is this component's node: a `:deep()` written in the
+   panel would compile against the panel's scope id and match nothing (it did, measured — the
+   frame came back byte-identical). */
+.rp-field :deep(.options-row) {
+  justify-content: flex-start;
+  flex-wrap: wrap;
+  padding-left: 0;
+}
+
+.rp-field :deep(.options-pair) {
+  flex-wrap: wrap;
+}
+/* THE COARSE RAIL STACKS (pass 5). An iPad in the row regime has no legend to rule the card's
+   width, so the card takes the bar's (224px, `74a2b5d9`'s) and a 136px margin leaves the field
+   20px — the chips overflowed the card by 74. There the name sits over its field, one column,
+   and it does NOT pin: a name pinned across a full-width field is the arm (a) cover this
+   component was built to refuse (measured: stacked and still sticky, `size` held at the card's
+   top while its chips scrolled under it). The margin pin is a desk and phone grammar; the
+   coarse rail reads its names as it scrolls, and that is a declared loss of M03 there. */
+@media (min-width: 1024px) and (pointer: coarse) {
+  .ruled-group {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .rp-name {
+    grid-area: 1 / 1;
+    position: static;
+  }
+
+  .rp-field {
+    grid-area: 2 / 1;
+  }
+
+  .rp-rule {
+    grid-area: 3 / 1;
+  }
+}
+</style>
