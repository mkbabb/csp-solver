+function stripComments(text, script = false) {
+  let out = "";
+  let q = null;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (q) {
+      out += c;
+      if (c === "\\") out += text[++i] ?? "";
+      else if (c === q) q = null;
+      continue;
+    }
+    if (c === '"' || c === "'" || (script && c === "`")) q = c;
+    else if (c === "/" && text[i + 1] === "*") {
+      const e = text.indexOf("*/", i + 2);
