+import { describe, expect, it, vi } from "vitest";
+import { MOTION, handStroke } from "@pencil/config/pencilConfig";
+
+// The master subscription is driven by hand: `raw` is the rAF timeline over the span.
+let drive: ((eased: number, raw: number) => void) | null = null;
+vi.mock("@mkbabb/pencil-boil", async (orig) => ({
+  ...(await orig<typeof import("@mkbabb/pencil-boil")>()),
+  createSequenceSubscription: (o: { onProgress: (e: number, r: number) => void }) => {
+    drive = o.onProgress;
+    return { start() {}, stop() {} };
+  },
+}));
+const { enrollStroke, beginRuling, afterRuling } = await import("./bootHand");
+const SPAN = 600_000;
+
+describe("the hand's clock (T9-M20 D1)", () => {
+  it("a healthy frame is never slowed; a stall pauses the hand one step", () => {
+    const seen: number[] = [];
+    enrollStroke((c) => {
+      seen.push(c);
+      return seen.length >= 4;
+    });
+    for (const t of [0, 16, 316, 332]) drive!(0, t / SPAN);
+    // 16 ms passes whole; the 300 ms stall advances one `stepMs`; the next frame is whole again
+    expect(seen).toEqual([0, 16, 16 + MOTION.hand.stepMs, 32 + MOTION.hand.stepMs]);
+  });
+});
+
+describe("the wave waits for the last lift (T9-M20 D15)", () => {
+  it("nothing to wait for when no ruling is in flight", () => {
+    expect(afterRuling()).toBeNull();
+  });
+  it("releases every waiter at the last ruling's lift, once", async () => {
+    const a = beginRuling();
+    const b = beginRuling();
+    const order: string[] = [];
+    void afterRuling()!.then(() => order.push("wave"));
+    a();
+    a(); // idempotent: a second release of one ruling does not end the other
+    await Promise.resolve();
+    expect(order).toEqual([]);
+    b();
+    await Promise.resolve();
+    expect(order).toEqual(["wave"]);
+    expect(afterRuling()).toBeNull();
+  });
+});
+
+describe("handStroke (the ledger string, solved in JS)", () => {
+  const bez = (a: number, b: number, t: number) =>
+    3 * a * (1 - t) ** 2 * t + 3 * b * (1 - t) * t * t + t ** 3;
+  it("agrees with the parametric curve at 41 samples to 1e-4", () => {
+    const [x1, y1, x2, y2] = (MOTION.curves.handStroke.match(/-?[\d.]+/g) ?? []).map(
+      Number,
+    );
+    for (let i = 0; i <= 40; i++) {
+      const t = i / 40;
+      expect(handStroke(bez(x1, x2, t))).toBeCloseTo(bez(y1, y2, t), 4);
+    }
+  });
+  it("touches down slow, peaks near a third, and stops (G-D4: ≤ 25 % drawn at 20 % of the time)", () => {
+    const speed = (x: number, h = 1e-4) =>
+      (handStroke(x + h) - handStroke(x - h)) / (2 * h);
+    expect(speed(1e-3)).toBeLessThan(0.3);
+    let [peak, at] = [0, 0];
+    for (let x = 0.01; x < 1; x += 0.001)
+      if (speed(x) > peak) [peak, at] = [speed(x), x];
+    expect(at).toBeGreaterThan(0.2);
+    expect(at).toBeLessThan(0.4);
+    expect(handStroke(0.2)).toBeLessThan(0.25);
+    expect(handStroke(0.9)).toBeGreaterThan(0.99);
+  });
+});
