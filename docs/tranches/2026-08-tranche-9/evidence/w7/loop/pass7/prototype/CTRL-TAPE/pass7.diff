+const subjectIs = (prelude, set) =>
+  selectors(prelude).some((sel) => names(split(sel).subj, set));
+
+const stripped = new Map();
+/** Template elements (every SFC) whose static class, `:class` or id names one of `set`. */
+function elements(t, set) {
+  const out = [];
+  for (const f of t.files) {
+    if (!f.endsWith(".vue")) continue;
+    const text = t.read(f);
+    if (!stripped.has(text))
+      stripped.set(text, stripHtml(sfc(text).template?.text ?? ""));
+    const s = stripped.get(text);
+    if (!s) continue;
+    for (const m of s.matchAll(
+      /<([a-zA-Z][\w-]*)((?:\s+(?:"[^"]*"|'[^']*'|[^\s>"'])+)*)\s*\/?>/g,
+    )) {
