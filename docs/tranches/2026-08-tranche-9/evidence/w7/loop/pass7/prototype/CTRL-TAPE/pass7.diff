+// ------------------------------------------------------------------------------ the tree
+const disk = new Map();
+const fromDisk = (f) => disk.get(f) ?? disk.set(f, fs.readFileSync(f, "utf8")).get(f);
+let listed = null;
+function tree(overlay = {}) {
+  listed ??= sources(ROOT);
+  const files = [
+    ...new Set([...listed, ...Object.keys(overlay).map((r) => path.join(ROOT, r))]),
+  ];
