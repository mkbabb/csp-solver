+    if (c === "(" || c === "[") d++;
+    if (c === ")" || c === "]") d--;
+    if (c === "," && d === 0) {
+      out.push(cur.trim());
+      cur = "";
+    } else cur += c;
+  }
+  out.push(cur.trim());
+  return out.filter(Boolean);
+};
+const ids = (s) =>
