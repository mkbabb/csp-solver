+    }
+  }
+  return out;
+}
+
+// ------------------------------------------------------------------------------ the pad
+const topSplit = (v) => {
+  const out = [];
+  let d = 0,
+    cur = "";
+  for (const c of v.trim()) {
+    if (c === "(") d++;
+    if (c === ")") d--;
+    if (/\s/.test(c) && d === 0) {
+      if (cur) out.push(cur);
+      cur = "";
+    } else cur += c;
+  }
+  if (cur) out.push(cur);
+  return out;
+};
+/** The bottom pad a declaration sets, or null when it sets none. */
+function bottomOf(d) {
+  if (d.prop === "padding-bottom" || d.prop === "padding-block-end") return d.value;
+  if (d.prop === "padding-block") {
+    const p = topSplit(d.value);
+    return p[1] ?? p[0];
+  }
+  if (d.prop === "padding") {
+    const p = topSplit(d.value);
+    return p[2] ?? p[0];
+  }
+  return null;
+}
+/** Net rem of a calc() sum outside env() (px read at 16). NaN when a term is not a length. */
+function netRem(v) {
+  const body = v.replace(/^calc\(/, "(").replace(/env\([^)]*\)/g, "0rem");
+  if (/\b(max|min|clamp|var)\(/.test(body)) return NaN;
+  const terms = [
+    ...body
+      .replace(/[()]/g, " ")
+      .matchAll(/([+-]?)\s*(\d*\.?\d+)(rem|px)|([+-]?)\s*(\d*\.?\d+)(?![\w.])/g),
+  ];
+  let sum = 0;
+  for (const m of terms) {
+    if (m[2] === undefined) {
+      if (+m[5] !== 0) return NaN;
+      continue;
+    }
+    const n = (m[1] === "-" ? -1 : 1) * +m[2];
+    sum += m[3] === "px" ? n / 16 : n;
+  }
+  return sum;
