+function allRules(t) {
+  const out = [];
+  for (const f of t.files) {
+    const text = t.read(f);
+    const key = f + "\0" + text;
+    if (parsed.has(key)) {
+      out.push(...parsed.get(key));
+      continue;
+    }
+    const at = out.length;
+    const blocks = f.endsWith(".vue")
