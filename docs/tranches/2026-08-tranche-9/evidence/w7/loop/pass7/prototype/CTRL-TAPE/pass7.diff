+/** T9-M18 (the owner: "this needs to have a border in some way") · pass-4 rulings §3 §6.1.
+ *
+ *  The bar is the case's fifth compartment and wears the WELLS' pen — never a CSS border (R6 L5).
+ *  A RECT IS NOT PAINT, so the edge is read from bytes: the bar photographed with its frame shown
+ *  and hidden, and each side's run must carry ink in ≥ 90% of its columns/rows. Born RED on this
+ *  tree's own pass-4 layer: an unpositioned foot paints UNDER the card (`z-index: 45`), and the
+ *  frame's top stroke — the side the owner's frame is about — read 0.00. That layer is the
+ *  negative control, same run. */
+const EDGE_COVERAGE = async (page: Page) => {
+  const box = await page.locator("#card-foot .action-bar").boundingBox();
+  if (!box) return null;
+  const clip = { x: box.x - 10, y: box.y - 10, width: box.width + 20, height: box.height + 20 };
+  const on = (await page.screenshot({ clip })).toString("base64");
+  const hide = await page.addStyleTag({
+    content: ".bar-frame .outline-svg { visibility: hidden !important }",
+  });
+  const off = (await page.screenshot({ clip })).toString("base64");
+  await hide.evaluate((n) => (n as Element).remove());
+  return page.evaluate(
+    async ({ on, off }) => {
+      const px = async (b64: string) => {
+        const bmp = await createImageBitmap(await (await fetch(`data:image/png;base64,${b64}`)).blob());
+        const c = new OffscreenCanvas(bmp.width, bmp.height);
+        const g = c.getContext("2d")!;
+        g.drawImage(bmp, 0, 0);
+        return g.getImageData(0, 0, bmp.width, bmp.height);
+      };
+      const [a, b] = [await px(on), await px(off)];
+      const { width: w, height: h } = a;
+      const s = window.devicePixelRatio || 1; // device px per css px
+      const ink = (x: number, y: number) => {
+        const o = (y * w + x) * 4;
+        return (
+          Math.max(
+            Math.abs(a.data[o] - b.data[o]),
+            Math.abs(a.data[o + 1] - b.data[o + 1]),
+            Math.abs(a.data[o + 2] - b.data[o + 2]),
+          ) > 24
+        );
+      };
+      const band = Math.round(14 * s); // the clip's 10px margin + 4px inside the box
+      const inset = Math.round(18 * s); // off the corners
+      const cover = (horiz: boolean, near: boolean) => {
+        let hit = 0;
+        let all = 0;
+        const [len, depth] = horiz ? [w, h] : [h, w];
+        for (let i = inset; i < len - inset; i++) {
+          all++;
+          for (let j = 0; j < band; j++) {
+            const d = near ? j : depth - 1 - j;
+            if (horiz ? ink(i, d) : ink(d, i)) {
+              hit++;
+              break;
+            }
+          }
+        }
+        return +(hit / all).toFixed(3);
+      };
+      // THE PAINTED CORE MEDIAN (pass 6; existence is not visibility, pass6 rulings A.5.3): every
+      // changed pixel's contrast against its own ground pixel, the core being the pixels whose
+      // luminance moved ≥ half the p98 move. A faint ink covers four sides and reads ~1.2:1.
+      const lin = (c: number) => ((c /= 255) <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
+      const L = (d: Uint8ClampedArray, o: number) => 0.2126 * lin(d[o]) + 0.7152 * lin(d[o + 1]) + 0.0722 * lin(d[o + 2]);
+      const px2: { move: number; r: number }[] = [];
+      for (let o = 0; o < a.data.length; o += 4) {
+        if (Math.max(Math.abs(a.data[o] - b.data[o]), Math.abs(a.data[o + 1] - b.data[o + 1]), Math.abs(a.data[o + 2] - b.data[o + 2])) <= 24) continue;
+        const [la, lb] = [L(a.data, o), L(b.data, o)];
+        px2.push({ move: Math.abs(la - lb), r: (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05) });
+      }
+      const moves = px2.map((p) => p.move).sort((m, n) => m - n);
+      const ref = moves.length ? moves[Math.floor(0.98 * (moves.length - 1))] : 0;
+      const core = px2.filter((p) => p.move >= 0.5 * ref).map((p) => p.r).sort((m, n) => m - n);
+      return {
+        top: cover(true, true),
+        bottom: cover(true, false),
+        left: cover(false, true),
+        right: cover(false, false),
+        coreMedian: core.length ? +core[core.length >> 1].toFixed(3) : 0,
+      };
+    },
+    { on, off },
+  );
+};
