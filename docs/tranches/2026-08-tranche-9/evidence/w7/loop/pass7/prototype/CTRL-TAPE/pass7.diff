+<script setup lang="ts">
+/**
+ * T9-W7 §15 (M12) pass 3 — THE CONFIRM'S FACE, and it is the SECTION's rule.
+ *
+ * WHAT IT REPLACES. At HEAD an armed destructive verb swapped its own sublabel to `sure?` in
+ * red. That is a question with no answer on the page: the only way to say no was to wait 2.5s
+ * or to guess that some other press would cancel, and `sure?` does not name what is about to
+ * happen. It also put the question INSIDE the control it was asking about, so the target of
+ * "yes" and the target of "no" were the same 44px box.
+ *
+ * WHAT IT IS. One sentence and two answers, in the row the verb lives in, at the row's full
+ * width. No ground, no scrim, no `role="dialog"`, no focus trap — the card is small enough
+ * that a band across one row IS the modality, and a dialog on a phone drawer would fight the
+ * sheet's own gesture.
+ *
+ * THE THREE CHANNELS, AND NONE OF THEM IS COLOUR ALONE (1.4.1).
+ *   1. THE SENTENCE names the act: `clear the board?`, not `sure?`.
+ *   2. THE WEIGHT LADDER ranks the answers — `keep` at the WELLS' 1.5, the destructive answer
+ *      at the TONGUE's 2.5. That ladder is already the case's grammar (case 3 · tongue 2.5 ·
+ *      wells 1.5), so the rank is legible to a reader who has never seen this ribbon and it
+ *      survives a greyscale print, a colour-blind reader and a forced-colours mode.
+ *   3. THE INK is red on the destructive word only — `--color-red-ink`, measured 4.99:1 on the
+ *      bare light card and 6.30:1 on the dark, on BARE card with no ground of its own.
+ *
+ * WHY `keep` IS DRAWN TOO. The obvious cut is a bare `keep` against a boxed verb — one frame,
+ * maximum contrast between the answers. CTRL-RULE measured the cost: R6 law L5 (the gallery's
+ * `keep` keeps its outline) flips RED at 422 characters against a 400-character window if the
+ * word goes bare. Both answers drawn, ranked by stroke, buys the same discrimination inside
+ * the law instead of against it.
+ *
+ * THE TAP FLOOR is W2's token and both answers clear it on both dimensions.
+ */
+import HandDrawnOutline from "@pencil/grid/HandDrawnOutline.vue";
+import { onMounted, useTemplateRef } from "vue";
+
+const props = defineProps<{
+  /** The sentence. M16: the player's words for the act, ending in a question mark. */
+  ask: string;
+  /** The destructive answer's word — the verb's own name, lowercase by the case's voice. */
+  verb: string;
+  /**
+   * TRUE only when the arm came from the KEYBOARD. A pointer arm must move no focus: the
+   * finger is already where the answer is, and moving focus on WebKit costs a `focusout` that
+   * the two-tap's own disarm then reads as a departure — the measured reason press 2 never
+   * fired there. A keyboard arm has the opposite need: the reader cannot see where to press
+   * next unless focus goes somewhere, and it goes to `keep`, never to the destructive answer,
+   * so a second Enter can only ever CANCEL.
+   */
+  autofocus?: boolean;
+}>();
+
+const emit = defineEmits<{ keep: []; go: [] }>();
+
+const keepEl = useTemplateRef<HTMLButtonElement>("keepEl");
+
+onMounted(() => {
+  // `preventScroll` because the foot is at the bottom of a scrollport: a plain focus() there
+  // scrolls the card to bring the ribbon into view, and the card has already been measured at
+  // a scroll offset this press must not change.
+  if (props.autofocus) keepEl.value?.focus({ preventScroll: true });
+});
