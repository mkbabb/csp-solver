+/** T9-W7 §10 pass 3 — NO DESK RUNG SPENDS `--sheet-chrome` (gap 8, and it was a SENTENCE).
+ *
+ *  The wordmark's foot publisher goes stale on WebKit at both desk rungs — the token reads
+ *  101.34 against an ink bottom of 117.75, 16.41px out at 1280 and 16.58 at 1440, and one
+ *  resize nudge corrects it exactly. Pass 2 booked that as harmless and gave a reason rather
+ *  than a row: "`--sheet-chrome` is a `<1024` rule, so nothing reads the stale value today."
+ *  That is a claim about a media query, which is the kind of claim that silently stops being
+ *  true — a single rule added outside the band, and a stale 16px lands in a live cap with no
+ *  test anywhere pointed at it.
+ *
+ *  So the sentence becomes the assertion. Walk every rule the page actually serves, find every
+ *  one that READS the token, and require each to sit under a `max-width: 1023.98px` condition.
+ *  It is engine-independent (it reads authored CSS, not computed style), it is cheap, and its
+ *  born-RED is the one-line style tag below.
+ *
+ *  PASS 4 — THIS ROW WAS RED IN BOTH ENGINES FOR TWO SEPARATE REASONS, and both are fixed here.
+ *
+ *  (a) THE BRANCH ORDER. `CSSStyleRule` implements `CSSGroupingRule` since CSS nesting, so
+ *      `"cssRules" in rule` is TRUE for every style rule in both engines. Testing that branch
+ *      first recursed into every style rule and examined none, and the walk returned 0 — caught
+ *      only because the row guards its own vacuity. `instanceof CSSStyleRule` is now tested
+ *      FIRST, and a style rule is still recursed into afterwards so a nested reader is seen.
+ *
+ *  (b) READERS, NOT DECLARERS — and this is the law's meaning, not a convenience. With the walk
+ *      corrected there are four rules mentioning the token and the fourth is `:root, :host`
+ *      outside any width condition: the build's own down-level twin of this tree's `@property`
+ *      block (`index.css` §6.5), which emits `--sheet-chrome: 0px` at the root for engines
+ *      without `@property`. A REGISTRATION at its initial value is the opposite of a stale
+ *      read — it is what makes an absent publisher compute to a number instead of to nothing.
+ *      The staleness this row books is a desk rung SPENDING the token, so the subject narrows
+ *      to `var(--sheet-chrome)` — every READER. Declarations are out of subject in both
+ *      directions and deliberately: the registration's initial cannot go stale, and an authored
+ *      declaration at a desk rung is dead ink unless some reader at that rung spends it, which
+ *      is the very thing this row forbids. The negative control plants a reader.
+ *
+ *  NO MASKED FALLBACK. The walk counts the sheets it could not enter and asserts that count is
+ *  zero, so a cross-origin or otherwise unwalkable sheet reds this row instead of silently
+ *  shrinking its corpus (the prior `catch` named a case that was not the case it swallowed).
+ */
+test("no desk rung spends --sheet-chrome — the staleness is booked where it cannot reach", async ({
+  page,
+}) => {
+  await loadSudoku(page);
+
+  const SPENDERS = () => {
+    const out: { selector: string; media: string; text: string }[] = [];
+    let refused = 0;
+    const walk = (rules: CSSRuleList, media: string) => {
+      for (const rule of rules) {
+        if (rule instanceof CSSMediaRule) {
+          walk(rule.cssRules, media ? `${media} AND ${rule.conditionText}` : rule.conditionText);
+          continue;
+        }
+        // CSSStyleRule FIRST: it also implements CSSGroupingRule under CSS nesting, so a
+        // `"cssRules" in rule` branch ahead of this one swallows every style rule (§(a) above).
+        if (rule instanceof CSSStyleRule && rule.style.cssText.includes("var(--sheet-chrome")) {
+          out.push({ selector: rule.selectorText, media, text: rule.style.cssText });
+        }
+        if ("cssRules" in rule) walk((rule as CSSGroupingRule).cssRules, media);
+      }
+    };
+    for (const sheet of document.styleSheets) {
+      try {
+        walk(sheet.cssRules, "");
+      } catch {
+        refused++;
+      }
+    }
+    return { out, refused };
+  };
+
+  const { out: spenders, refused } = await page.evaluate(SPENDERS);
+  // A sheet the walk cannot enter shrinks the corpus silently, so it reds the row instead.
+  expect(refused, "a stylesheet refused the walk — this row's corpus is incomplete").toBe(0);
+  // The walk must actually SEE the token, or a rename would make this row vacuously green.
+  expect(spenders.length, "the walk found no rule reading --sheet-chrome").toBeGreaterThan(0);
+  for (const s of spenders) {
+    expect(
+      s.media,
+      `a rule outside the <1024 band reads --sheet-chrome: ${s.selector} @ "${s.media}"`,
+    ).toContain("1023.98px");
+  }
+
