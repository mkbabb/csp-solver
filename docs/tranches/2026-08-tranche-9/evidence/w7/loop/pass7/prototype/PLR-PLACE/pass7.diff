+    await expect(deal).toBeVisible();
+    await c.bringToFront();
+    await cell(c, 20).click(); // C's first move since A opened: a clock on A with no settled cell
+    await expect
+      .poll(() => a.evaluate(() => (window as unknown as { __il: { arrived: number | null } }).__il.arrived), { timeout: 5000 })
+      .not.toBeNull();
