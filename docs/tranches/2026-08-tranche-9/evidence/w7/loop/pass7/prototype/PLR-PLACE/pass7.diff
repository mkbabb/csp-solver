+
+/**
+ * SHUT, THE HEAD PAINTS NOTHING (pass-6 critic gap 13). A sheet left half closed — faded but
+ * visible, or visible at no opacity with its edge still drawn — passed every row above, because
+ * every row reads a sheet that is OPEN. This one reads both sheets after a dismissal, at rest:
+ * the sheet's box is photographed as it is and with the sheet removed from the page
+ * (`display: none`), and no pixel may differ that a second bare photograph does not also move.
+ * The negative control is in the run: the shut pose planted at 35 % opacity, still visible.
+ */
+async function shutPaint(page: Page, sel: string) {
+  const s = page.locator(sel).first();
+  // the untransformed box, 10px wider on every side: the shut pose is scaled 0.9 and 8px lower
+  const b = await s.evaluate((e) => {
+    const el = e as HTMLElement;
+    const host = (el.offsetParent as HTMLElement).getBoundingClientRect();
+    const x = Math.max(0, Math.floor(host.left + el.offsetLeft - 10));
+    const y = Math.max(0, Math.floor(host.top + el.offsetTop - 10));
+    return { x, y, width: el.offsetWidth + 20, height: el.offsetHeight + 20 };
+  });
+  const shot = async () => (await page.screenshot({ clip: b, animations: 'disabled' })).toString('base64');
+  const on = await shot();
+  const again = await shot();
+  const tag = await page.addStyleTag({ content: `${sel} { display: none !important; }` });
+  const gone = await shot();
+  await tag.evaluate((e) => (e as Element).remove());
+  return page.evaluate(
+    async ({ on, again, gone }) => {
+      const px = async (b64: string) => {
+        const bmp = await createImageBitmap(await (await fetch(`data:image/png;base64,${b64}`)).blob());
+        const c = document.createElement('canvas');
+        c.width = bmp.width;
+        c.height = bmp.height;
+        const x = c.getContext('2d')!;
+        x.drawImage(bmp, 0, 0);
+        return x.getImageData(0, 0, c.width, c.height).data;
+      };
+      const [A, A2, G] = [await px(on), await px(again), await px(gone)];
+      const moved = (p: Uint8ClampedArray, q: Uint8ClampedArray, i: number) =>
+        Math.max(Math.abs(p[i] - q[i]), Math.abs(p[i + 1] - q[i + 1]), Math.abs(p[i + 2] - q[i + 2])) >= 6;
+      let n = 0;
+      for (let i = 0; i < A.length; i += 4) if (moved(A, G, i) && !moved(A, A2, i)) n++;
+      return n;
+    },
+    { on, again, gone },
+  );
+}
+
+test('shut, both head disclosures paint nothing', async ({ page }) => {
+  await page.setViewportSize({ width: 1280, height: 800 });
+  await page.emulateMedia({ colorScheme: 'light', reducedMotion: 'reduce' });
+  await page.goto(SOLO);
+  await settled(page);
+  const sheets = ['.corner-left [data-lobby]', '.corner-left .hover-card'];
+  const pose = (sel: string) =>
+    page.locator(sel).first().evaluate((e) => {
+      const c = getComputedStyle(e);
+      return `${c.opacity} ${c.visibility} ${c.pointerEvents}`;
+    });
+
+  await mark(page).click();
+  await openSheet(page);
+  await page.keyboard.press('Escape');
+  await page.locator('.corner-left .attribution-trigger').hover();
+  await expect(page.locator('.corner-left .hover-card')).toHaveClass(/is-open/);
+  await page.mouse.move(700, 700);
+  for (const sel of sheets) {
+    await expect(page.locator(sel).first()).not.toHaveClass(/is-open/);
+    await stable(() => pose(sel));
+    expect(await pose(sel), sel).toBe('0 hidden none');
+    expect(await shutPaint(page, sel), sel).toBe(0);
+  }
+  // THE NEGATIVE CONTROL: the shut pose half there.
+  const tag = await page.addStyleTag({
+    content: '.head-sheet:not(.is-open) { opacity: 0.35 !important; visibility: visible !important; }',
+  });
+  for (const sel of sheets) expect(await shutPaint(page, sel), `${sel} planted`).toBeGreaterThan(100);
+  await tag.evaluate((e) => (e as Element).remove());
+});
