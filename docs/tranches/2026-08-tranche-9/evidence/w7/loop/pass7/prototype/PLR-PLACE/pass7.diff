+});
+onBeforeUnmount(stopTimers);
+
+const placed = (id: string) => typeof settled.value[id] === "number";
+
+/** A seating chart of a room with nobody else in it is not a chart, so it draws only when the
+ *  room is ≥2. A peer with no settled cell, or with no ink, has a row and no dot: BoardHost's
+ *  law, an unknown author gets no colour, and a fallback here would draw a stranger in yours. */
+const chart = computed<PlaceChartInput | null>(() => {
+  const p = props.place;
+  if (!p || !live.value || yielded.value) return null;
+  return {
+    size: p.size,
+    subgrid: p.subgrid,
+    self: selfAt.value,
+    // YOUR RING IS YOUR MARK'S INK. Unbound, the ring inherited the estate's default
+    // `--color-user-ink` (the incumbent blue) while the mark beside it wore the room's colour
+    // for you: two colours for one person on one sheet (pass 4, frame 2).
+    selfInk: props.ink,
+    peers: props.rows
+      .filter((r) => !r.self && placed(r.id) && r.ink["--color-user-ink"])
+      .map((r) => ({
+        id: r.id,
+        ink: r.ink["--color-user-ink"],
+        pos: settled.value[r.id] as number,
+      })),
+  };
+});
+
+const lines = computed<LobbyLine[]>(() =>
+  shown.value.map((r) => {
+    const quiet = quietAt.value[r.id];
+    return {
+      id: r.id,
+      name: r.name,
+      ink: r.ink,
+      qualifier: r.self
+        ? LOBBY_COPY.self
+        : quiet !== null && quiet !== undefined && quiet >= props.quietAfterMs
+          ? LOBBY_COPY.quiet(Math.floor(quiet / 1000))
+          : chart.value && !placed(r.id)
+            ? LOBBY_COPY.unplaced
+            : "",
+    };
+  }),
+);
+</script>
+
+<template>
+  <!-- `onPress` / `onRelease` are the seam (`TAP_IS_A_LOOK`). Enter and Space are a native
+       button's click and nothing else: the `@keydown.enter` that used to sit beside it ran the
+       handler AND the synthesised click, netting zero (CH-70). -->
+  <button
+    ref="el"
+    type="button"
+    data-player-mark
+    class="player-mark"
+    :class="{ 'is-live': live }"
+    :style="[live ? ink : null, { '--presence-ink-dur': `${MOTION.presenceInkMs}ms` }]"
+    :aria-label="stateLine"
+    :aria-expanded="isOpen"
+    :aria-controls="lobbyId"
+    @click.stop="onClick"
+    @pointerdown="onPress"
+    @pointerup="onRelease"
+    @pointerenter="onEnter"
+    @pointerleave="onLeave"
+    @keydown="onKey"
+    @focus="onFocus"
+    @focusout="onBlur"
+  >
+    <PlayerStub :size="20" :pose="pose" />
+  </button>
+  <!-- THE SHEET ANSWERS ITS OWN TAP, AND THE TAP ENDS ON IT (pass-4 critic, the thin lap; pass 7).
+       A touch on the open sheet is prevented at its press and shuts the sheet at its release (the
+       seam, above). The release shuts it before Chromium's tap gesture has finished, and the tap
+       then ended on the cell under the sheet (row 7, Chromium: focus reached that cell; WebKit sends
+       no click after a prevented press and was never affected). A prevented `touchend` asks for
+       no click at all, so the tap ends on the sheet in both engines. `@click="close"` stays for
+       Chromium's taps 1–3px inside the bottom edge (rows 12 and 14 red there without it; no `.stop`:
+       the page root still hears it). A mouse press on the sheet is shut by the page root alone. -->
+  <PlayerLobby
+    :id="lobbyId"
+    :open="isOpen"
+    :state-line="stateLine"
+    :lines="lines"
+    :overflow="overflow"
+    :chart="chart"
+    @click="close"
+    @touchend.prevent
+    @pointerdown="onSheetPress"
+    @pointerup="onSheetRelease"
+  />
+</template>
+
+<style scoped>
+/* The `@mbabb` trigger's own √φ rungs, so the two marks share one centre line: 20px of stub
+   plus 2 × 9.888 is 39.8 tall, exactly the trigger's height at a fine pointer. */
+.player-mark {
+  display: flex;
+  align-items: center;
+  background: transparent;
+  border: none;
+  padding: 0.618rem 0.786rem;
+  cursor: pointer;
+  /* THE INK IS BOUND ONCE, HERE, and every other rule in this block leaves it alone. */
+  --mark-ink: var(--ink-press-quiet);
+  color: var(--mark-ink);
+  transition: color var(--presence-ink-dur) var(--ease-standard);
+}
+
+/* THE ONE SENTENCE. Your own index in the room's `k` is bound on this button by `App.vue`, so
+   `--color-user-ink` here is the colour every other page paints you — which is why the mark
+   going coloured means somebody else arrived, and not merely that a feature exists. */
+.player-mark.is-live {
+  --mark-ink: var(--color-user-ink);
+}
+
+/* ONE affordance, and it is not a colour: the stub is picked up (pose 0 → pose 1, both baked,
+   no filter, no travel, same frame). The swap is in the template because a `d` is an attribute;
+   what lives here is the ring, and the ring takes `currentColor` so it is the mark's own ink at
+   whatever the room made it. Per CHAIR §6.1 this family READS the focus-ring token and never
+   mints one: the form is `DrawerTab`'s (R6 law 39), and it adopts §6's chrome token the day one
+   ships. */
+.player-mark:focus-visible {
+  outline: 2px dashed currentColor;
+  outline-offset: 3px;
+}
+
+/* The floor is two-dimensional and it is declared ON THE MARK: `.attribution-trigger` is
+   excluded from the estate's coarse `min-width` arm (index.css:849) because it re-measured
+   full-width there, and this control is 45.2 wide at a fine pointer — under 44 in neither
+   dimension only because it says so here.
+
+   CONSUMED BARE (pass-4 gap 12). `--tap-floor` is T9-W2 §2.6's one declaration, on `.page-root`
+   at `src/assets/index.css:821-828`; a static token declared in the page's own stylesheet is
+   always present, so `, 2.75rem` here would be a second, silent publisher of the floor — the
+   very lie the same diff strikes on `--head-rule`. The estate's own copies of the fallback
+   (index.css:834/849, DrawerTab.vue:181, GameControlPanel.vue:1813) are NOT this lane's to
+   strike; they are named here so §10's leader can. */
+@media (pointer: coarse) {
+  .player-mark {
+    min-width: var(--tap-floor);
+    min-height: var(--tap-floor);
+    justify-content: center;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .player-mark {
+    transition-duration: 0s;
+  }
+}
+</style>
