+const laps = (a: DOMRect, b: DOMRect) =>
+  a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;
+const covered = (a: DOMRect, b: DOMRect) =>
+  Math.max(0, Math.min(a.right, b.right) - Math.max(a.left, b.left)) *
+  Math.max(0, Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top));
+
+async function drawn(short: boolean, bare = false) {
+  cramped.value = short;
+  yielded.value = bare;
+  await nextTick();
+  const sheet = document.getElementById(lobbyId);
+  const host = sheet?.offsetParent;
+  if (!sheet || !(host instanceof HTMLElement)) return null;
+  const at = host.getBoundingClientRect();
+  const left = at.left + sheet.offsetLeft;
+  return {
+    box: new DOMRect(
+      left,
+      at.top + sheet.offsetTop,
+      sheet.offsetWidth,
+      sheet.offsetHeight,
+    ),
+    rowsStart: left + parseFloat(getComputedStyle(sheet).paddingLeft),
+  };
+}
