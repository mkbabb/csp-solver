+const BANDS = ['top', 'right', 'bottom', 'left'] as const;
+async function fourBands(page: Page, sel: string) {
+  const sheet = page.locator(`${sel}:visible`).first();
+  const b = (await sheet.boundingBox())!;
+  const vw = page.viewportSize()!;
+  const read: Record<string, { stations: number; median: number }> = {};
+  for (const side of BANDS) {
+    const raw =
+      side === 'top' ? { x: b.x, y: b.y - 8, width: b.width, height: 16 }
+      : side === 'bottom' ? { x: b.x, y: b.y + b.height - 8, width: b.width, height: 16 }
+      : side === 'left' ? { x: b.x - 8, y: b.y, width: 16, height: b.height }
+      : { x: b.x + b.width - 8, y: b.y, width: 16, height: b.height };
+    const x = Math.max(0, Math.floor(raw.x)), y = Math.max(0, Math.floor(raw.y));
+    const clip = { x, y, width: Math.min(vw.width - x, Math.ceil(raw.width)), height: Math.min(vw.height - y, Math.ceil(raw.height)) };
+    const on = (await page.screenshot({ clip, animations: 'disabled' })).toString('base64');
+    const tag = await page.addStyleTag({ content: '.head-sheet-edge { visibility: hidden !important; }' });
+    const off = (await page.screenshot({ clip, animations: 'disabled' })).toString('base64');
+    await tag.evaluate((e) => (e as Element).remove());
+    read[side] = await page.evaluate(
+      async ({ on, off, horiz }) => {
+        const px = async (b64: string) => {
+          const bmp = await createImageBitmap(await (await fetch(`data:image/png;base64,${b64}`)).blob());
+          const c = document.createElement('canvas');
+          c.width = bmp.width;
+          c.height = bmp.height;
+          const x = c.getContext('2d')!;
+          x.drawImage(bmp, 0, 0);
+          return x.getImageData(0, 0, c.width, c.height);
+        };
+        const lum = (d: Uint8ClampedArray, i: number) => {
+          const f = (v: number) => ((v /= 255) <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
+          return 0.2126 * f(d[i]) + 0.7152 * f(d[i + 1]) + 0.0722 * f(d[i + 2]);
+        };
+        const [A, B] = [await px(on), await px(off)];
+        const len = horiz ? A.width : A.height, depth = horiz ? A.height : A.width;
+        const st: number[] = [];
+        for (let s = Math.floor(len * 0.1); s < Math.ceil(len * 0.9); s++) {
+          let best = 1;
+          for (let d = 0; d < depth; d++) {
+            const i = ((horiz ? d : s) * A.width + (horiz ? s : d)) * 4;
+            const [p, q] = [lum(A.data, i), lum(B.data, i)];
+            best = Math.max(best, (Math.max(p, q) + 0.05) / (Math.min(p, q) + 0.05));
+          }
+          st.push(best);
+        }
+        st.sort((p, q) => p - q);
+        return { stations: st.length, median: st.length ? +st[st.length >> 1].toFixed(3) : 0 };
+      },
+      { on, off, horiz: side === 'top' || side === 'bottom' },
+    );
+  }
+  return read;
+}
