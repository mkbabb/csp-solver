+    const clicks: string[] = [];
+    (window as any).__clicks = clicks;
+    addEventListener('click', (e) => el.contains(e.target as Node) && clicks.push((e as PointerEvent).pointerType), { capture: true });
+  });
+  const read = () => page.evaluate(() => ({ states: (window as any).__states as string[], clicks: (window as any).__clicks as string[] }));
+  await mark(page).tap();
+  await stable(read);
+  // the plant is live in this engine: the tap's one click reached the mark labelled `mouse`...
+  // ...and it toggled nothing; the release did.
+  expect(await read()).toEqual({ states: ['false', 'true'], clicks: ['mouse'] });
+  await mark(page).tap();
+  await stable(read);
+  expect(await read()).toEqual({ states: ['false', 'true', 'false'], clicks: ['mouse', 'mouse'] });
+  await ctx.close();
+});
