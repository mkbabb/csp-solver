+    const ring = w.find(".chart-self");
+    expect(ring.exists()).toBe(true);
+    expect(ring.attributes("fill")).toBe("none");
+    // stroke 2 CSS px, in user units
+    expect(+ring.attributes("stroke-width")!).toBeCloseTo(2 * (1000 / 96), 6);
+    expect(w.findAll(".chart-dot")).toHaveLength(0);
+  });
+
+  it("has no ring when your cell is unknown or hidden", () => {
+    const w = mount(PlaceChart, { props: { ...base, self: null } });
+    expect(w.find(".chart-self").exists()).toBe(false);
+  });
+});
+
+describe("PlaceChart — the query dims the others and nothing else", () => {
+  it("dims every dot but the queried one, and dims none when nothing is queried", () => {
+    const peers = [
+      { id: "p1", ink: "#c026d3", pos: 10 },
+      { id: "p2", ink: "#65a30d", pos: 40 },
+      { id: "p3", ink: "#0891b2", pos: 70 },
+    ];
+    const none = mount(PlaceChart, { props: { ...base, peers } });
+    expect(none.findAll(".chart-dot.is-dimmed")).toHaveLength(0);
+    const one = mount(PlaceChart, { props: { ...base, peers, queried: "p2" } });
+    const dimmed = one.findAll(".chart-dot.is-dimmed");
+    expect(dimmed).toHaveLength(2);
+    expect(one.find('.chart-dot[data-peer="p2"]').classes()).not.toContain("is-dimmed");
+  });
+});
diff --git a/web/frontend/src/pencil/chrome/PlayerMark/PlaceChart.vue b/web/frontend/src/pencil/chrome/PlayerMark/PlaceChart.vue
new file mode 100644
index 00000000..143354b1
--- /dev/null
+++ b/web/frontend/src/pencil/chrome/PlayerMark/PlaceChart.vue
@@ -0,0 +1,148 @@
+<script setup lang="ts">
+/**
+ * PlaceChart — THE BOARD, WITH THE ROOM ON IT (T9-W7 PLR-PLACE §3.3).
+ *
+ * The board's own frame and box rules at pose 0, a filled dot per peer at the cell they have
+ * SETTLED on, and a ring at yours. Geometry and nothing else: `generateGridBoilFrames` hands
+ * back the same paths `HandDrawnGrid` draws the real board with, the grain is already baked
+ * into them, and pose 0 enrols no beat — so this mints zero live filters (π: `filterBudget`
+ * stays 9, measured with the chart open).
+ *
+ * THE PITCH IS HELD, NOT THE BOX (pass 2). Pass 1 fixed the chart at 96px and let the pitch
+ * fall out of it, which put a 16×16 board's dots 1.0px apart — a density picture, not a seating
+ * chart, and this family is a seating chart or nothing. So the CELL is the constant: 10.667 CSS
+ * px of pitch at every size, a dot of r 4 (8.00px across) and 2.667px of gap between two
+ * neighbours' dots, whatever the board. The chart is then 42.7 at 4×4, 96 at 9×9 and 170.7 at
+ * 16×16 — and the 16×16's extra 74.7px of height is paid and declared, not hidden.
+ *
+ * WHY NOT 24px AT ALL. The same inks read 5.23–6.11:1 light and 9.52–10.63:1 dark here, against
+ * 2.35–2.69:1 at 24px on both light grounds in both engines; the frame reads 12.48 against
+ * 1.52. The failure at 24 was SIZE, not colour, and the cell lines are the proof — they are
+ * 0.48px of stroke even here, so they are not drawn. What a reader gets is the box grid.
+ */
+import { computed } from "vue";
+import { generateGridBoilFrames } from "@pencil/grid/gridPaths";
+
+const props = defineProps<{
+  /** the board's side — 4, 9 or 16 */
+  size: number;
+  /** the box root — 3 on a 9×9, 4 on a 16×16, the side itself on a Latin board */
+  subgrid: number;
+  /** a peer per settled cell, in the ink their digits are written in; a peer with no ink is
+   *  not in this list at all (BoardHost's law: an unknown author gets no colour) */
+  peers: { id: string; ink: string; pos: number }[];
+  /** your own cell, or `null` — no cell touched yet, or your cell is hidden */
+  self: number | null;
+  /** the peer id whose row the reader is pointing at, or `null` — the query */
+  queried: string | null;
+}>();
+
+/** The board's own coordinate system. */
+const VIEWBOX = 1000;
+/** THE ONE CONSTANT: CSS px per cell. 8.00 of dot + 2.667 of gap. */
+const PITCH = 32 / 3;
+const side = computed(() => PITCH * props.size);
+/** viewBox units per painted CSS px — every stroke and radius below is written in px × this. */
+const U = computed(() => VIEWBOX / side.value);
+
+const grid = computed(() => generateGridBoilFrames(props.size, props.subgrid, VIEWBOX));
+const cell = computed(() => VIEWBOX / props.size);
+const at = (pos: number) => ({
+  cx: ((pos % props.size) + 0.5) * cell.value,
+  cy: (Math.floor(pos / props.size) + 0.5) * cell.value,
+});
+/** r 4 CSS px at EVERY size — the pitch is what changed, so this never has to. */
+const dotR = computed(() => 4 * U.value);
+</script>
+
+<template>
+  <!-- aria-hidden: the log already speaks every arrival, W3 speaks "looked away" and the cell
+       names, and the rows below are the readable list. A picture of positions read aloud cell
+       by cell would be a fourth live region saying what three already say. -->
+  <svg
+    class="place-chart"
+    :viewBox="`0 0 ${VIEWBOX} ${VIEWBOX}`"
+    :width="side"
+    :height="side"
+    aria-hidden="true"
+    focusable="false"
+  >
+    <path
+      class="chart-frame"
+      :d="grid.frame[0]"
+      fill="none"
+      :stroke-width="2 * U"
+      stroke-linejoin="round"
+      stroke-linecap="round"
+    />
+    <!-- THE BOX RULES ARE 2px, like the frame and the ring. At 1.25px a hand-drawn line that
+         wanders across pixel columns never covers one whole pixel on some rows: painted at DPR 1
+         the rule's best row read 3.52:1 in light (the token's own ceiling) and its worst 2.07,
+         with 25–36% of rows under 3:1 (pass 4). 2px always covers one whole pixel per row, so
+         every row reaches the token. The ink, not the weight, keeps the rule under the frame. -->
+    <path
+      v-for="(line, i) in grid.subgridLines"
+      :key="i"
+      class="chart-rule"
+      :d="line[0]"
+      fill="none"
+      :stroke-width="2 * U"
+      stroke-linecap="round"
+    />
+    <circle
+      v-for="p in peers"
+      :key="p.id"
+      class="chart-dot"
+      :class="{ 'is-dimmed': queried !== null && queried !== p.id }"
+      :data-peer="p.id"
+      :cx="at(p.pos).cx"
+      :cy="at(p.pos).cy"
+      :r="dotR"
+      :fill="p.ink"
+    />
+    <!-- YOU ARE A RING, which is the estate's own peer-cursor idiom (gameCell.css:229-241)
+         re-used rather than a second convention: "which one is me" costs no hue, so it costs
+         nothing when the walk puts a peer 12.5° from your blue. Stroke 2, not 1.5: 1.5px read
+         3.18:1 on the phone ground, inside the noise, and 2 is `HandDrawnOutline`'s keep. -->
+    <circle
+      v-if="self !== null"
+      class="chart-self"
+      :cx="at(self).cx"
+      :cy="at(self).cy"
+      :r="dotR"
+      fill="none"
+      :stroke-width="2 * U"
+    />
+  </svg>
+</template>
+
+<style scoped>
+.place-chart {
+  display: block;
+  overflow: visible;
+}
+
+.chart-frame {
+  stroke: var(--color-pencil-graphite);
+  stroke-opacity: 0.95;
+}
+
+.chart-rule {
+  stroke: var(--ink-press-rule);
+}
+
+/* THE QUERY, and it is one CSS state (R6 law 14, one affordance). Pointing at a row does not
+   move a dot, recolour a dot or add a label to a dot: it takes the PRESSURE off the others, the
+   way the rule ink already means "quieter" everywhere else in this estate. Same-frame — there
+   is no transition here, because a dim is an answer to a pointer and an answer must not lag. */
+.chart-dot.is-dimmed {
+  opacity: 0.55;
+}
+
+/* NO TRANSITION ON A DOT, anywhere. The dot STEPS: `cx`/`cy` are swapped when the peer's
+   `cur` has held one cell for `PLACE_SETTLE_MS`, and a step has nothing to reduce — the
+   PRM form and the shipped form are the same form. */
+.chart-self {
+  stroke: var(--color-user-ink);
+}
+</style>
diff --git a/web/frontend/src/pencil/chrome/PlayerMark/PlayerLobby.vue b/web/frontend/src/pencil/chrome/PlayerMark/PlayerLobby.vue
new file mode 100644
index 00000000..bbcfdb9e
--- /dev/null
+++ b/web/frontend/src/pencil/chrome/PlayerMark/PlayerLobby.vue
@@ -0,0 +1,198 @@
+<script setup lang="ts">
+import { ref, watch } from "vue";
+import PlayerStub from "../icons/PlayerStub.vue";
+import HeadSheet from "../AttributionCard/HeadSheet.vue";
+import PlaceChart from "./PlaceChart.vue";
+import type { LobbyLine, PlaceChartInput } from "./types";
+
+const props = defineProps<{
+  id: string;
+  open: boolean;
+  stateLine: string;
+  lines: LobbyLine[];
+  /** `and 3 more` — the compression line, or empty. */
+  overflow: string;
+  /** the seating chart (T9-W7 PLR-PLACE), or `null` — no room, or nobody else at it */
+  chart?: PlaceChartInput | null;
+}>();
+
+/**
+ * THE QUERY (T9-W7 PLR-PLACE; R6 law 14, one affordance). A mouse over a row whose player has a
+ * dot takes the pressure off every OTHER dot. A row with no dot asks nothing — your own row
+ * (your mark is the ring, which is never dimmed) and a peer with no cell shown — because a
+ * question with no answer would only dim the whole chart. A touch never queries: it cannot
+ * hover, and a tap on this sheet is its dismissal.
+ */
+const queried = ref<string | null>(null);
+function ask(e: PointerEvent, id: string): void {
+  if (e.pointerType === "touch") return;
+  queried.value = props.chart?.peers.some((d) => d.id === id) ? id : null;
+}
+watch(
+  () => props.open,
+  () => (queried.value = null),
+);
+</script>
+
+<template>
+  <!-- THE HEAD'S ONE SHEET (`HeadSheet`: the @mbabb card's hang, fade and drawn edge, shared
+       with it, CH-71), `min-width: 16rem`. Hung off the wrapper rather than off the mark, it
+       opens at the PAGE's left edge — right edge 256, which clears the sun's x = 326 on a phone
+       and 1072 on the desk.
+
+       WHY THE GROUND IS THE ONE THING THAT DEPARTS FROM THE CARD. The card holds two lines over
+       whatever is behind it; this holds a LIST down the page, and what is behind it is the
+       wordmark's own bleed — measured rgb(204,203,203) over 8.9% of the desk sheet's box and
+       27.7% of the state line's. At 80% the quiet rung composites to 91 on that bleed, which is
+       4.23:1 against a local ground of 204: under the AA floor, and true today only because the
+       wordmark's strokes and a 3-to-13-character slug have not yet landed on each other. Luck is
+       not a design, so the arm the estate already wrote for `prefers-reduced-transparency` is
+       promoted to the default and the arm itself is deleted (it would be a no-op). The @mbabb
+       card's ground is untouched. Declared as this family's one DELTA; the owner disposes.
+
+       NO `role`, NO `aria-live`. The room's one `role="log"` stays mounted in the controls card
+       where it can speak whether this sheet is open or shut; a region inside a closed disclosure
+       announces nothing. These rows are plain markup — a disclosure, not a dialog.
+
+       NO `@click.stop`, and that is the phone's dismissal. There is nothing focusable in this
+       box and nothing in it to press, so a tap on it can only mean "I am done reading": the mark
+       shuts it (its `@click`, which falls through to this root) and the page root's `closeAll`
+       hears the same tap. That is what prices the lap —
+       whatever this sheet covers, one tap uncovers. Shut, it is `pointer-events: none`, so it
+       can never swallow a press meant for the board. -->
+  <HeadSheet :id="id" data-lobby class="player-lobby" :open="open">
+    <!-- R6 LAW 33, ONE NAME PER ACT (registry-v3 §2.5: the sheet's first line is never the
+         name's sentence). In a room the chart IS the first line, and the state line is not drawn:
+         the mark already says it, and the rows under the chart say who. Alone there is no chart,
+         so the line is drawn for the eye and `aria-hidden` for the ear, which heard it once, as
+         the name of the button that opened this. -->
+    <p v-if="!chart" class="pl-state" aria-hidden="true">{{ stateLine }}</p>
+    <!-- MOUNTED THROUGH THE CLOSE (pass-4 critic, the close cut): `open && chart` unmounted the
+         chart in the first shut frame, at opacity 1, and the sheet dropped 96px before its fade
+         began. A close is a pose; the chart leaves with the sheet, and holds still while it goes. -->
+    <PlaceChart
+      v-if="chart"
+      class="pl-chart"
+      :style="chart.selfInk"
+      :size="chart.size"
+      :subgrid="chart.subgrid"
+      :peers="chart.peers"
+      :self="chart.self"
+      :queried="queried"
+    />
+    <ul v-if="lines.length" class="pl-rows">
+      <li
+        v-for="p in lines"
+        :key="p.id"
+        class="pl-row"
+        :style="p.ink"
+        @pointerenter="ask($event, p.id)"
+        @pointerleave="queried = null"
+      >
+        <PlayerStub :size="14" class="pl-stub" />
+        <span class="pl-name">{{ p.name }}</span>
+        <span v-if="p.qualifier" class="pl-qual">{{ p.qualifier }}</span>
+      </li>
+    </ul>
+    <p v-if="overflow" class="pl-more">{{ overflow }}</p>
+  </HeadSheet>
+</template>
+
+<style scoped>
+.player-lobby {
+  /* OPAQUE. See the template note: this is the family's one declared delta from the card's
+     ground, and it is what makes every reading on this sheet a number rather than a stroke of
+     luck. `prefers-reduced-transparency` / `prefers-contrast: more` need no arm here — the
+     ground they would have asked for is the ground that ships. */
+  background: var(--color-popover);
+}
+
+/* REDUCED MOTION: the sheet appears and goes, with no fade and no delayed hide. BOTH selectors,
+   and each one class above `HeadSheet`'s own, because a media query adds no specificity and the
+   two scoped sheets land in no promised order: `.head-sheet.is-open` out-ranked a bare
+   `.player-lobby` here, and the open sheet kept its 150ms fade under reduce (PLR-PLACE pass 3,
+   measured `0.15s, 0.15s, 0s`). */
+@media (prefers-reduced-motion: reduce) {
+  .player-lobby.head-sheet,
+  .player-lobby.head-sheet.is-open {
+    transition-duration: 0s;
+    transition-delay: 0s;
+  }
+}
+
+/* M01's raise lives on the ROWS and only there. The state line, the qualifier and `and N more`
+   keep the tag rung: a one-rung raise on all three spends 16.2px of line box against the 12.4px
+   the coarse phone has between the sheet's bottom and the board's top (research R13, measured),
+   and a caption is not a control. */
+.pl-state {
+  margin: 0;
+  font-family: var(--font-hand);
+  font-size: var(--type-tag);
+  font-weight: 500;
+  line-height: 1.35;
+  color: var(--ink-press-quiet);
+}
+
+/* THE CHART IS THE FIRST LINE, so it has no berth of its own: the sheet's padding above it and
+   the rows' own 0.35rem below. In a room the height law is `36 + 10.667·N + 5.6 + 22.4·r +
+   (1.6 + S)·m` — the state line's S and the pass-3 chart's 8px berth are both gone from it. */
+
+/* THE FURNITURE IS DECLARED, NOT INHERITED (T9-W7 §11 — the substrate PLR-COUNT and PLR-PLACE
+   graft). `gap: 0` is said out loud because the height law has no term for one and a later hand
+   adding a gap here would break three families' arithmetic silently. */
+.pl-rows {
+  margin: 0.35rem 0 0;
+  padding: 0;
+  list-style: none;
+  display: flex;
+  flex-direction: column;
+  gap: 0;
+}
+
+/* ONE RUNG ABOVE THE WELL'S TAG (M01: raise, never lower) — 16px on the desk and on a coarse
+   phone against the roster's 14. The row carries the peer's own ink, so `currentColor` inks the
+   stub and `--color-user-ink` inks the name from the one binding. */
+/* THE ROW IS 22.4px TALL IN BOTH POINTER REGIMES, AND IT SAYS SO. `line-height: 1.35` on a
+   `--type-small` rung gives 20.39 at a fine pointer and moves with the mobile scale; the floor
+   is what makes `H = 36 + S + 5.6 + 22.4r + (1.6 + S)m` one law rather than two, and the
+   sections that graft this furniture (PLR-COUNT's tally, PLR-PLACE's list) read the 22.4 out of
+   this declaration. 1.4rem = 22.4px at the estate's 16px root. */
+.pl-row {
+  display: flex;
+  align-items: center;
+  gap: 0.35rem;
+  min-height: 1.4rem;
+  font-family: var(--font-hand);
+  font-size: var(--type-small);
+  line-height: 1.35;
+  color: var(--color-user-ink);
+}
+
+.pl-stub {
+  flex: 0 0 auto;
+}
+
+.pl-name {
+  color: var(--color-user-ink);
+}
+
+/* The qualifier's berth is the ROW's own 0.35rem gap and nothing besides — a `margin-left` on
+   top of it measured 11.2px, which is two spacings for one relationship. In the well this fact
+   sat at the row's far edge, 153.3px from the last letter it qualifies: a column, not a
+   sentence. Here it is 5.6px, and it reads as part of the line. */
+.pl-qual {
+  font-size: var(--type-tag);
+  font-weight: 400;
+  color: var(--ink-press-quiet);
+}
+
+/* The compression line's own 1.6px berth is the `m` term of the height law — declared, so the
+   law has a number for it rather than inheriting one. */
+.pl-more {
+  margin: 0.1rem 0 0;
+  font-family: var(--font-hand);
+  font-size: var(--type-tag);
+  line-height: 1.35;
+  color: var(--ink-press-quiet);
+}
+</style>
diff --git a/web/frontend/src/pencil/chrome/PlayerMark/PlayerMark.place.test.ts b/web/frontend/src/pencil/chrome/PlayerMark/PlayerMark.place.test.ts
new file mode 100644
index 00000000..252392b6
--- /dev/null
+++ b/web/frontend/src/pencil/chrome/PlayerMark/PlayerMark.place.test.ts
@@ -0,0 +1,225 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { mount } from "@vue/test-utils";
+import PlayerMark from "./PlayerMark.vue";
+import type { MarkRow, PlaceInput } from "./types";
+
+/**
+ * THE SEATING CHART'S CLOCK (T9-W7 PLR-PLACE). The sheet OPENS on where the room is now and
+ * damps only the moves that come after; a row with no dot asks the chart nothing.
+ */
+const ROWS: MarkRow[] = [
+  { id: "me", name: "swift-heron", ink: { "--color-user-ink": "#2563eb" }, self: true },
+  {
+    id: "p1",
+    name: "brave-otter",
+    ink: { "--color-user-ink": "#c026d3" },
+    self: false,
+  },
+  { id: "p2", name: "calm-wren", ink: { "--color-user-ink": "#65a30d" }, self: false },
+  { id: "p3", name: "shy-lynx", ink: { "--color-user-ink": "#0891b2" }, self: false },
+];
+const place = (
+  cursors: Record<string, number | null>,
+  self: number | null = 40,
+): PlaceInput => ({
+  size: 9,
+  subgrid: 3,
+  cursors,
+  self,
+  settleMs: 700,
+});
+
+const dots = () =>
+  [...document.querySelectorAll<SVGCircleElement>("[data-lobby] .chart-dot")].map(
+    (d) => ({
+      id: d.dataset.peer,
+      cx: d.getAttribute("cx"),
+      dim: d.classList.contains("is-dimmed"),
+    }),
+  );
+
+function mountMark(cursors: Record<string, number | null>) {
+  return mount(PlayerMark, {
+    attachTo: document.body,
+    props: { ink: {}, rows: ROWS, place: place(cursors) },
+  });
+}
+
+beforeEach(() => vi.useFakeTimers());
+afterEach(() => {
+  vi.useRealTimers();
+  document.body.innerHTML = "";
+});
+
+describe("the chart opens on the room as it is", () => {
+  it("draws every settled peer at the press, before any timer runs", async () => {
+    const w = mountMark({ p1: 10, p2: 20, p3: 30 });
+    await w.find("button").trigger("click");
+    expect(dots().map((d) => d.id)).toEqual(["p1", "p2", "p3"]);
+    expect(document.querySelectorAll("[data-lobby] .chart-self")).toHaveLength(1);
+    w.unmount();
+  });
+
+  it("holds a MOVE until the peer has sat still for settleMs, then steps", async () => {
+    const w = mountMark({ p1: 10, p2: 20, p3: 30 });
+    await w.find("button").trigger("click");
+    const before = dots().find((d) => d.id === "p1")!.cx;
+    await w.setProps({ place: place({ p1: 11, p2: 20, p3: 30 }) });
+    vi.advanceTimersByTime(699);
+    await w.vm.$nextTick();
+    expect(dots().find((d) => d.id === "p1")!.cx).toBe(before);
+    vi.advanceTimersByTime(1);
+    await w.vm.$nextTick();
+    expect(dots().find((d) => d.id === "p1")!.cx).not.toBe(before);
+    w.unmount();
+  });
+
+  it("a peer with no cell has a row, no dot, and says so", async () => {
+    const w = mountMark({ p1: 10, p2: null });
+    await w.find("button").trigger("click");
+    expect(dots().map((d) => d.id)).toEqual(["p1"]);
+    const quals = [...document.querySelectorAll("[data-lobby] .pl-qual")].map((q) =>
+      q.textContent?.trim(),
+    );
+    expect(quals).toEqual(["you", "no cell shown", "no cell shown"]);
+    w.unmount();
+  });
+});
+
+describe("the query asks only rows that have an answer", () => {
+  const enter = (i: number, pointerType = "mouse") => {
+    const row = document.querySelectorAll("[data-lobby] .pl-row")[i]!;
+    const e = new Event("pointerenter") as Event & { pointerType: string };
+    Object.defineProperty(e, "pointerType", { value: pointerType });
+    row.dispatchEvent(e);
+  };
+
+  it("a peer's row dims every other dot; your own row dims none", async () => {
+    const w = mountMark({ p1: 10, p2: 20, p3: 30 });
+    await w.find("button").trigger("click");
+    enter(2);
+    await w.vm.$nextTick();
+    expect(dots().map((d) => d.dim)).toEqual([true, false, true]);
+    enter(0);
+    await w.vm.$nextTick();
+    expect(dots().map((d) => d.dim)).toEqual([false, false, false]);
+    enter(1, "touch");
+    await w.vm.$nextTick();
+    expect(dots().map((d) => d.dim)).toEqual([false, false, false]);
+    w.unmount();
+  });
+});
+
+// PASS-4 CRITIC, THE HOSTAGE: a settle timer is ONE peer's. Two movers, because a gate with one
+// mover cannot see a clock the room shares (LAWS P4, the TWO-MOVERS row).
+describe("each peer's clock is its own", () => {
+  const cxOf = (id: string) => dots().find((d) => d.id === id)!.cx;
+
+  it("p2 moves once while p1 walks every 250 ms: p2 steps 700 ms after ITS move", async () => {
+    const w = mountMark({ p1: 10, p2: 20, p3: 30 });
+    await w.find("button").trigger("click");
+    const before = cxOf("p2");
+    let p1 = 10;
+    await w.setProps({ place: place({ p1, p2: 60, p3: 30 }) });
+    for (let t = 250; t <= 1000; t += 250) {
+      vi.advanceTimersByTime(250);
+      p1 += 1;
+      await w.setProps({ place: place({ p1, p2: 60, p3: 30 }) });
+    }
+    await w.vm.$nextTick();
