+/**
+ * F1'S FOURTH SURFACE — THE DECK'S SWATCH (pass-3 G14, re-born; pass-5 row 6). Reached by the
+ * estate's own gallery control (the wordmark), never `?view=gallery`, which reloads the page and
+ * evicts the room. The webkit race was the rig reading the deck before the room formed; the row
+ * now waits on the ROOM (three swatches) and only then reads your own.
+ */
+test('the deck paints your swatch in the colour the room paints you', async ({ browser }) => {
+  const ctx: BrowserContext = await browser.newContext({ viewport: { width: 1280, height: 800 } });
+  const a = await ctx.newPage();
+  await a.goto(SOLO);
+  await settled(a);
+  const link = await invite(a);
+  const b = await ctx.newPage();
+  await b.goto(link);
+  await settled(b);
+  await a.bringToFront();
+  await expect.poll(() => a.locator('.players-roster .player-row').count()).toBe(2);
+  // WHAT THE ROOM PAINTS YOU is read off the OTHER page: B's row for A's slug.
+  const aSlug = await a.evaluate(
+    () =>
+      document
+        .querySelector('.players-roster .player-row:has(.player-self) .player-name')
+        ?.textContent?.trim() ?? '',
+  );
+  const theirs = await b.evaluate((slug) => {
+    const li = [...document.querySelectorAll('.players-roster .player-row')].find(
+      (e) => e.querySelector('.player-name')?.textContent?.trim() === slug,
+    );
+    return li ? getComputedStyle(li.querySelector('.player-swatch')!).backgroundColor : '';
+  }, aSlug);
+  expect(theirs).not.toBe('');
+
+  await pressCommitted(a.locator('button.logo-trigger'), a.locator('.gallery-viewport'), {
+    what: 'the gallery deck',
+  });
+  // THE RACE, CURED: the room is read before the swatch is.
+  const swatches = a.locator('.game-card-swatch');
+  await expect(swatches).toHaveCount(2, { timeout: 15000 });
+  const deck = await swatches.evaluateAll((els) =>
+    els.map((e) => getComputedStyle(e).backgroundColor),
+  );
+  expect(new Set(deck).size).toBe(2);
+  // You first, in the colour B paints you.
+  expect(deck[0]).toBe(theirs);
+  await ctx.close();
+});
