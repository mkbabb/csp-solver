+function stopTimers(): void {
+  for (const id of Object.keys(timers)) {
+    clearTimeout(timers[id]);
+    delete timers[id];
+  }
+}
+// NOT `deep`. The session replaces the `cur` map on every change, so identity IS the change; a
+// deep watch re-ran this on every re-run of the getter, and `App.vue` rebuilds `place` whenever
+// your own cell moves, so your own walk re-armed the room's clocks as well.
