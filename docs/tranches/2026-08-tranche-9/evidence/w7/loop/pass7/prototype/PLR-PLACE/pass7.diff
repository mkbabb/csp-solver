+test('4 · the head is still while a peer walks the board, and the same scope moves once open', async ({
+  browser,
+}) => {
+  test.slow();
+  const ctx = await browser.newContext({ viewport: { width: 1280, height: 800 } });
+  const [a, b] = await table(ctx, 2);
+  const WALK = 30;
+  const STEP_MS = 150;
