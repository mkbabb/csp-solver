+  // lands (UI-6's delayed hide, the fade's end): the class, the LAYOUT height (a rect would read
+  // the fade's scale too), the painted opacity and whether the chart is there.
+  const record = () =>
+    a.evaluate(() => {
+      const w = window as unknown as { __fr: unknown[]; __done: boolean };
+      w.__fr = [];
+      w.__done = false;
+      const s = document.querySelector('[data-lobby].is-open') as HTMLElement;
+      const tick = () => {
+        const cs = getComputedStyle(s);
+        const open = s.classList.contains('is-open');
+        w.__fr.push({
+          open,
+          h: s.offsetHeight,
+          op: Number(cs.opacity),
+          chart: !!s.querySelector('.place-chart'),
+        });
+        if (!open && cs.visibility === 'hidden') w.__done = true;
+        else requestAnimationFrame(tick);
+      };
