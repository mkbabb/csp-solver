+    const r = await fourBands(page, '.corner-left .hover-card');
+    expect(painted(r), `${plant} ${JSON.stringify(r)}`).toBe(false);
+    await tag.evaluate((e) => (e as Element).remove());
+  }
+  // X7, an edge at 50 %, is PRINTED, not required: it paints 3.0–3.5 : 1, which is over the
+  // stroke floor — a visible edge by §2.4's own measure (the chair's dark X5 is the same case).
+  const x7 = await page.addStyleTag({ content: '.head-sheet-edge { opacity: 0.5 !important; }' });
+  test.info().annotations.push({ type: 'X7 opacity 0.5 (printed)', description: JSON.stringify(await fourBands(page, '.corner-left .hover-card')) });
+  await x7.evaluate((e) => (e as Element).remove());
+  // And the pass-4 border, planted, reads on the computed box.
+  await page.addStyleTag({
+    content: `.hover-card, [data-lobby] { border: 2px solid color-mix(in srgb, var(--color-border) 30%, transparent) !important; }`,
