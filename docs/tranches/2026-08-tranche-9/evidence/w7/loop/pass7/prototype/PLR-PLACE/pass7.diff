+    const g = await sh.evaluate((e) => {
+      const top = Math.min(...[...document.querySelectorAll('.sudoku-cell')].map((c) => c.getBoundingClientRect().top));
+      return { bottom: e.getBoundingClientRect().bottom, gridTop: top };
+    });
+    expect(g.bottom, 'this arm laps the board').toBeGreaterThan(g.gridTop);
+    await a.touchscreen.tap(60, g.bottom - depth);
+    await expect(mark(a)).toHaveAttribute('aria-expanded', 'false');
+    const active = await a.evaluate(() => document.activeElement?.getAttribute('aria-label') ?? '');
+    if (/^Row \d/.test(active)) reached.push(`${depth}px: ${active}`);
+    await a.evaluate(() => (document.activeElement as HTMLElement | null)?.blur());
+  }
+  expect(reached, 'a tap inside the sheet reached no cell').toEqual([]);
+  await ctx.close();
