+  if (!open || !now) return stopTimers();
+  if (!wasOpen) {
+    stopTimers();
+    settled.value = { ...now };
+    return;
+  }
+  for (const [id, pos] of Object.entries(now)) {
+    if (id in timers && pending[id] === pos) continue;
+    clearTimeout(timers[id]);
+    delete timers[id];
+    if (settled.value[id] === pos) continue;
+    pending[id] = pos;
+    timers[id] = setTimeout(() => {
+      delete timers[id];
+      settled.value = { ...settled.value, [id]: pos };
+    }, props.place!.settleMs);
+  }
+  // THE LEAVE WALKS EVERY CLOCK, not the settled set alone (pass-5 critic, THE GHOST): a peer
+  // whose FIRST move since the open is still pending has a timer and no settled cell, and a leave
+  // or a deal (the session empties the map) that skipped them let the timer fire later and draw
+  // them on a cell of a board that is gone.
+  for (const id of new Set([...Object.keys(settled.value), ...Object.keys(timers)])) {
