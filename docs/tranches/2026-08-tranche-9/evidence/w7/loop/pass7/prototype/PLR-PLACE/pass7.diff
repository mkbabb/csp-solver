+
+// ── 13 · THE GHOST (pass-5 critic) ────────────────────────────────────────────────────────────
+const sig = (p: Page) =>
+  p.evaluate(() =>
+    [...document.querySelectorAll<HTMLInputElement>('.sudoku-cell input')].map((i) => i.value || '.').join(''),
+  );
+
+for (const seeded of [false, true]) {
+  test(`13 · the ghost: a deal inside C's first settle leaves A's chart empty${seeded ? ' (control: C placed at the open)' : ''}`, async ({
+    browser,
+  }, info) => {
+    test.slow();
+    const ctx = await browser.newContext({ viewport: { width: 1280, height: 800 } });
+    const [a, b, c] = await table(ctx, 3);
+    const deal = b.locator('.controls-card button[aria-label="Deal a new board"]');
+    if (seeded) {
+      await c.bringToFront();
+      await cell(c, 5).click();
+    }
+    await a.bringToFront();
+    await openSheet(a);
+    if (seeded) await expect.poll(() => dots(a).then((d) => d.length), { timeout: 5000 }).toBe(1);
+    else expect(await dots(a), 'nobody placed at the open').toEqual([]);
+    const before = await sig(a);
+    // THE INTERLEAVE IS READ ON A, NOT ASSUMED (pass-6 critic 1.6; LAWS P6 §F): a recorder on A's
+    // own page stamps the moment C's ring lands on A's cell 20 (C's `cur` has ARRIVED, so A's clock
+    // for C is armed), the moment the deal lands on A (the board changes), and how many dots A's
+    // chart drew at that moment. The row asserts all three on its green run: arrival first, the
+    // deal inside C's 700 ms window from that arrival, and no dot for C yet when it landed.
+    await a.evaluate((was) => {
+      const w = window as unknown as { __il: Record<string, number | null> };
+      w.__il = { arrived: null, dealt: null, dotsAtDeal: null };
+      const grid = () =>
+        [...document.querySelectorAll<HTMLInputElement>('.sudoku-cell input')].map((i) => i.value || '.').join('');
+      let last = 0;
+      const tick = () => {
+        if (w.__il.dealt !== null) return;
+        const cells = document.querySelectorAll('.sudoku-cell');
+        if (w.__il.arrived === null && cells[20]?.classList.contains('is-peer-cursor'))
+          w.__il.arrived = performance.now();
+        if (grid() !== was) {
+          w.__il.dealt = performance.now();
+          // the chart as it stood on the last read BEFORE the new board (the deal empties the
+          // room's cursors in the same turn, so a read at the deal itself sees no dot either way)
+          w.__il.dotsAtDeal = last;
+          return;
+        }
+        last = document.querySelectorAll('[data-lobby].is-open .chart-dot').length;
+      };
+      const loop = () => {
+        tick();
+        if (w.__il.dealt === null) requestAnimationFrame(loop);
+      };
+      new MutationObserver(tick).observe(document.body, { subtree: true, attributes: true, childList: true, characterData: true });
+      requestAnimationFrame(loop);
+    }, before);
