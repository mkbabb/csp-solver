+// rest-probes.d.mts — the TYPES of the ONE rest-probe library (`./rest-probes.mjs`), so a TypeScript spec
+// imports it under `typecheck:e2e` (strict, no `allowJs`). No behaviour lives here; every export is typed
+// with its option names (LAWS P8 §I). CTRL-FACE's hand-rolled `PANEL_H_AT_REST` is `heightAtRest` here.
+// NOT-A-LANE: the chair's home (T9-W7 pass 9, homes v2).
+import type { Browser, Page } from "@playwright/test";
+
+export interface Rest {
+  ms: number;
+  /** 0 at rest, else the names of the animations still running */
+  residual: 0 | string[];
+}
+export interface HeightAtRest {
+  h: number | null;
+  rested: boolean;
+  frames: number;
+  /** windows restarted because the confirmation read disagreed */
+  restarts: number;
+}
+export interface HeightAtRestOptions {
+  sel: string;
+  /** the subtree whose running animations block rest (an ancestor selector; default the subject) */
+  root?: string | null;
+  frames?: number;
+  confirmMs?: number;
+  timeout?: number;
+}
+
+export const REST_CLAUSES: readonly string[];
+export function atRest(page: Page, timeout?: number): Promise<Rest>;
+export function heightAtRest(page: Page, o: HeightAtRestOptions): Promise<HeightAtRest>;
+/** Evaluate a JS expression string in the page. */
+export function js<T = unknown>(page: Page, expr: string): Promise<T>;
+export function openThenResize<T>(
+  page: Page,
+  o: {
+    open: () => Promise<unknown>;
+    close: () => Promise<unknown>;
+    read: () => Promise<T>;
+    to: { width: number; height: number };
+    same?: (a: T, b: T) => boolean;
+  },
+): Promise<{ before: T; after: T; reopened: T; rest: Rest; agree: boolean }>;
+export interface PublishedPair {
+  name: string;
+  published: unknown;
+  truth: unknown;
+}
+export function unpark(
+  page: Page,
+  o: { act: () => Promise<unknown>; perturb?: () => Promise<unknown>; pairs: [string, string, string][] },
+): Promise<{ before: PublishedPair[]; afterAct: PublishedPair[]; afterPerturb: PublishedPair[]; rest: [Rest, Rest]; stale: PublishedPair[] }>;
+/** Init script: WebKit's `pointerType: "mouse"` label on a touch's click, with iOS's delivery. */
+export function RELABEL(): void;
+export function tapToggles(page: Page, o: { target: string; state: string }): Promise<{ seq: string[]; states: unknown[]; toggles: number }>;
+export function rowTapFocus(
+  page: Page,
+  o: { cell: string; open: () => Promise<unknown>; row: string; ok?: string },
+): Promise<{ focus: string | null; kept: boolean; why?: string }>;
+/** homes v3: the focus-stop selector HR1 refuses to pin. */
+export const STOP_SEL: string;
+/** homes v3 · the hold REFUSES, never pins (HR1: a layer holding a ring or a stop; HR2: a fractional
+ *  opacity). A refusal pins nothing: the caller reads the cell RED or UNREAD. */
+export function holdPoses(
+  page: Page,
+  o?: { edge?: string | null; ring?: string; exempt?: string[] },
+): Promise<{ ok: boolean; held: number; refused: { el: string; why: string }[]; undo: () => Promise<void> }>;
+export function selfTest(browser: Browser): Promise<{ rows: string[]; exit: number }>;
