+      !rg ||
+      !PHONES.every((p) => rg.includes(p)) ||
+      DESKS.some((d) => rg.includes(d))
+    )
+      fails.push(`R3 seated in ${rg}`);
+  }
+  const block = L.census(fx.fe, "margin-note-block", "min-height", o);
+  // LEDGER row 4 (r4-unresolved): no site is UNRESOLVED (null), never the typed 16 / 1.2×
+  const masked = (v) => (on("r4-unresolved") ? null : v);
+  const fsOf = (cls, rg) => {
+    const e = L.effectiveAt(L.census(fx.fe, cls, "font-size", o), rg);
+    return e ? L.lengthPx(e.value, {}, map) : masked(16);
+  };
+  const lhOf = (cls, rg, fs) => {
+    const e = L.effectiveAt(L.census(fx.fe, cls, "line-height", o), rg);
+    if (!e) return masked(fs == null ? null : fs * 1.2);
