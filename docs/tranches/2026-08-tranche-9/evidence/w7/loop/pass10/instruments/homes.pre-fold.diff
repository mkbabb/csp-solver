+  let right = s.length;
+  d = 0;
+  for (let j = b; j < s.length; j++) {
+    const c = s[j];
+    if (OPEN[c]) d++;
+    else if (CLOSE[c]) {
+      if (d === 0) {
+        right = j;
+        break;
+      }
+      d--;
+    } else if (d === 0 && (c === "," || c === ";")) {
+      right = j;
+      break;
+    } else if (
+      d === 0 &&
+      c === "\n" &&
