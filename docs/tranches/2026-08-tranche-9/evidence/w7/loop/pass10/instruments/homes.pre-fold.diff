+const DESKS = ["desk-1280x800", "desk-1440x900"];
+/** The §7 reserve reading built on the library (the seed's law R1–R4, keyed as the SHAPE law
+ *  demands): one voice site (class-keyed census ∪ element-keyed sites), resolving to `inherit`,
+ *  seated in EVERY phone regime and no desk regime (EVALUATED), no `!important`; the block's
+ *  reserve at each phone regime ≥ the voice's line, both resolved at their consumers. */
+export function reserveReading(L, fx, file = "src/MarginNote.vue") {
+  const o = { files: fx.files, read: fx.read, exists: fx.exists };
+  const fails = [];
+  const { map } = L.tokens(fx.fe, o);
+  const key = (s) => `${s.file}:${s.line}:${s.prop}:${s.value}`;
+  const voice = new Map();
+  const isVoice = (e) => e.classes.has("margin-note");
+  const es = L.elementSites
+    ? L.elementSites(fx.fe, { file, pick: isVoice, props: ["min-height"], ...o })
+    : { elements: [], sites: [] };
+  // LEDGER N7 (seat-element): a CSS seat counts only when it may reach the voice's TEMPLATE element
+  const tpl = fx.exists(join(fx.fe, file))
+    ? L.sfc(fx.read(join(fx.fe, file))).template
+    : null;
+  const els = tpl && L.templateElements ? L.templateElements(tpl.text, tpl.line) : [];
+  const voiceEl = els.find(isVoice);
+  const reaches = (s) =>
+    !on("seat-element") ||
+    !voiceEl ||
+    !s.prelude ||
+    s.prelude.startsWith("<") ||
+    L.mayMatch(s.prelude, voiceEl, els);
+  for (const s of L.census(fx.fe, "margin-note", "min-height", o))
+    if (reaches(s)) voice.set(key(s), s);
+  for (const s of es.sites) if (!voice.has(key(s))) voice.set(key(s), s);
+  const v = [...voice.values()];
+  if (v.length !== 1) fails.push(`R1 ${v.length} voice sites`);
+  for (const s of v) {
+    if (L.resolve(s.value, map).trim() !== "inherit") fails.push(`R2 ${s.value}`);
+    if (s.important) fails.push("R3 !important");
