+            : line;
+        const hD = Math.max(
+          0,
+          ...dsites.filter((x) => x.prop === "height").map((x) => px(x.value, fsD)),
+        );
+        const vaD = Math.max(
+          0,
+          ...dsites
+            .filter((x) => x.prop === "vertical-align")
+            .map((x) => Math.abs(L.lengthPx(x.value, { fontSize: fsD }, map) ?? 0)),
+        );
+        grown = Math.max(
+          line,
+          Math.max(lhD, hD + vaD) + (hD ? 0 : vaD) + boxOf(dsites, fsD),
+        );
+      }
+      line = grown + boxOf(live(isVoice), vfs);
+    }
+    if (reserve == null || line == null || reserve < line - 0.5)
+      fails.push(`R4 ${rg}: reserve ${reserve} < the voice's line ${line}`);
+  }
+  return fails;
+}
