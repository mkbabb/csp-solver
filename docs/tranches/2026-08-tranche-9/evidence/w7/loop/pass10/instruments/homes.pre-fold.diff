+      how: inMath ? "math" : bracket ? "bracket" : op ? "operator" : "read",
+      op: (opB ?? opA)?.[1] ?? null,
+      ...(on("clock-context")
+        ? { ctx: valueContext(s, m.index, m.index + m[0].length) }
