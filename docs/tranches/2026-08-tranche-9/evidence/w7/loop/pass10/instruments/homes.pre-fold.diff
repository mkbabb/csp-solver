+// rest-probes.mjs — THE resize-at-rest, un-park, sequence-guard and row-focus probes (T9-W7; registry-v6
+// §2.11, LAWS P6 §D; registry-v7 §2.4 PRODUCT HOME). Four mechanisms recur across the estate:
+//   (a) UN-PARK — a publisher parked until `transitionend` never un-parks when no transition starts (FACE:
+//       two presses in one task; `--action-bar-h` 121 vs 132 for the page's life). Probe: act, reach REST,
+//       perturb something ELSE that moves the subject (the root font +12.5 %), reach rest, and compare every
+//       PUBLISHED length with its TRUTH (0.5 px).
+//   (b) RESIZE AT REST — a regime measured at OPEN goes stale on a resize at rest (SELF: 390×844 → 390×800
+//       keeps 4 rows / 7 cells lapped). Probe: open at A, resize to B, reach rest, read; close, reopen at
+//       B, read; the two reads must AGREE.
+//   (c) SEQUENCE-KEYED TOUCH GUARD — WebKit labels a touch's click `pointerType: "mouse"`. Probe: one tap,
+//       its event sequence logged, the state toggles counted (exactly one), and under the RELABEL plant
+//       (WebKit's label with iOS's delivery, in any engine) still exactly one.
+//   (d) ROW TAP KEEPS FOCUS — a tap on a row inside an open overlay keeps focus where the reader was
+//       (never BODY).
+// The presets are GENERIC (the chair's pass-7 gap 6: its presets named SELF's and FACE's trees): every
+// subject, state and read is a selector or a JS expression on the command line.
+//   node e2e/lib/rest-probes.mjs --self-test [--engine chromium|webkit]
+//   node e2e/lib/rest-probes.mjs --url <u> --preset resize --toggle <sel> --open <js→bool> --read <js→value>
+//        [--viewport 390x844] [--to 390x800] [--touch 1]
+//   node e2e/lib/rest-probes.mjs --url <u> --preset unpark --act <js> --pairs <name|publishedJs|truthJs;;…>
+//        [--perturb <js>] [--viewport 1280x800]
+//   node e2e/lib/rest-probes.mjs --url <u> --preset touch --target <sel> --state <js> [--plant relabel]
+//   node e2e/lib/rest-probes.mjs --url <u> --preset rowfocus --cell <sel> --toggle <sel> --open <js→bool>
+//        --row <sel> [--focus-ok <sel>]
+//   common: [--ready <sel>] [--engine] [--scheme dark]
+// Exit: 0 GREEN · 1 RED · 3 (self-test) a born-RED fixture or a plant read GREEN (a hole) · 4 both.
+import process from "node:process";
+import { fileURLToPath } from "node:url";
+import { resolve as resolvePath } from "node:path";
+import { args, load, playwright, openCell } from "./paint-lib.mjs";
+
+/** REST: no running/pending animation over two consecutive frames (read post-paint). An infinite
+ *  animation (a boil, a spinner) never rests: its names are printed as `residual`, never hidden. */
+export async function atRest(page, timeout = 6000) {
+  const t0 = Date.now();
+  let quiet = 0;
+  while (Date.now() - t0 < timeout) {
+    const n = await page.evaluate(
+      () =>
+        new Promise((r) =>
+          requestAnimationFrame(() => setTimeout(() => r(document.getAnimations().filter((a) => a.playState === "running" || a.pending).length), 0)),
+        ),
+    );
+    quiet = n === 0 ? quiet + 1 : 0;
+    if (quiet >= 2) return { ms: Date.now() - t0, residual: 0 };
+  }
+  const residual = await page.evaluate(() =>
+    document
+      .getAnimations()
+      .filter((a) => a.playState === "running")
+      .map((a) => a.animationName ?? a.id ?? a.constructor.name)
+      .slice(0, 5),
+  );
+  return { ms: Date.now() - t0, residual };
+}
+
+/** Clause switches for the rest-probes sabotage battery (REST_SABOTAGE=a,b). */
+export const REST_CLAUSES = ["confirm", "anim", "HR1", "HR2"];
+const R_OFF = new Set((process.env.REST_SABOTAGE ?? "").split(",").filter(Boolean));
+const rOn = (c) => !R_OFF.has(c);
+/** (e) HEIGHT AT REST (the chair, pass 9; CTRL-FACE's PANEL_H_AT_REST folded home, LAWS P8 §I): fonts
+ *  ready, then `frames` consecutive frames with the subject's height unchanged (to 0.01 px) and no
+ *  running animation in `root`'s subtree (anim); then a CONFIRMATION read `confirmMs` later must
+ *  agree, else the window restarts (confirm) — a layout that lands after the frame window (FACE's
+ *  critic: "read early") is never the rest. → {h, rested, frames, restarts} */
+export async function heightAtRest(page, { sel, root = null, frames = 10, confirmMs = 500, timeout = 6000 }) {
+  return page.evaluate(
+    async ({ sel, root, frames, confirmMs, timeout, off }) => {
+      await document.fonts.ready;
+      const el = document.querySelector(sel);
+      if (!el) return { h: null, rested: false, frames: 0, restarts: 0 };
+      const host = root ? (el.closest(root) ?? el) : el;
+      const raf = () => new Promise((r) => requestAnimationFrame(() => r()));
+      const moving = () => !off.includes("anim") && host.getAnimations({ subtree: true }).some((a) => a.playState === "running" || a.pending);
+      const read = () => +el.getBoundingClientRect().height.toFixed(2);
+      let last = -1,
+        same = 0,
+        n = 0,
+        restarts = 0;
+      const t0 = performance.now();
+      while (performance.now() - t0 < timeout) {
+        await raf();
+        n++;
+        const h = read();
+        if (h === last && !moving()) same++;
+        else {
+          same = 0;
+          last = h;
+        }
+        if (same < frames) continue;
+        if (off.includes("confirm")) return { h: last, rested: true, frames: n, restarts };
+        await new Promise((r) => setTimeout(r, confirmMs));
+        await raf();
+        if (read() === last && !moving()) return { h: last, rested: true, frames: n, restarts };
+        restarts++;
+        same = 0;
+        last = read();
+      }
+      return { h: last, rested: false, frames: n, restarts };
+    },
+    { sel, root, frames, confirmMs, timeout, off: [...R_OFF] },
+  );
+}
+
+/** Evaluate a JS expression string in the page. */
+/** homes v3 · THE HOLD REFUSES, NEVER PINS (MRK-LIVE's critic CRIT-ANC55; LAWS P9 §D). Outside
+ *  `reduce` a baked pose stack (sibling layers with `will-change: opacity`, swapped on the boil beat) may
+ *  flip between a read's two photographs, so a read may HOLD each stack at the pose it shows now. The
+ *  hold is lawful only for a binary pose layer that holds nothing the read judges:
+ *    HR1  a layer that holds a ring or a focus stop (or IS one, or holds the read's edge) is REFUSED —
+ *         pinning a ring's 0.55 ancestor to 1 photographs a ring the user never sees
+ *    HR2  a layer whose opacity is not 0 or 1 is REFUSED — it is not a pose, it is the paint
+ *  A refusal pins NOTHING: `{ ok: false, refused }` and the caller reads the cell RED or UNREAD, never a
+ *  pinned green. `{ ok: true, held, undo }` otherwise. The edge, the ring and `exempt` are never held. */
+export const STOP_SEL = 'a[href], button, input, select, textarea, summary, [tabindex]:not([tabindex="-1"]), [contenteditable="true"], [contenteditable=""]';
+export async function holdPoses(page, { edge = null, ring = ".focus-ring", exempt = [] } = {}) {
+  const r = await page.evaluate(
+    ({ skip, STOP, hr1, hr2 }) => {
+      const held = [],
+        refused = [];
+      for (const el of document.querySelectorAll("body *")) {
+        if (skip && el.closest(skip)) continue;
+        const cs = getComputedStyle(el);
+        if (!/opacity/.test(cs.willChange)) continue;
+        const c = typeof el.className === "string" ? el.className : (el.className?.baseVal ?? "");
