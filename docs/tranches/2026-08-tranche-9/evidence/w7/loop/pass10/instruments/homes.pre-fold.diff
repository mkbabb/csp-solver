+        : +L.resolve(e.value, map) * fs
+      : L.lengthPx(e.value, fs == null ? {} : { fontSize: fs }, map);
+    return n;
+  };
+  for (const rg of PHONES) {
+    const eff = L.effectiveAt(block, rg);
+    const bfs = fsOf("margin-note-block", rg),
+      vfs = fsOf("margin-note", rg);
+    const reserve = eff
+      ? L.lengthPx(
+          eff.value,
+          {
+            ...(bfs == null ? {} : { fontSize: bfs }),
+            lineHeight: lhOf("margin-note-block", rg, bfs) ?? undefined,
+          },
+          map,
+        )
+      : null;
+    let line = lhOf("margin-note", rg, vfs);
+    if (on("r4-element") && L.elementSites) {
+      // LEDGER N4/N19 (r4-element): the voice's font and line from EVERY rule that may reach its
+      // element (`> p:first-child`, `:has()`, `:not(:empty)`), the largest live candidate read
+      const at = (props) =>
+        L.elementSites(fx.fe, { file, pick: isVoice, props, ...o }).sites.filter((s) =>
+          (s.regimes ?? []).includes(rg),
+        );
+      const fsC = at(["font-size"])
+        .map((s) => L.lengthPx(s.value, {}, map))
+        .filter((x) => x != null);
+      const fsAll = [vfs, ...fsC].filter((x) => x != null);
+      const efs = fsAll.length ? Math.max(...fsAll) : null;
+      const lhC = at(["line-height"]).map((s) => {
+        const r = L.resolve(s.value, map).trim();
+        if (/^[\d.]+$/.test(r)) return efs == null ? null : +r * efs;
+        return L.lengthPx(s.value, efs == null ? {} : { fontSize: efs }, map);
+      });
+      const lhAll = [lhOf("margin-note", rg, efs), ...lhC].filter((x) => x != null);
+      line = lhAll.length ? Math.max(...lhAll) : null;
+    }
+    if (on("r4-descend") && L.elementSites && voiceEl && line != null) {
+      // homes v3 (r4-descend; LEDGER's critic C1–C6): R4 reads the voice's LINE BOX. The voice's
+      // DESCENDANTS (the ink box, the star) grow it by their own font, line, height,
+      // vertical-align and block-axis padding/margin/border; the voice grows it by its own (a
+      // `:has()` rule included). Conservative: each property's largest live candidate is summed.
+      const isDesc = (e) => {
+        for (let p = els[e.i]?.parent; p != null; p = els[p].parent)
+          if (p === voiceEl.i) return true;
+        return false;
+      };
+      const PROPS = [
+        "font-size",
+        "line-height",
+        "height",
+        "vertical-align",
+        "padding-top",
+        "padding-bottom",
+        "margin-top",
+        "margin-bottom",
+        "border-width",
+        "border-top-width",
+        "border-bottom-width",
+      ];
+      // the COMPONENT TREE bounds the reach (component-tree): another file's scoped rule reaches none of
+      // the voice's own elements (none is MarginNote's root) unless it is a `:deep()` rule of a component
+      // that renders MarginNote; an unscoped rule reaches as `mayMatch` says
+      const R = L.componentReach ? L.componentReach(fx.fe, o) : null;
+      const reach = (x) =>
+        !R ||
+        x.kind !== "sfc-style-scoped" ||
+        x.file === file ||
+        (/:deep\(/.test(String(x.prelude)) && R.deepReaches(x.file, file));
+      const live = (pick) =>
+        L.elementSites(fx.fe, { file, pick, props: PROPS, ...o }).sites.filter(
+          (x) => (x.regimes ?? []).includes(rg) && reach(x),
+        );
+      const sides = (d) => {
+        const p = d.prop;
+        const parts = splitTop(String(d.value).trim(), /\s+/).filter(Boolean);
+        if (/^(padding|margin)-(top|block-start)$/.test(p) || p === "border-top-width")
+          return [d.value, null];
+        if (
+          /^(padding|margin)-(bottom|block-end)$/.test(p) ||
+          p === "border-bottom-width"
+        )
+          return [null, d.value];
+        if (/^(padding|margin)-block$/.test(p)) return [parts[0], parts[1] ?? parts[0]];
+        if (/^(padding|margin|border-width)$/.test(p))
+          return [parts[0], parts[2] ?? parts[0]];
+        if (/^border(-block|-top|-bottom)?$/.test(p)) {
+          const w = parts.find((x) => /^[-+]?[\d.]/.test(x)) ?? null;
+          return [p === "border-bottom" ? null : w, p === "border-top" ? null : w];
+        }
+        return [null, null];
+      };
+      const px = (v, fs) =>
+        v == null
+          ? 0
+          : Math.max(0, L.lengthPx(v, fs == null ? {} : { fontSize: fs }, map) ?? 0);
+      const boxOf = (ss, fs) => {
+        let top = 0,
+          bottom = 0;
+        for (const x of ss) {
+          if (!/^(padding|margin|border)/.test(x.prop)) continue;
+          const [t, b] = sides(x);
+          top = Math.max(top, px(t, fs));
+          bottom = Math.max(bottom, px(b, fs));
+        }
+        return top + bottom;
+      };
+      const vlh = L.effectiveAt(L.census(fx.fe, "margin-note", "line-height", o), rg);
+      const vlhR = vlh ? L.resolve(vlh.value, map).trim() : null;
+      const dsites = live(isDesc);
+      let grown = line;
+      if (dsites.length) {
+        const fsD = Math.max(
+          vfs ?? 0,
+          ...dsites
+            .filter((x) => x.prop === "font-size")
+            .map(
+              (x) =>
+                L.lengthPx(x.value, vfs == null ? {} : { fontSize: vfs }, map) ?? 0,
+            ),
+        );
+        const lhC = dsites
+          .filter((x) => x.prop === "line-height")
+          .map((x) => {
+            const r = L.resolve(x.value, map).trim();
+            return /^[\d.]+$/.test(r)
+              ? +r * fsD
+              : (L.lengthPx(x.value, { fontSize: fsD }, map) ?? 0);
+          });
+        const lhD = lhC.length
+          ? Math.max(...lhC)
+          : vlhR != null && /^[\d.]+$/.test(vlhR)
