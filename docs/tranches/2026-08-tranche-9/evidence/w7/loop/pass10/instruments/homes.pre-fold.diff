+++ b/web/frontend/e2e/lib/glyph-pop.d.mts
@@ -0,0 +1,94 @@
+// glyph-pop.d.mts — the TYPES of the ONE glyph-population probe (`./glyph-pop.mjs`), so a TypeScript spec
+// imports it under `typecheck:e2e` (strict, no `allowJs`). No behaviour lives here; every export is typed
+// with its option names (LAWS P8 §I: never `[k: string]: unknown`). PLR-COUNT's pass-8 hand-rolled copy
+// (`GlyphRead`, `GlyphPlant`) is folded in by name.
+// NOT-A-LANE: the chair's home (T9-W7 pass 9, homes v2).
+import type { Browser, Page } from "@playwright/test";
+
+/** One population read: `why` holds one entry per breached clause, each led by its id (G0 … G5). */
+export interface GlyphRead {
+  red: boolean;
+  why: string[];
+  population?: number;
+  coreMedian?: number;
+  fracUnder?: number;
+  columns?: number;
+  slicePop?: number;
+  slices?: (number | null)[];
+  glyphCores?: (number | null)[];
+  /** the G4 columns read low (labels `k` / `½k`), untolerated */
+  g4Lows?: string[];
+  /** the G4 columns the CONTROL's lows tolerated (`label:core`) */
+  g4Tolerated?: string[];
+  /** the G5 glyphs the CONTROL's same glyphs tolerated (`k'ch':core/control`), PROPOSED g5tol */
+  g5Tolerated?: string[];
+  transientOn?: number;
+  transientOff?: number;
+  outsideRun?: number;
+  clip?: { x: number; y: number; width: number; height: number };
+  dpr?: number;
+}
+/** The probe's options. `tolerate` = the CONTROL's g4Lows (never this run's own). */
+export interface GlyphOptions {
+  subject: string;
+  off?: string | null;
+  floor?: number;
+  minPop?: number;
+  fracBound?: number | null;
+  delta?: number;
+  pad?: number;
+  slices?: number | "auto";
+  slicePop?: number | "auto";
+  sliceRatio?: number;
+  sliceQ?: number;
+  textRun?: boolean;
+  glyphWindows?: boolean;
+  runClip?: boolean;
+  /** G5: the quantile of the glyph's interior read (default 0.5) */
+  g5Q?: number;
+  tolerate?: string[] | null;
+  /** the CONTROL's glyphCores (PROPOSED g5tol): glyph k under the floor is tolerated where the control
+   *  holds the same glyph under it and this read is no worse by more than G5_EPS */
+  g5tolerate?: (number | null)[] | null;
+}
+/** A plant: a CSS string, or a mask over the text run — `[a, b]` of the run (or glyph `glyph`'s box) at
+ *  25 %, striped (1 px at 25 % α) with `comb`. */
+export type GlyphPlant = string | { mask: [number, number]; comb?: boolean; glyph?: number | null };
+/** The control-anchored reference: the CONTROL's read of the same payload. */
+export type GlyphControl = Pick<GlyphRead, "fracUnder" | "g4Lows" | "population" | "glyphCores">;
+export interface GlyphGateOptions extends Omit<GlyphOptions, "fracBound"> {
+  payload: string;
+  plants?: Record<string, GlyphPlant> | null;
+  slack?: number;
+  img?: { ng: string; ink?: [number, number] } | null;
+  control?: GlyphControl | null;
+}
+export interface GlyphGate {
+  payload: string;
+  bound: number | null;
+  clean: GlyphRead;
+  plants: Record<string, GlyphRead>;
+}
+
+export const GLYPH_CLAUSES: readonly string[];
+export const G5_EPS: number;
+export function autoSlices(span: number): number;
+export function glyphPopulation(page: Page, o: GlyphOptions): Promise<GlyphRead>;
+export function glyphGate(page: Page, o: GlyphGateOptions): Promise<GlyphGate>;
+/** G3's bound from a reference fraction, clamped below 1 at a reference ≥ 0.95. */
+export function boundOf(frac: number | null | undefined, slack?: number, pop?: number, minPop?: number): number | null;
+export function FILE_PLANTS(subject: string): Record<"OPA80F" | "COMB", string>;
+export function TEXT_PLANTS(subject: string): Record<string, GlyphPlant>;
+export function IMG_PLANTS(subject: string, ng: string, ink?: [number, number]): Record<string, string>;
+export function applyPlant(page: Page, subject: string, plant: GlyphPlant): Promise<() => Promise<void>>;
+export function applyTail(page: Page, subject: string, tail: number): Promise<unknown>;
+export function undoTail(page: Page, subject: string): Promise<void>;
+export function applyMask(
+  page: Page,
+  subject: string,
+  range: [number, number],
+  o?: { comb?: boolean; glyph?: number | null },
+): Promise<{ ok: boolean; run?: [number, number]; cut?: [number, number]; box?: number }>;
+export function undoMask(page: Page, subject: string): Promise<void>;
+export function selfTest(browser: Browser, o?: { dpr?: number }): Promise<{ rows: string[]; exit: number }>;
+export function fmt(r: GlyphRead): string;
diff --git a/web/frontend/e2e/lib/glyph-pop.mjs b/web/frontend/e2e/lib/glyph-pop.mjs
new file mode 100644
index 00000000..3d2120c6
--- /dev/null
+++ b/web/frontend/e2e/lib/glyph-pop.mjs
@@ -0,0 +1,590 @@
+// glyph-pop.mjs — THE glyph-population probe (T9-W7; registry-v5 §2.11 statistic, LAWS P6 §E, P7 §E
+// (v); registry-v7 §2.4 PRODUCT HOME). A painted-text gate reads the WHOLE glyph-coverage population:
+//   the subject photographed ON and with its text transparent (`color` AND `-webkit-text-fill-color`
+//   transparent, text-shadow none; or the caller's `off` sheet for an ink that is not text — TAB-PEN's
+//   favicon <img> photographed as its paper-only twin); every pixel whose RGB moved by ≥ `delta`
+//   (6/255) is a glyph pixel; its value = contrast(ON pixel, OFF pixel), the ink against its own ground.
+// The population is CLIPPED TO THE TEXT RUN (its text nodes' rects, never an svg or hidden descendant:
+// TIN/FIVE) and keeps only pixels STABLE across two ON photographs AND two OFF photographs (TIN: a
+// stray far-right cluster changed between the ON and OFF of one pair and red a clean tree 2 in 4).
+// Clauses (every one RED on breach — never `min(4.5, 0)`, never a skip):
+//   G0  the subject exists and is visible
+//   G1  the population ≥ `minPop` (40) px — an EMPTY or thin population is RED
+//   G2  the core median ≥ `floor` (4.5) — ABSOLUTE, never relative to an in-run photo of the subject
+//   G3  the fraction under `floor` ≤ `fracBound` — the bound is PER PAYLOAD (WALK: a pooled stamp
+//       handed the tighter subject the looser bound and masked a WebKit FADE65); `glyphGate` takes
+//       the clean read of THIS payload + 0.05
+//   G4  x-columns: every column holding ≥ `slicePop` px keeps its CORE (p95) ≥ max(3.0, 0.4 × the
+//       whole population's p95). The column count SCALES TO THE INK SPAN (TAB-PEN/COUNT: 16 columns
+//       over ~10 px of ink hold < 8 px each and G4 went blind) and the grid is read twice, aligned and
+//       shifted by half a column, so a 12 % fade always covers one whole column
+//   G5  glyph windows: the same core clause per CHARACTER (a Range per character of the run — COUNT:
+//       a p95 per x-window is blind to a fade over < ~95 % of it, and the leading digit is the
+//       costliest glyph to lose)
+// Plants (TEXT_PLANTS / IMG_PLANTS; each must RED): FAINT30, FADE65, FADE80 (fill), TAIL12, TAIL35,
+// HEAD12, MID20 (a mask over that fraction of the RUN at 25 %), EMPTY.
+//   node e2e/lib/glyph-pop.mjs --self-test [--engine chromium|webkit]     synthetic subjects, every plant
+//   node e2e/lib/glyph-pop.mjs --url <u> --subject <sel> --payload <name> [--scheme dark] [--dpr 2]
+//        [--viewport 1280x800] [--ready <sel>] [--click <sel>] [--hover <sel>] [--touch] [--prm 0]
+//        [--contrast more] [--regimes all]   (`all` = every paint-lib PAINT_REGIMES stop, LAWS P7 §E)
+// Exit: 0 clean GREEN and every plant RED · 1 clean RED · 3 a plant GREEN (a hole) · 4 both.
+import process from "node:process";
+import { fileURLToPath } from "node:url";
+import { resolve as resolvePath } from "node:path";
+import {
+  onOff,
+  lum,
+  ratio,
+  median,
+  quantile,
+  maxDelta,
+  settle,
+  textRunRects,
+  args,
+  load,
+  playwright,
+  openCell,
+  cellsOf,
+} from "./paint-lib.mjs";
+
+/** The column count for an ink span of `span` device px (G4). The floor is 13, not 8:
+ *  the aligned and half-shifted grids hold a WHOLE column inside any 12 % end run only when 1.5 / n ≤ 0.12
+ *  (at 8 columns a 17 px icon's TAIL12 straddled two columns and read GREEN in WebKit at DPR 1, pass 8). */
+export const autoSlices = (span) =>
+  Math.max(1, Math.min(Math.floor(span), 24, Math.max(13, Math.round(span / 3))));
+const autoSlicePop = (pop, n) => Math.max(3, Math.min(8, Math.round(pop / n / 3)));
+/** Clause switches for the glyph-pop sabotage battery (GLYPH_SABOTAGE=a,b; LAWS P7 §F (ii)): the chair's
+ *  pass-9 clauses — G5core (G5 reads a LOW quantile of the glyph's INTERIOR), G3clamp (a clean ≥ 0.95
+ *  never bounds G3 above 1), anchor (the control-anchored bound), g4tol (G4 tolerates only the
+ *  CONTROL's low columns, never this run's own). */
+/** g5tol: how much worse than the control's same glyph a tolerated glyph core may read. */
+export const G5_EPS = 0.05;
+export const GLYPH_CLAUSES = ["G5core", "G3clamp", "anchor", "g4tol", "g5tol"];
+const G_OFF = new Set((process.env.GLYPH_SABOTAGE ?? "").split(",").filter(Boolean));
+const gOn = (c) => !G_OFF.has(c);
+
+export async function glyphPopulation(
+  page,
+  { subject, off = null, floor = 4.5, minPop = 40, fracBound = null, delta = 6, pad = 2, slices = "auto", slicePop = "auto", sliceRatio = 0.4, sliceQ = 0.95, textRun = true, glyphWindows = true, runClip = true, g5Q = 0.5, tolerate = null, g5tolerate = null },
+) {
+  const loc = page.locator(subject).first();
+  // ACC-SIX pass 8 (PROPOSED → the ONE copy; LAWS P7 §E): a text laid in a ZERO-HEIGHT box (the strip's
+  // yielding meta) paints outside its box, so the box is not the clip: the clip is the box ∪ the text
+  // run, and a box Playwright calls invisible (0 px tall) is visible when its run paints. `runClip:
+  // false` is the legacy box clip (the self-test's ZERO row reads it G0/G1 — the hole this closes).
+  const runCss = textRun && runClip ? await page.evaluate(textRunRects, { subject }) : null;
+  const vis = (await loc.isVisible().catch(() => false)) || !!runCss?.length;
+  if (!vis) return { red: true, why: [`G0 subject ${subject} not visible`] };
+  let b = await loc.boundingBox();
+  if (runCss?.length && b) {
+    const l = Math.min(b.x, ...runCss.map((q) => q.l)),
+      t = Math.min(b.y, ...runCss.map((q) => q.t)),
+      r = Math.max(b.x + b.width, ...runCss.map((q) => q.r)),
+      bt = Math.max(b.y + b.height, ...runCss.map((q) => q.b));
+    b = { x: l, y: t, width: r - l, height: bt - t };
+  }
+  const vw = page.viewportSize();
+  const dpr = await page.evaluate(() => devicePixelRatio);
+  const x = Math.max(0, Math.floor(b.x - pad)),
+    y = Math.max(0, Math.floor(b.y - pad));
+  const clip = {
+    x,
+    y,
+    width: Math.min(vw.width - x, Math.ceil(b.width + 2 * pad)),
+    height: Math.min(vw.height - y, Math.ceil(b.height + 2 * pad)),
+  };
+  const offCss =
+    off ??
+    `${subject}, ${subject} * { color: transparent !important; -webkit-text-fill-color: transparent !important; text-shadow: none !important; }`;
+  // the text run (device px, relative to the clip) — the population's own extent
+  const run = textRun ? await page.evaluate(textRunRects, { subject }) : null;
+  const glyphs = textRun && glyphWindows ? await page.evaluate(textRunRects, { subject, chars: true }) : null;
+  const toDev = (r) => ({
+    l: Math.floor((r.l - clip.x) * dpr) - 1,
+    r: Math.ceil((r.r - clip.x) * dpr) + 1,
+    t: Math.floor((r.t - clip.y) * dpr) - 1,
+    b: Math.ceil((r.b - clip.y) * dpr) + 1,
+  });
+  const runDev = run && run.length ? run.map(toDev) : null;
+  const A = await onOff(page, clip, offCss);
+  const B = await onOff(page, clip, offCss);
+  const W = A.on.w;
+  let transientOn = 0,
+    transientOff = 0,
+    outsideRun = 0;
+  const pop = [],
+    xs = [],
+    ys = [];
+  const inPop = new Map(); // device pixel index → its contrast (the interior read, G5core)
+  for (let i = 0; i < A.on.data.length; i += 3) {
+    const px = (i / 3) % W,
+      py = Math.floor(i / 3 / W);
+    if (maxDelta(A.on.data, A.off.data, i) < delta) continue;
+    const tOn = maxDelta(A.on.data, B.on.data, i) >= delta,
+      tOff = maxDelta(A.off.data, B.off.data, i) >= delta;
+    if (tOn) transientOn++;
+    if (tOff) transientOff++;
+    if (tOn || tOff) continue;
+    if (runDev && !runDev.some((q) => px >= q.l && px < q.r && py >= q.t && py < q.b)) {
+      outsideRun++;
+      continue;
+    }
+    pop.push(ratio(lum(A.on.data, i), lum(A.off.data, i)));
+    xs.push(px);
+    ys.push(py);
+    inPop.set(py * W + px, pop.at(-1));
+  }
+  const why = [];
+  const med = median(pop);
+  const frac = pop.length ? pop.filter((v) => v < floor).length / pop.length : 1;
+  if (pop.length < minPop) why.push(`G1 population ${pop.length} px < ${minPop} (EMPTY/thin is RED)`);
+  else {
+    if (med < floor) why.push(`G2 core median ${med.toFixed(3)} < ${floor}`);
+    if (fracBound != null && frac > fracBound)
+      why.push(`G3 fraction under ${floor} = ${frac.toFixed(3)} > bound ${fracBound.toFixed(3)}`);
+  }
+  const sl = [],
+    gw = [];
+  let g4Lows = [],
+    tolerated = [],
+    g5tol = [];
+  let n = 0,
+    sp = 0,
+    lim = 0;
+  if (pop.length >= minPop) {
+    const core = quantile(pop, sliceQ);
+    lim = Math.max(3.0, sliceRatio * core);
+    const x0 = Math.min(...xs),
+      x1 = Math.max(...xs) + 1;
+    n = slices === "auto" ? autoSlices(x1 - x0) : slices;
+    sp = slicePop === "auto" ? autoSlicePop(pop.length, n) : slicePop;
+    const w = (x1 - x0) / n;
+    const lows = [];
+    g4Lows = lows;
+    for (const shift of [0, 0.5]) {
+      for (let k = 0; k < n; k++) {
+        const a = x0 + (k + shift) * w,
+          e = a + w;
+        if (e > x1 + 0.001) continue;
+        const v = pop.filter((_, j) => xs[j] >= a && xs[j] < e);
+        const c = v.length >= sp ? +quantile(v, sliceQ).toFixed(2) : null;
+        if (!shift) sl.push(c);
+        // g4tol (the chair p9; COUNT's G4 tolerance, re-cut): a column is tolerated ONLY when the
+        // CONTROL's read of the same payload holds it low (`tolerate`, from that read's g4Lows) —
+        // never this run's own clean read, which made gated(clean, clean) unable to add a column
+        const label = `${shift ? "½" : ""}${k}`;
+        if (c != null && c < lim) {
+          if (gOn("g4tol") && tolerate?.includes(label)) tolerated.push(`${label}:${c}`);
+          else lows.push(`${label}:${c}`);
+        }
+      }
+    }
+    if (lows.length)
+      why.push(`G4 column core (p${Math.round(sliceQ * 100)}) under ${lim.toFixed(2)} (= max(3.0, ${sliceRatio}×whole p${Math.round(sliceQ * 100)} ${core.toFixed(2)}); ${n} columns, ≥${sp} px) at ${lows.join(", ")}`);
+    if (glyphs && glyphs.length) {
+      const glows = [];
+      g5tol = [];
+      glyphs.forEach((g, k) => {
+        const q = toDev(g);
+        const v = pop.filter((_, j) => xs[j] >= q.l + 1 && xs[j] < q.r - 1 && ys[j] >= q.t && ys[j] < q.b);
+        // G5core (the chair p9; COUNT gap 2): the glyph's INTERIOR — population pixels whose four
+        // neighbours are population too (antialiased rims dropped, faded strokes KEPT) — read at a LOW
+        // quantile (g5Q, p50): a p95 per window is blind to a fade over < ~95 % of the glyph (COMB)
+        let c;
+        if (gOn("G5core")) {
+          const core = [];
+          for (let y = q.t; y < q.b; y++)
+            for (let x = q.l + 1; x < q.r - 1; x++) {
+              const v0 = inPop.get(y * W + x);
+              if (v0 == null) continue;
+              if ([[1, 0], [-1, 0], [0, 1], [0, -1]].every(([dx, dy]) => inPop.has((y + dy) * W + x + dx))) core.push(v0);
+            }
+          c = core.length >= sp ? +quantile(core, g5Q).toFixed(2) : v.length >= sp ? +quantile(v, sliceQ).toFixed(2) : null;
+        } else c = v.length >= sp ? +quantile(v, sliceQ).toFixed(2) : null;
+        gw.push(c);
+        // g5tol (PLR-COUNT pass 9, PROPOSED): a glyph under the floor is tolerated ONLY where the
+        // CONTROL's read of the same payload holds the SAME glyph under the floor too, and this read is
+        // no worse than the control's by more than G5_EPS (by VALUE, never by index alone: a deeper
+        // fade of a glyph the control already holds low still reds)
+        const ref = g5tolerate?.[k];
+        if (c != null && c < lim) {
+          if (gOn("g5tol") && ref != null && ref < lim && c >= ref - G5_EPS) g5tol.push(`${k}'${g.ch}':${c}/${ref}`);
+          else glows.push(`${k}'${g.ch}':${c}`);
+        }
+      });
+      if (glows.length) why.push(`G5 glyph core (${gOn("G5core") ? `interior p${Math.round(g5Q * 100)}` : `p${Math.round(sliceQ * 100)}`}) under ${lim.toFixed(2)} at ${glows.join(", ")}`);
+    }
+  }
+  return {
+    red: why.length > 0,
+    why,
+    population: pop.length,
+    coreMedian: +med.toFixed(3),
+    fracUnder: +frac.toFixed(3),
+    columns: n,
+    slicePop: sp,
+    slices: sl,
+    glyphCores: gw,
+    g4Lows: g4Lows.map((x) => x.split(":")[0]),
+    g4Tolerated: tolerated,
+    g5Tolerated: g5tol,
+    transientOn,
+    transientOff,
+    outsideRun,
+    clip,
+    dpr,
+  };
+}
+
+/** THE PER-PAYLOAD GATE (WALK W4): read the clean subject for THIS payload, bound G3 at its own
+ *  fraction + `slack`, then read every plant against that bound. `payload` names what the page holds
+ *  (a board, a deal, a peer id) and is REQUIRED — a bound is never pooled across payloads. */
+export async function glyphGate(page, { subject, payload, plants = null, slack = 0.05, img = null, control = null, ...opts }) {
+  if (!payload) throw new Error("glyphGate: `payload` is required (a G3 bound is per payload, never pooled)");
+  const first = await glyphPopulation(page, { subject, ...opts });
+  // anchor (the chair p9; COUNT gap 1 / LAWS P8 §F): with `control` — the CONTROL tree's read of the
+  // SAME payload ({fracUnder, g4Lows}) — G3 is bound at the control's fraction + slack and G4
+  // tolerates only the control's low columns; a bound cut from this run's own clean read cannot see a
+  // shipped regression (OPA80F: frac 1.000 against its own 1.050)
+  const ref = control && gOn("anchor") ? control : first;
+  const bound = boundOf(ref.fracUnder, slack, ref.population ?? Infinity, opts.minPop ?? 40);
+  opts = {
+    ...opts,
+    tolerate: control && gOn("anchor") ? (control.g4Lows ?? []) : opts.tolerate,
+    g5tolerate: control && gOn("anchor") ? (control.glyphCores ?? null) : opts.g5tolerate,
+  };
+  const clean = await glyphPopulation(page, { subject, fracBound: bound, ...opts });
+  const P = plants ?? (img ? IMG_PLANTS(subject, img.ng, img.ink) : TEXT_PLANTS(subject));
+  const out = {};
+  for (const [name, plant] of Object.entries(P)) {
+    const undo = await applyPlant(page, subject, plant);
+    await settle(page);
+    const r = await glyphPopulation(page, { subject, fracBound: bound, ...opts });
+    await undo();
+    await settle(page);
+    out[name] = r;
+  }
+  return { payload, bound, clean, plants: out };
+}
+
+/** G3's bound from a reference fraction: ref + slack, CLAMPED (G3clamp, the chair p9; COUNT gap 4) —
+ *  at a reference ≥ 0.95 the bound is half-way from it to 1, so it never reaches 1.0 and a plant that
+ *  drives every pixel under the floor (OPA80F's 1.000) still reds. null when the reference is thin. */
