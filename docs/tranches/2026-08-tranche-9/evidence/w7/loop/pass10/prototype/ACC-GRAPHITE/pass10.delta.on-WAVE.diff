diff --git a/web/frontend/src/pencil/grid/gridPaths.partial30.test.ts b/web/frontend/src/pencil/grid/gridPaths.partial30.test.ts
new file mode 100644
index 00000000..6f4ee78d
--- /dev/null
+++ b/web/frontend/src/pencil/grid/gridPaths.partial30.test.ts
@@ -0,0 +1,70 @@
+import { describe, it, expect, vi } from "vitest";
+import { MOTION } from "@pencil/config/pencilConfig";
+
+// crit.partial30 (T9-W7 pass 10, CHAIR §6) — ACC-GRAPHITE's own copy of FIVE's critic's unit row,
+// shipped by every consumer of `frontTween` until FIVE's first-tick cure lands. The band's retrace
+// draws on the board this primitive paces, so the row rides with the band. It reads the primitive,
+// never the band: a 30 Hz panel whose tween starts MID-FRAME. frontTween's first tick is
+// dt = (first rAF ts) - (start()'s performance.now()), a PARTIAL frame (0..33 ms at 30 Hz). Keyed on
+// the minimum of 32 ticks, one partial tick under stepMs pins the cap at stepMs for 32 frames, and
+// every 33 ms frame then travels 17 ms. RED here is FIVE's row 1 (LAWS P9 §D), not this family's.
+const F = 1000 / 30;
+const load = async () => {
+  vi.resetModules();
+  let carrier: {
+    onProgress: (e: number, raw: number) => void;
+    durationMs: number;
+  } | null = null;
+  vi.doMock("@mkbabb/pencil-boil", async (orig) => ({
+    ...(await orig<typeof import("@mkbabb/pencil-boil")>()),
+    createSequenceSubscription: (o: typeof carrier) => {
+      carrier = o;
+      return { start() {}, stop() {} };
+    },
+  }));
+  const { frontTween } = await import("@pencil/grid/gridPaths");
+  vi.spyOn(performance, "now").mockImplementation(() => 1000);
+  // run one 240 ms tween over the given rAF elapsed times (ms from its start()); frames to its end
+  const run = (elapsed: number[]) => {
+    let n = 0;
+    let done = -1;
+    frontTween({
+      durationMs: 240,
+      easing: (x) => x,
+      onProgress: () => void n++,
+      onComplete: () => (done = n + 1),
+    }).start();
+    for (const ms of elapsed)
+      if (done < 0) carrier!.onProgress(0, ms / carrier!.durationMs);
+    return done;
+  };
+  return run;
+};
+
+describe("crit.partial30 — a 30 Hz panel with a partial first tick", () => {
+  for (const partial of [2, 5, 9, 12, 16])
+    it(`first tick ${partial} ms then 30 Hz frames: a 240 ms front ends by frame 11 (the 30 Hz cure)`, async () => {
+      const run = await load();
+      const done = run(Array.from({ length: 40 }, (_, k) => partial + k * F));
+      vi.doUnmock("@mkbabb/pencil-boil");
+      // whole-frame start ends on frame 10 (the tree's own unit row); one partial frame adds <= 1
+      expect(done).toBeLessThanOrEqual(11);
+    });
+
+  it("a SECOND front 12 frames after a partial-start front still runs at the panel's frame", async () => {
+    const run = await load();
+    run(Array.from({ length: 12 }, (_, k) => 5 + k * F)); // front A, 5 ms partial first tick
+    // front B starts on a frame boundary of the SAME page (window shared); its ticks are whole frames
+    const done = run(Array.from({ length: 40 }, (_, k) => (k + 1) * F));
+    vi.doUnmock("@mkbabb/pencil-boil");
+    expect(done).toBeLessThanOrEqual(11);
+  });
+
+  it("NEGATIVE CONTROL: a whole-frame start ends on frame 10 (MOTION.hand.stepMs read)", async () => {
+    const run = await load();
+    const done = run(Array.from({ length: 40 }, (_, k) => (k + 1) * F));
+    vi.doUnmock("@mkbabb/pencil-boil");
+    expect(MOTION.hand.stepMs).toBe(17);
+    expect(done).toBe(10);
+  });
+});
