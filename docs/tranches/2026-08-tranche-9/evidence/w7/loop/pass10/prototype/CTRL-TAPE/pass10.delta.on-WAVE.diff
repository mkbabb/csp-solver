+// PASS 10 · BOARD INK IS THE TRUTH (CHAIR-RULINGS p10 §7; the pass-9 critic's edges R and C). The
+// session-log walk read a reload as pristine (the log starts empty, so ONE click cleared the
+// restored digit, both engines, tree and WAVE) and read a board an answered Clear had emptied as
+// dirty (Solve asked about nothing). The ask reads `boardInk` now. Each pointer is its own cell,
+// its regime witnessed first. The `__asked` recorder is proven in-run: it must read TRUE across
+// the press that mounts the question, then FALSE across the press that must not.
+for (const cell of [
+  { name: "fine 1440×900", viewport: { width: 1440, height: 900 }, hasTouch: false, coarse: false },
+  { name: "coarse 1440×900", viewport: { width: 1440, height: 900 }, hasTouch: true, coarse: true },
+]) {
+  test.describe(`T9-M12 across a reload @ ${cell.name}`, () => {
+    test.use({ viewport: cell.viewport, hasTouch: cell.hasTouch });
+
+    test("a restored digit asks before Clear; a board the answered Clear emptied solves on one click", async ({
+      page,
+    }) => {
+      test.setTimeout(90_000);
+      await loadSudoku(page);
+      await footSettled(page);
+      expect(await page.evaluate(() => matchMedia("(pointer: coarse)").matches), "the regime witness").toBe(cell.coarse);
+      const ribbon = page.locator("#card-foot .confirm-ribbon");
+      const empties = () =>
+        page.evaluate(() => [...document.querySelectorAll(".sudoku-cell input")].filter((i) => !(i as HTMLInputElement).value).length);
+      const at = await page.evaluate(() => [...document.querySelectorAll(".sudoku-cell input")].findIndex((i) => !(i as HTMLInputElement).value));
+      expect(at, "the board has an empty cell").toBeGreaterThanOrEqual(0);
+      const cellAt = () => page.locator(".sudoku-cell input").nth(at);
+      await cellAt().click();
+      await page.keyboard.type("5");
+      await expect(cellAt()).toHaveValue("5");
+      // the write is persisted before the reload (the board's own save, not a test hook)
+      await expect
+        .poll(
+          () =>
+            page.evaluate((i) =>
+              Object.keys(localStorage).some((k) => {
+                try {
+                  return JSON.parse(localStorage.getItem(k) ?? "null")?.values?.[String(i)] === 5;
+                } catch {
+                  return false;
+                }
+              }), at),
+          { timeout: 5000, message: "the saved board holds the digit" },
+        )
+        .toBe(true);
+      await page.reload();
+      await page.waitForSelector("svg.handwritten-logo", { timeout: 15000 });
+      await footSettled(page);
+      await expect(cellAt(), "the reload restores the player's digit").toHaveValue("5");
+      const record = () =>
+        page.evaluate(() => {
+          const w = window as unknown as { __asked: boolean };
+          w.__asked = false;
+          new MutationObserver(() => {
+            if (document.querySelector("#card-foot .confirm-ribbon")) w.__asked = true;
+          }).observe(document.getElementById("card-foot")!, { childList: true, subtree: true });
+        });
+      const asked = () => page.evaluate(() => (window as unknown as { __asked: boolean }).__asked);
+      // R · the restored digit is player ink: the press asks, and clears nothing
+      await record();
+      await page.locator('#card-foot button[aria-label="Clear the board"]').click();
+      await expect(ribbon, "R · a restored digit asks").toHaveCount(1);
+      await expect(ribbon).toHaveAttribute("aria-label", "clear the board?");
+      expect(await asked(), "the recorder sees the question it must see").toBe(true);
+      await expect(cellAt(), "the ask alone clears nothing").toHaveValue("5");
+      await ribbon.getByRole("button", { name: "clear", exact: true }).click();
+      await expect(cellAt(), "the answer clears the board").toHaveValue("");
+      await expect(ribbon).toHaveCount(0);
+      // C · the answered Clear left no ink: Solve acts on one press, never asked
+      await record();
+      await page.locator('#card-foot button[aria-label="Solve puzzle"]').click();
+      await expect.poll(empties, { timeout: 20000, message: "C · one press solves the cleared board" }).toBe(0);
+      expect(await asked(), "C · a board the Clear emptied is never asked").toBe(false);
+      console.log(`[M12 reload ${cell.name}] R asked, C solved unasked`);
+    });
+  });
+}
