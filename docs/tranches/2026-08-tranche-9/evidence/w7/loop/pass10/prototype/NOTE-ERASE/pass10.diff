+ * on `<html>`, `:root` still owned by CSS.
+ *
+ * THE REGISTRATION IS THE FENCE, AND IT IS NOT EMITTED HERE (chair §6.5, the @property law's
+ * first clause — pass 4). `@property --motion-*` is declared in the first STATIC stylesheet
+ * (`assets/index.css`, one block of seven at `initial-value: 0ms`); this function emits only the
+ * VALUES. A registration riding its own publisher is no fence at all: delete the publisher and
+ * the type goes with it, every rung computes to the empty string, the `animation` shorthand is
+ * invalid and `animation-name` reads `none` — the verb never runs and the record carries a mode
+ * nobody declared (pass 3 measured exactly that, row I). With the registration static, a missing
+ * publisher leaves every rung at 0ms: the verb runs instantly, the note vanishes on one frame,
+ * and gate 7 reads the declared failure (row E). Consumers write `var(--motion-<rung>)` BARE; a
+ * byte-equal fallback would make the same deletion invisible, which is why the fallbacks are
+ * struck.
+ */
+export function publishMotionRungs(doc: Document = document): void {
+  if (doc.querySelector("style[data-motion-rungs]")) return;
+  const names = Object.keys(MOTION.rungs);
+  const decls = Object.entries(MOTION.rungs)
+    .map(([name, ms]) => `--motion-${name}:${ms}ms`)
+    .join(";");
+  const zeroed = names.map((name) => `--motion-${name}:0ms`).join(";");
+  const style = doc.createElement("style");
+  style.setAttribute("data-motion-rungs", "");
+  style.textContent =
+    `:root{${decls}}` + `@media (prefers-reduced-motion: reduce){:root{${zeroed}}}`;
+  doc.head.appendChild(style);
+}
