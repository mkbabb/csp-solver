+// ── 2a′. A leave with no animation has no clock (pass 8, LAWS P7 §F) ─
+//
+// Vue's fallback timer reads the leaving node's `animation-duration` and never its
+// `animation-name`, so a rung written onto a leave whose computed name is `none` holds the node
+// for the rung on an animation that never runs (pass 7's hook did it to the union's `note-swap`:
+// the sentence on both lines for 16–20 frames). The hook keys its length on the COMPUTED name.
+// This leg reads the leave both ways a page can switch the verb off, the site's PRM arm and an
+// author `animation-name: none !important`, and counts the frames the leaving node is PAINTED:
+// each read is a task queued from its frame's rAF (`installTimeline`, the recorder's post-paint
+// track). Its negative runs in the same file on the same dist: the fence BLINDED (the hook's one
+// read is made to answer a running verb, so it writes the rung on every leave, which is the
+// pass-7 hook) holds the node for the rung and more frames than the bound.
+
+/** The in-run negatives. The hook's one key is `getAnimations()` on the leaving node (pass 9,
+ *  LAWS P8 §D); each negative lies to that read only, on nodes wearing a leave class, so Vue's own
+ *  clock read (the computed duration and delay) is untouched.
+ *  BLIND: every leave answers a running rub-out, so the hook writes the rung on every leave (the
+ *  pass-7 hook).
+ *  NAME_KEY: a leave answers a running animation whenever its COMPUTED name is not `none` (the
+ *  pass-8 hook, keyed on the proxy): a name that no `@keyframes` defines writes the rung.
+ *  PRESENT_KEY: a leave answers every CSS animation it carries as running on the document's
+ *  timeline, whatever its play state or timeline (the pass-9 hook, keyed on presence, LAWS P9 §D):
+ *  a paused verb, a verb on no timeline and one on a scroll timeline write the rung.
+ *  Every answer carries `playState: 'running'` and `timeline: document.timeline`, so the hook's
+ *  pass-10 key can't refuse a fake on its own clauses: what a negative proves is the old key. */
+const fakeAnimations = (mode: 'blind' | 'name' | 'present') => `(() => {
+  const real = Element.prototype.getAnimations;
+  Element.prototype.getAnimations = function (o) {
+    const own = real.call(this, o);
+    if (!/-leave-active/.test(String(this.getAttribute('class')))) return own;
+    const run = (animationName) => ({ animationName, playState: 'running', timeline: document.timeline });
+    if ('${mode}' === 'present') return own.filter((a) => 'animationName' in a).map((a) => run(a.animationName));
+    const n = getComputedStyle(this).animationName;
+    const still = n.split(',').every((x) => x.trim() === 'none');
+    return '${mode}' === 'blind' || !still ? [run(n)] : [];
+  };
+})();`;
+const BLIND_THE_FENCE = fakeAnimations('blind');
+const NAME_KEY = fakeAnimations('name');
+const PRESENT_KEY = fakeAnimations('present');
+
+/** The pass-9 critic's class (LAWS P9 §D): a leave that SHIPS its verb, with one declaration that
+ *  keeps the verb present and stops it running. Each is `!important`, since the site's `animation`
+ *  shorthand resets both longhands. Under the presence key each holds the sentence for the rung,
+ *  both engines. */
+const NOT_RUNNING: { name: string; decl: string }[] = [
+  { name: 'animation-play-state: paused', decl: 'animation-play-state: paused !important' },
+  { name: 'animation-timeline: none', decl: 'animation-timeline: none !important' },
+  { name: 'animation-timeline: scroll(root)', decl: 'animation-timeline: scroll(root) !important' },
+];
+
+/** The pass-8 critic's plant (LAWS P8 §D): a leave whose computed name no `@keyframes` defines.
+ *  Assembled at run time, never spelled: a spelled plant is a Tailwind source (T9-R6). */
+const GHOST = ['erase', 'ghost'].join('-');
+
+type PaintedTrack = { post: { k: number; r: { x: unknown } | null }[]; on: boolean };
+
+/** Watch the next leave of `leaving` (a selector matched once its leave class is on): the node's
+ *  DOM lifetime, its computed clock, and per frame, read post-paint, whether it was CONNECTED and
+ *  whether it was VISIBLE (its computed opacity > 0.05, LAWS P8 §D: a node at `opacity: 0` on the
+ *  page is not a double paint; pass 8's tree negative counted 18-19 connected frames, of which it
+ *  was visible on one). */
+async function watchLeave(page: Page, leaving: string) {
+  await page.evaluate(installTimeline, `css:${leaving}:opacity`);
+  await page.evaluate((sel) => {
+    const rec: LeaveRecord = {};
+    (window as unknown as { __leave: LeaveRecord }).__leave = rec;
+    new MutationObserver(() => {
+      const el = rec.el ?? document.querySelector(sel);
+      if (el && !rec.el) {
+        const cs = getComputedStyle(el);
+        Object.assign(rec, {
+          el,
+          t0: performance.now(),
+          animationName: cs.animationName,
+          animationDuration: cs.animationDuration,
+        });
+      }
+      if (rec.el && rec.t1 === undefined && !rec.el.isConnected) rec.t1 = performance.now();
+    }).observe(document.body, {
+      subtree: true,
+      childList: true,
+      attributes: true,
+      attributeFilter: ['class'],
+    });
+  }, leaving);
+  return async () => {
+    const read = () =>
+      page.evaluate(() => {
+        const r = (window as unknown as { __leave: LeaveRecord }).__leave;
+        return r.t1 === undefined || r.t0 === undefined ? null : r.t1 - r.t0;
+      });
+    await expect.poll(read, { timeout: 5000 }).not.toBeNull();
+    // Two more frames, so the frame after the removal has its post-paint read too.
+    await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+    return page.evaluate(() => {
+      const w = window as unknown as { __leave: LeaveRecord; __pf: PaintedTrack };
+      w.__pf.on = false;
+      const r = w.__leave;
+      return {
+        ms: +(r.t1! - r.t0!).toFixed(1),
+        animationName: r.animationName!,
+        animationDuration: r.animationDuration!,
+        painted: w.__pf.post.filter((p) => p.r !== null).length,
+        visible: w.__pf.post.filter((p) => p.r !== null && parseFloat(String(p.r.x)) > 0.05).length,
+      };
+    });
+  };
+}
