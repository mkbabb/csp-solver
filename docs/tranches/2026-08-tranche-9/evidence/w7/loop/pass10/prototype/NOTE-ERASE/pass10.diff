+/** A red line on the pinned board, then the edit that rubs it out, with the leave watched. */
+async function redLineLeaves(page: Page, arm?: (page: Page) => Promise<void>) {
+  await loadSudoku(page, '?board=' + CONFLICT_BOARD);
+  await expect
+    .poll(() => page.locator('.sudoku-cell .glyph-svg').count(), { timeout: 15000 })
+    .toBe(72);
+  await arm?.(page);
+  await setCellValue(page, 0, '9');
+  await setCellValue(page, 1, '9');
+  await page.locator('.controls-card button[aria-label="Solve puzzle"]').click();
+  await expect(page.locator('.margin-note')).toHaveClass(/teacher-red/, { timeout: 15000 });
+  const done = await watchLeave(page, '.margin-note .margin-note-ink[class*="leave-active"]');
+  await setCellValue(page, 1, '');
+  return done();
+}
+
+const STILL_LEAVES: { name: string; computed: string; arm: (page: Page) => Promise<void> }[] = [
+  {
+    name: "the site's PRM arm",
+    computed: 'none',
+    arm: (page) => page.emulateMedia({ reducedMotion: 'reduce' }),
+  },
+  {
+    name: 'animation-name: none !important on the leave class',
+    computed: 'none',
+    arm: (page) =>
+      page
+        .addStyleTag({
+          content: '.margin-note-ink.note-leave-active { animation-name: none !important; }',
+        })
+        .then(() => undefined),
+  },
+  {
+    // Pass 9 (LAWS P8 §D): NAMED but not RUNNING. The pass-8 hook keyed on this name.
+    name: 'a computed name no @keyframes defines (the ghost name)',
+    computed: GHOST,
+    arm: (page) =>
+      page
+        .addStyleTag({
+          content: `.margin-note-ink.note-leave-active { animation-name: ${GHOST} !important; }`,
+        })
+        .then(() => undefined),
+  },
+];
+
+/** THE TEETH of a zero-length leave (pass 10, LAWS P9 §F): the exact `0s` the hook wrote and at
+ *  most ZERO_LEAVE_FRAMES frames connected. Both are literal pins. The pass-9 time clause
+ *  (`ms < MOTION.rungs.whisper`) is STRUCK as decorative: its bound is the negative's own clock
+ *  (Vue's `duration + 1`), so a 140 ms write held 145-150 ms and passed it (the pass-9 critic). The
+ *  `visible <= painted` clause is STRUCK as vacuous: a visible frame is a connected frame by
+ *  construction. `ms` and `visible` are printed, never gated, on a still leave. */
+const ZERO_LEAVE_FRAMES = 2;
+const zeroLengthLeave = (leave: { animationDuration: string; painted: number }) =>
+  leave.animationDuration === '0s' && leave.painted <= ZERO_LEAVE_FRAMES;
+
+// The bound ±ε, pinned as literals the constant can't move (LAWS P9 §F): a record connected on
+// 1 or 2 frames is a zero-length leave, on 3 it is not; a 1 ms write is not `0s`.
+test('drop clock: the zero-length bound, ±1 frame and ±1 ms, as literals', () => {
+  expect(zeroLengthLeave({ animationDuration: '0s', painted: 1 })).toBe(true);
+  expect(zeroLengthLeave({ animationDuration: '0s', painted: 2 })).toBe(true);
+  expect(zeroLengthLeave({ animationDuration: '0s', painted: 3 })).toBe(false);
+  expect(zeroLengthLeave({ animationDuration: '0.001s', painted: 1 })).toBe(false);
+});
+
+for (const still of STILL_LEAVES) {
+  test(`drop clock: a leave with no animation has no clock — ${still.name}`, async ({ page }) => {
+    const leave = await redLineLeaves(page, still.arm);
+    expect(leave.animationName).toBe(still.computed);
+    expect(leave.animationDuration).toBe('0s');
+    expect(leave.painted).toBeLessThanOrEqual(ZERO_LEAVE_FRAMES);
+    expect(zeroLengthLeave(leave)).toBe(true);
+    console.log(
+      `still leave ${still.name}: ${leave.ms} ms, ${leave.painted} connected / ${leave.visible} visible frames`,
+    );
+  });
+}
+
+/** The shipped red-line leave with one declaration that stops its verb without removing it. */
+const notRunningArm = (decl: string) => (page: Page) =>
+  page
+    .addStyleTag({ content: `.margin-note-ink.note-leave-active { ${decl}; }` })
+    .then(() => undefined);
+
+for (const scheme of ['light', 'dark'] as const)
+for (const plant of NOT_RUNNING) {
+  test(`drop clock: a verb PRESENT but not RUNNING has no clock — ${scheme}, ${plant.name}`, async ({
+    page,
+  }) => {
+    await page.emulateMedia({ colorScheme: scheme });
+    const leave = await redLineLeaves(page, notRunningArm(plant.decl));
+    // The verb is still the leave's: present, and named.
+    expect(leave.animationName).not.toBe('none');
+    expect(leave.animationDuration).toBe('0s');
+    expect(leave.painted).toBeLessThanOrEqual(ZERO_LEAVE_FRAMES);
+    console.log(
+      `not running ${scheme} ${plant.name}: ${leave.ms} ms, ${leave.painted} connected / ${leave.visible} visible frames`,
+    );
+  });
+
+  test(`drop clock (negative, in-run): the pass-9 presence key holds ${plant.name} for the rung — ${scheme}`, async ({
+    page,
+  }) => {
+    await page.emulateMedia({ colorScheme: scheme });
+    await page.addInitScript(PRESENT_KEY);
+    const leave = await redLineLeaves(page, notRunningArm(plant.decl));
+    expect(leave.animationName).not.toBe('none');
+    // The binding clauses: the rung written, and the node held past the zero-length bound. The
+    // time is printed, never gated: a held leave's clock IS Vue's rung + 1 (LAWS P9 §F).
+    expect(leave.animationDuration).toBe(`${MOTION.rungs.whisper / 1000}s`);
+    expect(leave.painted).toBeGreaterThan(ZERO_LEAVE_FRAMES);
+    console.log(
+      `presence negative ${scheme} ${plant.name}: held ${leave.ms} ms, ${leave.painted} connected / ${leave.visible} visible frames`,
+    );
+  });
+}
+
+test('drop clock (negative, in-run): the fence blinded holds a still leave for the rung', async ({
+  page,
+}) => {
+  await page.addInitScript(BLIND_THE_FENCE);
+  await page.emulateMedia({ reducedMotion: 'reduce' });
+  const leave = await redLineLeaves(page);
+  // The pass-7 hook's reading: the rung written on a leave with no verb, the node held for it.
+  expect(leave.animationDuration).toBe(`${MOTION.rungs.whisper / 1000}s`);
+  expect(leave.painted).toBeGreaterThan(2);
+  // On the tree the held node is VISIBLE on one frame: `.note-leave-to` is `opacity: 0` from frame
+  // two. Its harm is the next line's write-in held for the rung (out-in), not a double paint.
+  console.log(
+    `drop-clock negative: held ${leave.ms} ms, ${leave.painted} connected / ${leave.visible} visible frames`,
+  );
+});
+
+test('drop clock (negative, in-run): the pass-8 name key holds a GHOST leave for the rung', async ({
+  page,
+}) => {
+  await page.addInitScript(NAME_KEY);
+  const leave = await redLineLeaves(page, (p) =>
+    p
+      .addStyleTag({
+        content: `.margin-note-ink.note-leave-active { animation-name: ${GHOST} !important; }`,
+      })
+      .then(() => undefined),
+  );
+  expect(leave.animationName).toBe(GHOST);
+  expect(leave.animationDuration).toBe(`${MOTION.rungs.whisper / 1000}s`);
+  expect(leave.painted).toBeGreaterThan(2);
+  console.log(
+    `ghost negative (name key): held ${leave.ms} ms, ${leave.painted} connected / ${leave.visible} visible frames`,
+  );
+});
