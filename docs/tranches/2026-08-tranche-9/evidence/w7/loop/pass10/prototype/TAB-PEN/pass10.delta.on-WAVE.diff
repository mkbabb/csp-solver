+
+/** An n x n PNG whose pixel i is `fn(i)` → [r, g, b] (or [r, g, b, a] with `alpha`): the self-test's
+ *  touch icons. */
+function pngN(n, fn, alpha = false, h = n) {
+  const chunk = (t, d) => {
+    const out = Buffer.alloc(12 + d.length);
+    out.writeUInt32BE(d.length, 0);
+    out.write(t, 4, "latin1");
+    d.copy(out, 8);
+    out.writeUInt32BE(
+      zlib.crc32(Buffer.concat([Buffer.from(t), d])) >>> 0,
+      8 + d.length,
+    );
+    return out;
+  };
+  const rows = [];
+  for (let y = 0; y < h; y++)
+    rows.push(
+      Buffer.from([0, ...Array.from({ length: n }, (_, x) => fn(y * n + x)).flat()]),
+    );
+  return Buffer.concat([
+    Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]),
+    chunk("IHDR", Buffer.from([0, 0, 0, n, 0, 0, 0, h, 8, alpha ? 6 : 2, 0, 0, 0])),
+    chunk("IDAT", zlib.deflateSync(Buffer.concat(rows))),
+    chunk("IEND", Buffer.alloc(0)),
+  ]);
+}
+const png180 = (fn, alpha) => pngN(180, fn, alpha);
+const BLOCK = "M8,6H24V26H8ZM8,11H24M8,16H24M8,21H24"; // C1: five pen lines, a near-solid tab
+const PAPER_RGB = [251, 250, 249];
+const INK_RGB = [10, 10, 10];
+/** The path rastered analytically and encoded over the light paper and ink (what `npm run icons` makes). */
+const pngOf = (d, pen, alphaAt = -1) => {
+  const { cov } = raster(d, pen);
+  const px = (i) => PAPER_RGB.map((p, c) => Math.round(p + (INK_RGB[c] - p) * cov[i]));
+  return alphaAt < 0
+    ? png180(px)
+    : png180((i) => [...px(i), i === alphaAt ? 0 : 255], true);
+};
+/** Every absolute x,y pair of a path moved by (dx, dy) and scaled by k (x) and ky (y) about (16, 16). */
+const LINKS = /(<link rel="icon"[^>]*>\s*<link rel="apple-touch-icon"[^>]*>)/;
+const Z = "M9,6H23L9,26H23"; // T1 (pass-8 critic): a Z drawn into the arm table
+const movePath = (d, dx, dy, k = 1, ky = k) =>
+  d.replace(
+    /(-?\d*\.?\d+),(-?\d*\.?\d+)/g,
+    (_, x, y) =>
+      `${+(16 + (x - 16) * k + dx).toFixed(3)},${+(16 + (y - 16) * ky + dy).toFixed(3)}`,
+  );
+/** THE EDGES (LAWS P8 §F, threshold sabotage). Each numeric bound pinned from OUTSIDE `BOUNDS` (and
+ *  WINDOWS): `bound` and `eps` are this table's own literals. `make(t)` builds a plant from one
+ *  parameter; the seek bisects t on the GATE'S OWN READING of the id, so both plants are data (a
+ *  path, a PNG, a token), measured, never a number typed beside the bound. The outer plant sits
+ *  within ε past the bound and must red the id; the inner sits within ε inside and must not. An
+ *  integer `t` indexes pixels or a candidate list pre-sorted by the gate's own ΔE. */
+const EDGE_SEEN = new Map(); // id|side → {tIn, tOut}: the seek is independent of BOUNDS, so it runs once
+function edges(clean) {
+  const img0 = decodePng(clean.png);
+  const ras0 = raster(PEN[ARM], WIDTH);
+  const P = PAPER_RGB;
+  const I = INK_RGB;
+  const repng = (fn) => png180((i) => fn(i, img0.rgba[i].slice(0, 3)));
+  const cube = (c, r) => {
+    const out = [];
+    for (let a = -r; a <= r; a++)
+      for (let b = -r; b <= r; b++)
+        for (let e = -r; e <= r; e++) out.push([c[0] + a, c[1] + b, c[2] + e]);
+    return out.filter((p) => p.every((v) => v >= 0 && v <= 255));
+  };
+  const { light } = pageTokens(clean.files).tok;
+  const byDE = (list, rc) => {
+    if (!rc) return []; // no token to sort by: the row's plants cannot be made, and the row FAILS
+    const de = (p) => deltaE(parseColor(`rgb(${p.join(" ")})`), rc);
+    return list
+      .map((p) => [de(p), p])
+      .sort((x, y) => x[0] - y[0])
+      .map(([, p]) => p);
+  };
+  const paperPx = [...ras0.cov.keys()].filter((i) => ras0.cov[i] === 0).reverse(); // bottom first
+  const inkPx = [...ras0.cov.keys()].filter((i) => ras0.cov[i] > 0);
+  const pixels = (list, n, to) => {
+    const on = new Set(list.slice(0, n));
+    return { png: repng((i, px) => (on.has(i) ? to(px) : px)) };
+  };
+  const css = clean.files.find((f) => f.file.endsWith("assets/index.css"));
+  const swIs = (t) => ({
+    svg: clean.svg.replace(/stroke-width="[^"]*"/, `stroke-width="${t}"`),
+  });
