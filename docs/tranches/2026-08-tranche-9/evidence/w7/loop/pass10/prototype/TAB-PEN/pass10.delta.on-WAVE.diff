+      "lo",
+      0.18,
+      0.002,
+      (n) => pixels(inkPx, n, () => P),
+      [0, inkPx.length],
+      1,
+    ],
+    [
+      "e.png-coverage",
+      "hi",
+      0.32,
+      0.002,
+      (n) => pixels(paperPx, n, () => I),
+      [0, paperPx.length],
+      1,
+    ],
