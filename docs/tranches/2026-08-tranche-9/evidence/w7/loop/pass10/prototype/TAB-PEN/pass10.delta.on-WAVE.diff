+      1,
+    ],
+    ["e.png-tie", "lo", 0.97, 0.0005, (n) => pixels(paperPx, n, () => I), [0, 2000], 1],
+    // the bottom row's paper, right to left: one 4-connected strip of n ink pixels
+    ["e.png-blob", "hi", 16, 1, (n) => pixels(paperPx, n, () => I), [0, 60], 1],
+  ];
+}
+/** The model a plant spec makes (the sidecar re-stamped, as `npm run icons` would). */
+const build = (clean, spec) => {
+  const m = { ...clean, ...spec };
+  delete m.arm; // the arm rides beside the model (audit's second argument), never in it
+  m.provenance = {
+    "icon.svg": sha256(m.svg),
+    "apple-touch-icon.png": m.png && sha256(m.png),
+  };
+  return m;
+};
+/** The gate's own reading of `id` on a spec: the extreme toward `side`, and whether the id fired. */
+function readEdge(clean, spec, id, side) {
+  const f = audit(build(clean, spec), spec.arm);
+  const r = f.readings[id] ?? [];
+  return {
+    v: side === "hi" ? Math.max(...r) : Math.min(...r),
+    fired: f.some(([, i]) => i === id),
+  };
+}
+function seekEdge(clean, [id, side, bound, , make, [t0, t1], int]) {
+  const out = (t) => {
+    const { v } = readEdge(clean, make(t), id, side);
+    return side === "hi" ? v > bound : v < bound;
+  };
+  let [a, b] = [t0, t1]; // a inside, b outside
+  if (out(a) || !out(b)) return null;
+  for (let k = 0; k < 40 && Math.abs(b - a) > (int ? 1 : 1e-6); k++) {
+    const m = int ? Math.floor((a + b) / 2) : (a + b) / 2;
+    if (out(m)) b = m;
+    else a = m;
+  }
+  return { tIn: a, tOut: b };
+}
+function edgeTest(clean, quiet, only = null) {
+  return edges(clean).map((e, k) => {
+    if (only !== null && k !== only) return true;
+    const [id, side, bound, eps, make] = e;
+    const key = `${k}|${id}|${side}|${bound}`;
+    let s;
+    let o;
+    let n;
+    try {
+      if (!EDGE_SEEN.has(key)) EDGE_SEEN.set(key, seekEdge(clean, e));
+      s = EDGE_SEEN.get(key);
+      if (s) [o, n] = [s.tOut, s.tIn].map((t) => readEdge(clean, make(t), id, side));
+    } catch {
+      s = null; // a plant the model cannot make (a sabotaged reading) is a FAILED row, never a crash
+    }
+    const ok =
+      !!s &&
+      o.fired &&
+      !n.fired &&
+      Math.abs(o.v - bound) <= eps &&
+      Math.abs(n.v - bound) <= eps;
+    if (!quiet)
+      console.log(
+        `  ${ok ? "PINNED" : "FAILED"}  EDGE ${id} ${side} ${bound} ±${eps}: ${
+          s
+            ? `past ${+o.v.toPrecision(6)} ${o.fired ? "RED" : "GREEN"} · inside ${+n.v.toPrecision(6)} ${n.fired ? "RED" : "GREEN"}`
+            : "no plant brackets the bound"
+        }`,
+      );
+    return ok;
+  });
+}
+
+/** THE CUTS (LAWS P8 §F, pass 10): each cut inside tie() pinned from outside CUTS by a plant built AT
+ *  cut ± ε/2 (a pixel value, or a pixel's distance from the pen), so moving the cut by ε flips one
+ *  side. [cut, its pinned value (this table's own literal, never read from CUTS), id the plant must
+ *  red, ε, make(t)]: make(value + ε/2) reds id, make(value − ε/2) does not. */
+function cutRows(clean) {
+  const img0 = decodePng(clean.png);
+  const ras0 = raster(PEN[ARM], WIDTH);
+  const n = img0.w;
+  const mix = (t) =>
+    PAPER_RGB.map((p, c) => Math.round(p + (1 - t) * (INK_RGB[c] - p)));
+  const at = (set, to) => ({
+    png: png180((i) => (set.has(i) ? to : img0.rgba[i].slice(0, 3))),
+  });
+  const full = (i) => ras0.cov[i] === 1;
+  let run = []; // the first 17 horizontally adjacent whole-coverage pixels: one 4-connected strip
+  for (let i = 0; i < ras0.cov.length && run.length < 17; i++)
+    run = full(i) && i % n && run.at(-1) === i - 1 ? [...run, i] : full(i) ? [i] : [];
+  // 400 whole-coverage pixels none 4-adjacent to another (even x, even y): the blob stays 1
+  const lone = [...ras0.cov.keys()]
+    .filter((i) => full(i) && !(i % 2) && !(Math.floor(i / n) % 2))
+    .slice(0, 400);
+  // a pixel off the pen's support by Chebyshev distance d (the bottom-most such pixel)
+  const ring = (d) => {
+    const dist = (i) => {
+      let m = Infinity;
+      for (let dy = -d - 1; dy <= d + 1; dy++)
+        for (let dx = -d - 1; dx <= d + 1; dx++) {
+          const [x, y] = [(i % n) + dx, Math.floor(i / n) + dy];
+          if (x >= 0 && y >= 0 && x < n && y < n && ras0.cov[y * n + x] > 0)
+            m = Math.min(m, Math.max(Math.abs(dx), Math.abs(dy)));
+        }
+      return m;
+    };
+    for (let i = ras0.cov.length - 1; i >= 0; i--) if (dist(i) === d) return i;
+    return -1;
+  };
+  return [
+    ["e.png-blob", 0.5, "e.png-blob", 0.02, (t) => at(new Set(run), mix(t))],
+    ["e.png-tie", 0.5, "e.png-tie", 0.02, (t) => at(new Set(lone), mix(t))],
+    [
+      "e.png-reach",
+      1,
+      "e.png-paper",
+      1,
+      (t) => at(new Set([ring(Math.round(t + 0.5))]), INK_RGB),
+    ],
+  ];
+}
+function cutTest(clean, quiet, only = null) {
+  return cutRows(clean).map(([cut, c, id, eps, make], k) => {
+    if (only !== null && k !== only) return true;
+    let o;
+    let i;
+    try {
+      [o, i] = [c + eps / 2, c - eps / 2].map((t) =>
+        readEdge(clean, make(t), id, "hi"),
+      );
+    } catch {
+      o = null; // a plant the model cannot make is a FAILED row, never a crash
+    }
+    const ok = !!o && o.fired && !i.fired;
+    if (!quiet)
+      console.log(
+        `  ${ok ? "PINNED" : "FAILED"}  CUT ${cut} ${c} ±${eps / 2} (red ${id}): ${
+          o
+            ? `past ${o.fired ? "RED" : "GREEN"} · inside ${i.fired ? "RED" : "GREEN"}`
+            : "no plant"
+        }`,
+      );
+    return ok;
+  });
+}
+
+function selfTest(clean, { quiet = false } = {}) {
+  // Every plant re-stamps the sidecar as `npm run icons` would (the gate must red on SHAPE, not on a
+  // stale sha), except P6, whose point is the stale sha. `ids` are check ids the plant must fire.
+  const plant = (
+    label,
+    edit,
+    want,
+    {
+      keepSha = false,
+      stalePng = false,
+      png = null,
+      files = null,
+      html = null,
+      arm,
+      patch = null,
+      ids = [],
+    } = {},
+  ) => {
+    const svg = edit(clean.svg);
+    const m = {
+      ...clean,
+      svg,
+      png: png ?? clean.png,
+      files: files ?? clean.files,
+      html: html ? html(clean.html) : clean.html,
+      ...patch,
+    };
+    if (!keepSha)
+      m.provenance = {
+        "icon.svg": sha256(svg),
+        "apple-touch-icon.png": stalePng
+          ? clean.provenance?.["apple-touch-icon.png"]
+          : m.png && sha256(m.png),
+      };
+    const fails = audit(m, arm);
+    const got = [...new Set(fails.map(([c]) => c))].sort().join("");
+    const fired = new Set(fails.map(([, id]) => id));
+    const missing = ids.filter((i) => !fired.has(i));
+    const changed =
+      svg !== clean.svg ||
+      png ||
+      files ||
+      (html && m.html !== clean.html) ||
+      arm ||
+      patch;
+    const ok = got === want && changed && !missing.length;
+    if (!quiet)
+      console.log(
+        `  ${ok ? (want ? "RED as required" : "GREEN as required") : "FAILED"}  ${label}: red ${got || "none"}, want ${want || "none"}${ids.length ? ` [${ids.map((i) => (fired.has(i) ? i : `${i}:MISSING`)).join(" ")}]` : ""}${ok ? "" : ` (fired: ${[...fired].join(" ")})`}`,
+      );
+    return ok;
+  };
+  const inStyle = (css) => (s) => s.replace("</style>", `${css}</style>`);
+  const withFile = (file, text) => [...clean.files, { file, text }];
+  const pathTo = (d) => (s) => s.replace(/ d="[^"]*"/, ` d="${d}"`);
+  const cleanPx = decodePng(clean.png).rgba.map((p) => p.slice(0, 3));
+  const bars = png180((i) => {
+    const [x, y] = [i % 180, Math.floor(i / 180)];
+    return Math.floor(y / 22) % 2 === 1 && y > 10 && y < 170 && x > 30 && x < 150
+      ? INK_RGB
+      : PAPER_RGB;
+  });
+  if (!quiet) console.log("\nself-test plants:");
+  const results = plants({
+    plant,
+    inStyle,
+    withFile,
+    pathTo,
+    cleanPx,
+    bars,
+    clean,
+    MAIN_FAVICON,
+    PAPER_RGB,
+    INK_RGB,
+    BLOCK,
+    LINKS,
+    Z,
+    movePath,
+    png180,
+    pngN,
+    pngOf,
+    decodePng,
+    ARM,
+    PEN,
+    WIDTH,
+  });
+  return [...results, ...edgeTest(clean, quiet), ...cutTest(clean, quiet)].every(
+    Boolean,
+  );
+}
+
+const model = readTree(ROOT);
+
+if (process.argv.includes("--threshold-battery")) {
+  // Every bound the EDGES pin, moved by its ε outward (loosened: the past plant must turn GREEN) and
+  // inward (tightened: the inside plant must turn RED) — each move must fail its edge row (LAWS P8 §F).
+  const rows = [];
+  let bite = 0;
+  const all = edges(model);
+  all.forEach((e, k) => {
+    const [id, side, bound, eps] = e;
+    const at = side === "lo" ? 0 : 1;
+    const table =
+      id === "d.window"
+        ? WINDOWS[Object.keys(WINDOWS).find((w) => WINDOWS[w][at] === bound)]
+        : BOUNDS[id];
+    for (const [how, sign] of [
+      ["loosen", side === "lo" ? -1 : 1],
+      ["tighten", side === "lo" ? 1 : -1],
+    ]) {
+      const keep = table[at];
+      table[at] = bound + sign * eps;
+      const ok = edgeTest(model, true, k)[k];
+      table[at] = keep;
+      rows.push(`  ${ok ? "HOLE" : "BITE"}  ${id} ${side} ${bound} ${how} by ${eps}`);
+      if (!ok) bite++;
+    }
+  });
+  // every cut inside tie(), moved by its ε both ways: each move must fail its CUT row
+  cutRows(model).forEach(([cut, , , eps], k) => {
+    for (const [how, sign] of [
+      ["up", 1],
+      ["down", -1],
+    ]) {
+      const keep = CUTS[cut];
+      CUTS[cut] = keep + sign * eps;
+      const ok = cutTest(model, true, k)[k];
+      CUTS[cut] = keep;
+      rows.push(`  ${ok ? "HOLE" : "BITE"}  CUT ${cut} ${keep} ${how} by ${eps}`);
+      if (!ok) bite++;
+    }
+  });
+  const clean = [...edgeTest(model, true), ...cutTest(model, true)].every(Boolean);
+  console.log(
+    `check-favicon --threshold-battery:\n${rows.join("\n")}\n  ${bite}/${rows.length} bite · unmoved edges ${clean ? "PINNED" : "FAILED"}`,
+  );
+  process.exit(bite === rows.length && clean ? 0 : 2);
+}
+
+if (process.argv.includes("--sabotage-battery")) {
+  // Every check id the self-test names, and the library clauses this gate reads: each switched off
+  // alone must red the self-test (LAWS P7 §F (ii)).
+  const ids = [
+    "a.junk",
+    "a.count",
+    "a.element",
+    "a.attr",
+    "a.dupe",
+    "a.root",
+    "a.ns",
+    "a.viewbox",
+    "a.paper",
+    "a.paper-xy",
+    "a.order",
+    "b.fill",
+    "b.cap",
+    "b.join",
+    "b.width",
+    "b.at-rule",
+    "b.context",
+    "b.selector",
+    "b.prop",
+    "b.important",
+    "b.bytes",
+    "c.unplaced",
+    "c.unresolved",
+    "c.conflict",
+    "c.tokens",
+    "c.opaque",
+    "c.delta",
+    "c.fallback",
+    "d.arm",
+    "d.pin",
+    "d.unreadable",
+    "d.extent",
+    "d.centre",
+    "d.window",
+    "d.mass",
+    "e.link-icon",
+    "e.link-touch",
+    "e.icon-file",
+    "e.favicon",
+    "e.prov-svg",
+    "e.png-file",
+    "e.prov-png",
+    "e.png-size",
+    "e.png-opaque",
+    "e.png-paper",
+    "e.png-coverage",
+    "e.png-ink",
+    "e.png-delta",
+    "e.png-tie",
+    "e.png-blob",
+  ];
+  const lib = [
+    "html-comment",
+    "html-inert",
+    "one-link",
+    "link-allow",
+    "base-red",
+    "token-conflict",
+    "tok-sites",
+    "at-own",
+    "collect-walk",
+    "decode",
+  ];
+  let bite = 0;
+  const rows = [];
+  for (const id of ids) {
+    OFF.clear();
+    OFF.add(id);
+    const ok = selfTest(model, { quiet: true });
+    rows.push(`  ${ok ? "HOLE" : "BITE"}  gate  ${id}`);
+    if (!ok) bite++;
+  }
+  OFF.clear();
+  for (const id of lib) {
+    sabotage([id]);
+    fileCache.clear(); // the library's readings under this clause's absence
+    const m2 = readTree(ROOT);
+    const ok = selfTest(m2, { quiet: true });
+    rows.push(`  ${ok ? "HOLE" : "BITE"}  lib   ${id}`);
+    if (!ok) bite++;
+  }
+  sabotage([]);
+  fileCache.clear();
+  console.log(
+    `check-favicon --sabotage-battery:\n${rows.join("\n")}\n  ${bite}/${ids.length + lib.length} bite`,
+  );
+  process.exit(bite === ids.length + lib.length ? 0 : 2);
+}
+
+if (run(model).length) {
+  console.error("\ncheck-favicon: the gate is RED on the tree (run check-favicon.mjs)");
+  process.exit(1);
+}
+if (!selfTest(model)) {
+  console.error(
+    "\ncheck-favicon: a plant did not red its clause (or a negative-negative went red)",
+  );
+  process.exit(2);
+}
+console.log(
+  "\ncheck-favicon self-test: every plant red its clause, every edge and cut pinned",
+);
