+    [
+      "d.window",
+      "lo",
+      0.15,
+      0.002,
+      (k) => pathIs(movePath(PEN[ARM], 0, 0, 1, k)),
+      [1, 1.3],
+    ],
+    [
+      "d.window",
+      "hi",
+      0.17,
+      0.002,
+      (k) => pathIs(movePath(PEN[ARM], 0, 0, 1, k)),
+      [1, 0.8],
+    ],
+    [
+      "d.window",
+      "lo",
+      0.19,
+      0.002,
+      (k) => pathIs(movePath(PEN[ARM], 0, 0, 1, k), 5),
+      [1, 1.3],
+    ],
+    [
+      "d.window",
+      "hi",
+      0.21,
+      0.002,
+      (k) => pathIs(movePath(PEN[ARM], 0, 0, 1, k), 5),
+      [1, 0.8],
+    ],
+    ["d.mass", "lo", 0.18, 0.002, (t) => swIs(+t.toFixed(4)), [4, 2]],
+    ["d.mass", "hi", 0.32, 0.002, (t) => swIs(+t.toFixed(4)), [4, 7]],
+    // the paper moved on EVERY pixel but pixel 0 (a one-pixel read cannot pin this row) …
+    [
+      "e.png-paper",
+      "hi",
+      1,
+      0.05,
+      (n) => ({
+        png: repng((i, px) => (i && !ras0.cov[i] && same(px, P) ? nearPaper[n] : px)),
+      }),
+      [0, nearPaper.length - 1],
+      1,
+    ],
+    // … and on ONE pixel, the bottom row's middle, off the path and away from pixel 0
+    [
+      "e.png-paper",
+      "hi",
+      1,
+      0.05,
+      (n) => ({ png: repng((i, px) => (i === lone ? nearPaper[n] : px)) }),
+      [0, nearPaper.length - 1],
+      1,
+    ],
