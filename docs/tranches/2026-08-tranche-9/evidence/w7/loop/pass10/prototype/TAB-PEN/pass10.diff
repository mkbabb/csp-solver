+  cutRows(model).forEach(([cut, , , eps], k) => {
+    for (const [how, sign] of [
+      ["up", 1],
+      ["down", -1],
+    ]) {
+      const keep = CUTS[cut];
+      CUTS[cut] = keep + sign * eps;
+      const ok = cutTest(model, true, k)[k];
+      CUTS[cut] = keep;
+      rows.push(`  ${ok ? "HOLE" : "BITE"}  CUT ${cut} ${keep} ${how} by ${eps}`);
+      if (!ok) bite++;
+    }
+  });
+  const clean = [...edgeTest(model, true), ...cutTest(model, true)].every(Boolean);
+  console.log(
+    `check-favicon --threshold-battery:\n${rows.join("\n")}\n  ${bite}/${rows.length} bite · unmoved edges ${clean ? "PINNED" : "FAILED"}`,
+  );
+  process.exit(bite === rows.length && clean ? 0 : 2);
+}
+
+if (process.argv.includes("--sabotage-battery")) {
+  // Every check id the self-test names, and the library clauses this gate reads: each switched off
+  // alone must red the self-test (LAWS P7 §F (ii)).
+  const ids = [
+    "a.junk",
+    "a.count",
+    "a.element",
+    "a.attr",
+    "a.dupe",
+    "a.root",
+    "a.ns",
+    "a.viewbox",
+    "a.paper",
+    "a.paper-xy",
+    "a.order",
+    "b.fill",
+    "b.cap",
+    "b.join",
+    "b.width",
+    "b.at-rule",
+    "b.context",
+    "b.selector",
+    "b.prop",
+    "b.important",
+    "b.bytes",
+    "c.unplaced",
+    "c.unresolved",
+    "c.conflict",
+    "c.tokens",
+    "c.opaque",
+    "c.delta",
+    "c.fallback",
+    "d.arm",
+    "d.pin",
+    "d.unreadable",
+    "d.extent",
+    "d.centre",
+    "d.window",
+    "d.mass",
+    "e.link-icon",
+    "e.link-touch",
+    "e.icon-file",
+    "e.favicon",
+    "e.prov-svg",
+    "e.png-file",
+    "e.prov-png",
+    "e.png-size",
+    "e.png-opaque",
+    "e.png-paper",
+    "e.png-coverage",
+    "e.png-ink",
+    "e.png-delta",
+    "e.png-tie",
+    "e.png-blob",
+  ];
+  const lib = [
+    "html-comment",
+    "html-inert",
+    "one-link",
+    "link-allow",
+    "base-red",
+    "token-conflict",
+    "tok-sites",
+    "at-own",
+    "collect-walk",
+    "decode",
