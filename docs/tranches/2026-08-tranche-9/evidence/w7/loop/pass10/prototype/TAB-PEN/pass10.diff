+/* ── the markup ─────────────────────────────────────────────────────────────── */
+export const ALLOWED = {
+  svg: ["xmlns", "viewBox"],
+  style: [],
+  rect: ["width", "height", "fill", "x", "y"],
+  path: ["d", "fill", "stroke", "stroke-width", "stroke-linecap", "stroke-linejoin"],
+};
+export function parseSvg(svg) {
+  const els = [];
+  let styleText = "";
+  const tag =
+    /<(\/?)([A-Za-z][\w:.-]*)((?:\s+[^\s=>/]+\s*=\s*(?:"[^"]*"|'[^']*'))*)\s*(\/?)>/y;
+  const junk = [];
+  let i = 0;
+  let inStyle = false;
+  while (i < svg.length) {
+    if (inStyle) {
+      const end = svg.indexOf("</style>", i);
+      if (end < 0) return { els, styleText, junk: ["an unclosed <style>"] };
+      styleText += svg.slice(i, end);
+      i = end;
+      inStyle = false;
+      continue;
+    }
+    const lt = svg.indexOf("<", i);
+    const text = svg.slice(i, lt < 0 ? svg.length : lt);
+    if (text.trim()) junk.push(`text "${text.trim().slice(0, 20)}"`);
+    if (lt < 0) break;
+    tag.lastIndex = lt;
+    const m = tag.exec(svg);
+    if (!m) {
+      junk.push(`markup this gate can't read at "${svg.slice(lt, lt + 12)}"`);
+      break;
+    }
+    i = tag.lastIndex;
+    if (m[1]) continue;
+    const attrs = [...m[3].matchAll(/([^\s=]+)\s*=\s*(?:"([^"]*)"|'([^']*)')/g)].map(
+      (a) => [a[1], a[2] ?? a[3]],
+    );
+    els.push({
+      name: m[2],
+      attrs,
+      dupe: new Set(attrs.map(([k]) => k)).size < attrs.length,
+    });
+    if (m[2] === "style" && !m[4]) inStyle = true;
+  }
+  return { els, styleText, junk };
+}
+
+/* ── geometry: absolute M/L/H/V/C/Q/Z → polylines (curves at 24 steps) and exact extrema ─────── */
+export function geometry(d) {
+  const t = d.match(/[A-Za-z]|-?\d*\.?\d+(?:e-?\d+)?/g);
+  if (!t || t.some((x) => /[a-z]/.test(x) || /[^MLHVCQZ\d.e-]/.test(x))) return null;
+  const xs = [];
+  const ys = [];
+  const lines = [];
+  let line = null;
+  const ext = (v) => {
+    const out = [v[0], v[v.length - 1]];
+    const roots = [];
+    if (v.length === 4) {
+      const [a, b, c] = [
+        -v[0] + 3 * v[1] - 3 * v[2] + v[3],
+        2 * (v[0] - 2 * v[1] + v[2]),
+        v[1] - v[0],
+      ];
+      if (Math.abs(a) < 1e-12) {
+        if (Math.abs(b) > 1e-12) roots.push(-c / b);
+      } else if (b * b - 4 * a * c >= 0) {
+        const s = Math.sqrt(b * b - 4 * a * c);
+        roots.push((-b + s) / (2 * a), (-b - s) / (2 * a));
+      }
+    } else if (Math.abs(v[0] - 2 * v[1] + v[2]) > 1e-12)
+      roots.push((v[0] - v[1]) / (v[0] - 2 * v[1] + v[2]));
+    for (const u of roots.filter((r) => r > 0 && r < 1)) out.push(bez(v, u));
+    return out;
+  };
+  const bez = (v, u) =>
+    v.length === 4
+      ? (1 - u) ** 3 * v[0] +
+        3 * (1 - u) ** 2 * u * v[1] +
+        3 * (1 - u) * u * u * v[2] +
+        u ** 3 * v[3]
+      : (1 - u) ** 2 * v[0] + 2 * (1 - u) * u * v[1] + u * u * v[2];
+  let [cx, cy] = [0, 0];
+  let cmd = "";
+  for (let i = 0; i < t.length;) {
+    if (/[A-Z]/.test(t[i])) cmd = t[i++];
+    const n = () => +t[i++];
+    if (cmd === "Z") {
+      if (line) {
+        line.push(line[0]);
+        [cx, cy] = line[0];
+      }
+      continue;
+    }
+    if (cmd === "M") {
+      [cx, cy] = [n(), n()];
+      lines.push((line = [[cx, cy]]));
+      cmd = "L"; // implicit lineto after a moveto's first pair
+    } else if (cmd === "L") [cx, cy] = [n(), n()];
+    else if (cmd === "H") cx = n();
+    else if (cmd === "V") cy = n();
+    else if (cmd === "C" || cmd === "Q") {
+      const p = [[cx, cy]];
+      for (let k = 0; k < (cmd === "C" ? 3 : 2); k++) p.push([n(), n()]);
+      xs.push(...ext(p.map((q) => q[0])));
+      ys.push(...ext(p.map((q) => q[1])));
+      for (let k = 1; k <= 24; k++)
+        line?.push([
+          bez(
+            p.map((q) => q[0]),
+            k / 24,
+          ),
+          bez(
+            p.map((q) => q[1]),
+            k / 24,
+          ),
+        ]);
+      [cx, cy] = p[p.length - 1];
+      continue;
+    } else return null;
+    if (!line) return null;
+    if (cmd !== "L" || line.length > 1 || line[0][0] !== cx || line[0][1] !== cy)
+      line.push([cx, cy]);
+    xs.push(cx);
+    ys.push(cy);
+  }
+  if (!lines.length || xs.some(Number.isNaN)) return null;
+  return {
+    box: [Math.min(...xs), Math.min(...ys), Math.max(...xs), Math.max(...ys)],
+    lines,
+  };
+}
+
+/** Per-pixel ink coverage of a round-capped, round-joined pen of `pen` units along the path, on an
+ *  `n` × `n` raster of the 32 viewBox, `ss` × `ss` samples a pixel (the union of capsules IS the
+ *  round-cap/round-join stroke). Memoised. */
+export const rasterCache = new Map();
+export function raster(d, pen, n = 180, ss = 4) {
+  const key = `${d}|${pen}|${n}|${ss}`;
+  if (rasterCache.has(key)) return rasterCache.get(key);
+  const g = geometry(d);
+  if (!g) return null;
+  const k = (n * ss) / 32;
+  const S = n * ss;
+  const r = (pen / 2) * k;
+  const ink = new Uint8Array(S * S);
+  for (const line of g.lines)
+    for (let j = 0; j < line.length; j++) {
+      const [ax, ay] = [line[j][0] * k, line[j][1] * k];
+      const [bx, by] =
+        j + 1 < line.length ? [line[j + 1][0] * k, line[j + 1][1] * k] : [ax, ay];
+      const [dx, dy] = [bx - ax, by - ay];
+      const L2 = dx * dx + dy * dy;
+      const x0 = Math.max(0, Math.floor(Math.min(ax, bx) - r));
+      const x1 = Math.min(S - 1, Math.ceil(Math.max(ax, bx) + r));
+      const y0 = Math.max(0, Math.floor(Math.min(ay, by) - r));
+      const y1 = Math.min(S - 1, Math.ceil(Math.max(ay, by) + r));
+      for (let y = y0; y <= y1; y++)
+        for (let x = x0; x <= x1; x++) {
+          const [px, py] = [x + 0.5 - ax, y + 0.5 - ay];
+          const u = L2 ? Math.max(0, Math.min(1, (px * dx + py * dy) / L2)) : 0;
+          const [ex, ey] = [px - u * dx, py - u * dy];
+          if (ex * ex + ey * ey <= r * r) ink[y * S + x] = 1;
+        }
+    }
+  const cov = new Float64Array(n * n);
+  for (let y = 0; y < S; y++)
+    for (let x = 0; x < S; x++)
+      if (ink[y * S + x])
+        cov[Math.floor(y / ss) * n + Math.floor(x / ss)] += 1 / (ss * ss);
+  const out = { cov, mass: cov.reduce((s, v) => s + v, 0) / (n * n) };
+  rasterCache.set(key, out);
+  return out;
+}
+
+/* ── the touch icon's pixels (PNG, non-interlaced, any colour type) ─────────── */
+export function decodePng(buf) {
+  if (!buf || buf.length < 33 || buf.readUInt32BE(0) !== 0x89504e47) return null;
+  let o = 8;
+  let hdr = null;
+  let plte = null;
+  let trns = null;
+  const idat = [];
+  while (o + 8 <= buf.length) {
+    const len = buf.readUInt32BE(o);
+    const type = buf.toString("latin1", o + 4, o + 8);
+    const data = buf.subarray(o + 8, o + 8 + len);
+    o += 12 + len;
+    if (type === "IHDR")
+      hdr = {
+        w: data.readUInt32BE(0),
+        h: data.readUInt32BE(4),
+        depth: data[8],
+        ct: data[9],
+        lace: data[12],
+      };
+    else if (type === "PLTE") plte = data;
+    else if (type === "tRNS") trns = data;
+    else if (type === "IDAT") idat.push(data);
+    else if (type === "IEND") break;
+  }
+  const ch = { 0: 1, 2: 3, 3: 1, 4: 2, 6: 4 }[hdr?.ct];
+  if (!hdr || hdr.lace || !ch || (hdr.ct === 3 && !plte)) return null;
+  const bits = ch * hdr.depth;
+  const stride = Math.ceil((hdr.w * bits) / 8);
+  const step = Math.max(1, bits >> 3);
+  let raw;
+  try {
+    raw = zlib.inflateSync(Buffer.concat(idat));
+  } catch {
+    return null;
+  }
+  const px = Buffer.alloc(stride * hdr.h);
+  for (let y = 0; y < hdr.h; y++) {
+    const f = raw[y * (stride + 1)];
+    for (let x = 0; x < stride; x++) {
+      const r = raw[y * (stride + 1) + 1 + x];
+      const a = x >= step ? px[y * stride + x - step] : 0;
+      const b = y ? px[(y - 1) * stride + x] : 0;
+      const c = x >= step && y ? px[(y - 1) * stride + x - step] : 0;
+      const pa = Math.abs(b - c);
+      const pb = Math.abs(a - c);
+      const pc = Math.abs(a + b - 2 * c);
+      const pred = [0, a, b, (a + b) >> 1, pa <= pb && pa <= pc ? a : pb <= pc ? b : c][
+        f
+      ];
+      px[y * stride + x] = (r + pred) & 255;
+    }
+  }
+  const sample = (y, k) => {
+    const bit = k * hdr.depth;
+    const byte = px[y * stride + (bit >> 3)];
+    if (hdr.depth >= 8) return byte;
+    return (byte >> (8 - hdr.depth - (bit & 7))) & ((1 << hdr.depth) - 1);
+  };
+  const scale = hdr.depth < 8 && hdr.ct !== 3 ? 255 / ((1 << hdr.depth) - 1) : 1;
+  const rgba = [];
+  const w16 = hdr.depth === 16 ? 2 : 1;
+  for (let y = 0; y < hdr.h; y++)
+    for (let x = 0; x < hdr.w; x++) {
+      const s = (k) => sample(y, x * ch * w16 + k * w16) * scale;
+      if (hdr.ct === 3) {
+        const i = s(0);
+        rgba.push([plte[3 * i], plte[3 * i + 1], plte[3 * i + 2], trns?.[i] ?? 255]);
+      } else if (hdr.ct < 2 || hdr.ct === 4)
+        rgba.push([s(0), s(0), s(0), hdr.ct === 4 ? s(1) : 255]);
+      else rgba.push([s(0), s(1), s(2), hdr.ct === 6 ? s(3) : 255]);
+    }
+  return { w: hdr.w, h: hdr.h, rgba };
+}
+
+/** The PNG held to the analytic raster, every pixel read (pass 10; no one-pixel read survives):
+ *  - `paper`: the max ΔE to the paper over EVERY pixel off the path (support dilated by REACH px) —
+ *    a tint, a box at any coverage, a dot of one pixel, wherever it sits;
+ *  - `ink`: the max ΔE to the ink over EVERY pixel the pen covers whole (coverage 1, eroded by REACH);
+ *  - `meanDelta`, `iou` (binarised at CUTS["e.png-tie"]) and `blob` (the largest 4-connected run with
+ *    |Δcoverage| > CUTS["e.png-blob"]) on the coverage, for the fringe between the two masks. */
+export function tie(img, ras, paper, ink) {
+  const P = paper.rgb.map((v) => v * 255);
+  const I = ink.rgb.map((v) => v * 255);
+  const n = img.w;
+  const [cutT, cutB, R] = [CUTS["e.png-tie"], CUTS["e.png-blob"], CUTS["e.png-reach"]];
+  // near: the pen's support dilated by R; core: its whole-coverage pixels eroded by R (the two masks
+  // a rasteriser's fringe may not reach past)
+  const near = new Uint8Array(img.rgba.length);
+  const core = new Uint8Array(img.rgba.length).fill(1);
+  for (let i = 0; i < near.length; i++)
+    for (let dy = -R; dy <= R; dy++)
+      for (let dx = -R; dx <= R; dx++) {
+        const [x, y] = [(i % n) + dx, Math.floor(i / n) + dy];
+        const j = x >= 0 && y >= 0 && x < n && y < n ? y * n + x : -1;
+        if (ras.cov[i] > 0 && j >= 0) near[j] = 1;
+        if (j < 0 || ras.cov[j] !== 1) core[i] = 0;
+      }
+  const de = (p, c) => deltaE({ rgb: p.slice(0, 3).map((v) => v / 255), a: 1 }, c);
+  const same = (p, Q) =>
+    Math.round(Q[0]) === p[0] && Math.round(Q[1]) === p[1] && Math.round(Q[2]) === p[2];
+  let [sum, inter, union, paperMax, inkMax] = [0, 0, 0, 0, 0];
+  const off = new Uint8Array(img.rgba.length); // |Δcoverage| > cutB: a pixel the path does not explain
+  for (let i = 0; i < img.rgba.length; i++) {
+    const px = img.rgba[i];
+    if (!near[i] && !same(px, P)) paperMax = Math.max(paperMax, de(px, paper));
+    if (core[i] && !same(px, I)) inkMax = Math.max(inkMax, de(px, ink));
+    const a = [0, 1, 2].reduce((s, c) => s + (P[c] - px[c]) / (P[c] - I[c]), 0) / 3;
+    const got = Math.min(1, Math.max(0, a));
+    const want = ras.cov[i];
+    sum += Math.abs(got - want);
+    off[i] = Math.abs(got - want) > cutB ? 1 : 0;
+    if (got >= cutT || want >= cutT) union++;
+    if (got >= cutT && want >= cutT) inter++;
+  }
+  // the largest 4-connected component of unexplained pixels: a mark, not a rasteriser's fringe
+  let blob = 0;
+  for (let i = 0; i < off.length; i++) {
+    if (off[i] !== 1) continue;
+    let size = 0;
+    const stack = [i];
+    off[i] = 2;
+    while (stack.length) {
+      const j = stack.pop();
+      size++;
+      for (const k of [j - n, j + n, j % n ? j - 1 : -1, (j + 1) % n ? j + 1 : -1])
+        if (k >= 0 && k < off.length && off[k] === 1) {
+          off[k] = 2;
+          stack.push(k);
+        }
+    }
+    blob = Math.max(blob, size);
+  }
+  return {
+    meanDelta: sum / img.rgba.length,
+    iou: union ? inter / union : 0,
+    blob,
+    paperMax,
+    inkMax,
+  };
+}
+
+/* ── the audit: one model in, a list of [clause, id, reason] out ─────────────── */
+export function audit(m, arm = { name: ARM, width: WIDTH, d: PEN[ARM] }) {
+  const fails = [];
+  const red = (clause, id, why) => {
+    if (!OFF.has(id)) fails.push([clause, id, why]);
+  };
