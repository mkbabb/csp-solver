+      .replace(/ d="[^"]*"/, ` d="${d}"`)
+      .replace(/stroke-width="[^"]*"/, `stroke-width="${width}"`),
+    arm: { name: ARM, width, d },
+  });
+  const nearPaper = byDE(cube(P, 7), light["--color-background"]);
+  const same = (px, Q) => px.every((v, c) => v === Q[c]);
+  const lone = paperPx.find((i) => i % img0.w === img0.w >> 1);
+  const lum8 = (px) => px[0] + px[1] + px[2];
+  const dark0 = img0.rgba.reduce(
+    (d, px, i) => (lum8(px) < lum8(img0.rgba[d]) ? i : d),
+    0,
+  );
+  const nearInk = byDE(cube(I, 9), light["--color-foreground"]);
+  // [id, side, bound, eps, make(t), [t0 inside, t1 outside], integer?]
