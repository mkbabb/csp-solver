+    if (count(n) !== 1)
+      red("a", "a.count", `${count(n)} <${n}> elements, exactly one wanted`);
+  for (const e of els) {
+    if (!ALLOWED[e.name])
+      red("a", "a.element", `<${e.name}> is not one of svg, style, rect, path`);
