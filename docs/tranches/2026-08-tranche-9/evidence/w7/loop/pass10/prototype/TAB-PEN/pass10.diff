+
+export function readTree(root) {
+  const read = (...p) => {
+    try {
+      return fs.readFileSync(path.join(root, ...p));
+    } catch {
+      return null;
+    }
+  };
+  const html = String(read("index.html") ?? "");
+  const one = exactlyOneLink(html, "icon").links[0]?.href;
+  const href = one?.startsWith("/") ? one.slice(1) : "icon.svg";
+  let provenance;
+  try {
+    provenance = JSON.parse(String(read("scripts", "icons.provenance.json")));
+  } catch {
+    provenance = null;
+  }
+  return {
+    svg: String(read("public", href) ?? ""),
+    html,
+    files: sources(root).map((f) => ({
+      file: path.relative(root, f),
+      text: fs.readFileSync(f, "utf8"),
+    })),
+    png: read("public", "apple-touch-icon.png"),
+    provenance,
+    iconExists: read("public", "icon.svg") !== null,
+    faviconExists: read("public", "favicon.svg") !== null,
+  };
+}
+
+/** The gate's plain run (the self-test, the batteries and the plants live beside it, in
+ *  check-favicon.self-test.mjs and check-favicon.plants.mjs, and import this file). */
+export function run(model = readTree(ROOT)) {
+  const fails = audit(model);
+  console.log(`check-favicon (${ROOT}):`);
+  for (const clause of "abcde") {
+    const mine = fails.filter(([c]) => c === clause);
+    console.log(
+      `  ${clause}  ${mine.length ? "RED" : "GREEN"}${mine.map(([, id, w]) => `\n       ${id}: ${w}`).join("")}`,
+    );
+  }
+  const ras = raster(PEN[ARM], WIDTH);
+  const img = decodePng(model.png);
+  const pt = pageTokens(model.files);
+  if (
+    ras &&
+    img &&
+    pt.tok.light["--color-background"] &&
+    pt.tok.light["--color-foreground"]
+  ) {
+    const fit = tie(
+      img,
+      ras,
+      pt.tok.light["--color-background"],
+      pt.tok.light["--color-foreground"],
+    );
+    console.log(
+      `  readings: arm ${ARM} width ${WIDTH} · mass ${ras.mass.toFixed(4)} · png paper max ΔE ${fit.paperMax.toFixed(3)} ink max ΔE ${fit.inkMax.toFixed(3)} · tie mean |Δ| ${fit.meanDelta.toFixed(4)} IoU ${fit.iou.toFixed(4)} blob ${fit.blob} px · unresolved non-setProperty sites ${pt.unresolved.length - pt.unresolved.filter((u) => /setProperty/.test(u.kind)).length} (printed, not red)`,
+    );
+  }
+  return fails;
+}
+
+if (
+  process.argv[1] &&
+  import.meta.url === pathToFileURL(path.resolve(process.argv[1])).href
+) {
+  const fails = run();
+  if (fails.length) {
+    console.error(`\ncheck-favicon: ${fails.length} failure(s)`);
+    process.exit(1);
+  }
+  console.log(
+    "\ncheck-favicon: the tab's s is one pen line, on the page's paper, in its ink",
+  );
+}
