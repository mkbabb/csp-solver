@@ -0,0 +1,857 @@
+#!/usr/bin/env node
+/**
+ * THE FAVICON GATE (T9-M22, TAB-PEN). The tab's s is one pen line on the page's paper, in the page's
+ * ink. It reads the SHAPE, not the spelling (LAWS P6 §F): the markup against an allowlist, every
+ * `<style>` rule in source order with the last one winning, the page's links and tokens through the
+ * estate's ONE library (`shape-census.mjs`: `htmlLinks`, `tokenSites`, `tokenConflicts`, colours
+ * scored by ΔE), the path rastered analytically, and the touch icon's own pixels. Browserless.
+ *
+ *   a  the markup     exactly one each of svg, style, rect, path, and nothing else: no comment, no
+ *                     entity, no second element, no attribute outside the allowlist (so no filter,
+ *                     clip, rx/ry, transform, opacity, style="", dasharray). viewBox `0 0 32 32`; the
+ *                     rect covers it at 0,0; the rect is painted before the path.
+ *   b  one pen line   the path: fill none, round caps and joins, stroke-width a bare number in
+ *                     [3.6, 5.2] of the 32 viewBox. The `<style>` body holds `rect{fill}` and
+ *                     `path{stroke}` only, at the top level or inside `@media (prefers-color-scheme:
+ *                     dark)`; no other property, selector, at-rule or !important. <= 600 B.
+ *   c  the page's     the painted fill and stroke, resolved per scheme through the cascade (the
+ *      colours        attributes, then every rule in source order), are the page's
+ *                     --color-background / --color-foreground (ΔE <= 0.5, opaque) in light and in
+ *                     dark. The tokens are read at EVERY site the library finds; a site outside
+ *                     `:root`/`@theme` and `.dark` is RED, two placed sites that disagree are RED
+ *                     (never resolved by walk order), and an unresolved `setProperty` is RED. Ink
+ *                     over paper >= 7:1 in each scheme.
+ *   d  the pen        the path and stroke-width are the arm table's (`scripts/icons.mjs`: PEN[ARM],
+ *                     WIDTH), and that table is a PINNED ballot arm (ARM_PIN: each arm's path
+ *                     sha256, widths {4, 5}; a re-cut of the pen is a stated edit here); the exact extrema bbox inflated by half the pen is within [0.55, 0.80]
+ *                     of the tile per axis, centred within 0.5 unit; stroke / (bbox H + stroke) is in
+ *                     WINDOWS[WIDTH] (a tab-size legibility window, 2 px at 16 px, keyed to the pen's
+ *                     width so the owner's arm B needs one const, not a gate edit); the path's ink
+ *                     MASS, rastered analytically at 180 (4 × 4 samples a pixel), is in [0.18, 0.32].
+ *   e  the estate     index.html (comments and inert template/noscript/script/style contents
+ *                     stripped, no <base>) carries EXACTLY ONE rel~=icon, to /icon.svg, and exactly
+ *                     one apple-touch-icon, to /apple-touch-icon.png, each attribute on the library's
+ *                     LINK_ALLOW (no media, no sizes: one link per rel); favicon.svg is gone
+ *                     (the rename busts the favicon store); scripts/icons.provenance.json carries both
+ *                     files' sha256; the PNG decodes to 180 x 180, opaque, its ink coverage in
+ *                     [0.18, 0.32], and it IS the path, every pixel read: each pixel off the pen's
+ *                     support (dilated 1 px) is the light paper (max ΔE <= 1), each pixel the pen
+ *                     covers whole (eroded 1 px) is the light ink (max ΔE <= 1), and between them the
+ *                     coverage against the analytic raster reads mean |Δ| <= 0.02 and IoU >= 0.97,
+ *                     with no 4-connected mark the path does not explain (|Δ| > 0.5) over 16 px.
+ *                     A PNG that isn't the s reds on content, whatever the sidecar says. Its live
+ *                     twin is `e2e/tab-pen.spec.ts`.
+ *
+ * This file is the gate alone. Its self-test, the EDGES, the CUTS and both batteries live in
+ * `check-favicon.self-test.mjs`, and the plant table (the fixture) in `check-favicon.plants.mjs`:
+ * `node scripts/check-favicon.self-test.mjs [--sabotage-battery | --threshold-battery]
+ * [--root <web/frontend>]` (`npm run lint:favicon` runs the gate, then the self-test). Every numeric
+ * bound lives in BOUNDS (or WINDOWS), every cut inside tie() in CUTS, each pinned from outside.
+ * Run: `node scripts/check-favicon.mjs [--root <web/frontend>]`.
+ */
+import { createHash } from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+import process from "node:process";
+import { pathToFileURL } from "node:url";
+import zlib from "node:zlib";
+import { ARM, PEN, WIDTH, WINDOWS } from "./icons.mjs";
+import {
+  cssRules,
+  deltaE,
+  exactlyOneLink,
+  parseColor,
+  resolve,
+  sources,
+  stripCss,
+  tokenConflicts,
+  tokenSites,
+  tokens,
+} from "./shape-census.mjs";
+
+export const argRoot = process.argv.indexOf("--root");
+export const ROOT =
+  argRoot > 0
+    ? path.resolve(process.argv[argRoot + 1])
+    : path.join(import.meta.dirname, "..");
+export const TOKENS = ["--color-background", "--color-foreground"];
+export const sha256 = (b) => createHash("sha256").update(b).digest("hex");
+/** EVERY numeric bound the audit reads, [lo, hi], keyed by its check id (WINDOWS is the arm table's,
+ *  per width). The self-test's EDGES pin each one from outside this table: a plant measured within
+ *  ε past the bound must red, one within ε inside must not, and `--threshold-battery` moves every
+ *  bound by its ε both ways (LAWS P8 §F, threshold sabotage). Moving a bound is an EDGES edit too. */
+export const BOUNDS = {
+  "b.width": [3.6, 5.2],
+  "b.bytes": [-Infinity, 600],
+  "c.tokens": [7, Infinity],
+  "c.delta": [-Infinity, 0.5],
+  "c.fallback": [-Infinity, 0.5],
+  "d.extent": [0.55, 0.8],
+  "d.centre": [-Infinity, 0.5],
+  "d.mass": [0.18, 0.32],
+  "e.png-paper": [-Infinity, 1],
+  "e.png-coverage": [0.18, 0.32],
+  "e.png-ink": [-Infinity, 1],
+  "e.png-delta": [-Infinity, 0.02],
+  "e.png-tie": [0.97, Infinity],
+  "e.png-blob": [-Infinity, 16],
+};
+export const inside = (id, v, [lo, hi] = BOUNDS[id]) => v >= lo && v <= hi;
+/** The cuts inside tie(), each a bound on a PIXEL, not on a reading: the IoU's binarisation level, the
+ *  blob's |Δcoverage| cut, and the off-path mask's reach (px). Each is pinned by a CUT row (a plant at
+ *  cut ± ε, the gate's own read) and moved by `--threshold-battery` like a bound (LAWS P8 §F). */
+export const CUTS = { "e.png-tie": 0.5, "e.png-blob": 0.5, "e.png-reach": 1 };
+/** The arm table PINNED (T9-B27/B28): each ballot arm's path by sha256, and the width set. A table
+ *  edit that is not one of these reds d.pin; re-cutting the pen is a stated edit of THIS table. */
+export const ARM_PIN = {
+  W: "fce8f710b97b45f7f3667ad56d74486055b7ac6fb60482482fc73dd36e6449e9",
+  H: "e2ed86c88fcd132d8121d014806f90defccf2678388a533572c29fe1111e691f",
+  widths: [4, 5],
+};
+export const OFF = new Set(); // the gate's own sabotage switch (check ids)
+
+/* ── colour ─────────────────────────────────────────────────────────────────── */
+export const lum = ({ rgb }) =>
+  rgb
+    .map((v) => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4))
+    .reduce((s, v, i) => s + v * [0.2126, 0.7152, 0.0722][i], 0);
+export const contrast = (a, b) => {
+  const [hi, lo] = [lum(a), lum(b)].sort((p, q) => q - p);
+  return (hi + 0.05) / (lo + 0.05);
+};
+export const opaque = (c) => c && (c.a ?? 1) >= 0.999;
+
+/** The page's two tokens through the ONE library, placed light (`:root`, which `@theme` reads as) /
+ *  dark (`.dark`) / unplaced, with the library's conflicts. The library reads each file once (cached
+ *  on its path and text; a plant that adds a file pays for that file alone); memoised per list. */
+export const siteCache = new WeakMap();
+export const fileCache = new Map();
+export function fileTokens({ file, text }) {
+  const key = `${file}\u0000${text}`;
+  if (!fileCache.has(key)) {
+    const abs = path.join(ROOT, file);
+    const io = {
+      files: [abs],
+      read: (p) => (p === abs ? text : fs.readFileSync(p, "utf8")),
+      exists: (p) => p === abs || fs.existsSync(p),
+    };
+    const mine = (x) => x.file === file; // an @import's target is read at its own entry
+    fileCache.set(key, {
+      sites: TOKENS.flatMap((prop) =>
+        tokenSites(ROOT, prop, io)
+          .filter(mine)
+          .map((x) => ({ ...x, prop })),
+      ),
+      decls: tokens(ROOT, io).all.filter(mine),
+    });
+  }
+  return fileCache.get(key);
+}
+export function pageTokens(files) {
+  if (siteCache.has(files)) return siteCache.get(files);
+  const per = files.map(fileTokens);
+  const sites = per.flatMap((f) => f.sites);
+  const map = new Map(per.flatMap((f) => f.decls.map((x) => [x.prop, x.value])));
+  const placed = sites.filter((s) => !s.unresolved);
+  const home = (s) =>
+    s.ctx || s.important
+      ? null
+      : s.prelude.replace(/\s+/g, "") === ":root"
+        ? "light"
+        : s.prelude.replace(/\s+/g, "") === ".dark"
+          ? "dark"
+          : null;
+  const tok = { light: {}, dark: {} };
+  for (const s of placed)
+    if (home(s)) tok[home(s)][s.prop] = parseColor(resolve(s.value, map));
+  const conflicts = tokenConflicts(placed);
+  // A token whose placed sites disagree has no value this gate can know (the build's order decides):
+  // it resolves to nothing, in whichever order the walk met the sites.
+  for (const c of conflicts) if (home(c.sites[0])) tok[home(c.sites[0])][c.name] = null;
+  const out = {
+    tok,
+    unplaced: placed.filter((s) => !home(s)),
+    unresolved: sites.filter((s) => s.unresolved),
+    conflicts,
+  };
+  siteCache.set(files, out);
+  return out;
+}
