+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { test, expect, type Page } from "@playwright/test";
+
+// PRM: live, because the twin reads the icon links, their image loads and their bytes at three
+// instants (hydrated, a late tick, after the theme toggle); no frame or moving surface is measured.
+
+/**
+ * THE TAB'S PEN, AS THE BROWSER SEES IT — the behavioural twin of `lint:favicon` clause e (T9-W7
+ * §12 row 2; LAWS P7 §F iii). The gate reads `index.html` as text; this reads the BUILT page under
+ * production's own CSP (public/_headers' `/*` policy, put on the document by the twin itself): the
+ * live `link[rel~=icon]` and `apple-touch-icon` nodes, `matchMedia(link.media)` in the scheme under
+ * test, the resolved URL's origin and path, any `<base>`, every attribute write to the links from
+ * document start, each icon LOADED AS AN IMAGE (`new Image()`, which CSP governs by img-src, as the
+ * UA's own icon load is), and the bytes the page fetches (content type and sha256 against the
+ * sidecar). It reads THREE times: after hydration, after a late tick (2 s after load), and after
+ * the in-app theme toggle is pressed. Run it against a served dist (`PLAYWRIGHT_BASE_URL`).
+ *
+ * Every clause has an in-run plant that reds it ALONE (rewritten HTML or CSP, or a re-routed
+ * response, never a file on disk), and the negative-negatives must stay GREEN. The sabotage battery
+ * is pure: each clause is switched off over the SAME readings and its sole plant must turn GREEN.
+ */
+
+const file = (p: string) => readFileSync(fileURLToPath(new URL(p, import.meta.url)), "utf8");
+const SIDECAR = JSON.parse(file("../scripts/icons.provenance.json")) as Record<string, string>;
+/** public/_headers' `/*` block (CF Pages' format), its Content-Security-Policy: the one production serves. */
+const CSP = (() => {
+  let on = false;
+  for (const line of file("../public/_headers").split("\n")) {
+    if (/^[^\s#]/.test(line)) on = line.trim() === "/*";
+    const m = on && /^\s+content-security-policy:\s*(.*)$/i.exec(line);
+    if (m) return m[1].trim();
+  }
+  return "";
+})();
+
+const WANT = {
+  icon: { path: "/icon.svg", type: "image/svg+xml", sha: SIDECAR["icon.svg"] },
+  "apple-touch-icon": {
+    path: "/apple-touch-icon.png",
+    type: "image/png",
+    sha: SIDECAR["apple-touch-icon.png"],
+  },
+} as const;
+type Rel = keyof typeof WANT;
+const RELS = Object.keys(WANT) as Rel[];
+/** The attributes a live link may carry; `type` is held to the rel's own, `media` is evaluated. */
+const ALLOW = ["rel", "href", "type", "media"];
+const TOGGLE = 'button[aria-label^="Switch to"]';
+type Instant = "hydrated" | "late" | "toggled";
+
+const CLAUSES = [
+  "count",
+  "allow",
+  "media",
+  "type",
+  "origin",
+  "path",
+  "base",
+  "img",
+  "ctype",
+  "sha",
+  "mutation",
+] as const;
+type Clause = (typeof CLAUSES)[number];
+
+interface LinkRead {
+  attrs: [string, string][];
+  href: string;
+  media: boolean; // matchMedia(link.media) in the scheme under test (true when no media)
+  img: string; // the icon loaded as an image under the page's CSP: load | error | empty | timeout
+  status: number;
+  ctype: string;
+  sha: string;
+}
+interface Reading {
+  at: Instant;
+  pressed: boolean; // the toggle was found and pressed (the toggled instant only)
+  origin: string;
+  base: boolean;
+  links: Record<Rel, LinkRead[]>;
+  mutations: string[];
+}
+
+/** An init script, so it runs at document start, before the parser and every module script: each
+ *  attribute write to a rel~=icon / apple-touch-icon link, and each such link added or removed once
+ *  parsing is done (the parser's own insertions land while readyState is "loading": not writes). */
+const WATCH = () => {
+  const w = window as unknown as { __tabWrites: string[] };
+  w.__tabWrites = [];
+  const watched = (n: Node) =>
+    n instanceof HTMLLinkElement &&
+    /(^|\s)(icon|apple-touch-icon)(\s|$)/i.test(n.getAttribute("rel") ?? "");
+  new MutationObserver((list) => {
+    for (const r of list) {
+      if (r.type === "attributes" && watched(r.target))
+        w.__tabWrites.push(
+          `${r.attributeName}=${(r.target as Element).getAttribute(r.attributeName ?? "")}`,
+        );
+      else if (r.type === "childList" && document.readyState !== "loading")
+        for (const n of [...r.addedNodes, ...r.removedNodes])
+          if (watched(n)) w.__tabWrites.push(`node ${(n as Element).outerHTML}`);
+    }
+  }).observe(document, { subtree: true, childList: true, attributes: true });
+};
+
+/** One instant's reading of the page as its own scripts left it: links, image loads, base, writes, bytes. */
+const snapshot = (page: Page, at: Instant, pressed: boolean): Promise<Reading> =>
+  page.evaluate(
+    async ([rels, at, pressed]) => {
+      const hex = (b: ArrayBuffer) =>
+        [...new Uint8Array(b)].map((x) => x.toString(16).padStart(2, "0")).join("");
+      const asImage = (src: string) =>
+        new Promise<string>((done) => {
+          const im = new Image();
+          const t = setTimeout(() => done("timeout"), 5_000);
+          im.onload = () => (clearTimeout(t), done(im.naturalWidth > 0 ? "load" : "empty"));
+          im.onerror = () => (clearTimeout(t), done("error"));
+          im.src = src;
+        });
+      const links = {} as Record<string, LinkRead[]>;
+      for (const rel of rels) {
+        links[rel] = [];
+        const nodes = [...document.querySelectorAll("link")].filter((l) =>
+          (l.getAttribute("rel") ?? "").toLowerCase().split(/\s+/).includes(rel),
+        );
+        for (const l of nodes) {
+          const got: LinkRead = {
+            attrs: [...l.attributes].map((a) => [a.name.toLowerCase(), a.value]),
+            href: l.href,
+            media: !l.media || matchMedia(l.media).matches,
+            img: await asImage(l.href),
+            status: 0,
+            ctype: "",
+            sha: "",
+          };
+          try {
+            const r = await fetch(l.href, { cache: "no-store" });
+            got.status = r.status;
+            got.ctype = r.headers.get("content-type") ?? "";
+            got.sha = hex(await crypto.subtle.digest("SHA-256", await r.arrayBuffer()));
+          } catch {
+            got.status = -1;
+          }
+          links[rel].push(got);
+        }
+      }
+      return {
+        at,
+        pressed,
+        origin: location.origin,
+        base: document.querySelector("base") !== null,
+        links,
+        mutations: [...((window as unknown as { __tabWrites?: string[] }).__tabWrites ?? [])],
+      } as Reading;
+    },
+    [RELS, at, pressed] as const,
+  );
+
+/** The page read at its three instants: hydrated (+400 ms), late (2 s after load), toggled (+400 ms). */
+async function read(page: Page, url: string, scheme: "light" | "dark"): Promise<Reading[]> {
+  await page.emulateMedia({ colorScheme: scheme });
+  await page.addInitScript(WATCH);
+  await page.goto(url, { waitUntil: "load" });
+  const loaded = Date.now();
+  // hydration; a plant that re-points the bundle too (E6's foreign <base>) never mounts, and is read as served
+  await page
+    .waitForFunction(() => (document.querySelector("#app")?.childElementCount ?? 0) > 0, null, {
+      timeout: 15_000,
+    })
+    .catch(() => undefined);
+  await page.waitForTimeout(400);
+  const out = [await snapshot(page, "hydrated", false)];
+  await page.waitForTimeout(Math.max(0, 2_000 - (Date.now() - loaded)));
+  out.push(await snapshot(page, "late", false));
+  const toggle = page.locator(TOGGLE).first();
+  const pressed = (await toggle.count()) > 0;
+  if (pressed) await toggle.click({ timeout: 5_000 }).catch(() => undefined);
+  await page.waitForTimeout(400);
+  out.push(await snapshot(page, "toggled", pressed));
+  return out;
+}
+
+/** The clauses one instant reds, each with its reason; `off` switches clauses off (the battery). */
+function judgeOne(r: Reading, off: ReadonlySet<Clause>): [Clause, string][] {
+  const out: [Clause, string][] = [];
+  const red = (c: Clause, why: string) => {
+    if (!off.has(c)) out.push([c, `${r.at}: ${why}`]);
+  };
+  if (r.base) red("base", "a live <base> element re-points every relative href");
+  if (r.mutations.length) red("mutation", `written after parse: ${r.mutations.join(" | ")}`);
+  for (const rel of RELS) {
+    const want = WANT[rel];
+    const links = r.links[rel] ?? [];
+    if (links.length !== 1) red("count", `${links.length} live ${rel} links`);
+    for (const l of links) {
+      for (const [k, v] of l.attrs)
+        if (!ALLOW.includes(k)) red("allow", `${rel}: ${k}="${v}" off the allowlist`);
+      const type = l.attrs.find(([k]) => k === "type")?.[1];
+      if (type !== undefined && type.trim().toLowerCase() !== want.type)
+        red("type", `${rel}: type="${type}", not ${want.type}`);
+      if (!l.media) red("media", `${rel}: its media query is false in this scheme`);
+      const u = new URL(l.href);
+      if (u.origin !== r.origin) red("origin", `${rel}: resolves to ${u.origin}`);
+      if (u.pathname + u.search + u.hash !== want.path)
+        red("path", `${rel}: resolves to ${u.pathname}${u.search}${u.hash}`);
+      if (l.img !== "load") red("img", `${rel}: as an image under the page's CSP: ${l.img}`);
+      if (l.status !== 200 || !l.ctype.toLowerCase().startsWith(want.type))
+        red("ctype", `${rel}: fetched ${l.status} ${l.ctype}`);
+      if (l.sha !== want.sha) red("sha", `${rel}: sha256 ${l.sha.slice(0, 12)}, not the sidecar's`);
+    }
+  }
+  return out;
+}
+const judge = (rs: Reading[], off: ReadonlySet<Clause> = new Set()) =>
+  rs.flatMap((r) => judgeOne(r, off));
+
+interface Plant {
+  name: string;
+  /** the clauses it must red: `exact` reds these and no other; otherwise at least these */
+  want: Clause[];
+  exact: boolean;
+  scheme?: "light" | "dark";
+  html?: (h: string) => string;
+  csp?: (c: string) => string;
+  setup?: (page: Page, origin: string) => Promise<void>;
+}
+const LINKS = /(<link rel="icon"[^>]*>\s*<link rel="apple-touch-icon"[^>]*>)/;
+const tag = (t: string) => [`<${t}>`, `</${t}>`];
+/** Serve `at` (glob or URL) with a content type and the icon's bytes (or `body`'s, or edited ones). */
+const serve =
+  (at: string, ctype: string, edit: (svg: string) => string = (x) => x, from = "/icon.svg") =>
+  async (page: Page, origin: string) => {
+    const real = await page.request.get(`${origin}${from}`);
+    const body = from.endsWith(".svg") ? edit(await real.text()) : await real.body();
+    void (await page.route(at, (route) =>
+      route.fulfill({
+        status: 200,
+        body,
+        headers: { "content-type": ctype, "access-control-allow-origin": "*" },
+      }),
+    ));
+  };
+/** The page's own script writes the icon link: after `load` + `ms`, or when the theme toggle is pressed. */
+const repoint = (to: string, back: boolean, ms = 0, onToggle = false) => async (page: Page) => {
+  await page.addInitScript(
+    ([to, back, ms, onToggle, sel]) => {
+      const go = () => {
+        const l = document.querySelector<HTMLLinkElement>('link[rel~="icon"]');
+        if (!l) return;
+        const was = l.getAttribute("href") ?? "";
+        l.setAttribute("href", to);
+        if (back) setTimeout(() => l.setAttribute("href", was), 50);
+      };
+      if (onToggle)
+        addEventListener("click", (e) => (e.target as Element)?.closest?.(sel) && setTimeout(go), true);
+      else addEventListener("load", () => setTimeout(go, ms));
+    },
+    [to, back, ms, onToggle, TOGGLE] as const,
+  );
+};
+const thick = (svg: string) => svg.replace(/stroke-width="[^"]*"/, 'stroke-width="6"');
+/** E7's species at a given moment: the thick SVG served, the icon re-pointed at it. */
+const thickWhen = (ms: number, onToggle = false) => async (page: Page, origin: string) => {
+  await serve("**/tab-pen-thick.svg", "image/svg+xml", thick)(page, origin);
+  await repoint("/tab-pen-thick.svg", false, ms, onToggle)(page);
+};
+/** P-origin's policy: production's, with example.com let in for images and fetches (so only origin reds). */
+const withOrigin = (c: string) =>
+  c.replace(/img-src([^;]*)/, "img-src$1 https://example.com").replace(/connect-src([^;]*)/, "connect-src$1 https://example.com");
+
+const PLANTS: Plant[] = [
+  { name: "E1 the icon link scoped to dark, read light", want: ["media"], exact: true, html: (h) => h.replace('<link rel="icon"', '<link rel="icon" media="(prefers-color-scheme: dark)"') },
+  { name: "E2 the icon link typed text/plain", want: ["type"], exact: true, html: (h) => h.replace('type="image/svg+xml"', 'type="text/plain"') },
+  { name: "E3 both links inside a template", want: ["count"], exact: true, html: (h) => h.replace(LINKS, (k) => tag("template").join(k)) },
+  { name: "E4 both links inside a noscript", want: ["count"], exact: true, html: (h) => h.replace(LINKS, (k) => tag("noscript").join(k)) },
+  { name: "E5 both links kept only as a script string", want: ["count"], exact: true, html: (h) => h.replace(LINKS, (k) => tag("script").join(`window.__x = ${JSON.stringify(k)};`)) },
+  { name: "E6 a base href to a foreign origin", want: ["base", "origin"], exact: false, html: (h) => h.replace("<title>", '<base href="https://example.com/" /><title>') },
+  { name: "E7 a script re-points the icon after load", want: ["mutation", "path", "sha"], exact: false, setup: thickWhen(0) },
+  { name: "X1 production's CSP with img-src 'none' (fetch still 200)", want: ["img"], exact: true, csp: (c) => c.replace(/img-src[^;]*/, "img-src 'none'") },
+  { name: "X2 the icon re-pointed 1,500 ms after load", want: ["mutation", "path", "sha"], exact: false, setup: thickWhen(1_500) },
+  { name: "X3 the icon re-pointed when the theme toggle is pressed", want: ["mutation", "path", "sha"], exact: false, setup: thickWhen(0, true) },
+  { name: "X4 a module script re-points the icon as it evaluates", want: ["mutation", "path"], exact: false, html: (h) => h.replace("</head>", '<script type="module" src="/tab-pen-write.js"></script></head>'), setup: async (page) => void (await page.route("**/tab-pen-write.js", (route) => route.fulfill({ status: 200, body: 'document.querySelector(\'link[rel~="icon"]\')?.setAttribute("href", "/icon.svg?module");', headers: { "content-type": "text/javascript" } }))) },
+  { name: "P-base a same-origin base (resolution unchanged)", want: ["base"], exact: true, html: (h) => h.replace("<title>", '<base href="/" /><title>') },
+  { name: "P-allow a sizes ladder on the touch icon", want: ["allow"], exact: true, html: (h) => h.replace('rel="apple-touch-icon"', 'rel="apple-touch-icon" sizes="180x180"') },
+  { name: "P-origin the icon's bytes served off-origin, the policy letting them in", want: ["origin"], exact: true, csp: withOrigin, html: (h) => h.replace('href="/icon.svg"', 'href="https://example.com/icon.svg"'), setup: serve("https://example.com/icon.svg", "image/svg+xml") },
+  { name: "P-path the icon's bytes at another path", want: ["path"], exact: true, html: (h) => h.replace('href="/icon.svg"', 'href="/tab-pen-copy.svg"'), setup: serve("**/tab-pen-copy.svg", "image/svg+xml") },
+  { name: "P-ctype the touch icon served as application/octet-stream (an image sniffs, a type does not)", want: ["ctype"], exact: true, setup: serve("**/apple-touch-icon.png", "application/octet-stream", undefined, "/apple-touch-icon.png") },
+  { name: "P-ctype-svg the icon served as text/plain", want: ["ctype"], exact: false, setup: serve("**/icon.svg", "text/plain") },
+  { name: "P-sha the icon served with other bytes", want: ["sha"], exact: true, setup: serve("**/icon.svg", "image/svg+xml", thick) },
+  { name: "P-mutation a re-point undone 50 ms later", want: ["mutation"], exact: true, setup: async (page) => repoint("/icon.svg?x", true)(page) },
+  { name: "NN1 the links' attributes reordered", want: [], exact: true, html: (h) => h.replace('<link rel="icon" type="image/svg+xml" href="/icon.svg" />', '<link href="/icon.svg" type="image/svg+xml" rel="icon">') },
+  { name: "NN2 media=all on the icon (true in both schemes)", want: [], exact: true, html: (h) => h.replace('<link rel="icon"', '<link rel="icon" media="all"') },
+  { name: "NN3 E1 read dark (its query holds)", want: [], exact: true, scheme: "dark", html: (h) => h.replace('<link rel="icon"', '<link rel="icon" media="(prefers-color-scheme: dark)"') },
+];
+
+test("the tab's pen as the built page serves it: clean, plants, battery", async ({ browser, baseURL }) => {
+  test.setTimeout(900_000);
+  const origin = new URL(baseURL ?? "http://127.0.0.1").origin;
+  const unapplied = new Set<string>();
+  const once = async (p: Partial<Plant>, scheme: "light" | "dark") => {
+    const ctx = await browser.newContext();
+    try {
+      const page = await ctx.newPage();
+      // the document always carries production's CSP; a plant may rewrite its HTML or its policy
+      await page.route(
+        (u) => u.origin === origin && u.pathname === "/",
+        async (route) => {
+          const res = await route.fetch();
+          const was = await res.text();
+          const body = p.html ? p.html(was) : was;
+          const csp = p.csp ? p.csp(CSP) : CSP;
+          // a plant that changes nothing proves nothing
+          if ((p.html && body === was) || (p.csp && csp === CSP)) unapplied.add(p.name ?? "");
+          await route.fulfill({
+            response: res,
+            body,
+            headers: { ...res.headers(), "content-security-policy": csp },
+          });
+        },
+      );
+      await p.setup?.(page, origin);
+      return await read(page, `${origin}/`, scheme);
+    } finally {
+      await ctx.close();
+    }
+  };
+  const rows: string[] = [];
+  let ok = !!CSP;
+  if (!CSP) rows.push("  FAILED  no Content-Security-Policy read from public/_headers' /* block");
+  for (const scheme of ["light", "dark"] as const) {
+    const rs = await once({}, scheme);
+    for (const r of rs) {
+      const got = judge([r]);
+      const unpressed = r.at === "toggled" && !r.pressed;
+      rows.push(
+        `  ${got.length || unpressed ? "RED  " : "GREEN"}  clean ${scheme} ${r.at}${unpressed ? " (the theme toggle was not found)" : ""}${got.map(([c, w]) => `\n         ${c}: ${w}`).join("")}`,
+      );
+      if (got.length || unpressed) ok = false;
+    }
+  }
+  const readings = new Map<Plant, Reading[]>();
+  for (const p of PLANTS) readings.set(p, await once(p, p.scheme ?? "light"));
+  for (const p of PLANTS) {
+    const fired = [...new Set(judge(readings.get(p)!).map(([c]) => c))].sort();
+    const when = [...new Set(judge(readings.get(p)!).map(([, w]) => w.split(":")[0]))].join(" ");
+    const want = [...p.want].sort();
+    const good = unapplied.has(p.name)
+      ? false
+      : p.exact
+        ? fired.join() === want.join()
+        : want.every((c) => fired.includes(c));
+    rows.push(
+      `  ${good ? "AS REQUIRED" : "FAILED     "}  ${p.name}: ${unapplied.has(p.name) ? "the plant changed nothing" : `red [${fired.join(" ")}]${when ? ` at ${when}` : ""}`}, want ${p.exact ? "" : ">= "}[${want.join(" ")}]`,
+    );
+    if (!good) ok = false;
+  }
+  // the battery: each clause off over the same readings; its sole plants must then read GREEN
+  for (const c of CLAUSES) {
+    const sole = PLANTS.filter((p) => p.exact && p.want.length === 1 && p.want[0] === c);
+    const bite =
+      sole.length > 0 && sole.every((p) => judge(readings.get(p)!, new Set([c])).length === 0);
+    rows.push(`  ${bite ? "BITE" : "HOLE"}  ${c} off: ${sole.map((p) => p.name.split(" ")[0]).join(" ") || "no sole plant"}`);
+    if (!bite) ok = false;
+  }
+  console.log(`tab-pen (${origin}, ${test.info().project.name}):\n${rows.join("\n")}`);
+  expect(ok, rows.join("\n")).toBe(true);
+});
