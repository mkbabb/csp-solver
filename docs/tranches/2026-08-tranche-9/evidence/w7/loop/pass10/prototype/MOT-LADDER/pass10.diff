+          "the dusk verb's curve moves (`ease-in`) and the crossing is not re-derived",
+          () =>
+            gHinge(
+              src0.replace(/(\bdusk:\s*\{\s*ease:\s*")[^"]+"/, '$1ease-in"'),
+              css0,
+              lad.rungs,
+            ),
+        ],
+        [
+          "G-HINGE",
+          "the sheet arm's light rule is deleted (the arm has no instant going light)",
+          () =>
+            gHinge(
+              src0,
+              css0.replace(
