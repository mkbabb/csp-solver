+      rows.push(`${T} ${c.subject} BORN-RED ${label} (${clause}) ${fmt(r)}${label.startsWith("DASHED") ? ` ← STATION-8 reads ${r.station8}` : ""}`);
+    }
+    // DRAWN (the chair, pass-9 ruling 7): the roster's floor at the authored 1.5 → 1.35, its bound
+    // read at ±ε (1.40 GREEN by 0.05, 1.30 RED by 0.05), the 1 px and the 0.55× (0.825 px) plants,
+    // the law's 1.80 on the same frame off the roster, and the pin (a source authoring 1.4)
+    const SRC = (w) => `<HandDrawnOutline\n  class="head-sheet-frame"\n  :stroke-width="${w}"\n/>`;
+    for (const [label, c, want, clause] of [
+      ["drawn 1.5 px at its authored floor", { subject: "#f-drawn", edge: ".f-drawn-edge", drawn: "head-sheet", drawnSource: SRC(1.5) }, "GREEN"],
+      ["drawn 1.5 px OFF the roster (the law's 1.80)", { subject: "#f-drawn", edge: ".f-drawn-edge" }, "RED", "B3"],
+      ["drawn 1.40 px (bound + ε)", { subject: "#f-d14", edge: ".f-d14-edge", drawn: "head-sheet", drawnSource: SRC(1.5) }, "GREEN"],
+      ["drawn 1.30 px (bound − ε)", { subject: "#f-d13", edge: ".f-d13-edge", drawn: "head-sheet", drawnSource: SRC(1.5) }, "RED", "B3"],
+      ["drawn 1 px", { subject: "#f-thin", edge: ".f-thin-edge", drawn: "head-sheet", drawnSource: SRC(1.5) }, "RED", "B3"],
+      ["drawn 0.55× (0.825 px)", { subject: "#f-d055", edge: ".f-d055-edge", drawn: "head-sheet", drawnSource: SRC(1.5) }, "RED", "B3"],
+      ["drawn PIN: the source authors 1.4", { subject: "#f-drawn", edge: ".f-drawn-edge", drawn: "head-sheet", drawnSource: SRC(1.4) }, "RED", "drawn"],
+    ]) {
+      const r = await fourBands(page, c);
+      const d = Object.values(r.bands ?? {}).map((b) => b.thickness);
+      const margin = d.length ? (Math.min(...d) - (c.drawn ? 1.5 : 2) * 0.9).toFixed(3) : "n/a";
+      const ok = want === "GREEN" ? !r.red : r.red && r.why.some((w) => w.startsWith(clause));
+      if (!ok && want === "GREEN") cleanRed = true;
+      if (!ok && want !== "GREEN") hole = true;
+      rows.push(`${T} ${c.subject} DRAWN ${label} want ${want}${clause ? " (" + clause + ")" : ""} · min depth ${Math.min(...d)} margin ${margin} ${fmt(r)}${ok ? "" : " ← WRONG"}`);
+    }
+    // the typed floor beside the roster is refused (a lane-chosen parameter)
+    const refused = await fourBands(page, { subject: "#f-drawn", edge: ".f-drawn-edge", drawn: "head-sheet", drawnSource: SRC(1.5), thick: 1.5 }).then(() => false, () => true);
+    if (!refused) hole = true;
+    rows.push(`${T} #f-drawn DRAWN a typed thick beside the roster → ${refused ? "REFUSED" : "ACCEPTED ← a hole"}`);
+    // pass10/CHAIR-RULINGS §10 (thickTol REFUSED): the critic's born-RED `{ drawn, thickTol: 0.5 }` floored the
+    // 1.5 px frame at 0.75 and a 1 px frame cleared it; the pair is refused like a typed thick
+    const refusedTol = await fourBands(page, { subject: "#f-thin", edge: ".f-thin-edge", drawn: "head-sheet", drawnSource: SRC(1.5), thickTol: 0.5 }).then(() => false, () => true);
+    if (!refusedTol) hole = true;
+    rows.push(`${T} #f-thin DRAWN a typed thickTol 0.5 beside the roster → ${refusedTol ? "REFUSED" : "ACCEPTED ← a hole (the 1 px frame clears 0.75)"}`);
+    // the LEGACY FADE15 (the edge root's `stroke` only): the path's own stroke attribute keeps its ink
+    const legacy = await fourBands(page, { subject: "#f-frame", edge: ".f-frame-edge" }).then(async () => {
+      const t = await page.addStyleTag({ content: `.f-frame-edge { color: color-mix(in srgb, currentColor 15%, transparent) !important; stroke: color-mix(in srgb, currentColor 15%, transparent) !important; }` });
