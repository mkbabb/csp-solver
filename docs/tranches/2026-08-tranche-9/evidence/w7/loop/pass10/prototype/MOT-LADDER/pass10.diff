+/** Frames with the animation present, keyed on `kPaint` (reads before it DROPPED); F1 + CI verdicts. */
+export function analyse(frames, rest, { kPaint = -1, tolPx = 3, tolMs = 2, ks = [2, 3], ctTol = 4, inRAF = null, writes = null } = {}) {
+  // STALE (the chair, pass 9): a post read whose timeline moved past its frame's is the NEXT frame's
+  // read; frame k's own pre-update read (inRAF) stands in for it, marked, never silently kept
+  let stale = 0,
+    seeks = 0;
+  const byK = new Map((inRAF ?? []).map((x) => [x.k, x]));
+  const fixed = frames.map((x) => {
+    if (!ppOn("stale") || x.tlNow == null || x.tlNow === x.tl || x.ct === null) return x;
+    stale++;
+    const s = byK.get(x.k);
+    // STALE-REBASE (MOT-VERB pass 9, PROPOSED): the in-rAF twin is read BEFORE the frame's later rAF
+    // callbacks, so a mover held paused and started by a write in a rAF registered after the sampler's
+    // (the fold's holdFirstFrame) reads ct 0 there whatever the write was: WebKit's frame-1 post read
+    // is stale on every fold, and PLANT skip painted frame 1 at ct 150 GREEN. A RUNNING stale read
+    // carries the frame's own clock back: ct − (tlNow − tl) × rate. Position stays the twin's.
+    // homes v3 (seek-guard): a clock write between frame k's in-rAF read and this post read, other than
+    // the frame's own start (inside a rAF of frame k), is a SEEK; the rebase would infer a clock the
+    // frame never painted, so the read is UNREAD (ct null), never rebased to a green
+    const lo = s?.wn ?? 0,
+      hi = x.wn ?? lo;
+    const seeked =
+      ppOn("seek-guard") && (writes ?? []).some((wr) => wr.n >= lo && wr.n < hi && !(wr.inRaf && wr.k === x.k));
+    if (seeked && x.ps === "running" && ppOn("stale-rebase")) {
+      seeks++;
+      return { ...x, ct: null, stale: true, seek: true };
+    }
+    const back = ppOn("stale-rebase") && x.ps === "running" ? x.ct - (x.tlNow - x.tl) * (x.pr ?? 1) : null;
+    if (s) return back === null ? { ...s, stale: true } : { ...s, ct: back, stale: true, rebased: true };
+    return back === null ? { ...x, ct: null } : { ...x, ct: back, stale: true, rebased: true };
+  });
+  const all = fixed.filter((x) => x.ct !== null).sort((a, b) => a.k - b.k);
+  const f = kPaint >= 0 ? all.filter((x) => x.k >= kPaint) : all;
+  const dropped = all.length - f.length;
+  if (!f.length) return { red: true, f1red: true, ciRed: false, why: ["EMPTY: the subject never animated"], f1: null, ci: [], dropped };
+  const c = (s) => Math.hypot(s.x - rest.x, s.y - rest.y),
+    dw = (s) => s.w - rest.w;
+  const why = [];
+  const f1pos = ppOn("F1") && (c(f[0]) > tolPx || Math.abs(dw(f[0])) > tolPx);
+  // F1ct (LAWS P8 §D, the frame-1 clause): frame 1 paints at ct ≤ ctTol (4 ms, a quarter frame at
+  // 60 Hz). A 3 px position tolerance alone passes WebKit's 11–33 ms started clock on an eased foot
+  const f1ct = ppOn("F1ct") && Math.abs(f[0].ct) > ctTol;
+  const f1red = f1pos || f1ct;
+  if (f1pos) why.push(`F1 frame 1 at ct ${f[0].ct.toFixed(1)}: centre ${c(f[0]).toFixed(2)} px, dw ${dw(f[0]).toFixed(2)} px (> ${tolPx})`);
+  if (f1ct) why.push(`F1ct frame 1 at ct ${f[0].ct.toFixed(1)} ms (> ${ctTol})`);
+  const ci = [];
+  let ciRed = false;
+  for (const k of ks) {
+    const fk = f[k - 1];
+    if (!fk) {
+      why.push(`CI frame ${k} missing`);
+      ciRed = true;
+      continue;
+    }
+    const want = fk.tl - f[0].tl;
+    const off = fk.ct - want; // the law: ct(frame k) = tl(k) − tl(frame 1), frame 1 at ct 0
+    ci.push({ k, ct: +fk.ct.toFixed(1), tlDelta: +want.toFixed(1), off: +off.toFixed(1) });
+    if (ppOn("CI") && Math.abs(off) > tolMs) {
+      why.push(`CI ct(frame ${k}) ${fk.ct.toFixed(1)} vs tl(${k})−tl(1) ${want.toFixed(1)} (off ${off.toFixed(1)} ms > ${tolMs})`);
+      ciRed = true;
+    }
+  }
+  return { red: why.length > 0, f1red, f1pos, f1ct, ciRed, why, f1: { k: f[0].k, ct: +f[0].ct.toFixed(1), c: +c(f[0]).toFixed(2), dw: +dw(f[0]).toFixed(2), ps: f[0].ps, stale: !!f[0].stale }, ci, frames: f.length, dropped, stale, seeks };
+}
