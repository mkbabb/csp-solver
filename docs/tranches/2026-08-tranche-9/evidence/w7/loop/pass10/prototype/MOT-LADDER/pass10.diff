+export async function applyEdgePlant(page, edge, plant) {
+  // homes v3 (MRK-LIVE §9.12): a plant that computes NO css (a `{ fade }` on an edge matching nothing)
+  // is a no-op with a no-op undo — B0 carries that red; `addStyleTag` is never handed an empty sheet
