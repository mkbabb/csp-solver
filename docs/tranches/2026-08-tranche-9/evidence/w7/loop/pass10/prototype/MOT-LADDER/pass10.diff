@@ -0,0 +1,180 @@
+import { test, expect } from '@playwright/test';
+import { loadavg } from 'node:os';
+import { encodeSudoku } from './wire';
+import { readMover, SKIP_PLANT, F2_PLANT, fmtArm, type Mover } from './lib/postpaint.mjs';
+
+// PRM: live, because the subject is the fold's motion: under reduce both verbs are a same-frame
+// cut and there is no first frame to read.
+
+/**
+ * T9-M19 · THE FOLD'S FIRST PAINTED FRAME IS ITS FIRST POSE (GA1, INTAKE row 30; T9-W7 §13
+ * MOT-VERB pass 6, charter row 8).
+ *
+ * THE DEFINITION (pass-6 chair §1.4, written here so the gate carries it): enter frame 1 = the
+ * first frame after the reparent on which the fold's mover exists; on it the board's centre is
+ * within 3 px of its rest pose (the playing board it left, read before the press) AND its width
+ * within 3 px — the RAW delta, never a residual against a fitted curve. READ POST-PAINT (pass 7,
+ * LAWS P6 §D): each frame is read in a task queued from its rAF, with the frame's rAF time and its
+ * `document.timeline` time captured in the rAF, frame 1 keyed on the mover's first
+ * IntersectionObserver entry — THE ONE SAMPLER at its product home (`./lib/postpaint.mjs`,
+ * `readMover`; registry-v7 §2.4). This file carries no reader of its own since pass 8. The pass-6
+ * reader sampled IN rAF, registered before the product's own, so it read the pre-callback state: a
+ * runtime plant that painted frame 1 at ct 150, 142.9 px off, passed it 8/8.
+ * The CLOCK IDENTITY rides the same frames: ct(frame k) = tl(k) − tl(frame 1) ± 2 ms for k = 2, 3
+ * (a first frame that is at rest but whose clock then jumps is the same skip one frame later).
+ * GATED IN BOTH ENGINES since pass 8 (LAWS P7 §D; the FRAME clock binds, pass8/CHAIR-RULINGS §2.4):
+ * pass 7 gated it in Chromium only, and the pass-7 critic's PLANT f2 (frame 1 at rest, then its
+ * clock jumps 150 ms on the second rAF) passed WebKit 6/6 while WebKit's own CI column read 150.0.
+ * Both engines; 1280 fine (light and dark), 390×844 coarse, and kenken at deck index 4. PLANT skip
+ * (every explicit `startTime` write lands 150 ms early) and PLANT f2 are the negatives, in this file,
+ * and each must RED its clause. A residual gate would pass a verb that starts part-way in on the
+ * right curve, which is the defect: at 74a2b5d9 frame 1 sits 92.9 px off at 1280 in Chromium, and in
+ * WebKit the UA's own resolution of a pending start put it 3.76 px off and 7.37 px narrow (pass 5).
+ *
+ * GA2 rides the same fold (its own rAF read of the clip, beside the sampler): while the fold runs,
+ * the board is never clipped by an ancestor
+ * (the visible fraction, every ancestor's overflow on each axis, is 1.0 on every frame; 0.235 at
+ * 74a2b5d9). Born RED on the control (74a2b5d9) at every cell and engine.
+ */
+// prettier-ignore
+const SOLVED_9 = [
+  5, 3, 4, 6, 7, 8, 9, 1, 2,  6, 7, 2, 1, 9, 5, 3, 4, 8,  1, 9, 8, 3, 4, 2, 5, 6, 7,
+  8, 5, 9, 7, 6, 1, 4, 2, 3,  4, 2, 6, 8, 5, 3, 7, 9, 1,  7, 1, 3, 9, 2, 4, 8, 5, 6,
+  9, 6, 1, 5, 3, 7, 2, 8, 4,  2, 8, 7, 4, 1, 9, 6, 3, 5,  3, 4, 5, 2, 8, 6, 1, 7, 9,
+];
+const BLANKS = new Set([0, 4, 10, 22, 36, 40, 55, 61, 73, 80]);
+const BOARD = encodeSudoku(
+  3,
+  Object.fromEntries(SOLVED_9.map((v, i) => [i, BLANKS.has(i) ? 0 : v])),
+  81,
+);
+
+// The last cell is the deck at a NON-ZERO index (INTAKE row 31): kenken is card 5 of 5, so the
+// deck opens scrolled, and the fold's lift (`overflow-x: clip`) resets that scroll. Chromium then
+// reported a snap for a position no hand chose, the centre went to card 1 in the fold's first
+// frame and the fold ran on a board parked out of sight (frame 1 at 0×0, 569 px off; pass 6).
+// Its board is dealt, not pinned: the row reads geometry, never the givens.
+const CELLS = [
+  { name: '1280x800 fine light', w: 1280, h: 800, touch: false, scheme: 'light', game: 'sudoku' },
+  { name: '1280x800 fine dark', w: 1280, h: 800, touch: false, scheme: 'dark', game: 'sudoku' },
+  { name: '390x844 coarse light', w: 390, h: 844, touch: true, scheme: 'light', game: 'sudoku' },
+  { name: '1280x800 fine light, kenken (deck index 4)', w: 1280, h: 800, touch: false, scheme: 'light', game: 'kenken' },
+] as const;
+
+/** GA2's read, beside the sampler (which reads the mover's pose, never its clip): on every frame the
+ *  mover animates, the fraction of the board no ancestor's overflow clips. */
+function installClipRead(): void {
+  const w = window as unknown as { __clipMin: number; __clipFrames: number };
+  w.__clipMin = 1;
+  w.__clipFrames = 0;
+  const tick = () => {
+    const board = document.querySelector('.board-peek-host');
+    const live = board
+      ?.getAnimations()
+      .some((a) => !(a instanceof CSSTransition) && !(a instanceof CSSAnimation));
+    if (board && live) {
+      const r = board.getBoundingClientRect();
+      let [l, t, rr, b] = [r.left, r.top, r.right, r.bottom];
+      for (let a = board.parentElement; a; a = a.parentElement) {
+        const cs = getComputedStyle(a);
+        const ar = a.getBoundingClientRect();
+        if (cs.overflowX !== 'visible') [l, rr] = [Math.max(l, ar.left), Math.min(rr, ar.right)];
+        if (cs.overflowY !== 'visible') [t, b] = [Math.max(t, ar.top), Math.min(b, ar.bottom)];
+      }
+      const area = r.width * r.height;
+      const vis = area > 0 ? (Math.max(0, rr - l) * Math.max(0, b - t)) / area : 0;
+      w.__clipMin = Math.min(w.__clipMin, vis);
+      w.__clipFrames++;
+    }
+    requestAnimationFrame(tick);
+  };
+  requestAnimationFrame(tick);
+}
+
+const SUBJECT = '.board-peek-host';
+type Plant = 'skip' | 'skip16' | 'f2' | null;
+
+/** Open the cell, fold, and read frame 1 + the clock identity post-paint through the ONE sampler. */
+async function readFold(
+  browser: import('@playwright/test').Browser,
+  cell: (typeof CELLS)[number],
+  plant: Plant = null,
+): Promise<{ m: Mover; clipMin: number; clipFrames: number; restW: number; lastW: number }> {
+  const ctx = await browser.newContext({
+    viewport: { width: cell.w, height: cell.h },
+    hasTouch: cell.touch,
+    colorScheme: cell.scheme,
+    reducedMotion: 'no-preference',
+  });
+  if (plant === 'skip') await ctx.addInitScript(SKIP_PLANT);
+  if (plant === 'skip16') await ctx.addInitScript(SKIP_PLANT, 16);
+  if (plant === 'f2') await ctx.addInitScript(F2_PLANT, SUBJECT);
+  const page = await ctx.newPage();
+  await page.goto(cell.game === 'sudoku' ? '/?game=sudoku&board=' + BOARD : '/?game=' + cell.game);
+  await page.locator('.board-cells').first().waitFor();
+  // the payload read back through the aria-label corpus (LAWS P5), never innerText
+  if (cell.game === 'sudoku')
+    expect(await page.locator('.board-cells [aria-label*="given clue"]').count()).toBe(71);
+  if (cell.touch)
+    expect(await page.evaluate(() => matchMedia('(any-pointer: coarse)').matches)).toBe(true);
+  await page.evaluate(() => document.fonts.ready);
+  const restW = await page.evaluate((sel) => document.querySelector(sel)!.getBoundingClientRect().width, SUBJECT);
+  await page.evaluate(installClipRead);
+  const m = await readMover(page, { sel: SUBJECT, key: 'g' });
+  const clip = await page.evaluate(() => {
+    const w = window as unknown as { __clipMin: number; __clipFrames: number };
+    return { clipMin: w.__clipMin, clipFrames: w.__clipFrames };
+  });
+  const lastW = await page.evaluate((sel) => document.querySelector(sel)?.getBoundingClientRect().width ?? 0, SUBJECT);
+  if (cell.game !== 'sudoku')
+    expect(
+      await page.locator('.game-card.is-center .board-peek-host').count(),
+      'the centre card lost the live board (the deck re-centred under the fold)',
+    ).toBe(1);
+  await ctx.close();
+  return { m, ...clip, restW, lastW };
+}
+
+/** The gate's clauses — the sampler's F1 and CI, BOTH engines at ±3 px / ±2 ms (LAWS P7 §D; the
+ *  FRAME clock binds, pass8/CHAIR-RULINGS §2.4). Returns every failure (empty = GREEN). */
+function failures(m: Mover): string[] {
+  const out = [...m.post.why];
+  if (m.kPaint < 0) out.push(`the mover never reported its first painted frame (io ${m.io})`);
+  return out;
+}
+
+for (const cell of CELLS) {
+  test(`GA1 · the fold's first painted frame is its first pose · ${cell.name}`, async ({
+    browser,
+  }) => {
+    const r = await readFold(browser, cell);
+    console.log(
+      `GA1 ${test.info().project.name} ${cell.name}: kPaint ${r.m.kPaint} (rAF-time key ${r.m.kStamp}) io ${r.m.io} | POST ${fmtArm(r.m.post)} | rAF-TIME KEY ${fmtArm(r.m.byStamp)} | inRAF ${fmtArm(r.m.inRAF)} | GA2 visible min ${r.clipMin.toFixed(3)} over ${r.clipFrames} frames; load ${loadavg()[0].toFixed(1)}`,
+    );
+    expect(failures(r.m)).toEqual([]);
+    // the glide MOVES after frame 1 (a hold that never releases would pass the rows above)
+    expect(r.m.post.frames ?? 0, 'the fold ran fewer than three frames').toBeGreaterThanOrEqual(3);
+    expect(r.lastW, 'the fold never shrank the board').toBeLessThan(r.restW - 3);
+    // GA2: never clipped while it folds
+    expect(r.clipFrames, 'GA2 read no folding frame').toBeGreaterThan(0);
+    expect(r.clipMin, `the folding board is clipped (visible ${r.clipMin.toFixed(3)})`).toBeGreaterThanOrEqual(0.999);
+  });
+}
+
+// THE NEGATIVES, in-run, both engines: PLANT skip (frame 1 painted 150 ms in) must red F1, PLANT skip16
+// (one frame in, 16 ms: the pass-8 critic's WebKit frame-1 clock) must red F1ct, and the pass-7 critic's
+// PLANT f2 (frame 1 at rest, then the clock jumps 150 ms on the second rAF) must red CI. In WebKit the
+// fold's frame-1 post read is stale on every run (pass 9), so skip and skip16 red there only through the
+// ONE sampler's stale-rebase (MOT-VERB pass 9, PROPOSED to the home).
+for (const [plant, clause] of [
+  ['skip', 'f1red'],
+  ['skip16', 'f1ct'],
+  ['f2', 'ciRed'],
+] as const)
+  test(`GA1 · PLANT ${plant} reds the post-paint read · ${CELLS[0].name}`, async ({ browser }) => {
+    const r = await readFold(browser, CELLS[0], plant);
+    console.log(
+      `GA1 PLANT ${plant} ${test.info().project.name}: POST ${fmtArm(r.m.post)} → ${r.m.post[clause] ? `RED (${clause})` : 'GREEN (the gate is blind)'}`,
+    );
+    expect(r.m.post[clause], `PLANT ${plant} painted and the ${clause} clause stayed green`).toBe(true);
+  });
diff --git a/web/frontend/e2e/frame-halfstroke.spec.ts b/web/frontend/e2e/frame-halfstroke.spec.ts
new file mode 100644
index 00000000..e0039748
--- /dev/null
+++ b/web/frontend/e2e/frame-halfstroke.spec.ts
@@ -0,0 +1,139 @@
+import { test, expect, type Browser } from '@playwright/test';
+import { encodeSudoku } from './wire';
+import { fourBands, fmt as fmtBands, type FourBands } from './lib/edge-bands.mjs';
+
+// PRM: live, because the read is the steady look the default regime lands on (the draw-in done and
+// the four poses baked); reduce bakes the same poses, and the frame is read at rest either way.
+
+/**
+ * T9-W7 §13 · THE FRAME IS PAINTED WHOLE (INTAKE-23 rows 1–2; registry-v7 §2.2 (i), ACC-GRAPHITE's
+ * unblock). The board frame's four sides are one 12-unit stroke in the grid's 1000-unit box, and the
+ * steady look is the four BAKED poses: coverage bitmaps exactly the box's size. With the ring's top and
+ * bottom on the box's edge (`FRAME_Y_PAD` 0), half of each of those strokes fell outside the bitmap and
+ * was never painted: the owner saw the sides at their full weight and the top and bottom at half.
+ *
+ * THE READ, in paint, through THE ONE four-band probe (`./lib/edge-bands.mjs`, pass 9; the pass-8 private
+ * `depth()`/`cov()` reader is deleted, LAWS P8 §I): the board is photographed with the grid's ink ON and
+ * OFF, one device station per column/row, and each band's painted depth is B3's statistic. Keyed on the
+ * board's DEVICE-PIXEL span (printed), never on the pointer.
+ *   B6  (was F1) every band paints ≥ 0.85 of the deepest band's depth: top and bottom against the sides
+ *   B3  (was F2) every band paints ≥ 0.9 × the frame's AUTHORED stroke (12 units × the scale)
+ *   B2/B4  the probe's own contrast and hole clauses, at its defaults
+ * PLANT (in-run, must RED): the baked ink cut to the box's inner 99 % vertically, which takes the outer
+ * part of the top and bottom strokes away as the edge bake used to.
+ * Born RED on the control (`74a2b5d9`): top and bottom read about half the sides at every rig.
+ */
+// prettier-ignore
+const SOLVED_9 = [
+  5, 3, 4, 6, 7, 8, 9, 1, 2,  6, 7, 2, 1, 9, 5, 3, 4, 8,  1, 9, 8, 3, 4, 2, 5, 6, 7,
+  8, 5, 9, 7, 6, 1, 4, 2, 3,  4, 2, 6, 8, 5, 3, 7, 9, 1,  7, 1, 3, 9, 2, 4, 8, 5, 6,
+  9, 6, 1, 5, 3, 7, 2, 8, 4,  2, 8, 7, 4, 1, 9, 6, 3, 5,  3, 4, 5, 2, 8, 6, 1, 7, 9,
+];
+const BLANKS = new Set([0, 4, 10, 22, 36, 40, 55, 61, 73, 80]);
+const BOARD = encodeSudoku(
+  3,
+  Object.fromEntries(SOLVED_9.map((v, i) => [i, BLANKS.has(i) ? 0 : v])),
+  81,
+);
+
+/** Desk, phone and the three 1× touch boards (registry-v7 §2.2 (iii)). */
+const RIGS = [
+  { name: 'desk 1280x800 fine dpr1', w: 1280, h: 800, dpr: 1, touch: false },
+  { name: 'phone 390x844 coarse dpr2', w: 390, h: 844, dpr: 2, touch: true },
+  { name: 'tablet 768x1024 coarse dpr1', w: 768, h: 1024, dpr: 1, touch: true },
+  { name: 'tablet 1024x768 coarse dpr1', w: 1024, h: 768, dpr: 1, touch: true },
+  { name: 'laptop 1280x800 coarse dpr1', w: 1280, h: 800, dpr: 1, touch: true },
+] as const;
+const SCHEMES = ['light', 'dark'] as const;
+const PLANT_CSS = '.grid-ink { clip-path: inset(0.9% 0 0.9% 0); }';
+const OFF_CSS = '.grid-ink, .hand-drawn-grid { visibility: hidden !important; }';
+// the grid's own box on every tree (the baked ink is a masked HTML box here and an svg `<image>` on
+// `74a2b5d9`: the edge list names both, so the control's read is a paint read, never a missing node)
+const SUBJECT = 'svg.hand-drawn-grid';
+const EDGE = 'svg.hand-drawn-grid, .grid-ink';
+const UNITS = 1000;
+const STROKE = 12;
+const BAND = 26; // the inner rules start 26 units in: the band reads the frame alone
+
+type Reading = { span: number; box: string; top: number; bottom: number; left: number; right: number; want: number; bands: FourBands };
+
+/** The frame's four bands through THE ONE probe (`./lib/edge-bands.mjs`, pass 9: the private depth reader
+ *  is gone). The subject is the grid's box, the edge its ink (both forms); the strip runs 8 px outside to just short of the
+ *  first inner rule (`BAND` units in), so a band reads the frame alone. B3's floor is the frame's
+ *  AUTHORED stroke (12 units × the scale) × 0.9 (pass9/CHAIR-RULINGS §7: a drawn frame floors at its
+ *  authored width × 0.9); B6 at 0.85 is F1's relative clause (top and bottom vs the deepest band). */
+async function readFrame(
+  browser: Browser,
+  rig: (typeof RIGS)[number],
+  colorScheme: 'light' | 'dark',
+  plant: boolean,
+): Promise<Reading> {
+  const ctx = await browser.newContext({
+    viewport: { width: rig.w, height: rig.h },
+    deviceScaleFactor: rig.dpr,
+    hasTouch: rig.touch,
+    colorScheme,
+    reducedMotion: 'no-preference',
+  });
+  const page = await ctx.newPage();
+  await page.goto('/?game=sudoku&board=' + BOARD);
+  await page.locator('.board-cells').first().waitFor();
+  expect(await page.locator('.board-cells [aria-label*="given clue"]').count()).toBe(71);
+  // the steady look: the draw-in done and all four poses baked (the live stack is the fallback)
+  await expect(page.locator('.boil-frame-bitmap')).toHaveCount(4, { timeout: 30000 });
+  if (plant) await page.addStyleTag({ content: PLANT_CSS });
+  await page.evaluate(() => document.fonts.ready);
+  const g = await page.evaluate((sel) => {
+    const r = document.querySelector(sel)!.getBoundingClientRect();
+    return { w: r.width, h: r.height };
+  }, SUBJECT);
+  const side = Math.min(g.w, g.h);
+  const want = (STROKE * side) / UNITS; // css px
+  const bands = await fourBands(page, {
+    subject: SUBJECT,
+    edge: EDGE,
+    off: OFF_CSS,
+    out: 8,
+    inn: Math.max(4, Math.floor((BAND * side) / UNITS) - 1),
+    thick: want,
+    thickTol: 0.9,
+    relBand: 0.85,
+  });
+  await ctx.close();
+  const depth = (k: 'top' | 'bottom' | 'left' | 'right') => bands.bands?.[k]?.thickness ?? 0;
+  return {
+    span: Math.round(side * rig.dpr),
+    box: `${g.w.toFixed(1)}×${g.h.toFixed(1)}`,
+    top: depth('top'),
+    bottom: depth('bottom'),
+    left: depth('left'),
+    right: depth('right'),
+    want,
+    bands,
+  };
+}
+
+/** The gate: the ONE probe's verdict (B0–B6), and the relative read printed as the pass-8 F1 ratio. */
+function failures(r: Reading): string[] {
+  return [...r.bands.why];
+}
+
+const fmt = (r: Reading) =>
+  `box ${r.box} · span ${r.span} dpx · depth t ${r.top.toFixed(2)} b ${r.bottom.toFixed(2)} l ${r.left.toFixed(2)} r ${r.right.toFixed(2)} css px · stroke ${r.want.toFixed(2)} · t/b÷sides ${(Math.min(r.top, r.bottom) / ((r.left + r.right) / 2)).toFixed(3)} · min÷deepest ${(Math.min(r.top, r.bottom, r.left, r.right) / Math.max(r.top, r.bottom, r.left, r.right)).toFixed(3)} · ${fmtBands(r.bands)}`;
+
+for (const rig of RIGS)
+  for (const scheme of SCHEMES)
+    test(`the frame paints whole · ${rig.name} · ${scheme}`, async ({ browser }) => {
+      const r = await readFrame(browser, rig, scheme, false);
+      console.log(`FRAME ${test.info().project.name} ${rig.name} ${scheme}: ${fmt(r)}`);
+      expect(failures(r)).toEqual([]);
+    });
+
+// THE NEGATIVE, in-run: the outer edge of the top and bottom strokes cut away must RED.
+for (const rig of [RIGS[0], RIGS[1]])
+  test(`PLANT half-stroke reds the frame read · ${rig.name}`, async ({ browser }) => {
+    const r = await readFrame(browser, rig, 'light', true);
+    const red = failures(r);
+    console.log(`FRAME PLANT ${test.info().project.name} ${rig.name}: ${fmt(r)} → ${red.join(' · ') || 'GREEN (the gate is blind)'}`);
+    expect(red.length, 'the half-stroke plant painted and the gate stayed green').toBeGreaterThan(0);
+  });
diff --git a/web/frontend/e2e/ladder-prm.spec.ts b/web/frontend/e2e/ladder-prm.spec.ts
new file mode 100644
index 00000000..e5ad2107
--- /dev/null
+++ b/web/frontend/e2e/ladder-prm.spec.ts
@@ -0,0 +1,153 @@
+import { test, expect, type Page } from '@playwright/test';
+import { encodeSudoku } from './wire';
+
+// PRM: frozen — emulateMedia({reducedMotion:'reduce'}) before goto
+
+/**
+ * T9-W7 §13 · THE LADDER'S CLASS-CLOSURE CLAUSE, AS A ROW (MOT-LADDER pass 5, row 5).
+ *
+ * PRM is a VALUE of the ladder: under `reduce` every `--motion-*` rung reads 0s, so every rung
+ * consumer collapses to a same-frame swap. Pass 4 proved it once, by hand (62 rendered elements
+ * tweening under reduce at 74a2b5d9 → 16 on the ladder, all 16 inherited, 0 unaccounted, both
+ * engines) and the proof had no `expect` and no lane: a seventeenth tweening element would have
+ * gone unseen. This file is that proof as a row.
+ *
+ * What it holds, on RENDERED ELEMENTS (never CSSOM rules, which cannot see what paints):
+ *   1 the regime is witnessed: `matchMedia('(prefers-reduced-motion: reduce)')` true in the page;
+ *   2 every rung reads `0s` at `:root`;
+ *   3 every element whose computed transition or animation still spends time sits inside the
+ *     dark toggle's button — the ONE inherited residue, named by its occluder — and there are no
+ *     more of them than the CEILING the base carried (16; an allowlist for an inherited defect
+ *     carries a ceiling, it never grows silently);
+ *   4 the walk can FAIL: a stranded element with a 300ms transition, planted in the same page
+ *     after the read, is found by the same walk (the negative control, in-run).
+ */
+
+// The pinned board: the estate's own codec (wire.ts), so both runs deal the same givens.
+// prettier-ignore
+const SOLVED_9 = [
+  5, 3, 4, 6, 7, 8, 9, 1, 2,  6, 7, 2, 1, 9, 5, 3, 4, 8,  1, 9, 8, 3, 4, 2, 5, 6, 7,
+  8, 5, 9, 7, 6, 1, 4, 2, 3,  4, 2, 6, 8, 5, 3, 7, 9, 1,  7, 1, 3, 9, 2, 4, 8, 5, 6,
+  9, 6, 1, 5, 3, 7, 2, 8, 4,  2, 8, 7, 4, 1, 9, 6, 3, 5,  3, 4, 5, 2, 8, 6, 1, 7, 9,
+];
+const BLANKS = new Set([0, 4, 10, 22, 36, 40, 55, 61, 73, 80]);
+const BOARD = encodeSudoku(
+  3,
+  Object.fromEntries(SOLVED_9.map((v, i) => [i, BLANKS.has(i) ? 0 : v])),
+  81,
+);
+
+/** The base's inherited residue at 74a2b5d9: the toggle's parked live stack. A ceiling. */
+const INHERITED_CEILING = 16;
+const OCCLUDER = '.sun-moon-toggle';
+const RUNGS = ['whisper', 'leave', 'note', 'dusk', 'step', 'throw', 'rise'];
+
+/** Every rendered element that still spends time, keyed by whether the occluder holds it. */
+async function roster(page: Page) {
+  return page.evaluate((occluder) => {
+    const secs = (v: string) =>
+      v.split(',').map((s) => (s.trim().endsWith('ms') ? parseFloat(s) / 1000 : parseFloat(s)));
+    const out: { tag: string; cls: string; inOccluder: boolean; td: string; an: string }[] = [];
+    for (const el of Array.from(document.querySelectorAll('body *'))) {
+      const cs = getComputedStyle(el);
+      const tweens =
+        cs.transitionProperty !== 'none' && secs(cs.transitionDuration).some((n) => n > 0);
+      const animates =
+        cs.animationName !== 'none' && secs(cs.animationDuration).some((n) => n > 0);
+      if (!tweens && !animates) continue;
+      out.push({
+        tag: el.tagName,
+        cls: (el.getAttribute('class') ?? '').slice(0, 60),
+        inOccluder: !!el.closest(occluder),
+        td: cs.transitionDuration,
+        an: cs.animationName,
+      });
+    }
+    return out;
+  }, OCCLUDER);
+}
+
+/**
+ * THE FOUR POSES (pass 6, the critic's row): the clause matters wherever a surface can tween, so
+ * the walk runs the play surface and the gallery at the desk (fine) and at the phone (coarse,
+ * `hasTouch`, the regime witnessed in the page). One pose held the clause in pass 5; the other
+ * three were a critic's reading, not a row.
+ */
+const POSES = [
+  { name: 'play 1440 fine', w: 1440, h: 900, touch: false, gallery: false },
+  { name: 'play 390x844 coarse', w: 390, h: 844, touch: true, gallery: false },
+  { name: 'gallery 1440 fine', w: 1440, h: 900, touch: false, gallery: true },
+  { name: 'gallery 390x844 coarse', w: 390, h: 844, touch: true, gallery: true },
+] as const;
+
+for (const pose of POSES)
+  test(`the ladder under reduce · ${pose.name}: every rung 0s, the residue inside its ceiling, the walk able to fail`, async ({
+    browser,
+  }) => {
+    const ctx = await browser.newContext({
+      viewport: { width: pose.w, height: pose.h },
+      hasTouch: pose.touch,
+      reducedMotion: 'reduce',
+    });
+    const page = await ctx.newPage();
+    await page.goto('/?game=sudoku&board=' + BOARD);
+    await page.locator('.board-cells').first().waitFor();
+
+    // THE PAYLOAD, READ BACK through the aria-label corpus (the digits are SVG glyphs, so
+    // `.board-cells` innerText is empty on every arm — pass 5 compared empty strings).
+    const givens = await page
+      .locator('.board-cells [aria-label*="given clue"]')
+      .count();
+    expect(givens, 'the pinned board deals its 71 givens').toBe(81 - BLANKS.size);
+
+    expect(
+      await page.evaluate(() => [
+        matchMedia('(prefers-reduced-motion: reduce)').matches,
+        matchMedia('(any-pointer: coarse)').matches,
+      ]),
+      'the regime, witnessed',
+    ).toEqual([true, pose.touch]);
+
+    if (pose.gallery) {
+      // Under reduce the gallery deals a still poster, never the live face, so the pose is the
+      // picker itself.
+      await page.locator('button.logo-trigger').first().click();
+      await page.locator('[aria-label="Choose a puzzle"]').first().waitFor();
+    }
+
+    const rungs = await page.evaluate(
+      (names) =>
+        names.map((n) =>
+          getComputedStyle(document.documentElement).getPropertyValue(`--motion-${n}`).trim(),
+        ),
+      RUNGS,
+    );
+    expect(rungs).toEqual(RUNGS.map(() => '0s'));
+
+    // Settle is a POSE, never a sleep: the roster is read until two consecutive reads agree.
+    let prev = -1;
+    let rows: Awaited<ReturnType<typeof roster>> = [];
+    await expect
+      .poll(async () => {
+        rows = await roster(page);
+        const same = rows.length === prev;
+        prev = rows.length;
+        return same;
+      })
+      .toBe(true);
+
+    const outside = rows.filter((r) => !r.inOccluder);
+    expect(outside, `tweening under reduce outside ${OCCLUDER}`).toEqual([]);
+    expect(rows.length).toBeLessThanOrEqual(INHERITED_CEILING);
+
+    // THE NEGATIVE CONTROL, same page, same walk: a stranded element the ladder never reached.
+    await page.evaluate(() => {
+      const d = document.createElement('div');
+      d.dataset.ladderPlant = '';
+      d.style.transition = 'opacity 300ms linear';
+      document.body.append(d);
+    });
+    const planted = (await roster(page)).filter((r) => !r.inOccluder);
+    expect(planted.length, 'the walk finds a planted 300ms transition').toBe(1);
+    await ctx.close();
+  });
diff --git a/web/frontend/e2e/lib/edge-bands.d.mts b/web/frontend/e2e/lib/edge-bands.d.mts
new file mode 100644
index 00000000..d25ede03
--- /dev/null
+++ b/web/frontend/e2e/lib/edge-bands.d.mts
@@ -0,0 +1,113 @@
+// edge-bands.d.mts — the TYPES of the ONE four-band edge probe (`./edge-bands.mjs`), so a TypeScript spec
+// imports it under `typecheck:e2e` (strict, no `allowJs`). No behaviour lives here; every export is typed
