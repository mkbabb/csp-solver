+  // paused mover at ct 0 (the product's start write runs in a later rAF of the same frame); its post
+  // read ran after frame 2's timeline update. Clean: post ct 17 at tlNow 263 → rebased 0, GREEN.
+  // Planted (startTime written 150 ms early): post ct 167 → rebased 150, RED on F1ct alone.
+  const held = (ct0) => [fr(0, 246, ct0, 0, 263), fr(1, 263, ct0), fr(2, 280, ct0 + 17)];
+  const twin = [{ ...fr(0, 246, 0), ps: "paused" }, fr(1, 263, 17), fr(2, 280, 34)];
+  const u5c = analyse(held(17), rest, { kPaint: 0, inRAF: twin });
