+      ["r", "skip", "f1red", null],
+      ["r", "f2", "ciRed", null],
+      ["r", "from40", "f1pos", "f1ct"],
+      ["e", "skip16", "f1ct", "f1pos"],
+    ]) {
+      const r = await run(key, plant);
+      const bites = r.post[want] && (!only || !r.post[only]);
+      if (!bites) hole = true;
+      rows.push(`POSTPAINT self-test r${rep} ${key === "r" ? "RAF" : "EASED"}-mover PLANT ${plant} | POST ${fmtArm(r.post)} → ${bites ? `RED (${want}${only ? ` only` : ""})` : "GREEN ← a hole"}`);
