diff --git a/web/frontend/e2e/boot-hand.spec.ts b/web/frontend/e2e/boot-hand.spec.ts
new file mode 100644
index 00000000..adfff039
--- /dev/null
+++ b/web/frontend/e2e/boot-hand.spec.ts
@@ -0,0 +1,289 @@
+import { test, expect, type Browser } from '@playwright/test';
+import { loadavg } from 'node:os';
+import { installTimeline } from './lib/postpaint.mjs';
+
+// PRM: live, because the subject is the boot's draw-in: under reduce the grid stands whole from the
+// first frame and the wave is a same-frame cut, so there is no ruling to time.
+
+/**
+ * T9-M20 · THE BOOT'S ONE HAND, read on the painted timeline (T9-W7 §13 pass 8, MOT-VERB charter
+ * rows 2–3; INTAKE-23 rows 1 and 8). The page is drawn by one hand: the grid's lines on the hand's
+ * clock (`bootHand.enrollStroke`), and the deal's wave held off the page until the last lift
+ * (`afterRuling`). Two clauses, both engines, each at the panel's native rate AND under a 60 Hz and a
+ * 30 Hz display (a rAF shim that runs callbacks only on every second or fourth native frame):
+ *   W  THE WAVE WAITS: the first given digit starts to ink no earlier than the frame on which the
+ *      ruling reaches 95 % (less one frame's interval). Born RED on `74a2b5d9` (digits at 352–479 ms,
+ *      ruled 95 % at 557–579 ms, pass 7) and under the bypass plant (a build whose `afterRuling`
+ *      returns null).
+ *   R  THE HAND IS A RATE: at 60 and 30 Hz the hand keeps ≥ 0.9 of its native pace, i.e. the ruling
+ *      takes no more than 1/0.9 = 1.111× its native time in the same run (LAWS P8 §D, the law's 0.9;
+ *      pass 8's 1.2× is struck: pass 7's flat-17 ms clock passed it at 60 Hz in both engines). The
+ *      shim's arms are named at the rate they DELIVER (WebKit's native frame is ~10 ms, so its '60'
+ *      runs at 50 Hz and its '30' at 25 Hz), printed per arm. Pass 7's clock is R's plant.
+ *   L  A LOST FRAME NEVER TELEPORTS THE HAND (the stall leg, LAWS P7 §F (iii): M20's behavioural twin):
+ *      three 120 ms main-thread stalls injected in rAF at a quarter, half and three quarters of the
+ *      ruling; the ruled fraction gained on the frame after each lost frame (a rAF gap ≥ 100 ms between
+ *      the first stroke and 95 %) is ≤ 4× the larger step of its two neighbours on either side. The wall clock (`clock += dt`, the pre-M20 hand) is L's plant: a
+ *      lost frame there lands its whole interval at once. %/s is printed, never gated: a wall-clock
+ *      hand keeps its %/s across a stall by definition, so only the per-frame step can see it.
+ *   S  NOTHING BAKES UNDER THE HAND (`stacksResident`): no pose bake lands (a blob URL minted, which is
+ *      how every raster stack hands its encode over) between the first stroke and the ruling's 95 %,
+ *      and the wait's ceiling never fired (`data-hand-ceiling` absent). Born RED on `74a2b5d9` (its
+ *      four grid encodes land inside its ruling) and under the plant whose `stacksResident` resolves at
+ *      once. W's second plant empties `holdRuling`, so the ruling never holds the wave.
+ * The ruling is the home's `ruled:` subject (the drawn fraction summed over every transition-layer
+ * line, read post-paint per frame); the wave's onset is the first mutation that draws a given digit's
+ * stroke past 5 %. The deal is random (a restore's wave is not the boot's): the row reads timing,
+ * never the givens. Box load printed per line (LAWS P6 §B).
+ */
+const RULED = 'ruled:svg.hand-drawn-grid > g:not(.boil-frame-layer) > path.grid-line';
+/** R's floor (LAWS P8 §D) and L's bound: a lost frame's step ≤ 4× its neighbours' (the hand's one
+ *  `stepMs` of travel reads ~1 at 60 Hz and ~2.2 on a 7.8 ms panel; the wall clock's 120 ms stall lands
+ *  7–15 frames at once). Env-overridable for the threshold battery only. */
+const R_FLOOR = Number(process.env.BOOT_R_FLOOR ?? 0.9);
+const L_BOUND = Number(process.env.BOOT_L_BOUND ?? 4);
+const RATES = [
+  { name: 'native', hz: 0 },
+  { name: '60 Hz', hz: 60 },
+  { name: '30 Hz', hz: 30 },
+] as const;
+
+/** Init script: the display at `hz` — rAF callbacks run only on the native frames at least one
+ *  period apart, with that frame's own timestamp. 0 leaves the panel alone. */
+function displayAt(hz: number): void {
+  if (!hz) return;
+  const period = 1000 / hz;
+  const native = window.requestAnimationFrame.bind(window);
+  let queue: [number, FrameRequestCallback][] = [];
+  const live = new Set<number>();
+  let last = -Infinity;
+  let pumping = false;
+  let id = 0;
+  const pump = (ts: number) => {
+    if (ts - last >= period - 2) {
+      last = ts;
+      const run = queue;
+      queue = [];
+      for (const [i, cb] of run) if (live.delete(i)) cb(ts);
+    }
+    if (queue.length) native(pump);
+    else pumping = false;
+  };
+  window.requestAnimationFrame = (cb: FrameRequestCallback) => {
+    const i = ++id;
+    live.add(i);
+    queue.push([i, cb]);
+    if (!pumping) {
+      pumping = true;
+      native(pump);
+    }
+    return i;
+  };
+  window.cancelAnimationFrame = (i: number) => {
+    live.delete(i);
+  };
+}
+
+/** Init script: every pose bake's landing — a raster stack mints one blob URL per encode. */
+function watchBakes(): void {
+  const w = window as unknown as { __bakes: number[] };
+  w.__bakes = [];
+  const mint = URL.createObjectURL.bind(URL);
+  URL.createObjectURL = (o: Blob | MediaSource) => {
+    w.__bakes.push(performance.now());
+    return mint(o);
+  };
+}
+
+/** Init script: the wave's onset — the first time a given digit's stroke is drawn past 5 %. */
+function watchWave(): void {
+  const w = window as unknown as { __wave: number | null };
+  w.__wave = null;
+  new MutationObserver((ms) => {
+    if (w.__wave !== null) return;
+    for (const m of ms) {
+      const el = m.target as SVGPathElement;
+      if (!el.closest?.('.glyph-svg')) continue;
+      const d = parseFloat(el.style.strokeDasharray);
+      const o = parseFloat(el.style.strokeDashoffset);
+      if (d > 0 && o < d * 0.95) {
+        w.__wave = performance.now();
+        return;
+      }
+    }
+  }).observe(document, { subtree: true, attributes: true, attributeFilter: ['style'] });
+}
+
+/** Init script (L): three 120 ms main-thread stalls, each inside a rAF, the first frame the ruling's
+ *  drawn fraction (the same inline-dash sum as the `ruled:` subject) crosses 25, 50 and 75 %. */
+function stallRuling(): void {
+  const w = window as unknown as { __stalls: number[] };
+  w.__stalls = [];
+  const marks = [0.25, 0.5, 0.75];
+  const tick = () => {
+    const lines = document.querySelectorAll<SVGPathElement>(
+      'svg.hand-drawn-grid > g:not(.boil-frame-layer) > path.grid-line',
+    );
+    let dashed = 0;
+    let sum = 0;
+    for (const l of lines) {
+      const d = parseFloat(l.style.strokeDasharray);
+      const o = parseFloat(l.style.strokeDashoffset);
+      if (d > 0 && Number.isFinite(o)) dashed++;
+      sum += d > 0 && Number.isFinite(o) ? 1 - o / d : 1;
+    }
+    if (dashed > 0 && sum / lines.length >= marks[0]) {
+      marks.shift();
+      const t0 = performance.now();
+      while (performance.now() - t0 < 120);
+      w.__stalls.push(t0);
+    }
+    if (marks.length) requestAnimationFrame(tick);
+  };
+  requestAnimationFrame(tick);
+}
+
+type Boot = {
+  interval: number;
+  t0: number;
+  t95: number;
+  ruling: number;
+  wave: number | null;
+  worstStep: number;
+  worstRate: number;
+  held: number;
+  /** pose bakes that landed between the first stroke and the ruling's 95 %, and in all */
+  bakesIn: number;
+  bakes: number;
+  ceiling: string | null;
+  /** L: per injected stall, the ruled step on the frame after it over the larger neighbour step */
+  stalls: { gap: number; step: number; near: number; ratio: number; rate: number }[];
+};
+
+async function boot(browser: Browser, hz: number, stall = false): Promise<Boot> {
+  const ctx = await browser.newContext({
+    viewport: { width: 1280, height: 800 },
+    reducedMotion: 'no-preference',
+  });
+  await ctx.addInitScript(displayAt, hz);
+  await ctx.addInitScript(watchWave);
+  await ctx.addInitScript(watchBakes);
+  await ctx.addInitScript(installTimeline, RULED);
+  if (stall) await ctx.addInitScript(stallRuling);
+  const page = await ctx.newPage();
+  await page.goto('/?game=sudoku');
+  await expect(page.locator('.boil-frame-bitmap')).toHaveCount(4, { timeout: 30000 });
+  await expect
+    .poll(() => page.evaluate(() => (window as unknown as { __wave: number | null }).__wave), { timeout: 15000 })
+    .not.toBeNull();
+  const got = await page.evaluate(() => {
+    const w = window as unknown as {
+      __pf: { rafs: { k: number; ts: number }[]; post: { k: number; t: number; r: { x: number } | null }[] };
+      __wave: number | null;
+      __bakes: number[];
+    };
+    const ceiling = document.querySelector('svg.hand-drawn-grid')?.getAttribute('data-hand-ceiling') ?? null;
+    return { rafs: w.__pf.rafs, post: w.__pf.post, wave: w.__wave, bakes: w.__bakes, ceiling };
+  });
+  await ctx.close();
+  const ruled = got.post.filter((p) => p.r).map((p) => ({ k: p.k, t: p.t, x: p.r!.x }));
+  const full = Math.max(...ruled.map((p) => p.x));
+  const first = ruled.find((p) => p.x > 0.001)!;
+  const at95 = ruled.find((p) => p.x >= 0.95 * full)!;
+  const ts = new Map(got.rafs.map((r) => [r.k, r.ts]));
+  const gaps = got.rafs.slice(1).map((r, i) => r.ts - got.rafs[i].ts).sort((a, b) => a - b);
+  const interval = gaps[gaps.length >> 1];
+  let worstStep = 0;
+  let worstRate = 0;
+  let held = 0;
+  for (let i = 1; i < ruled.length; i++) {
+    if (ruled[i].t > at95.t) break;
+    const dt = (ts.get(ruled[i].k) ?? 0) - (ts.get(ruled[i - 1].k) ?? 0);
+    const dx = (ruled[i].x - ruled[i - 1].x) / full;
+    if (ruled[i - 1].x > 0.001) held = Math.max(held, dt);
+    worstStep = Math.max(worstStep, dx);
+    if (dt > 0) worstRate = Math.max(worstRate, dx / (dt / 1000));
+  }
+  // L: a frame whose rAF follows its predecessor by ≥ 100 ms inside the ruling is a lost frame
+  const steps = ruled.map((p, i) => ({
+    gap: i ? (ts.get(p.k) ?? 0) - (ts.get(ruled[i - 1].k) ?? 0) : 0,
+    dx: i ? (p.x - ruled[i - 1].x) / full : 0,
+    t: p.t,
+  }));
+  const stalls = steps
+    .map((s, i) => ({ ...s, i }))
+    .filter((s) => s.i > 2 && s.gap >= 100 && s.t > first.t && s.t <= at95.t)
+    .map((s) => {
+      const near = Math.max(
+        ...[-2, -1, 1, 2]
+          .map((d) => steps[s.i + d])
+          .filter((n) => n && n.gap > 0 && n.gap < 100)
+          .map((n) => n.dx),
+      );
+      // a lost frame that moved nothing (the hand between lines) reads 0, never 0/0
+      const ratio = s.dx <= 1e-6 ? 0 : near > 0 ? s.dx / near : Infinity;
+      return { gap: s.gap, step: s.dx, near, ratio, rate: s.dx / (s.gap / 1000) };
+    });
+  return {
+    stalls,
+    interval,
+    t0: first.t,
+    t95: at95.t,
+    ruling: at95.t - first.t,
+    wave: got.wave,
+    worstStep,
+    worstRate,
+    held,
+    bakesIn: got.bakes.filter((t) => t > first.t && t < at95.t).length,
+    bakes: got.bakes.length,
+    ceiling: got.ceiling,
+  };
+}
+
+const fmt = (b: Boot) =>
+  `interval ${b.interval.toFixed(1)} ms · first stroke ${b.t0.toFixed(0)} → ruled 95 % ${b.t95.toFixed(0)} (${b.ruling.toFixed(0)} ms) · wave ${b.wave?.toFixed(0) ?? 'never'} · worst step ${(100 * b.worstStep).toFixed(2)} %/frame, ${(100 * b.worstRate).toFixed(0)} %/s · max held ${b.held.toFixed(1)} ms · bakes in the ruling ${b.bakesIn}/${b.bakes} · ceiling ${b.ceiling ?? 0}`;
+
+test(`the boot's one hand: the wave waits and the hand is a rate`, async ({ browser }) => {
+  test.setTimeout(240000);
+  const project = test.info().project.name;
+  const got: Record<string, Boot> = {};
+  for (const r of RATES) {
+    const b = await boot(browser, r.hz);
+    got[r.name] = b;
+    console.log(`BOOT ${project} ${r.name}: ${fmt(b)}; load ${loadavg()[0].toFixed(1)}`);
+  }
+  const bad: string[] = [];
+  for (const r of RATES) {
+    const b = got[r.name];
+    if (b.wave === null || b.wave < b.t95 - b.interval)
+      bad.push(`W ${r.name}: the wave inked at ${b.wave?.toFixed(0)} ms, ${(b.t95 - (b.wave ?? 0)).toFixed(0)} ms before the ruling reached 95 %`);
+  }
+  for (const r of RATES) {
+    const b = got[r.name];
+    if (b.bakesIn > 0 || b.ceiling !== null)
+      bad.push(`S ${r.name}: ${b.bakesIn} pose bake(s) landed under the hand, the ceiling fired ${b.ceiling ?? 0}×`);
+  }
+  // R at the law's 0.9 (LAWS P8 §D): pace = native ruling / arm ruling; the arm named at the rate it DELIVERS
+  for (const r of RATES.slice(1)) {
+    const k = got[r.name].ruling / got.native.ruling;
+    const hz = 1000 / got[r.name].interval;
+    console.log(`BOOT ${project} R ${r.name} (delivers ${hz.toFixed(1)} Hz): ${k.toFixed(3)}× native, pace ${(1 / k).toFixed(3)} (floor ${R_FLOOR}, margin ${(1 / k - R_FLOOR).toFixed(3)})`);
+    if (1 / k < R_FLOOR) bad.push(`R ${r.name} (${hz.toFixed(1)} Hz): the hand kept ${(1 / k).toFixed(3)} of its native pace (${got[r.name].ruling.toFixed(0)} vs ${got.native.ruling.toFixed(0)} ms), under the law's ${R_FLOOR}`);
+  }
+  console.log(`BOOT ${project} verdict: ${bad.join(' · ') || 'GREEN'}`);
+  expect(bad).toEqual([]);
+});
+
+test(`a lost frame never teleports the hand (L, the stall leg)`, async ({ browser }) => {
+  test.setTimeout(120000);
+  const project = test.info().project.name;
+  const b = await boot(browser, 0, true);
+  console.log(`BOOT ${project} L: ${fmt(b)}; load ${loadavg()[0].toFixed(1)}`);
+  for (const s of b.stalls)
+    console.log(
+      `BOOT ${project} L stall: gap ${s.gap.toFixed(1)} ms · step ${(100 * s.step).toFixed(2)} % vs neighbours ${(100 * s.near).toFixed(2)} % → ${s.ratio.toFixed(2)}× (bound ${L_BOUND}, margin ${(L_BOUND - s.ratio).toFixed(2)}) · ${(100 * s.rate).toFixed(0)} %/s`,
+    );
+  expect(b.stalls.length, 'the leg injected no lost frame inside the ruling (vacuous)').toBeGreaterThanOrEqual(2);
+  const worst = Math.max(...b.stalls.map((s) => s.ratio));
+  expect(worst, `a lost frame moved the ruling ${worst.toFixed(2)}× its neighbours' step`).toBeLessThanOrEqual(L_BOUND);
+});
