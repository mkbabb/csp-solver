+  const u5 = !u5c.red && u5p.f1ct;
+  if (!u5) hole = true;
+  rows.push(`POSTPAINT unit U5 stale-rebase: clean ${fmtArm(u5c)} · planted ${fmtArm(u5p)} → ${u5 ? "OK (planted F1ct RED, clean GREEN)" : "← a hole: a stale frame 1 reads its pre-write twin"}`);
+  // U6 seek-guard (homes v3; pass10/CHAIR-RULINGS §18, the critic's missing plant): the fold's shape with
+  // a SEEK between frame 1's paint and its stale post read — frame 1 painted ct 150 (a skip) and a task
+  // wound the clock back 150 ms, so the post read holds ct 17 and the rebase alone infers a clean 0. With
+  // the guard the read is UNREAD and frame 2 (ct 17) reds F1ct; the frame's own in-rAF start write alone
+  // is lawful (GREEN, U5's clean)
+  const w6 = (n, k, inRaf, kind) => ({ n, k, inRaf, kind });
