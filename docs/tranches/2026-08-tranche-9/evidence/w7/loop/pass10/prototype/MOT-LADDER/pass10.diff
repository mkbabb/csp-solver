+
+/** The pairs of published curve tokens that are allowed to resolve to the same points.
+ *  Four names for the glass curve are grammar because rule 5 makes them mean different
+ *  things; a FIFTH name appearing unannounced is not. */
+const DECLARED_DUPLICATES = new Set([
+  "--ease-glassGlide=--verb-layDown-ease",
+  "--ease-glassGlide=--verb-slide-ease",
+  "--verb-layDown-ease=--verb-slide-ease",
+  "--verb-lift-ease=--verb-rubOut-ease",
+  "--ease-noteWrite=--verb-writeIn-ease",
+  // T9-W7 §13 pass 5: the toggle's PRM fallback keeps CSS `ease`, written out; dusk IS `ease`.
+  "--ease-prmFade=--verb-dusk-ease",
+]);
+
+// ── THE PROPERTY ALIAS TABLE (rule 5) ────────────────────────────────────────────────
+// A shorthand contains its longhands, and the independent transform properties are the
+// transform family under another spelling.
+const TRANSFORM_FAMILY = new Set(["transform", "scale", "translate", "rotate"]);
+const CONTAINS = {
+  background: ["background-color", "background-image"],
+  inset: ["top", "right", "bottom", "left"],
+  border: ["border-color", "border-width"],
+};
+
+// The table reads BOTH ways, because a shorthand and its longhand are one decision written
+// two ways: `background` on a card that only ever paints a colour is `background-color`, and
+// a verb that owns the longhand owns the spelling the stylesheet happens to use.
+function covers(props, moved) {
+  if (props.includes(moved)) return true;
+  if (TRANSFORM_FAMILY.has(moved) && props.some((p) => TRANSFORM_FAMILY.has(p)))
+    return true;
+  for (const p of props) {
+    if (moved.startsWith(`${p}-`) || p.startsWith(`${moved}-`)) return true;
