+          out.push({
+            name: `?${m[1].trim()}`,
+            unresolved: true,
+            inherits: null,
+            syntax: null,
+            initial: null,
+            kind: "registerProperty",
+            file,
+            line: lineAt(s, m.index),
+          });
+    }
+  }
+  return out;
+}
