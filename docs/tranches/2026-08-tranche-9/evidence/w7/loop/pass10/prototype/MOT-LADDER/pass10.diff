+    // homes v3 · inkkey (MRK-LIVE's CRIT-FCMOVE): the outline clipped to nothing while the card moves 4 px
+    const FCINK = scheme === "dark" ? [102, 178, 255] : [0, 90, 180];
+    const FC = { subject: "#f-fc", edge: "#f-fc", off: "#f-fc { outline-color: transparent !important; clip-path: none !important; translate: none !important; }" };
+    const FCMOVE = "#f-fc { clip-path: inset(0) !important; translate: -4px -4px !important; }";
+    const fcClean = await fourBands(page, { ...FC, ink: FCINK });
+    if (fcClean.red) cleanRed = true;
+    rows.push(`${T} #f-fc INKKEY CLEAN (ink ${FCINK.join(",")}) ${fmt(fcClean)}`);
+    const fcKeyed = await plantRead(FCMOVE, { ...FC, ink: FCINK });
+    if (!fcKeyed.red) hole = true;
+    rows.push(`${T} #f-fc INKKEY PLANT CRIT-FCMOVE keyed on the ink ${fmt(fcKeyed)}`);
+    const fcBare = await plantRead(FCMOVE, FC);
+    rows.push(`${T} #f-fc INKKEY PLANT CRIT-FCMOVE unkeyed (the hole the key closes; printed) ${fmt(fcBare)}`);
+    // homes v3 · the absent edge (MRK-LIVE §9.12): a `{ fade }` plant on an edge matching nothing is a
+    // no-op with a no-op undo, and B0 carries the red — never a throw
+    let threw = null;
+    try {
+      const undo = await applyEdgePlant(page, ".f-none-edge", { fade: 0.15 });
+      await undo();
+    } catch (e) {
+      threw = String(e).split("\n")[0];
+    }
+    const absent = await fourBands(page, { subject: "#f-frame", edge: ".f-none-edge" });
+    if (threw || !absent.red) hole = true;
+    rows.push(`${T} ABSENT-EDGE { fade } plant → ${threw ? `THREW ${threw} ← a hole` : "no-op undo"}; ${fmt(absent)}`);
+    await ctx.close();
+  }
+  return { rows, exit: cleanRed ? (hole ? 4 : 1) : hole ? 3 : 0 };
+}
+
+// ------------------------------------------------------------------------------------------ CLI
+if (process.argv[1] && fileURLToPath(import.meta.url) === resolvePath(process.argv[1])) {
+  const A = args();
+  const engine = A.engine ?? "chromium";
+  let exit = 0;
+  if (A["sabotage-battery"]) {
+    // each clause off in turn (a child process per clause): the self-test must RED (exit ≠ 0)
+    const { spawnSync } = await import("node:child_process");
+    for (const c of EDGE_CLAUSES) {
+      const r = spawnSync(process.execPath, [fileURLToPath(import.meta.url), "--self-test", "--engine", engine, "--dprs", A.dprs ?? "1"], { env: { ...process.env, EDGE_SABOTAGE: c }, encoding: "utf8" });
+      const bit = r.status !== 0;
+      if (!bit) exit = 3;
+      const greens = r.stdout.split("\n").filter((l) => / → GREEN/.test(l) && /PLANT|BORN-RED/.test(l)).map((l) => l.replace(/^.*?(#\S+ (?:B5 )?(?:PLANT|BORN-RED) \S+( [^(→]*)?).*$/, "$1").trim());
+      console.log(`EDGE sabotage ${c} off → self-test exit ${r.status} ${bit ? "BITES" : "SILENT (a clause with no plant)"}${greens.length ? ` · GREEN: ${[...new Set(greens)].join(" | ")}` : ""}`);
+    }
+    console.log(`LOAD ${load()}`);
+    process.exit(exit);
+  }
+  const browser = await playwright()[engine].launch();
+  try {
+  if (A["self-test"]) {
+    for (const dpr of (A.dprs ?? "1,2").split(",").map(Number)) {
