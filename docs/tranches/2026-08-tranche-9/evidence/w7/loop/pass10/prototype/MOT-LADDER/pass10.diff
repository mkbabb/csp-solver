+      const r = await fourBands(page, { subject: "#f-frame", edge: ".f-frame-edge" });
+      await t.evaluate((e) => e.remove());
+      await settle(page);
+      return r;
+    });
+    rows.push(`${T} #f-frame LEGACY FADE15 (root stroke only) ${fmt(legacy)} ← the pass-7 form ${legacy.red ? "(read RED here)" : "(GREEN: the descendant form is load-bearing)"}`);
+    // homes v3 · B7, the band statistic (ACC-GRAPHITE's G2 at its class): the clean read's α50 width is
+    // the reference, the window [0.9, 1.1] a literal pin; the half-clip reds B7 alone, X6 reds B7 on the
+    // two sides it erases
+    const plantRead = async (css, c) => {
+      const t = await page.addStyleTag({ content: css });
+      await settle(page);
+      const r = await fourBands(page, c);
+      await t.evaluate((e) => e.remove());
+      await settle(page);
+      return r;
+    };
+    const RING_OFF = "#f-ring { outline-color: transparent !important; }";
+    const ringRef = median(Object.values((await fourBands(page, { subject: "#f-ring", edge: "#f-ring", off: RING_OFF })).bands).map((b) => b.width));
+    const W = { subject: "#f-ring", edge: "#f-ring", off: RING_OFF, widthRef: ringRef, widthWindow: [0.9, 1.1] };
+    const b7c = await fourBands(page, W);
+    if (b7c.red) cleanRed = true;
+    rows.push(`${T} #f-ring B7 CLEAN (ref α50 width ${ringRef} css px) ${fmt(b7c)} widths ${Object.values(b7c.bands).map((b) => b.width).join("/")}`);
+    const half = await plantRead("#f-ring { clip-path: inset(-1px) !important; }", { ...W, thick: 1 });
+    if (!half.red || !half.why.every((w) => w.startsWith("B7"))) hole = true;
+    rows.push(`${T} #f-ring B7 PLANT HALFCLIP (inset(-1px) on a 2 px outline; thick 1 so B7 alone may red) ${fmt(half)} widths ${Object.values(half.bands ?? {}).map((b) => b.width).join("/")}`);
+    const frameRef = median(Object.values((await fourBands(page, { subject: "#f-frame", edge: ".f-frame-edge" })).bands).map((b) => b.width));
+    const x6 = await plantRead(".f-frame-edge { clip-path: inset(0 22% 0 22%) !important; }", { subject: "#f-frame", edge: ".f-frame-edge", widthRef: frameRef, widthWindow: [0.9, 1.1] });
+    if (!x6.why.some((w) => w.startsWith("B7 left")) || !x6.why.some((w) => w.startsWith("B7 right"))) hole = true;
