+          const edge = `${subject} > .outline-svg`;
+          const g = await edgeGate(page, { subject, edge, drawn: A.roster, plants: DRAWN_PLANTS(edge, f.width) });
+          if (g.clean.red) cleanRed = true;
+          console.log(`EDGE ROSTER ${tag} ${A.roster} site ${i + 1}/${n} [edge ${g.clean.edgeCount}] CLEAN (floor ${f.width} × ${DRAWN_TOL} = ${(f.width * DRAWN_TOL).toFixed(2)}) ${fmt(g.clean)}`);
+          for (const [k, r] of Object.entries(g.plants)) {
+            if (!r.red && !r.noop) hole = true;
+            console.log(`EDGE ROSTER ${tag} ${A.roster} site ${i + 1}/${n} PLANT ${k} ${fmt(r)}`);
+          }
+        }
+      } finally {
+        await ctx.close();
+      }
+    }
+    exit = cleanRed ? (hole ? 4 : 1) : hole ? 3 : 0;
+  } else {
+    let cleanRed = false,
+      hole = false;
+    for (const cell of cellsOf(A)) {
