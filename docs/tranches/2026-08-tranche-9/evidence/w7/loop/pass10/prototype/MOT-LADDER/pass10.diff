+        ],
+        [
+          "G-HINGE",
+          "the fractions leave MOTION (the hinge has no home)",
+          () =>
+            gHinge(src0.replace(/\bhinge:\s*\{[^}]*\}/, "hinge: {}"), css0, lad.rungs),
