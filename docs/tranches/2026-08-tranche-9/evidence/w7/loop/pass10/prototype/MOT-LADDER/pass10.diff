+          ? found.length
+            ? `REGRESSED — ${found.length} finding(s) on a lawful model`
+            : "HELD (as it must) — 0 findings on a lawful model"
+          : found.length
+            ? "RED (as it must)"
+            : "GREEN — VACUOUS"
+      }`,
+    );
+    // `--list` prints WHY each control red, so a control that reds for an incidental reason
+    // (a stale row the model forgot) is visible rather than counted.
+    if (LIST)
+      for (const f of found.slice(0, 2)) console.log(`        · ${f.slice(0, 170)}`);
+    if (held && found.length)
+      vacuous.push(`the negative-negative REGRESSED: ${found.join("; ")}`);
+    if (!held && !found.length)
+      vacuous.push(`check "${target}" stayed GREEN under: ${desc}.`);
+  }
+  failures.push(...vacuous.map((v) => `[SELF-TEST] ${v}`));
+}
+
