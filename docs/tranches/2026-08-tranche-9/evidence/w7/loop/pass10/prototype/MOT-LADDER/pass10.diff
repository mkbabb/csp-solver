+      for (const row of r.rows) console.log(`${engine} ${row}`);
+      exit = Math.max(exit, r.exit);
+    }
+  } else if (A.roster) {
+    // homes v3 · THE ROSTER'S CONSUMER (pass10/CHAIR-RULINGS §10: the tray-well consumer): every painted site
+    // of the named entry read on the served page under `drawn` (the roster's pinned floor), with the source
+    // pin read on `--fe` (the served tree's own frontend), the site count, THIN_1PX and the 0.55× plant
+    const f = DRAWN_FRAMES[A.roster];
+    if (!f) throw new Error(`--roster ${A.roster}: not on DRAWN_FRAMES`);
+    const ref = authoredStroke(A.roster, A.fe ? { fe: resolvePath(A.fe) } : {});
+    let cleanRed = ref.why.length > 0,
+      hole = false;
+    for (const cell of cellsOf(A)) {
