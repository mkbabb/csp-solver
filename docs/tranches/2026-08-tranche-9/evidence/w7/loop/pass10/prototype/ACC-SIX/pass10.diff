index 00000000..e11baf5d
--- /dev/null
+++ b/web/frontend/e2e/count-yield.spec.ts
@@ -0,0 +1,561 @@
+import { test, expect, type Browser, type Page } from "@playwright/test";
+import { installTimeline } from "./lib/postpaint.mjs";
+import { atRest } from "./lib/rest-probes.mjs";
+
+// PRM: frozen — emulateMedia({reducedMotion:'reduce'}) before goto, in `open()` below. The row reads
+//   boxes, one text range and a painted timeline of that range, never a tween.
+
+/**
+ * T9-W7 ACC-SIX · THE COUNT YIELDS WHERE IT DOES NOT FIT, STAYS WHERE IT DOES, AND NEVER PAINTS A
+ * SECOND ROW (registry-v6 §2.12, registry-v7 §5 row 1–3; LAWS P7 §F "an e2e row DRIVES THE PRODUCT").
+ *
+ * The count ("N of M on the board") rides the margin strip's meta line beside the voice for the
+ * first three writes of a deal. Where the pair does not fit (a phone, a long hint, the widest 16x16
+ * count) the count gives up its line for the rest of the lesson and the strip stays ONE line, so W2's
+ * drawer tab and everything under the board hold still; where the pair fits it stays.
+ *
+ * The row DRIVES THE PRODUCT and writes nothing into a Vue-owned node (pass 7 set its widest voice
+ * with a hand-made span, the product's next hint patched its own line in beside it — two spans, a
+ * 41.59 px strip, a false gap): a real 16x16 deal (`?board=`, 86 givens, 170 writable) and the
+ * product's own hint button, four presses. Press 1 names a step, press 2 writes it (the count lays
+ * down, "1 of 170"), press 3 names the next step with a 34-character line ("E goes nowhere else in
+ * this column"), press 4 writes it.
+ *
+ * Per cell, three clauses, every pose (pass 9, the chair's ruling 3: the ABSOLUTE strip clause, keyed
+ * on `74a2b5d9`'s 20.8 px, MOVED to the painted reserve, which the note-reserve row reads; 20.8 is
+ * the control's, the reserve is the product's):
+ *   ROW — the count's text never sits below the voice's mid-line.
+ *   YIELD (393x699, 812x375 coarse) — from press 3 the count is gone and stays gone.
+ *   FIT (1280x800 fine, 844x390 coarse) — the count is laid beside the step's line at press 2 and
+ *     is still on the voice's row at press 3 ("1 of 170 on the board"): a yield keyed on the hint's
+ *     LENGTH ends the lesson here. SEAT: where a record stands in line two at press 3 (§7's ledger,
+ *     the WAVE union's `.margin-note-previous`; never on `74a2b5d9`), the record takes the count's
+ *     berth by the integrator's rule and the count must be gone and stay gone.
+ * And across presses 2 and 3, POST-PAINT (the ONE recorder's `range:` subject, a task queued from
+ * every rAF):
+ *   PAINT — 0 frames paint the count's text on a second row ("the same frame, before paint").
+ *
+ * RESIZE (pass 9, the pass-8 critic's G-RO): the yield's other half is a ResizeObserver on the block
+ * and the voice. With the count standing beside a voice at a width where it fits (the first voiced
+ * pose: press 2 on the union, press 3 on `74a2b5d9`, whose press-2 hint is silent; never press 3 under
+ * §7's seat), the window narrows (1280x800 to 393x699, 844x390 to 600x390), both schemes: the count
+ * must not sit on a second row
+ * when the strip settles, and no post-paint frame after the resize may paint it there.
+ * FONT (the hand's font landing): every font response is held until the count's write has run, then
+ * released; the same two clauses across the landing. The fallback face is WIDER than the hand, so
+ * under it the count has already yielded and a landing can only narrow the line: on this
+ * product the landing has no failing state, and the leg is a witness, not a gate (printed as such).
+ * METRIC (the landing's mechanism, made to bite): with the count standing beside the voice, the
+ * voice's glyph metrics widen in place (letter-spacing, no text change, no viewport change), which is
+ * what a narrower-fallback landing would do; the same two clauses.
+ *
+ * BORN-RED (the same tree built with one rewrite, `pass9/prototype/ACC-SIX/instruments/`):
+ * `overyield` (the yield keyed on the voice's length) reds FIT; `late150` (the report 150 ms late)
+ * reds PAINT; `noro` (no ResizeObserver) reds RESIZE.
+ */
+
+type Cell = { name: string; viewport: { width: number; height: number }; coarse: boolean; fits: boolean };
+const cells: Cell[] = [
+  { name: "393x699 coarse", viewport: { width: 393, height: 699 }, coarse: true, fits: false },
+  { name: "812x375 coarse", viewport: { width: 812, height: 375 }, coarse: true, fits: false },
+  { name: "1280x800 fine", viewport: { width: 1280, height: 800 }, coarse: false, fits: true },
+  { name: "844x390 coarse", viewport: { width: 844, height: 390 }, coarse: true, fits: true },
+];
+
+// A REAL 16x16 payload: a valid solved grid by the band pattern, 86 givens seeded, 170 writable.
+function mulberry(a: number) {
+  return () => {
+    a |= 0;
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+const SOL16 = Array.from({ length: 256 }, (_, i) => {
+  const r = Math.floor(i / 16);
+  return ((4 * (r % 4) + Math.floor(r / 4) + (i % 16)) % 16) + 1;
+});
+const KEEP16 = (() => {
+  const rnd = mulberry(20260923);
+  const idx = [...Array(256).keys()];
+  for (let i = 255; i > 0; i--) {
+    const j = Math.floor(rnd() * (i + 1));
+    [idx[i], idx[j]] = [idx[j], idx[i]];
+  }
+  return new Set(idx.slice(0, 86));
+})();
+const PUZ16 = SOL16.map((v, i) => (KEEP16.has(i) ? v.toString(36) : "0")).join("");
+const BOARD16 =
+  "?board=" +
+  btoa(String.fromCharCode(1) + "4." + PUZ16)
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+
+/** PASS 10 · the SAME deal transposed (rows <-> columns, the givens with them): a second real payload
+ *  whose first steps are named in the long "...in this column" form (G-FIT-UNION, below). */
+const PUZ16T = Array.from({ length: 256 }, (_, i) => PUZ16[(i % 16) * 16 + Math.floor(i / 16)]).join("");
+const BOARD16T =
+  "?board=" +
+  btoa(String.fromCharCode(1) + "4." + PUZ16T)
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+
+type Pose = {
+  strip: number;
+  tabY: number | null;
+  voice: string;
+  meta: string | null;
+  /** the count's TEXT (its Range, the box is 0 px tall) sits below the voice's mid-line */
+  metaRow2: boolean;
+  /** a record stands in line two (§7's ledger, `.margin-note-previous`; absent on `74a2b5d9`) */
+  record: boolean;
+  /** the voice's mid-line, the row-two threshold for the painted timeline */
+  voiceMid: number | null;
+  coarse: boolean;
+};
+// Read-only: nothing here writes to the page.
+const SNAP = (): Pose => {
+  const r2 = (n: number) => Math.round(n * 100) / 100;
+  const strip = r2(document.querySelector(".board-margin")?.getBoundingClientRect().height ?? -1);
+  const t = document.querySelector(".drawer-tab");
+  const tabY = t ? r2(t.getBoundingClientRect().y + scrollY) : null;
+  const voice = document.querySelector(".margin-note");
+  const meta = document.querySelector(".margin-note-meta");
+  const v = voice?.getBoundingClientRect();
+  const voiceMid = v ? v.top + v.height / 2 : null;
+  let metaRow2 = false;
+  if (meta && voiceMid !== null) {
+    const r = document.createRange();
+    r.selectNodeContents(meta);
+    metaRow2 = r.getBoundingClientRect().top > voiceMid;
+  }
+  return {
+    strip,
+    tabY,
+    voice: voice?.textContent?.trim() ?? "",
+    meta: meta?.textContent?.trim() ?? null,
+    metaRow2,
+    record: !!document.querySelector(".margin-note-previous:not(.is-hidden)"),
+    voiceMid,
+    coarse: matchMedia("(pointer: coarse)").matches,
+  };
+};
+/** A pose is read when two consecutive reads agree (the dock sheet slides ~700 ms). */
+async function settled(page: Page): Promise<Pose> {
+  let prev = "";
+  let pose!: Pose;
+  await expect
+    .poll(
+      async () => {
+        pose = await page.evaluate(SNAP);
+        const k = JSON.stringify(pose);
+        const same = k === prev;
+        prev = k;
+        return same;
+      },
+      { intervals: [250], timeout: 15000 },
+    )
+    .toBe(true);
+  return pose;
+}
+type Open = { scheme?: "light" | "dark"; holdFonts?: Promise<void>; board?: string };
+async function open(browser: Browser, cell: Cell, o: Open = {}) {
+  const ctx = await browser.newContext({
+    viewport: cell.viewport,
+    hasTouch: cell.coarse,
+    isMobile: false,
+    colorScheme: o.scheme ?? "light",
+  });
+  const page = await ctx.newPage();
+  if (o.holdFonts) {
+    const gate = o.holdFonts;
+    await page.route(/\.(woff2?|ttf|otf)(\?|$)/, async (r) => {
+      await gate;
+      await r.continue();
+    });
+  }
+  await page.emulateMedia({ reducedMotion: "reduce" });
+  // a held font holds the load event: the page is read from its DOM, never its load
+  await page.goto("/" + (o.board ?? BOARD16), o.holdFonts ? { waitUntil: "domcontentloaded" } : undefined);
+  await page.waitForSelector(".sudoku-cell", { timeout: 60000 });
+  if (!o.holdFonts) await page.evaluate(() => document.fonts.ready);
+  return { ctx, page };
+}
+/** The product's own hint, as `fillByHint` presses it (the first live match in the DOM). */
+const hint = (page: Page) =>
+  page.evaluate(() => {
+    const b = document.querySelector<HTMLButtonElement>('[aria-label*="Hint" i]:not([disabled])');
+    b?.click();
+    return !!b;
+  });
+const written = (page: Page) =>
+  page.evaluate(() =>
+    Number(document.querySelector('[role="progressbar"]')?.getAttribute("aria-valuetext")?.split(" ")[0] ?? -1),
+  );
+
+
+type Frame = { k: number; t: number; r: { x: number; y: number; w: number; h: number } | null };
+const stopTimeline = (page: Page) =>
+  page.evaluate(() => {
+    const w = window as unknown as { __pf: { on: boolean; post: Frame[] } };
+    w.__pf.on = false;
+    return w.__pf.post;
+  });
+/** Rest, then presses 1 and 2 (the count laid, "1 of 170"): the poses so far. `before2` runs just
+ *  before press 2 (the write that lays the count). */
+async function lay(page: Page, before2?: () => Promise<unknown>) {
+  const poses: Array<[string, Pose]> = [["rest", await settled(page)]];
+  for (let k = 0; k < 2; k++) {
+    if (k === 1 && before2) await before2();
+    expect(await hint(page)).toBe(true);
+    await expect.poll(() => written(page), { timeout: 10000 }).toBeGreaterThanOrEqual(k);
+    poses.push([`press${k + 1}`, await settled(page)]);
+  }
+  await expect.poll(() => written(page), { timeout: 10000 }).toBe(1);
+  poses.push(["laid", await settled(page)]);
+  return poses;
+}
+/** Rest, four presses; presses 2 and 3 are recorded post-paint (`range:` over the count's text): the
+ *  count's laying and the long line, so a yield at either press is inside the window. */
+async function drive(browser: Browser, cell: Cell) {
+  const { ctx, page } = await open(browser, cell);
+  const poses = await lay(page, () => page.evaluate(installTimeline, "range:.margin-note-meta"));
+  expect(await hint(page)).toBe(true);
+  poses.push(["press3", await settled(page)]);
+  const pf = await stopTimeline(page);
+  expect(await hint(page)).toBe(true);
+  await expect.poll(() => written(page), { timeout: 10000 }).toBe(2);
+  poses.push(["press4", await settled(page)]);
+  await ctx.close();
+  return { poses: Object.fromEntries(poses) as Record<string, Pose>, order: poses.map(([n]) => n), frames: pf };
+}
+/** Frames after `t0` whose count text paints below the settled voice's mid-line. */
+const rowTwo = (frames: Frame[], t0: number, mid: number) =>
+  frames.filter((f) => f.t > t0 && f.r && f.r.h > 0 && f.r.y > mid);
+
+for (const cell of cells) {
+  test(`the count ${cell.fits ? "stays where it fits" : "yields and stays gone"}, on one row, painting no second · ${cell.name}`, async ({
+    browser,
+  }) => {
+    test.setTimeout(180000);
+    const tree = await drive(browser, cell);
+    const P = tree.poses;
+    expect(P.rest.coarse, "the pointer regime is witnessed").toBe(cell.coarse);
+    expect(P.rest.meta, "no count before the first write").toBe(null);
+    // a FIT cell lays the count beside the step's line; a YIELD cell may already give it up at press 2
+    expect(cell.fits ? P.laid.meta : (P.laid.meta ?? "1 of 170 on the board"), "the count was laid down (the row's witness)").toBe(
+      "1 of 170 on the board",
+    );
+    expect(P.press3.voice.length, "press 3 speaks the long line").toBeGreaterThanOrEqual(30);
+
+    // soft from here: a broken tree shows EVERY clause it breaks, not the first
+    for (const n of tree.order) {
+      const p = P[n];
+      expect.soft(p.metaRow2, `${n}: ROW the count never sits on a second row`).toBe(false);
+    }
+    if (cell.fits && P.press3.record) {
+      // §7's seat (the WAVE integrator's, `MarginNote.vue` readYield): a record standing in line two
+      // takes the count's berth, a yield like any other. FIT's own pose is then `laid` (above).
+      expect.soft(P.press3.meta, "SEAT: a record in line two takes the count's berth").toBe(null);
+      expect.soft(P.press4.meta, "SEAT: once yielded the count stays gone (no blink)").toBe(null);
+    } else if (cell.fits) {
+      expect.soft(P.press3.meta, "FIT: beside the long line the count stays").toBe("1 of 170 on the board");
+      expect.soft(P.press4.meta, "FIT: the next write updates it in place").toBe("2 of 170 on the board");
+    } else {
+      expect.soft(P.press3.meta, "YIELD: beside the long line the count gives up its line").toBe(null);
+      expect.soft(P.press4.meta, "YIELD: once yielded the count stays gone (no blink)").toBe(null);
+    }
+    const mid = P.laid.voiceMid ?? 0;
+    const row2 = rowTwo(tree.frames, -Infinity, mid);
+    const withCount = tree.frames.filter((f) => f.r && f.r.h > 0).length;
+    expect.soft(tree.frames.length, "PAINT: the recorder read frames across presses 2 and 3").toBeGreaterThanOrEqual(10);
+    expect.soft(row2.length, `PAINT: frames painting the count on a second row (of ${tree.frames.length})`).toBe(0);
+    console.log(
+      `YIELD ${cell.name}: ` +
+        tree.order
+          .map((n) => `${n} strip ${P[n].strip} tab ${P[n].tabY} meta ${P[n].meta ?? "-"}${P[n].metaRow2 ? " ROW2" : ""}${P[n].record ? " RECORD" : ""}`)
+          .join(" · ") +
+        ` · press3 voice "${P.press3.voice}" (${P.press3.voice.length}) · post-paint frames ${tree.frames.length}, with count ${withCount}, row two ${row2.length}`,
+    );
+  });
+}
+
+/** Stand the count beside a voice, then run `turn` with the post-paint recorder on: the strip re-reads
+ *  its yield on the turn alone (no text changes). The stand is the first pose with a voice: `laid` where
+ *  the press-2 hint speaks (the union), press 3 where it is silent (`74a2b5d9`, whose voice first speaks
+ *  at press 3). Never press 3 when `laid` already speaks: on the union a record in line two takes the
+ *  count's berth at press 3 (§7's seat), and the turn must find the count standing. */
+async function across(page: Page, turn: () => Promise<void>) {
+  const poses = await lay(page);
+  if (!poses[poses.length - 1][1].voice) {
+    expect(await hint(page)).toBe(true);
+    poses.push(["press3", await settled(page)]);
+  }
+  const stand = poses[poses.length - 1][1];
+  await page.evaluate(installTimeline, "range:.margin-note-meta");
+  // The turn's clock starts at its `resize` event, not at the call: a viewport set between a frame's
+  // paint and its post-paint read makes that read force a layout at the new width that no frame has
+  // rendered (no ResizeObserver delivery, no paint). The first rendered frame at the new width runs
+  // the resize steps first. With no resize (the font's landing) the clock starts at the call.
+  const t0 = await page.evaluate(() => {
+    const w = window as unknown as { __rz?: number };
+    w.__rz = undefined;
+    addEventListener("resize", () => (w.__rz ??= performance.now()));
+    return performance.now();
+  });
+  await turn();
+  const after = await settled(page);
+  // The window must hold ten post-paint frames after the turn in both engines (WebKit's run at its
+  // shim's 25-50 Hz). Pass 10: an EVENT wait on the recorder's own count, then the ONE library's
+  // rest probe; pass 9's fixed 500 ms tail here was `lint:sleep`'s red (LAWS P9 §B, CHAIR p10 §21).
+  await expect
+    .poll(
+      () =>
+        page.evaluate((t) => {
+          const w = window as unknown as { __pf: { post: Frame[] }; __rz?: number };
+          const z = w.__rz ?? t;
+          return w.__pf.post.filter((f) => f.t > z).length;
+        }, t0),
+      { intervals: [100], timeout: 15000 },
+    )
+    .toBeGreaterThanOrEqual(10);
+  const rest = await atRest(page);
+  const frames = await stopTimeline(page);
+  const tz = (await page.evaluate(() => (window as unknown as { __rz?: number }).__rz)) ?? t0;
+  const before = Object.fromEntries(poses) as Record<string, Pose>;
+  const mid = after.voiceMid ?? 0;
+  const pre = rowTwo(frames, t0, mid).filter((f) => f.t <= tz);
+  return { before, stand, after, frames, t0, tz, pre, rest, row2: rowTwo(frames, tz, mid), late: frames.filter((f) => f.t > tz).length };
+}
+const show = (fs: Frame[], tz: number) => fs.map((f) => `k${f.k}@${(f.t - tz).toFixed(1)}ms y${f.r?.y}`).join(" ") || "none";
+
+const RESIZES: Array<{ from: Cell; to: { width: number; height: number } }> = [
+  { from: cells[2], to: { width: 393, height: 699 } },
+  { from: cells[3], to: { width: 600, height: 390 } },
+];
+for (const scheme of ["light", "dark"] as const)
+  for (const { from, to } of RESIZES)
+    test(`RESIZE: the count re-reads its yield when the strip narrows · ${from.name} → ${to.width}x${to.height} · ${scheme}`, async ({
+      browser,
+    }) => {
+      test.setTimeout(180000);
+      const { ctx, page } = await open(browser, from, { scheme });
+      const r = await across(page, () => page.setViewportSize(to));
+      await ctx.close();
+      expect(r.stand.voice && r.stand.meta && !r.stand.record, "the count stands beside a voice before the resize (the row's witness)").toBeTruthy();
+      expect.soft(r.after.metaRow2, "RESIZE: the count never sits on a second row once the strip settles").toBe(false);
+      expect.soft(r.late, "RESIZE: the recorder read frames after the resize").toBeGreaterThanOrEqual(10);
+      expect.soft(r.row2.length, `RESIZE: post-paint frames painting the count on a second row (of ${r.late})`).toBe(0);
+      console.log(
+        `RESIZE ${from.name} → ${to.width}x${to.height} ${scheme}: stand ${r.stand.voice ? "voiced" : "silent"} meta ${r.stand.meta} · after meta ${r.after.meta ?? "-"}${r.after.metaRow2 ? " ROW2" : ""} strip ${r.after.strip} voiceMid ${r.after.voiceMid?.toFixed(1)} · frames after ${r.late}, row two ${r.row2.length} [${show(r.row2, r.tz)}] · unrendered reads before the resize event ${r.pre.length} [${show(r.pre, r.tz)}]`,
+      );
+    });
+
+test(`FONT: the count re-reads its yield when the hand's font lands · ${cells[3].name}`, async ({ browser }) => {
+  test.setTimeout(180000);
+  let release!: () => void;
+  const held = new Promise<void>((res) => (release = res));
+  const { ctx, page } = await open(browser, cells[3], { holdFonts: held });
+  const status = await page.evaluate(() => document.fonts.status);
+  const r = await across(page, async () => {
+    release();
+    await page.evaluate(() => document.fonts.ready);
+  });
+  await ctx.close();
+  expect(status, "the fonts were still loading when the presses ran (the row's witness)").toBe("loading");
+  expect.soft(r.after.metaRow2, "FONT: the count never sits on a second row once the font lands").toBe(false);
+  expect.soft(r.row2.length, `FONT: post-paint frames painting the count on a second row (of ${r.late})`).toBe(0);
+  console.log(
+    `FONT ${cells[3].name}: status at the presses ${status} · stand voiceMid ${r.stand.voiceMid?.toFixed(1)} meta ${r.stand.meta} · after voiceMid ${r.after.voiceMid?.toFixed(1)} meta ${r.after.meta ?? "-"}${r.after.metaRow2 ? " ROW2" : ""} · frames after ${r.late}, row two ${r.row2.length}`,
+  );
+});
+
+for (const cell of [cells[2], cells[3]])
+  test(`METRIC: the count re-reads its yield when the voice's glyphs widen in place · ${cell.name}`, async ({ browser }) => {
+    test.setTimeout(180000);
+    const { ctx, page } = await open(browser, cell);
+    let px = 0;
+    const r = await across(page, async () => {
+      // the room left at the line's end, spread over the voice's letters plus 24 px: the count no
+      // longer fits beside the voice. Assembled at run time: a spec is a Tailwind source (T9-R6).
+      px = await page.evaluate(() => {
+        const block = document.querySelector(".margin-note-block")!.getBoundingClientRect();
+        const rg = document.createRange();
+        rg.selectNodeContents(document.querySelector(".margin-note-meta")!);
+        const room = block.right - rg.getBoundingClientRect().right;
+        const n = (document.querySelector(".margin-note")?.textContent ?? "").trim().length || 1;
+        return Math.ceil((Math.max(0, room) + 24) / n);
+      });
+      await page.addStyleTag({ content: [".margin-note", "{ letter-spacing:", px + "px !important }"].join(" ") });
+    });
+    await ctx.close();
+    console.log(
+      `METRIC ${cell.name}: letter-spacing ${px}px · stand ${r.stand.voice ? "voiced" : "silent"} meta ${r.stand.meta} · after meta ${r.after.meta ?? "-"}${r.after.metaRow2 ? " ROW2" : ""} voiceMid ${r.after.voiceMid?.toFixed(1)} · frames after ${r.late}, row two ${r.row2.length} [${show(r.row2, r.tz)}]`,
+    );
+    expect(r.stand.voice && r.stand.meta && !r.stand.record, "the count stands beside a voice before the widening (the row's witness)").toBeTruthy();
+    expect(r.after.meta === null || r.after.metaRow2, "the widening leaves no room beside the voice (the row's witness)").toBe(true);
+    expect.soft(r.after.metaRow2, "METRIC: the count never sits on a second row once the strip settles").toBe(false);
+    expect.soft(r.late, "METRIC: the recorder read frames after the widening").toBeGreaterThanOrEqual(10);
+    expect.soft(r.row2.length, `METRIC: post-paint frames painting the count on a second row (of ${r.late})`).toBe(0);
+  });
+
+/** PASS 10 · ABS IN A READING (the pass-9 critic's G-ABS; registry-v9 §6, SIX + LEDGER): pass 9 moved
+ *  the ABSOLUTE strip clause (keyed on the control's 20.8 px) to LEDGER's painted reserve, and no row
+ *  then read the strip WITH THE COUNT LAID. "The strip is one line either way, so the tab never moves
+ *  for the count" is read here as a difference, the count the one variable: the `laid` pose against
+ *  the last un-laid pose that speaks the same way (a voiced pose against `press1`, a silent one
+ *  against `rest`; `74a2b5d9`'s press-2 hint is silent, the union's speaks), so the reserve's own
+ *  motion between a silent and a voiced strip (LEDGER's, not the count's) is never charged here.
+ *  The in-run negative lays one more pixel under the block only while the count is laid
+ *  (`.meta-yields`): the strip must then move, or the row cannot see the class it gates. A MARGIN,
+ *  not padding: the preflight's border-box lets a silent block's `min-height` swallow a padding
+ *  pixel (`74a2b5d9`'s silent press 2 read Δstrip 0.00 under it), so a padding plant gates nothing
+ *  there. */
+const ABS_EPS = 0.05; // px: a literal, never derived from the reading
+for (const cell of [cells[1], cells[2], cells[3]])
+  test(`ABS: the strip and the tab never move for the count · ${cell.name}`, async ({ browser }) => {
+    test.setTimeout(180000);
+    const { ctx, page } = await open(browser, cell);
+    const P = Object.fromEntries(await lay(page)) as Record<string, Pose>;
+    const ref = P.laid.voice ? P.press1 : P.rest;
+    const refName = P.laid.voice ? "press1" : "rest";
+    const laidUp = P.laid.meta !== null && !P.laid.record;
+    let planted: Pose | null = null;
+    if (laidUp) {
+      // joined at run time: a spec is a Tailwind source (T9-R6)
+      await page.addStyleTag({ content: [".margin-note-block.meta-yields", "{ margin-bottom: 1px !important }"].join(" ") });
+      planted = await settled(page);
+    }
+    await ctx.close();
+    expect(laidUp, "the count is laid with no record in line two (the row's witness)").toBe(true);
+    expect(!!ref.voice, `the reference pose speaks as \`laid\` does (${refName})`).toBe(!!P.laid.voice);
+    const dS = P.laid.strip - ref.strip;
+    const dT = (P.laid.tabY ?? 0) - (ref.tabY ?? 0);
+    const pS = planted ? planted.strip - P.laid.strip : 0;
+    const pT = planted ? (planted.tabY ?? 0) - (P.laid.tabY ?? 0) : 0;
+    console.log(
+      `ABS ${cell.name}: ref ${refName} strip ${ref.strip} tab ${ref.tabY} · laid strip ${P.laid.strip} tab ${P.laid.tabY} meta ${P.laid.meta} · Δstrip ${dS.toFixed(2)} Δtab ${dT.toFixed(2)} · PLANT +1px margin on .meta-yields: Δstrip ${pS.toFixed(2)} Δtab ${pT.toFixed(2)}`,
+    );
+    expect.soft(Math.abs(dS), "ABS: the count adds no height to the strip").toBeLessThanOrEqual(ABS_EPS);
+    expect.soft(Math.abs(dT), "ABS: the tab never moves for the count").toBeLessThanOrEqual(ABS_EPS);
+    expect.soft(pS, "ABS PLANT: one pixel on the laid block moves the strip (the row can fail)").toBeGreaterThanOrEqual(0.5);
+  });
+
+/** PASS 10 · LIFE (the chair's pass-10 pick 4: THE SEAT GOVERNS) and SEAT's born-RED (the pass-9
+ *  critic's G-SEAT). The count lives from the deal's first write for as many writes as the lesson
+ *  runs, until the seat ends it: a record standing in line two (§7's ledger) takes the count's berth
+ *  and the lesson is OVER, so the count does not come back when that record LEAVES. Where no record
+ *  ever stands (`74a2b5d9`'s note has no line two) the lesson is the product's own: three writes,
+ *  one rest, then gone. Either way, once gone the count never returns inside the deal.
+ *
+ *  The seat's own EFFECT is read, not the template's hide: pass 9's SEAT asserts held while the
+ *  record stood, where `v-if="meta && !(metaYields && previous)"` hides the count whether or not the
+ *  seat ended the lesson (`noseat`, the seat line deleted, read 11/11 GREEN both engines). Here the
+ *  record is made to LEAVE through the product's own path: the press-2 cell is written over with
+ *  another digit, which falsifies the record line two holds, and the ledger strikes it. With the
+ *  seat the count stays gone; without it the template lets the lesson's count back (RED).
+ *  Plants (one rewrite each, the lane's evidence dir): `noseat` reds the seat disjunct on the union;
+ *  `lift4` (the lesson keyed on four writes) reds the three-writes disjunct on the tree. */
