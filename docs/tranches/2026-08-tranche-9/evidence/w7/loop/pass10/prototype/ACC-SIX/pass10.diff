+// A frame stream through the gate, one non-forced write per frame on its own rAF stamp; returns
+// the commits' stamps. `quant` rounds each stamp to the whole millisecond (WebKit's grain), and
+// the wall clock reads the same grain, so the gate's detector sees the clock the engine has.
+async function stream(hz: number, n: number, quant: boolean, jitter = 0) {
+  const t = { now: quant ? 1000 : 1000.25 };
+  const frontGate = await freshGate(t);
+  const hits: number[] = [];
+  let cur = 0;
+  const gate = frontGate(() => hits.push(cur));
+  let seed = 7;
+  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647; // deterministic
+  for (let k = 0; k < n; k++) {
+    const ideal = 1000.25 + (k * 1000) / hz + rnd() * jitter; // a pump is never early
+    cur = quant ? Math.floor(ideal) : ideal;
+    t.now = cur + (quant ? 0 : 0.35); // the callback runs a little after its frame
+    gate.write(k / n, false, cur);
+  }
+  const gaps = hits.slice(1).map((x, i) => x - hits[i]);
+  return {
+    hits,
+    perS: ((hits.length - 1) / (hits[hits.length - 1] - hits[0])) * 1000,
+    minGap: Math.min(...gaps),
+  };
+}
