diff --git a/web/frontend/e2e/rate-clock.ts b/web/frontend/e2e/rate-clock.ts
new file mode 100644
index 00000000..512119c4
--- /dev/null
+++ b/web/frontend/e2e/rate-clock.ts
@@ -0,0 +1,187 @@
+/**
+ * RATE CLOCKS — the ONE copy every rate or budget row ships beside (T9-W7 pass 6, the chair's
+ * instruments lane; registry-v5 §2.3; LAWS P5 "A rate or budget gate proves its ablation reds
+ * under a 60 Hz rAF shim or drives its own clock ≥120 Hz"). From ACC-FIVE's pass-5 critic
+ * (`critique/ACC-FIVE/instruments/front-rate-60hz.CRITIC.spec.ts`): with the budget deleted
+ * (FRONT_MIN_MS 16 → 0) G10 PASSED at 60.2/60.4/60.0 (chromium) and 58.0/61.4/58.4 (webkit) per
+ * second under a 60 Hz clock — a gate whose verdict was the host's display.
+ *
+ * Three init scripts (pass to `context.addInitScript`), each self-contained:
+ *   SIXTY_HZ      the critic's shim verbatim: rAF callbacks fire on the first native frame at or
+ *                 after each 16.667 ms due time — the NEGATIVE CONTROL clock.
+ *   DRIVEN_CLOCK  a JS animation clock at `hz` (default 125): rAF callbacks are dispatched from a
+ *                 setTimeout pump stamped on its vsync grid (pass 8; `stamp: "wall"` keeps the
+ *                 pass-6 `performance.now()` stamps), so a budget ablation reds on ANY host,
+ *                 including a 60 Hz panel and the runner's raster.
+ *   TICK_RECORDER records native rAF timestamps (no change to the clock), for the precondition.
+ * All three leave `window.__ticks` (ms timestamps of animation-clock ticks).
+ *
+ * `clockPrecondition(page)` reads `__ticks` over the window the row measured and returns the
+ * median rate; every rate row asserts it ≥ 1.5 × its budget (93.75 Hz for 62.5/s) BEFORE it
+ * reads its own numbers, so a slow clock REDS LOUDLY instead of passing a broken tree.
+ *
+ * PRODUCT COPY (e2e/, ACC-FIVE pass 6): the chair's pass6/instruments/rate-clock.ts but for three
+ * `export` keywords. The three clocks are reached only through `clockFor`, and knip reds an export
+ * nothing imports.
+ */
+import type { Page } from "@playwright/test";
+
+const SIXTY_HZ = () => {
+  const nat = window.requestAnimationFrame.bind(window);
+  let pending = new Map<number, FrameRequestCallback>();
+  let id = 1,
+    due = -1,
+    scheduled = false;
+  (window as unknown as { __ticks: number[] }).__ticks = [];
+  const pump = (ts: number) => {
+    scheduled = false;
+    if (due < 0) due = ts;
+    if (ts + 0.5 < due) {
+      scheduled = true;
+      nat(pump);
+      return;
+    }
+    due = Math.max(due + 1000 / 60, ts);
+    (window as unknown as { __ticks: number[] }).__ticks.push(ts);
+    const cbs = pending;
+    pending = new Map();
+    for (const cb of cbs.values()) cb(ts);
+  };
+  window.requestAnimationFrame = (cb) => {
+    const i = id++;
+    pending.set(i, cb);
+    if (!scheduled) {
+      scheduled = true;
+      nat(pump);
+    }
+    return i;
+  };
+  window.cancelAnimationFrame = (i) => {
+    pending.delete(i);
+  };
+};
+
+const DRIVEN_CLOCK = (o: { hz: number; stamp: "vsync" | "wall" } = { hz: 125, stamp: "vsync" }) => {
+  const period = 1000 / o.hz;
+  // THE STAMP IS THE FRAME'S VSYNC (ACC-FIVE pass 8). A panel hands every rAF callback of a frame
+  // the frame's own time, on a regular grid, whenever the task runs; a timer pump stamped with
+  // `performance.now()` at fire hands the timer's lateness to every frame (6.1-10.1 ms apart at
+  // 125 Hz, 12-22 ms at 60 Hz under load 40-55), and no A.6 gate can then keep two frames in a
+  // 16 ms slot: over 3 s of such ticks the A.6 optimum was 51.1/s chromium, 54.7/s WebKit at
+  // 125 Hz. So the pump stamps the grid time it was DUE, on the engine's own grain (WebKit's rAF
+  // times are whole milliseconds, floored), and a pump that fires a whole period late stamps
+  // the latest vsync, as a panel that dropped frames does. `stamp: "wall"` keeps the pass-6
+  // stamps for the proof.
+  const a = performance.now();
+  let b = a;
+  while (b === a) b = performance.now();
+  const whole = Math.abs(b - a - Math.round(b - a)) < 1e-9 && Math.abs(a - Math.round(a)) < 1e-9;
+  let pending = new Map<number, FrameRequestCallback>();
+  let id = 1,
+    timer: ReturnType<typeof setTimeout> | null = null,
+    next = -Infinity;
+  (window as unknown as { __ticks: number[] }).__ticks = [];
+  (window as unknown as { __drops: number }).__drops = 0;
+  const pump = () => {
+    timer = null;
+    const now = performance.now();
+    // THE STAMP IS THE LATEST VSYNC AT OR BEFORE THE WALL: a pump a whole period late has missed
+    // those vsyncs (dropped frames) and stamps the panel's current one, so a stamp is never more
+    // than one period old, as a panel's never is (stamped with the SCHEDULED vsync, 5-17 ms behind
+    // the wall in WebKit at load 50-60, a sequence consumer read 0 re-cuts in 3 of 9 WebKit runs,
+    // mechanism unnamed; 0 of 4 with this stamp); a timer may fire a fraction early (chromium:
+    // 0.5 ms), and a frame's time never runs ahead of the wall's
+    if (o.stamp !== "wall" && now - next >= period) {
+      const k = Math.floor((now - next) / period);
+      (window as unknown as { __drops: number }).__drops += k;
+      next += k * period;
+    }
+    const ts = o.stamp === "wall" ? now : Math.min(now, whole ? Math.floor(next) : next);
+    (window as unknown as { __ticks: number[] }).__ticks.push(ts);
+    const cbs = pending;
+    pending = new Map();
+    // each callback in its own guard, as native rAF runs them: one callback's throw must not
+    // drop the frame's other callbacks nor stop the clock (a thrown frame left pencil-boil's
+    // chain waiting on a frame that never came, and every sequence consumer read 0 re-cuts)
+    for (const cb of cbs.values())
+      try {
+        cb(ts);
+      } catch (e) {
+        (window as unknown as { __rafErrors?: string[] }).__rafErrors ??= [];
+        (window as unknown as { __rafErrors: string[] }).__rafErrors.push(String(e));
+        setTimeout(() => {
+          throw e;
+        });
+      }
+    if (pending.size) arm();
+  };
+  const arm = () => {
+    if (timer != null) return;
+    const now = performance.now();
+    if (o.stamp === "wall" || !Number.isFinite(next)) next = Math.max(next + period, now);
+    else {
+      next += period;
+      // the vsyncs a late pump missed are dropped frames; an idle clock resumes on its grid
+      if (next < now) {
+        const k = Math.ceil((now - next) / period);
+        if (pending.size && k < 10) (window as unknown as { __drops: number }).__drops += k;
+        next += k * period;
+      }
+    }
+    timer = setTimeout(pump, Math.max(0, next - now));
+  };
+  window.requestAnimationFrame = (cb) => {
+    const i = id++;
+    pending.set(i, cb);
+    arm();
+    return i;
+  };
+  window.cancelAnimationFrame = (i) => {
+    pending.delete(i);
+  };
+};
+
+const TICK_RECORDER = () => {
+  const nat = window.requestAnimationFrame.bind(window);
+  const w = window as unknown as { __ticks: number[] };
+  w.__ticks = [];
+  const tick = (ts: number) => {
+    w.__ticks.push(ts);
+    nat(tick);
+  };
+  nat(tick);
+};
+
+/** The median animation-clock rate (Hz) over ticks at or after `since` (performance.now()). */
+export async function clockHz(page: Page, since = 0): Promise<{ hz: number; gaps: number }> {
+  return page.evaluate((since) => {
+    const t = ((window as unknown as { __ticks?: number[] }).__ticks ?? []).filter((x) => x >= since);
+    const g = t
+      .slice(1)
+      .map((x, i) => x - t[i])
+      .filter((d) => d < 100)
+      .sort((a, b) => a - b);
+    const med = g.length ? g[g.length >> 1] : Infinity;
+    return { hz: 1000 / med, gaps: g.length };
+  }, since);
+}
+
+/** The init script a row runs under, keyed by CLOCK=60|driven|native (default driven) and, for
+ *  the driven clock, HZ (default 125) and STAMP=vsync|wall (default vsync). A driven clock below
+ *  the budget's 93.75 Hz is a FLOOR row (ACC-FIVE pass 8, LAWS P7 §F: every rate row reads 60 Hz
+ *  AND 30 Hz beside the driven 125): it cannot see the ceiling broken, and it is the one clock
+ *  that sees a gate slow a true 60 Hz panel. `hz` is the rate the row asked for. */
+export function clockFor(
+  env = process.env.CLOCK ?? "driven",
+  hz = Number(process.env.HZ ?? 125),
+  stamp = (process.env.STAMP ?? "vsync") as "vsync" | "wall",
+): {
+  name: string;
+  script: (() => void) | ((o: { hz: number; stamp: "vsync" | "wall" }) => void);
+  arg?: { hz: number; stamp: "vsync" | "wall" };
+  hz?: number;
+} {
+  if (env === "60") return { name: "60 Hz shim (negative control)", script: SIXTY_HZ };
+  if (env === "native") return { name: "native (recorded)", script: TICK_RECORDER };
+  return { name: `driven ${hz} Hz (${stamp} stamps)`, script: DRIVEN_CLOCK, arg: { hz, stamp }, hz };
+}
diff --git a/web/frontend/e2e/tally-flash.spec.ts b/web/frontend/e2e/tally-flash.spec.ts
new file mode 100644
index 00000000..51367278
--- /dev/null
+++ b/web/frontend/e2e/tally-flash.spec.ts
@@ -0,0 +1,87 @@
+// PRM: live, because the subject IS the draw-in: under reduced motion the tally snaps inked and
+// there is no first frame to read.
+import { test, expect } from "@playwright/test";
+import { installTimeline } from "./lib/postpaint.mjs";
+
+/**
+ * THE TALLY NEVER PAINTS A NEW TIER WHOLE BEFORE IT DRAWS IN (T9-W7 ACC-FIVE pass 8; registry-v7
+ * §2.7c; LAWS P7 §F "a consumer that moved its first write out of the inking flush reads
+ * post-paint for a whole-then-empty frame").
+ *
+ * Pass 7 dropped the tally's forced start write and let the frame after the grade write it. The
+ * new tier's strokes took their `inked` class in the render the grade landed in, still at the
+ * reveal the last draw-in left them (whole), and drew in from empty one or two frames later: 4
+ * of 11 tier-changing inks flashed whole on that tree against 0 of 7 on the control (pass-7
+ * critique §1.4). The cure writes the start in the inking flush through the gate and commits the
+ * ink WITH the reveal, so a start the budget owes keeps the last committed tally until it lands.
+ *
+ * THE READ is the chair's painted timeline (`installTimeline`, `len:` subject): after every rAF a
+ * task reads the inked strokes' count and their summed DRAWN length (geometry, or a dash's drawn
+ * fraction on a tree that still dashes). An ink's first frame L is the first read at the settled
+ * count with ≤ 30 % of the settled length; a FLASH is any read before L at the settled count with
+ * ≥ 90 % of it, on an act that changed the count. Acts: fresh loads (HARD / EASY alternating) and
+ * in-app re-deals, until ≥ 10 tier-changing inks have been read or 40 acts have run.
+ *
+ * BORN-RED: pass 7's tally (no start write, the class from the props) flashes; a run that reads
+ * fewer than 10 tier-changing inks reds on the count, so an empty run cannot pass.
+ */
+const MIN_INKS = 10;
+const MAX_ACTS = 40;
+const TALLY = ".difficulty-tally .dt-stroke.inked";
+
+type Read = { k: number; t: number; r: { x: number; y: number } | null };
+
+test("the tally's new strokes never paint whole before they draw in", async ({ browser }, testInfo) => {
+  test.setTimeout(600000);
+  const ctx = await browser.newContext({ viewport: { width: 1280, height: 800 }, reducedMotion: "no-preference" });
+  await ctx.addInitScript(installTimeline, `len:${TALLY}`);
+  const page = await ctx.newPage();
+  const drain = () =>
+    page.evaluate(() => {
+      const w = window as unknown as { __pf: { post: Read[] } };
+      const r = w.__pf.post;
+      w.__pf.post = [];
+      return r;
+    });
+  const count = () => page.evaluate((s) => document.querySelectorAll(s).length, TALLY);
+  const judge = (reads: Read[], n0: number) => {
+    const s = reads.filter((x) => x.r).map((x) => ({ n: x.r!.y, len: x.r!.x, t: x.t }));
+    const settled = s[s.length - 1];
+    const full = settled?.len ?? 0;
+    const nF = settled?.n ?? 0;
+    const L = s.findIndex((x) => x.n === nF && nF > 0 && full > 0 && x.len / full <= 0.3);
+    let flash = 0;
+    if (L > 0 && nF !== n0) for (let k = 0; k < L; k++) if (s[k].n === nF && s[k].len / full >= 0.9) flash++;
+    return { n0, nF, inked: L >= 0, changed: L >= 0 && nF !== n0, flash };
+  };
+  const rows: ReturnType<typeof judge>[] = [];
+  const log = (act: string, r: ReturnType<typeof judge>) => {
+    rows.push(r);
+    console.log(`TALLY-FLASH ${testInfo.project.name} ${act} ${JSON.stringify(r)}`);
+  };
+  for (let i = 0; rows.length < MAX_ACTS && rows.filter((r) => r.changed).length < MIN_INKS; i++) {
+    const diff = i % 2 ? "EASY" : "HARD";
+    await page.goto(`/?size=3&difficulty=${diff}`);
+    await page.waitForSelector(".sudoku-cell", { timeout: 60000 });
+    await page
+      .waitForFunction(() => !document.querySelector(".difficulty-tally")?.classList.contains("is-ungraded"), null, { timeout: 60000 })
+      .catch(() => {});
+    await page.waitForTimeout(2500);
+    log(`load ${diff}`, judge(await drain(), 0));
+    for (let d = 0; d < 2; d++) {
+      const n0 = await count();
+      await drain();
+      await page.locator('button[aria-label="Deal a new board"]').first().click();
+      await page.waitForTimeout(4000);
+      log(`re-deal ${diff}`, judge(await drain(), n0));
+    }
+  }
+  const inks = rows.filter((r) => r.changed);
+  const flashes = inks.filter((r) => r.flash > 0);
+  const line = `${flashes.length} of ${inks.length} tier-changing inks flash whole (${rows.filter((r) => r.inked).length} inks over ${rows.length} acts)`;
+  console.log(`TALLY-FLASH ${testInfo.project.name} SUMMARY ${line}`);
+  testInfo.annotations.push({ type: "tally-flash", description: line });
+  expect(inks.length, `only ${inks.length} tier-changing inks were read: the row saw too little to pass`).toBeGreaterThanOrEqual(MIN_INKS);
+  expect(flashes.length, line).toBe(0);
+  await ctx.close();
+});
diff --git a/web/frontend/e2e/wash-step.spec.ts b/web/frontend/e2e/wash-step.spec.ts
new file mode 100644
index 00000000..f692864c
--- /dev/null
+++ b/web/frontend/e2e/wash-step.spec.ts
@@ -0,0 +1,154 @@
+import { test, expect } from "@playwright/test";
+import { onOff, lum, ratio } from "./lib/paint-lib.mjs";
+
+// PRM: frozen — emulateMedia({reducedMotion:'reduce'}) before goto. The row reads one painted ground at rest.
+
+/**
+ * T9-W7 ACC-SIX pass 8 · THE WASH, READ AS PAINTED (the behavioural row beside `check-theme-tokens`'
+ * wash reach; LAWS P7 §F (iii): every source law pairs with a paint read on the real surface).
+ *
+ * `.cell-peer` — the selected cell's row / column / box reach — paints ONE ground token whose arm
+ * the const in index.css names. The row selects an empty cell on a real 9x9 deal (`?board=`, 30
+ * givens), photographs the inner 40 % of an empty PEER cell with its wash and with the wash layer
+ * hidden (the SAME pixels, one variable), and reads the step between them (WCAG ratio of the mean
+ * luminances). The step is the wash: it must not fall under HEAD's own painted step in that cell
+ * (the readings below), less 0.001.
+ *
+ * IN-RUN PLANTS (each must RED, the negative in the same run): W1 the consumer faded
+ * (`.cell-peer { opacity: .2 }`: 1.017-1.026 on GRAPHITE's tree) and W5 an `@property`
+ * re-registration of the token with `initial-value: transparent` (1.000: the consumer never
+ * inherits the const). A source gate reads neither in paint; this row reads both.
+ *
+ * PASS 9 (the pass-8 critic's G-W7): the row reads BOTH contrast arms (LAWS P7 §E(i)). Under
+ * `prefers-contrast: more` the const's arm is re-declared at 13 %. Every floor is HEAD's own painted
+ * step in that cell (`74a2b5d9`: 1.078 / 1.103 no-preference, 1.143 / 1.224 more, the lowest of
+ * pass 8's and pass 9's reads) less 0.001, the photograph's measured spread (1.103-1.104). Pass 8's
+ * 0.006 was wider than the edge: WebKit paints the 12 % contrast arm at 1.141 against 1.143, so
+ * the arm one percent under its pin read GREEN. In-run per arm: W7 the arm erased under
+ * `prefers-contrast: more` (1.000), and ε, the arm one percent under its pin (6 % / 12 %), which
+ * must read under the floor; the margin is printed beside every reading.
+ *
+ * PASS 10 (the pass-9 critic's gap 6): the step was rounded to three decimals and the floors are
+ * HEAD less one such quantum, so the clean read cleared by +0.001 in 6 of 8 cells and WebKit's ε
+ * (light, more) read 1.141 against 1.142: the bound's resolution WAS its margin. The step is now
+ * read unrounded and printed to four decimals with its margin. The floor stays a bound pinned to
+ * the control's same-payload reading (HEAD's step, `74a2b5d9`), and W1 / W5 / W7 stay in-run
+ * negatives that must read under it (each reds by 0.06 or more). ε, the arm one percent under its
+ * pin, is a WITNESS here, never a gate: its painted distance from HEAD is the floor's own
+ * quantum, so no ±ε pair in paint separates it from a photograph's rounding. The arm's percent is
+ * held by the SOURCE pin (`check-theme-tokens` W8 ± ε at 0.1 %), which is the gate for it. The
+ * witness prints its unrounded step and whether it read under the floor.
+ */
+
+const FLOOR = {
+  "no-preference": { light: 1.077, dark: 1.102 },
+  more: { light: 1.142, dark: 1.223 },
+} as const;
+// joined at run time: a product file is a Tailwind source (T9-R6)
+const arm = (pct: number) => "--wash-" + "blue: color-mix(in srgb, var(--color-crayon-blue) " + pct + "%, transparent)";
+const PLANTS = {
+  "no-preference": {
+    W1: ".cell-peer { opacity: 0.2 !important; }",
+    W5: "@property --ground-wash-unit { syntax: '<color>'; inherits: false; initial-value: transparent; }",
+    eps: `:root { ${arm(6)} !important; }`,
+  },
+  more: {
+    W1: ".cell-peer { opacity: 0.2 !important; }",
+    W7: "@media (prefers-contrast: more) { :root { --wash-" + "blue: transparent !important; } }",
+    eps: `@media (prefers-contrast: more) { :root { ${arm(12)} !important; } }`,
+  },
+} as const;
+
+// A REAL 9x9 payload: a valid solved grid by the band pattern, 30 givens seeded.
+const SOL9 = Array.from({ length: 81 }, (_, i) => {
+  const r = Math.floor(i / 9);
+  return ((3 * (r % 3) + Math.floor(r / 3) + (i % 9)) % 9) + 1;
+});
+const KEEP9 = new Set([0, 4, 8, 10, 13, 16, 20, 22, 24, 27, 31, 35, 37, 39, 41, 43, 45, 49, 53, 56, 58, 60, 64, 67, 70, 72, 76, 80, 2, 78]);
+const PUZ9 = SOL9.map((v, i) => (KEEP9.has(i) ? String(v) : "0")).join("");
+const BOARD9 =
+  "?board=" +
+  btoa(String.fromCharCode(1) + "3." + PUZ9)
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+
+type Page = import("@playwright/test").Page;
+type Px = { data: Uint8Array; w: number; h: number };
+/** The wash's step on ONE clip: mean luminance with the layer vs the same pixels without it. */
+async function step(page: Page, clip: { x: number; y: number; width: number; height: number }) {
+  const { on, off } = (await onOff(page, clip, ".cell-peer { display: none !important; }")) as { on: Px; off: Px };
+  const mean = (p: Px) => {
+    const n = p.w * p.h;
+    let s = 0;
+    for (let k = 0; k < n; k++) s += lum(p.data, k * 3);
+    return s / n;
+  };
+  return ratio(mean(on), mean(off));
+}
+
+for (const contrast of ["no-preference", "more"] as const)
+for (const scheme of ["light", "dark"] as const) {
+  test(`the wash paints its step over the card, and the plants that fade it red · ${scheme} · contrast ${contrast}`, async ({ browser }) => {
+    test.setTimeout(90000);
+    const ctx = await browser.newContext({
+      viewport: { width: 1280, height: 800 },
+      deviceScaleFactor: 1,
+      colorScheme: scheme,
+    });
+    const page = await ctx.newPage();
+    await page.emulateMedia({ reducedMotion: "reduce", contrast });
+    await page.goto("/" + BOARD9);
+    expect(await page.evaluate(() => matchMedia("(prefers-contrast: more)").matches), "the contrast arm is witnessed").toBe(contrast === "more");
+    await page.waitForSelector("svg.hand-drawn-grid", { timeout: 60000 });
+    await page.evaluate(() => document.fonts.ready);
+    const empty = await page.evaluate(() =>
+      Array.from(document.querySelectorAll(".game-cell input")).map(
+        (i) => !/given/i.test(i.getAttribute("aria-label") ?? "") && !(i as HTMLInputElement).value,
+      ),
+    );
+    const pick = [40, 30, 50, 21].find((i) => empty[i]);
+    expect(pick, "an empty cell to select").not.toBeUndefined();
+    await page.locator(".game-cell").nth(pick!).click();
+    await page.waitForTimeout(400);
+    const peers = await page.evaluate(() =>
+      Array.from(document.querySelectorAll(".game-cell")).map((c) => !!c.querySelector(".cell-peer")),
+    );
+    const r0 = Math.floor(pick! / 9);
+    const peer = [...Array(81).keys()].find((i) => i !== pick && peers[i] && empty[i] && Math.floor(i / 9) === r0);
+    expect(peer, "an empty peer cell in the selected row").not.toBeUndefined();
+    const b = (await page.locator(".game-cell").nth(peer!).boundingBox())!;
+    const clip = {
+      x: Math.round(b.x + b.width * 0.3),
+      y: Math.round(b.y + b.height * 0.3),
+      width: Math.max(2, Math.round(b.width * 0.4)),
+      height: Math.max(2, Math.round(b.height * 0.4)),
+    };
+    const clean = await step(page, clip);
+    const f4 = (v: number) => v.toFixed(4);
+    const planted: Record<string, number> = {};
+    for (const [k, css] of Object.entries(PLANTS[contrast])) {
+      const tag = await page.addStyleTag({ content: css });
+      await page.waitForTimeout(100);
+      planted[k] = await step(page, clip);
+      await tag.evaluate((e) => (e as Element).remove());
+    }
+    const computed = await page.evaluate(
+      (i) => getComputedStyle(document.querySelectorAll(".game-cell")[i].querySelector(".cell-peer")!).backgroundColor,
+      peer!,
+    );
+    const floor = FLOOR[contrast][scheme];
+    const margin = (v: number) => (v - floor >= 0 ? "+" : "") + (v - floor).toFixed(4);
+    console.log(
+      `WASH ${scheme} contrast ${contrast}: cell ${pick} peer ${peer} step ${f4(clean)} (floor ${floor}, margin ${margin(clean)}) · ` +
+        Object.entries(planted)
+          .map(([k, v]) => `${k}${k === "eps" ? " (witness)" : ""} ${f4(v)} (${margin(v)}${k === "eps" ? (v < floor ? ", under" : ", NOT under") : ""})`)
+          .join(" · ") +
+        ` · computed ${computed}`,
+    );
+    await ctx.close();
+    expect.soft(clean, "the wash's painted step clears HEAD's").toBeGreaterThanOrEqual(floor);
+    for (const [k, v] of Object.entries(planted))
+      if (k !== "eps") expect.soft(v, `plant ${k} must read under the floor (the row can fail)`).toBeLessThan(floor);
+  });
+}
