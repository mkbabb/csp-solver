+    const g0 = await glyphMap(page);
+    const seq: Array<[string, Pose]> = await lay(page);
+    const g1 = await glyphMap(page);
+    const wcell = g1.findIndex((g, i) => g && !g0[i]);
+    expect(await hint(page)).toBe(true);
+    seq.push(["press3", await settled(page)]);
+    const seat = seq[seq.length - 1][1].record;
+    let over: { was: string; key: string } | null = null;
+    if (seat) {
+      // THE SEAT DISJUNCT (the union): the record LEAVES, the lesson stays over
+      expect(wcell, "the press-2 write is found on the board").toBeGreaterThanOrEqual(0);
+      over = await overwrite(page, wcell);
+      seq.push(["left", await settled(page)]);
+      for (let k = 0; k < 2; k++) {
+        expect(await hint(page)).toBe(true);
+        seq.push([`after${k + 1}`, await settled(page)]);
+      }
+    } else {
+      // THE THREE-WRITES DISJUNCT (no line two): hint on until the third write has rested, then two more
+      for (let k = 4; k <= 12 && (await written(page)) < 3; k++) {
+        expect(await hint(page)).toBe(true);
+        seq.push([`press${k}`, await settled(page)]);
+      }
+      seq.push(["rested", await settled(page)]);
+      for (let k = 0; k < 2; k++) {
+        expect(await hint(page)).toBe(true);
+        seq.push([`after${k + 1}`, await settled(page)]);
+      }
+    }
+    const n = await written(page);
+    await ctx.close();
+    const line = seq.map(([k, p]) => `${k} ${p.meta ?? "-"}${p.record ? " R" : ""}`).join(" · ");
+    console.log(`LIFE ${cell.name}: ${seat ? "SEAT" : "THREE"} · cell ${wcell}${over ? ` ${over.was}->${over.key}` : ""} · written ${n} · ${line}`);
+    const P = Object.fromEntries(seq) as Record<string, Pose>;
+    expect(P.laid.meta, "the count was laid at the first write (the row's witness)").toBe("1 of 170 on the board");
+    const laidAt = seq.findIndex(([k]) => k === "laid");
+    const gone = seq.findIndex(([, p], i) => i > laidAt && p.meta === null);
+    expect.soft(gone, "LIFE: the lesson ends inside the run").toBeGreaterThan(0);
+    for (const [k, p] of seq.slice(gone > 0 ? gone : seq.length))
+      expect.soft(p.meta, `LIFE: once gone the count never comes back (${k})`).toBe(null);
+    if (seat) {
+      expect(P.left.record, "the record LEFT line two (the seat row's witness)").toBe(false);
+      expect.soft(P.press3.meta, "SEAT: the record takes the count's berth").toBe(null);
+      expect.soft(P.left.meta, "SEAT: the lesson ended at the seat, so the record's leaving brings no count back").toBe(null);
+    } else {
+      expect(n, "three writes were laid (the row's witness)").toBeGreaterThanOrEqual(3);
+      for (const [k, p] of seq)
+        if (/^press\d+$/.test(k) && p.meta !== null) expect.soft(p.meta, `THREE: the count follows the board (${k})`).toMatch(/^[123] of 170 on the board$/);
+      expect.soft(P.rested.meta, "THREE: after the third write's rest the lesson lifts").toBe(null);
+    }
+  });
+
+/** PASS 10 · G-FIT-UNION (the pass-9 critic's `len32`: a yield keyed on the voice's length >= 32 read
+ *  11/11 GREEN on the union, both engines, because the union's FIT cells read the count beside a
+ *  31-char voice at `laid` and SEAT swaps the press-3 assert away). FIT is read here at the FIRST
+ *  pose where the count stands (or should) beside a LONG line with no record in line two: the
+ *  transposed deal, whose steps are named "...in this column". The voice's length at that pose is
+ *  printed, never assumed; a yield keyed on any length the pose carries reds this row. */
+for (const cell of [cells[2], cells[3]])
+  test(`FIT-LONG: beside the long line, with no record, the count stays · ${cell.name}`, async ({ browser }) => {
+    test.setTimeout(240000);
+    // BOTH deals, every qualifying pose: the union's long line comes at `laid` of the transposed deal
+    // (its press-3 line stands beside a record), `74a2b5d9`'s at press 3 of the base deal (its press-2
+    // hint is silent). No fallback: a qualifying pose on either deal is read, and at least one must exist.
+    const read: Array<[string, Pose]> = [];
+    for (const [deal, board] of [["T", BOARD16T], ["B", BOARD16]] as const) {
+      const { ctx, page } = await open(browser, cell, { board });
+      const seq: Array<[string, Pose]> = await lay(page);
+      expect(await hint(page)).toBe(true);
+      seq.push(["press3", await settled(page)]);
+      await ctx.close();
+      const laidAt = seq.findIndex(([k]) => k === "laid");
+      seq.forEach(([k, p], i) => {
+        if (i >= laidAt && p.voice.length >= 32 && !p.record) read.push([`${deal}:${k}`, p]);
+      });
+      console.log(
+        `FIT-LONG ${cell.name} deal ${deal}: ` + seq.map(([k, p]) => `${k} voice(${p.voice.length}) meta ${p.meta ?? "-"}${p.record ? " R" : ""}`).join(" · "),
+      );
+    }
+    console.log(`FIT-LONG ${cell.name}: read at ${read.map(([k, p]) => `${k}(${p.voice.length})`).join(", ") || "none"}`);
+    expect(read.length, "a pose with the count's lesson open, a voice of 32+ chars and no record (the row's witness)").toBeGreaterThan(0);
+    for (const [k, p] of read) {
+      expect.soft(p.meta, `FIT-LONG ${k}: the count stays beside a ${p.voice.length}-char line`).toBe("1 of 170 on the board");
+      expect.soft(p.metaRow2, `FIT-LONG ${k}: on the voice's row`).toBe(false);
+    }
+  });
