+import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
+import { mount } from "@vue/test-utils";
+import { nextTick } from "vue";
+import GameBoard from "./GameBoard.vue";
+import MarginNote from "@pencil/chrome/MarginNote.vue";
+import { MOTION } from "@pencil/config/pencilConfig";
+
+/**
+ * T9-W7 ACC-SIX — THE COUNT, IN THE MARGIN.
+ *
+ * The board's one memorable sentence, and the whole of it is a lifecycle: laid down on the
+ * FIRST write of a deal, updated in place, lifted after `min(3, writable)` writes, and never
+ * seen again on that board. Four of the rows below were the pass-2 critique's open findings —
+ * the lesson taught twice after an undo, the lesson that never lifted on a stalled board, the
+ * phantom fourth fill on a leashed deal, the resurrection on a clear — so each is written as
+ * the reader's own sequence rather than as an assertion about a flag.
+ *
+ * The line rides `MarginNote`'s `meta` slot, and `MarginNote` IS NOT STUBBED HERE (pass 4).
+ * It was: a hand-written stub whose template dropped the real component's `:key="meta"`, so
+ * the row named "updates in place" asserted text only and could not see the re-mount it is
+ * named for — the gate-that-cannot-fail class. The real component is mounted instead, so the
+ * in-place row reads the real template forever and reds the day a key comes back.
+ */
+const STUBS = {
+  HandDrawnGrid: true,
+  CelebrationStar: true,
+  CelebrationHeart: true,
+  CompletionVignette: true,
+  SolverErrorNote: true,
+};
+
+const REST_MS = 250 + MOTION.chromeLeaveMs;
+
+function emptyValues(total = 16) {
+  const v: Record<string, number> = {};
+  for (let i = 0; i < total; i++) v[String(i)] = 0;
+  return v;
+}
+
+function mountBoard(props: Record<string, unknown> = {}) {
+  return mount(GameBoard, {
+    props: {
+      boardSize: 4,
+      totalCells: 16,
+      values: emptyValues(),
+      givenCells: new Set<string>(),
+      animatingCells: new Set<string>(),
+      solveState: "idle",
+      boardGeneration: 1,
+      subgridSize: 2,
+      gridLabel: "4 by 4 sudoku board",
+      conflictsFn: () => ({ positions: new Set<string>(), unit: null }),
+      peersFn: () => new Set<string>(),
+      freshBoardCopy: () => "",
+      ...props,
+    },
+    global: { stubs: STUBS },
+  });
+}
+
+type Board = ReturnType<typeof mountBoard>;
+const line = (w: Board) =>
+  w.find(".margin-note-meta").exists() ? w.get(".margin-note-meta").text() : null;
+
+/**
+ * Bring the board to `n` written cells ONE WRITE AT A TIME — the player's own rhythm, and the
+ * rhythm the lay-down rule is written in. (A jump straight from 0 to 3 is a RESTORE, not a
+ * first write, and the rule is meant to sleep through it; the restored-session row says so.)
+ */
+async function write(w: Board, n: number, total = 16) {
+  const values = emptyValues(total);
+  let at = 0;
+  for (const [pos, v] of Object.entries(w.props("values") as Record<string, number>))
+    if (v !== 0) {
+      values[pos] = v;
+      at++;
+    }
+  while (at !== n) {
+    if (at < n) {
+      values[String(at)] = 1;
+      at++;
+    } else {
+      at--;
+      values[String(at)] = 0;
+    }
+    await w.setProps({ values: { ...values } });
+    await nextTick();
+  }
+}
+
+describe("GameBoard — the count line's literal", () => {
+  beforeEach(() => vi.useFakeTimers());
+  afterEach(() => vi.useRealTimers());
+
+  it("says `N of M on the board` on the first write, and nothing before it", async () => {
+    const w = mountBoard();
+    expect(line(w)).toBe(null);
+    await write(w, 1);
+    expect(line(w)).toBe("1 of 16 on the board");
+    w.unmount();
+  });
+
+  it("updates in place on the writes that follow — the SAME node, not a re-mount", async () => {
+    // The pass-3 critique's §2.1, as the reader's own sequence: the sentence is laid down
+    // once and the text patches. Element identity is the mechanism's own witness — with
+    // `:key="meta"` back on `MarginNote`'s meta line this row reds at write 2 (verified by
+    // ablation, pass4/prototype/ACC-SIX §1), while a text-only assertion stays green.
+    const w = mountBoard();
+    await write(w, 1);
+    const first = w.get(".margin-note-meta").element;
+    await write(w, 2);
+    expect(line(w)).toBe("2 of 16 on the board");
+    expect(w.get(".margin-note-meta").element).toBe(first);
+    await write(w, 3);
+    expect(line(w)).toBe("3 of 16 on the board");
+    expect(w.get(".margin-note-meta").element).toBe(first);
+    w.unmount();
+  });
+
+  it("counts the WRITABLE cells, never the board's squares", async () => {
