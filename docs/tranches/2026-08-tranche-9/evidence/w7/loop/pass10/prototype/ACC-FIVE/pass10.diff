+  const rows = await page.evaluate(async ([streams, mod]) => {
+    const m = await import(/* @vite-ignore */ mod);
+    return streams.map(([hz, quant]) => {
+      const hits: number[] = [];
+      let cur = 0;
+      const g = m.frontGate(() => hits.push(cur));
+      const t0 = Math.round(performance.now()) + 5000;
+      const n = Math.round(hz * 2);
+      for (let k = 0; k < n; k++) {
+        const t = t0 + (k * 1000) / hz;
+        cur = quant ? Math.round(t) : t;
+        g.write(k / n, false, cur);
+      }
+      const gaps = hits.slice(1).map((x, i) => x - hits[i]);
+      return { hz, quant, frames: n, commits: hits.length, perS: ((hits.length - 1) / (hits[hits.length - 1] - hits[0])) * 1000, minGap: Math.min(...gaps) };
+    });
+  }, [[[60, true], [60, false], [30, true], [30, false], [120, true], [125, true], [125, false], [75, false], [90, false], [100, false], [144, false], [165, false], [240, false]] as [number, boolean][], "/src/pencil/grid/gridPaths.ts"] as const);
