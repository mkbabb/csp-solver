+    const a = performance.now();
+    let b = a;
+    while (b === a) b = performance.now();
+    return Math.abs(b - a - Math.round(b - a)) < 1e-9 ? "whole-ms" : "fine";
+  });
+  // the floor's share is the battery's knob (G10_PANEL_SHARE=1±ε pins the margin: the gate keeps
+  // A.6's best to within ε at every rate); the gate runs at FLOOR_SHARE
+  const share = Number(process.env.G10_PANEL_SHARE ?? FLOOR_SHARE);
+  const lines = rows.map((r) => {
+    const floor = share * a6Best(r.hz);
