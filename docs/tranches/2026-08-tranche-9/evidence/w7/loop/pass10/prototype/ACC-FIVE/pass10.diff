+          `corridor ${theme}: ${CORRIDOR.ink} vs ${g} is ${cr.toFixed(3)} — under ${CORRIDOR.floor} + ${CORRIDOR_MARGIN} of margin (token arithmetic; the painted row is e2e/progress-corridor.spec.ts)`,
+        );
+    }
+  }
+  return out;
+}
+
+/** the two scopes, re-derived per call so a self-test's mutated css is what gets graded */
+const themesScopes = (css) => ({
+  light: scopeOf(css, "@theme {"),
+  dark: scopeOf(css, "\n.dark {"),
+});
