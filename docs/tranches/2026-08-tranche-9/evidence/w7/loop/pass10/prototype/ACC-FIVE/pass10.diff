+/**
+ * THE FILL GAUGE'S CORRIDOR, PAINTED (T9-W7 §2/§4, gate G2).
+ *
+ * The gauge is the one accent on the board with THREE grounds at once: the graphite frame line it
+ * retraces (an 8-unit stroke inside a 12-unit one leaves a ~1.27 CSS px flank per side at desk,
+ * 0.73 at phone), the paper behind that, and the board wrapper's own 2 px border, which the
+ * stroke's outer overhang covers (T9-W7 pass 6: a quarter of the trace's footprint at desk; the
+ * pass-2..5 gold read 2.970 on it, under the floor, while this file checked two grounds). They swap value between themes. So "clears 3:1" is
+ * an INTERVAL the ink has to sit inside, not a number it has to beat — and this file asserts the
+ * interval against PAINTED BYTES, because token arithmetic over-reports a hand-drawn line by
+ * ~0.5 (a 12-unit wobbled stroke never paints its own token at full strength). The node arm in
+ * `scripts/check-ink-pressure.mjs` carries the same corridor in token space, labelled as such;
+ * where the two disagree, THIS one governs.
+ *
+ * WHY THE GROUND IS READ AT PROGRESS 0. At `progress === 0` the trace's `v-for` yields nothing —
+ * there is no `.progress-trace` node in the DOM at all (HandDrawnGrid) — so the frame line and
+ * the paper are read off a board that provably has no gauge on it. The pass-2 instrument sampled
+ * an untraced EDGE of a traced board and had to argue it was clean; this samples an untraced
+ * BOARD and does not have to argue anything.
+ *
+ * THE CORE IS THE MODE OF 24 COLUMNS, not the single most chromatic pixel. A wobbled stroke's
+ * peak pixel is its own best case and moves with the seed; the modal column core is the colour
+ * the stroke actually paints across its run. The max-chroma pixel is asserted too, at the same
+ * floor, so the margin is what survives EITHER instrument.
+ */
+
+const FLOOR = 3;
+const HUE_WINDOW = 45; // degrees either side of the gold anchor: what counts as "the gauge"
+/** THE CHROMA FLOOR, and it is load-bearing. The gauge paints C 0.122 light / 0.100 dark; the
+ *  frame line paints C 0.011. Without this floor a column the front has not reached contributes
+ *  the LINE as its "core", and on a lightly filled board the mode of 24 columns is then the line
+ *  itself — which reads 1.0 against the line and passes nothing. Measured, not guessed. */
+const CHROMA_FLOOR = 0.05;
+const GOLD_HUE: Record<string, number> = { light: 83.7, dark: 95.2 };
+/** THE BORDER ROW'S FLOOR. Light: the 3:1 floor, which one ink clears on all three grounds
+ *  (painted luminance 0.1922–0.2300). Dark: NO ink clears 3:1 against the light line, the dark
+ *  paper and the dark border at once (the best is 2.914, arithmetic from the painted grounds), so
+ *  the row is held to what HEAD's violet painted there — 2.441 at 74a2b5d9, both engines — and a
+ *  gauge may not lose to it. That number is a floor, not a pass: the estate row is the border's. */
+const BORDER_FLOOR: Record<string, number> = { light: FLOOR, dark: 2.441 };
+
+type Rgb = [number, number, number];
+
+const srgbToLinear = (c: number) => {
+  const x = c / 255;
+  return x <= 0.04045 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4);
+};
+// WCAG luminance and contrast through the ONE paint library at its product home (registry-v7
+// §2.4, LAWS P7 §I): this file carried its own copy until pass 8.
+const lum = (c: Rgb): number => paintLum(c, 0);
+const ratio = (a: Rgb, b: Rgb): number => paintRatio(lum(a), lum(b));
+
+/** sRGB -> OKLCH (Ottosson), the space the estate's tiers were cut in. */
+function oklch([r, g, b]: Rgb) {
+  const [R, G, B] = [srgbToLinear(r), srgbToLinear(g), srgbToLinear(b)];
+  const l = Math.cbrt(0.4122214708 * R + 0.5363325363 * G + 0.0514459929 * B);
+  const m = Math.cbrt(0.2119034982 * R + 0.6806995451 * G + 0.1073969566 * B);
+  const s = Math.cbrt(0.0883024619 * R + 0.2817188376 * G + 0.6299787005 * B);
+  const A = 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s;
+  const Bb = 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s;
+  return {
+    L: 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s,
+    C: Math.hypot(A, Bb),
+    h: ((Math.atan2(Bb, A) * 180) / Math.PI + 360) % 360,
+  };
+}
+const hueGap = (a: number, b: number) => {
+  const d = Math.abs(a - b) % 360;
+  return d > 180 ? 360 - d : d;
+};
+
+/**
+ * A painted band, decoded BY THE ENGINE THAT PAINTED IT.
+ *
+ * This file used to `import { PNG } from "pngjs"` — and `pngjs` is not a dependency of this
+ * package, so the spec could not resolve its own import and had never been run (T9-W7 pass 4;
+ * the pass-3 critique said "written and never executed" and the reason was one level lower than
+ * that). The estate installs nothing for a gate, so the screenshot goes back INTO the page and
+ * is decoded on a canvas: the same sRGB bytes, no Node image library, and the decode happens in
+ * the browser whose raster is the subject.
+ */
+type Band = { w: number; h: number; data: number[] };
+
+async function band(page: Page, clip: { x: number; y: number; width: number; height: number }) {
+  const b64 = (await page.screenshot({ clip })).toString("base64");
+  return page.evaluate(async (d): Promise<Band> => {
+    const img = new Image();
+    img.src = "data:image/png;base64," + d;
+    await img.decode();
+    const c = document.createElement("canvas");
+    c.width = img.naturalWidth;
+    c.height = img.naturalHeight;
+    const ctx = c.getContext("2d", { willReadFrequently: true })!;
+    ctx.drawImage(img, 0, 0);
+    return {
+      w: c.width,
+      h: c.height,
+      data: Array.from(ctx.getImageData(0, 0, c.width, c.height).data),
+    };
+  }, b64);
+}
+
+const px = (b: Band, x: number, y: number): Rgb => {
+  const o = (b.w * y + x) << 2;
+  return [b.data[o], b.data[o + 1], b.data[o + 2]];
+};
+
+/** the most frequent colour over whole rows of a band that passes `keep` (null if none does) */
+function modalRows(b: Band, rows: number[], keep: (c: Rgb) => boolean): Rgb | null {
+  const freq = new Map<string, number>();
+  for (const y of rows) {
+    if (y < 0 || y >= b.h) continue;
+    for (let x = 0; x < b.w; x++) {
+      const k = px(b, x, y).join(",");
+      freq.set(k, (freq.get(k) ?? 0) + 1);
+    }
+  }
+  for (const [k] of [...freq.entries()].sort((a, c) => c[1] - a[1])) {
+    const rgb = k.split(",").map(Number) as Rgb;
+    if (keep(rgb)) return rgb;
+  }
+  return null;
+}
+
+/** paper = the modal colour; line = the modal ACHROMATIC colour that is neither paper nor its edge */
+function groundOf(b: Band) {
+  const freq = new Map<string, number>();
+  for (let y = 0; y < b.h; y++)
+    for (let x = 0; x < b.w; x++) {
+      const k = px(b, x, y).join(",");
+      freq.set(k, (freq.get(k) ?? 0) + 1);
+    }
+  const ranked = [...freq.entries()].sort((a, b) => b[1] - a[1]);
+  const paper = ranked[0][0].split(",").map(Number) as Rgb;
+  let line: Rgb | null = null;
+  for (const [k] of ranked) {
+    const rgb = k.split(",").map(Number) as Rgb;
+    if (k === ranked[0][0]) continue;
+    if (oklch(rgb).C > 0.03) continue;
+    if (Math.abs(lum(rgb) - lum(paper)) < 0.05) continue;
+    line = rgb;
+    break;
+  }
+  return { paper, line };
+}
+
+/**
+ * The MODE of 24 per-column cores, and the single max-chroma pixel beside it.
+ *
+ * THE NO-GAUGE-PIXEL CASE IS A NAMED FAILURE, NOT A CRASH (T9-W7 pass-4, critique §3.6). The
+ * hue window pre-selects pixels within 45° of the gold anchor. On the base this family exists
+ * to cure — HEAD's violet, 150.7° off — NO column yields a candidate, and the earlier cut of
+ * this file then dereferenced an empty ranking and reported a TypeError. The born-RED outcome
+ * of a corridor gate must be a corridor READING: what the band actually held, at what hue, and
+ * how far off the anchor it was. So the sweep keeps a second, hue-blind maximum (`offAnchor`)
+ * whose only filter is the chroma floor, and the caller prints it when `columns` is 0.
+ */
+function modalCore(b: Band, scheme: string, cols = 24) {
+  const per: { rgb: Rgb; C: number; h: number }[] = [];
+  let max: { rgb: Rgb; C: number; h: number } | null = null;
+  /** the most chromatic pixel in the band REGARDLESS of hue — the failure's own evidence */
+  let offAnchor: { rgb: Rgb; C: number; h: number } | null = null;
+  const step = Math.max(1, Math.floor(b.w / cols));
+  for (let c = 0; c < cols; c++) {
+    const x = Math.min(b.w - 1, c * step);
+    let best: { rgb: Rgb; C: number; h: number } | null = null;
+    for (let y = 0; y < b.h; y++) {
+      const rgb = px(b, x, y);
+      const o = oklch(rgb);
+      if (o.C < CHROMA_FLOOR) continue;
+      const cand = { rgb, C: o.C, h: o.h };
+      if (!offAnchor || o.C > offAnchor.C) offAnchor = cand;
+      // only pixels inside the gauge's own hue window AND above the chroma floor are the gauge
+      if (hueGap(o.h, GOLD_HUE[scheme]) > HUE_WINDOW) continue;
+      if (!best || o.C > best.C) best = cand;
+      if (!max || o.C > max.C) max = cand;
+    }
+    if (best) per.push(best);
+  }
+  const freq = new Map<string, number>();
+  for (const p of per) freq.set(p.rgb.join(","), (freq.get(p.rgb.join(",")) ?? 0) + 1);
+  const ranked = [...freq.entries()].sort((a, b) => b[1] - a[1]);
+  const modal = ranked.length ? (ranked[0][0].split(",").map(Number) as Rgb) : null;
+  return { modal, columns: per.length, max: max?.rgb ?? null, offAnchor };
+}
+
+/**
+ * Fill through the product's own HINT button. Every digit it writes is CORRECT, so the board
+ * stays solvable and the front walks the top edge for real. A probe that TYPES digits writes
+ * wrong ones, and a board with a duplicate returns the failure verdict — which paints the
+ * teacher's red and was mistaken for a gauge reading in an earlier cut of this instrument.
+ */
+async function fillByHint(page: Page, max = 26) {
+  let n = 0;
+  for (; n < max; n++) {
+    const ok = await page.evaluate(() => {
+      const b = document.querySelector<HTMLButtonElement>('[aria-label*="Hint" i]');
+      if (!b || b.disabled) return false;
+      b.click();
+      return true;
+    });
+    if (!ok) break;
+    await page.waitForTimeout(130);
+  }
+  await page.evaluate(() => (document.activeElement as HTMLElement)?.blur?.());
+  await page.waitForTimeout(1000);
+  return n;
+}
+
+
+/**
+ * The NAMED failure's own text. Shared by the gate and by its born-RED control below, so the
+ * message a reviewer meets on a red is the message the control proved is produced.
+ */
+function noGaugePixel(
+  scheme: string,
+  offAnchor: { rgb: Rgb; C: number; h: number } | null,
+  line: Rgb,
+  paper: Rgb,
+) {
+  const found = offAnchor
+    ? `the band's most chromatic pixel is ${offAnchor.rgb.join(",")} at h ${offAnchor.h.toFixed(1)}°, ` +
+      `${hueGap(offAnchor.h, GOLD_HUE[scheme]).toFixed(1)}° off the gold anchor ${GOLD_HUE[scheme]}° ` +
+      `(C ${offAnchor.C.toFixed(3)}); it reads ${ratio(offAnchor.rgb, line).toFixed(3)} vs the line and ` +
+      `${ratio(offAnchor.rgb, paper).toFixed(3)} vs the paper`
+    : `no pixel in the band clears the chroma floor ${CHROMA_FLOOR} at all`;
+  return (
+    `NO GAUGE PIXEL IN THE BAND (${scheme}). 0 of 24 columns hold a pixel within ` +
+    `${HUE_WINDOW}° of the gold anchor above the chroma floor. ${found}. ` +
+    `grounds: line ${line.join(",")}, paper ${paper.join(",")}.`
+  );
+}
+
+/**
+ * THE CORRIDOR ROW, one body for the gate and for its born-RED controls. `ablate` (the controls
+ * only) repaints the gauge after the fill, and the control's own precondition is read first:
+ * the gauge must be painting before it is ablated, so a control cannot pass on an empty band.
+ * The corridor THROWS its reading; a control asserts the text of that throw, never a local call
+ * to the message builder (pass-4 critique §3.6).
+ */
+async function corridor(
+  page: Page,
+  scheme: "light" | "dark",
+  testInfo: TestInfo,
+  ablate?: string,
+) {
+  await page.emulateMedia({ colorScheme: scheme, reducedMotion: "reduce" });
+  await page.goto("/?size=3&difficulty=EASY");
+  await page.waitForSelector(".sudoku-cell", { timeout: 60000 });
+  // the dealt board is on the page when its givens have rendered (the ground is read off it)
+  await expect
+    .poll(() => page.locator(".sudoku-cell .glyph-svg").count(), { timeout: 15000 })
+    .toBeGreaterThan(0);
+
+  const box = (await page.locator("svg.hand-drawn-grid").first().boundingBox())!;
+  const clip = {
+    x: Math.round(box.x + box.width * 0.1),
+    y: Math.round(box.y - 10),
+    width: Math.round(box.width * 0.8),
+    height: 26,
+  };
+
+  // THE GROUND, off a board with no gauge on it: at progress 0 there is no trace node.
+  expect(await page.evaluate(() => document.querySelectorAll(".progress-trace").length)).toBe(0);
+  const bare = await band(page, clip);
+  const { paper, line } = groundOf(bare);
+  expect(line, "the frame line must be found in the band").not.toBeNull();
+  // THE THIRD GROUND, painted: the most frequent colour in the rows around the wrapper's top edge
+  // that is neither the paper nor the line (its box is read for the ROWS only — the colour is the
+  // bytes; the edge sits at a fractional device row, so four rows are ranked, not two assumed).
+  // No such colour means the row has lost its subject, and that is a failure, not a pass.
+  const wrap = (await page.locator(".board-wrapper").first().boundingBox())!;
+  const top = Math.floor(wrap.y) - clip.y;
+  const border = modalRows(bare, [top - 1, top, top + 1, top + 2], (c) => ratio(c, paper) > 1.1 && ratio(c, line!) > 1.1);
+  expect(border, `no border colour in rows ${top - 1}–${top + 2}: the wrapper edge is not where the row reads it`).not.toBeNull();
+
+  const hints = await fillByHint(page);
+  expect(hints, "the hint control must be able to fill the board").toBeGreaterThan(8);
+
+  // THE ALPHA: the gauge is the one OPAQUE stroke on a board whose frame is 0.95 (§2).
+  const computed = await page.evaluate(() => {
+    const t = document.querySelector(".progress-trace");
+    return t
+      ? {
+          strokeOpacity: getComputedStyle(t).strokeOpacity,
+          hasPathLength: !!t.getAttribute("pathLength"),
+          hasDash: !!t.getAttribute("stroke-dasharray"),
+        }
+      : null;
+  });
+  expect(computed, "a gauge must exist once a digit is written").not.toBeNull();
+  expect(computed!.strokeOpacity).toBe("1");
+  // the dash is gone: the front is geometry (§1)
+  expect(computed!.hasPathLength).toBe(false);
+  expect(computed!.hasDash).toBe(false);
+
+  if (ablate) {
+    const before = modalCore(await band(page, clip), scheme);
+    expect(before.columns, "the gauge must be painting before it is ablated").toBeGreaterThan(0);
+    const was = await page.evaluate(
+      () => getComputedStyle(document.querySelector(".progress-trace")!).stroke,
+    );
+    await page.evaluate((css) => {
+      const st = document.createElement("style");
+      st.textContent = css;
+      document.head.appendChild(st);
+    }, ablate);
+    // the ablation has LANDED when the trace's computed stroke has left the gold it read
+    await expect
+      .poll(() => page.evaluate(() => getComputedStyle(document.querySelector(".progress-trace")!).stroke))
+      .not.toBe(was);
+  }
+
+  const { modal, columns, max, offAnchor } = modalCore(await band(page, clip), scheme);
+
+  // THE NAMED FAILURE (critique §3.6). A band with no gauge pixel in it is the exact outcome
+  // this gate exists to produce on HEAD's violet, so it reports the corridor it DID find
+  // rather than dereferencing an empty ranking.
+  const grounds = `grounds: line ${line!.join(",")}, paper ${paper.join(",")}, border ${border!.join(",")}`;
+  if (columns === 0) throw new Error(noGaugePixel(scheme, offAnchor, line!, paper));
+  expect(columns, `24 columns must each carry a gauge pixel (${grounds})`).toBe(24);
+
+  // IT IS THE GOLD CRAYON FIRST: a hue this far from the anchor is a different colour passing
+  // the same ratio, which is exactly what the violet did. Read BEFORE the ratios, so an ink
+  // inside the 45° window at the gauge's own luminance reds HERE and nowhere else.
+  const gap = hueGap(oklch(modal!).h, GOLD_HUE[scheme]);
+  expect(gap, `HUE: the modal core ${modal!.join(",")} is ${gap.toFixed(1)}° off the gold anchor`)
+    .toBeLessThanOrEqual(5);
+
+  const vsLine = ratio(modal!, line!);
+  const vsPaper = ratio(modal!, paper);
+  const vsBorder = ratio(modal!, border!);
+  const maxVsLine = ratio(max!, line!);
+  const maxVsPaper = ratio(max!, paper);
+  const maxVsBorder = ratio(max!, border!);
+  testInfo.annotations.push({
+    type: "corridor",
+    description:
+      `${scheme}: modal ${modal!.join(",")} vs line ${line!.join(",")} = ${vsLine.toFixed(3)}, ` +
+      `vs paper ${paper.join(",")} = ${vsPaper.toFixed(3)}, vs border ${border!.join(",")} = ${vsBorder.toFixed(3)}; ` +
+      `max-chroma ${maxVsLine.toFixed(3)} / ${maxVsPaper.toFixed(3)} / ${maxVsBorder.toFixed(3)}`,
+  });
+
+  // ALL THREE grounds. The corridor is the intersection. Line and paper hold on BOTH instruments;
+  // the border on the MODAL core only, because the max-chroma pixel is a partial-coverage blend
+  // at the stroke's outer edge, lighter than the ink (OKLCH L 0.619 against 0.598, pass 6), and it
+  // sits on the PAGE outside the wrapper (251,250,249), where it reads 3.54 / 3.59 against the
+  // ground it touches. Held to the border it does not touch it reads 2.917 chromium / 2.927 webkit
+  // light; that number is printed in the annotation above and is not a reading of the border.
+  expect(vsLine).toBeGreaterThanOrEqual(FLOOR);
+  expect(vsPaper).toBeGreaterThanOrEqual(FLOOR);
+  expect(maxVsLine).toBeGreaterThanOrEqual(FLOOR);
+  expect(maxVsPaper).toBeGreaterThanOrEqual(FLOOR);
+  expect(vsBorder, `BORDER: the modal core ${modal!.join(",")} reads ${vsBorder.toFixed(3)} on the wrapper border ${border!.join(",")} (floor ${BORDER_FLOOR[scheme]})`)
+    .toBeGreaterThanOrEqual(BORDER_FLOOR[scheme]);
+}
+
+/** Drive the corridor row under an ablation and hand back the error it threw (null if none). */
+const thrownBy = (run: Promise<void>) =>
+  run.then(
+    () => null,
+    (e: Error) => e,
+  );
+
+for (const scheme of ["light", "dark"] as const) {
+  test(`the fill gauge clears ${FLOOR}:1 on the line and the paper, and the border floor on the wrapper — ${scheme}`, async ({
+    page,
+  }, testInfo) => {
+    await corridor(page, scheme, testInfo);
+  });
+}
+
+/**
+ * THE GATE'S BORN-RED CONTROLS, ON THIS TREE, IN THE SAME RUN (T9-W7 pass 4-5; LAWS §Gates).
+ *
+ * FAR: the gauge repainted HEAD's own violet (`#8b5cf6`, 150.7° off the gold anchor) in a
+ * stylesheet appended last (the only thing that beats an equal-specificity `!important` in
+ * `@layer utilities`). The row must THROW the named failure with the off-anchor evidence in it.
+ *
+ * NEAR: an ink INSIDE the 45° window at the gauge's own luminance, 25° off the anchor (OKLCH L
+ * and C held: light #b46b29 at h 58.7, dark #8b5b19 at h 69.7; Y within 4 % of the gauge's). The
+ * window admits it, so only the hue row can catch it — the pass-4 critic's 25.3° pick red on the
+ * RATIO row first and left the ≤5° line un-demonstrated.
+ *
+ * BORDER: an ink on the anchor that clears the line and the paper and fails ONLY the wrapper
+ * border. Light: the pass-2..5 gold #a87e13 (3.505 / 3.646 / 2.970 painted). Dark: #756106 at
+ * h 94.5 (3.505 / 3.091 / 2.424, under HEAD's 2.441). Only the BORDER row can catch either.
+ */
+const NEAR: Record<string, string> = { light: "#b46b29", dark: "#8b5b19" };
+const BORDER_ONLY: Record<string, string> = { light: "#a87e13", dark: "#756106" };
+
+for (const scheme of ["light", "dark"] as const) {
+  test(`BORN-RED: the corridor names its failure on HEAD's violet — ${scheme}`, async ({
+    page,
+  }, testInfo) => {
+    const err = await thrownBy(
+      corridor(page, scheme, testInfo, "html body .progress-trace { stroke: #8b5cf6 !important }"),
+    );
+    expect(err, "the corridor must FAIL on HEAD's violet; it passed, so it is VACUOUS").not.toBeNull();
+    expect(err!.message).toContain(`NO GAUGE PIXEL IN THE BAND (${scheme})`);
+    expect(err!.message).toMatch(/grounds: line \d+,\d+,\d+, paper \d+,\d+,\d+\./);
+    // the far arm lands outside the window: named with its own hue, or as under the chroma floor
+    expect(err!.message).toMatch(/° off the gold anchor|clears the chroma floor/);
+    testInfo.annotations.push({ type: "born-red", description: err!.message });
+  });
+
+  test(`BORN-RED: an in-window ink 25° off the anchor reds on the HUE row — ${scheme}`, async ({
+    page,
+  }, testInfo) => {
+    const err = await thrownBy(
+      corridor(page, scheme, testInfo, `html body .progress-trace { stroke: ${NEAR[scheme]} !important }`),
+    );
+    expect(err, "a 25°-off ink inside the window passed the corridor").not.toBeNull();
+    expect(err!.message).toContain("HUE: the modal core");
+    testInfo.annotations.push({ type: "born-red", description: err!.message.split("\n")[0] });
+  });
+
+  test(`BORN-RED: an ink that clears the line and the paper reds on the wrapper BORDER — ${scheme}`, async ({
+    page,
+  }, testInfo) => {
+    const err = await thrownBy(
+      corridor(page, scheme, testInfo, `html body .progress-trace { stroke: ${BORDER_ONLY[scheme]} !important }`),
+    );
+    expect(err, `${BORDER_ONLY[scheme]} passed the corridor; the border row cannot see its ground`).not.toBeNull();
+    expect(err!.message).toContain("BORDER: the modal core");
+    testInfo.annotations.push({ type: "born-red", description: err!.message.split("\n")[0] });
+  });
+}
