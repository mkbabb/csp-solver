+function gateKin(css, deg = OKLCH_KIN_DEG) {
+  const out = [];
+  for (const [theme, scope] of Object.entries(themesScopes(css))) {
+    for (const { ink, crayon, why } of KIN) {
+      const d = hueGap(oklch(colorOf(scope, ink)).h, oklch(colorOf(scope, crayon)).h);
+      if (d > deg)
+        out.push(
+          `kin ${theme}: ${ink} is ${d.toFixed(1)}° from ${crayon} (KIN_DEG ${deg}) — ${why}`,
+        );
+    }
+  }
+  return out;
+}
+
+function gateCorridor(css) {
+  const out = [];
+  for (const [theme, scope] of Object.entries(themesScopes(css))) {
+    const ink = colorOf(scope, CORRIDOR.ink);
+    for (const g of CORRIDOR.grounds) {
+      const cr = contrast(ink, colorOf(scope, g));
+      if (cr < CORRIDOR.floor + CORRIDOR_MARGIN)
