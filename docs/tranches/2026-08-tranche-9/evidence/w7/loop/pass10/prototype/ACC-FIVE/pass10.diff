+import { describe, it, expect, vi, afterEach } from "vitest";
+import {
+  poseFronts,
+  generateFrameTraceFrames,
+  FRONT_MIN_MS,
+  FRONT_GAP_MS,
+} from "./gridPaths";
+import { MOTION } from "../config/pencilConfig";
+
+/**
+ * THE FRONT'S CONTRACT (T9-W7 §1/§4, the cross-family hand-off).
+ *
+ * `poseFronts` is exported to ACC-SIX, the §10 tally and PLR-COUNT, and it carries a
+ * precondition the pass-3 critique found unstated (§3.7): it parses a pose as ONE polyline.
+ * Handed a multi-subpath pose it would count the JUMPS between subpaths as drawn length and
+ * return a single connected path crossing the board — a wrong shape that looks plausible. The
+ * guard hands such a pose back uncut, and these rows are what make that a contract rather than
+ * a comment. The positive rows cut the estate's own grain-baked ring; the two guard rows use
+ * HAND-WRITTEN poses (a two-subpath string and a `catmullRomToBezier`-shaped curve), because on
+ * this tree no estate generator emits either shape: `generateFrameTraceFrames`' un-grained
+ * branch strips each side's leading `M` into one polyline, and `generateGridBoilFrames`' frame
+ * is an array of closed rects. The hazard is real and its named instances were not.
+ */
+const subpaths = (d: string) => (d.match(/[Mm]/g) ?? []).length;
+const points = (d: string) => (d.match(/-?\d*\.?\d+(?:e[-+]?\d+)?/gi) ?? []).length / 2;
+
+// the board gauge's own ring, grain-baked exactly as HandDrawnGrid bakes it (grain-static)
+const RING = generateFrameTraceFrames(1000, 42, 4, 1.5, {
+  baseFrequency: 0.04,
+  numOctaves: 2,
+  scale: 2.5,
+  seed: 7,
+});
+
+describe("poseFronts — the drawn front, as geometry", () => {
+  it("cuts a single-subpath ring at its own arc-length fraction", () => {
+    expect(subpaths(RING[0])).toBe(1);
+    const half = poseFronts(RING, 0.5);
+    expect(half).toHaveLength(RING.length);
+    // a cut pose is shorter than the whole one, and still one subpath
+    expect(points(half[0])).toBeLessThan(points(RING[0]));
+    expect(points(half[0])).toBeGreaterThan(2);
+    expect(subpaths(half[0])).toBe(1);
+    // and the cut is monotone in the fraction
+    expect(points(poseFronts(RING, 0.25)[0])).toBeLessThan(points(half[0]));
+  });
+
+  it("returns the poses UNCHANGED at f >= 1 and empty at f <= 0", () => {
+    expect(poseFronts(RING, 1)).toBe(RING);
+    expect(poseFronts(RING, 1.7)).toBe(RING);
+    expect(poseFronts(RING, 0)).toEqual(RING.map(() => ""));
+    expect(poseFronts(RING, -0.3)).toEqual(RING.map(() => ""));
+  });
+
+  it("hands a MULTI-SUBPATH pose back uncut rather than joining its subpaths", () => {
+    const multi = "M0,0 L100,0 L100,100 M300,300 L400,300 L400,400";
+    expect(subpaths(multi)).toBe(2);
+    expect(poseFronts([multi], 0.5)[0]).toBe(multi);
+  });
+
+  it("hands a CURVE pose back uncut — control points are not vertices", () => {
+    // the shape `catmullRomToBezier` emits: `wobbleLine`'s non-jagged branch, which every
+    // caller avoids today by passing `jagged: true`. Parsed as a polyline its control points
+    // would be counted as points on the line and both the length and the cut would be wrong.
+    const curved = "M0,0 C10,0 20,10 20,20 C20,30 30,40 40,40";
+    expect(subpaths(curved)).toBe(1);
+    expect(poseFronts([curved], 0.5)[0]).toBe(curved);
+  });
+
+  it("BORN-RED CONTROL: the guard discriminates, it does not refuse everything", () => {
+    // a single linear pose of the same family IS cut — so the two rows above fail the moment
+    // `poseIsLinearSinglePath` stops discriminating and starts returning false for everything.
+    const single = RING[0];
+    expect(subpaths(single)).toBe(1);
+    expect(poseFronts([single], 0.5)[0]).not.toBe(single);
+    expect(poseFronts(["M0,0 L100,0 L100,100"], 0.5)[0]).not.toBe(
+      "M0,0 L100,0 L100,100",
+    );
+  });
+
+  it("memoises on the frames array's identity without changing the answer", () => {
+    const a = poseFronts(RING, 0.37);
+    const b = poseFronts(RING, 0.37);
+    expect(b).toEqual(a);
+    // a fresh array of the same strings is a memo MISS and must still agree
+    expect(poseFronts([...RING], 0.37)).toEqual(a);
+  });
