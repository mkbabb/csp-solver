+/* T9-W7 §3, printed: the family, and the interval the gauge lives in. */
+console.log(
+  `kinship — every interactive accent is one of the five crayons at a different pressure (KIN_DEG ${OKLCH_KIN_DEG}°, OKLCH):`,
+);
+for (const [theme, scope] of Object.entries(themesScopes(INDEX_CSS))) {
+  for (const { ink, crayon } of KIN) {
+    const a = oklch(colorOf(scope, ink));
+    const b = oklch(colorOf(scope, crayon));
+    console.log(
+      `  ${theme.padEnd(5)} ${ink.padEnd(22)} h ${a.h.toFixed(1)}°  L ${a.L.toFixed(3)} C ${a.C.toFixed(3)}   Δ${hueGap(a.h, b.h).toFixed(2)}° off ${crayon} (h ${b.h.toFixed(1)}°)`,
+    );
+  }
+}
+console.log(
+  `\ncorridor — the fill trace clears ${CORRIDOR.floor}:1 against BOTH its grounds at once, with ${CORRIDOR_MARGIN} of margin (TOKEN ARITHMETIC: it over-reports a 12-unit hand-drawn line by ~0.5 against the painted bytes — the governing row is the painted one in e2e/progress-corridor.spec.ts):`,
+);
+for (const [theme, scope] of Object.entries(themesScopes(INDEX_CSS))) {
+  const cells = CORRIDOR.grounds
+    .map(
+      (g) =>
+        `${contrast(colorOf(scope, CORRIDOR.ink), colorOf(scope, g)).toFixed(3)} vs ${g}`,
+    )
+    .join("  /  ");
+  console.log(`  ${theme.padEnd(5)} ${cells}`);
+}
+console.log("");
+
 const ratio = (theme, p) =>
   contrast(press(THEMES[theme].graphite, p, THEMES[theme].card), THEMES[theme].card);
 const SCOPE_NAMES = Object.keys(THEMES);
