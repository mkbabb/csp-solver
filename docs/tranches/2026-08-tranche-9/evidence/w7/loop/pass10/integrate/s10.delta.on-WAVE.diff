diff --git a/web/frontend/src/games/shared/useGameState.ink.test.ts b/web/frontend/src/games/shared/useGameState.ink.test.ts
new file mode 100644
index 0000000..2da91dd
--- /dev/null
+++ b/web/frontend/src/games/shared/useGameState.ink.test.ts
@@ -0,0 +1,144 @@
+import { describe, it, expect } from "vitest";
+import { defineComponent, h } from "vue";
+import { flushPromises, mount } from "@vue/test-utils";
+import { useGameState, type GameStateDomain } from "./useGameState";
+
+/**
+ * T9-M12 · BOARD INK IS THE TRUTH (pass-10 CHAIR-RULINGS §7).
+ *
+ * The destructive ask (Deal / Clear / Fill / Solve on a dirty board) read the session's undo log
+ * at pass 9: player writes since the last deal. Two edges broke it, both engines, tree and WAVE.
+ * R: a reload restores the digits and starts the log empty, so ONE click cleared a board the
+ * player had written on with no ask. C: after a digit and an answered Clear the board holds no
+ * ink, but the walk still found the pre-Clear write and Solve asked about nothing. `boardInk`
+ * reads the board: a value off the clues and off the solver's tone, or a note.
+ */
+
+type Dealt = { values: Record<string, number> };
+interface Persisted {
+  values: Record<string, number>;
+  givenCells: string[];
+  originalGivenCells: string[];
+  solvedValues: Record<string, number>;
+  boardGeneration: number;
+  size: number;
+  difficulty: "EASY";
+}
+type Domain = GameStateDomain<"EASY", Dealt, Record<string, never>, Persisted>;
+type Model = ReturnType<
+  typeof useGameState<"EASY", Dealt, Record<string, never>, Persisted>
+>;
+
+/** A 9×9 with two clues; every other square empty. */
+const DEALT: Dealt = { values: { "0": 5, "1": 3 } };
+
+function makeDomain(persisted: Persisted | null = null): Domain {
+  return {
+    initial: {
+      difficulty: "EASY",
+      source: persisted ? "storage-only" : "fresh",
+      persisted,
+      boardLink: "absent",
+    },
+    initialSize: 3,
+    boardSizeOf: (raw) => raw * raw,
+    getRandomBoard: async () => DEALT,
+    applyDealFurniture: () => {},
+    resetFurniture: () => {},
+    grade: () => ({ hardestTechnique: null, solved: true }),
+    solve: async (values) => ({
+      solved: true,
+      values,
+      backtracks: 0,
+      nodesExplored: 0,
+      propagations: 0,
+      solutionCount: 1,
+    }),
+    propagate: async () => new Uint32Array(0),
+    fillForced: () => ({ placements: [] }),
+    hint: () => null,
+    snapshotExtra: () => ({}),
+    restoreExtra: () => {},
+    restorePersistedFurniture: () => {},
+    syncToUrl: () => {},
+    persist: () => {},
+    clearPersisted: () => {},
+    dropBoardParam: () => {},
+    writeShareUrl: () => {},
+  };
+}
+
+async function mountModel(domain: Domain) {
+  let model!: Model;
+  const wrapper = mount(
+    defineComponent({
+      setup() {
+        model = useGameState(domain);
+        return () => h("div");
+      },
+    }),
+  );
+  await flushPromises();
+  return { model, wrapper };
+}
+
+/** A saved board: clues at 0 and 1, the player's 7 at 40, the solver's 9 at 41. */
+const SAVED = (extra: Record<string, number> = { "40": 7 }): Persisted => ({
+  values: { "0": 5, "1": 3, "41": 9, ...extra },
+  givenCells: ["0", "1"],
+  originalGivenCells: ["0", "1"],
+  solvedValues: { "41": 9 },
+  boardGeneration: 4,
+  size: 3,
+  difficulty: "EASY",
+});
+
+describe("boardInk — the destructive ask's signal is the board's player ink", () => {
+  it("a dealt board with clues alone is pristine", async () => {
+    const { model, wrapper } = await mountModel(makeDomain());
+    expect(model.boardInk.value).toBe(false);
+    wrapper.unmount();
+  });
+
+  it("one player digit is ink; undoing it is not", async () => {
+    const { model, wrapper } = await mountModel(makeDomain());
+    model.setCell(40, 7);
+    expect(model.boardInk.value).toBe(true);
+    model.undo();
+    expect(model.boardInk.value).toBe(false);
+    wrapper.unmount();
+  });
+
+  it("R · a digit restored on reload is player ink, with the undo log empty", async () => {
+    // Born RED on pass 9's walk: the log starts empty after a restore, so it read pristine.
+    const { model, wrapper } = await mountModel(makeDomain(SAVED()));
+    expect(model.undoDepth.value).toBe(0);
+    expect(model.boardInk.value).toBe(true);
+    wrapper.unmount();
+  });
+
+  it("R′ · a restored board whose only non-clue digit is the solver's is pristine", async () => {
+    const { model, wrapper } = await mountModel(makeDomain(SAVED({})));
+    expect(model.boardInk.value).toBe(false);
+    wrapper.unmount();
+  });
+
+  it("C · after a digit and an answered Clear the board holds no ink", async () => {
+    // Born RED on pass 9's walk: the clear does not end it, so the pre-Clear write still counted.
+    const { model, wrapper } = await mountModel(makeDomain());
+    model.setCell(40, 7);
+    model.clearBoard();
+    expect(model.boardInk.value).toBe(false);
+    model.undo(); // the Clear undone: the digit is back on the board
+    expect(model.boardInk.value).toBe(true);
+    wrapper.unmount();
+  });
+
+  it("a player's note is ink", async () => {
+    const { model, wrapper } = await mountModel(makeDomain());
+    model.setPencilMode("corner");
+    model.toggleUserMark(40, 3);
+    expect(model.boardInk.value).toBe(true);
+    wrapper.unmount();
+  });
+});
