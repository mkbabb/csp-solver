+    // style object key, or a runtime `setProperty`.
+    for (const re of [
+      BAND_DECL,
+      /["'`](--peer-(?:ink|ring)-l)["'`]\s*:/g,
+      /setProperty\(\s*["'`](--peer-(?:ink|ring)-l)["'`]/g,
