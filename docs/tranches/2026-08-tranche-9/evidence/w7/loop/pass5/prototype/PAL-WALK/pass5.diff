+}
+
+/**
+ * A DECOY, NAMED. This used to be called THE LAW HOLDS and it never held the law: the walk is
+ * mapped over the ARCLENGTH of the open complement, so every hue it emits is outside every
+ * reserved arc by construction, and no step — 137.5°, 52.42°, 0.5° — can put one inside. What
+ * it does prove is worth one line: the complement is non-empty (there is somewhere to walk) and
+ * the golden step over it repeats no hue in 144 (the walk is a walk). The law itself is check 1
+ * (the arcs are the sheet's, resolved) and tier 3 (the painted bytes, `e2e/peer-walk.spec.ts`).
+ */
+function check2StepIsClean(css, ts, n = 144) {
+  const arcs = declaredArcs(ts);
+  const out = [];
+  let span = 0;
+  let cut = 0;
+  for (const [a, b] of arcs) {
+    if (a > cut) span += a - cut;
+    cut = Math.max(cut, b);
+  }
+  if (cut < 360) span += 360 - cut;
+  if (span <= 0) {
+    out.push("the declared arcs leave no open complement to walk on");
+    return { failures: out, n, span };
+  }
+  const hues = walk(arcs, n).map((h) => h.toFixed(2));
+  const dupes = hues.length - new Set(hues).size;
+  if (dupes) out.push(`the golden step repeats ${dupes} hue(s) inside ${n} indices`);
+  return { failures: out, n, span };
+}
+
+/** The band pair a TS table declares, `NAME = [light, dark] as const`, or null if absent. */
+function declaredBands(ts, name) {
+  const m = ts.match(
+    new RegExp(`\\b${name}\\s*=\\s*\\[\\s*([\\d.]+)\\s*,\\s*([\\d.]+)\\s*\\]`),
+  );
+  return m ? [Number(m[1]), Number(m[2])] : null;
+}
+
+/** Each band the module bisects against, held to the value the sheet publishes in each arm. The
+ *  comparison is EXACT: both sides are authored decimals, and a band that differs by any amount
+ *  is a chroma bisected for a lightness the engine is not painting. */
+function check3BandsAgree(css, ts) {
+  const { light, dark } = armsOf(css);
+  const out = [];
+  for (const [table, token] of [
+    ["DIGIT_BANDS", "--peer-ink-l"],
+    ["RING_BANDS", "--peer-ring-l"],
+  ]) {
+    const pair = declaredBands(ts, table);
+    if (!pair) {
+      out.push(
+        `playerIdentity.ts declares no ${table} — the chroma has no band to be bisected at`,
+      );
+      continue;
+    }
+    for (const [k, armName, arm] of [
+      [0, "light", light],
+      [1, "dark", dark],
+    ]) {
+      const raw = arm.get(token);
+      const sheet = raw === undefined ? NaN : Number(raw);
+      if (!Number.isFinite(sheet))
+        out.push(
+          `index.css publishes no numeric ${token} in the ${armName} arm (read: ${raw ?? "nothing"})`,
+        );
+      else if (sheet !== pair[k])
+        out.push(
+          `${token} ${armName}: index.css says ${sheet}, playerIdentity.ts ${table} says ${pair[k]} — ` +
+            `the chroma is bisected for a lightness the engine is not painting`,
+        );
+    }
+  }
+  // THE TABLES ARE THE ONES THE WALK READS. A comparer that holds two named tables is blind to a
+  // third one the walk is quietly pointed at (PAL-TIN's pass-4 critic planted exactly that
+  // against the leader's gate), so the module's own call sites are read too: the string written
+  // at `--peer-ink-l` must be bisected against DIGIT_BANDS, the ring's against RING_BANDS, and
+  // nothing else. A band or a table in some OTHER file is check 4's (ONE PUBLISHER), which
+  // reads every source file rather than these two.
+  const calls = [
+    ...ts.matchAll(/\(\s*"(--peer-(?:ink|ring)-l)"\s*,\s*([A-Za-z_$][\w$]*)\s*\)/g),
+  ];
