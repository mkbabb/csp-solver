+}
+
+/** Every source file check 4 reads: `src/` and `e2e/`, the four extensions a band can be
+ *  written in. A test fixture is a publisher too — a band pinned in a spec is a second copy. */
+function sourceFiles() {
+  const out = [];
+  const walkDir = (dir) => {
+    for (const name of readdirSync(dir)) {
+      const at = join(dir, name);
+      if (statSync(at).isDirectory()) walkDir(at);
+      else if (/\.(css|vue|ts|mts)$/.test(name))
+        out.push({ rel: relative(ROOT, at), text: readFileSync(at, "utf8") });
+    }
+  };
+  for (const d of ["src", "e2e"]) walkDir(join(ROOT, d));
