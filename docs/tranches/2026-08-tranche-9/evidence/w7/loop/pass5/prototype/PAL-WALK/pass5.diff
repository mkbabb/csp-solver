+#!/usr/bin/env node
+/**
+ * check-peer-arcs — THE PLAYER'S HUE IS NOT ALLOWED TO BE A COLOUR THE HOUSE ALREADY SPENT.
+ *
+ * `playerIdentity.ts` walks a golden step over the arcs of the wheel `index.css` has NOT
+ * reserved, so that no hand at the table is ever mistakable for a crayon, an ink tier, the
+ * solver's rainbow or the local blue. The arcs are a CONSTANT in that file because a browser
+ * cannot read a stylesheet's source at run time — which means the constant and the stylesheet
+ * are two statements of one fact, and two statements of one fact drift.
+ *
+ * So this re-derives the arcs from `index.css` itself and diffs. A hex that moves, a token that
+ * is added, a sixth anchor: any of them reds here, with the arc that moved named, and the walk
+ * is re-cut rather than quietly re-landed inside somebody else's colour.
+ *
+ * RESERVED IS FOUND BY RESOLVED VALUE, NEVER BY A NAME AND NEVER BY A LITERAL — and each half
+ * of that was a real bite. The name-list regex this file first carried green-lit a hand 0.47°
+ * from `--color-answer-pale` the moment a sibling wave RENAMED the token it was matching: a
+ * rename is not a re-hue. Then the hex-only regex read `--color-x: var(--color-crayon-blue)` as
+ * no colour at all, and an `hsl()` chromatic as no colour at all, and the light block's hexes as
+ * the dark arm's: a NAME is not a colour, a VAR is not a colour, and a BLOCK is not an arm.
+ *
+ * So the census resolves. Aliases are followed to the hex they end at; `hsl()` is parsed;
+ * declarations are read PER ARM by brace-matching the `.dark` block out of the root one; and
+ * `@media print` / `forced-colors` are excluded, because a sheet that prints in one ink reserves
+ * nothing about a screen. Every declaration whose RESOLVED OKLCH chroma clears CHROMA_FLOOR
+ * reserves its arc, whatever it is called and however it is written. (Measured at HEAD: nothing
+ * sits between 0.03 and 0.06 — the floor is a canyon, not a knife edge.)
+ *
+ *   1  ARCS AGREE     the arcs derived from index.css == RESERVED_ARCS
+ *   3  BANDS AGREE    the lightness bands `playerIdentity.ts` bisects its chroma against
+ *                     (`DIGIT_BANDS`, `RING_BANDS`) == the `--peer-ink-l` / `--peer-ring-l` the
+ *                     sheet publishes, per arm. ONE PUBLISHER (index.css) and this comparer, not
+ *                     two publishers: the module has to know the band to find the chroma sRGB
+ *                     holds there, and a browser cannot read a stylesheet's source, so the TS
+ *                     pair is a copy and the copy is held here. A band moved on one side alone
+ *                     asks the engine for a chroma the new lightness cannot hold; the engine
+ *                     clips it and turns the hue — measured at runtime, `--peer-ring-l`
+ *                     0.32 → 0.20 turned the painted ring 18.258° off the hue it was asked for
+ *                     (1.712° at the shipped band), which walks a hand into a reserved arc.
+ *   4  ONE PUBLISHER  check 3 holds the TWO copies it knows about, and a copy it does not know
+ *                     about is exactly how a band drifts. So every source file under `src/` and
+ *                     `e2e/` is read (comments stripped first) and a SECOND PUBLISHER reds, agree
+ *                     or disagree: a declaration of `--peer-ink-l` / `--peer-ring-l` anywhere but
+ *                     index.css's two arms (a rule in `gameCell.css`, a style block in a `.vue`, a
+ *                     `setProperty` in a script); a band-shaped literal (two lightnesses in (0,1))
+ *                     under a ring/band/peer/hand name other than the module's two held tables;
+ *                     a hex table under a peer/ring/hand/player name (a player's ink is a formula,
+ *                     so a table of them is a second palette by construction); and a
+ *                     `--color-peer-*` token declared with a literal colour. The self-test plants
+ *                     each one (B1 · B3 · A1 · A2 · A4 · A6, the pass-4 critics' attack set).
+ *   2  THE STEP IS CLEAN  a DECOY, and renamed to what it actually proves: the complement is
+ *                     non-empty and a golden step over it yields no duplicate hue in 144. It does
+ *                     NOT carry the law — the walk is mapped over the open arclength, so by
+ *                     CONSTRUCTION no step can put a hue inside a reserved arc, and this check
+ *                     therefore cannot red on a broken step (STEP=0.5 leaves it green). The law
+ *                     lives in check 1 (the arcs are the sheet's) and in tier 3's painted bytes.
+ *
+ * NOT CHECKED HERE, AND SAID OUT LOUD: hue EXACTNESS. Pass 1 booked a ±0.5° gate on the painted
+ * bytes; it is RETIRED BY DELETION rather than loosened, because it cannot be met by any design
+ * — the 8-bit round trip alone moves a hue up to 1.166° (digit) / 1.712° (ring), 144 indices, both engines, so the gate
+ * could only ever fail. What replaces it is the ±1° MARGIN inside GUARD below (the rounding is
+ * paid for in the arc width) and the PAINTED law in `e2e/peer-walk.spec.ts`, which reads the
+ * engine's own pixels and asks the only question that matters: is any hand inside a reserved
+ * arc, and is any hand closer in ΔE to a house ink than the house's own crayons are to each
+ * other.
+ *
+ * `--self-test` re-runs both against known-bad inputs and fails if either PASSES: a gate that
+ * cannot fail is not a gate (the check-ink-pressure house pattern).
+ *
+ *   node scripts/check-peer-arcs.mjs [--self-test]
+ */
+import { readFileSync, readdirSync, statSync } from "node:fs";
+import { join, relative } from "node:path";
+import { fileURLToPath } from "node:url";
+// Explicit, matching the other check-* scripts: eslint runs these with browser globals, so the
+// implicit `process` is a no-undef error here.
+import process from "node:process";
+
+const ROOT = join(fileURLToPath(new URL("..", import.meta.url)));
+const CSS = join(ROOT, "src/assets/index.css");
+const IDENT = join(ROOT, "src/games/shared/playerIdentity.ts");
+
+/** The family law's floor, and the arc half-width derived from it: the law plus a degree of
+ *  margin. A screen is 8 bits a channel, and a string rounds to a byte triple whose hue is off
+ *  the one asked for — so a walk built on the bare floor clears it in arithmetic and lands under
+ *  it in the pixels (measured: index 0 asked 26.41°, painted 26.13°, 11.97° from crayon-rose).
+ *  The degree does NOT cover the worst turn of either string (digit ≤1.166°, ring ≤1.712°,
+ *  measured over 144, both engines): the law is held where the bytes are, by
+ *  `useSession.test.ts`'s rounded-bytes row (CI) and `e2e/peer-walk.spec.ts` §A (painted). */
+const MIN_SEP = 12;
+const GUARD = MIN_SEP + 1;
+/** 4 decimal places in the constant, so a rounding of 5e-5 is expected and 5e-4 is drift. */
+const TOL = 5e-4;
+/** CHROMATIC, in OKLCH chroma. Below this a declaration is paper, ink-black or a grey: a hue
+ *  nobody could mistake a player for, because it is barely a hue. */
+const CHROMA_FLOOR = 0.06;
+
+/** Every custom-property declaration, whatever it is declared WITH — hex, `hsl()`, or another
+ *  token's name. The value is resolved below; this only finds the pairs. */
+const DECLS = /(--[a-z0-9-]+):\s*([^;{}]+);/g;
+
+const lin = (c) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
+
+/** sRGB hex → OKLCH chroma and hue, degrees. */
+function oklchOf(hex) {
+  const n = parseInt(hex.slice(1), 16);
+  const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((v) => lin(v / 255));
+  const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
+  const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
+  const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
+  const A = 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s;
+  const B = 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s;
+  const h = (Math.atan2(B, A) * 180) / Math.PI;
+  return { C: Math.hypot(A, B), h: h < 0 ? h + 360 : h };
+}
+
+/** `hsl(H S% L%)` (commas optional) → a six-digit hex. A hue written this way is a hue. */
+function hslToHex(h, s, l) {
+  const S = s / 100;
+  const L = l / 100;
+  const k = (n) => (n + h / 30) % 12;
+  const a = S * Math.min(L, 1 - L);
+  const f = (n) => L - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
+  const byte = (v) =>
+    Math.round(v * 255)
+      .toString(16)
+      .padStart(2, "0");
+  return `#${byte(f(0))}${byte(f(8))}${byte(f(4))}`;
+}
+
+/** Cut a brace-matched block out of the text, returning [inside, therest]. */
+function carve(css, opener) {
+  const at = css.indexOf(opener);
+  if (at < 0) return null;
+  let depth = 0;
+  for (let i = at + opener.length - 1; i < css.length; i++) {
+    if (css[i] === "{") depth++;
+    else if (css[i] === "}" && --depth === 0)
+      return [css.slice(at + opener.length, i), css.slice(0, at) + css.slice(i + 1)];
+  }
+  return null;
+}
+
+/**
+ * THE TWO ARMS, AND WHAT IS NOT AN ARM. A declaration inside `.dark` is the night-time value of
+ * its name; the same name outside it is the daytime one. `@media print` and
+ * `@media (forced-colors: active)` are neither — a room that prints in one ink, or a system that
+ * substitutes its own, reserves nothing about the hues a screen paints.
+ */
+function armsOf(css) {
+  let rest = css;
+  for (const opener of ["@media print {", "@media (forced-colors: active) {"]) {
+    let cut;
+    while ((cut = carve(rest, opener))) rest = cut[1];
+  }
+  const dark = carve(rest, ".dark {");
+  const light = dark ? dark[1] : rest;
+  const read = (text) =>
+    new Map([...text.matchAll(DECLS)].map((m) => [m[1], m[2].trim()]));
+  return { light: read(light), dark: read(dark ? dark[0] : "") };
+}
+
+/**
+ * A declaration's RESOLVED colour in one arm, or null if it is not a colour at all. `var(--x)`
+ * is followed (to the arm's own value first, then the root's, which is what the cascade does);
+ * a chain is followed to a depth no stylesheet has ever needed, and a cycle simply runs out.
+ */
+function resolve(value, arm, root, depth = 0) {
+  const v = value.trim();
+  if (/^#[0-9a-fA-F]{6}$/.test(v)) return v.toLowerCase();
+  const hsl = v.match(/^hsl\(\s*([\d.]+)\s*,?\s*([\d.]+)%\s*,?\s*([\d.]+)%\s*\)$/i);
+  if (hsl) return hslToHex(Number(hsl[1]), Number(hsl[2]), Number(hsl[3]));
+  const alias = v.match(/^var\(\s*(--[a-z0-9-]+)\s*(?:,\s*([^)]*))?\)$/i);
+  if (alias && depth < 8) {
+    const next = arm.get(alias[1]) ?? root.get(alias[1]) ?? alias[2];
+    if (next) return resolve(next, arm, root, depth + 1);
+  }
+  return null; // a length, a shadow, a gradient, a keyword — not a hue anyone can be mistaken for
+}
+
+/** Every CHROMATIC declaration in the sheet, resolved per arm, with its hue. The name and the arm
+ *  are carried for the error message only — neither is ever what decides. */
+function reservedInks(css) {
+  const { light, dark } = armsOf(css);
+  const out = [];
+  for (const [armName, arm] of [
+    ["light", light],
+    ["dark", dark],
+  ])
+    for (const [name, raw] of arm) {
+      const hex = resolve(raw, arm, light);
+      if (!hex) continue;
+      const { C, h } = oklchOf(hex);
+      if (C > CHROMA_FLOOR) out.push({ name, arm: armName, hex, C, h });
+    }
+  return out;
+}
+
+/** The union of [h−GUARD, h+GUARD] over every reserved hue: wrapped, merged, sorted. */
+function deriveArcs(hues) {
+  const raw = [];
+  for (const h of hues) {
+    const a = h - GUARD;
+    const b = h + GUARD;
+    if (a < 0) raw.push([a + 360, 360], [0, b]);
+    else if (b > 360) raw.push([a, 360], [0, b - 360]);
+    else raw.push([a, b]);
+  }
+  raw.sort((p, q) => p[0] - q[0]);
+  const merged = [];
+  for (const iv of raw) {
+    const last = merged[merged.length - 1];
+    if (last && iv[0] <= last[1] + 1e-9) last[1] = Math.max(last[1], iv[1]);
+    else merged.push([...iv]);
+  }
+  return merged;
+}
+
+/** The `RESERVED_ARCS` literal as playerIdentity.ts declares it. NONE is a legal reading and
+ *  the honest one: it is what a full-circle walk declares, and check 2 then prices it. */
+function declaredArcs(ts) {
+  const block = ts.match(/RESERVED_ARCS[^=]*=\s*\[([\s\S]*?)\n\];/);
+  if (!block) return [];
+  return [...block[1].matchAll(/\[\s*([\d.]+)\s*,\s*([\d.]+)\s*\]/g)].map((m) => [
+    Number(m[1]),
+    Number(m[2]),
+  ]);
+}
+
+/** The walk those arcs produce — playerIdentity.ts's own, re-derived rather than imported. */
+function walk(arcs, n) {
+  const open = [];
+  let cut = 0;
+  for (const [a, b] of arcs) {
+    if (a > cut) open.push([cut, a]);
+    cut = Math.max(cut, b);
+  }
+  if (cut < 360) open.push([cut, 360]);
+  const span = open.reduce((s, [a, b]) => s + (b - a), 0);
+  const step = span * ((3 - Math.sqrt(5)) / 2);
+  return Array.from({ length: n }, (_, i) => {
+    let p = (((i * step) % span) + span) % span;
+    for (const [a, b] of open) {
+      if (p < b - a) return a + p;
+      p -= b - a;
+    }
+    return open[open.length - 1][1];
+  });
+}
+
+// ── the two checks, as pure functions of their two texts (so the self-test can feed them) ────
+
+function check1ArcsAgree(css, ts) {
+  const inks = reservedInks(css);
+  const derived = deriveArcs(inks.map((i) => i.h));
+  const declared = declaredArcs(ts);
+  const out = [];
+  if (derived.length !== declared.length)
+    out.push(
+      `index.css derives ${derived.length} reserved arc(s) from ${inks.length} chromatic ` +
+        `declarations; playerIdentity.ts declares ${declared.length}`,
+    );
+  for (let i = 0; i < Math.min(derived.length, declared.length); i++)
+    for (const [e, name] of [
+      [0, "start"],
+      [1, "end"],
+    ])
+      if (Math.abs(derived[i][e] - declared[i][e]) > TOL)
+        out.push(
+          `arc ${i} ${name}: index.css says ${derived[i][e].toFixed(4)}°, ` +
+            `playerIdentity.ts says ${declared[i][e].toFixed(4)}°`,
+        );
