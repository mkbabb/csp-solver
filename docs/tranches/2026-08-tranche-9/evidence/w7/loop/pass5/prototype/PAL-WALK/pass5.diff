+  for (const token of Object.keys(want)) {
+    const at = calls.filter((c) => c[1] === token).map((c) => c[2]);
+    if (!at.length)
+      out.push(`playerIdentity.ts writes no string at ${token} through a band table`);
+    for (const t of at)
+      if (t !== want[token])
+        out.push(
+          `the ${token} string is bisected against ${t}, not ${want[token]} — a second table the comparer does not hold`,
+        );
