+test("§B the ring, photographed — the line the product actually draws", async ({ page }, info) => {
+  await page.goto(SOLO);
+  await settled(page);
+  // THE BOIL PARKS AT IDLE, and until it does the two photographs differ everywhere the grid is.
+  // One wait, once, before any of them — not a per-shot sleep.
+  await page.waitForTimeout(2500);
+  const dpr = await page.evaluate(() => window.devicePixelRatio);
+  // The hands the CORE MEDIAN finds hardest over all 144 at the chair's pair (the pass-5 sweep):
+  // light i=6 / 95 (3.133), dark i=86 / 89 / 5 (3.341–3.348) — five per arm, both arms.
+  //
+  // THE ROW'S SCOPE, SAID: five hands per arm on every run; `WALK_SWEEP=1` photographs all 144
+  // (≈10 min an engine per density) and is how the five are re-chosen — pass 5 ran it at dpr
+  // 1/2/3: `evidence/w7/loop/pass5/prototype/PAL-WALK/`.
+  const HANDS = [5, 6, 86, 89, 95];
+  for (const arm of ["light", "dark"] as const) {
+    await theme(page, arm);
+    const shipped = await page.evaluate(() =>
+      getComputedStyle(document.documentElement).getPropertyValue("--peer-ring-l").trim(),
+    );
+    const sweep = !!process.env.WALK_SWEEP;
+    for (const i of sweep ? Array.from({ length: 144 }, (_, k) => k) : HANDS) {
+      const p = await paintedRing(page, i);
+      const c = p.core;
+      console.log(
+        `[${info.project.name}/${arm}] dpr ${dpr} band ${shipped} i=${i}: ` +
+          `isTheRing ${p.isTheRing} (Δ to computed ${p.deltaToComputed.toFixed(1)}) · ` +
+          `CORE px ${c.px} max ${c.max.toFixed(3)} p30 ${c.p30.toFixed(3)} median ${c.median.toFixed(3)} ` +
+          `frac<3 ${(c.under3 * 100).toFixed(1)}% noise ${c.noise} · scan core ${p.ratio.toFixed(3)} · ` +
+          `sensitivity ${p.sensitivity} · ${p.where}`,
+      );
+      expect(p.isTheRing, `the sampler found the ring, ${arm} i=${i}`).toBe(true);
+      expect(c.median, `painted ring core median, ${arm} i=${i}, dpr ${dpr}`).toBeGreaterThanOrEqual(
+        CORE_FLOOR,
+      );
+    }
+  }
+  await page.evaluate(() => document.documentElement.classList.remove("dark"));
+});
+
+/**
+ * THE NAME ON THE TAPE, PAINTED (the pass-4 critic's instrument, landed): the label photographed
+ * as drawn and again with its colour set transparent, so every pixel the TEXT changed is found and
+ * read against the ground actually painted under it — grid line, digit, tape paper and all. A
+ * composite over a flat card is the ground the tape is not always on; this is the one it is.
+ */
+async function paintedName(
+  page: Page,
+  label: ReturnType<Page["locator"]>,
+): Promise<{
+  spec: string;
+  textPx: number;
+  worst: number;
+  under45: number;
+  coreWorst: number;
+  corePx: number;
+  noise: number;
+  sensitivity: string;
+  ground: [number, number];
+}> {
+  // THE TEXT'S OWN BOX, not the label's: the label's box also holds the board beyond the paper's
+  // torn ends, where the grid's boil cycles its variants between photographs and a repainted grid
+  // pixel reads as "text over a dark ground". A Range over the name bounds exactly the glyphs.
+  const box = await label.evaluate((l) => {
+    const r = document.createRange();
+    r.selectNodeContents(l);
+    const b = r.getBoundingClientRect();
+    return { x: b.x, y: b.y, width: b.width, height: b.height };
+  });
+  const clip = { x: box.x - 1, y: box.y - 1, width: box.width + 2, height: box.height + 2 };
+  const ink = await rawOf(page, await page.screenshot({ clip }));
+  const spec = await label.evaluate((l) => getComputedStyle(l).color);
+  await label.evaluate((l) => ((l as HTMLElement).style.color = "transparent"));
+  await expect.poll(() => label.evaluate((l) => getComputedStyle(l).color)).toBe("rgba(0, 0, 0, 0)");
+  const bare = await rawOf(page, await page.screenshot({ clip }));
+  await label.evaluate((l) => ((l as HTMLElement).style.color = ""));
+  await expect.poll(() => label.evaluate((l) => getComputedStyle(l).color)).toBe(spec);
+  // THE NOISE CONTROL: the name photographed a second time, so a pixel the grid's boil repainted
+  // between the photographs (outside the paper's torn edge, inside the label's box) is named and
+  // dropped rather than read as text over a dark ground.
+  const again = await rawOf(page, await page.screenshot({ clip }));
+  const specRgb = await page.evaluate((css) => {
+    const c = document.createElement("canvas");
+    c.width = c.height = 1;
+    const g = c.getContext("2d", { willReadFrequently: true })!;
+    g.fillStyle = css;
+    g.fillRect(0, 0, 1, 1);
+    return Array.from(g.getImageData(0, 0, 1, 1).data.slice(0, 3));
+  }, spec);
+  const lin = (v: number): number => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
+  const lum = (d: number[], k: number): number =>
+    0.2126 * lin(d[k] / 255) + 0.7152 * lin(d[k + 1] / 255) + 0.0722 * lin(d[k + 2] / 255);
+  const ratio = (x: number, y: number): number => (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
+  const specL = lum(specRgb, 0);
+  const moved: number[] = [];
+  let top = 0;
+  let noise = 0;
+  for (let k = 0; k < ink.data.length; k += 4) {
+    const n =
+      Math.abs(ink.data[k] - again.data[k]) +
+      Math.abs(ink.data[k + 1] - again.data[k + 1]) +
+      Math.abs(ink.data[k + 2] - again.data[k + 2]);
+    if (n > 8) {
+      noise++;
+      moved.push(0);
+      continue;
+    }
+    const d =
+      Math.abs(ink.data[k] - bare.data[k]) +
+      Math.abs(ink.data[k + 1] - bare.data[k + 1]) +
+      Math.abs(ink.data[k + 2] - bare.data[k + 2]);
+    moved.push(d);
+    if (d > top) top = d;
+  }
+  const text: number[] = [];
+  const core: number[] = [];
+  const painted: { d: number; r: number }[] = [];
+  let lo = 1;
+  let hi = 0;
+  moved.forEach((d, n) => {
+    if (d <= 0.2 * top) return;
+    const gl = lum(bare.data, n * 4);
+    lo = Math.min(lo, gl);
+    hi = Math.max(hi, gl);
+    text.push(ratio(specL, gl));
+    const pr = ratio(lum(ink.data, n * 4), gl);
+    painted.push({ d, r: pr });
+    if (d >= 0.8 * top) core.push(pr);
+  });
+  return {
+    spec,
+    textPx: text.length,
+    worst: Math.min(...text),
+    under45: text.filter((r) => r < 4.5).length,
+    coreWorst: Math.min(...core),
+    corePx: core.length,
+    noise,
+    // THE SENSITIVITY ROW (LAWS §Gates): the painted glyph pixel against its own ground, at
+    // 50/70/90/100 % of the most-changed pixel — the median and the share under 4.5 at each.
+    // An antialiased glyph never reaches its spec colour at its edge, so the painted columns
+    // are printed; the spec colour against the ground actually painted is what is asserted.
+    sensitivity: [0.5, 0.7, 0.9, 1.0]
+      .map((f) => {
+        const r = painted
+          .filter((q) => q.d >= f * top)
+          .map((q) => q.r)
+          .sort((u, v) => u - v);
+        return `${f * 100}%: median ${r[r.length >> 1]?.toFixed(3)} · ${r.filter((v) => v < 4.5).length}/${r.length} under 4.5`;
+      })
+      .join(" | "),
+    ground: [lo, hi],
+  };
+}
+
+test("§C the name on the tape is written in the ring's string, and reads 4.5 on the ground it is painted on", async ({
+  context,
+}, info) => {
+  // Two pages in ONE context, so `?wire=local`'s BroadcastChannel is the room — the product's
+  // own invite flow (the well's verb writes `?s=`), digits written by B, the tape hovered on A.
+  // The cells are the ones where the tape crosses a GRID LINE with a digit under it (an empty cell
+  // with a given above) and the top row, where it flips below.
+  const a = await context.newPage();
+  await a.goto(SOLO);
+  await settled(a);
+  const verb = a.locator('.controls-card button[aria-label="Play together on this board"]');
+  await expect(verb).toBeEnabled();
+  await verb.click();
+  await expect.poll(() => new URL(a.url()).searchParams.get("s")).not.toBeNull();
+  const b = await context.newPage();
+  await b.goto(a.url());
+  await settled(b);
+  const inputs = (p: Page) => p.locator(".sudoku-cell input");
+  const givens = await a.evaluate(() =>
+    [...document.querySelectorAll(".sudoku-cell input")]
+      .map((i) => (i as HTMLInputElement).value || ".")
+      .join(""),
+  );
+  expect(givens, "the encoded board decoded").toBe(GIVENS);
+  const empty = [...givens].flatMap((ch, i) => (ch === "." ? [i] : []));
+  const cells = [
+    ...empty.filter((i) => i >= 9 && givens[i - 9] !== ".").slice(0, 3),
+    ...empty.filter((i) => i < 9).slice(0, 1),
+  ];
+  for (const x of cells) {
+    await inputs(b).nth(x).click();
+    await inputs(b).nth(x).fill("7");
+    await expect.poll(() => inputs(a).nth(x).inputValue()).toBe("7");
+  }
+  await inputs(b).nth(givens.indexOf("3")).click({ force: true }); // B's cursor off the four
+  await a.waitForTimeout(2500); // sleep-ok: the boil parks before a byte is read
+  for (const arm of ["light", "dark"] as const) {
+    await theme(a, arm);
+    for (const x of cells) {
+      const label = a.locator(".attribution-tape .washi-label");
+      // The hover is re-made until the tape mounts: under load WebKit can drop the first
+      // pointer move onto a cell (measured once in the pass-5 battery, never twice running).
+      await expect(async () => {
+        await a.mouse.move(2, 2);
+        await a.locator(".game-cell").nth(x).hover();
+        await expect(label).toBeVisible({ timeout: 3000 });
+      }).toPass({ timeout: 30000 });
+      const ring = await label.evaluate((l) => {
+        const probe = document.createElement("span");
+        l.parentElement!.appendChild(probe);
+        probe.style.color = "var(--color-peer-cursor-ink)";
+        const c = getComputedStyle(probe).color;
+        probe.remove();
+        return c;
+      });
+      const t = await paintedName(a, label);
+      console.log(
+        `[${info.project.name}/${arm}] cell ${x}${x < 9 ? " (top row, below)" : " (given above)"} name ${t.spec} · ` +
+          `spec vs painted ground worst ${t.worst.toFixed(3)} (${t.under45}/${t.textPx} px < 4.5) · ` +
+          `painted core worst ${t.coreWorst.toFixed(3)} (${t.corePx} px) · sensitivity ${t.sensitivity} · noise ${t.noise} px · ground lum ${t.ground.map((v) => v.toFixed(4)).join("..")}`,
+      );
+      expect(t.spec).toBe(ring);
+      expect(t.worst, `the name over the ground it is painted on, ${arm} cell ${x}`).toBeGreaterThanOrEqual(4.5);
+      await a.mouse.move(2, 2);
+      await expect(label).toHaveCount(0);
+    }
+  }
+});
