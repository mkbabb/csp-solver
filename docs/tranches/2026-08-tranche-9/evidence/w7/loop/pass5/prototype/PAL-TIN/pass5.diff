+    ["light", "dark"].flatMap((a) =>
+      [...arms[a].sticks, ...arms[a].rings].map((s) => s.hex),
+    ),
+  );
+  let spelled = 0;
+  for (const f of files) {
+    const text = uncomment(f.text);
+    for (const re of [
+      new RegExp(`${PEER_TOKEN.source}\\s*:`, "g"),
+      new RegExp(`["'\`]${PEER_TOKEN.source}["'\`]\\s*:`, "g"),
+      new RegExp(`setProperty\\(\\s*["'\`]${PEER_TOKEN.source}["'\`]`, "g"),
+    ])
+      for (const m of text.matchAll(re))
+        findings.push(
+          `4a: ${f.rel} declares ${m[1]} — a second publisher of the tin index.css owns`,
+        );
+    for (const m of text.matchAll(/#[0-9a-fA-F]{6}\b/g))
+      if (published.has(m[0].toLowerCase())) {
+        spelled++;
+        findings.push(`4a: ${f.rel} spells ${m[0]}, which index.css publishes`);
+      }
