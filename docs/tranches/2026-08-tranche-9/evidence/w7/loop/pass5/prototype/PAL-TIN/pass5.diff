+        "--peer-ring-l: 0.295;\n  --color-peer-1-ring:",
+      ),
+      SOURCES,
+    ],
+    [
+      "a runtime setProperty of a ring arm in a spec",
+      css,
+      plant(
+        "e2e/planted.spec.ts",
+        'document.documentElement.style.setProperty("--color-peer-1-ring", "red");\n',
+      ),
+    ],
+    [
+      "a tin hex spelled in a source file",
+      css,
+      plant(G, `export const x = "${arms.light.rings[0].hex}";\n`),
+    ],
+    [
+      "4b · the light amber ring arm moved L +0.02 off the pair",
+      swapRing(css, "light", 1, nudge(arms.light.rings[0].hex, 0.02)),
+      SOURCES,
+    ],
+  ])
+    controls.push([`4 (${label})`, "g4", label, text, sources]);
