+          findings.push(
+            `4a: ${f.rel}'s \`${name}\` carries ${nums.join(", ")} — a band table, and a second ` +
+              `publisher whether or not it agrees with the pair (${RING_PAIR.light} / ${RING_PAIR.dark})`,
+          );
+      }
+      if (/peer|ring|hand|player/i.test(name)) {
+        const hexes = body.match(/#[0-9a-fA-F]{6}\b/g) ?? [];
