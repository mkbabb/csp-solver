+      `${files.length} source files under src/ and e2e/ read · ${spelled} tin hexes spelled in code`,
+  };
+}
+
+/** Every `.css`/`.vue`/`.ts`/`.mts` under `src/` and `e2e/` except index.css itself. A test
+ *  fixture is a publisher too — a band pinned in a spec is a second copy of the number. */
+function sourceFiles() {
+  const out = [];
+  const walk = (dir) => {
+    for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
+      const p = path.join(dir, e.name);
+      if (e.isDirectory()) walk(p);
+      else if (/\.(css|vue|ts|mts)$/.test(e.name) && p !== INDEX_CSS)
