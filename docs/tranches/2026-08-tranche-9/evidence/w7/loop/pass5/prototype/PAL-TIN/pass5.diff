+      drop(css, "light", 3),
+    ],
+    [
+      "3b",
+      "g3b",
+      "peer-1's light ring arm swung 4deg off its stick",
+      swapRing(
+        css,
+        "light",
+        1,
+        at(arms.light.rings[0].hex, hueOf(arms.light.rings[0].hex) + 4),
+      ),
+    ],
+  ];
+  // GATE 4 — the second publishers the pass-4 critic planted (A1 A2 A4 A5 A6), the leader's two
+  // band rules (B1 B2), a runtime `setProperty` in a spec, a tin hex spelled in code, and a
+  // ring arm moved off the pair. Every one reds, agree or disagree.
+  const plant = (rel, text) => [...SOURCES, { rel, text }];
+  const G = "src/games/shared/planted.ts";
+  for (const [label, text, sources] of [
+    [
+      "A1 · gameCell.css redeclares a ring arm",
+      css,
+      plant(
+        "src/games/shared/gameCell.css",
+        ":root { --color-peer-2-ring: #2a3900; }\n",
+      ),
+    ],
+    [
+      "A2 · an agreeing pair under another name",
+      css,
+      plant(G, "export const ringLightness = { light: 0.295, dark: 0.79 };\n"),
+    ],
+    [
+      "A4 · a drifted hex table of ring arms",
+      css,
+      plant(G, 'export const RING = { light: ["#552200", "#2a3900"] };\n'),
+    ],
+    [
+      "A5 · RING_BANDS agreeing with the pair",
+      css,
+      plant(G, "export const RING_BANDS = { light: 0.295, dark: 0.79 };\n"),
+    ],
+    [
+      "A6 · RING_BANDS far from the pair",
+      css,
+      plant(G, "export const RING_BANDS = { light: 0.5, dark: 0.6 };\n"),
+    ],
+    [
+      "B1 · a band rule in gameCell.css",
+      css,
+      plant("src/games/shared/gameCell.css", ".game-cell { --peer-ring-l: 0.2; }\n"),
+    ],
+    [
+      "B2 · the sheet grows a scalar again",
+      css.replace(
