+  let lo = 0;
+  let hi = 0.5;
+  for (let i = 0; i < 60; i++) {
+    const mid = (lo + hi) / 2;
+    if (inGamut(rgbOfOklch(L, mid, hDeg))) lo = mid;
+    else hi = mid;
+  }
+  return lo;
+}
+const hexOfRgb = (rgb) =>
+  "#" +
+  rgb
