+  const quiet =
+    gate4(
+      css,
+      arms,
+      plant(
+        G,
+        "/* --peer-ring-l: 0.2; RING = [0.2, 0.79] */\nconst ring = `var(--color-peer-2-ring)`;\n",
+      ),
+    ).findings.length !== base.red.g4;
+  console.log(
+    `\n— GATE 4 on a consumer and a comment: ${quiet ? "RED (wrong)" : "unmoved, as it must be"} —`,
+  );
+  if (quiet) code = code || 3;
+
+  for (const [gate, key, what, text, sources] of controls) {
+    console.log(`\n— negative control for GATE ${gate}: ${what} —`);
+    const r = run(text, `control-${gate}`, sources ?? SOURCES);
+    if (!(r.red[key] > base.red[key])) {
+      console.error(
+        `SELF-TEST FAILED: gate ${gate} stayed GREEN under its own control`,
+      );
+      code = code || 3;
+    } else console.log(`SELF-TEST: gate ${gate} is RED, as it must be`);
+  }
+}
+
+process.exit(code);
