+/** A pose is settled when two reads 150ms apart agree — the dock's slide, the sheet's fade and
+ *  the mark's ink each end on their own clock, and this waits for the clock, not a guess at it. */
+async function stable(read: () => Promise<unknown>) {
+  let last: unknown = Symbol('unread');
+  await expect
+    .poll(
+      async () => {
+        const v = JSON.stringify(await read());
+        const same = v === last;
+        last = v;
+        return same;
+      },
+      { intervals: [150], timeout: 8000 },
+    )
+    .toBe(true);
