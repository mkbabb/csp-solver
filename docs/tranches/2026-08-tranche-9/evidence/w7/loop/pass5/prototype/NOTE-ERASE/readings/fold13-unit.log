+ /** A WAAPI mover SPENDS a verb at a rung (T9-W7 §13): it never types a number and it
+  *  never picks a curve. Returns the options half of `element.animate(keyframes, …)`;
+  *  the keyframes stay the caller's, because the SHAPE is theirs and the TIMING is ours.
+  *  The fill comes from the VERB (pass 2) — it is the verb's arm, not the mover's taste, and
+  *  no verb fills `forwards`, so `FILL_ALLOWLIST` never hears about a spend. */
+ export const spend = <V extends WaapiVerb>(
+   verb: V,
+   rung: (typeof MOTION.verbs)[V]["rungs"][number],
+ ) =>
+   ({
+     duration: MOTION.rungs[rung],
+     easing: MOTION.verbs[verb].ease,
+     fill: MOTION.verbs[verb].fill,
+     composite: "replace",
+   }) as const;
