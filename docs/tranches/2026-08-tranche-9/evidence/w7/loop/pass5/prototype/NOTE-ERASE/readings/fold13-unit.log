+  *  verb has no options half to hand a mover. */
+ type WaapiVerb = {
+   [
+     K in keyof typeof MOTION.verbs
+   ]: "waapi" extends (typeof MOTION.verbs)[K]["mechanism"][number] ? K : never;
+ }[keyof typeof MOTION.verbs];
