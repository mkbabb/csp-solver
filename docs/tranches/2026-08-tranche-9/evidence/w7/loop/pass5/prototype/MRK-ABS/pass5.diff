+// PRM: live, because the board ledger is read in the regime the product ships (its figures
+// reproduce to the third decimal run to run) and G-ABS-4 reads a live focus's first frame; G-ABS-3
+// alone parks the boil — emulateMedia({reducedMotion:'reduce'}) before its goto — because its grounds
+// ride the board's boiling edge and a worst sample on a moving ground is not a quantity.
+/**
+ * THE FOCUS RING — the board ring's ledger and geometry, the chrome ring's ink and floor (T9-W7 §5/§6).
+ *
+ * Four rows, each carrying its own negative control IN THE SAME RUN (the row is only a gate if
+ * the control reds):
+ *
+ *   G-ABS-5  THE LEDGER IS TRUE. `index.css`'s `--color-focus-sketch` comment carries a ledger:
+ *            the tier-2 opacity it was read at, and one row per board × ground × theme × engine.
+ *            Every figure in that comment must be a ledger row (or the opacity); the opacity must
+ *            equal `gameCell.css` tier 2's source text AND the painted ring's computed value; every
+ *            row must sit within a tenth of the painted reading. Controls: tier 2 ablated to 0.9 at
+ *            runtime (opacity + paint clauses red), the source text mutated (opacity clause reds),
+ *            every figure falsified to 9.99 (paint clause reds), one unguarded figure appended
+ *            (figure clause reds).
+ *   G-ABS-7  MA-N FROM THE DOM. At 16×16, every cell: the ring's painted outer ink (its vertices
+ *   G-ABS-8  through the path's own screen CTM, plus half the heaviest stroke the sheet draws)
+ *            stays inside its own cell. The resident `d` is first proved byte-identical to the
+ *            recipe below at `RING_GEOMETRY` (G-ABS-8) — so the recipe IS the product — and the
+ *            same recipe at inset 1.00 must ENTER a neighbour (the witness that the inset is
+ *            load-bearing).
+ *   G-ABS-4  ONE INK. On every game route, both themes: every focus stop's ring host paints one
+ *            token colour (law 39's dashed tab aside), `outline-style: auto` nowhere, and the
+ *            colour is already the final one on the first frame. Control: one stop re-styled to
+ *            `outline: auto` must red the clause.
+ *   G-ABS-3  THE CHROME FLOOR, PAINTED, THE BOIL PARKED. Home route, both themes: each stop's ring
+ *            read from painted bytes along each side's normal (ring OFF = the same pixels blurred;
+ *            the changed pixel must BE the computed outline ink). A stop passes when no sample line
+ *            reads under 3:1; an ADMITTED stop carries the fraction it is allowed and reds STALE
+ *            when it obeys the rule. Control: a stranded near-ground ring injected on one stop.
+ *
+ * The board ledger is read in the default regime (its figures reproduce to the third decimal run
+ * to run); the chrome floor with `prefers-reduced-motion: reduce`, which parks the boil — the
+ * tab and deck grounds ride the board's boiling edge, and a worst sample on a moving ground is
+ * not a quantity. Every read settles by POLLING, never by a fixed wait.
+ */
+import { test, expect, type Page } from "@playwright/test";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { wobbleRect } from "@mkbabb/pencil-boil";
+import { RING_GEOMETRY } from "../src/pencil/config/pencilConfig";
+
+const FE = join(fileURLToPath(new URL(".", import.meta.url)), "..");
+const INDEX_CSS = readFileSync(join(FE, "src/assets/index.css"), "utf8");
+const CELL_CSS = readFileSync(join(FE, "src/games/shared/gameCell.css"), "utf8");
+const TIER2 = ".game-cell:has(input:focus-visible) .cell-ghost-path";
+
+type RGB = number[];
+type Engine = "chromium" | "webkit";
+const lin = (c: number) => (c / 255 <= 0.04045 ? c / 255 / 12.92 : Math.pow((c / 255 + 0.055) / 1.055, 2.4));
+const lum = (c: RGB) => 0.2126 * lin(c[0]) + 0.7152 * lin(c[1]) + 0.0722 * lin(c[2]);
+const ratio = (a: RGB, b: RGB) => (Math.max(lum(a), lum(b)) + 0.05) / (Math.min(lum(a), lum(b)) + 0.05);
+const dist = (a: RGB, b: RGB) => Math.abs(a[0] - b[0]) + Math.abs(a[1] - b[1]) + Math.abs(a[2] - b[2]);
+const r3 = (x: number) => Math.round(x * 1000) / 1000;
+
+/** A real `?board=` payload in the app's own codec: base64url("\x01" + "<sub>.<cells base36>"). A
+ *  valid pattern solution, about two givens in five, cells 0 and 1 held EMPTY (the frame crossing
+ *  and the paper cell the ledger reads). */
+function mint(sub: number): string {
+  const n = sub * sub;
+  let cells = "";
+  for (let r = 0; r < n; r++)
+    for (let c = 0; c < n; c++) {
+      const i = r * n + c;
+      const keep = i > 1 && (r * 7 + c * 3) % 5 < 2;
+      cells += (keep ? ((r * sub + Math.floor(r / sub) + c) % n) + 1 : 0).toString(36);
+    }
+  return btoa(String.fromCharCode(1) + `${sub}.${cells}`).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+}
+
+async function loadBoard(page: Page, sub: number) {
+  const payload = mint(sub);
+  await page.goto(`/?size=${sub}&board=${payload}`);
+  await expect.poll(() => page.locator(".board-shell .game-cell").count(), { timeout: 120000 }).toBe(sub ** 4);
+  await expect.poll(() => page.evaluate(() => new URLSearchParams(location.search).get("board"))).toBe(payload);
+}
+
+async function setTheme(page: Page, want: "light" | "dark") {
+  const isDark = () => page.evaluate(() => document.documentElement.classList.contains("dark"));
+  if ((await isDark()) !== (want === "dark")) {
+    await page.locator("button.sun-moon-toggle").first().focus();
+    await page.keyboard.press("Enter");
+    await expect.poll(isDark, { timeout: 10000 }).toBe(want === "dark");
+  }
+  await page.evaluate(() => (document.activeElement as HTMLElement)?.blur?.());
+  await settled(page);
+}
+
+/** Settled = no running finite animation anywhere in the document (the theme's bake, a ring's
+ *  draw-on, a fold). Infinite loops (the boil's ticker is not an Animation) never block it. */
+const settled = (page: Page) =>
+  expect
+    .poll(
+      () =>
+        page.evaluate(
+          () =>
+            document
+              .getAnimations()
+              .filter((a) => a.playState === "running" && a.effect?.getTiming().iterations !== Infinity).length,
+        ),
+      { timeout: 15000 },
+    )
+    .toBe(0);
+
+async function inject(page: Page, css: string, id: string) {
+  await page.evaluate(
+    ({ css, id }) => {
+      document.getElementById(id)?.remove();
+      if (!css) return;
+      const s = document.createElement("style");
+      s.id = id;
+      s.textContent = css;
+      document.head.appendChild(s);
+    },
+    { css, id },
+  );
+}
+
+/** The painted bytes of a clip, decoded in the page (no image library in the estate). */
+async function pixels(page: Page, clip: { x: number; y: number; width: number; height: number }) {
+  const png = await page.screenshot({ clip, scale: "css" });
+  const data: number[] = await page.evaluate(
+    async ({ b64, w, h }) => {
+      const img = new Image();
+      img.src = `data:image/png;base64,${b64}`;
+      await img.decode();
+      const c = document.createElement("canvas");
+      c.width = w;
+      c.height = h;
+      const g = c.getContext("2d")!;
+      g.drawImage(img, 0, 0);
+      return Array.from(g.getImageData(0, 0, w, h).data);
+    },
+    { b64: png.toString("base64"), w: clip.width, h: clip.height },
+  );
+  return (x: number, y: number): RGB | null => {
+    const px = Math.round(x - clip.x),
+      py = Math.round(y - clip.y);
+    if (px < 0 || py < 0 || px >= clip.width || py >= clip.height) return null;
+    const o = (py * clip.width + px) * 4;
+    return [data[o], data[o + 1], data[o + 2]];
+  };
+}
+
+// ── G-ABS-5 · the ledger ─────────────────────────────────────────────────────────────────────
+// A figure: two or more decimals, not the tail of a dotted number ("1.4.11"), and still a figure
+// when it ends a sentence ("read 4.15.").
+const FIGURE = /(?<!\d\.)(?<!\d)\d+\.\d{2,}(?!\d|\.\d)/g;
+type LedgerRow = { board: string; on: string; light: Record<Engine, number>; dark: Record<Engine, number> };
+function ledger(css: string) {
+  const at = css.indexOf("--color-focus-sketch:");
+  const comment = css.slice(at, css.indexOf("*/", at));
+  const op = comment.match(/WORST of (\d+) samples, tier 2 at stroke-opacity (\d+(?:\.\d+)?)/);
+  const rows: LedgerRow[] = [];
+  const guarded: string[] = op ? [op[2]] : [];
+  for (const m of comment.matchAll(/(16×16|9×9) (paper|frame)\s+light (\d+\.\d+) \/ (\d+\.\d+)\s+dark (\d+\.\d+) \/ (\d+\.\d+)/g)) {
+    rows.push({ board: m[1], on: m[2], light: { chromium: +m[3], webkit: +m[4] }, dark: { chromium: +m[5], webkit: +m[6] } });
+    guarded.push(m[3], m[4], m[5], m[6]);
+  }
+  const unguarded = [...comment.matchAll(FIGURE)].map((m) => m[0]);
+  for (const g of guarded) unguarded.splice(unguarded.indexOf(g), 1);
+  return { opacity: op ? +op[2] : null, rows, unguarded };
+}
+const tier2 = (src: string) => {
+  const i = src.indexOf(`${TIER2} {`);
+  return +(src.slice(i, src.indexOf("}", i)).match(/stroke-opacity:\s*([\d.]+)/)?.[1] ?? NaN);
+};
+
+/** The ledger's statistic: the ring's LEFT side, 60 samples along the drawn path, at each the
+ *  pixel of a 3×3 window that changed most between blurred and focused; WORST of 60. */
+async function ledgerRead(page: Page, idx: number) {
+  const geom = () =>
+    page.evaluate((i) => {
+      const cell = document.querySelectorAll(".board-shell .game-cell")[i] as HTMLElement;
+      const p = cell.querySelector(".cell-ghost-path") as SVGPathElement;
+      const m = p.getScreenCTM()!;
+      const pts = [...p.getAttribute("d")!.matchAll(/[ML]\s*(-?[\d.eE+]+),(-?[\d.eE+]+)/g)].map((g) => [
+        m.e + m.a * +g[1],
+        m.f + m.d * +g[2],
+      ]);
+      const r = cell.getBoundingClientRect();
+      return { pts, so: getComputedStyle(p).strokeOpacity, box: { x: r.x, y: r.y, w: r.width, h: r.height } };
+    }, idx);
+  const g0 = await geom();
+  const clip = { x: Math.floor(g0.box.x - 20), y: Math.floor(g0.box.y - 20), width: Math.ceil(g0.box.w + 40), height: Math.ceil(g0.box.h + 40) };
+  await page.evaluate(() => (document.activeElement as HTMLElement)?.blur?.());
+  await settled(page);
+  const before = await pixels(page, clip);
+  await page.locator(".board-shell .game-cell .cell-native-input").nth(idx).focus();
+  await page.keyboard.press("Shift");
+  await expect.poll(() => page.evaluate(() => document.querySelectorAll(".game-cell:has(input:focus-visible)").length)).toBe(1);
+  await settled(page);
+  const g = await geom();
+  const after = await pixels(page, clip);
+  await page.evaluate(() => (document.activeElement as HTMLElement)?.blur?.());
+  const nv = g.pts.length % 4 === 1 ? g.pts.length - 1 : g.pts.length;
+  const side = g.pts.slice((3 * nv) / 4, nv).concat([g.pts[0]]);
+  const took: number[] = [];
+  for (let i = 0; i < 60; i++) {
+    const t = ((i + 0.5) / 60) * (side.length - 1);
+    const k = Math.min(side.length - 2, Math.floor(t)),
+      f = t - k;
+    const x = side[k][0] + f * (side[k + 1][0] - side[k][0]),
+      y = side[k][1] + f * (side[k + 1][1] - side[k][1]);
+    let best: { d: number; r: number } | null = null;
+    for (let dx = -1; dx <= 1; dx++)
+      for (let dy = -1; dy <= 1; dy++) {
+        const a = after(x + dx, y + dy),
+          b = before(x + dx, y + dy);
+        if (!a || !b) continue;
+        const d = dist(a, b);
+        if (!best || d > best.d) best = { d, r: ratio(a, b) };
+      }
+    if (best && best.d >= 8) took.push(best.r);
+  }
+  return { worst: took.length === 60 ? r3(Math.min(...took)) : null, strokeOpacity: +g.so };
+}
+
+test.describe("MRK-ABS · the board ring", () => {
+  test("G-ABS-5 · the ledger is true at the opacity it names, and reds when it is not", async ({ page }, info) => {
+    test.setTimeout(300000);
+    const engine = info.project.name as Engine;
+    const L = ledger(INDEX_CSS);
+    const srcOp = tier2(CELL_CSS);
+    const where = { "16×16": { sub: 4, cell: { paper: 1, frame: 0 } }, "9×9": { sub: 3, cell: { paper: 0 } } } as const;
+    const arms: Record<string, { reads: { board: string; on: string; theme: string; worst: number | null }[]; ops: number[] }> = {};
+    for (const arm of [
+      { name: "shipped", css: "" },
+      { name: "ablated-0.9", css: `${TIER2}{stroke-opacity:.9!important}` },
+    ]) {
+      const reads: { board: string; on: string; theme: string; worst: number | null }[] = [];
+      const ops: number[] = [];
+      for (const board of ["16×16", "9×9"] as const) {
+        await loadBoard(page, where[board].sub);
+        await inject(page, arm.css, "g-abs-5-arm");
+        for (const theme of ["light", "dark"] as const) {
+          await setTheme(page, theme);
+          for (const [on, idx] of Object.entries(where[board].cell)) {
+            const r = await ledgerRead(page, idx);
+            reads.push({ board, on, theme, worst: r.worst });
+            ops.push(r.strokeOpacity);
+          }
+        }
+      }
+      arms[arm.name] = { reads, ops };
+    }
+    const paintClause = (rows: LedgerRow[], reads: { board: string; on: string; theme: string; worst: number | null }[]) =>
+      rows.length === 3 &&
+      reads.every((r) => {
+        const row = rows.find((x) => x.board === r.board && x.on === r.on);
+        return !!row && r.worst !== null && Math.abs(r.worst - row[r.theme as "light" | "dark"][engine]) <= 0.1;
+      });
+    const opClause = (ledgerOp: number | null, source: number, computed: number[]) =>
+      ledgerOp !== null && ledgerOp === source && computed.every((o) => o === ledgerOp);
+    const lines = arms.shipped.reads.map((r) => {
+      const row = L.rows.find((x) => x.board === r.board && x.on === r.on);
+      return `${r.board} ${r.on} ${r.theme}: painted ${r.worst} ledger ${row?.[r.theme as "light" | "dark"][engine]}`;
+    });
+    console.log(`[G-ABS-5 ${engine}] opacity ledger ${L.opacity} source ${srcOp} computed ${[...new Set(arms.shipped.ops)]} · ablated ${[...new Set(arms["ablated-0.9"].ops)]}\n${lines.join("\n")}\nablated: ${arms["ablated-0.9"].reads.map((r) => r.worst).join(" ")}`);
+    // THE GATE, on the tree.
+    expect(L.unguarded, "every figure in the ledger comment is a ledger row").toEqual([]);
+    expect(opClause(L.opacity, srcOp, arms.shipped.ops), `opacity: ledger ${L.opacity}, source ${srcOp}, computed ${arms.shipped.ops}`).toBe(true);
+    expect(paintClause(L.rows, arms.shipped.reads), lines.join("\n")).toBe(true);
+    // ITS CONTROLS, same run.
+    expect(opClause(L.opacity, srcOp, arms["ablated-0.9"].ops), "control: tier 2 ablated to 0.9 reds the opacity clause").toBe(false);
+    expect(paintClause(L.rows, arms["ablated-0.9"].reads), "control: tier 2 ablated to 0.9 reds the paint clause").toBe(false);
+    const t2 = CELL_CSS.indexOf(`${TIER2} {`);
+    const t2end = CELL_CSS.indexOf("}", t2);
+    const mutated = CELL_CSS.slice(0, t2) + CELL_CSS.slice(t2, t2end).replace(/stroke-opacity:\s*[\d.]+/, "stroke-opacity: 0.9") + CELL_CSS.slice(t2end);
+    expect(opClause(L.opacity, tier2(mutated), arms.shipped.ops), "control: the source text moved reds the opacity clause").toBe(false);
+    const falsified = ledger(INDEX_CSS.replace(/(\b(?:light|dark) )(\d+\.\d+) \/ (\d+\.\d+)/g, "$19.99 / 9.99"));
+    expect(falsified.rows.length, "control: the falsified ledger still parses").toBe(3);
+    expect(paintClause(falsified.rows, arms.shipped.reads), "control: every figure falsified to 9.99 reds the paint clause").toBe(false);
+    const stray = ledger(INDEX_CSS.replace("Until the owner rules,", "The guard's faces read 4.15. Until the owner rules,"));
+    expect(stray.unguarded, "control: an unguarded figure in the comment reds the figure clause").toEqual(["4.15"]);
+  });
+
+  test("G-ABS-7 · MA-N from the DOM: no ring enters its neighbour (G-ABS-8 identity; the f = 1.00 witness)", async ({ page }) => {
+    test.setTimeout(180000);
+    await loadBoard(page, 4);
+    const cells = await page.evaluate(() =>
+      [...document.querySelectorAll(".board-shell .game-cell")].map((cell) => {
+        const p = cell.querySelector(".cell-ghost-path") as SVGPathElement;
+        const m = p.getScreenCTM()!;
+        const r = cell.getBoundingClientRect();
+        return { d: p.getAttribute("d")!, m: [m.a, m.d, m.e, m.f], box: [r.x, r.y, r.width, r.height] };
+      }),
+    );
+    const N = 16,
+      V = 1000,
+      cs = V / N,
+      SEED = 42;
+    // The recipe of `generateCellRects` (gridPaths.ts), inset free; G-ABS-8 below proves it IS the
+    // product at RING_GEOMETRY before the witness is allowed to speak.
+    const ring = (pos: number, inset: number) => {
+      const size = inset * cs,
+        pad = ((1 - inset) / 2) * cs;
+      const r = Math.floor(pos / N),
+        c = pos % N;
+      return wobbleRect(c * cs + pad, r * cs + pad, size, size, {
+        roughness: RING_GEOMETRY.wanderUnits / (0.015 * size),
+        segments: 4,
+        seed: SEED + 500 + pos * 7,
+        jagged: true,
+      });
+    };
+    const clearance = (d: string, m: number[], box: number[], stroke: number) => {
+      let worst = Infinity;
+      for (const g of d.matchAll(/[ML]\s*(-?[\d.eE+]+),(-?[\d.eE+]+)/g)) {
+        const x = m[2] + m[0] * +g[1],
+          y = m[3] + m[1] * +g[2];
+        const hs = (stroke / 2) * m[0];
+        worst = Math.min(worst, x - hs - box[0], box[0] + box[2] - (x + hs), y - hs - box[1], box[1] + box[3] - (y + hs));
+      }
+      return worst;
+    };
+    const identical = cells.filter((c, pos) => c.d === ring(pos, RING_GEOMETRY.inset)).length;
+    expect(identical, "G-ABS-8: every resident `d` is the recipe at RING_GEOMETRY").toBe(N * N);
+    for (const stroke of [7, 10]) {
+      const product = Math.min(...cells.map((c) => clearance(c.d, c.m, c.box, stroke)));
+      const witness = Math.min(...cells.map((c, pos) => clearance(ring(pos, 1), c.m, c.box, stroke)));
+      console.log(`[G-ABS-7] stroke ${stroke}: product ${r3(product)} px · witness f=1.00 ${r3(witness)} px · identical ${identical}/${N * N} · scale ${r3(cells[0].m[0])} px/u`);
+      expect(product, `G-ABS-7 stroke ${stroke}: the ring's outer ink stays inside its own cell (px)`).toBeGreaterThanOrEqual(0);
+      if (stroke === 10) expect(witness, "the witness: the same wander at inset 1.00 enters the neighbour (px)").toBeLessThan(0);
+    }
+  });
+});
+
+// ── the chrome ring ──────────────────────────────────────────────────────────────────────────
+const WALK = 'a[href], button, input:not([type=hidden]), select, textarea, [tabindex]:not([tabindex="-1"])';
+/** Three hosts wear their ring on a descendant (the deck's card, the staging and guard faces). */
+const HOSTS: [string, string][] = [
+  [".gallery-viewport", ".game-card.is-center"],
+  [".staging-btn", ".staging-face"],
+  [".guard-btn", ".guard-face"],
+];
+const stops = (page: Page) =>
+  page.evaluate((sel) => {
+    const out: string[] = [];
+    for (const n of document.querySelectorAll<HTMLElement>(sel)) {
+      const r = n.getBoundingClientRect();
+      const cs = getComputedStyle(n);
+      if (!r.width || !r.height || cs.visibility === "hidden" || cs.display === "none" || n.closest("[inert]")) continue;
+      const key = `${n.tagName.toLowerCase()}.${(n.getAttribute("class") || "").trim().split(/\s+/)[0]}`;
+      if (!out.includes(key)) out.push(key);
+    }
+    return out;
+  }, WALK);
+/** Keyboard modality first (a key press), then focus: the stop matches `:focus-visible` as a Tab
+ *  would leave it, and the first frame's computed ring is read one rAF after `focus()`. */
+const focusStop = async (page: Page, key: string) => {
+  await page.keyboard.press("Shift");
+  return page.evaluate(
+    async ({ key, HOSTS }) => {
+      const [tag, cls] = key.split(".");
+      const el = [...document.querySelectorAll<HTMLElement>(tag)].find((n) => (n.getAttribute("class") || "").trim().split(/\s+/)[0] === cls)!;
+      (document.activeElement as HTMLElement)?.blur?.();
+      await new Promise((r) => requestAnimationFrame(r));
+      el.focus();
+      await new Promise((r) => requestAnimationFrame(r));
+      let host = el;
+      for (const [f, h] of HOSTS) if (el.matches(f)) host = ((f === ".gallery-viewport" ? document : el).querySelector(h) as HTMLElement) ?? el;
+      const first = getComputedStyle(host);
+      return { firstColour: first.outlineColor, firstStyle: first.outlineStyle };
+    },
+    { key, HOSTS },
+  );
+};
+const hostRing = (page: Page) =>
+  page.evaluate((HOSTS) => {
+    const el = document.activeElement as HTMLElement;
+    let host = el;
+    for (const [f, h] of HOSTS) if (el.matches(f)) host = ((f === ".gallery-viewport" ? document : el).querySelector(h) as HTMLElement) ?? el;
+    const cs = getComputedStyle(host);
+    const r = host.getBoundingClientRect();
+    // The ink as sRGB bytes whatever its serialisation (`rgb()`, `color(srgb … / a)`, `oklab()`):
+    // the page's own canvas resolves it.
+    const cv = document.createElement("canvas").getContext("2d", { willReadFrequently: true })!;
+    cv.fillStyle = cs.outlineColor;
+    cv.fillRect(0, 0, 1, 1);
+    const px = cv.getImageData(0, 0, 1, 1).data;
+    return {
+      fv: el.matches(":focus-visible"),
+      ink: [px[0], px[1], px[2], px[3] / 255],
+      colour: cs.outlineColor,
+      style: cs.outlineStyle,
+      w: parseFloat(cs.outlineWidth) || 0,
+      off: parseFloat(cs.outlineOffset) || 0,
+      radius: cs.borderRadius,
+      rect: { x: r.x, y: r.y, w: r.width, h: r.height },
