@@ -0,0 +1,30 @@
+/**
+ * THE LOBBY'S FIVE LINES, IN ONE PLACE (T9-W7 §11 · M16).
+ *
+ * Three surfaces read this: the sheet draws it, the mark's accessible name IS the state line,
+ * and `App.vue` computes that line one boundary over. A copy string that lived in three files
+ * would be three strings; here it is one, and the two gates that read copy read it once —
+ * `scripts/check-font-coverage.mjs`'s `lobbyStrings` derive (does the 46-codepoint cut hold
+ * these glyphs) and `scripts/check-copy-register.mjs`'s `COPY_SOURCES` arm (M16: no dash, no
+ * first person, no jargon). Both name `LOBBY_COPY` by identifier, so a line that moves out of
+ * this object stops being read and the gate says so.
+ *
+ * COUNTING, DECLARED ONCE — three populations, one sentence:
+ *   `alone` / `others` count OTHER players (the estate's own idiom, and what the mark is named);
+ *   the rows show EVERYONE, you first;
+ *   `more` counts the remainder OF THE ROWS.
+ *
+ * M16: plain English, no em dash, no first person, no colon, no `j`, no `x` (the cut).
+ */
+export const LOBBY_COPY = {
+  /** the state line when you are the only page at this board, and the mark's whole name */
+  alone: "no other players",
+  /** the state line, and the mark's name, in a room */
+  others: (n: number) => (n === 1 ? "1 other player" : `${n} other players`),
+  /** your own row's qualifier — read at the open, never on a timer */
+  self: "you",
+  /** a peer past `PRESENCE_QUIET_MS`: still at the table, not yet gone */
+  quiet: (seconds: number) => `${seconds} seconds ago`,
+  /** the compression line: the rows the height budget could not draw */
+  more: (n: number) => `and ${n} more`,
+} as const;
