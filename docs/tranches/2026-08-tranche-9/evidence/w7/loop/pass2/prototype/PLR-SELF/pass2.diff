+  await page.evaluate(() => {
+    const room = new URL(location.href).searchParams.get("s")!;
+    const w = window as unknown as Record<string, unknown>;
+    const seen: unknown[] = [];
+    w.__frames = seen;
+    const ch = new BroadcastChannel(`board:${room}`);
