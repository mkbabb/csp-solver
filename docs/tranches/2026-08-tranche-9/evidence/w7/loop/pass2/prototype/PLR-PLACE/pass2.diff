+          for (let i = 0; i < (n as number); i++) {
+            const id = `p-fake${String(i).padStart(8, "0")}`;
+            ch.postMessage({ kind: "hi", data: { ack: true }, from: id });
+            ch.postMessage({ kind: "cur", data: { p: i * 5 + 1, ...e }, from: id });
