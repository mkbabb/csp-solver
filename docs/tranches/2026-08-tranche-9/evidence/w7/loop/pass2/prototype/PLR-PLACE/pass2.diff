+}
+async function drive(a: Page, b: Page, id: string, cells: number[]) {
+  await a.evaluate((r) => {
+    const w = window as unknown as { __st: unknown; __ch: BroadcastChannel };
+    w.__st = null;
+    const ch = new BroadcastChannel(`board:${r}`);
