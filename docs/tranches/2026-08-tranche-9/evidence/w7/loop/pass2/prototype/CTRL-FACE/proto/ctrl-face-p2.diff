+    if (!/\.(css|vue)$/.test(f.rel)) continue;
+    let css = f.rel.endsWith(".vue")
+      ? [...f.text.matchAll(/<style[^>]*>([\s\S]*?)<\/style>/g)]
+          .map((m) => m[1])
+          .join("\n")
+      : f.text;
+    css = css.replace(/\/\*[\s\S]*?\*\//g, " ");
+    for (const m of css.matchAll(/([^{}]+)\{([^{}]*)\}/g)) {
+      const sel = m[1].trim();
+      if (!sel || sel.startsWith("@")) continue; // at-rule preludes, never a selector
+      blocks.push({ where: f.rel, sel, body: m[2] });
+    }
+  }
+  /** `--font-*` / `--face-*` definitions, so a face is resolved the way the browser does. */
+  const tokens = {};
+  for (const f of TREE) {
+    if (!/\.(css|vue)$/.test(f.rel)) continue;
+    for (const m of f.text.matchAll(/(--(?:font|face)-[\w-]+)\s*:\s*([^;]+);/g))
+      if (!(m[1] in tokens)) tokens[m[1]] = m[2].trim();
+  }
+  const resolve = (value) => {
+    const seen = new Set();
+    let v = value.trim();
+    let m;
+    while ((m = /^var\(\s*(--[\w-]+)\s*(?:,[\s\S]*)?\)$/.exec(v))) {
+      if (seen.has(m[1]) || !(m[1] in tokens)) return null;
+      seen.add(m[1]);
+      v = tokens[m[1]].trim();
+    }
+    return v.split(",")[0].replace(/["']/g, "").trim();
+  };
+  const norm = (s) => s.replace(/\s+/g, " ").trim();
+  /** The classes the law is about — read off the keys, so the list is spelled once. */
+  const LISTED = new Set(
+    Object.keys(FACE_SITES).flatMap((k) =>
+      [...k.matchAll(/\.([\w-]+)/g)].map((m) => m[1]),
+    ),
+  );
+  /** Every block that declares a face on one of those classes, filed under its exact selector. */
+  const homes = new Map();
+  for (const b of blocks) {
+    const decl = /(?:^|[;{\s])font-family\s*:\s*([^;]+)/.exec(b.body);
+    if (!decl) continue;
+    const names = [...b.sel.matchAll(/\.([\w-]+)/g)].map((m) => m[1]);
+    if (!names.some((n) => LISTED.has(n))) continue;
+    const sel = norm(b.sel);
+    if (!(sel in FACE_SITES)) {
+      problems.push(
+        `the face law: ${b.where} declares \`font-family\` at \`${sel}\`, which is not a site ` +
+          `the law names. Every home for these classes is written down, because a face set ` +
+          `somewhere nobody listed is a face nobody can re-cut — add the selector to ` +
+          `FACE_SITES with the family it must paint, or set no face there.`,
+      );
+      continue;
+    }
+    if (!homes.has(sel)) homes.set(sel, []);
+    homes.get(sel).push({ ...b, raw: decl[1].trim() });
+  }
+  for (const [sel, family] of Object.entries(FACE_SITES)) {
+    const declaring = homes.get(sel);
+    if (!declaring) {
+      problems.push(
+        `the face law: no rule sets \`font-family\` AT \`${sel}\`, so either the site inherits ` +
+          `its face from whatever encloses it — which cannot be re-cut at the site — or the ` +
+          `rule was renamed out from under this law. Declare it there, reading one face token.`,
+      );
+      continue;
+    }
+    for (const d of declaring) {
+      const first = /^var\(\s*(--[\w-]+)/.exec(d.raw);
+      if (!first || !/^--face-/.test(first[1])) {
+        problems.push(
+          `the face law: ${d.where} sets \`${sel} { font-family: ${d.raw} }\`. The first token ` +
+            `must be a \`--face-*\` law (\`--face-printed\` / \`--face-written\` / ` +
+            `\`--face-mono\`): a literal is reachable from no voice at all, and a \`--font-*\` ` +
+            `binding names the FILE rather than the register, so re-cutting the register means ` +
+            `chasing every site that reads the font.`,
+        );
+        continue;
+      }
+      const got = resolve(d.raw);
+      if (got !== family)
+        problems.push(
+          `the face law: ${d.where} paints \`${sel}\` in ${got ?? "an unresolvable family"} ` +
+            `(\`${d.raw}\`) and the law says ${family}. PRINTED is the eight group names; ` +
+            `WRITTEN is every value and every verb; MONO is the shared component's own default, ` +
+            `which the deck keeps.`,
+        );
+    }
+  }
+}
+
 if (problems.length) {
   console.error("font coverage FAILED:");
   for (const p of problems) console.error(`  · ${p}`);
