+/**
+ * THE NOTE'S RUNG ON THE PAPER (T9-W7 §7).
+ *
+ * `gateFloors` reads every rung against the CARD, and the quiet rung clears there. The margin
+ * note is not on a card: the strip sits on `--color-background`, the paper, which is a lighter
+ * ground in light and a darker one in dark — so a rung that clears 4.5 on the card is not
+ * thereby cleared where a SETTLED note actually paints. The settle is the first thing to send
+ * running text to that rung on that surface, and this is the row that says it reads.
+ *
+ * ONE row for both note families: NOTE-ERASE ages the live line, NOTE-LEDGER keeps the previous
+ * one; whichever ships, the assertion is the same ink on the same paper. It is deliberately not
+ * a seventh `SHIP4` surface — that census pins six and self-tests on the count.
+ */
+const NOTE_QUIET = {
+  ink: "--ink-press-quiet",
+  surface: "--color-background",
+  floor: 4.5,
+  consumers:
+    ".margin-note-ink[data-note-age='settled'] (NOTE-ERASE) / .margin-note-previous (NOTE-LEDGER)",
+};
+
+function gateNote(css, note) {
+  const fails = [];
+  const p = stopOf(css, note.ink);
+  for (const [name, scope] of Object.entries(SCOPES)) {
+    const paper = colorOf(scope, note.surface);
+    const cr = contrast(press(THEMES[name].graphite, p, paper), paper);
+    if (cr < note.floor) {
+      fails.push(
+        `${note.ink} (${p}%) on ${note.surface} = ${cr.toFixed(3)}:1 in ${name} — under the ` +
+          `text floor ${note.floor}; a settled note is running text on the paper (${note.consumers})`,
+      );
+    }
+  }
+  return fails;
+}
+
+/**
+ * THE DISCOVERY HALF. `consumers` above is prose, and prose goes stale — the block's own law is
+ * that a count the tree can derive is never written down. So the census derives it: every
+ * `var(--ink-press-*)` read in `src/`, asserted to still exist and to still contain the files
+ * the two pinned selectors live in. It fails when the ramp loses its consumers wholesale (the
+ * `--ink-press-firm` shape: a rung nobody reads) and when a pinned row is deleted.
+ */
+const QUIET_FLOOR = 16;
+function gateNoteDiscovery(files, min = QUIET_FLOOR) {
+  const fails = [];
+  const hits = [];
+  for (const f of files) {
+    const body = readFileSync(f, "utf8");
+    const n = (body.match(/var\(--ink-press-(quiet|rule)\)/g) ?? []).length;
+    if (n) hits.push([relative(SRC, f), n]);
+  }
+  const total = hits.reduce((a, [, n]) => a + n, 0);
+  if (total < min)
+    fails.push(
+      `the two rungs have ${total} consumers in src/ (was ${min}) — a rung nobody reads is ` +
+        `unearned abstraction, and the note row above may be asserting over a deleted surface`,
+    );
+  const pinned = ["pencil/chrome/MarginNote.vue"];
+  for (const p of pinned) {
+    if (!hits.some(([f]) => f === p))
+      fails.push(
+        `${p} no longer reads a press rung — the pinned consumer of the note row is gone`,
+      );
+  }
+  return fails;
+}
+
 /* ── closure 5: the cross-theme rank (T9-W5 §5.4) ────────────────────────── */
 
