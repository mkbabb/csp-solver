+#!/usr/bin/env node
+/**
+ * THE CONSEQUENCE LADDER'S CSS WITNESS (T9-W7 · CTRL-COST · G23).
+ *
+ * O-12 stands: CI is sixteen BROWSERLESS lanes. Every claim this family makes about the card is
+ * a claim about geometry, and the instruments that measure geometry are LOCAL. What CI can hold
+ * is the DECLARATION the geometry follows from — and that is worth holding, because the failure
+ * mode these rows have is silent. Delete `min-height` from the answer and the `no` button
+ * shrinks to its line box: nothing throws, no test reds, and a 44px target becomes an 18px one
+ * on the engine half of the readers. Re-point the pin band's `padding-top` at a literal and the
+ * sticky head goes back to covering the chips under it, at the rung it covered them at before.
+ * An e2e row would catch both and would also re-rot silently the first time it is skipped; this
+ * runs in every lane, every commit, and reads the source.
+ *
+ * SIX DECLARATIONS, each the load-bearing half of a measured row:
+ *
+ *   1  TAP FLOOR        `.act-answer` takes `min-height: var(--tap-floor…)` — the answer is a
+ *                       real control (44.00 × 44.00 at the desk, zero headroom) and not a word.
+ *   2  PIN BAND         `.controls-card` spends `padding-top: var(--pin-band)` and the head
+ *                       pins at `top: calc(0.6rem - var(--pin-band))`. The pair IS the cure:
+ *                       either half alone puts the head back on the band's first control.
+ *   3  DERIVED HEAD     `--cost-head-h` is a `calc()` in CSS and has NO JavaScript publisher.
+ *                       Pass 2 sampled it off the first head's box; the sample was engine-split
+ *                       38/41/42 and depended on which band sorted first.
+ *   4  THE BERTH'S INK  the berthed tape carries vertical padding (`padding-block`, or the
+ *                       four-value `padding` that contains one) — at 0.02rem the ink crossed
+ *                       its own paper by 0.61px, on a tape that is rotated.
+ *   5  THE FENCE        `.act-face[data-armed]` drops its ground. The asked word reads 4.693 on
+ *                       the accent ground and 4.99 on bare card; the hovered-and-armed state is
+ *                       the one the second press happens in.
+ *   6  NO SILENT ZERO   `--card-pad-b` is read with NO `, 0px` fallback (chair §6.5) and is
+ *                       REGISTERED with an `initial-value`, so an absent publisher is caught by
+ *                       the probe that deletes it rather than by a sentinel that collapsed.
+ *
+ * `--self-test` mints every colour: each check is run against a source string with its own
+ * declaration broken, and must RED; and against the live shape, and must stay GREEN. A gate
+ * that cannot be shown failing is not a gate.
+ *
+ * Run: `node scripts/check-cost-face.mjs [--self-test]`, cwd web/frontend.
+ */
+import fs from "node:fs";
+import path from "node:path";
+import process from "node:process";
+
+const ROOT = path.join(import.meta.dirname, "..");
+const SUBJECTS = {
+  panel: "src/games/shared/GameControlPanel.vue",
+  scene: "src/games/shared/scene.css",
+};
+
+/** Source with its comments blanked. Every rule this gate reads is explained by a comment that
+ *  quotes the declaration it explains, so a raw scan finds the prose before the rule. */
+const uncommented = (s) =>
+  s.replace(/\/\*[\s\S]*?\*\/|<!--[\s\S]*?-->/g, (m) => m.replace(/[^\n]/g, " "));
+
+/** The declaration bodies of EVERY flat rule whose prelude contains `sel`, joined. Flat: a
+ *  body with no nested braces, which is every rule these two files write (media blocks are
+ *  walked into, since their own body is not flat and the inner rules are). */
+function ruleBody(css, sel) {
+  const out = [];
+  const re = /([^{}]*)\{([^{}]*)\}/g;
+  let m;
+  while ((m = re.exec(uncommented(css)))) {
+    const prelude = m[1].slice(m[1].lastIndexOf("}") + 1);
+    if (prelude.includes(sel)) out.push(m[2]);
+  }
+  return out.join("\n");
+}
+
+/** As `ruleBody`, but the selector must be a WHOLE comma-separated part of the prelude. */
+function selectorBody(css, sel) {
+  const out = [];
+  const re = /([^{}]*)\{([^{}]*)\}/g;
+  let m;
+  while ((m = re.exec(uncommented(css)))) {
+    const prelude = m[1].slice(m[1].lastIndexOf("}") + 1);
+    if (prelude.split(",").some((p) => p.trim() === sel)) out.push(m[2]);
+  }
+  return out.join("\n");
+}
+
+/**
+ * THE CHECKS. Each takes `{ panel, scene }` (raw source) and returns a list of failures. They
+ * read the source rather than a parsed model on purpose: what ships is the text, and a parser
+ * that normalises `padding: 0.5px 0.4rem` into a longhand would hide the very shape check 4
+ * exists to see.
+ */
+const CHECKS = [
+  [
+    "1 TAP FLOOR — `.act-answer` takes min-height: var(--tap-floor…)",
+    ({ panel }) => {
+      const body = ruleBody(panel, ".act-answer");
+      return /min-height:\s*var\(--tap-floor/.test(body)
+        ? []
+        : [
+            "`.act-answer` does not declare `min-height: var(--tap-floor…)` — the answer is a " +
+              "word again, not a target a thumb can hit",
+          ];
+    },
+  ],
+  [
+    "2 PIN BAND — the card spends it and the head pulls back into it",
+    ({ panel, scene }) => {
+      const out = [];
+      if (
+        !/(^|[;\s])padding-top:\s*var\(--pin-band\)/m.test(
+          ruleBody(scene, ".controls-card"),
+        )
+      )
+        out.push(
+          "`.controls-card` does not spend `padding-top: var(--pin-band)` — there is no " +
+            "reserved strip for a pinned head to live in",
+        );
+      if (
+        !/top:\s*calc\(\s*0\.6rem\s*-\s*var\(--pin-band\)\s*\)/.test(
+          ruleBody(panel, ".cost-band-head"),
+        )
+      )
+        out.push(
+          "`.cost-band-head` does not pin at `calc(0.6rem - var(--pin-band))` — a sticky head " +
+            "is offset from the CONTENT box, so `top: 0` parks it on the band's first control",
+        );
+      return out;
+    },
+  ],
+  [
+    "3 DERIVED HEAD — `--cost-head-h` is a calc, with no JS publisher",
+    ({ panel, scene }) => {
+      const out = [];
+      if (!/--cost-head-h:\s*calc\(/.test(uncommented(scene)))
+        out.push(
+          "`--cost-head-h` is not declared as a `calc()` in scene.css — a sampled band " +
+            "depends on which head sorts first and reads 38/41/42 across the regimes",
+        );
+      if (/setProperty\(\s*\n?\s*["']--cost-head-h["']/.test(panel))
+        out.push(
+          "`GameControlPanel` publishes `--cost-head-h` from JavaScript — the derived term " +
+            "and a sampled one cannot both be the reserve",
+        );
+      return out;
+    },
+  ],
+  [
+    "4 THE BERTH'S INK — the berthed tape carries vertical padding",
+    ({ panel }) => {
+      const body = ruleBody(panel, ".note-berth :deep(.washi-label)");
+      const block = /padding-block:\s*([^;]+);/.exec(body);
+      const shorthand = /(?:^|[;\s])padding:\s*([^;]+);/.exec(body);
+      const vertical = block?.[1] ?? shorthand?.[1]?.trim().split(/\s+/)[0] ?? "";
+      const px = /^([\d.]+)px$/.exec(vertical);
+      return px && Number(px[1]) >= 0.5
+        ? []
+        : [
+            `the berthed tape's vertical padding is \`${vertical || "absent"}\` — at 0.02rem ` +
+              "(0.32px) the text's ink box exceeded its own label box by 0.61px at the top, on " +
+              "a tape that is rotated",
+          ];
+    },
+  ],
+  [
+    "5 THE FENCE — the armed face drops its hover ground",
+    ({ panel }) => {
+      // The selector has to be the WHOLE compound, not a prefix of one: check 7's
+      // `.act-face[data-armed] .act-verb:hover` contains this one as a substring, so a
+      // prefix match would let either half stand in for both and neither could red alone.
+      const body = selectorBody(panel, ".act-face[data-armed]");
+      return /background:\s*none/.test(body)
+        ? []
+        : [
+            "`.act-face[data-armed]` does not clear its background — `sure?` reads 4.693 on " +
+              "`--color-accent` and 4.99 on bare card, and hovered-and-armed is the state the " +
+              "second press happens in",
+          ];
+    },
+  ],
+  [
+    "6 NO SILENT ZERO — `--card-pad-b` is read bare and registered",
+    ({ scene }) => {
+      const out = [];
+      const bad = [...scene.matchAll(/var\(--card-pad-b\s*,[^)]*\)/g)];
+      if (bad.length)
+        out.push(
+          `${bad.length} consumer(s) of \`--card-pad-b\` still spell a fallback ` +
+            `(${bad[0][0]}) — a measured token's absence must be loud (chair §6.5)`,
+        );
+      if (!/@property\s+--card-pad-b\s*\{[^}]*initial-value:/.test(scene))
+        out.push(
+          "`--card-pad-b` is not registered with an `initial-value` — a bare `var()` on an " +
+            "unregistered property takes its whole declaration with it",
+        );
+      return out;
+    },
+  ],
+  [
+    // MEASURED, then written (the fence's second half). Pass 3's first cut fenced only the
+    // FACE, and the asked word still read 4.693 armed-and-hovered on both engines: the accent
+    // ground a reader sees there is `.icon-btn:hover`'s, on the VERB BUTTON INSIDE the face,
+    // which the face's own `background: none` never touched. Two selectors, one fence.
+    "7 THE FENCE REACHES THE VERB — the armed verb button takes no hover ground",
+    ({ panel }) => {
+      const body = ruleBody(panel, ".act-face[data-armed] .act-verb:hover");
+      return /background:\s*none/.test(body)
+        ? []
+        : [
+            "`.act-face[data-armed] .act-verb:hover` does not clear its background — the face " +
+              "is transparent but `.icon-btn:hover` grounds the button under the word, and the " +
+              "asked word reads 4.693 in the state the second press happens in",
+          ];
+    },
+  ],
+];
+
+/** The planted defect each check must red on, applied to the live source. */
+const PLANTS = [
+  [
+    "1",
+    (s) => ({ ...s, panel: s.panel.replace(/min-height: var\(--tap-floor[^;]*;/, "") }),
+  ],
+  [
+    "2",
+    (s) => ({
+      ...s,
+      scene: s.scene.replace(/padding-top: var\(--pin-band\);/, "padding-top: 0.6rem;"),
+    }),
+  ],
+  [
+    "3",
+    (s) => ({
+      ...s,
+      scene: s.scene.replace(/--cost-head-h: calc\([^;]*;/, "--cost-head-h: 40px;"),
+    }),
+  ],
+  [
+    "4",
+    (s) => ({
+      ...s,
+      panel: s.panel.replace(/padding: 1px 0\.4rem;/, "padding: 0.02rem 0.4rem;"),
+    }),
+  ],
+  [
+    "5",
+    (s) => ({
+      ...s,
+      panel: s.panel.replace(
+        /\.act-face\[data-armed\],\n\.act-face\[data-armed\] \.act-verb:hover \{\n  background: none;\n\}/,
+        ".act-face[data-armed] .act-verb:hover {\n  background: none;\n}",
+      ),
+    }),
+  ],
+  [
+    "6",
+    (s) => ({
+      ...s,
+      scene: s.scene.replace(/var\(--card-pad-b\)/g, "var(--card-pad-b, 0px)"),
+    }),
+  ],
+  [
+    "7",
+    (s) => ({
+      ...s,
+      panel: s.panel.replace(/\.act-face\[data-armed\] \.act-verb:hover,?\n?/, ""),
+    }),
+  ],
+];
+
+function selfTest(live) {
+  const out = [];
+  for (const [id, plant] of PLANTS) {
+    const broken = plant(live);
+    if (broken.panel === live.panel && broken.scene === live.scene) {
+      out.push(
+        `plant ${id} changed NOTHING — the fixture no longer matches the source`,
+      );
+      continue;
+    }
+    const [name, fn] = CHECKS.find(([n]) => n.startsWith(`${id} `));
+    const found = fn(broken);
+    console.log(
+      `  ${found.length ? "✓" : "✗"} plant ${id} → ${name.slice(2)} ` +
+        `${found.length ? `RED (${found.length})` : "stayed GREEN"}`,
+    );
+    if (!found.length) out.push(`plant ${id} did NOT red \`${name}\``);
+  }
+  return out;
+}
+
+const live = Object.fromEntries(
+  Object.entries(SUBJECTS).map(([k, rel]) => [
+    k,
+    fs.readFileSync(path.join(ROOT, rel), "utf8"),
+  ]),
+);
+
+console.log(
+  `COST-FACE WITNESS — ${Object.values(SUBJECTS).join(", ")}; ${CHECKS.length} declarations`,
+);
+const failures = [];
+for (const [name, fn] of CHECKS) {
+  const found = fn(live);
+  console.log(`  ${found.length ? "✗" : "✓"} ${name}`);
+  for (const f of found) failures.push(`[${name}] ${f}`);
+}
+
+if (process.argv.includes("--self-test")) {
+  console.log("\nSELF-TEST — each check against its own planted defect:");
+  failures.push(...selfTest(live).map((v) => `[SELF-TEST] ${v}`));
+}
+
+if (failures.length) {
+  console.error(`\n${failures.length} failure(s):\n`);
+  for (const f of failures) console.error(`  • ${f}\n`);
+  process.exit(1);
+}
+
+console.log(
+  "\nOK — the answer keeps its floor, the band is reserved and derived, the berth's ink is on " +
+    "its own paper, the armed face is unhoverable ground, and no measured token fails quietly.",
+);
