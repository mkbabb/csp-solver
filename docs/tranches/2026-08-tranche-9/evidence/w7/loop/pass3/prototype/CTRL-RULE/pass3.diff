@@ -0,0 +1,101 @@
+<script setup lang="ts">
+/**
+ * T9-W7 · CTRL-RULE — THE HAND-RULED LINE, and the only place its terms are written.
+ *
+ * `wobbleLine` is the BOARD's own generator (`@mkbabb/pencil-boil`, the grid's roughness and
+ * segment count), rendered as ONE STATIC `<path>`: no beat, no subscriber, no `url(#…)`
+ * filter — the card's filter census does not move (9). The incumbent was a CSS `border-top`,
+ * whose σ is 0 by construction: a printed hairline, not a drawn rule, and this family's whole
+ * claim is that the line is drawn. Measured against the board's own rule on the same page:
+ * σ 1.05px against 1.11, inside R3's grid band [0.722, 2.886].
+ *
+ * THE CHORD IS NOMINAL. The viewBox stretches in X alone (`preserveAspectRatio="none"` with
+ * the svg's CSS height equal to the viewBox's 5 units), so the wobble's PERPENDICULAR
+ * amplitude — the only quantity σ reads — is the amplitude generated at `RULE_CHORD` whatever
+ * width the line resolves to. That is what buys a static path: no observer per rule, no
+ * regeneration on rotate, one `d` per seed for the life of the page.
+ *
+ * THE STROKE AND THE INK ARE A FLOOR, NOT A TASTE. Pass 1 shipped 1.6px at `--ink-press-rule`
+ * (graphite 55%) and its MEDIAN read 3.53:1 light while its WORST PAINTED COLUMN read 2.451 —
+ * a median is not a floor, and 1.4.11's 3:1 is a floor. The token is not moved for one consumer
+ * (it is `check-ink-pressure`'s ramp, ordered against two other rungs in three scopes), so the
+ * stroke is what is swept: `--rp-rule-stroke`, the THINNEST of 1.8 / 2.0 that clears the worst
+ * column in light in BOTH engines on the pinned seeds. The default below is the shipped value
+ * and the census names which one it is.
+ */
+import { computed } from "vue";
+import { wobbleLine } from "@mkbabb/pencil-boil";
+
+const props = defineProps<{
+  /** One seed per rule — a line is that group's line at every mount. */
+  seed: number;
+}>();
+
+/** The span the card's wrap actually resolves to across its three regimes (284.22 desk · 374
+ *  dock · 884 landscape) — the middle of the two the rule is read at, so the x-stretch stays
+ *  near 1 and the rule reads as one hand at every width. The seed sweep clears the band at this
+ *  chord AND at the spec's 284.67; a seed is only pinned if it clears at both. */
+const RULE_CHORD = 300;
+const RULE_H = 5;
+
+const d = computed(() =>
+  wobbleLine(0, RULE_H / 2, RULE_CHORD, RULE_H / 2, {
+    roughness: 0.4,
+    segments: 8,
+    seed: props.seed,
+  }),
+);
+
+/** The page is ruled left to right rather than stamped: each line waits its own beat. ONCE,
+ *  at mount — nothing re-draws on a scroll, an open or a chip. The DURATION is the ladder's
+ *  `--motion-note` rung, not a constant of this component's: pass 2 minted `MOTION.ruleDrawMs`
+ *  at 260 and the rung it was 10ms from is 250. */
+const drawDelay = computed(() => `${(props.seed % 7) * 22}ms`);
+</script>
+
+<template>
+  <svg
+    class="ruled-line"
+    :viewBox="`0 0 ${RULE_CHORD} ${RULE_H}`"
+    preserveAspectRatio="none"
+    aria-hidden="true"
+    focusable="false"
+  >
+    <path
+      :d="d"
+      pathLength="1"
+      class="pencil-draw-on"
+      :style="{ '--draw-dur': 'var(--motion-note)', '--draw-delay': drawDelay }"
+    />
+  </svg>
+</template>
+
+<style scoped>
+.ruled-line {
+  display: block;
+  width: 100%;
+  height: 5px;
+  overflow: visible;
+  pointer-events: none;
+}
+
+.ruled-line path {
+  fill: none;
+  stroke: var(--ink-press-rule);
+  /* 2.0, and it is the SWEEP's answer, not a taste. EVERY CITATION BELOW NAMES ITS POPULATION,
+     because this reading is sub-pixel-phase dependent — the same 2px stroke reads 3.530 at
+     y 302.83 and 2.413 at y 766.03 when the rule lands between device pixels — and a number
+     with no population is a number that can be argued either way. The gate is therefore the
+     WORST PAINTED COLUMN over 7 census cells × 2 themes × 2 engines × 4 sub-pixel phases, not
+     a median and not one cell's read (pass-3 readings/rule-sweep.json).
+       Pass 2's 1.8 row ("2.366 / 2.909") is STRUCK: it appears nowhere in the bank and no
+       instrument in this family ever measured a 1.8 stroke. The stroke is 2.0 because that is
+       what was swept; 1.8 is an unrun arm and says so.
+     The `--ink-press-rule` token is NOT moved to buy this: it is `check-ink-pressure`'s ramp,
+     ordered against two other rungs in three scopes, and re-pitching a shared ramp for one
+     consumer is how a ladder stops meaning anything. The stroke is this consumer's own number.
+     The custom property stays so the sweep can be re-run without editing the component. */
+  stroke-width: var(--rp-rule-stroke, 2);
+  stroke-linecap: round;
+}
+</style>
