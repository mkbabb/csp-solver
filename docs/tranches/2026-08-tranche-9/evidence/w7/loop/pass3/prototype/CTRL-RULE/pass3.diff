+/**
+ * T9-W7 · CTRL-RULE §15 — THE CONFIRM, AS THE HOUSE ALREADY ASKS IT.
+ *
+ * The card asked in place: the armed verb's own sublabel became `sure?` and a bare `no` appeared
+ * beside it. Measured, that face is not zero-reflow (the verb's box shrinks 16.1px because
+ * `Clear` → `sure?` is a narrower word), its `no` is 12 × 21px against a 44px floor, and it puts
+ * the destructive answer inside the same box as the destructive verb. The house's own confirm —
+ * the gallery's guard ribbon, twice owner-passed — is a NOTE anchored under the verb that armed
+ * it, and it is zero-reflow on all four sides because it is out of flow.
+ *
+ * This is that note, berthed in the bar. One mechanism for deal · clear · fill · solve.
+ *
+ * TWO NUMBERS IT CARRIES THAT THE GALLERY'S DOES NOT:
+ *  · THE FLOOR IN BOTH DIMENSIONS. The gallery's verbs wear `min-height: 44px` alone and
+ *    measure `keep` 39 × 44 and `clear` 41.6 × 44 — under the floor in the dimension a
+ *    height-only rule can never reach. `min-inline-size` joins it (the same pairing
+ *    `index.css`'s coarse block made for the option chips at T4-P1), and
+ *    `e2e/zone-grammar.spec.ts` already models the per-dimension negative control.
+ *  · THE RING IS AUTHORED. `--ring-ink` (index.css) rather than a second spelled `color-mix`,
+ *    so the card and the deck ring at one value.
+ *
+ * W1 §1.5 OWNS THE ARMING. This is the FACE: which verbs ask, and on what state, is not
+ * decided here — `fill` and `solve` carry no arm on this tree and the family does not claim
+ * one.
+ */
+import { onMounted, ref } from "vue";
+import HandDrawnOutline from "@pencil/grid/HandDrawnOutline.vue";
+
+defineProps<{
+  /** The question, in plain English, ending in a question mark. */
+  line: string;
+  /** The destructive answer's word — the same verb the reader pressed. */
+  verb: string;
+}>();
+
+const emit = defineEmits<{ (e: "keep"): void; (e: "confirm"): void }>();
+
+/** Focus lands on KEEP: the safe answer is the default one, and a reader who presses Enter on
+ *  arrival keeps their board. Esc is the same answer by another key. */
+const keepEl = ref<HTMLButtonElement | null>(null);
+
+/** THE ANCHOR AND ITS CLAMP ARE DELETED (pass 3). Pass 2 centred the note on the verb that
+ *  armed it and then clamped it — two `getBoundingClientRect` reads, a `getComputedStyle`
+ *  parse and a nested `Math.max` — to keep half of a 142px note from hanging off a 390px
+ *  edge. A note that is the FOOT'S FULL WIDTH has no centre to compute and no edge to hang
+ *  off: `inset-inline: 0` is the whole placement, in CSS, at zero script cost. What the
+ *  mount still owes is the focus — `keep` takes it, because the safe answer is the default
+ *  one, and a reader who presses Enter on arrival keeps their board. */
+onMounted(() => keepEl.value?.focus({ preventScroll: true }));
+</script>
+
+<template>
+  <div
+    class="confirm-ribbon"
+    role="alertdialog"
+    aria-modal="false"
+    :aria-label="line"
+    @keydown.escape.stop="emit('keep')"
+  >
+    <p class="confirm-line">{{ line }}</p>
+    <div class="confirm-verbs">
+      <!-- ONE FACE, WEIGHT-RANKED — and that wording is pass 3's correction. Pass 2 left
+           `keep` BARE and argued the bareness was a third channel; its own diff then kept the
+           gallery's `keep` drawn, so the section shipped two answers to one question and the
+           "one face" sentence contradicted the commit it was written in. Making the gallery's
+           bare instead flips R6 law L5 RED (422 drawn faces against 400), so the direction is
+           settled: BOTH answers are drawn, and the rank is the STROKE — 1.5 for the answer
+           that costs nothing, 2.5 for the one that wipes a board. Weight is a channel a
+           reader can see without colour, which bareness only pretended to be. -->
+      <button ref="keepEl" type="button" class="confirm-btn" @click.stop="emit('keep')">
+        <HandDrawnOutline :pose="0" :stroke-width="1.5" :outset="2" class="confirm-face">
+          keep
+        </HandDrawnOutline>
+      </button>
+      <button type="button" class="confirm-btn" @click.stop="emit('confirm')">
+        <!-- The destructive face takes the heavier ink — the outline's own stroke at 2.5,
+             which is the hand's way of saying weight — and the word in `--color-red-ink` on
+             BARE card. A reader who can see neither stroke weight nor colour still reads the
+             sentence, which names the act. -->
+        <HandDrawnOutline
+          :pose="0"
+          :stroke-width="2.5"
+          :outset="2"
+          class="confirm-face is-destructive"
+        >
+          {{ verb }}
+        </HandDrawnOutline>
+      </button>
+    </div>
+  </div>
+</template>
+
+<style scoped>
+/* ABOVE the bar's rule, not below it. The gallery's ribbon hangs under its deck because a deck
+   has page beneath it; the bar is the CASE'S FOOT and there is nothing below it but the edge of
+   the sheet. Out of flow either way, which is the property that matters: Δ 0 on four sides for
+   the verb, the bar and the wrap. */
+/* THE NOTE IS THE FOOT'S FULL WIDTH (pass 3). `width: max-content` with
+   `max-width: min(20rem, 92%)` measured 142.13 × 87.19 — 0.364 of the foot it sits over — and
+   what lives in the other 0.636 is the estate the question is about: the `checking` row's
+   `Off` chip read 0.395 of the foot on the note's own flank and SHARED A BASELINE with the
+   note's two answers, so the crop reads as one line, `keep [clear] ff Ask Live`. Three
+   channels of weight cannot fix a note you read across. `inset-inline: 0` makes the
+   intersection arithmetic rather than a clamp: the note covers the foot, and the foot is the
+   one band in the case that holds no group. */
+.confirm-ribbon {
+  position: absolute;
+  bottom: 100%;
+  inset-inline: 0;
+  z-index: 70;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 0.35rem;
+  padding: 0.5rem 0.75rem 0.6rem;
+  background: var(--color-card);
+  text-align: center;
+}
+
+.confirm-line {
+  margin: 0;
+  font-family: var(--font-hand);
+  font-size: var(--type-small);
+  line-height: 1.25;
+  color: var(--color-foreground);
+}
+
+.confirm-verbs {
+  display: flex;
+  gap: 0.75rem;
+}
+
+/* A bare hit target: everything the eye reads is the FACE inside it, and the box around the
+   face is drawn (`.guard-btn`'s idiom verbatim — one grammar, two files). */
+.confirm-btn {
+  display: inline-flex;
+  padding: 0;
+  border: none;
+  background: transparent;
+  color: var(--color-foreground);
+  font-family: var(--font-hand);
+  font-size: var(--type-verb);
+  line-height: 1;
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+}
+
+.confirm-face {
+  display: inline-flex;
+  align-self: center;
+  align-items: center;
+  justify-content: center;
+  padding: 0.32rem 0.9rem;
+  /* Radius 0 on every drawn thing: the drawn frame is the shape, and a rounded hit box under a
+     square drawn one is two shapes. */
+  border-radius: 0;
+}
+
+/* NO GROUND. An 8% foreground wash behind the word was the third channel in pass 1, and it was
+   the one channel that MADE THE OTHER TWO WORSE: `--color-red-ink` reads 4.99:1 on bare card and
+   4.20 composed on that wash — under 1.4.3's 4.5 floor for the one word on this page that must
+   not be misread. The wash also cannot be a cue on its own terms (CTRL-TABS proved no mix
+   percentage separates a state from a ground at 3:1), so it was paying contrast for nothing. The
+   three channels that remain are all real: the sentence NAMES the act, the two drawn boxes are
+   RANKED by stroke (1.5 against 2.5), and one word is red — on bare card, where it measures
+   4.99:1 against 1.4.3's 4.5. */
+.confirm-face.is-destructive {
+  color: var(--color-red-ink);
+}
+
+/* THE FLOOR IN BOTH DIMENSIONS — the gallery's `min-height` alone measured `keep` 39 × 44. */
+@media (pointer: coarse) {
+  .confirm-face {
+    min-height: var(--tap-floor, 2.75rem);
+    min-inline-size: var(--tap-floor, 2.75rem);
+  }
+}
+
+/* The ring rides the FACE, so it traces the drawn box rather than a zero-padding button. */
+.confirm-btn:focus-visible {
+  outline: none;
+}
+
+.confirm-btn:focus-visible .confirm-face {
+  outline: 2px solid var(--ring-ink, currentColor);
+  outline-offset: 4px;
+}
+
+/* Hover is an INK LIFT, never a ground: the accent fill retires with the rest of the card's. */
+@media (hover: hover) {
+  .confirm-btn:hover .confirm-face {
+    color: var(--color-foreground);
+    transition: color var(--motion-whisper) var(--ease-standard);
+  }
+
+  .confirm-btn:hover .confirm-face.is-destructive {
+    color: var(--color-red-ink);
+  }
+}
+</style>
