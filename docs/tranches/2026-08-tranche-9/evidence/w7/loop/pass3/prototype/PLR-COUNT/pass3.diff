index 00000000..7a0afa47
--- /dev/null
+++ b/web/frontend/src/games/shared/PlayerTally.vue
@@ -0,0 +1,359 @@
+<script setup lang="ts">
+/**
+ * THE TALLY (T9-W7 PLR-COUNT §3.2) — how many people are on this board, drawn as objects.
+ *
+ * One upright per person, in arrival order, self first, each in that person's ink: a count a
+ * reader takes without reading. No diagonal, ever — the gate-five slash is a MAGNITUDE idiom
+ * (`DifficultyTally` owns it, correctly) and at five people it stops being anybody's stroke
+ * and becomes a strike across four other people's.
+ *
+ * ONE THRESHOLD, AND IT IS FIVE. Five strokes are drawn, five rows are listed, and at six the
+ * NUMBER replaces the strokes while the register compresses to four and a foot. The chunk gap
+ * pass 1 shipped (five, a pitch of air, then a sixth) died with it: two thresholds on one
+ * object is two numbers on one object, and a reader counting five-plus-one is reading the
+ * gap rather than the room.
+ *
+ * THE THRESHOLD IS PRICED, NOT ASSUMED. Painted ink, measured: N=1 309.28 px², N=3 839.01,
+ * N=5 1416.95, N=6 206.79 (chromium; webkit 272.62 / 791.55 / 1324.67 / 212.75). One more
+ * person made the control the lightest it has ever been — 85.4% below five and 33% below ONE,
+ * which is a magnitude that runs backwards. The numeral takes the rung raise (`--type-heading`,
+ * +62% glyph area) and the gate is a FLOOR, ink(6) >= ink(1), so the swap can never again
+ * shrink the mark below its own smallest state. Whether five strokes giving way to one digit
+ * READS as more people is the owner's to say (U-10): the strip and the table go to them.
+ *
+ * ONE COUNTING BASE: everyone at this board. The glyph, the strokes, the accessible name, the
+ * rows and the foot count the same people, so a sighted reader and a listening one hear the
+ * same number (pass 1 said `12` and "11 other players" on one control). `N other players` is
+ * right in the deck, where the sentence is about the others who follow you (GameGallery.vue:
+ * 217-222 owns it, R6 law 32); here it is not.
+ *
+ * THE POSE IS KEYED TO THE PERSON, not to the slot: the seed comes from the id, the `d` is
+ * generated at a fixed local origin and the SLOT is a translate. A person in the middle leaving
+ * moves everybody right of them one pitch left and changes no surviving stroke's geometry by a
+ * byte — their own wobble travels with them.
+ *
+ * COLOUR IS ROOM-RELATIVE, and that is the family's F1 ruling as code: on THIS route the BOARD
+ * keeps `--color-user-ink` (`useSession.ts:537`, self `ink: {}` — a solo board is
+ * byte-identical), your own stroke here is that same blue, and on your neighbour's page you
+ * are the ink the room agreed for you. The other arm of that const is the substrate's (chair
+ * §6.8, U-10); nothing in this file chooses it.
+ */
+import { computed, onUnmounted, ref, useId, watch } from "vue";
+import { session } from "./useSession";
+import { useTallyStrokes, type TallyStroke } from "./useTallyStrokes";
+import { claimHeadDisclosure } from "@pencil/chrome/AttributionCard/useHoverCard";
+import PlayerLobby, {
+  LOBBY_COPY,
+  TALLY_MAX,
+  type LobbyPerson,
+} from "./PlayerLobby.vue";
+
+/** viewBox units. `DifficultyTally`'s own geometry: pitch 13, y 9 → 35, in a 44-unit box. */
+const PITCH = 13;
+const TOP = 9;
+const BOTTOM = 35;
+const BOX_H = 44;
+
+/**
+ * SOLO — the owner's fork, both arms built, one const between them (gap 5, U-10).
+ *
+ * `keep` (the default): a page with no room is still one person at this board, and that person
+ * is you. The mark is permanent on every playing board, one stroke in graphite, and the
+ * register has a row rather than a state line standing over nothing. M14's own words lean
+ * here — an icon "coloured when a session is live" presupposes an icon present and uncoloured
+ * otherwise, and graphite is this estate's uncoloured. The price is measured: `.corner-left`
+ * 75.53 → 119.53 on every solo board, and one new tab stop.
+ *
+ * `gate-on-a-room`: the mark mounts only once there is a room to count. The head grows and
+ * shrinks with the wire, and an icon is never seen uncoloured. The price is that the most-seen
+ * board has no mark at all, so the control is one a player meets for the first time mid-session.
+ */
+const SOLO_ARM: "keep" | "gate-on-a-room" = "keep";
+const SOLO: LobbyPerson[] = [{ id: "self", slug: "", ink: {}, self: true }];
+const people = computed<LobbyPerson[]>(() =>
+  session.players.value.length
+    ? session.players.value
+    : SOLO_ARM === "keep"
+      ? SOLO
+      : [],
+);
+const count = computed(() => people.value.length);
+/** The strokes are drawn at all only below the threshold; past it the count is written. */
+const drawn = computed(() => count.value > 0 && count.value <= TALLY_MAX);
+/** One person is one person, alone or in a room of one: the stroke says so in graphite. */
+const solo = computed(() => count.value === 1);
+
+/** FNV-1a, 32-bit — the id's own bits, so the wobble a person is drawn with is theirs on every
+ *  page that draws them and survives every arrival and departure around them. */
+function seedFor(id: string): number {
+  let h = 0x811c9dc5;
+  for (let i = 0; i < id.length; i++) {
+    h ^= id.charCodeAt(i);
+    h = Math.imul(h, 0x01000193) >>> 0;
+  }
+  return 11 + 12 * (h % 97);
+}
+
+/**
+ * THE SET IS THE FIRST FIVE PEOPLE, whether or not they are being painted. Pass 2 computed it
+ * off `drawn`, which is 0 past the threshold: six people made the set EMPTY, so the sixth
+ * person arriving and the third leaving in one tick moved nothing the watch could see. The set
+ * is who would be drawn; the template decides whether it is.
+ */
+const tallied = computed(() => people.value.slice(0, TALLY_MAX));
+const ids = computed(() => tallied.value.map((p) => p.id));
+
+/** Every stroke is generated at the SAME local origin; the slot is the transform below. */
+const strokes = computed<TallyStroke[]>(() =>
+  tallied.value.map((p) => ({
+    key: p.id,
+    x1: PITCH / 2,
+    y1: TOP,
+    x2: PITCH / 2,
+    y2: BOTTOM,
+    seed: seedFor(p.id),
+  })),
+);
+const boxWidth = computed(() => PITCH * count.value);
+
+const { poses, boilFrame, drawIn, settle, forget, dashOffset } = useTallyStrokes(
+  () => strokes.value,
+);
+settle(ids.value);
+
+/**
+ * THE CROSSING, as a SET DIFFERENCE — the defect this pass found. A tally is a set: an arrival
+ * draws ITS stroke and re-announces nobody else's, a departure draws nothing at all, and the
+ * two happening in one tick must do exactly one of each.
+ *
+ * Pass 1 watched `now > was` on a COUNT and re-drew all six strokes when seven people became
+ * six. Pass 2 cured the direction and kept the count, which left a defect nobody had named:
+ * a simultaneous depart and arrive leaves the count untouched, so the watch never fired, the
+ * newcomer took the departed person's slot and their `reveal` with it, and a stroke appeared
+ * that no hand had drawn. Ids are what changed; ids are what is watched.
+ */
+watch(
+  ids,
+  (now, was) => {
+    const before = was ?? [];
+    forget(before.filter((id) => !now.includes(id)));
+    const fresh = now.filter((id) => !before.includes(id));
+    if (fresh.length) drawIn(fresh);
+    else settle(now);
+  },
+  { flush: "post" },
+);
+
+/** The peer's ink binding; yours is empty, so your stroke takes the page's own blue. */
+const inkOf = (i: number) => tallied.value[i]?.ink ?? {};
+/** The slot, in viewBox units. A departure moves this and nothing else. */
+const slotAt = (i: number) => `translate(${PITCH * i} 0)`;
+
+/** The state line IS the accessible name, and it counts what the strokes count. */
+const stateLine = computed(() => LOBBY_COPY.count(count.value));
+
+const lobbyId = useId();
+/**
+ * A PRESS, NOT A HOVER, and the difference is measured: `useHoverCard` opens on `mouseenter`
+ * at a fine pointer, so Playwright's own click — which moves the pointer onto the control
+ * first — opened the sheet and then toggled it shut in the same gesture (desk, chromium:
+ * the sheet read `scale(0.9)`, 230.4px of its 256). @mbabb can live with that because it is a
+ * hover card whose press is a convenience; this one publishes `aria-expanded`, and a
+ * disclosure whose button closes what the approach opened is a broken control. The spec asks
+ * hover for the ink lift alone, which is CSS and wants no state at all.
+ */
+const isOpen = ref(false);
+const close = () => (isOpen.value = false);
+function toggle() {
+  isOpen.value = !isOpen.value;
+  // One head disclosure at a time: the register and the @mbabb card open on the same anchor
+  // at the same width, and two popovers in one box is the pass-1 defect.
+  if (isOpen.value) claimHeadDisclosure(close);
+}
+/** The clock the qualifiers are read against, stamped at OPEN. A register that ticks is a
+ *  register that asks to be watched; this one states what was true when you looked. */
+const openedAt = ref(0);
+
+/**
+ * SCAFFOLD, NOT THIS FAMILY'S (§11 leader's, PLR-SELF §3.6). The window-bound Escape and the
+ * open/close lifecycle belong to the seated substrate; they are carried here because the
+ * substrate lane had not landed a tree this prototype could take them from, and they are the
+ * first thing the fold deletes. What is this family's is the ABSENCE below it: no
+ * `@keydown.enter` (a native button already fires `click` on Enter — CH-70), and no
+ * `@focusout` on the mark (`@pointerdown.prevent` means a press never took focus, so a
+ * focusout close is a handler for an event that cannot happen by press and a thief of the
+ * board's caret when it can).
+ */
+function onEscape(e: KeyboardEvent) {
+  if (e.key !== "Escape" || e.defaultPrevented) return;
+  e.preventDefault();
+  close();
+}
+watch(isOpen, (open) => {
+  if (open) {
+    openedAt.value = Date.now();
+    window.addEventListener("keydown", onEscape);
+  } else {
+    window.removeEventListener("keydown", onEscape);
+  }
+});
+onUnmounted(() => window.removeEventListener("keydown", onEscape));
+
+defineExpose({ close });
+</script>
+
+<template>
+  <!-- The wrapper is NOT positioned: the sheet below resolves its absolute box against the
+       head corner itself (`.corner-left` / `.mobile-attribution`, both `position: fixed`), so
+       the register hangs at the PAGE's left edge while the mark sits beside @mbabb. -->
+  <span v-if="count" class="player-tally">
+    <button
+      type="button"
+      class="pt-mark"
+      data-player-mark
+      :aria-label="stateLine"
+      :aria-expanded="isOpen"
+      :aria-controls="lobbyId"
+      @click.stop="toggle"
+      @pointerdown.prevent
+    >
+      <svg
+        v-if="drawn"
+        class="pt-marks"
+        :class="{ 'is-solo': solo }"
+        :viewBox="`0 0 ${boxWidth} ${BOX_H}`"
+        :style="{ width: `${(boxWidth * 36) / BOX_H}px` }"
+        aria-hidden="true"
+        xmlns="http://www.w3.org/2000/svg"
+      >
+        <!-- Grain-baked pose siblings, opacity-swapped on the shared beat. Zero live filters,
+             so the head's filter census is 9 by construction. -->
+        <g
+          v-for="(pose, f) in poses"
+          :key="'pose-' + f"
+          class="pt-pose"
+          :class="{ 'is-active': boilFrame === f }"
+        >
+          <path
+            v-for="(d, i) in pose"
+            :key="ids[i]"
+            :d="d"
+            :transform="slotAt(i)"
+            class="pt-stroke"
+            :style="inkOf(i)"
+            fill="none"
+            stroke-linecap="round"
+            stroke-linejoin="round"
+            pathLength="100"
+            stroke-dasharray="100 100"
+            :stroke-dashoffset="dashOffset(ids[i])"
+          />
+        </g>
+      </svg>
+      <!-- Past five: the count, written. The hand's own digits at the HEADING rung, in your
+           blue, which is the one thing still saying "live" once the strokes are gone. The rung
+           is the price of the swap (see the header's ink table): at the subheading rung the
+           mark shrank to a third of its own N=1 state. -->
+      <span v-else class="pt-count">{{ count }}</span>
+    </button>
+    <PlayerLobby
+      :id="lobbyId"
+      :open="isOpen"
+      :state="stateLine"
+      :people="people"
+      :opened-at="openedAt"
+    />
+  </span>
+</template>
+
+<style scoped>
+/* The mark rides the head line beside @mbabb; the corner wrapper is the positioned ancestor
+   and stays that way, so nothing here establishes a containing block. */
+.player-tally {
+  display: inline-flex;
+  align-items: center;
+}
+
+.pt-mark {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  background: transparent;
+  border: none;
+  /* The @mbabb trigger's own inline rung; no block padding, so the head line's height is the
+     trigger's 39.75 on a desk and the tap floor's 44 on a phone. */
+  padding: 0 0.618rem;
+  /* The floor at N=1, both dimensions, so the smallest state of the mark is still a target.
+     THE FALLBACK IS THE SHIPPED LITERAL, twice, and it is written rather than omitted on two
+     laws that agree here: index.css:821-828 states the token's law ("the fallback is the
+     shipped literal, so a consumer mounted outside `.page-root` still lands on 44px rather
+     than on `initial`") over a STATIC declaration at App.vue:982 on `.page-root`; and CHAIR
+     §6.5's no-fallback rule is scoped to MEASURED tokens published from TS with an
+     `@property` initial-value, which this one is not. */
+  min-width: var(--tap-floor, 2.75rem);
+  /* The svg's own height, held by the button too, so the head line does not step when the
+     strokes give way to the written count (36 vs 25.888 at the heading rung, measured). */
+  min-height: 36px;
+  cursor: pointer;
+  font-family: var(--font-hand);
+  line-height: 1;
+}
+
+@media (pointer: coarse) {
+  .pt-mark {
+    min-height: var(--tap-floor, 2.75rem);
+  }
+}
+
+.pt-mark:focus-visible {
+  outline: 2px dashed currentColor;
+  outline-offset: 3px;
+}
+
+.pt-marks {
+  display: block;
+  height: 36px;
+  overflow: visible;
+}
+
+/* Boil: each pose is its own compositing layer so the beat is a compositor blend, never a
+   repaint (the grid's will-change:opacity discipline, inherited). */
+.pt-pose {
+  opacity: 0;
+  will-change: opacity;
+}
+.pt-pose.is-active {
+  opacity: 1;
+}
+
+/* THE STROKE IS THE PERSON'S INK. `--color-user-ink` is what the board's glyphs are written
+   with, so a peer's inline rebinding reaches this stroke and YOUR stroke — which rebinds
+   nothing — takes the incumbent blue. One value, two surfaces, no mapping. */
+.pt-stroke {
+  stroke: var(--color-user-ink);
+  stroke-width: 3.2;
+  stroke-opacity: 0.95;
+}
+
+/* One person is a quantity, not a cast: alone, the stroke is the page's own graphite. */
+.pt-marks.is-solo .pt-stroke {
+  stroke: var(--color-pencil-graphite, var(--grid-line-color));
+}
+
+/* The ink lift, fine pointers only: the solo stroke has somewhere quieter to lift from, a
+   coloured one does not. */
+@media (hover: hover) and (pointer: fine) {
+  .pt-mark:hover .pt-marks.is-solo .pt-stroke {
+    stroke-opacity: 1;
+  }
+}
+
+/* The written count takes the heading rung — 25.888 against the subheading's 20.352 — and the
+   button's 36px floor absorbs it, so the head line never steps at the swap. */
+.pt-count {
+  font-size: var(--type-heading);
+  font-weight: 500;
+  line-height: 1;
+  color: var(--color-user-ink);
+}
+</style>
