--- /dev/null
+++ b/web/frontend/src/games/shared/PlayerLobby.vue
@@ -0,0 +1,247 @@
+<script lang="ts">
+import { ref } from "vue";
+
+/** Somebody at this board, as the register reads them. */
+export interface LobbyPerson {
+  id: string;
+  slug: string;
+  ink: Record<string, string>;
+  self: boolean;
+}
+
+/**
+ * THE ONE THRESHOLD (T9-W7 PLR-COUNT §2). Five strokes on the mark, five rows in the sheet:
+ * one number, two surfaces. Past it the mark writes the count and the sheet keeps four rows
+ * and says how many it is not showing.
+ */
+export const TALLY_MAX = 5;
+
+/**
+ * THE STRINGS, in one constant, named so the copy gate's own discovery grammar finds them
+ * (`check-copy-register.mjs` at 74a2b5d9 reads a table by its NAME). Plain English, no first
+ * person, no em dash, every codepoint in the hand's cut. The static halves are the seated
+ * substrate's table at the fold; the two COUNT halves below are this family's, and they are
+ * what makes the glyph's digits a substring of the accessible name.
+ */
+export const LOBBY_COPY = {
+  /** the count, one base: everyone at this board, you included */
+  count: (n: number) => (n === 1 ? "1 player" : `${n} players`),
+  self: "you",
+  quiet: (s: number) => `${s} seconds ago`,
+  more: (n: number) => `and ${n} more`,
+} as const;
+
+/**
+ * THE SHEET'S ROW BUDGET IS A HEIGHT QUESTION, so it is asked of the height. One module-level
+ * MediaQueryList shared by every instance (`useHoverCard`'s own idiom): a 664px phone holds two
+ * rows over the board, an 844px one holds five. The guard is for the no-DOM case, not a browser.
+ * Module-local: an export nothing imports is a substrate nothing uses (knip, G18).
+ */
+const tall = ref(true);
+if (typeof window !== "undefined" && typeof window.matchMedia === "function") {
+  const mq = window.matchMedia("(min-height: 800px)");
+  tall.value = mq.matches;
+  mq.addEventListener("change", (e) => {
+    tall.value = e.matches;
+  });
+}
+</script>
+
+<script setup lang="ts">
+/**
+ * THE REGISTER (T9-W7 PLR-COUNT §3.3) — the roll call the mark opens.
+ *
+ * The @mbabb card's pose, reused whole except for one value: same 2px border at 30%, same 1rem
+ * radius and padding, same 16rem floor, same 150ms fade. Hung at the PAGE's left edge, so its
+ * right edge lands at 256 and clears the sun at every width the head has.
+ *
+ * THE GROUND IS OPAQUE, and that is this family's declared delta. The card holds two lines; the
+ * register holds six, down the page, over the `sudoku` wordmark — and at 80% the wordmark bled
+ * through at rgb(204) in light, which put the quiet rungs at 3.3:1. A list needs a ground it can
+ * be measured against. The @mbabb card is untouched (π).
+ *
+ * PLAIN MARKUP, NO REGION ROLE. `.players-roster` keeps `role="log"` in the well (screen-reader
+ * only now) and keeps announcing arrivals; a second region here would say the same thing twice
+ * to the same reader. Three live regions before, three after.
+ *
+ * NO `@click.stop`. There is nothing focusable in this sheet, so a tap on it has exactly one
+ * useful meaning: dismiss. That is the phone's dismissal a reader can find, and it is what
+ * prices the lap — whatever the sheet covers, one tap uncovers.
+ */
+import { computed } from "vue";
+import { tallyPose0 } from "./useTallyStrokes";
+import { PRESENCE_QUIET_MS, lastHeard } from "./useSession";
+
+const props = defineProps<{
+  id: string;
+  open: boolean;
+  state: string;
+  people: LobbyPerson[];
+  /** the clock the qualifiers were read against — stamped when the sheet opened */
+  openedAt: number;
+}>();
+
+/** One upright at row scale, still — pose 0, no beat inside the sheet. Every row draws the
+ *  same stroke; what differs between rows is whose ink it is written in. */
+const rowPose = tallyPose0({ key: "row", x1: 6.5, y1: 9, x2: 6.5, y2: 35, seed: 11 });
+
+/**
+ * TALL: the state line and at most five rows, or four and a foot that says how many are not
+ * shown. SHORT: two rows, and NO FOOT — this is the pass-3 repair. A two-row budget spent one
+ * row on the foot, so from three people up the short phone named exactly ONE person and then
+ * said "and 2 more": a register whose office is WHO is here degraded to a second saying of HOW
+ * MANY, in the regime it had priced the lap for. The state line already carries the count, so
+ * the foot is the row to cut. It costs +2.3px of lap at 664 (measured), where 11 of 11 lapped
+ * taps dismiss the sheet. Killing the foot in BOTH regimes was refused on the number: it
+ * narrows the tall phone's clearance to 0.9px.
+ *
+ * Never a scroll — a sheet that scrolls inside a head popover is a surface asking to be managed.
+ */
+const shown = computed(() => {
+  if (!tall.value) return props.people.slice(0, 2);
+  return props.people.length > TALLY_MAX
+    ? props.people.slice(0, TALLY_MAX - 1)
+    : props.people;
+});
+const more = computed(() =>
+  tall.value ? props.people.length - shown.value.length : 0,
+);
+
+/** `you` on yourself; `N seconds ago` on a peer who has been quiet since before you looked.
+ *  Read against the stamp taken at OPEN, so nothing in this sheet ticks. */
+function qualifier(p: LobbyPerson): string {
+  if (p.self) return LOBBY_COPY.self;
+  const heard = lastHeard[p.id];
+  if (!heard || !props.openedAt) return "";
+  const dt = props.openedAt - heard;
+  if (dt < PRESENCE_QUIET_MS) return "";
+  return LOBBY_COPY.quiet(Math.round(dt / 1000));
+}
+</script>
+
+<template>
+  <div :id="id" class="player-lobby" :class="{ 'is-open': open }" data-lobby>
+    <p class="pl-state">{{ state }}</p>
+    <ul class="pl-rows">
+      <li v-for="p in shown" :key="p.id" class="pl-row">
+        <svg
+          class="pl-row-mark"
+          viewBox="3.5 7 6 30"
+          :style="p.ink"
+          aria-hidden="true"
+          xmlns="http://www.w3.org/2000/svg"
+        >
+          <path
+            :d="rowPose"
+            fill="none"
+            stroke-linecap="round"
+            stroke-linejoin="round"
+            stroke-width="3.2"
+            stroke-opacity="0.95"
+          />
+        </svg>
+        <span v-if="p.slug" class="pl-name">{{ p.slug }}</span>
+        <span v-if="qualifier(p)" class="pl-qualifier">{{ qualifier(p) }}</span>
+      </li>
+    </ul>
+    <p v-if="more > 0" class="pl-more">{{ LOBBY_COPY.more(more) }}</p>
+  </div>
+</template>
+
+<style scoped>
+/* The @mbabb card's pose — the same border, radius, padding, width floor and 150ms fade on the
+   house's standard ease, over an OPAQUE ground (see the script block). `visibility` is what
+   pulls a shut sheet out of the tab order (UI-6's idiom, inherited with the pose). */
+.player-lobby {
+  position: absolute;
+  top: 100%;
+  left: 0;
+  margin-top: 0;
+  padding: 1rem;
+  background: var(--color-popover);
+  border: 2px solid color-mix(in srgb, var(--color-border) 30%, transparent);
+  border-radius: 1rem;
+  opacity: 0;
+  visibility: hidden;
+  pointer-events: none;
+  transform: scale(0.9) translateY(8px);
+  transition:
+    opacity 150ms var(--ease-standard),
+    transform 150ms var(--ease-standard),
+    visibility 0s linear 150ms;
+  z-index: 50;
+  min-width: 16rem;
+  font-family: var(--font-hand);
+}
+
+.player-lobby.is-open {
+  opacity: 1;
+  visibility: visible;
+  pointer-events: auto;
+  transform: scale(1) translateY(0);
+  transition:
+    opacity 150ms var(--ease-standard),
+    transform 150ms var(--ease-standard),
+    visibility 0s linear 0s;
+}
+
+.pl-state {
+  margin: 0;
+  font-size: var(--type-tag);
+  font-weight: 500;
+  line-height: 1.35;
+  color: var(--ink-press-quiet);
+}
+
+.pl-rows {
+  display: flex;
+  flex-direction: column;
+  gap: 0.1rem;
+  margin: 0.35rem 0 0;
+  padding: 0;
+  list-style: none;
+}
+
+.pl-row {
+  display: flex;
+  align-items: center;
+  gap: 0.35rem;
+  min-width: 0;
+}
+
+/* The mark at row scale: the same upright, still. The viewBox is cropped to the stroke's own
+   box rather than the tally's 44-unit frame, so a 22px row still paints the stroke at 2.35px —
+   inside the regime the contrast and chroma were measured in, instead of a 1.3px hairline. */
+.pl-row-mark {
+  flex: 0 0 auto;
+  width: 4.4px;
+  height: 22px;
+  overflow: visible;
+}
+.pl-row-mark path {
+  stroke: var(--color-user-ink);
+}
+
+/* The name is the page's graphite, not the person's ink: the ink is the mark's job, and a
+   coloured name is a second saying of the same thing at a worse contrast. */
+.pl-name {
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-size: var(--type-small);
+  line-height: 1.35;
+  color: var(--color-pencil-graphite, var(--grid-line-color));
+}
+
+.pl-qualifier,
+.pl-more {
+  font-size: var(--type-tag);
+  line-height: 1.35;
+  color: var(--ink-press-quiet);
+}
+
+.pl-more {
+  margin: 0.1rem 0 0;
+}
+</style>
diff --git a/web/frontend/src/games/shared/PlayerTally.vue b/web/frontend/src/games/shared/PlayerTally.vue
