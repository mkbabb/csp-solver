+    );
+
+    // 0 — the ring's geometry is the cascade's and this file asserts what it READ, which is the
+    // one way a literal cannot rot here. §6 owns the value; this row simply refuses to guess it.
+    expect(r.ring.alpha).toBeCloseTo(0.55, 5);
+    expect(r.ring.fill).toBeCloseTo(0.04, 5);
+
+    // 1 — THE LAW, in the only units it is felt in, on two floors. The ABSOLUTE one is the
+    // family's own claim (no hand nearer a house ink than 0.07); the RATIO is the estate's claim
+    // about itself, and it moves when the estate does.
+    expect(r.nearest.dE).toBeGreaterThanOrEqual(0.07);
+    expect(r.underReference / 144).toBeLessThanOrEqual(r.houseShare);
+
+    // 2 — no two hands paint the same bytes over the first 16, 24 and 40.
+    for (const n of [16, 24, 40]) {
