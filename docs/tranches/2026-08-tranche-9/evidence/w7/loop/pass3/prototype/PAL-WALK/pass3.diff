+  const box = await page.locator(".game-cell").nth(40).boundingBox();
+  if (!box) throw new Error("cell 40 has no box");
+  const clip = {
+    x: Math.floor(box.x - 6),
+    y: Math.floor(box.y - 6),
+    width: Math.ceil(box.width + 12),
+    height: Math.ceil(box.height + 12),
+  };
