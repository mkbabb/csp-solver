+ * the MODULE's emitted hues against that constant and prices the capacity in ΔE. Neither of them
+ * paints: a requested `oklch()` is not a colour until an engine clips it into sRGB and rounds it
+ * to three bytes, and that round trip is where every earlier version of this claim died — a flat
+ * chroma rotated hues by 15.33° and walked a hand back inside crayon-blue's arc while the
+ * arithmetic said it was 12° clear.
+ *
+ * So this asks the ENGINE, twice over. §A composites the walk's own strings through the page's
+ * canvas at the bands the live stylesheet is serving. §B photographs the ONE ring the product
+ * actually draws and reads its bytes back, because a 4px antialiased stroke never reaches its
+ * token and every arithmetic ring number over-reports by the difference.
+ *
+ * NOTHING HERE IS A LITERAL THAT COULD ROT. The ring's alpha and fill come off the cascade, not
+ * out of this file. The count of hands near a house ink is a RATIO to the count the house's own
+ * chromatic tokens produce among themselves, re-derived in the same run — a literal ceiling of 5
+ * reds at 94 of 360 hues the moment a sibling wave lands one new token, which is a gate measuring
+ * the estate's weather rather than this family's design.
+ */
+import { test, expect, type Page } from "@playwright/test";
+
+/** A screenshot's own bytes, decoded BY THE BROWSER THAT TOOK IT — the page already holds a
+ *  canvas, so a PNG decoder is one `drawImage` rather than a dependency this estate does not
+ *  declare. */
+async function rawOf(
+  page: Page,
+  png: { toString: (enc: string) => string },
+): Promise<{ data: number[]; w: number; h: number }> {
+  return page.evaluate(async (b64) => {
+    const img = new Image();
+    img.src = `data:image/png;base64,${b64}`;
+    await img.decode();
+    const c = document.createElement("canvas");
+    c.width = img.naturalWidth;
+    c.height = img.naturalHeight;
+    const g = c.getContext("2d", { willReadFrequently: true })!;
+    g.drawImage(img, 0, 0);
+    const d = g.getImageData(0, 0, c.width, c.height);
+    return { data: Array.from(d.data), w: c.width, h: c.height };
+  }, png.toString("base64"));
+}
+
+const SOLO = "./?size=3&difficulty=EASY&wire=local";
+/** The ring band this tree ships, and the pair the synthesis priced beside it. Both are read
+ *  PAINTED in §A's arithmetic and §B's photograph; the shipped one is the lightest light arm and
+ *  darkest dark arm that clear 3.0 painted with 0.10 of headroom. */
+const ALTERNATE_BAND = { light: "0.34", dark: "0.77" };
+
+interface Reading {
+  band: string;
+  ringBand: string;
+  /** what the CASCADE says the ring is drawn with — never a literal in this file. */
+  ring: { alpha: number; fill: number; width: number };
+  hands: { i: number; h: number; C: number; ringC: number; rgb: number[] }[];
+  nearest: { dE: number; i: number; token: string };
+  /** hands under the house's own nearest-pair distance, and that distance, re-derived here. */
+  houseReference: number;
+  underReference: number;
+  /** the share of the house's OWN chromatic tokens whose nearest neighbour is under that same
+   *  reference — the ceiling the walk's own share is held against. */
+  houseShare: number;
+  houseTokens: number;
+  aa: { ratio: number; i: number; ground: string }[];
+  /** the ring against its own fill, by token arithmetic, per candidate band. */
+  ringArithmetic: Record<string, { worst: number; i: number; onPopover: number; minC: number }>;
+  /** what alpha ALONE would have to be for the palette to clear 3:1 with no ring band. */
+  alphaOnly: { first: number | null; under065: number };
+  peerVsPeer: Record<string, number>;
+}
+
+async function settled(page: Page): Promise<void> {
+  await page.waitForSelector("svg.handwritten-logo", { timeout: 40000 });
+  await expect
+    .poll(() => page.locator(".sudoku-cell .glyph-svg").count(), { timeout: 40000 })
+    .toBeGreaterThan(0);
+}
+
+async function theme(page: Page, t: "light" | "dark"): Promise<void> {
+  await page.evaluate((x) => {
+    document.documentElement.classList.toggle("dark", x === "dark");
+  }, t);
+  await page.evaluate(
+    () => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))),
+  );
+}
+
+/** Put a peer's cursor on one cell for real: the product's own class and the product's own var,
+ *  bound with the ring string the module emits. Nothing else about the cell is touched. */
+async function seatCursor(page: Page, index: number | null): Promise<void> {
+  await page.evaluate(async (i) => {
+    const w = window as unknown as { __walkSeat?: MutationObserver };
+    const cell = document.querySelectorAll<HTMLElement>(".game-cell")[40];
+    if (!cell) throw new Error("no cell 40");
+    w.__walkSeat?.disconnect();
+    delete w.__walkSeat;
+    if (i === null) {
+      cell.classList.remove("is-peer-cursor");
+      cell.style.removeProperty("--color-peer-cursor-ink");
+      return;
+    }
+    const served = "/src/games/shared/playerIdentity.ts";
+    const m = (await import(/* @vite-ignore */ served)) as {
+      inkFor: (n: number) => Record<string, string>;
+    };
+    const ink = m.inkFor(i)["--color-peer-cursor-ink"];
+    const set = (): void => {
+      cell.style.setProperty("--color-peer-cursor-ink", ink);
+      cell.classList.add("is-peer-cursor");
+    };
+    set();
+    // THE BOIL RE-RENDERS THE CELL, and Vue patches `class` by writing the attribute whole — so
+    // a class set from outside the component survives until the next tick and no longer. The
+    // product's own seat is a peer on the wire; this probe is about the RING'S BYTES, not the
+    // session, so the seat is simply re-asserted. Three lines of test affordance, and not one
+    // declaration of `gameCell.css` is restated here.
+    const o = new MutationObserver(() => {
+      if (!cell.classList.contains("is-peer-cursor")) set();
+    });
+    o.observe(cell, { attributes: true, attributeFilter: ["class", "style"] });
+    w.__walkSeat = o;
+  }, index);
+  // the ring draws on over 180ms; the photograph is of the finished line.
+  await page.waitForTimeout(320);
+}
+
+/** One theme's whole arithmetic reading, taken inside the page so the bytes are the engine's. */
+async function read(page: Page, arm: "light" | "dark"): Promise<Reading> {
+  // THE SHIPPED BAND IS THE SHEET'S, never this file's — a spec that sets the token it is about
+  // to assert on cannot red when the token moves, which is exactly what the first cut of this
+  // row did. The ALTERNATE is passed in and priced beside it; nothing is written to the page.
+  await seatCursor(page, 0);
+  const out = await page.evaluate(async (alternate): Promise<Reading> => {
+    // The module the BOARD imports, in the page's own graph — a served path rather than a static
+    // specifier, because this file is typechecked from `e2e/` where that path does not resolve,
+    // and because the point is to ask the running product rather than a copy of it.
+    const served = "/src/games/shared/playerIdentity.ts";
+    const m = (await import(/* @vite-ignore */ served)) as {
+      inkFor: (i: number) => Record<string, string>;
+    };
+    const cs = getComputedStyle(document.documentElement);
+    const band = cs.getPropertyValue("--peer-ink-l").trim();
+    const ringBandNow = cs.getPropertyValue("--peer-ring-l").trim();
+    const sub = (s: string): string =>
+      s.replace("var(--peer-ink-l)", band).replace("var(--peer-ring-l)", ringBandNow);
+    const inks = Array.from({ length: 144 }, (_, i) => sub(m.inkFor(i)["--color-user-ink"]));
+    const rings = Array.from({ length: 144 }, (_, i) =>
+      sub(m.inkFor(i)["--color-peer-cursor-ink"]),
+    );
+
+    // THE RING'S GEOMETRY IS THE CASCADE'S. `gameCell.css` is §6's file and this family does not
+    // touch it, so the alpha, the fill and the width are READ off the element the product draws
+    // rather than written down here where they would rot silently.
+    const path = document.querySelector(".game-cell.is-peer-cursor .cell-ghost-path");
+    if (!path) throw new Error("no peer-cursor ring on the board");
+    const ps = getComputedStyle(path);
+    const ringGeom = {
+      alpha: Number(ps.strokeOpacity),
+      fill: Number(ps.fillOpacity),
+      width: parseFloat(ps.strokeWidth),
+    };
+
+    // EVERY CUSTOM PROPERTY THE SHEET NAMES, RESOLVED THROUGH THE CASCADE — which is what
+    // "reserved per arm" means and what a regex over the source cannot do: in dark, the light
+    // block's hexes are text in a stylesheet and paint nothing, and comparing a night-time hand
+    // against a daytime token is a number about nobody.
+    const names = new Set<string>();
+    for (const s of document.styleSheets) {
+      let rules: CSSRuleList;
+      try {
+        rules = s.cssRules;
+      } catch {
+        continue; // a cross-origin sheet has nothing to say about this product's tokens
+      }
+      for (const r of rules)
+        for (const mm of r.cssText.matchAll(/(--[a-z0-9-]+):/g)) names.add(mm[1]);
+    }
+
+    const c = document.createElement("canvas");
+    c.width = c.height = 1;
+    const g = c.getContext("2d", { willReadFrequently: true })!;
+    const paint = (ground: string, css: string, alpha: number): number[] => {
+      g.globalAlpha = 1;
+      g.globalCompositeOperation = "copy";
+      g.fillStyle = ground;
+      g.fillRect(0, 0, 1, 1);
+      g.globalCompositeOperation = "source-over";
+      g.globalAlpha = alpha;
+      g.fillStyle = css;
+      g.fillRect(0, 0, 1, 1);
+      const d = g.getImageData(0, 0, 1, 1).data;
+      return [d[0], d[1], d[2]];
+    };
+    const lin = (v: number): number =>
+      v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
+    const oklab = ([R, G, B]: number[]): number[] => {
+      const [r, gg, b] = [R, G, B].map((v) => lin(v / 255));
+      const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * gg + 0.0514459929 * b);
+      const mm = Math.cbrt(0.2119034982 * r + 0.6806995451 * gg + 0.1073969566 * b);
+      const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * gg + 0.6299787005 * b);
+      return [
+        0.2104542553 * l + 0.793617785 * mm - 0.0040720468 * s,
+        1.9779984951 * l - 2.428592205 * mm + 0.4505937099 * s,
+        0.0259040371 * l + 0.7827717662 * mm - 0.808675766 * s,
+      ];
+    };
+    const dE = (a: number[], b: number[]): number => {
+      const [x, y] = [oklab(a), oklab(b)];
+      return Math.hypot(x[0] - y[0], x[1] - y[1], x[2] - y[2]);
+    };
+    const chromaOf = (rgb: number[]): number => {
+      const [, A, B] = oklab(rgb);
+      return Math.hypot(A, B);
+    };
+    const lum = ([r, gg, b]: number[]): number =>
+      0.2126 * lin(r / 255) + 0.7152 * lin(gg / 255) + 0.0722 * lin(b / 255);
+    const ratio = (a: number[], b: number[]): number => {
+      const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p);
+      return (x + 0.05) / (y + 0.05);
+    };
+
+    const hands = inks.map((css, i) => {
+      const rgb = paint("#808080", css, 1);
+      const [, A, B] = oklab(rgb);
+      const h = (Math.atan2(B, A) * 180) / Math.PI;
+      return {
+        i,
+        h: h < 0 ? h + 360 : h,
+        C: Math.hypot(A, B),
+        ringC: chromaOf(paint("#808080", rings[i], 1)),
+        rgb,
+      };
+    });
+
+    // THE TOKENS THIS ARM ACTUALLY SERVES, found by chroma in the live cascade — the same rule
+    // tier 1 reads the source with, so a rename cannot hide a hue here either.
+    const tokens = [...names]
+      .map((name) => ({ name, value: cs.getPropertyValue(name).trim() }))
+      .filter((t) => /^(#|rgb|hsl|oklch|color\()/i.test(t.value))
+      .map((t) => ({ name: t.name, rgb: paint("#808080", t.value, 1) }))
+      .filter((t) => chromaOf(t.rgb) > 0.06);
+
+    // THE REFERENCE, RE-DERIVED IN THIS RUN AND IN THIS ARM. It used to be the literal 0.0764 —
+    // the light arm's orange against gold — carried into the dark arm where the same pair reads
+    // 0.0605. The estate states this number about itself: the closest two CRAYONS, the five
+    // colours this product calls different colours, read off the live cascade.
+    const crayons = tokens.filter((t) => /^--color-crayon-/.test(t.name));
+    let houseReference = Infinity;
+    for (let a = 0; a < crayons.length; a++)
+      for (let b = a + 1; b < crayons.length; b++)
+        houseReference = Math.min(houseReference, dE(crayons[a].rgb, crayons[b].rgb));
+
+    /** How close a thing gets to the nearest OTHER chromatic token in the house. */
+    const nearestOther = (rgb: number[], self?: string): { dE: number; token: string } => {
+      let best = { dE: Infinity, token: "" };
+      for (const t of tokens) {
+        if (t.name === self) continue;
+        const d = dE(rgb, t.rgb);
+        if (d > 1e-9 && d < best.dE) best = { dE: d, token: t.name };
+      }
+      return best;
+    };
+
+    // AND THE COUNT IS A RATIO TO THE HOUSE'S OWN. `underReference ≤ 5` was a literal, and a
+    // literal measures the estate's weather: one new token from a sibling wave reds it at 94 of
+    // 360 hues. What the walk owes is that it crowd the house's inks NO HARDER THAN THE HOUSE
+    // CROWDS ITSELF — the share of house tokens whose own nearest neighbour is under the crayon
+    // reference, re-derived here, against the share of hands that are.
+    let houseUnder = 0;
+    for (const t of tokens)
+      if (nearestOther(t.rgb, t.name).dE < houseReference) houseUnder++;
+
+    let nearest = { dE: Infinity, i: -1, token: "" };
+    let underReference = 0;
+    for (const hand of hands) {
+      const best = nearestOther(hand.rgb);
+      if (best.dE < houseReference) underReference++;
+      if (best.dE < nearest.dE) nearest = { dE: best.dE, i: hand.i, token: best.token };
+    }
+    const houseShare = houseUnder / tokens.length;
+
+    // THE GROUNDS A DIGIT IS ACTUALLY PAINTED ON. The board sits on the card over the paper; the
+    // roster row sits in the controls card, which is the dock sheet's popover on a phone; the
+    // selection wash is the 8% crayon-blue a digit reads against on your own selected cell; the
+    // TAPE is the washi the fold's attribution rides (`--sheet-washi-neutral`); and the LAMINATE
+    // is the armed-hint ground under the same digit. The last two are REPORTED, not asserted:
+    // they are the fold's surfaces and this family prices them rather than curing them.
+    const cardCssBase = cs.getPropertyValue("--color-card").trim();
+    const rgbOf = (v: number[]): string => `rgb(${v[0]},${v[1]},${v[2]})`;
+    const wash = paint(cardCssBase, cs.getPropertyValue("--color-crayon-blue").trim(), 0.08);
+    const tape = cs.getPropertyValue("--sheet-washi-neutral").trim();
+    // the armed-hint wash, as `gameCell.css:.cell-because` composes it: 15% teacher-red on the card.
+    const laminate = rgbOf(
+      paint(cardCssBase, cs.getPropertyValue("--color-teacher-red").trim(), 0.15),
+    );
+    const grounds: Record<string, string> = {
+      background: cs.getPropertyValue("--color-background").trim(),
+      card: cardCssBase,
+      popover: cs.getPropertyValue("--color-popover").trim(),
+      "selection-wash": rgbOf(wash),
+    };
+    const reported: Record<string, string> = {
+      "tape (reported)": tape,
+      "laminate (reported)": laminate || cardCssBase,
+      "accent (watched, not a ground)": cs.getPropertyValue("--color-accent").trim(),
+    };
+    const aa: Reading["aa"] = [];
+    for (const [name, gcss] of Object.entries({ ...grounds, ...reported })) {
+      if (!gcss) continue;
+      const bg = paint(gcss, "rgba(0,0,0,0)", 0);
+      let worst = { ratio: Infinity, i: -1, ground: name };
+      for (const hand of hands) {
+        const r = ratio(paint(gcss, inks[hand.i], 1), bg);
+        if (r < worst.ratio) worst = { ratio: r, i: hand.i, ground: name };
+      }
+      aa.push(worst);
+    }
+
+    // THE RING against its OWN fill, the thing a reader actually has to see it against — the 4%
+    // wash of the same ink inside the same cell. Priced at BOTH candidate bands so the pin rule
+    // in `index.css` has its two readings, and on the phone's popover ground as well as the card.
+    const cardCss = grounds.card || grounds.background;
+    const ringAt = (band: string) => {
+      const swap = (s: string): string => s.replace(ringBandNow, band);
+      let worst = { r: Infinity, i: -1 };
+      let onPopover = Infinity;
+      let minC = Infinity;
+      for (const hand of hands) {
+        const ringCss = swap(rings[hand.i]);
+        minC = Math.min(minC, chromaOf(paint("#808080", ringCss, 1)));
+        for (const [ground, keep] of [
+          [cardCss, true],
+          [grounds.popover, false],
+        ] as [string, boolean][]) {
+          const fill = paint(ground, ringCss, ringGeom.fill);
+          const stroke = paint(rgbOf(fill), ringCss, ringGeom.alpha);
+          const r = ratio(stroke, fill);
+          if (keep) {
+            if (r < worst.r) worst = { r, i: hand.i };
+          } else onPopover = Math.min(onPopover, r);
+        }
+      }
+      return { worst: worst.r, i: worst.i, onPopover, minC };
+    };
+    const ringArithmetic: Reading["ringArithmetic"] = {};
+    for (const b of [ringBandNow, alternate]) ringArithmetic[b] = ringAt(b);
+
+    // THE OPACITY AXIS ALONE (§6's question): with no ring band, how much alpha would the ring
+    // need? Reported, never asserted — `join-language-prm:153` holds the shipped 0.55.
+    let first: number | null = null;
+    let under065 = 0;
+    for (let a = 0.5; a <= 1.0001; a += 0.01) {
+      let ok = true;
+      let count = 0;
+      for (const hand of hands) {
+        const fill = paint(cardCss, inks[hand.i], ringGeom.fill);
+        const stroke = paint(rgbOf(fill), inks[hand.i], a);
+        if (ratio(stroke, fill) < 3) {
+          ok = false;
+          count++;
+        }
+      }
+      if (Math.abs(a - 0.65) < 0.005) under065 = count;
+      if (ok && first === null) first = Math.round(a * 100) / 100;
+    }
+
+    const peerVsPeer: Record<string, number> = {};
+    for (const n of [2, 3, 4, 5, 8, 16]) {
+      let min = Infinity;
+      for (let i = 0; i < n; i++)
+        for (let k = i + 1; k < n; k++)
+          min = Math.min(min, dE(hands[i].rgb, hands[k].rgb));
+      peerVsPeer[String(n)] = min;
+    }
+    return {
+      band,
+      ringBand: ringBandNow,
+      ring: ringGeom,
+      hands,
+      nearest,
+      houseReference,
+      underReference,
+      houseShare,
+      houseTokens: tokens.length,
+      aa,
+      ringArithmetic,
+      alphaOnly: { first, under065 },
+      peerVsPeer,
+    };
+  }, ALTERNATE_BAND[arm]);
+  await seatCursor(page, null);
+  return out;
+}
+
+/** MRK-ABS's `isTheRing`, on this family's subject: two photographs of one cell, the CHANGED
+ *  pixels are the ring and its fill, and the stroke's median is verified against what the
+ *  cascade says it should composite to before any number is believed. */
+async function paintedRing(
+  page: Page,
+  index: number,
+): Promise<{
+  isTheRing: boolean;
+  deltaToComputed: number;
+  ratio: number;
+  ink: number[];
+  fill: number[];
+  samples: number;
+  where: string;
