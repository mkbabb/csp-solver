+      expect(new Set(bytes).size, `${n} hands, ${arm}`).toBe(n);
+    }
+
+    // 3 — AA on the four grounds a digit is painted on, worst of 144. A digit is text. The tape,
+    // the laminate and the accent are PRINTED and not asserted: the first two are the fold's own
+    // surfaces (HEAD's `--color-user-ink` reads 4.232 on the dark tape and 4.403 on the laminate),
+    // and the accent is a coupling for any future wave that paints a slug on a chip.
+    for (const w of r.aa) {
+      say(`AA ${w.ground}: worst ${w.ratio.toFixed(3)}:1 at i=${w.i}`);
+      if (!/reported|watched/.test(w.ground)) expect(w.ratio).toBeGreaterThanOrEqual(4.5);
+    }
+
+    // 4 — the ring by arithmetic at both candidate bands, and the minimum chroma each spends.
+    for (const [b, v] of Object.entries(r.ringArithmetic))
+      say(
+        `ring band ${b}: worst ${v.worst.toFixed(3)}:1 at i=${v.i} · on popover ${v.onPopover.toFixed(3)}:1 · min ring chroma ${v.minC.toFixed(4)}`,
+      );
+    say(
