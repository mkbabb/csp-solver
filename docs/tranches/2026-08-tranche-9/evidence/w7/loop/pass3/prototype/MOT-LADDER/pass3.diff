+  if (declared && dockRung) return [];
+  return [
+    `the dock's clock declares no band: ${declared ? 1 : 0} of 1 travel line, dock rung ${dockRung ? (dockRung[1] ?? dockRung[2]) : "unnamed"} — a length nobody saw against its distance is what may not ship again.`,
+  ];
+}
+
+/** G-GUARD — one settle-guard constant, read by both FLIP engines. */
+function gGuard() {
+  const bad = [];
+  const flip = join(SRC, "games/shared/useFlipGlide.ts");
+  const car = join(SRC, "pencil/chrome/GameGallery/useCarouselGlide.ts");
