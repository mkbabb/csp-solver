+      () => gDockBand({ rungs: [{ key: "rise", value: 600 }], rungDoc: "rise: 600," }),
+    ],
+    [
+      "B10 PINNED-CITE",
+      "a PINNED site drops its cite (useControlsDrawer's 480/520/560 audition)",
+      () => b10PinnedCite({ rungDoc: "", src: "" }),
+    ],
+    [
+      "B11 KIND FENCE",
+      "THE THREE PLANTS — `const GLIDE_MS = 600`, `.animate({duration: 777})`, `setTimeout(…, SABOTAGE_MS)`",
+      () => {
+        const planted = [
+          "const GLIDE_MS = 600;",
+          "el.animate(frames, { duration: 777 });",
+          "const SABOTAGE_MS = 340;",
+          "setTimeout(done, SABOTAGE_MS);",
+        ];
+        const bad = [];
+        for (const [i, line] of planted.entries()) {
+          const isClock =
+            /setTimeout\s*\(|setInterval\s*\(|duration\s*:|\.animate\s*\(|_MS\b|Ms\b\s*[:=]/.test(
+              line,
+            ) && CLOCK.test(line);
+          if (!isClock) continue;
+          const kind =
+            TRAVEL_READ.test(line) || POLICY_TAG.test(line) || WINDOW_TAG.test(line)
+              ? "kinded"
+              : null;
+          if (!kind) bad.push(`plant:${i + 1}  a bare clock, no kind.  ${line}`);
+        }
+        return bad;
+      },
+    ],
+    [
+      "B11 KIND FENCE",
+      "THE NEGATIVE-NEGATIVE — the nine instrument artefacts (a comment, a type position) must NOT red",
+      () => {
+        const artefacts = ["// the 520ms fold", "  durationMs: number;", "/* 200ms window */"];
+        const bad = [];
+        for (const a of artefacts) {
+          const line = stripCode(a);
+          const isClock =
+            /setTimeout\s*\(|setInterval\s*\(|duration\s*:|\.animate\s*\(|_MS\b|Ms\b\s*[:=]/.test(
+              line,
+            ) && CLOCK.test(line);
+          if (isClock) bad.push(`artefact read as a clock: ${a}`);
+        }
+        // INVERTED: this case is the one that must stay GREEN, so it returns a red only when
+        // the parser regressed. Reported here so the roster's blindness cannot pass silently.
+        return bad.length ? bad : ["(negative-negative held: 0 of 3 artefacts read as clocks)"];
+      },
+    ],
+    [
+      "B12 ABSENCE (static half)",
+      "the scratch ships `initial-value: 520ms` — absence would read 0.52s and PASS",
+      () => b12Absence({ pub: { registered: true, initialStill: false } }),
+    ],
+    [
+      "B12 ABSENCE (static half)",
+      "the registration is dropped — absence takes the shorthand to `all`",
+      () => b12Absence({ pub: { registered: false, initialStill: true } }),
+    ],
+    [
+      "G-REFUSE-ONE-HOME",
+      "`0.6s` is typed back into index.css beside the character's home",
+      () => {
+        const bad = [];
+        for (const m of `.solve-failure { animation: refuse-shake 0.6s linear; }`.matchAll(
+          /animation:\s*refuse-shake\s+([^\s;]+)/g,
+        ))
+          if (!/^var\(--refuse-dur\)$/.test(m[1]))
+            bad.push(`model  refuse-shake at ${m[1]} — a literal twin.`);
+        return bad;
+      },
+    ],
+  ];
+  const vacuous = [];
+  for (const [target, desc, fn] of cases) {
+    const found = fn();
+    console.log(
+      `  [${target}] ${desc}\n      → ${found.length ? "RED (as it must)" : "GREEN — VACUOUS"}`,
+    );
+    if (!found.length) vacuous.push(`check "${target}" stayed GREEN under: ${desc}.`);
+  }
+  failures.push(...vacuous.map((v) => `[SELF-TEST] ${v}`));
+}
+
+if (failures.length) {
+  console.error(
+    `\n${failures.length} failure(s). ${LIST ? "" : "Re-run with --list for each."}`,
+  );
+  if (!LIST) for (const f of failures.slice(0, 8)) console.error(`  • ${f}`);
+  process.exit(1);
+}
+console.log(
+  "\nOK — every shipped duration reads a rung or a content-anchored admission; the ladder is closed, published once with its reduce arm, mirrored, `all`-free, curved, delay-fenced, banded, and nothing shortened.",
+);
