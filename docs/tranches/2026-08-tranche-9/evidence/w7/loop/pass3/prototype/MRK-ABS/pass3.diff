+    await page.waitForSelector(".board-shell .game-cell", { timeout: 40000 });
+    await expect.poll(() => page.locator(".board-shell .game-cell").count(), { timeout: 40000 }).toBe(N * N);
+    await page.waitForTimeout(700);
