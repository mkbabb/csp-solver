+/* ── T9-W7 §3 · KINSHIP, and THE CORRIDOR ───────────────────────────────────
+ *
+ * The ladder above grades PRESSURE. These two grade HUE and its price.
+ *
+ * KIN: every interactive accent is one of the five crayons at a different pressure, so an ink
+ * tier must hold its crayon's hue. The violet this replaced sat 41.3° off every house colour and
+ * no gate could say so, because a hex is not a hue. OKLCH is the space the tiers were cut in.
+ *
+ * CORRIDOR: the fill trace has TWO grounds at once — the frame line it retraces and the paper
+ * behind it — and they swap places between themes, so "clears 3:1" is an INTERVAL, not a number.
+ * The gate asserts the interval, never the hex: any move of --grid-line-color or --color-card
+ * re-opens it and reds here rather than in the wild. This arm is TOKEN ARITHMETIC and is labelled
+ * so: it over-reports a 12-unit hand-drawn line by ~0.5 against the painted bytes, so it carries
+ * a MARGIN over the floor and the painted pair is asserted in the browser
+ * (e2e/progress-corridor.spec.ts), which is the row that governs.
+ */
+const OKLCH_KIN_DEG = 5;
+const CORRIDOR_MARGIN = 0.25;
+
+const lin = (c) => {
+  const s = c / 255;
+  return s <= 0.04045 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
+};
+const unlin = (v) =>
+  255 * (v <= 0.0031308 ? v * 12.92 : 1.055 * v ** (1 / 2.4) - 0.055);
+
+/** sRGB (0-255) → OKLCH {L, C, h°}. Björn Ottosson's matrices, verbatim. */
+function oklch([r, g, b]) {
+  const [R, G, B] = [lin(r), lin(g), lin(b)];
+  const l = Math.cbrt(0.4122214708 * R + 0.5363325363 * G + 0.0514459929 * B);
+  const m = Math.cbrt(0.2119034982 * R + 0.6806995451 * G + 0.1073969566 * B);
+  const s = Math.cbrt(0.0883024619 * R + 0.2817188376 * G + 0.6299787005 * B);
+  const L = 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s;
+  const a = 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s;
+  const bb = 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s;
+  return { L, C: Math.hypot(a, bb), h: ((Math.atan2(bb, a) * 180) / Math.PI + 360) % 360 };
+}
+
+/** OKLCH → sRGB (0-255, clamped). The self-test's rotation needs the way back. */
+function fromOklch({ L, C, h }) {
+  const a = C * Math.cos((h * Math.PI) / 180);
+  const b = C * Math.sin((h * Math.PI) / 180);
+  const l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3;
+  const m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3;
+  const s = (L - 0.0894841775 * a - 1.291485548 * b) ** 3;
+  return [
+    4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
+    -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
+    -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s,
+  ].map((v) => Math.min(255, Math.max(0, Math.round(unlin(v)))));
