+      type: "corridor",
+      description:
+        `${scheme}: modal ${modal.join(",")} vs line ${line!.join(",")} = ${vsLine.toFixed(3)}, ` +
+        `vs paper ${paper.join(",")} = ${vsPaper.toFixed(3)}; max-chroma ${maxVsLine.toFixed(3)} / ${maxVsPaper.toFixed(3)}`,
+    });
