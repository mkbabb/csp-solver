+const BASE = {
+  value: "5",
+  position: 0,
+  boardSize: 9,
+  noiseDelay: 0,
+  isGiven: false,
+  isOverridden: false,
+  isSolved: false,
+  isRevealed: false,
+  isHovered: false,
+};
+
+const strokeOf = (props: Partial<typeof BASE>) =>
+  mount(HandwrittenGlyph, { props: { ...BASE, ...props } })
+    .find("path")
+    .attributes("stroke");
+
+describe("HandwrittenGlyph — whose hand wrote this digit", () => {
+  it("writes a player's digit in --color-user-ink, with NO fallback spelling", () => {
+    const stroke = strokeOf({ isGiven: false });
+    expect(stroke).toBe("var(--color-user-ink)");
+    // the tell the defect left behind: a comma means a second colour is named here
+    expect(stroke).not.toContain(",");
+  });
+
+  it("writes an OVERRIDDEN given in the player's ink too — they wrote it, so it is theirs", () => {
+    expect(strokeOf({ isGiven: true, isOverridden: true })).toBe("var(--color-user-ink)");
+  });
+
+  it("leaves an original given in the page's own foreground, never the pen", () => {
+    expect(strokeOf({ isGiven: true })).toBe("var(--color-foreground)");
+  });
+
+  it("gives a solved digit the solver's rainbow, which outranks both", () => {
+    expect(strokeOf({ isGiven: false, isSolved: true })).toBe("url(#solver-ink)");
+  });
+});
