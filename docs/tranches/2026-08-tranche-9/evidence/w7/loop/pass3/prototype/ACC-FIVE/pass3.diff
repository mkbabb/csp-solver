+import { PNG } from "pngjs";
+
+/**
+ * THE FILL GAUGE'S CORRIDOR, PAINTED (T9-W7 §2/§4, gate G2).
+ *
+ * The gauge is the one accent on the board with TWO grounds at once: the graphite frame line it
+ * retraces (an 8-unit stroke inside a 12-unit one leaves a ~1.27 CSS px flank per side at desk,
+ * 0.73 at phone) and the paper behind that. They swap value between themes. So "clears 3:1" is
+ * an INTERVAL the ink has to sit inside, not a number it has to beat — and this file asserts the
+ * interval against PAINTED BYTES, because token arithmetic over-reports a hand-drawn line by
+ * ~0.5 (a 12-unit wobbled stroke never paints its own token at full strength). The node arm in
+ * `scripts/check-ink-pressure.mjs` carries the same corridor in token space, labelled as such;
+ * where the two disagree, THIS one governs.
+ *
+ * WHY THE GROUND IS READ AT PROGRESS 0. At `progress === 0` the trace's `v-for` yields nothing —
+ * there is no `.progress-trace` node in the DOM at all (HandDrawnGrid) — so the frame line and
+ * the paper are read off a board that provably has no gauge on it. The pass-2 instrument sampled
+ * an untraced EDGE of a traced board and had to argue it was clean; this samples an untraced
+ * BOARD and does not have to argue anything.
+ *
+ * THE CORE IS THE MODE OF 24 COLUMNS, not the single most chromatic pixel. A wobbled stroke's
+ * peak pixel is its own best case and moves with the seed; the modal column core is the colour
+ * the stroke actually paints across its run. The max-chroma pixel is asserted too, at the same
+ * floor, so the margin is what survives EITHER instrument.
+ */
+
+const FLOOR = 3;
+const HUE_WINDOW = 45; // degrees either side of the gold anchor: what counts as "the gauge"
+/** THE CHROMA FLOOR, and it is load-bearing. The gauge paints C 0.122 light / 0.100 dark; the
+ *  frame line paints C 0.011. Without this floor a column the front has not reached contributes
+ *  the LINE as its "core", and on a lightly filled board the mode of 24 columns is then the line
+ *  itself — which reads 1.0 against the line and passes nothing. Measured, not guessed. */
+const CHROMA_FLOOR = 0.05;
+const GOLD_HUE: Record<string, number> = { light: 83.7, dark: 95.2 };
+
+type Rgb = [number, number, number];
+
+const srgbToLinear = (c: number) => {
+  const x = c / 255;
+  return x <= 0.04045 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4);
+};
+const lum = ([r, g, b]: Rgb) =>
+  0.2126 * srgbToLinear(r) + 0.7152 * srgbToLinear(g) + 0.0722 * srgbToLinear(b);
