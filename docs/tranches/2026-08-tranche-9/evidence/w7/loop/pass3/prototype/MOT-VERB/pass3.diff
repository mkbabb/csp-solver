+
+  const stale = [...ADMITTED.keys()].filter((k) => !seen.has(k));
+  const collisions = [...textKeys.values()].filter((n) => n > 1).length;
+  return { rows, launderers, admittedTags, stale, counts, movers, moverReds, spendReds, beats, collisions, seen };
+}
+
+/** RULE 8. The table is data in `DarkModeToggle.vue` (`@toggle-beats`), and every beat it
+ *  names must read back off the rule it names. A comment that contradicts its own
+ *  declaration is the defect this catches — on the one surface where it matters most. */
+function beatTable(texts, raws, src, rungs = new Map()) {
+  const file = [...texts.keys()].find((f) => f.endsWith("DarkModeToggle.vue"));
+  if (!file) return { ok: false, rows: [{ beat: "—", why: "DarkModeToggle.vue is not here" }] };
+  const raw = raws.get(file);
+  const m = /@toggle-beats\s*(\{[\s\S]*?\})\s*\*\//.exec(raw);
+  if (!m) return { ok: false, rows: [{ beat: "—", why: "the gesture carries no beat table. Write it beside the gesture." }] };
