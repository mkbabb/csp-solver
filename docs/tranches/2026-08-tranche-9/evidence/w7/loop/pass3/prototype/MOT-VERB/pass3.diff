+  // THE WALK IS NOT `.ts`-ONLY (pass 3). Pass 2 read `/\.ts$/`, and `App.vue:380` — one of the
+  // three spends in the tree, the product's one page going over — was invisible to the gate
+  // for the whole pass. A `<script>` block is code wherever it is written, so a .vue file is
+  // read with everything outside its script blanked, which keeps every line number true.
+  const movers = [];
+  const spends = [];
+  const scriptText = (file) => {
+    const raw = raws.get(file) ?? readFileSync(file, "utf8");
+    if (file.endsWith(".ts")) return strip(raw);
+    let out = raw.replace(/[^\n]/g, " ");
+    for (const m of raw.matchAll(/<script[^>]*>([\s\S]*?)<\/script>/g)) {
+      const at = m.index + m[0].indexOf(m[1]);
+      out = out.slice(0, at) + m[1] + out.slice(at + m[1].length);
+    }
+    return strip(out);
+  };
+  for (const file of walk(src, /\.(ts|vue)$/)) {
+    if (/\.(test|spec)\.ts$/.test(file)) continue; // a unit test's illegal spend is its fixture
+    let t = scriptText(file);
+    if (sabotage) t = sabotage(relative(src, file), t);
