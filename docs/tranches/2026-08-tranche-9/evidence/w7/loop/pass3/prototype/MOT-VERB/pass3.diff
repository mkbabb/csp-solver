+++ b/web/frontend/src/pencil/config/pencilVerbs.test.ts
@@ -0,0 +1,78 @@
+import { describe, expect, it } from "vitest";
+import { MOTION, publishMotionRungs, spend } from "./pencilConfig";
+
+/** THE VERBS' OWN LAWS (T9-W7 §13). The gate reads the stylesheets; this reads the tuple —
+ *  the half a text scan cannot see, because it is a type. */
+describe("the pencil verbs", () => {
+  it("hands a mover the verb's own fill, never a string typed at the call site", () => {
+    expect(spend("turn", "throw")).toEqual({
+      duration: 520,
+      easing: "cubic-bezier(0.32, 0.72, 0, 1)",
+      fill: "none",
+      composite: "replace",
+    });
+    // The fill is a VALUE on the verb, so moving it moves every consumer at once.
+    expect(spend("slide", "step").fill).toBe(MOTION.verbs.slide.fill);
+  });
+
+  it("gives every verb one fill out of the closed set, and none of them `forwards`", () => {
+    for (const verb of Object.values(MOTION.verbs)) {
+      expect(["none", "backwards"]).toContain(verb.fill);
+      expect(verb.fill).not.toBe("forwards");
+    }
+    // V5, RESTATED AS THE DATA IT CAN BE. RUB OUT and WRITE IN are the two that fill backwards:
+    // their keyframe's `to` IS the cascade rest pose, which is what keeps `FILL_ALLOWLIST` out
+    // of this.
+    expect(MOTION.verbs.rubOut.fill).toBe("backwards");
+    expect(MOTION.verbs.writeIn.fill).toBe("backwards");
+  });
+
+  it("lets a mover spend only a verb whose mechanism is waapi", () => {
+    // @ts-expect-error writeIn is a keyframe verb: there is no options half to hand a mover.
+    expect(() => spend("writeIn", "note")).not.toThrow();
+    expect(MOTION.verbs.writeIn.mechanism).not.toContain("waapi");
+    expect(MOTION.verbs.turn.mechanism).toContain("waapi");
+  });
+
+  it("narrows the door to the verb's OWN rungs, at the type", () => {
+    // THE DOOR (pass 3). `spend` reads the rung out of the verb it was given, so a rung the
+    // verb may not spend is a compile error at the line that spends it — not a lint message
+    // and not a runtime surprise. This is the half rule 7 cannot see: the gate reads the
+    // argument text, the type reads the set.
+    // @ts-expect-error turn may spend `throw` and nothing else.
+    expect(() => spend("turn", "whisper")).not.toThrow();
+    // @ts-expect-error `sheet` is not a rung at all: the laminate's 280 is admitted, not a rung.
+    expect(() => spend("slide", "sheet")).not.toThrow();
+    expect(MOTION.verbs.turn.rungs).toEqual(["throw"]);
+  });
+
+  it("spends no rung a verb is not allowed to spend", () => {
+    expect(MOTION.verbs.layDown.rungs).toContain("leave");
+    for (const verb of Object.values(MOTION.verbs))
+      for (const rung of verb.rungs) expect(MOTION.rungs).toHaveProperty(rung);
+  });
+
+  it("gives no verb a number of its own", () => {
+    // V11. A verb owns a curve, a property set, a fill and the rungs it may spend. Every
+    // LENGTH is the ladder's — the dusk's 350 was the last one held here and it went home.
+    const own = Object.values(MOTION.verbs).filter((v) => "ms" in v);
+    expect(own).toHaveLength(0);
+    expect(MOTION.verbs.dusk.rungs).toEqual(["dusk"]);
+    expect(MOTION.rungs.dusk).toBe(350);
+  });
+
+  it("publishes the ladder as one node, its values and its reduce arm together", () => {
+    const doc = document.implementation.createHTMLDocument("the ladder");
+    publishMotionRungs(doc);
+    const nodes = doc.head.querySelectorAll("style[data-motion-rungs]");
+    expect(nodes).toHaveLength(1);
+    const css = nodes[0].textContent ?? "";
+    // Every rung, at its own value, and every rung again at zero under reduce — generated from
+    // the object, so the two layers cannot drift apart.
+    for (const [name, ms] of Object.entries(MOTION.rungs)) {
+      expect(css).toContain(`--motion-${name}:${ms}ms`);
+      expect(css).toContain(`--motion-${name}:0ms`);
+    }
+    expect(css).toContain("@media (prefers-reduced-motion: reduce)");
+  });
+});
