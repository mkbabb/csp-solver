+  console.log(`rows raising two or more rules under one ruling: ${many} of ${ADMITTED.size}`);
+}
+
+console.log(`declarations that name neither a verb nor a rung: ${r.rows.length}  (budget 0)`);
+console.log(
+  `  by rule — curve ${r.counts.curve} · rung ${r.counts.rung} · the fence ${r.counts.fence} declarations / ${r.counts.fenceTerms} terms · the set ${r.counts.set} · what it moves ${r.counts.props} · direction ${r.counts.direction}`,
