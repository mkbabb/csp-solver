+    // the verb's own rungs), but a type is checked where TypeScript runs and this gate is what
+    // CI runs on the estate's stylesheets: the same law, said twice, is the point.
+    for (const m of t.matchAll(/\bspend\(\s*"([A-Za-z]+)"\s*,\s*"([A-Za-z]+)"\s*\)/g)) {
