+  selfTestRed = selfTest() ? 0 : 1;
+  console.log(selfTestRed ? "the controls: RED" : "the controls: every one fires");
+  console.log("");
+}
+
+const r = run();
+const dupes = duplicatePairs();
+
+if (process.argv.includes("--why")) {
+  console.log("what each admitted row actually breaks:");
+  for (const [key, tags] of r.admittedTags)
+    if (ADMITTED.has(key))
+      console.log(`  ${String(tags.length).padStart(2)}  ${tags.join(", ").padEnd(24)} ${key}`);
