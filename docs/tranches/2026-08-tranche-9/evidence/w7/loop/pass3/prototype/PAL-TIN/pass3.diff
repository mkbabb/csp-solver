+<script setup lang="ts">
+/**
+ * THE TALLY (T9-W7 PAL-TIN §1.3) — the sharing axis, drawn where there is room for it.
+ *
+ * The tin holds five pencils and the sixth player takes amber again, so something other than
+ * colour has to say which amber. It is the deal counter's own mark: a gate-five tally, four
+ * uprights and a binding slash, in `DifficultyTally`'s geometry and the same wobbled hand.
+ *
+ * ONE MODE, TWO HOMES — the roster row and the attribution tape, both of which already name
+ * the author in words and both of which have a LINE BOX to draw in. The cell does not. Pass 2
+ * drew this mark in the digit's lower band and pass 3 measured what was already living there:
+ * the hint laminate's 15% wash covers 91% of the cell, the cursor ring's outer edge plus its
+ * wobble reaches 90.65 at 9×9, the grid line eats 2.25 / 3.60 / 5.40 cell-% depending on which
+ * row the cell is in, and the mark's own round cap costs `boardWidth / 600` at each end. What
+ * is left to draw in is 2.67 px on the best 9×9 desk cell, 1.71 on a sub-grid row, 0.43 on the
+ * board's last row, 1.52 at 9×9 on a phone, and NEGATIVE at every 16×16 arm. Every pass-2
+ * clearance figure was `getBBox`, which excludes the stroke, and was optimistic by half of it.
+ * So the in-cell tally is gone, with its number, and this component keeps the home that fits.
+ *
+ * Frozen: one pose (frame `[0]` of the boil generator), no beat, no live filter, so the
+ * filter census stays at 9. `aria-hidden` in both homes — the roster row already carries the
+ * slug and the tape already says the name, so a tick that spoke would be a second region
+ * saying the same thing.
+ *
+ * THE GEOMETRY is `DifficultyTally.vue:66-77`'s, cropped to the line box: uprights y 85 → 97
+ * at 7 apart from a fixed left edge, the gate's slash across them, viewBox `4 83 36 16`. The
+ * height is `1em` of whatever line box it lands in — ~14 px on a desk roster row, ~12 px on a
+ * phone one, ~12–14 px on the tape at `--type-small` — so one set of numbers draws both homes
+ * and neither asks for a size of its own.
+ */
+import { computed } from "vue";
+import { generateLineBoilFrames } from "@pencil/grid/gridPaths";
+
+const props = defineProps<{
+  /** laps round the tin; 1–4 draw uprights, 5 and beyond draw the gate of five. */
+  ticks: number;
+  /** decorrelates the wobble — `seedFor(peerId)`, so one person draws one hand in both homes. */
+  seed: number;
+}>();
+
+const TOP = 85;
+const FOOT = 97;
+const GAP = 7;
+const LEFT = 12; // the first upright's x — the fixed edge the tally grows from
+const BOIL = 0.6; // the tally's own perturbation, in the same units
+
+const paths = computed<string[]>(() => {
+  const n = Math.min(5, Math.max(0, Math.trunc(props.ticks)));
+  if (n === 0) return [];
+  const uprights = n >= 5 ? 4 : n;
+  const strokes: [number, number, number, number][] = [];
+  for (let i = 0; i < uprights; i++) {
+    const x = LEFT + i * GAP;
+    strokes.push([x, TOP, x, FOOT]);
+  }
+  if (n >= 5) strokes.push([LEFT - 4, FOOT + 1, LEFT + 25, TOP - 1]);
+  // One pose off the boil generator — the frames are the hand's variants and we keep the
+  // first, which is what "frozen" means here: a drawn line, never an animated one.
+  return strokes.map(
+    ([x1, y1, x2, y2], i) =>
+      generateLineBoilFrames(
+        x1,
+        y1,
+        x2,
+        y2,
+        {
+          roughness: 0.95,
+          segments: 4,
+          seed: props.seed * 31 + i * 17 + 11,
+          jagged: true,
+        },
+        BOIL,
+        2,
+      )[0],
+  );
+});
+</script>
+
+<template>
+  <svg
+    v-if="paths.length"
+    class="roster-tick"
+    viewBox="4 83 36 16"
+    preserveAspectRatio="xMidYMid meet"
+    xmlns="http://www.w3.org/2000/svg"
+    aria-hidden="true"
+    focusable="false"
+  >
+    <!-- THE INK IS A PRESENTATION ATTRIBUTE, exactly as the digit's is
+         (`HandwrittenGlyph.vue:310`), and that is load-bearing rather than stylistic: the print
+         and forced-colours rules live in `@layer base`, an unlayered scoped rule OUTRANKS a
+         layered one, and a presentation attribute loses to both. Written as CSS here the tick
+         printed black (the print rule carries `!important`) but kept the player's colour under
+         forced colours — measured in pass 2, then cured. -->
+    <path v-for="(d, i) in paths" :key="i" :d="d" stroke="var(--color-user-ink)" />
+  </svg>
+</template>
+
+<style scoped>
+/* The mark rides whatever line box it is dropped into — `1em` tall, so the roster row and the
+   tape at `--type-small` each get the right size with no size of their own. Print and forced
+   colours reach the strokes through `index.css:926` / `:948`, which name `.roster-tick path`
+   beside `.glyph-svg path`; without that pair the tally would print in the player's colour. */
+.roster-tick {
+  /* INLINE-BLOCK, and it is load-bearing: Tailwind's preflight puts every `svg` at
+     `display: block`, which dropped this one onto a line of its own at the start of the name
+     box — measured (the mark sat 61 px LEFT of the word it belongs to, both engines). It sits
+     in the text's own line now, against the word, which is what makes the row a legend. */
+  display: inline-block;
+  height: 1em;
+  width: auto;
+  overflow: visible;
+  margin-inline-start: 0.35em;
+  vertical-align: -0.12em;
+}
+
+.roster-tick path {
+  fill: none;
+  /* ONE PAINTED WIDTH ON EVERY LINE BOX. The crop is scaled by the row's `1em`, so an authored
+     user-space width would paint 2.02 px on a desk row and 1.7 on a phone one; the tally is a
+     pencil line and a pencil line is the same weight wherever it is written. */
+  vector-effect: non-scaling-stroke;
+  stroke-width: 1.5;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+</style>
