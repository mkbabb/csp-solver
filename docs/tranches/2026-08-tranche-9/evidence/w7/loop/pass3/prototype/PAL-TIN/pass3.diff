+function chromaAt(L, hDeg) {
+  let lo = 0;
+  let hi = 0.5;
+  for (let i = 0; i < 60; i++) {
+    const mid = (lo + hi) / 2;
+    if (inGamut(rgbOfOklch(L, mid, hDeg))) lo = mid;
+    else hi = mid;
+  }
+  return lo;
+}
+const hexOfRgb = (rgb) =>
+  "#" +
+  rgb
+    .map((v) => Math.round(gam(Math.min(1, Math.max(0, v))) * 255).toString(16).padStart(2, "0"))
+    .join("");
