+ * cell — so it is carried in a reported row that never fails.
+ */
+const CELL = new Set([
+  "user-ink", "solver-ink-1", "solver-ink-2", "solver-ink-3", "solver-ink-4",
+  "solver-ink-5", "teacher-red", "focus-sketch", "crayon-blue",
+]);
+
+// ── OKLab / OKLCH / sRGB, Björn Ottosson's matrices; ΔE Euclidean in OKLab ────────────
+const lin = (c) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
+const gam = (c) => (c <= 0.0031308 ? 12.92 * c : 1.055 * c ** (1 / 2.4) - 0.055);
