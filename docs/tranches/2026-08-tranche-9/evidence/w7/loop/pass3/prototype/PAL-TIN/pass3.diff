+      sticks: [...blocks[arm].matchAll(STICK)].map((m) => ({ i: +m[1], hex: m[2].toLowerCase() })),
+      rings: [...blocks[arm].matchAll(RING)].map((m) => ({ i: +m[1], hex: m[2].toLowerCase() })),
+      bg: resolve(blocks[arm], fb, "background"),
+      card: resolve(blocks[arm], fb, "card"),
+      progress: resolve(blocks[arm], fb, "progress-ink"),
+    };
+  }
+  return arms;
