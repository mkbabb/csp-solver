+  const [, A, B] = oklab(hex);
+  const h = (Math.atan2(B, A) * 180) / Math.PI;
+  return h < 0 ? h + 360 : h;
+};
+const chromaOf = (hex) => {
+  const [, A, B] = oklab(hex);
+  return Math.hypot(A, B);
+};
+const lOf = (hex) => oklab(hex)[0];
+const gap = (a, b) => {
+  const d = Math.abs(a - b) % 360;
+  return d > 180 ? 360 - d : d;
+};
+const dE = (a, b) => {
+  const A = oklab(a);
+  const B = oklab(b);
+  return Math.hypot(A[0] - B[0], A[1] - B[1], A[2] - B[2]);
+};
