+        const O = eval(over) as (f: string, a: number, b: string) => string;
+        const bg = read("--color-background");
+        const card = read("--color-card");
+        const pop = read("--color-popover");
+        // the attribution tape's paper and the hint laminate, composited as the estate does
+        const tape = (() => {
