+      }),
+    );
+  for (const r of await read()) expect(r, 'shut').toMatch(/^0s(, 0s)*\|0s(, 0s)*$/);
+  await openSheet(a);
+  for (const r of await read()) expect(r, 'open').toMatch(/^0s(, 0s)*\|0s(, 0s)*$/);
+  await ctx.close();
