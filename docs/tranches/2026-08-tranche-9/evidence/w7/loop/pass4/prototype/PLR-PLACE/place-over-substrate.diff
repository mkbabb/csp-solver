+test('7 · a tapped mark opens on a coarse phone, the lap belongs to the sheet, and one tap there dismisses', async ({
+  browser,
+}, info) => {
+  test.slow();
+  const { ctx, pages } = await coarseTable(browser, 664);
+  const [a, b] = pages;
+  // B writes a digit in the second row, left of the sheet's right edge, so A can raise its tape.
+  await b.bringToFront();
+  // An empty cell in the second or third row, columns 1 to 5: under the sheet on this phone
+  // (its right edge is 256, a column is 40 wide) whatever the deal gave.
+  const target = await b.evaluate(() => {
+    const ins = [...document.querySelectorAll('.sudoku-cell input')] as HTMLInputElement[];
+    for (const r of [1, 2]) for (let c = 0; c < 5; c++) {
+      const i = r * 9 + c;
+      if (!ins[i].value && !ins[i].readOnly) return i;
+    }
+    return -1;
+  });
+  expect(target).toBeGreaterThan(-1);
+  await cell(b, target).tap();
+  await b.keyboard.type('5');
+  await a.bringToFront();
+  await expect.poll(() => cell(a, target).inputValue(), { timeout: 10000 }).toBe('5');
+  // THE PRECONDITION IS READ, NOT ASSUMED. The coarse tape (T9-W7 3C-4) rises on a tapped peer
+  // digit in WebKit; in Chromium `hasTouch` it did not rise at all in pass 4, on the HEAD control
+  // (74a2b5d9) exactly as on this tree (0 of 25 samples over 1.2 s, seven cells). That is the
+  // fold's row, not this one; where the tape never rose, the "no tape under the sheet" clause
+  // below is vacuous, and the annotation says so rather than the row passing silently.
+  await cell(a, target).tap();
+  const tapeUp = await expect
+    .poll(() => a.locator('.attribution-tape').count(), { timeout: 2000 })
+    .toBe(1)
+    .then(() => true, () => false);
+  info.annotations.push({ type: 'tape-before-press', description: String(tapeUp) });
+  if (info.project.name === 'webkit') expect(tapeUp, 'WebKit raises the coarse tape').toBe(true);
+
+  // THE NEGATIVE CONTROL FIRST, in this run: the pass-3 seam (`pointerdown` cancelled for every
+  // pointer) re-created by a capture listener. Under a WebKit touch it cancels the tap's click
+  // and the mark never opens; Chromium opens regardless. The built mark must open on both.
+  const planted = await a.evaluate(() => {
+    const m = [...document.querySelectorAll('[data-player-mark]')].find(
+      (e) => (e as HTMLElement).getBoundingClientRect().width > 0,
+    )!;
+    const plant = (e: Event) => e.preventDefault();
+    m.addEventListener('pointerdown', plant, { capture: true });
+    (window as any).__unplant = () => m.removeEventListener('pointerdown', plant, { capture: true });
+    return true;
+  });
+  expect(planted).toBe(true);
+  await mark(a).tap();
+  await a.waitForTimeout(400);
+  const plantedOpen = await mark(a).getAttribute('aria-expanded');
+  expect(plantedOpen, 'the pass-3 seam under a tap').toBe(info.project.name === 'webkit' ? 'false' : 'true');
+  if (plantedOpen === 'true') {
+    await a.touchscreen.tap(380, 650); // shut it again, off the sheet
+    await a.waitForTimeout(300);
+  }
+  await a.evaluate(() => (window as any).__unplant());
+  await cell(a, target).tap();
+  if (tapeUp) await expect(a.locator('.attribution-tape')).toHaveCount(1);
+
+  // THE BUILT MARK.
+  await mark(a).tap();
+  await a.waitForTimeout(400);
+  expect(await mark(a).getAttribute('aria-expanded'), 'a tap opens the sheet').toBe('true');
+  // A tap is an honest look away: the cell lets go, and the tape it held goes with it, so there
+  // is no tape left to paint over the sheet.
+  await expect(a.locator('.attribution-tape')).toHaveCount(0);
+  const geo = await a.evaluate(() => {
+    const sh = document.querySelector('[data-lobby].is-open')!.getBoundingClientRect();
+    const cells = [...document.querySelectorAll('.sudoku-cell')].map((c) => c.getBoundingClientRect());
+    const g = {
+      top: Math.min(...cells.map((c) => c.top)),
+      bottom: Math.max(...cells.map((c) => c.bottom)),
+      right: Math.max(...cells.map((c) => c.right)),
+    };
+    const lapY = (Math.max(sh.top, g.top) + Math.min(sh.bottom, g.bottom)) / 2;
+    const lapX = (sh.left + Math.min(sh.right, g.right)) / 2;
+    const hit = document.elementFromPoint(lapX, lapY);
+    return {
+      lap: Math.max(0, sh.bottom - g.top),
+      lapX,
+      lapY,
+      owner: hit?.closest('[data-lobby]') ? 'sheet' : (hit?.className?.toString() ?? 'none'),
+      active: document.activeElement?.getAttribute('aria-label') ?? document.activeElement?.tagName,
+    };
+  });
+  expect(geo.lap, 'this arm laps the board').toBeGreaterThan(0);
+  expect(geo.owner, 'the sheet owns the hit test over the lapped board').toBe('sheet');
+
+  // THE DISMISSAL: one tap in the lap shuts the sheet and reaches no cell.
+  const values = () =>
+    a.evaluate(() =>
+      [...document.querySelectorAll('.sudoku-cell input')].map((i) => (i as HTMLInputElement).value).join('|'),
+    );
+  const before = await values();
+  await a.touchscreen.tap(geo.lapX, geo.lapY);
+  await a.waitForTimeout(300);
+  expect(await mark(a).getAttribute('aria-expanded')).toBe('false');
+  const after = await a.evaluate(
+    () => document.activeElement?.getAttribute('aria-label') ?? document.activeElement?.tagName,
+  );
+  expect(after, 'the tap reached no cell').not.toMatch(/^Row \d/);
+  expect(await values()).toBe(before);
+  await ctx.close();
+});
