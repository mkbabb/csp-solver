+    const none = mount(PlaceChart, { props: { ...base, peers } });
+    expect(none.findAll(".chart-dot.is-dimmed")).toHaveLength(0);
+    const one = mount(PlaceChart, { props: { ...base, peers, queried: "p2" } });
+    const dimmed = one.findAll(".chart-dot.is-dimmed");
+    expect(dimmed).toHaveLength(2);
+    expect(one.find('.chart-dot[data-peer="p2"]').classes()).not.toContain("is-dimmed");
+  });
+});
diff --git a/web/frontend/src/pencil/chrome/PlayerMark/PlayerMark.place.test.ts b/web/frontend/src/pencil/chrome/PlayerMark/PlayerMark.place.test.ts
new file mode 100644
index 00000000..966a85ba
--- /dev/null
+++ b/web/frontend/src/pencil/chrome/PlayerMark/PlayerMark.place.test.ts
@@ -0,0 +1,111 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { mount } from "@vue/test-utils";
+import PlayerMark from "./PlayerMark.vue";
+import type { MarkRow, PlaceInput } from "./types";
+
+/**
+ * THE SEATING CHART'S CLOCK (T9-W7 PLR-PLACE). The sheet OPENS on where the room is now and
+ * damps only the moves that come after; a row with no dot asks the chart nothing.
+ */
+const ROWS: MarkRow[] = [
+  { id: "me", name: "swift-heron", ink: { "--color-user-ink": "#2563eb" }, self: true },
+  {
+    id: "p1",
+    name: "brave-otter",
+    ink: { "--color-user-ink": "#c026d3" },
+    self: false,
+  },
+  { id: "p2", name: "calm-wren", ink: { "--color-user-ink": "#65a30d" }, self: false },
+  { id: "p3", name: "shy-lynx", ink: { "--color-user-ink": "#0891b2" }, self: false },
+];
+const place = (
+  cursors: Record<string, number | null>,
+  self: number | null = 40,
+): PlaceInput => ({
+  size: 9,
+  subgrid: 3,
+  cursors,
+  self,
+  settleMs: 700,
+});
+
+const dots = () =>
+  [...document.querySelectorAll<SVGCircleElement>("[data-lobby] .chart-dot")].map(
+    (d) => ({
+      id: d.dataset.peer,
+      cx: d.getAttribute("cx"),
+      dim: d.classList.contains("is-dimmed"),
+    }),
+  );
+
+function mountMark(cursors: Record<string, number | null>) {
+  return mount(PlayerMark, {
+    attachTo: document.body,
+    props: { stateLine: "3 other players", ink: {}, rows: ROWS, place: place(cursors) },
+  });
+}
+
+beforeEach(() => vi.useFakeTimers());
+afterEach(() => {
+  vi.useRealTimers();
+  document.body.innerHTML = "";
+});
+
+describe("the chart opens on the room as it is", () => {
+  it("draws every settled peer at the press, before any timer runs", async () => {
+    const w = mountMark({ p1: 10, p2: 20, p3: 30 });
+    await w.find("button").trigger("click");
+    expect(dots().map((d) => d.id)).toEqual(["p1", "p2", "p3"]);
+    expect(document.querySelectorAll("[data-lobby] .chart-self")).toHaveLength(1);
+    w.unmount();
+  });
+
+  it("holds a MOVE until the peer has sat still for settleMs, then steps", async () => {
+    const w = mountMark({ p1: 10, p2: 20, p3: 30 });
+    await w.find("button").trigger("click");
+    const before = dots().find((d) => d.id === "p1")!.cx;
+    await w.setProps({ place: place({ p1: 11, p2: 20, p3: 30 }) });
+    vi.advanceTimersByTime(699);
+    await w.vm.$nextTick();
+    expect(dots().find((d) => d.id === "p1")!.cx).toBe(before);
+    vi.advanceTimersByTime(1);
+    await w.vm.$nextTick();
+    expect(dots().find((d) => d.id === "p1")!.cx).not.toBe(before);
+    w.unmount();
+  });
+
+  it("a peer with no cell has a row, no dot, and says so", async () => {
+    const w = mountMark({ p1: 10, p2: null });
+    await w.find("button").trigger("click");
+    expect(dots().map((d) => d.id)).toEqual(["p1"]);
+    const quals = [...document.querySelectorAll("[data-lobby] .pl-qual")].map((q) =>
+      q.textContent?.trim(),
+    );
+    expect(quals).toEqual(["you", "no cell shown", "no cell shown"]);
+    w.unmount();
+  });
+});
+
+describe("the query asks only rows that have an answer", () => {
+  const enter = (i: number, pointerType = "mouse") => {
+    const row = document.querySelectorAll("[data-lobby] .pl-row")[i]!;
+    const e = new Event("pointerenter") as Event & { pointerType: string };
+    Object.defineProperty(e, "pointerType", { value: pointerType });
+    row.dispatchEvent(e);
+  };
+
+  it("a peer's row dims every other dot; your own row dims none", async () => {
+    const w = mountMark({ p1: 10, p2: 20, p3: 30 });
+    await w.find("button").trigger("click");
+    enter(2);
+    await w.vm.$nextTick();
+    expect(dots().map((d) => d.dim)).toEqual([true, false, true]);
+    enter(0);
+    await w.vm.$nextTick();
+    expect(dots().map((d) => d.dim)).toEqual([false, false, false]);
+    enter(1, "touch");
+    await w.vm.$nextTick();
+    expect(dots().map((d) => d.dim)).toEqual([false, false, false]);
+    w.unmount();
+  });
+});
diff --git a/web/frontend/e2e/player-place.spec.ts b/web/frontend/e2e/player-place.spec.ts
new file mode 100644
index 00000000..9b10d7ae
--- /dev/null
+++ b/web/frontend/e2e/player-place.spec.ts
@@ -0,0 +1,531 @@
+/**
+ * WHERE THE ROOM IS (T9-W7 §11 · PLR-PLACE) — the head's seating chart, and the rows a critic
+ * proved the pass-3 file could not fail.
+ *
+ * PRM: live, because every row reads a SETTLED pose past its window (the sheet's 150ms fade, the
+ * chart's `PLACE_SETTLE_MS` damping) except row 8, which emulates `reducedMotion: 'reduce'`
+ * with emulateMedia({reducedMotion:'reduce'}) before goto and reads the open sheet there.
+ *
+ * O-12: LOCAL. An instrument run by hand and by the wave's battery, never by a runner.
+ *
+ *   1  the chart opens on the room as it is: every settled peer drawn at the press, and a MOVE
+ *      after it still damped (the negative control on the seed)
+ *   2  the query at four at the table: a peer's row leaves its dot at 1 and the other two at
+ *      0.55; your own row dims nothing, the ring stays 1, and the ring wears your mark's ink
+ *   3  Hidden says one `null` and B draws no dot for A; Shown says the cell A is on, once, and
+ *      B draws A there
+ *   4  the head is still while a peer walks the board (the mark and its shut sheet, the whole
+ *      subtree), and the SAME scope moves once the sheet is open (the negative control)
+ *   5  the pitch is 32/3 px a cell at 4×4, 9×9 and 16×16, every dot 8px across, unconditionally
+ *   6  each qualifier on its own peer: `you`, the silent peer's seconds, `no cell shown`, and
+ *      nothing on a peer with a dot
+ *   7  a TAP opens the mark on a coarse phone in both engines (the pass-3 seam, planted, is the
+ *      negative control: WebKit drops the tap's click), the tap lets the cell go so no tape is
+ *      left under the sheet, the sheet owns the lapped board's hit test, and one tap there
+ *      dismisses it and hits no cell
+ *   8  under reduce the open sheet has no transition left
+ */
+import { test, expect, type Browser, type BrowserContext, type Page } from '@playwright/test';
+
+const Q = 'difficulty=EASY&wire=local';
+
+async function settled(page: Page) {
+  await page.waitForSelector('svg.handwritten-logo', { timeout: 60000 });
+  await expect
+    .poll(() => page.locator('.sudoku-cell .glyph-svg').count(), { timeout: 60000 })
+    .toBeGreaterThan(0);
+}
+
+async function invite(page: Page): Promise<string> {
+  const verb = page.locator('.controls-card button[aria-label="Play together on this board"]');
+  await expect(verb).toBeEnabled();
+  const docked = !(await verb.isVisible());
+  if (docked) {
+    await page.locator('.drawer-tab').first().click();
+    await page.waitForTimeout(700); // the dock SLIDES — settle the pose
+  }
+  await verb.click();
+  await expect.poll(() => page.locator('.players-roster .player-row').count()).toBe(1);
+  if (docked) {
+    // Shut the door again: an open dock makes the board inert, and every row here plays on it.
+    await page.locator('.drawer-tab').first().click();
+    await expect(page.locator('#controls-drawer .drawer-case')).toBeHidden();
+    await page.waitForTimeout(700);
+  }
+  return page.url();
+}
+
+/** A table of `n` pages in ONE context (the local wire is a BroadcastChannel, which is scoped to
+ *  the context), A first. The rest open the link A's own verb wrote. */
+async function table(ctx: BrowserContext, n: number, size = 3): Promise<Page[]> {
+  const a = await ctx.newPage();
+  await a.goto(`./?size=${size}&${Q}`);
+  await settled(a);
+  const link = await invite(a);
+  const pages = [a];
+  for (let i = 1; i < n; i++) {
+    const p = await ctx.newPage();
+    await p.goto(link);
+    await settled(p);
+    pages.push(p);
+  }
+  await a.bringToFront();
+  await expect
+    .poll(() => a.locator('.players-roster .player-row').count(), { timeout: 20000 })
+    .toBe(n);
+  return pages;
+}
+
+const cell = (p: Page, i: number) => p.locator('.sudoku-cell input').nth(i);
+const mark = (p: Page) => p.locator('[data-player-mark]:visible');
+const sheet = (p: Page) => p.locator('[data-lobby]:visible');
+const dots = (p: Page) =>
+  p.evaluate(() =>
+    [...document.querySelectorAll('[data-lobby].is-open .chart-dot')].map((d) => ({
+      peer: d.getAttribute('data-peer'),
+      cx: d.getAttribute('cx'),
+      cy: d.getAttribute('cy'),
+      opacity: getComputedStyle(d).opacity,
+    })),
+  );
+
+/** Open by a real press and read past the 150ms fade: the sheet scales 0.9 → 1 on the way in,
+ *  so a box read inside the fade is 10% short (a 4×4 chart reads 38.39 there, not 42.67). */
+async function openSheet(p: Page) {
+  await mark(p).click();
+  await expect(sheet(p)).toBeVisible();
+  await p.waitForTimeout(400);
+}
+
+test('1 · the chart opens on the room as it is, and a move after the press is still damped', async ({
+  browser,
+}) => {
+  test.slow();
+  const ctx = await browser.newContext();
+  const [a, ...peers] = await table(ctx, 4);
+  for (const [i, p] of peers.entries()) {
+    await p.bringToFront();
+    await cell(p, 10 + 20 * i).click();
+  }
+  await a.bringToFront();
+  await a.waitForTimeout(2000); // the room holds still, long past any settle
+  // Time from the press to the first painted dot, measured in the page: the click listener is
+  // in CAPTURE so it stamps before the mark's own handler runs.
+  await a.evaluate(() => {
+    const w = window as unknown as { __press: number; __firstDot: number };
+    w.__press = 0;
+    w.__firstDot = 0;
+    const m = [...document.querySelectorAll('[data-player-mark]')].find(
+      (e) => (e as HTMLElement).getBoundingClientRect().width > 0,
+    )!;
+    m.addEventListener('click', () => (w.__press = performance.now()), { capture: true });
+    const probe = () => {
+      if (document.querySelector('[data-lobby].is-open .chart-dot')) {
+        w.__firstDot = performance.now();
+        return;
+      }
+      requestAnimationFrame(probe);
+    };
+    requestAnimationFrame(probe);
+  });
+  await mark(a).click();
+  await expect.poll(() => a.evaluate(() => (window as any).__firstDot as number)).toBeGreaterThan(0);
+  const openMs = await a.evaluate(
+    () => (window as any).__firstDot - (window as any).__press,
+  );
+  const atOpen = await dots(a);
+  expect(atOpen, 'every settled peer is drawn at the press').toHaveLength(3);
+  expect(openMs, 'the first dot paints inside two frames of the press').toBeLessThan(100);
+
+  // THE NEGATIVE CONTROL: the seed is not a timer that happened to fire fast. A peer moves AFTER
+  // the press; its dot holds for the settle window and then steps.
+  const mover = peers[0];
+  await mover.bringToFront();
+  await cell(mover, 70).click();
+  await a.bringToFront();
+  await a.waitForTimeout(300);
+  const held = (await dots(a)).map((d) => `${d.cx},${d.cy}`);
+  expect(held).toEqual(atOpen.map((d) => `${d.cx},${d.cy}`));
+  await expect
+    .poll(async () => (await dots(a)).map((d) => `${d.cx},${d.cy}`).join(' '), { timeout: 3000 })
+    .not.toBe(atOpen.map((d) => `${d.cx},${d.cy}`).join(' '));
+  await ctx.close();
+});
+
+test('2 · the query at four: a peer row answers, your own row dims nothing', async ({ browser }) => {
+  test.slow();
+  const ctx = await browser.newContext({ viewport: { width: 1280, height: 800 } });
+  const [a, ...peers] = await table(ctx, 4);
+  for (const [i, p] of peers.entries()) {
+    await p.bringToFront();
+    await cell(p, 12 + 20 * i).click();
+  }
+  await a.bringToFront();
+  await cell(a, 40).click();
+  await a.waitForTimeout(1200);
+  await openSheet(a);
+  const rows = a.locator('[data-lobby]:visible .pl-row');
+  await expect(rows).toHaveCount(4);
+
+  const before = (await dots(a)).map((d) => d.opacity);
+  expect(before).toEqual(['1', '1', '1']);
+
+  await rows.nth(2).hover();
+  const onPeer = (await dots(a)).map((d) => d.opacity);
+  expect(onPeer.filter((o) => o === '1'), 'the queried dot').toHaveLength(1);
+  expect(onPeer.filter((o) => o === '0.55'), 'every other dot').toHaveLength(2);
+
+  await rows.nth(0).hover(); // your own row — you are the ring, never a dot
+  const onSelf = (await dots(a)).map((d) => d.opacity);
+  expect(onSelf).toEqual(['1', '1', '1']);
+  const ring = await a.evaluate(() => {
+    const r = document.querySelector('[data-lobby].is-open .chart-self');
+    return r ? getComputedStyle(r).opacity : null;
+  });
+  expect(ring).toBe('1');
+  // and the ring is YOUR ink: the colour your own mark wears in this room, not the estate default
+  const [stroke, markInk] = await a.evaluate(() => {
+    const r = document.querySelector('[data-lobby].is-open .chart-self')!;
+    const m = [...document.querySelectorAll('[data-player-mark]')].find(
+      (e) => (e as HTMLElement).getBoundingClientRect().width > 0,
+    )!;
+    return [getComputedStyle(r).stroke, getComputedStyle(m).color];
+  });
+  expect(stroke).toBe(markInk);
+  await ctx.close();
+});
+
+test('3 · Hidden says one null and draws you nowhere; Shown says your cell once and draws you there', async ({
+  browser,
+}) => {
+  test.slow();
+  const ctx = await browser.newContext({ viewport: { width: 1280, height: 800 } });
+  const [a, b] = await table(ctx, 2);
+  await a.evaluate(() => {
+    const room = new URL(location.href).searchParams.get('s')!;
+    const w = window as unknown as Record<string, unknown>;
+    const seen: unknown[] = [];
+    w.__frames = seen;
+    const ch = new BroadcastChannel(`board:${room}`);
+    ch.onmessage = (e: MessageEvent) => seen.push(e.data);
+  });
+  const CELL = 30;
+  await cell(a, CELL).click();
+  await a.waitForTimeout(500);
+  const curs = () =>
+    a.evaluate(() =>
+      ((window as any).__frames as { kind?: string; data?: { p: number | null } }[])
+        .filter((f) => f?.kind === 'cur')
+        .map((f) => f.data!.p),
+    );
+  await a.evaluate(() => ((window as any).__frames as unknown[]).splice(0));
+
+  const chip = (label: string) =>
+    a.locator('.zone-row', { has: a.locator('.zone-row-label', { hasText: 'your cell' }) })
+      .getByRole('button', { name: label, exact: true });
+  await chip('Hidden').click();
+  await a.waitForTimeout(600);
+  expect(await curs(), 'Hidden: one null, then silence').toEqual([null]);
+
+  await b.bringToFront();
+  await openSheet(b);
+  expect(await dots(b), 'B draws no dot for a hidden A').toHaveLength(0);
+  await b.keyboard.press('Escape');
+
+  await a.bringToFront();
+  await a.evaluate(() => ((window as any).__frames as unknown[]).splice(0));
+  await chip('Shown').click();
+  await a.waitForTimeout(600);
+  expect(await curs(), 'Shown: the cell A is on, once').toEqual([CELL]);
+
+  await b.bringToFront();
+  await openSheet(b);
+  const drawn = await dots(b);
+  expect(drawn).toHaveLength(1);
+  // cell 30 on a 9×9 is row 3, column 3: the dot's centre in the chart's own 1000-unit frame.
+  const at = (i: number) => ((i + 0.5) * 1000) / 9;
+  expect(Number(drawn[0].cx)).toBeCloseTo(at(CELL % 9), 3);
+  expect(Number(drawn[0].cy)).toBeCloseTo(at(Math.floor(CELL / 9)), 3);
+  await ctx.close();
+});
+
+test('4 · the head is still while a peer walks the board, and the same scope moves once open', async ({
+  browser,
+}) => {
+  test.slow();
+  const ctx = await browser.newContext({ viewport: { width: 1280, height: 800 } });
+  const [a, b] = await table(ctx, 2);
+  const WALK = 30;
+  const STEP_MS = 150;
+  const watch = () =>
+    a.evaluate(() => {
+      const m = [...document.querySelectorAll('[data-player-mark]')].find(
+        (e) => (e as HTMLElement).getBoundingClientRect().width > 0,
+      )!;
+      // The scope is the mark's own parent: the button AND its sheet, shut or open, and every
+      // `cur`-driven node the sheet can hold (the chart, the qualifiers, the rows).
+      const scope = m.parentElement!;
+      const w = window as unknown as { __muts: number; __obs?: MutationObserver; __scope: string };
+      w.__muts = 0;
+      w.__obs?.disconnect();
+      w.__scope = `${scope.tagName.toLowerCase()} holding ${scope.querySelectorAll('[data-player-mark],[data-lobby]').length}`;
+      w.__obs = new MutationObserver((r) => (w.__muts += r.length));
+      w.__obs.observe(scope, { subtree: true, childList: true, attributes: true, characterData: true });
+    });
+  const walk = async (n: number) => {
+    await b.bringToFront();
+    await cell(b, 0).click();
+    for (let i = 0; i < n; i++) {
+      await b.keyboard.press(i % 18 < 9 ? 'ArrowRight' : 'ArrowDown');
+      await b.waitForTimeout(STEP_MS);
+    }
+    await b.waitForTimeout(1000); // past the settle window
+    await a.bringToFront();
+  };
+
+  await watch();
+  const t0 = Date.now();
+  await walk(WALK);
+  const shutMs = Date.now() - t0;
+  const shut = await a.evaluate(() => ({
+    muts: (window as any).__muts as number,
+    scope: (window as any).__scope as string,
+  }));
+  expect(shut.scope).toBe('div holding 2');
+  expect(shut.muts, `0 mutations over ${WALK} cells in ${shutMs} ms, sheet shut`).toBe(0);
+
+  await openSheet(a);
+  await a.waitForTimeout(400);
+  await watch();
+  await walk(10);
+  const open = await a.evaluate(() => (window as any).__muts as number);
+  expect(open, 'the same scope does move when the chart is open').toBeGreaterThan(0);
+  await ctx.close();
+});
+
+for (const size of [2, 3, 4]) {
+  const n = size * size;
+  test(`5 · the pitch at ${n}×${n}: 32/3 px a cell, a dot 8px across`, async ({ browser }) => {
+    test.slow();
+    const ctx = await browser.newContext({ viewport: { width: 1280, height: 800 } });
+    const [a, b] = await table(ctx, 2, size);
+    await b.bringToFront();
+    await cell(b, n + 1).click();
+    await a.bringToFront();
+    await cell(a, 0).click();
+    await a.waitForTimeout(1000);
+    await openSheet(a);
+    const read = await a.evaluate(() => {
+      const s = document.querySelector('[data-lobby].is-open .place-chart') as SVGSVGElement;
+      const w = s.getBoundingClientRect().width;
+      const h = s.getBoundingClientRect().height;
+      const k = w / s.viewBox.baseVal.width;
+      const d = s.querySelector('.chart-dot') as SVGCircleElement | null;
+      const r = s.querySelector('.chart-self') as SVGCircleElement | null;
+      return {
+        w,
+        h,
+        dot: d ? Number(d.getAttribute('r')) * 2 * k : null,
+        ring: r ? Number(r.getAttribute('r')) * 2 * k : null,
+      };
+    });
+    expect(read.w).toBeCloseTo((32 / 3) * n, 1); // layout snaps to 1/64 px: 42.656 at 4×4
+    expect(read.h).toBeCloseTo((32 / 3) * n, 1);
+    expect(read.dot).not.toBeNull();
+    expect(read.ring).not.toBeNull();
+    expect(read.dot!).toBeCloseTo(8, 1);
+    expect(read.ring!).toBeCloseTo(8, 1);
+    await ctx.close();
+  });
+}
+
+test('6 · each qualifier sits on its own peer', async ({ browser }) => {
+  test.slow();
+  test.setTimeout(180000);
+  const ctx = await browser.newContext({ viewport: { width: 1280, height: 800 } });
+  const [a, placedPeer, unplacedPeer] = await table(ctx, 3);
+  const slug = (p: Page) =>
+    p.evaluate(
+      () =>
+        document
+          .querySelector('.players-roster .player-row:has(.player-self) .player-name')
+          ?.textContent?.trim() ?? '',
+    );
+  const placedName = await slug(placedPeer);
+  const unplacedName = await slug(unplacedPeer);
+  await placedPeer.bringToFront();
+  await cell(placedPeer, 20).click();
+  // A FOURTH at the table who says `hi` once and then nothing: past PRESENCE_QUIET_MS it is
+  // quiet, and still inside PRESENCE_EXPIRY_MS it has a row. The product's own message shape.
+  await a.bringToFront();
+  await a.evaluate(() => {
+    const ch = new BroadcastChannel(`board:${new URL(location.href).searchParams.get('s')}`);
+    ch.postMessage({ kind: 'hi', data: {}, from: 'p-silent00000' });
+    ch.close();
+  });
+  await expect.poll(() => a.locator('.players-roster .player-row').count()).toBe(4);
+  await a.waitForTimeout(21500);
+  await openSheet(a);
+  const rows = await a.evaluate(() =>
+    [...document.querySelectorAll('[data-lobby].is-open .pl-row')].map((r) => ({
+      name: r.querySelector('.pl-name')?.textContent?.trim() ?? '',
+      qual: r.querySelector('.pl-qual')?.textContent?.trim() ?? '',
+    })),
+  );
+  expect(rows).toHaveLength(4);
+  expect(rows[0].qual).toBe('you');
+  expect(rows.find((r) => r.name === placedName)?.qual, 'a peer with a dot says nothing').toBe('');
+  expect(rows.find((r) => r.name === unplacedName)?.qual).toBe('no cell shown');
+  const silent = rows.filter(
+    (r) => r.name !== placedName && r.name !== unplacedName && r.qual !== 'you',
+  );
+  expect(silent).toHaveLength(1);
+  expect(silent[0].qual).toMatch(/^2\d seconds ago$/);
+  expect(await dots(a)).toHaveLength(1);
+  // the sheet's rows, the mark's name and the room's own log agree on the count
+  expect(await mark(a).getAttribute('aria-label')).toBe('3 other players');
+  expect(await a.locator('.players-roster .player-row').count()).toBe(4);
+  await ctx.close();
