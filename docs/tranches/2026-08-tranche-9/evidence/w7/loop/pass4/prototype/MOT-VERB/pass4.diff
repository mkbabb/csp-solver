+    expect(nodes).toHaveLength(1);
+    const css = nodes[0].textContent ?? "";
+    // Every rung, at its own value, and every rung again at zero under reduce — generated from
+    // the object, so the two layers cannot drift apart.
+    for (const [name, ms] of Object.entries(MOTION.rungs)) {
+      expect(css).toContain(`--motion-${name}:${ms}ms`);
+      expect(css).toContain(`--motion-${name}:0ms`);
+    }
+    expect(css).toContain("@media (prefers-reduced-motion: reduce)");
+  });
+});
