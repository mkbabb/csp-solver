+const PINNED = [
+  {
+    file: "src/games/shared/useControlsDrawer.ts",
+    rung: "throw",
+    cite: /auditioned 480\/520\/560/,
+    doc: /R6 standing ruling 1|audit 4, 2026-07-11/,
+    what: "the desk drawer's throw",
+  },
+  {
+    file: "src/App.vue",
+    rung: "throw",
+    cite: /T4-W12 Wave C/,
+    doc: /R6 standing ruling 1|audit 4, 2026-07-11/,
+    what: "the board fold",
+  },
+  {
+    file: "src/pencil/chrome/GameGallery/useCarouselGlide.ts",
+    rung: "step",
+    cite: /RATIFY-ME|T4-W12 ballot\s+\*?\s*row 4|ballot row 4/,
+    doc: /RATIFY-ME T4-W12 ballot/,
+    what: "one card slot",
