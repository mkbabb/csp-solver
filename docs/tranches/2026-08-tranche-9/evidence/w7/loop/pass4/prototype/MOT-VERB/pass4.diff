+#!/usr/bin/env node
+/**
+ * T9-W7 §13 · THE DURATION LADDER GATE.  BORN RED.
+ *
+ * The estate's easing half is a system and its duration half is not: `pencilConfig.ts`
+ * MOTION named four durations and the shipped rules spelled their lengths as literals
+ * (I6 at HEAD: 77 declarations, 35 distinct literals, 1 reading a named rung). This gate
+ * is the duration twin of `check-motion-contract.mjs`'s PRM contract. It never judges
+ * whether a length is RIGHT — only whether it is a NAMED DECISION.
+ *
+ *   B1 NAMED        every DURATION position inside a shipped transition/animation term
+ *                   reads a rung (`var(--motion-*)`, `MOTION.rungs.*`) or sits in the
+ *                   ADMITTED ledger with a class, a cite and a CONTENT ANCHOR. Position
+ *                   aware: a term's 2nd time is a DELAY, a separate axis (B9 fences it).
+ *   B2 CLOSED       the ladder is a short closed set (<= LADDER_MAX), every rung carries a
+ *                   ruling, and every other numeric MOTION member is EXEMPT by cite or an
+ *                   admitted GRADED TS class.
+ *   B3 MIRROR       ONE publisher emits ONE `<style data-motion-rungs>` node whose text is
+ *      +FALLBACK    GENERATED from `MOTION.rungs` (so it is byte-equal by construction),
+ *      +ONE HOME    carrying the live arm AND the reduce arm; main.ts calls it before
+ *                   mount; no `@theme` copy; no second publisher in ["'].
+ *   B4 NO-ALL       `transition: all` is banned in shipped source.
+ *   B5 PRM          the posture, rule level: the publisher's reduce arm zeroes EVERY rung,
+ *                   the only live nonzero transition lengths outside a reduce block read a
+ *                   rung, and exactly the PRM-FALLBACK rows sit inside a reduce block.
+ *                   (Its RUNTIME twin walks the CSSOM on the built dist — see §RUNTIME.)
+ *   B6 NO-SHORTEN   a RATCHET against the banked inventory (`motion-inventory.base.json`):
+ *                   a duration may rise, never fall. A fall needs a RETUNE ledger row with
+ *                   a cite. Git `BASE_REF` is the fallback when the bank is missing.
+ *   B7 TAILWIND     no `duration-N` class attribute; `--default-transition-duration` reads
+ *                   `var(--motion-whisper)`; each override is an arbitrary-value utility
+ *                   naming a rung; no `transition-all` utility.
+ *   B8 CURVE        (i2 folded in) no bare `ease`/`ease-in`/`ease-out`/`ease-in-out`/
+ *                   `linear`, and no missing timing function, on a transition clause that
+ *                   spends a real length. `linear` stays legal on an `animation:` whose
+ *                   keyframes carry per-step easing.
+ *   B9 DELAY FENCE  the second and later time values in a term are LITERALS. The ladder
+ *                   governs travel; it never governs a beat alignment.
+ *   G-DOCK-BAND     `rungs.rise`'s docstring declares the band it governs, both ends.
+ *   G-GUARD         ONE settle-guard constant, read by both FLIP engines.
+ *
+ * The ADMITTED ledger is closed BOTH ways (the `check-copy-register.mjs` shape): a row
+ * nothing consumes reds the gate, so an admission cannot outlive its reason. Rows are
+ * CONTENT ANCHORED — `file :: literal :: a nearby stable string` — because line cites
+ * rotted four times inside one pass.
+ *
+ * Run:  node scripts/check-motion-bands.mjs             (verdict)
+ *       node scripts/check-motion-bands.mjs --list      (every offending position)
+ *       node scripts/check-motion-bands.mjs --inventory (the ground table, JSON)
+ *       node scripts/check-motion-bands.mjs --bank      (write the B6 ratchet bank)
+ *       node scripts/check-motion-bands.mjs --self-test (each check shown able to fail)
+ */
+import {
+  readFileSync,
+  readdirSync,
+  statSync,
+  existsSync,
+  writeFileSync,
+} from "node:fs";
+import { execFileSync } from "node:child_process";
+import { join, resolve, relative, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import process from "node:process";
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const ROOT = resolve(process.env.ROOT ?? join(HERE, ".."));
+const SRC = join(ROOT, "src");
+const CONFIG = join(SRC, "pencil/config/pencilConfig.ts");
+const THEME = join(SRC, "assets/index.css");
+const MAIN = join(SRC, "main.ts");
+const BANK = join(HERE, "motion-bank.json");
+/** The dock audition's MEASURED series — the per-frame readings G-DOCK-BAND checks the
+ *  rung's declared band against. Written by `e2e/motion-dock-audition.spec.ts`, never by
+ *  hand: a band a gate reads out of the prose it is meant to test is a spec citing itself
+ *  (pass-3 critique §2.3). */
+const SERIES = join(HERE, "motion-dock-series.json");
+/** The wave's base commit — the git fallback when the bank is unreadable. */
+const BASE_REF = process.env.BASE_REF ?? "74a2b5d9";
+
+/** A ladder is short or it is a list. */
+const LADDER_MAX = 8;
+/** The duration constants that are NOT rungs, each exempt by its own cite. */
+const EXEMPT_KEYS = {
+  beatMs:
+    "the boil beat — a raster-swap cadence, never painted as a gesture (R6 law 7)",
+  settleGuardMs:
+    "the FLIP engines' never-never backstop — a timeout, never a length on screen (§1.6)",
+};
+/** Numeric TS members outside MOTION that are an admitted GRADED SET, not stray lengths. */
+const ADMITTED_TS = {
+  DRAW_IN_PRESETS:
+    "GRADED — the draw-in tuple (duration/stagger/jitter/baseDelay) IS the design; a rung would erase the grade",
+  WASH: "GRADED — §12's join-wash furniture, fifteen constants tuned against each other (§1.9); the ladder NAMES it and does not re-home it",
+  GLYPH_ANIM: "GRADED — the handwriting's own grade",
+  CELEBRATION: "CHARACTER — the crest, auditioned whole",
