+  const bad = [];
+  for (const p of PINNED) {
+    const f = join(ROOT, p.file);
+    const t = existsSync(f) ? readFileSync(f, "utf8") : "";
+    if (!t) {
+      bad.push(`${p.file} is missing — a PINNED site cannot carry its cite.`);
+      continue;
+    }
+    if (!p.cite.test(t))
