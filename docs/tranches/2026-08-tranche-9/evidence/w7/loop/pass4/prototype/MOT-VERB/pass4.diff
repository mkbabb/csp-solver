+  const bad = [];
+  const drawer = join(SRC, "games/shared/useControlsDrawer.ts");
+  const t = existsSync(drawer) ? readFileSync(drawer, "utf8") : "";
+  const m =
+    /mobileDock[^\n]*MOTION\.rungs\.([A-Za-z]+)|rungs\.([A-Za-z]+)\s*:\s*MOTION\.rungs|dock\s*\?\s*spend\(\s*"[a-zA-Z]+"\s*,\s*"([A-Za-z]+)"/.exec(
+      t,
+    );
