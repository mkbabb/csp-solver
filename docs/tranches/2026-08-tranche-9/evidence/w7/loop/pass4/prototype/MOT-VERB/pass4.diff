+                (verb.fill === "none" ? " (a `none` verb writes no fill keyword)" : ""),
+            );
+            tags.push("fill");
+          }
+        }
+        // RULE 5b — direction.
+        const dir = kf ? kf.dir : selectorDirection(selector);
+        if (dir === "leave" && ARRIVING_VERBS.has(verbName)) {
+          why.push(
+            `this is a LEAVE and ${verbName} arrives; a hand taking something off the page is LIFT or RUB OUT`,
+          );
+          tags.push("direction");
+        }
+        if (dir === "arrival" && LEAVING_VERBS.has(verbName)) {
+          why.push(
+            `this is an ARRIVAL and ${verbName} leaves; something coming to the page is LAY DOWN or WRITE IN`,
+          );
+          tags.push("direction");
+        }
+      }
+      if (!why.length) continue;
+      // RULE 6, THE HONEST LEDGER (pass 3). An admission covers THE RULES ITS RULING NAMES and
+      // no others. Pass 2's two-field row let one sentence excuse every offence the site would
+      // ever raise — 21 of 36 rows were tripping two or more rules under a ruling that argued
+      // one — so a second defect could land on an admitted line and never be seen. The third
+      // field is that ruling's SCOPE, and an offence outside it still reds.
+      const raised = [...new Set(tags)];
+      admittedTags.set(key, raised);
+      if (ADMITTED.has(key)) {
+        const [, ruling, rules = []] = ADMITTED.get(key);
+        const outside = raised.filter((t) => !rules.includes(t));
+        if (!outside.length) continue;
+        for (const t of outside) counts[t]++;
+        launderers.push({
+          at,
+          key,
+          why: `the ruling covers ${rules.join(", ") || "nothing"} — "${ruling}" — but this line also breaks ${outside.join(", ")}. Widen the ruling or fix the line.`,
+          body: body.slice(0, 76),
+        });
+        continue;
+      }
+      // The by-rule tally counts what is UNADMITTED: an admitted row is outside the law by a
+      // ruling, and counting it again as a red would read the ledger as a debt.
+      for (const t of raised) counts[t]++;
+      for (const t of tags) if (t === "fence") counts.fenceTerms++;
+      rows.push({ at, key, why: why.join("; "), body: body.slice(0, 76) });
+    }
+  }
+
+  // RULE 7 — the movers, and THE DOOR. An options object may not type a duration or quote a
+  // curve; it spends, spreads a spend, or passes one through. And every `spend(verb, rung)`
+  // spends a rung that verb is allowed to spend.
+  //
+  // THE WALK IS NOT `.ts`-ONLY (pass 3). Pass 2 read `/\.ts$/`, and `App.vue:380` — one of the
+  // three spends in the tree, the product's one page going over — was invisible to the gate
+  // for the whole pass. A `<script>` block is code wherever it is written, so a .vue file is
+  // read with everything outside its script blanked, which keeps every line number true.
+  const movers = [];
+  const spends = [];
+  const scriptText = (file) => {
+    const raw = raws.get(file) ?? readFileSync(file, "utf8");
+    if (file.endsWith(".ts")) return strip(raw);
+    let out = raw.replace(/[^\n]/g, " ");
+    for (const m of raw.matchAll(/<script[^>]*>([\s\S]*?)<\/script>/g)) {
+      const at = m.index + m[0].indexOf(m[1]);
+      out = out.slice(0, at) + m[1] + out.slice(at + m[1].length);
+    }
+    return strip(out);
+  };
+  for (const file of walk(src, /\.(ts|vue)$/)) {
+    if (/\.(test|spec)\.ts$/.test(file)) continue; // a unit test's illegal spend is its fixture
+    let t = scriptText(file);
+    if (sabotage) t = sabotage(relative(src, file), t);
+    // THE DOOR, read as an argument list. The TYPE narrows it too (`spend<V>(verb, rung)` takes
+    // the verb's own rungs), but a type is checked where TypeScript runs and this gate is what
+    // CI runs on the estate's stylesheets: the same law, said twice, is the point.
+    for (const m of t.matchAll(/\bspend\(\s*"([A-Za-z]+)"\s*,\s*"([A-Za-z]+)"\s*\)/g)) {
+      const [, verbName, rung] = m;
+      const line = t.slice(0, m.index).split("\n").length;
+      const verb = VERB.get(verbName);
+      const at = `${relative(src, file)}:${line}`;
+      if (!verb) spends.push({ at, why: `there is no verb called ${verbName}.` });
+      else if (!verb.rungs.includes(rung))
+        spends.push({
+          at,
+          why: `spends ${verbName} at ${rung}. ${verbName} may spend ${verb.rungs.join(", ") || "no rung at all"}.`,
+        });
+    }
+    for (const m of t.matchAll(/\.animate\(/g)) {
+      let depth = 0;
+      let end = m.index;
+      for (let i = m.index + m[0].length - 1; i < t.length; i++) {
+        if (t[i] === "(") depth++;
+        else if (t[i] === ")" && --depth === 0) {
+          end = i;
+          break;
+        }
+      }
+      const args = t.slice(m.index + m[0].length, end);
+      // The options half is the last argument that is an object; a trailing comma leaves an
+      // empty tail behind it, which is not an argument.
+      const last =
+        terms(args)
+          .map((a) => a.trim())
+          .filter(Boolean)
+          .pop() ?? "";
+      const line = t.slice(0, m.index).split("\n").length;
+      const bad = [];
+      if (/duration\s*:\s*\d/.test(last))
+        bad.push("a duration is typed here; spend a rung");
+      if (/easing\s*:\s*["'`]/.test(last))
+        bad.push("a curve is quoted here; spend a verb");
+      movers.push({ at: `${relative(src, file)}:${line}`, bad });
+    }
+  }
+  const moverReds = movers.filter((m) => m.bad.length);
+  const spendReds = spends;
+
+  // RULE 8 — the toggle's beat table, beside the gesture, as data.
+  const beats = beatTable(texts, raws, src, new Map(readSource().rungs));
+
+  const stale = [...ADMITTED.keys()].filter((k) => !seen.has(k));
+  const collisions = [...textKeys.values()].filter((n) => n > 1).length;
+  return {
+    rows,
+    launderers,
+    admittedTags,
+    stale,
+    counts,
+    movers,
+    moverReds,
+    spendReds,
+    beats,
+    collisions,
+    seen,
+  };
+}
+
+/** RULE 8. The table is data in `DarkModeToggle.vue` (`@toggle-beats`), and every beat it
+ *  names must read back off the rule it names. A comment that contradicts its own
+ *  declaration is the defect this catches — on the one surface where it matters most. */
+function beatTable(texts, raws, src, rungs = new Map()) {
+  const file = [...texts.keys()].find((f) => f.endsWith("DarkModeToggle.vue"));
+  if (!file)
+    return { ok: false, rows: [{ beat: "—", why: "DarkModeToggle.vue is not here" }] };
+  const raw = raws.get(file);
+  const m = /@toggle-beats\s*(\{[\s\S]*?\})\s*\*\//.exec(raw);
+  if (!m)
+    return {
+      ok: false,
+      rows: [
+        {
+          beat: "—",
+          why: "the gesture carries no beat table. Write it beside the gesture.",
+        },
+      ],
+    };
+  let table;
+  try {
+    table = JSON.parse(m[1]);
+  } catch (e) {
+    return {
+      ok: false,
+      rows: [
+        { beat: "—", why: `the beat table is not readable: ${String(e.message)}` },
+      ],
+    };
+  }
+  const text = texts.get(file);
+  const bad = [];
+  const claimed = []; // the character span of every rule a beat names, for the other direction
+  for (const [beat, want] of Object.entries(table)) {
+    // A selector LIST is one rule written over several lines, which is the estate's idiom:
+    // the table names one member and the rule is whatever that member opens.
+    const at = [`\n${want.selector} {`, `\n${want.selector},`]
+      .map((s) => text.indexOf(s))
+      .find((n) => n >= 0);
+    if (at === undefined) {
+      bad.push({
+        beat,
+        why: `the table names ${want.selector}, which is not a rule here`,
+      });
+      continue;
+    }
+    const open = text.indexOf("{", at);
+    const shut = text.indexOf("}", open);
+    claimed.push([open, shut]);
+    const body = text.slice(open, shut);
+    const decl =
+      new RegExp(`transition(?:-delay)?\\s*:\\s*([^;]+);`).exec(body)?.[1] ?? "";
+    const term =
+      terms(decl.replace(/\s+/g, " ")).find((t) => t.includes(want.property)) ?? decl;
+    const times = [...term.matchAll(TIME)].map((t) => {
+      const s = String(t[0]);
+      const rung = /var\(--motion-([a-z]+)/.exec(s);
+      if (rung) return rungs.get(rung[1]) ?? -1;
+      return Number(s.replace(/[^\d.]/g, ""));
+    });
+    const dur = want.delayOnly ? 0 : (times[0] ?? -1);
+    const delay = want.delayOnly ? (times[0] ?? -1) : (times[1] ?? 0);
+    if (dur !== want.duration || delay !== want.delay)
+      bad.push({
+        beat,
+        why: `${want.selector} runs ${dur}ms at ${delay}ms; the beat table says ${want.duration}ms at ${want.delay}ms. Fix the declaration or the table, in the same change.`,
+      });
+  }
+  // THE OTHER DIRECTION (pass 3). Pass 2 read the table and never read the SURFACE, so a beat
+  // could be deleted from the character and the ledger would still pass — the record verifying
+  // the record. The predicate is satisfiable and it is the character's own signature: every
+  // `transition`/`transition-delay` in this file's <style> that carries `!important` outside
+  // `@media (prefers-reduced-motion)` is a beat of the gesture and must be named by the table.
+  // PER DECLARATION, said out loud: the 8 declarations carry 10 property terms, and `tuck`'s
+  // opacity and `star1`'s opacity ride their declaration's beat. Per-TERM completeness would be
+  // born RED at 2 on the surface the owner audited most, which is a U-10 question and not a
+  // thing to ship red.
+  const reduce = [];
+  for (const m of text.matchAll(/@media[^{]*prefers-reduced-motion[^{]*\{/g)) {
+    let depth = 0;
+    for (let i = m.index + m[0].length - 1; i < text.length; i++) {
+      if (text[i] === "{") depth++;
+      else if (text[i] === "}" && --depth === 0) {
+        reduce.push([m.index, i]);
+        break;
+      }
+    }
+  }
+  const unnamed = [];
+  let beatsOnSurface = 0;
+  for (const m of text.matchAll(/transition(?:-delay)?\s*:\s*([^;}]+)[;}]/g)) {
+    if (!/!important/.test(m[1])) continue;
+    if (reduce.some(([a, b]) => m.index > a && m.index < b)) continue;
+    beatsOnSurface++;
+    if (claimed.some(([a, b]) => m.index > a && m.index < b)) continue;
+    const line = text.slice(0, m.index).split("\n").length;
+    const t = [...String(m[1]).matchAll(TIME)].map((x) => String(x[0]));
+    unnamed.push({
+      beat: `${relative(src, file)}:${line}`,
+      why: `has a transition of ${t.join(" then ") || "its own"} that no beat in the table names. Add the beat or remove the declaration, in the same change.`,
+    });
+  }
+  bad.push(...unnamed);
+  return {
+    ok: bad.length === 0,
+    rows: bad,
+    size: Object.keys(table).length,
+    onSurface: beatsOnSurface,
+  };
+}
+
+/** The duplicate-pair row: two published curve tokens may share points only where declared. */
+function duplicatePairs(
+  css = readFileSync(join(ROOT, "src/assets/index.css"), "utf8"),
+) {
+  const tokens = [
+    ...css.matchAll(/^\s*(--(?:ease|verb)-[A-Za-z-]+):\s*(cubic-bezier\([^)]*\));/gm),
+  ].map((m) => [m[1], m[2]]);
+  const undeclared = [];
+  for (let i = 0; i < tokens.length; i++)
+    for (let j = i + 1; j < tokens.length; j++)
+      if (
+        tokens[i][1] === tokens[j][1] &&
+        !DECLARED_DUPLICATES.has(`${tokens[i][0]}=${tokens[j][0]}`)
+      )
+        undeclared.push(
+          `${tokens[i][0]} and ${tokens[j][0]} are the same curve, undeclared`,
+        );
+  return undeclared;
+}
+
+// ── THE SELF-TEST ─────────────────────────────────────────────────────────────────────
+// Negative controls, run against the real tree with one line moved: a gate nobody has seen
+// fail is a gate nobody has seen.
+function selfTest() {
+  const control = (name, sabotage, expect) => {
+    const r = run({ sabotage });
+    const caught = expect(r);
+    console.log(`  ${caught ? "RED as it must be" : "MISSED"} — ${name}`);
+    return caught;
+  };
+  let ok = true;
+  ok &= control(
+    "A: a legacy --ease-* token on a transition, the rung kept",
+    (f, t) =>
+      f === "games/shared/scene.css"
+        ? t.replace("var(--verb-lift-ease)", "var(--ease-accelIn)")
+        : t,
+    (r) => r.counts.curve > 0,
+  );
+  ok &= control(
+    "B: an erase curve on the note's arrival",
+    (f, t) =>
+      f === "pencil/chrome/MarginNote.vue"
+        ? t.replace(
+            /ink-write-in ([^;]*?)var\(--verb-writeIn-ease\)/,
+            "ink-write-in $1var(--verb-rubOut-ease)",
+          )
+        : t,
+    (r) => r.counts.props > 0 || r.counts.direction > 0,
+  );
+  ok &= control(
+    "rule 9 THE FILL ARM: a `none` verb handed a fill keyword",
+    (f, t) =>
+      f === "games/shared/SolverErrorNote.vue"
+        ? t.replace(
+            "note-in var(--motion-note) var(--verb-layDown-ease)",
+            "note-in var(--motion-note) var(--verb-layDown-ease) forwards",
+          )
+        : t,
+    (r) => r.counts.fill > 0,
+  );
+  ok &= control(
+    "rule 9 the OTHER way: a `backwards` verb stripped of its arm",
+    (f, t) =>
+      f === "pencil/chrome/MarginNote.vue"
+        ? t.replace("var(--verb-writeIn-ease) backwards", "var(--verb-writeIn-ease)")
+        : t,
+    (r) => r.counts.fill > 0,
+  );
+  ok &= control(
+    "the delay fence: a delay respelled as a rung",
+    // RE-AIMED at the fold: prettier WRAPS this declaration, so the control matches the term
+    // across the wrap instead of one printed line (the literal it keyed on no longer exists —
+    // a control keyed on a formatter's output is a control that dies on `--write`).
+    (f, t) =>
+      f === "games/shared/scene.css"
+        ? t.replace(
+            /var\(--verb-writeIn-ease\)(\s+)150ms/,
+            "var(--verb-writeIn-ease)$1var(--motion-whisper)",
+          )
+        : t,
+    (r) => r.counts.fence > 0,
+  );
+  ok &= control(
+    "rule 7: a mover types its own duration",
+    (f, t) =>
+      f === "pencil/chrome/GameGallery/useCarouselGlide.ts"
+        ? t.replace("...GLIDE,", "duration: 300,")
+        : t,
+    (r) => r.moverReds.length > 0,
+  );
+  ok &= control(
+    "rule 7/THE DOOR: an illegal spend, in a .vue script the pass-2 walk never read",
+    (f, t) =>
+      f === "App.vue"
+        ? t.replace('spend("turn", "throw")', 'spend("turn", "whisper")')
+        : t,
+    (r) => r.spendReds.some((x) => x.at.startsWith("App.vue")),
+  );
+  ok &= control(
+    "1\u2032/5b with no shape carve-out: a bound animation that names no verb",
+    (f, t) =>
+      f === "assets/index.css"
+        ? `${t}\n.probe-escape { animation: ink-write-in var(--motion-note) linear backwards; }\n`
+        : t,
+    (r) => r.rows.some((x) => x.at.startsWith("assets/index.css")),
+  );
+  ok &= control(
+    "rule 6: a SECOND offence planted on an admitted row, its declaration untouched",
+    (f, t) =>
+      f === "pencil/sheet/AnswerKeyLaminate.vue"
+        ? t.replace(
+            ".answer-key-laminate.is-shown {",
+            ".answer-key-laminate.is-leaving {",
+          )
+        : t,
+    (r) =>
+      r.launderers.some((x) => x.at.startsWith("pencil/sheet/AnswerKeyLaminate.vue")),
+  );
+  ok &= control(
+    "rule 8 the OTHER way: star3 deleted from the table, its declaration left on the surface",
+    (f, t) =>
+      f === "pencil/celestial/DarkModeToggle.vue"
+        ? t.replace(/,\n\s*"star3":\s*\{[^}]*\}/, "")
+        : t,
+    (r) =>
+      !r.beats.ok &&
+      (r.beats.rows ?? []).some((b) => /no beat in the table names/.test(b.why)),
+  );
+  ok &= control(
+    "rule 8: a beat moves and the table does not",
+    (f, t) =>
+      f === "pencil/celestial/DarkModeToggle.vue"
+        ? t.replace(
+            "transform 340ms var(--ease-accelIn)",
+            "transform 250ms var(--ease-accelIn)",
+          )
+        : t,
+    (r) => !r.beats.ok,
+  );
+  // The publisher's own control: a comment inside the marker pair must still publish.
+  const cfg = readFileSync(join(ROOT, "src/pencil/config/pencilConfig.ts"), "utf8");
+  // RE-AIMED at the fold (pass 4): the ladder is MOT-LADDER's `MOTION.rungs` literal now, not
+  // this family's grafted `const RUNGS`, and it carries SEVEN rungs (`rise` is the dock's seam).
+  // The control is the same control — prose inside the tuple must not stop the publisher.
+  const commented = cfg.replace(
+    /(\n {2}rungs: \{\n)/,
+    "$1    /* a reader's note, inserted mid-tuple */\n",
+  );
+  let parsed;
+  try {
+    const s = readSource(commented);
+    parsed = s.rungs.length === 7 && s.verbs.length === 7;
+  } catch {
+    parsed = false;
+  }
+  console.log(
+    `  ${parsed ? "still publishes" : "THREW"} — a comment inserted inside RUNGS`,
+  );
+  ok &= parsed;
+  // And the duplicate row: plant a fifth pair and watch it red.
+  const css = readFileSync(join(ROOT, "src/assets/index.css"), "utf8");
+  const clean = duplicatePairs(css).length === 0;
+  const plantedRed =
+    duplicatePairs(
+      css.replace(
+        "  --ease-standard:",
+        "  --ease-planted: cubic-bezier(0.32, 0.72, 0, 1);\n  --ease-standard:",
+      ),
+    ).length > 0;
+  console.log(`  ${clean ? "clean" : "ALREADY DIRTY"} — the declared duplicate pairs`);
+  console.log(
+    `  ${plantedRed ? "RED as it must be" : "MISSED"} — a fifth name for the glass curve, planted`,
+  );
+  ok &= clean && plantedRed;
+  return Boolean(ok);
+}
+
+// ── THE RUN ───────────────────────────────────────────────────────────────────────
+// THE SELF-TEST FALLS THROUGH (pass 3). Pass 2 exited on the controls, so the eight of them
+// have never run in the same invocation as the census and CI has never seen both. The estate's
+// idiom is check-motion-contract.mjs's: run the controls, then run the law.
+let selfTestRed = 0;
+if (process.argv.includes("--self-test")) {
+  console.log("the gate's own negative controls:");
+  selfTestRed = selfTest() ? 0 : 1;
+  console.log(selfTestRed ? "the controls: RED" : "the controls: every one fires");
+  console.log("");
+}
+
+const r = run();
+const dupes = duplicatePairs();
+
+if (process.argv.includes("--why")) {
+  console.log("what each admitted row actually breaks:");
+  for (const [key, tags] of r.admittedTags)
+    if (ADMITTED.has(key))
+      console.log(
+        `  ${String(tags.length).padStart(2)}  ${tags.join(", ").padEnd(24)} ${key}`,
+      );
+  const many = [...r.admittedTags].filter(
+    ([k, t]) => ADMITTED.has(k) && t.length > 1,
+  ).length;
+  console.log(
+    `rows raising two or more rules under one ruling: ${many} of ${ADMITTED.size}`,
+  );
+}
+
+console.log(
+  `declarations that name neither a verb nor a rung: ${r.rows.length}  (budget 0)`,
+);
+console.log(
+  `  by rule — curve ${r.counts.curve} · rung ${r.counts.rung} · the fence ${r.counts.fence} declarations / ${r.counts.fenceTerms} terms · the set ${r.counts.set} · what it moves ${r.counts.props} · direction ${r.counts.direction} · the fill arm ${r.counts.fill}`,
+);
+console.log(
+  `admissions in the ledger: ${ADMITTED.size}, stale ${r.stale.length}, laundering ${r.launderers.length}`,
+);
+const kinds = {};
+for (const [, [kind]] of ADMITTED) kinds[kind] = (kinds[kind] ?? 0) + 1;
+console.log(
+  `  by kind — ${Object.entries(kinds)
+    .map(([k, n]) => `${k} ${n}`)
+    .join(" · ")}`,
+);
+console.log(
+  `declarations written twice in one file (the ordinal keeps them apart): ${r.collisions}`,
+);
+console.log(
+  `movers that spend: ${r.movers.length - r.moverReds.length} of ${r.movers.length}`,
+);
+console.log(
+  `spends that are in their verb's set: ${r.spendReds.length === 0 ? "all" : `RED ${r.spendReds.length}`}`,
+);
+console.log(
+  `the toggle's beat table: ${r.beats.ok ? `${r.beats.size} beats, ${r.beats.onSurface} declarations on the surface, each named by the other` : "RED"}`,
+);
+console.log(`undeclared duplicate curve tokens: ${dupes.length}`);
+
+for (const row of r.rows)
+  console.log(`  · src/${row.at.padEnd(52)} ${row.why}\n      ${row.body}`);
+for (const row of r.launderers)
+  console.log(`  · src/${row.at.padEnd(52)} ${row.why}\n      ${row.body}`);
+for (const k of r.stale)
+  console.log(
+    `  · the ledger admits ${k}, which is not there any more. Read it again.`,
+  );
+for (const m of r.moverReds)
+  console.log(`  · src/${m.at.padEnd(52)} ${m.bad.join("; ")}`);
+for (const m of r.spendReds) console.log(`  · src/${m.at.padEnd(52)} ${m.why}`);
+for (const b of r.beats.rows ?? []) console.log(`  · the toggle's ${b.beat}: ${b.why}`);
+for (const d of dupes) console.log(`  · ${d}`);
+
+let publisher = 0;
+try {
+  console.log(
+    execFileSync("node", [join(HERE, "publish-verbs.mjs"), "--check"], {
+      encoding: "utf8",
+    }).trim(),
+  );
+} catch (e) {
+  publisher = 1;
+  console.log(String(e.stdout ?? "").trim());
+}
+
+const bad =
+  r.rows.length ||
+  r.launderers.length ||
+  r.stale.length ||
+  r.moverReds.length ||
+  r.spendReds.length ||
+  !r.beats.ok ||
+  dupes.length ||
+  publisher ||
+  selfTestRed;
