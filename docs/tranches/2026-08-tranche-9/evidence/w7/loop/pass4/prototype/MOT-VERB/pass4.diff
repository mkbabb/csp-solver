+/**
+ * B9 — THE DELAY FENCE (MOT-VERB's rule, adopted section wide). The ladder governs
+ * TRAVEL. A delay is a beat alignment against another gesture's clock, and a shared rung
+ * would make one retune move two unrelated things.
+ */
+function b9DelayFence(decls) {
+  const bad = [];
+  for (const d of decls)
+    for (const q of d.pos)
+      if ((q.role === "delay" || q.role === "extra") && q.kind === "rung")
