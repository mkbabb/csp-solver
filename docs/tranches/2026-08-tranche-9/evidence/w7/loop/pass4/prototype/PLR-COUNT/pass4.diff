+++ b/web/frontend/e2e/player-mark.spec.ts
@@ -0,0 +1,379 @@
+/**
+ * THE HEAD'S PLAYER MARK (T9-W7 §11 · §12 · M14) — the mark, its sheet, and the four laws that
+ * are easy to lose.
+ *
+ * PRM: live, because every row here reads a SETTLED pose, never a frame inside a beat — the
+ * mark's one beat is a 400ms `color` transition and the sheet's is a 150ms fade, and each row
+ * that touches either settles past its window before it reads. The reduced arm is not this
+ * file's: `join-language-prm.spec.ts` reads this mark's transition under `reducedMotion: reduce`.
+ *
+ * O-12: LOCAL. CI is sixteen browserless lanes; this is an instrument, run by hand and by the
+ * wave's own battery, never by a runner.
+ *
+ *   1  your own mark is the colour the room paints you, and graphite when nobody else is here
+ *      (PLR-COUNT seat: the labels count everyone, `1 player` / `2 players` / `9 players`)
+ *   2  a mouse press opens the sheet without taking focus or telling the room you looked away
+ *   3  Space and Enter each toggle once; Escape shuts it; focus never leaves the mark
+ *   4  the sheet never scrolls and never outgrows its viewport's row budget
+ */
+import { test, expect, type BrowserContext, type Page } from '@playwright/test';
+
+const SOLO = './?size=3&difficulty=EASY&wire=local';
+
+async function settled(page: Page) {
+  await page.waitForSelector('svg.handwritten-logo', { timeout: 60000 });
+  await expect
+    .poll(() => page.locator('.sudoku-cell .glyph-svg').count(), { timeout: 60000 })
+    .toBeGreaterThan(0);
+}
+
+async function invite(page: Page): Promise<string> {
+  const verb = page.locator(
+    '.controls-card button[aria-label="Play together on this board"]',
+  );
+  await expect(verb).toBeEnabled();
+  if (!(await verb.isVisible())) {
+    await page.locator('.drawer-tab').first().click();
+    await page.waitForTimeout(700); // the dock SLIDES — settle the pose
+  }
+  await verb.click();
+  // The URL is stamped before the wire is listening; self's own row is the proof it is up.
+  await expect.poll(() => page.locator('.players-roster .player-row').count()).toBe(1);
+  return page.url();
+}
+
+const mark = (page: Page) => page.locator('[data-player-mark]:visible');
+const lobby = (page: Page) => page.locator('[data-lobby]:visible');
+
+test('the mark rests graphite alone and takes the room ink the moment somebody else is here', async ({
+  browser,
+}) => {
+  const ctx: BrowserContext = await browser.newContext();
+  const a = await ctx.newPage();
+  await a.goto(SOLO);
+  await settled(a);
+
+  const alone = await mark(a).evaluate((el) => ({
+    live: el.classList.contains('is-live'),
+    label: el.getAttribute('aria-label'),
+    color: getComputedStyle(el).color,
+  }));
+  expect(alone.live).toBe(false);
+  // PLR-COUNT's one base (re-aimed, declared): the name counts everyone at this board.
+  expect(alone.label).toBe('1 player');
+
+  const link = await invite(a);
+  const b = await ctx.newPage();
+  await b.goto(link);
+  await settled(b);
+  await a.bringToFront();
+  await expect.poll(() => a.locator('.players-roster .player-row').count()).toBe(2);
+  await a.waitForTimeout(700); // past the 400ms presence ink
+
+  const live = await mark(a).evaluate((el) => ({
+    live: el.classList.contains('is-live'),
+    label: el.getAttribute('aria-label'),
+    color: getComputedStyle(el).color,
+  }));
+  expect(live.live).toBe(true);
+  expect(live.label).toBe('2 players');
+  expect(live.color).not.toBe(alone.color);
+
+  // AND IT IS THE COLOUR THE ROOM PAINTS YOU (F1). What B draws for A is what A draws for A.
+  const aSlug = await a.evaluate(
+    () =>
+      document
+        .querySelector('.players-roster .player-row:has(.player-self) .player-name')
+        ?.textContent?.trim() ?? '',
+  );
+  const theirs = await b.evaluate((slug) => {
+    const li = [...document.querySelectorAll('.players-roster .player-row')].find(
+      (e) => e.querySelector('.player-name')?.textContent?.trim() === slug,
+    );
+    return li ? getComputedStyle(li.querySelector('.player-swatch')!).backgroundColor : '';
+  }, aSlug);
+  expect(theirs).toBe(live.color);
+  await ctx.close();
+});
+
+test('a mouse press opens the sheet, keeps the cell focused, and tells the room nothing', async ({
+  page,
+}) => {
+  await page.goto(SOLO);
+  await settled(page);
+  await invite(page);
+
+  await page.evaluate(() => {
+    const room = new URL(location.href).searchParams.get('s')!;
+    const w = window as unknown as Record<string, unknown>;
+    const seen: unknown[] = [];
+    w.__frames = seen;
+    const ch = new BroadcastChannel(`board:${room}`);
+    ch.onmessage = (e: MessageEvent) => seen.push(e.data);
+  });
+
+  await page.locator('.sudoku-cell input').first().click();
+  await page.waitForTimeout(400);
+  await page.evaluate(() => ((window as any).__frames as unknown[]).splice(0));
+
+  await mark(page).click();
+  await page.waitForTimeout(500);
+  const after = await page.evaluate(() => ({
+    cur: ((window as any).__frames as { kind?: string }[]).filter((f) => f?.kind === 'cur')
+      .length,
+    inCell: !!(document.activeElement as HTMLElement | null)?.closest('.sudoku-cell'),
+  }));
+  await expect(lobby(page)).toBeVisible();
+  // Opening your own roster is not looking away from the board — the board is still under it.
+  expect(after.cur).toBe(0);
+  expect(after.inCell).toBe(true);
+});
+
+test('Space and Enter each toggle once, Escape shuts it, and focus never leaves the mark', async ({
+  page,
+}) => {
+  await page.goto(SOLO);
+  await settled(page);
+  await invite(page);
+  const m = mark(page);
+  await m.evaluate((el: HTMLElement) => el.focus());
+
+  const state = async () => {
+    await page.waitForTimeout(220);
+    return m.evaluate((el) => ({
+      expanded: el.getAttribute('aria-expanded'),
+      focused: el === document.activeElement,
+    }));
+  };
+  expect(await state()).toEqual({ expanded: 'false', focused: true });
+  await page.keyboard.press('Space');
+  expect(await state()).toEqual({ expanded: 'true', focused: true });
+  await page.keyboard.press('Space');
+  expect(await state()).toEqual({ expanded: 'false', focused: true });
+  // ONE activation, not two: `@keydown.enter` beside a native button was a double-toggle that
+  // netted zero (CH-70). The handler is gone; the button's own activation is the contract.
+  await page.keyboard.press('Enter');
+  expect(await state()).toEqual({ expanded: 'true', focused: true });
+  await page.keyboard.press('Escape');
+  expect(await state()).toEqual({ expanded: 'false', focused: true });
+});
+
+test('the sheet never scrolls, and it compresses rather than outgrow its budget', async ({
+  page,
+}) => {
+  await page.setViewportSize({ width: 1280, height: 800 });
+  await page.goto(SOLO);
+  await settled(page);
+  await invite(page);
+  await page.evaluate(() => {
+    const room = new URL(location.href).searchParams.get('s')!;
+    const ch = new BroadcastChannel(`board:${room}`);
+    for (let i = 0; i < 8; i++)
+      ch.postMessage({ kind: 'hi', data: {}, from: `mark-spec-${i}` });
+    setTimeout(() => ch.close(), 0);
+  });
+  await expect.poll(() => page.locator('.players-roster .player-row').count()).toBe(9);
+
+  await mark(page).click();
+  await page.waitForTimeout(320); // the sheet SLIDES
+  const sheet = await lobby(page).evaluate((el) => ({
+    rows: el.querySelectorAll('.pl-row').length,
+    more: el.querySelector('.pl-more')?.textContent?.trim() ?? '',
+    state: el.querySelector('.pl-state')?.textContent?.trim() ?? '',
+    scrolls: el.scrollHeight !== el.clientHeight,
+    width: +el.getBoundingClientRect().width.toFixed(1),
+  }));
+  // ONE population (PLR-COUNT, re-aimed): the state line, the rows and `and N more` all count
+  // everyone at this board, you first.
+  expect(sheet.state).toBe('9 players');
+  expect(sheet.rows).toBe(4);
+  expect(sheet.more).toBe('and 5 more');
+  expect(sheet.scrolls).toBe(false);
+  expect(sheet.width).toBe(256);
+});
+
+/**
+ * G18 — `--head-rule` IS REGISTERED, AND ITS ABSENCE IS VISIBLE (pass-4 gap 2).
+ *
+ * Pass 3 asserted the registration and called that a born-RED. It was not: with
+ * `initial-value: 12px` an unpublished token and a published one paint the same pixel, so the
+ * row passed with or without a publisher and the `env(safe-area-inset-top)` term could vanish
+ * unseen (PLR-SELF C4, both engines). The registration now carries `0px`, which is
+ * computationally independent AND fails where a reader can see it: strike the publisher and
+ * both head marks sit hard against the viewport's top edge.
+ *
+ * The negative control is in this same run, and it is the pass-3 form: a planted token
+ * registered at `12px` with the identical publisher, struck the identical way, which does not
+ * move. One run, two ablations, one of them proving the other can fail.
+ */
+test('the head rule is a registered length whose publisher can be struck visibly', async ({
+  page,
+}) => {
+  await page.setViewportSize({ width: 1280, height: 800 });
+  await page.goto(SOLO);
+  await settled(page);
+
+  const read = () =>
+    page.evaluate(() => {
+      const root = document.querySelector('.page-root')!;
+      const corner = document.querySelector('.corner-left') as HTMLElement;
+      const probe = document.getElementById('plr-self-probe') as HTMLElement;
+      return {
+        token: getComputedStyle(root).getPropertyValue('--head-rule').trim(),
+        cornerTop: +corner.getBoundingClientRect().top.toFixed(2),
+        probeTop: +getComputedStyle(probe).top.replace('px', ''),
+      };
+    });
+
+  // The pass-3 form, planted: same syntax, same publisher, `initial-value: 12px`.
+  await page.evaluate(() => {
+    const el = document.createElement('div');
+    el.id = 'plr-self-probe';
+    document.querySelector('.page-root')!.append(el);
+    const sheet = document.createElement('style');
+    sheet.id = 'plr-self-probe-style';
+    sheet.textContent = `
+      @property --plr-probe-rule { syntax: "<length>"; inherits: true; initial-value: 12px; }
+      .page-root { --plr-probe-rule: calc(0.75rem + 0px); }
+      #plr-self-probe { position: fixed; left: 0; top: var(--plr-probe-rule); }`;
+    document.head.append(sheet);
+  });
+
+  const before = await read();
+  expect(before.token).toBe('12px');
+  expect(before.cornerTop).toBe(12);
+  expect(before.probeTop).toBe(12);
+
+  // "The publisher never shipped" — the declaration struck, the registration intact.
+  //
+  // THE STRIKE IS INLINE, and that is not fussiness. App.vue publishes `--head-rule` from a
+  // SCOPED block, so the rule Vue emits is `.page-root[data-v-…]` at (0,2,0); an injected
+  // `.page-root { … }` at (0,1,0) loses the cascade and strikes nothing. This probe's first run
+  // read `12px` after the strike on both engines and looked exactly like the defect it is
+  // written to catch — a gate that cannot fail and a gate whose ablation does not land read the
+  // same from the outside, which is the whole lesson of C4.
+  await page.evaluate(() => {
+    const root = document.querySelector('.page-root') as HTMLElement;
+    root.style.setProperty('--head-rule', 'initial');
+    root.style.setProperty('--plr-probe-rule', 'initial');
+  });
+  const after = await read();
+
+  // THE ROW: the head goes to the edge, and a reader sees it.
+  expect(after.token).toBe('0px');
+  expect(after.cornerTop).toBe(0);
+  // THE NEGATIVE CONTROL: the pass-3 registration is indistinguishable from its own publisher.
+  expect(after.probeTop).toBe(12);
+
+  // And no consumer carries a fallback — a fallback on a measured token is a lie that cannot
+  // be caught, so the count is zero across every stylesheet the page loaded.
+  const fallbacks = await page.evaluate(() => {
+    let n = 0;
+    for (const sheet of [...document.styleSheets]) {
+      let rules: CSSRuleList;
+      try {
+        rules = sheet.cssRules;
+      } catch {
+        continue;
+      }
+      for (const r of [...rules]) if (/var\(\s*--head-rule\s*,/.test(r.cssText)) n++;
+    }
+    return n;
+  });
+  expect(fallbacks).toBe(0);
+});
+
+/**
+ * ESCAPE HAS ONE OWNER, AND THE OWNER IS THE OPEN SHEET (pass-4 gap 5).
+ *
+ * `useAnswerKeyPeek.ts:56` answers Escape unconditionally on a `window` keydown registered at
+ * mount — earlier than the mark's and in the same phase — so `preventDefault` could never reach
+ * it. The mark's listener is registered in CAPTURE and stops propagation, so while the sheet is
+ * open nothing else on the page reads the key.
+ *
+ * The negative control is the same key with the sheet SHUT: Escape then ends the peek, which is
+ * what makes the row above a claim rather than a tautology.
+ */
+test('Escape reaches only the open sheet, and reaches the peek when the sheet is shut', async ({
+  page,
+}) => {
+  await page.goto(SOLO);
+  await settled(page);
+  await invite(page);
+
+  const peekUp = () => page.locator('.answer-key-laminate.is-shown').count();
+  const m = mark(page);
+  await m.evaluate((el: HTMLElement) => el.focus());
+
+  // The peek up, the sheet open.
+  await page.keyboard.press('k');
+  await expect.poll(peekUp, { timeout: 5000 }).toBe(1);
+  await m.evaluate((el: HTMLElement) => el.focus());
+  await page.keyboard.press('Space');
+  await page.waitForTimeout(220);
+  expect(await m.getAttribute('aria-expanded')).toBe('true');
+
+  await page.keyboard.press('Escape');
+  await page.waitForTimeout(220);
+  // THE ROW: the sheet took the key, and the peek never saw it.
+  expect(await m.getAttribute('aria-expanded')).toBe('false');
+  expect(await peekUp()).toBe(1);
+
+  // THE NEGATIVE CONTROL: with the sheet shut the peek owns Escape, as it always has.
+  await page.keyboard.press('Escape');
+  await expect.poll(peekUp, { timeout: 5000 }).toBe(0);
+});
+
+/**
+ * THE ROW BUDGET IS THE PHONE'S REGIME, NOT A VIEWPORT HEIGHT (pass-4 gap 4).
+ *
+ * At `(min-height: 800px)` one pixel of desk viewport turned four names into one: 1280×800 drew
+ * four rows and `and 3 more`, 1280×799 drew ONE and `and 6 more`, with the board's top at 122.5
+ * in both. The regime now reads the pointer class with the height, so the desk reads the same at
+ * both — and the negative control in this run is the old query, evaluated live on the same page.
+ */
+test('the desk draws the same rows at 800 and at 799, and the old query is why it did not', async ({
+  page,
+}) => {
+  await page.setViewportSize({ width: 1280, height: 800 });
+  await page.goto(SOLO);
+  await settled(page);
+  await invite(page);
+  await page.evaluate(() => {
+    const room = new URL(location.href).searchParams.get('s')!;
+    const ch = new BroadcastChannel(`board:${room}`);
+    for (let i = 0; i < 6; i++)
+      ch.postMessage({ kind: 'hi', data: {}, from: `rows-spec-${i}` });
+    setTimeout(() => ch.close(), 0);
+  });
+  await expect.poll(() => page.locator('.players-roster .player-row').count()).toBe(7);
+
+  const draw = async (h: number) => {
+    await page.setViewportSize({ width: 1280, height: h });
+    await page.waitForTimeout(120);
+    if ((await mark(page).getAttribute('aria-expanded')) !== 'true') await mark(page).click();
+    await page.waitForTimeout(320); // the sheet SLIDES
+    return lobby(page).evaluate((el) => ({
+      rows: el.querySelectorAll('.pl-row').length,
+      more: el.querySelector('.pl-more')?.textContent?.trim() ?? '',
+      bottom: +el.getBoundingClientRect().bottom.toFixed(1),
+      boardTop: +(
+        document.querySelector('.board-wrapper')?.getBoundingClientRect().top ?? -1
+      ).toFixed(1),
+      oldQuery: window.matchMedia('(min-height: 800px)').matches,
+      regime: window.matchMedia('(pointer: coarse) and (max-height: 799px)').matches,
+    }));
+  };
+
+  const tall = await draw(800);
+  const short = await draw(799);
+  expect(tall.rows).toBe(4);
+  expect(tall.more).toBe('and 3 more');
+  // THE ROW: one pixel of desk viewport moves nothing.
+  expect(short.rows).toBe(tall.rows);
+  expect(short.more).toBe(tall.more);
+  expect(short.regime).toBe(false);
+  // THE NEGATIVE CONTROL: the query pass 3 keyed on DID flip across that pixel.
+  expect(tall.oldQuery).toBe(true);
+  expect(short.oldQuery).toBe(false);
+});
diff --git a/web/frontend/e2e/player-tally.spec.ts b/web/frontend/e2e/player-tally.spec.ts
new file mode 100644
index 00000000..b260e825
--- /dev/null
+++ b/web/frontend/e2e/player-tally.spec.ts
@@ -0,0 +1,685 @@
+/**
+ * THE TALLY (T9-W7 PLR-COUNT) — the count a reader takes without reading, as rows.
+ *
+ * One counting base: the strokes, the glyph, the accessible name, the register's rows and its
+ * foot all count everyone at this board. One threshold: five. What this file holds is the
+ * behaviour a screenshot cannot — the name against the glyph (2.5.3), the width table, the
+ * crossing (no survivor ever re-draws; the only stroke that draws is one the tally did not
+ * hold a tick ago), a departure landing mid-draw, the keys, the phone budgets, the deck that
+ * has no mark, the board's own ink under a room, the third join a reader is not pulled out
+ * by, and a quiet peer's qualifier on a fixed clock. The mark is seated on the §11 leader's
+ * substrate (`@pencil/chrome/PlayerMark`); its disclosure rows are `player-mark.spec.ts`'s.
+ *
+ * PRM: live, because every row here asserts a RESTING pose or a same-frame swap — the draw-in
+ * is the one tween on this surface and no assertion reads it mid-flight; the reduced-motion
+ * arm of the draw-in is asserted by `emulateMedia` below rather than inferred.
+ *
+ * LOCAL (O-12): CI is browserless; this is an instrument, run against a dev server by hand.
+ */
+import { test, expect, type Page } from "@playwright/test";
+
+const mark = (page: Page) => page.locator("[data-player-mark]:visible").first();
+
+/** The sheet fades and scales over 150ms; every box read here is of the SETTLED pose. */
+const settle = (page: Page) => page.waitForTimeout(260);
+
+async function settled(page: Page) {
+  await page.waitForSelector("svg.handwritten-logo", { timeout: 60000 });
+  await expect
+    .poll(() => page.locator(".sudoku-cell .glyph-svg").count(), { timeout: 60000 })
+    .toBeGreaterThan(0);
+}
+
+let cursor = 0;
+/** k people arrive on the local arm. The page answers each ack and inks them from its own
+ *  walk, so the indices are the room's real ones. */
+async function peers(page: Page, room: string, k: number) {
+  if (k <= 0) return;
+  const from = cursor;
+  cursor += k;
+  await page.evaluate(
+    ({ room, k, from }) => {
+      const w = window as unknown as { __ch?: BroadcastChannel };
+      w.__ch ??= new BroadcastChannel(`board:${room}`);
+      for (let i = 0; i < k; i++)
+        w.__ch.postMessage({ kind: "hi", data: {}, from: `tally-${from + i}` });
+    },
+    { room, k, from },
+  );
+  await page.waitForTimeout(700);
+}
+
+const head = (page: Page) =>
+  page.evaluate(() => {
+    const m = [...document.querySelectorAll("[data-player-mark]")].find(
+      (e) => e.getBoundingClientRect().width > 0,
+    ) as HTMLElement | undefined;
+    const pose = m?.querySelector(".pt-pose");
+    const b = m?.getBoundingClientRect();
+    return {
+      label: m?.getAttribute("aria-label") ?? null,
+      width: b ? +b.width.toFixed(2) : null,
+      height: b ? +b.height.toFixed(2) : null,
+      strokes: pose ? pose.querySelectorAll("path").length : 0,
+      written: m?.querySelector(".pt-count")?.textContent ?? null,
+      writtenPx: m?.querySelector(".pt-count")
+        ? getComputedStyle(m.querySelector(".pt-count")!).fontSize
+        : null,
+      ds: pose ? [...pose.querySelectorAll("path")].map((p) => p.getAttribute("d")) : [],
+      offs: pose
+        ? [...pose.querySelectorAll("path")].map((p) => p.getAttribute("stroke-dashoffset"))
+        : [],
+    };
+  });
+
+// ── G7 · one base ──────────────────────────────────────────────────────────────────────────
+test("the name counts what the strokes count, and the number takes over at six", async ({
+  page,
+}) => {
+  const room = `tally-base-${Date.now()}`;
+  await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+  await settled(page);
+
+  let at = 1;
+  for (const N of [1, 2, 3, 4, 5, 6, 16]) {
+    await peers(page, room, N - at);
+    at = N;
+    const h = await head(page);
+    // 2.5.3 BY CONSTRUCTION: the name carries the glyph's digits, because it IS the count.
+    expect(h.label).toBe(N === 1 ? "1 player" : `${N} players`);
+    expect(h.strokes).toBe(N <= 5 ? N : 0);
+    if (N > 5) {
+      expect(h.label).toContain(h.written!);
+      // THE RUNG IS THE PRICE OF THE SWAP: the numeral sits at `--type-title` (32.9), the
+      // smallest rung whose painted ink clears one graphite stroke in both themes (pass 4, G16);
+      // pass 3's heading (25.888) cleared it only under a per-crop normaliser.
+      expect(parseFloat(h.writtenPx!)).toBeGreaterThan(32);
+    }
+    // the head line never steps: the mark is its own height at every count
+    expect(h.height).toBeGreaterThanOrEqual(36);
+  }
+});
+
+// ── G3 · the width table ───────────────────────────────────────────────────────────────────
+test("the width table, and the floor at the smallest count", async ({ page }) => {
+  const room = `tally-width-${Date.now()}`;
+  await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+  await settled(page);
+  const want: Record<number, number> = {
+    1: 44,
+    2: 44,
+    3: 51.66,
+    4: 62.28,
+    5: 72.92,
+    6: 44,
+  };
+  const got: Record<number, number> = {};
+  let at = 1;
+  for (const N of [1, 2, 3, 4, 5, 6]) {
+    await peers(page, room, N - at);
+    at = N;
+    const h = await head(page);
+    got[N] = h.width!;
+    // TO 0.01, not "to within 1.5": pass 2 reported a table to two places and asserted a
+    // tolerance that would have passed on a different table.
+    expect(Math.abs(h.width! - want[N]), `width at N=${N} (got ${h.width})`).toBeLessThan(0.02);
+  }
+  console.log("WIDTH TABLE", JSON.stringify(got));
+});
+
+// ── G9 · the crossing, both ways and both at once ──────────────────────────────────────────
+// THE LAW, RESTATED (pass 4): no SURVIVOR ever re-draws; the only stroke that draws is one the
+// tally did not hold a tick ago. Pass 3 wrote "6→5 re-draws nothing" and proved it with the
+// SIXTH person leaving, who was never in the five — the row below also sends an INNER leaver.
+test("a departure re-draws no survivor, and a depart-and-arrive draws exactly the newcomer", async ({
+  page,
+}) => {
+  const room = `tally-cross-${Date.now()}`;
+  await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+  await settled(page);
+  const ids = ["p0", "p1", "p2", "p3", "p4"];
+  const say = (msgs: { kind: string; from: string }[]) =>
+    page.evaluate(
+      ({ room, msgs }) => {
+        const w = window as unknown as { __ch?: BroadcastChannel };
+        w.__ch ??= new BroadcastChannel(`board:${room}`);
+        for (const m of msgs) w.__ch.postMessage({ kind: m.kind, data: {}, from: m.from });
+      },
+      { room, msgs },
+    );
+
+  await say(ids.map((from) => ({ kind: "hi", from })));
+  await page.waitForTimeout(900);
+  expect((await head(page)).written).toBe("6");
+
+  // SIX TO FIVE: the number gives way to five strokes, and not one of them tweens. A watch
+  // that only knows `now > was` re-draws all five here, because `drawn` goes 0 -> 5.
+  await say([{ kind: "bye", from: ids[4] }]);
+  for (let i = 0; i < 5; i++) {
+    await page.waitForTimeout(80);
+    const off = (await head(page)).offs;
+    expect(off.every((v) => v === "0")).toBe(true);
+  }
+  const five = await head(page);
+  expect(five.strokes).toBe(5);
+
+  // A MIDDLE DEPARTURE: the pose is keyed to the person and the slot is a transform, so four
+  // `d` attributes come through byte for byte and only the leaver's is gone.
+  await say([{ kind: "bye", from: ids[1] }]);
+  await page.waitForTimeout(700);
+  const four = await head(page);
+  expect(four.strokes).toBe(4);
+  expect(four.ds.filter((d) => five.ds.includes(d)).length).toBe(4);
+
+  // ONE TICK, BOTH WAYS — the row pass 2 could not have passed. The count does not move, so a
+  // watch on the count never fires and the newcomer inherits the departed person's reveal.
+  // Watching the ID SET, exactly one stroke is new and exactly one is gone.
+  await say([
+    { kind: "bye", from: ids[0] },
+    { kind: "hi", from: "p9" },
+  ]);
+  await page.waitForTimeout(120);
+  const mid = await head(page);
+  expect(mid.strokes, "the count did not move").toBe(4);
+  // exactly one stroke is mid-draw (dashoffset above 0); the other three are untouched
+  const drawing = mid.offs.filter((v) => v !== "0").length;
+  expect(drawing, `exactly the newcomer draws in (offs ${JSON.stringify(mid.offs)})`).toBe(1);
+  await page.waitForTimeout(700);
+  const after = await head(page);
+  expect(after.ds.filter((d) => four.ds.includes(d)).length).toBe(3);
+});
+
+// ── G9 · the INNER leaver at six: the promoted sixth draws in, and nobody else moves ───────
+test("at six, an inner leaver promotes the sixth and only that stroke draws", async ({ page }) => {
+  const room = `tally-inner-${Date.now()}`;
+  await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+  await settled(page);
+  const ids = ["q0", "q1", "q2", "q3", "q4"];
+  const say = (msgs: { kind: string; from: string }[]) =>
+    page.evaluate(
+      ({ room, msgs }) => {
+        const w = window as unknown as { __ch?: BroadcastChannel };
+        w.__ch ??= new BroadcastChannel(`board:${room}`);
+        for (const m of msgs) w.__ch.postMessage({ kind: m.kind, data: {}, from: m.from });
+      },
+      { room, msgs },
+    );
+  await say(ids.map((from) => ({ kind: "hi", from })));
+  await page.waitForTimeout(900);
+  expect((await head(page)).written).toBe("6");
+  // q1 is INSIDE the five (you, q0, q1, q2, q3); q4 is the sixth and is promoted by the leave.
+  await say([{ kind: "bye", from: "q1" }]);
+  await expect.poll(async () => (await head(page)).strokes).toBe(5);
+  const first = (await head(page)).offs;
+  console.log("INNER LEAVER first frame", JSON.stringify(first));
+  expect(first.slice(0, 4).every((v) => v === "0"), "no survivor re-draws").toBe(true);
+  expect(Number(first[4]), "the promoted sixth draws in").toBeGreaterThan(0);
+  await page.waitForTimeout(700);
+  expect((await head(page)).offs.every((v) => v === "0")).toBe(true);
+});
+
+// ── G9b · a departure landing while a stroke is still drawing in ───────────────────────────
+// Pass 3's `settle(now)` on a bare departure jumped a drawing stroke to inked for ONE frame and
+// then let its live tween overwrite it (46.42 → 0 → 27.17 → 14.58, the critic's settle-race).
+// The row samples the newcomer's dash every animation frame: it must only ever fall, and it
+// must still be drawing on the first frame after the leave.
+test("a departure during a draw-in neither jumps nor restarts the newcomer", async ({ page }) => {
+  const room = `tally-race-${Date.now()}`;
+  await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+  await settled(page);
+  // three settled: you, r0 and r1
+  await page.evaluate(({ room }) => {
+    const ch = new BroadcastChannel(`board:${room}`);
+    for (const from of ["r0", "r1"]) ch.postMessage({ kind: "hi", data: {}, from });
+    setTimeout(() => ch.close(), 0);
+  }, { room });
+  await expect.poll(async () => (await head(page)).strokes).toBe(3);
+  await page.waitForTimeout(700);
+  const trace = await page.evaluate(
+    ({ room }) =>
+      new Promise<{ t: number; off: number; bye: boolean }[]>((done) => {
+        const ch = new BroadcastChannel(`board:${room}`);
+        const out: { t: number; off: number; bye: boolean }[] = [];
+        let bye = false;
+        const t0 = performance.now();
+        const read = () => {
+          const g = document.querySelector("[data-player-mark] .pt-pose");
+          const ps = g ? g.querySelectorAll("path") : [];
+          const last = ps[ps.length - 1];
+          return last ? Number(last.getAttribute("stroke-dashoffset")) : NaN;
+        };
+        ch.postMessage({ kind: "hi", data: {}, from: "race-new" });
+        setTimeout(() => {
+          ch.postMessage({ kind: "bye", data: {}, from: "r0" });
+          bye = true;
+        }, 80);
+        const tick = () => {
+          out.push({ t: performance.now() - t0, off: read(), bye });
+          if (performance.now() - t0 < 700) requestAnimationFrame(tick);
+          else {
+            ch.close();
+            done(out);
+          }
+        };
+        requestAnimationFrame(tick);
+      }),
+    { room },
+  );
+  const drawing = trace.filter((s) => s.off > 0);
+  expect(drawing.length, "the newcomer drew in at all").toBeGreaterThan(0);
+  const start = trace.findIndex((s) => s.off > 0);
+  const tail = trace.slice(start).map((s) => s.off);
+  const rises = tail.filter((v, i) => i > 0 && v > tail[i - 1] + 0.01).length;
+  // the first sampled frame on which the page has already applied the leave
+  const afterBye = trace.find((s, i) => s.bye && i > 0 && trace[i - 1].bye);
+  console.log(
+    "RACE",
+    JSON.stringify({ frames: trace.length, rises, afterBye, tail: tail.slice(0, 12) }),
+  );
+  expect(rises, "the dash only ever falls").toBe(0);
+  expect(afterBye!.off, "still drawing on the frame after the leave").toBeGreaterThan(0);
+  await expect.poll(async () => (await head(page)).offs.every((v) => v === "0")).toBe(true);
+});
+
+// ── G10/G11 · the seam and the keys ────────────────────────────────────────────────────────
+test("Space and Escape, and a mouse press that takes no focus", async ({ page }) => {
+  const room = `tally-keys-${Date.now()}`;
+  await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+  await settled(page);
+  await peers(page, room, 2);
+  const expanded = () =>
+    page.evaluate(
+      () => document.querySelector("[data-player-mark]")?.getAttribute("aria-expanded"),
+    );
+
+  await page.evaluate(() =>
+    (document.querySelector("[data-player-mark]") as HTMLElement).focus(),
+  );
+  await page.keyboard.press("Space");
+  await expect.poll(expanded).toBe("true");
+  await page.keyboard.press("Escape");
+  await expect.poll(expanded).toBe("false");
+
+  // The caret stays where the reader put it: `@pointerdown.prevent` means a press opens the
+  // sheet without taking focus off the board, and Escape is window-bound so it still closes.
+  const cell = page.locator(".sudoku-cell input").first();
+  await cell.click();
+  await mark(page).click();
+  await expect.poll(expanded).toBe("true");
+  expect(await page.evaluate(() => document.activeElement?.tagName)).toBe("INPUT");
+  await page.keyboard.press("Escape");
+  await expect.poll(expanded).toBe("false");
+  expect(await page.evaluate(() => document.activeElement?.tagName)).toBe("INPUT");
+});
+
+// ── The leave: focus landing anywhere else shuts the sheet, whichever way it was opened ─────
+// PLR-PLACE's graft. `@focusout` on the mark hears only a leave that starts ON the mark; a mouse
+// open never focuses it, so the caret moving on through the board left the sheet open over it.
+// Focus is moved by `.focus()` rather than Tab so both engines answer (PW-WebKit's Tab skips
+// buttons). NEGATIVE CONTROL, same page: focus landing on the mark itself leaves it open.
+test("focus moving anywhere else shuts the sheet, and focus on the mark does not", async ({
+  page,
+}) => {
+  const room = `tally-leave-${Date.now()}`;
+  await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+  await settled(page);
+  await peers(page, room, 2);
+  const expanded = () =>
+    page.evaluate(
+      () => document.querySelector("[data-player-mark]")?.getAttribute("aria-expanded"),
+    );
+  const focusCell = (i: number) =>
+    page.evaluate(
+      (i) => (document.querySelectorAll(".sudoku-cell input")[i] as HTMLInputElement).focus(),
+      i,
+    );
+
+  // mouse open with the caret in a cell, then the caret moves to another cell. The mark is
+  // never focused on this path, which is the whole of what `@focusout` could not hear.
+  await focusCell(0);
+  await mark(page).click();
+  await expect.poll(expanded).toBe("true");
+  await focusCell(1);
+  await page.waitForTimeout(200);
+  const afterCaretMoved = await expanded();
+  // shut it by the product's own key either way, so the control below starts from one state
+  if (afterCaretMoved === "true") await page.keyboard.press("Escape");
+  await expect.poll(expanded).toBe("false");
+
+  // the negative control: open again, and focus lands on the mark itself
+  await mark(page).click();
+  await expect.poll(expanded).toBe("true");
+  await page.evaluate(() =>
+    (document.querySelector("[data-player-mark]") as HTMLElement).focus(),
+  );
+  await page.waitForTimeout(200);
+  const afterMarkFocused = await expanded();
+  console.log("LEAVE", JSON.stringify({ afterCaretMoved, afterMarkFocused }));
+  expect(afterCaretMoved, "the caret moving on is a leave").toBe("false");
+  expect(afterMarkFocused, "focus landing on the mark is not a leave").toBe("true");
+});
+
+// ── G11 · the Tab route, declared per row ──────────────────────────────────────────────────
+test("the mark is reachable by Tab", async ({ page, browserName }) => {
+  // DECLARED, NOT INHERITED: PW-WebKit does not move focus between controls on a Tab press
+  // without the platform's own full-keyboard-access setting, so this row asserts in chromium
+  // and says so out loud here rather than reporting a silent green in the other engine.
+  test.skip(
+    browserName === "webkit",
+    "PW-WebKit: Tab does not traverse non-text controls (macOS full keyboard access is off " +
+      "in the bundled build); the reachability claim is chromium's, and this row says so.",
+  );
+  const room = `tally-tab-${Date.now()}`;
+  await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+  await settled(page);
+  await peers(page, room, 2);
+  let presses = 0;
+  await page.evaluate(() => (document.activeElement as HTMLElement)?.blur());
+  for (; presses < 12; presses++) {
+    await page.keyboard.press("Tab");
+    const onMark = await page.evaluate(
+      () => !!document.activeElement?.closest("[data-player-mark]"),
+    );
+    if (onMark) break;
+  }
+  console.log(`TAB ROUTE ${browserName}: press ${presses + 1}`);
+  expect(presses).toBeLessThan(12);
+});
+
+// ── G12 · the deck has no mark ─────────────────────────────────────────────────────────────
+test("the deck has no mark", async ({ page }) => {
+  await page.goto("/?view=gallery");
+  await page.waitForSelector("svg.handwritten-logo", { timeout: 60000 });
+  await page.waitForTimeout(1000);
+  await expect(page.locator("[data-player-mark]")).toHaveCount(0);
+});
+
+// ── G17 · the solo arm, as shipped ─────────────────────────────────────────────────────────
+test("solo: one graphite stroke and a register with a row", async ({ page }) => {
+  await page.goto("/?size=3&difficulty=EASY");
+  await settled(page);
+  const h = await head(page);
+  expect(h.label).toBe("1 player");
+  expect(h.strokes).toBe(1);
+  const stroke = await page.evaluate(() => {
+    const p = document.querySelector("[data-player-mark] .pt-pose .pt-stroke");
+    return p ? getComputedStyle(p).stroke : null;
+  });
+  console.log("SOLO STROKE", stroke);
+  await mark(page).click();
+  const sheet = page.locator("[data-lobby]:visible").first();
+  await expect(sheet).toBeVisible();
+  await settle(page); // the sheet fades and scales over 150ms; measure the settled pose
+  await expect(sheet.locator(".pl-row")).toHaveCount(1);
+  await expect(sheet.locator(".pl-state")).toHaveText("1 player");
+});
+
+// ── G8/G7 · the short phone, on the LEADER's row budget ────────────────────────────────────
+// RE-CUT, DECLARED (pass 4): pass 3's short regime drew `min(N,2)` rows and no foot. Seated on
+// the substrate, the §11 leader's `ROWS.short = 2` binds — two rows' space, so from three people
+// one named row and `and N more`. This family's objection rides the return, not this row.
+test.describe("the short phone", () => {
+  test.use({ viewport: { width: 390, height: 664 }, hasTouch: true, isMobile: true });
+  test("the leader's two-row budget: one named row and the compression line", async ({ page }) => {
+    const room = `tally-short-${Date.now()}`;
+    await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+    await settled(page);
+    // THE REGIME IS WITNESSED, never assumed.
+    const regime = await page.evaluate(() => ({
+      coarse: matchMedia("(pointer: coarse)").matches,
+      short: matchMedia("(pointer: coarse) and (max-height: 799px)").matches,
+    }));
+    expect(regime.coarse).toBe(true);
+    expect(regime.short).toBe(true);
+    await peers(page, room, 2); // N = 3
+    await mark(page).click();
+    const sheet = page.locator("[data-lobby]:visible").first();
+    await expect(sheet).toBeVisible();
+    await settle(page);
+    await expect(sheet.locator(".pl-state")).toHaveText("3 players");
+    await expect(sheet.locator(".pl-row")).toHaveCount(1);
+    await expect(sheet.locator(".pl-more")).toHaveText("and 2 more");
+    const named = await sheet.locator(".pl-name").allTextContents();
+    console.log("SHORT ROWS", JSON.stringify(named));
+    const box = await sheet.boundingBox();
+    console.log("SHORT SHEET H", box?.height.toFixed(2));
+    // the tap floor, coarse: `var(--tap-floor)` is 44px and the mark's box answers it
+    const m = await mark(page).boundingBox();
+    console.log("COARSE MARK", JSON.stringify(m));
+    expect(m!.height).toBeGreaterThanOrEqual(44);
+    expect(m!.width).toBeGreaterThanOrEqual(44);
+  });
+});
+
+// ── G8 · the tall phone, four rows and a foot ──────────────────────────────────────────────
+test.describe("the tall phone", () => {
+  test.use({ viewport: { width: 390, height: 844 }, hasTouch: true, isMobile: true });
+  test("sixteen people: four rows and a foot that counts the rest", async ({ page }) => {
+    const room = `tally-tall-${Date.now()}`;
+    await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+    await settled(page);
+    const regime = await page.evaluate(() => ({
+      coarse: matchMedia("(pointer: coarse)").matches,
+      short: matchMedia("(pointer: coarse) and (max-height: 799px)").matches,
+    }));
+    expect(regime.coarse).toBe(true);
+    expect(regime.short).toBe(false);
+    await peers(page, room, 15); // N = 16
+    await mark(page).click();
+    const sheet = page.locator("[data-lobby]:visible").first();
+    await expect(sheet).toBeVisible();
+    await settle(page);
