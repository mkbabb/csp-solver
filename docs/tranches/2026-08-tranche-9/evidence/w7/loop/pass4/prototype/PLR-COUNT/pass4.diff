@@ -0,0 +1,455 @@
+<script lang="ts">
+import { ref, type Ref } from "vue";
+
+/**
+ * ONE MediaQueryList PER QUERY, AT MODULE SCOPE — `useHoverCard`'s own idiom one file over,
+ * and the reason this component carries a second `<script>` block: `<script setup>` is the
+ * setup function, so a probe written there is one listener per instance and the head mounts
+ * two. The `matchMedia` guard is for the no-DOM case (jsdom), not for any browser.
+ */
+function probe(query: string): Ref<boolean> {
+  const m = ref(false);
+  if (typeof window !== "undefined" && typeof window.matchMedia === "function") {
+    const l = window.matchMedia(query);
+    m.value = l.matches;
+    l.addEventListener("change", (e) => {
+      m.value = e.matches;
+    });
+  }
+  return m;
+}
+
+/**
+ * THE COMPRESSION REGIME IS THE PHONE'S, AND IT IS KEYED ON THE PHONE (pass-4 gap 4).
+ *
+ * Pass 3 keyed it on `(min-height: 800px)` alone, and one pixel of desk viewport turned four
+ * names into one: at 1280×799 the sheet drew ONE row and `and 6 more`, at 1280×800 four rows
+ * and `and 3 more`, with the board's top at 122.5 in both. A 900px screen with browser chrome
+ * IS 1280×799. The constraint `ROWS.short` actually serves is the SHORT PHONE — a 664-tall
+ * coarse viewport has nothing between the sheet's bottom and the board's top to clear it with,
+ * where the desk's lap is CH-71's ratified pose and compression buys nothing there. So the
+ * regime reads the pointer class AND the height, never the height alone.
+ */
+const shortPhone = probe("(pointer: coarse) and (max-height: 799px)");
+</script>
+
+<script setup lang="ts">
+// `ref` comes from the module block above — the two script blocks share one scope.
+import { computed, onBeforeUnmount, useId, watch } from "vue";
+import PlayerLobby from "./PlayerLobby.vue";
+import { LOBBY_COPY } from "./copy";
+import type { LobbyLine, MarkRow } from "./types";
+import {
+  claimHeadDisclosure,
+  registerHeadDisclosure,
+  useHoverCard,
+} from "../AttributionCard/useHoverCard";
+import { useTallyStrokes, type TallyStroke } from "@pencil/composables/useTallyStrokes";
+import { MOTION } from "@pencil/config/pencilConfig";
+
+/**
+ * THE TALLY OF EVERYONE (T9-W7 §11 · M14 · PLR-COUNT, seated on PLR-SELF's substrate).
+ *
+ * One upright per person at this board, you first, each in that person's ink: a count a reader
+ * takes without reading. No diagonal, ever — the gate-five slash is a MAGNITUDE idiom
+ * (`DifficultyTally` owns it) and across five people it is a strike through four of them. From
+ * six the NUMBER replaces the strokes, at the title rung. One threshold, five, shared with the
+ * sheet's tall row budget.
+ *
+ * ONE COUNTING BASE. The strokes, the written number, the accessible name, the rows and
+ * `and N more` count the same people, and the name is computed HERE from the array the strokes
+ * are drawn from — so the glyph's digits are a substring of the name by construction (2.5.3).
+ *
+ * THE POSE IS KEYED TO THE PERSON, not the slot: the seed comes from the id, every `d` is
+ * generated at one local origin, and the slot is a translate. A departure moves the survivors
+ * right of it one pitch left and changes no surviving `d` by a byte.
+ *
+ * Everything else — the disclosure, the one-owner Escape, the head's shared open, the sheet's
+ * furniture and its row budget, the quiet qualifiers read at the open — is the leader's
+ * substrate, taken whole. This component is pencil and knows nothing about sessions; `App.vue`
+ * hands it the rows, your ink, and a reader for how long each peer has been quiet.
+ */
+const props = withDefaults(
+  defineProps<{
+    /** This page's own ink in this room — bound on the mark, spent when the room is ≥2. */
+    ink: Record<string, string>;
+    /** You first, then arrival order. Empty on a board with no room. */
+    rows: MarkRow[];
+    /** Silence past this is worth saying out loud. The session's own `PRESENCE_QUIET_MS`. */
+    quietAfterMs?: number;
+    /** How long a peer has been silent, in ms — read at OPEN, never on a timer. */
+    quietMsOf?: (id: string) => number | null;
+  }>(),
+  { quietAfterMs: 20000, quietMsOf: undefined },
+);
+
+/**
+ * SOLO — the owner's fork, both arms built, one const between them (U-10).
+ *
+ * `keep` (the default): a page with no room is still one person at this board, and that person
+ * is you — one stroke, in graphite, and a sheet with your row. M14's "coloured when a session is
+ * live" presupposes a mark present and uncoloured otherwise; graphite is this estate's
+ * uncoloured. `gate-on-a-room`: nothing mounts until there is a room to count, so the head
+ * grows with the wire and the most-seen board has no mark at all.
+ */
+const SOLO_ARM: "keep" | "gate-on-a-room" = "keep";
+const SOLO: MarkRow[] = [{ id: "self", name: "", ink: {}, self: true }];
+const people = computed<MarkRow[]>(() =>
+  props.rows.length ? props.rows : SOLO_ARM === "keep" ? SOLO : [],
+);
+const count = computed(() => people.value.length);
+/** The accessible name AND the sheet's first line, from the array the strokes count. */
+const stateLine = computed(() => LOBBY_COPY.count(count.value));
+
+const { isOpen, toggle, close } = useHoverCard();
+const el = ref<HTMLButtonElement | null>(null);
+const lobbyId = useId();
+/** ≥2 at the table. One row (or none) is a board you are alone on, and it stays graphite. */
+const live = computed(() => count.value > 1);
+
+// ── The tally ──────────────────────────────────────────────────────────────────────────────
+/** The threshold: five strokes are drawn; from six the count is written. */
+const TALLY_MAX = 5;
+/** viewBox units — `DifficultyTally`'s own geometry: pitch 13, y 9 → 35, in a 44-unit box. */
+const PITCH = 13;
+const BOX_H = 44;
+
+/** FNV-1a, 32-bit — the id's own bits, so the wobble a person is drawn with is theirs on every
+ *  page that draws them and survives every arrival and departure around them. */
+function seedFor(id: string): number {
+  let h = 0x811c9dc5;
+  for (let i = 0; i < id.length; i++) {
+    h ^= id.charCodeAt(i);
+    h = Math.imul(h, 0x01000193) >>> 0;
+  }
+  return 11 + 12 * (h % 97);
+}
+/** YOUR stroke is keyed `self` in both arms of the wire, so joining a room does not read as
+ *  somebody arriving: the stroke re-inks (the 400ms presence colour) and never re-draws. */
+const keyOf = (r: MarkRow) => (r.self ? "self" : r.id);
+
+/** THE SET IS THE FIRST FIVE PEOPLE, painted or not — past the threshold the set is still who
+ *  WOULD be drawn, so a swap at six is a change the watch can see (pass 3's empty-set cure). */
+const tallied = computed(() => people.value.slice(0, TALLY_MAX));
+const ids = computed(() => tallied.value.map(keyOf));
+const drawn = computed(() => count.value > 0 && count.value <= TALLY_MAX);
+const boxWidth = computed(() => PITCH * count.value);
+const strokes = computed<TallyStroke[]>(() =>
+  tallied.value.map((r) => ({
+    key: keyOf(r),
+    x1: PITCH / 2,
+    y1: 9,
+    x2: PITCH / 2,
+    y2: 35,
+    seed: seedFor(r.id),
+  })),
+);
+const { poses, boilFrame, reducedMotion, drawIn, forget, settle, dashOffset } =
+  useTallyStrokes(() => strokes.value);
+
+/**
+ * THE CROSSING IS A SET DIFFERENCE, and it says only what it does. Gone keys are forgotten
+ * (their tween stops with them); fresh keys draw in; every other stroke is left exactly as it
+ * is — including one still mid-draw (pass-4 gap 3: pass 3 `settle`d the survivors here, which
+ * jumped a drawing stroke to inked for one frame and then let its live tween overwrite it).
+ *
+ * THE LAW, RESTATED (pass-4 gap 2): a departure re-draws no SURVIVOR; the only stroke that ever
+ * draws is one the tally did not hold a tick ago. At six that is real: an inner leaver promotes
+ * the sixth person into the five, and that person's stroke draws in because it was never drawn.
+ */
+watch(
+  ids,
+  (now, was) => {
+    const before = was ?? [];
+    forget(before.filter((k) => !now.includes(k)));
+    const fresh = now.filter((k) => !before.includes(k));
+    if (fresh.length) drawIn(fresh);
+  },
+  { flush: "post" },
+);
+// A mid-draw PRM engage would strand a reveal (the chain force-clears, never finishes):
+// `DifficultyTally`'s own repair, one line.
+watch(reducedMotion, (reduced) => reduced && settle(ids.value));
+
+/** The slot, in viewBox units. A departure moves this and nothing else. */
+const slotAt = (i: number) => `translate(${PITCH * i} 0)`;
+
+// ── Escape, window-bound, one owner — AND THE PHASE IS THE WHOLE OF IT ──────────────────────
+// GameGallery.vue:696-721's paragraph, applied: a key belongs to ONE surface at a time, so the
+// listener exists only while this sheet is open.
+//
+// Pass 3 wrote `preventDefault` and called that ownership. It was not (pass-4 gap 5).
+// `useAnswerKeyPeek.ts:56` answers Escape UNCONDITIONALLY on a `window` keydown registered at
+// mount — earlier than this one, and in the same bubble phase — so with the answer-key peek up
+// and the sheet open the peek read the key FIRST and `defaultPrevented` was still false when it
+// did. `stopImmediatePropagation` cannot reach backwards past a listener that already ran.
+//
+// The cure is the phase. This listener is registered in CAPTURE on `window`, which is the first
+// thing the event touches on its way down, and it stops propagation outright: while this sheet
+// is open, nothing else on the page reads Escape. That is what "one owner" has to mean, and it
+// costs nothing when the sheet is shut because the listener is not there.
+//
+// ESCAPE SHUTS THE SHEET AND MOVES NOTHING ELSE (PLR-COUNT pass 4, a defect in the seat as
+// banked). The leader's listener ended in `el.focus()`, which is a no-op when the sheet was
+// opened from the keyboard (focus is already on the mark) and a THEFT when it was opened by a
+// mouse press: `@pointerdown.prevent` kept the caret in the cell, and Escape then took it out,
+// read on this tree as `activeElement` INPUT → BUTTON in both engines. Nothing inside the sheet
+// can hold focus, so there is nothing to return focus FROM; the line is struck.
+const ESCAPE_CAPTURE = { capture: true } as const;
+function onWindowEscape(e: KeyboardEvent): void {
+  if (e.key !== "Escape" || e.defaultPrevented) return;
+  e.preventDefault();
+  e.stopPropagation();
+  e.stopImmediatePropagation();
+  close();
+}
+// ── Focus going ANYWHERE ELSE is a leave (PLR-PLACE's graft, taken by PLR-COUNT pass 4) ──────
+// `@focusout` on the mark only hears a leave that STARTS on the mark, i.e. a keyboard open. A
+// mouse open never focuses the mark (`@pointerdown.prevent`), so a reader who pressed the mark
+// with the caret in a cell and then tabbed on through the board left the sheet hanging over it.
+// A document `focusin`, bound only while the sheet is open, hears both, and it needs no
+// `relatedTarget` (WebKit hands `null` for a press and for a Tab alike). Nothing inside the sheet
+// can take focus, so any focus that lands outside the mark is focus that left it.
+function onDocFocusin(e: FocusEvent): void {
+  if (!el.value?.contains(e.target as Node | null)) close();
+}
+watch(isOpen, (open) => {
+  if (open) {
+    window.addEventListener("keydown", onWindowEscape, ESCAPE_CAPTURE);
+    document.addEventListener("focusin", onDocFocusin);
+  } else {
+    window.removeEventListener("keydown", onWindowEscape, ESCAPE_CAPTURE);
+    document.removeEventListener("focusin", onDocFocusin);
+  }
+});
+onBeforeUnmount(() => {
+  window.removeEventListener("keydown", onWindowEscape, ESCAPE_CAPTURE);
+  document.removeEventListener("focusin", onDocFocusin);
+});
+
+// The head's disclosures share one origin, so they share one open (the module Set in
+// `useHoverCard`). The mark is not a descendant of the card in either head arm, which is why
+// this is a Set and not an injection.
+const unregister = registerHeadDisclosure(close);
+onBeforeUnmount(unregister);
+watch(isOpen, (open) => {
+  if (!open) return;
+  claimHeadDisclosure(close);
+  // THE QUALIFIERS ARE READ AT THE OPEN AND NEVER AGAIN. A held-open sheet that counted
+  // upwards would need a clock the estate does not keep, and would rewrite a line under a
+  // reader who is reading it. What it says is true of the moment they asked.
+  quietAt.value = Object.fromEntries(
+    people.value.map((r) => [r.id, r.self ? null : (props.quietMsOf?.(r.id) ?? null)]),
+  );
+});
+
+const quietAt = ref<Record<string, number | null>>({});
+
+/**
+ * THE SHEET NEVER SCROLLS, SO THE VIEWPORT DECIDES HOW MANY ROWS IT HOLDS.
+ *
+ * `H(r, m) = 36 + S + 5.6 + 22.4·r + (1.6 + S)·m` with S read from the sheet (measured exact to
+ * 0.05px at three points, both engines). A tall phone (844) has 5.3px between five rows and the
+ * board's top; a short one (664) has none, so it takes two. One media query — the regime above
+ * — and no scrollport anywhere: a list you scroll inside a disclosure is a second surface, and
+ * the compression line is the honest answer instead.
+ */
+const ROWS = { tall: 5, short: 2 } as const;
+const budget = computed(() => (shortPhone.value ? ROWS.short : ROWS.tall));
+const shown = computed(() =>
+  people.value.length <= budget.value
+    ? people.value
+    : people.value.slice(0, budget.value - 1),
+);
+const overflow = computed(() =>
+  people.value.length > shown.value.length
+    ? LOBBY_COPY.more(people.value.length - shown.value.length)
+    : "",
+);
+
+const lines = computed<LobbyLine[]>(() =>
+  shown.value.map((r) => {
+    const quiet = quietAt.value[r.id];
+    return {
+      id: r.id,
+      name: r.name,
+      ink: r.ink,
+      qualifier: r.self
+        ? LOBBY_COPY.self
+        : quiet !== null && quiet !== undefined && quiet >= props.quietAfterMs
+          ? LOBBY_COPY.quiet(Math.floor(quiet / 1000))
+          : "",
+    };
+  }),
+);
+</script>
+
+<template>
+  <!-- `@pointerdown.prevent` is the seam, and it is one attribute (PLR-PLACE arm I, both
+       engines). A mouse press on this mark must not move focus: the cell you were writing in
+       keeps it, `onGridFocusout` never fires, and the room is not told you looked away for as
+       long as you read your own roster. The click still lands, so Enter and Space are untouched
+       — a native button's activation is the whole contract, and the `@keydown.enter` that used
+       to sit beside it ran the handler AND the synthesised click, netting zero (CH-70). -->
+  <button
+    v-if="count"
+    ref="el"
+    type="button"
+    data-player-mark
+    class="player-mark"
+    :class="{ 'is-live': live }"
+    :style="[live ? ink : null, { '--presence-ink-dur': `${MOTION.presenceInkMs}ms` }]"
+    :aria-label="stateLine"
+    :aria-expanded="isOpen"
+    :aria-controls="lobbyId"
+    @click.stop="toggle"
+    @pointerdown.prevent
+  >
+    <svg
+      v-if="drawn"
+      class="pt-marks"
+      :class="{ 'is-solo': !live }"
+      :viewBox="`0 0 ${boxWidth} ${BOX_H}`"
+      :style="{ width: `${(boxWidth * 36) / BOX_H}px` }"
+      aria-hidden="true"
+      xmlns="http://www.w3.org/2000/svg"
+    >
+      <!-- Grain-baked pose siblings, opacity-swapped on the shared beat: zero live filters. -->
+      <g
+        v-for="(pose, f) in poses"
+        :key="'pose-' + f"
+        class="pt-pose"
+        :class="{ 'is-active': boilFrame === f }"
+      >
+        <path
+          v-for="(d, i) in pose"
+          :key="ids[i]"
+          :d="d"
+          :transform="slotAt(i)"
+          class="pt-stroke"
+          :style="tallied[i]?.ink"
+          fill="none"
+          stroke-linecap="round"
+          stroke-linejoin="round"
+          pathLength="100"
+          stroke-dasharray="100 100"
+          :stroke-dashoffset="dashOffset(ids[i])"
+        />
+      </g>
+    </svg>
+    <!-- From six: the count, written, at the TITLE rung. The rung is the price of the swap; the
+         ink table that chose it is in the style block. -->
+    <span v-else class="pt-count">{{ count }}</span>
+  </button>
+  <PlayerLobby
+    v-if="count"
+    :id="lobbyId"
+    :open="isOpen"
+    :state-line="stateLine"
+    :lines="lines"
+    :overflow="overflow"
+  />
+</template>
+
+<style scoped>
+/* THE BOX IS THE TALLY'S. The `@mbabb` trigger's inline rung and no block padding, so the mark
+   is its strokes plus 2 × 9.888: 44 · 44 · 51.66 · 62.28 · 72.92 at N = 1…5 and 44 from six
+   (the width table, G3). The floor is two-dimensional at a coarse pointer and inline-only at a
+   fine one, where the 36px floor holds the head line still across the 5↔6 swap. */
+.player-mark {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: transparent;
+  border: none;
+  padding: 0 0.618rem;
+  min-width: var(--tap-floor);
+  min-height: 36px;
+  cursor: pointer;
+  font-family: var(--font-hand);
+  line-height: 1;
+  /* THE INK IS BOUND ONCE, HERE: the ring and the written count read it. */
+  --mark-ink: var(--ink-press-quiet);
+  color: var(--mark-ink);
+  transition: color var(--presence-ink-dur) var(--ease-standard);
+}
+
+/* Your own index in the room's `k` is bound on this button by `App.vue`, so from two people on
+   `--color-user-ink` here is the colour every other page paints you. */
+.player-mark.is-live {
+  --mark-ink: var(--color-user-ink);
+}
+
+/* The ring takes `currentColor`, so it is the mark's own ink at whatever the room made it — the
+   form is `DrawerTab`'s (R6 law 39); §6's chrome token is adopted the day one ships. */
+.player-mark:focus-visible {
+  outline: 2px dashed currentColor;
+  outline-offset: 3px;
+}
+
+/* `--tap-floor` CONSUMED BARE: T9-W2 §2.6's one static declaration on `.page-root`. */
+@media (pointer: coarse) {
+  .player-mark {
+    min-height: var(--tap-floor);
+  }
+}
+
+.pt-marks {
+  display: block;
+  height: 36px;
+  overflow: visible;
+}
+
+/* Boil: each pose is its own compositing layer, so the beat is a compositor blend. */
+.pt-pose {
+  opacity: 0;
+  will-change: opacity;
+}
+.pt-pose.is-active {
+  opacity: 1;
+}
+
+/* THE STROKE IS THE PERSON'S INK — a peer's inline rebinding of `--color-user-ink` reaches it.
+   Alone, the one stroke is the page's graphite; when a second person arrives YOUR stroke takes
+   your room ink over the leader's 400ms presence beat, and never re-draws to do it. */
+.pt-stroke {
+  stroke: var(--color-user-ink);
+  stroke-width: 3.2;
+  stroke-opacity: 0.95;
+  transition: stroke var(--presence-ink-dur) var(--ease-standard);
+}
+.pt-marks.is-solo .pt-stroke {
+  stroke: var(--color-pencil-graphite);
+}
+
+/* The ink lift, fine pointers only, and only where it cannot dim a colour: the solo stroke. */
+@media (hover: hover) and (pointer: fine) {
+  .player-mark:hover .pt-marks.is-solo .pt-stroke {
+    stroke-opacity: 1;
+  }
+}
+
+/* THE WRITTEN COUNT TAKES THE TITLE RUNG (32.9px), and the reason is a number (PLR-COUNT pass 4,
+   G16). Ink weight, one normaliser per run, 390 coarse dpr 3, light, chromium / webkit:
+     one graphite stroke 60.42 / 60.42 · the `6` at subheading 33.95 / 33.55 · at heading
+     53.67 / 53.17 · at title 84.96 / 84.38. Dark: 58.69 / 62.04 · 47.76 / 46.29 · 75.28 / 73.40 ·
+     118.77 / 116.53.
+   Pass 3's heading rung cleared the floor only because its instrument normalised each crop by
+   its own darkest pixel; with one normaliser the room-inked digit paints LESS than one graphite
+   stroke in light. The title rung is the smallest rung on the ladder that clears it in both
+   themes and both engines, and the 36px floor still holds the head line (the box is 44 × 44 at
+   a coarse pointer at every rung). It does NOT make the swap monotone: five strokes paint
+   230.84, so six people still read lighter than five. That is the owner's (U-10). */
+.pt-count {
+  font-size: var(--type-title);
+  font-weight: 500;
+  color: var(--mark-ink);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .player-mark,
+  .pt-stroke {
+    transition-duration: 0s;
+  }
+}
+</style>
diff --git a/web/frontend/src/pencil/chrome/PlayerMark/copy.ts b/web/frontend/src/pencil/chrome/PlayerMark/copy.ts
