+import { describe, it, expect } from "vitest";
+import { generateRectBoilFrames } from "./gridPaths";
+
+/**
+ * T9-W7 §10 — THE JOIN'S FOUR SILENCES.
+ *
+ * The raised index tab has no bottom and the tray's lid has a hole under it, and the two meet
+ * by GEOMETRY rather than by a card-coloured patch laid across the seam. A patch is two
+ * surfaces agreeing on a fill, and `prefers-contrast: more`, an opaque sheet or a re-themed
+ * ground breaks that agreement without breaking a test. So the cut path is gated here, at the
+ * generator, where the geometry is a string.
+ *
+ * Each row names a way the cut could fail QUIETLY — the path closing anyway, the hole landing
+ * nowhere, a fallback returning something that is neither open nor the ring it promised, a
+ * rounded caller having its cut dropped. A silent failure draws a box that looks deliberate.
+ */
+
+const OPTS = { boilAmount: 1.2, seed: 42 } as const;
+const FRAMES = 4;
+
+/** The generator's own argument order, with the two knobs this file exercises at the end. */
+const rect = (cuts?: Parameters<typeof generateRectBoilFrames>[9], radius = 0) =>
+  generateRectBoilFrames(0, 0, 100, 40, OPTS, 1.2, FRAMES, radius, undefined, cuts);
+
+describe("the cut ring — openRing / generateRectBoilFrames", () => {
+  it("SILENCE 1 — the cut path does not end in Z (a closed 'open' ring is the patch again)", () => {
+    const closed = rect();
+    const cut = rect({ omit: "bottom" });
+
+    expect(closed.length).toBe(FRAMES);
+    expect(cut.length).toBe(FRAMES);
+    // The control: every frame of the uncut ring closes.
+    for (const d of closed) expect(d.trimEnd().endsWith("Z")).toBe(true);
+    // The subject: no frame of the cut ring closes, on any frame of the boil.
+    for (const d of cut) expect(d.trimEnd().endsWith("Z")).toBe(false);
+  });
+
+  it("SILENCE 2 — the gapped side has no point inside [x0, x1] (a hole with a line through it)", () => {
+    const gap = [30, 70] as const;
+    const cut = rect({ gap, gapSide: "top" });
+
+    for (const d of cut) {
+      expect(d.trimEnd().endsWith("Z")).toBe(false);
+      // Every command is `M x,y` or `L x,y`; the top side is y ≈ 0, so a point with a small y
+      // and an x inside the hole is a line crossing the tab's mouth.
+      const pts = [...d.matchAll(/[ML]\s*(-?[\d.]+)[, ]\s*(-?[\d.]+)/g)].map((m) => [
+        parseFloat(m[1]),
+        parseFloat(m[2]),
+      ]);
+      expect(pts.length).toBeGreaterThan(8);
+      const inHole = pts.filter(([px, py]) => py < 10 && px > gap[0] && px < gap[1]);
+      expect(inHole).toEqual([]);
+    }
+  });
+
+  it("SILENCE 3 — each fallback returns the CLOSED ring it declares, not a half-open one", () => {
+    // (a) hi <= lo — a zero-width hole is no hole.
+    // (b) the gap falls outside the side — a tab that is not on this edge.
+    // (c) !crossed / an endpoint empty — the hole swallows the whole side.
+    const degenerate = [
+      { gap: [50, 50] as const, gapSide: "top" as const },
+      { gap: [400, 480] as const, gapSide: "top" as const },
+      { gap: [-40, 140] as const, gapSide: "top" as const },
+    ];
+    const closed = rect();
+    for (const cuts of degenerate) {
+      const out = rect(cuts);
+      expect(out.length).toBe(FRAMES);
+      for (const d of out) expect(d.trimEnd().endsWith("Z")).toBe(true);
+      // Byte-identical to the uncut ring: a fallback that declares "the ring I always drew"
+      // has to be that ring, or the boil's seed trail has silently moved.
+      expect(out).toEqual(closed);
+    }
+  });
+
+  it("SILENCE 4 — radius !== 0 THROWS in dev instead of dropping the cut", () => {
+    // The cut ring is built from the square path's four straight sides; the rounded arm
+    // interleaves corner arcs and has nowhere to put a hole. Dropping the cut there would ship
+    // a raised tab WITH a bottom — a closed box that looks deliberate.
