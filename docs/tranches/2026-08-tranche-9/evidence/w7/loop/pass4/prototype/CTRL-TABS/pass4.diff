+/** A rectangle's sides, in the generator's own order: top · right · bottom · left. */
+export type RectSide = "top" | "right" | "bottom" | "left";
+
+/**
+ * T9-W7 §10 — THE CUTS. A drawn box that is one WALL of a neighbouring box, rather than a box
+ * beside it. Two operations, both pre-baked into the pose geometry (no filter, no beat, no
+ * second element):
+ *
+ *   `omit`  drops one side's segments entirely and leaves the path OPEN — the raised index
+ *           tab, which has no bottom because its bottom IS the tray's lid, continued upward.
+ *   `gap`   leaves the span `[from, to]` of one side open — the tray's lid under that raised
+ *           tab, so no line crosses the tab's mouth.
+ *
+ * The join is then GEOMETRY: the tab's two verticals end on the lid's own y and the lid stops
+ * either side of them, within the stroke's own width. Before this the continuity was two
+ * surfaces agreeing on a fill (a card-coloured patch laid across the seam) — which is exactly
+ * the kind of accident a `prefers-contrast: more` or an opaque-sheet regime exposes.
+ *
+ * `gap`'s coordinates are ABSOLUTE in the generator's own units, on the gapped side's own axis
+ * (x for `top`/`bottom`, y for `left`/`right`), and are read in travel order rather than in
+ * numeric order, so the same pair works on a side the ring walks backwards.
+ */
+export interface RectCuts {
+  omit?: RectSide;
+  gap?: readonly [number, number];
+  gapSide?: RectSide;
+}
+
+const SIDE_ORDER: readonly RectSide[] = ["top", "right", "bottom", "left"];
+
+/**
+ * The four sides' point lists (each already wobbled and perturbed for this frame) re-assembled
+ * as ONE OPEN polyline around the cut. Returns `undefined` when the cuts ask for nothing, so
+ * the caller falls through to the closed ring it always drew.
+ *
+ * Consecutive sides share an endpoint, which is why every continuation is `slice(1)` — the same
+ * dedup the closed serialization does with its `replace(/^M[^ ]+/, "")`.
+ */
