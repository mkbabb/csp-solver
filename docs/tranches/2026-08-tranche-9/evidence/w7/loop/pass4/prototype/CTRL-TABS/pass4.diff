+    const before = generateRectBoilFrames(0, 0, 100, 40, OPTS, 1.2, FRAMES, 0);
+    expect(rect()).toEqual(before);
+    const roundedBefore = generateRectBoilFrames(0, 0, 100, 40, OPTS, 1.2, FRAMES, 6);
+    expect(rect(undefined, 6)).toEqual(roundedBefore);
+  });
