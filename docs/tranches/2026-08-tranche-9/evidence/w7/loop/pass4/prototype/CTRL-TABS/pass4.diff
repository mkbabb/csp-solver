+  sidePoints: [number, number][][],
+  cuts: RectCuts,
+): [number, number][] | undefined {
+  const omitIdx = cuts.omit ? SIDE_ORDER.indexOf(cuts.omit) : -1;
+  if (omitIdx >= 0) {
+    // The three surviving sides, walked from the one AFTER the missing side: the path starts
+    // at the omitted side's far end and finishes at its near end, open at both.
+    const ring: [number, number][] = [...sidePoints[(omitIdx + 1) % 4]];
+    for (let k = 2; k <= 3; k++) ring.push(...sidePoints[(omitIdx + k) % 4].slice(1));
