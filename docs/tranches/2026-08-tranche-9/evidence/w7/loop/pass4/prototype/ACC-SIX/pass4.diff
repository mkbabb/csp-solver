+/** A closed linear pose (`pointsToLinear` + ` Z`) back to its points, the close made explicit. */
+function posePoints(d: string): [number, number][] {
+  const nums = d.match(/-?\d*\.?\d+(?:e[-+]?\d+)?/gi);
+  if (!nums || nums.length < 4) return [];
+  const pts: [number, number][] = [];
+  for (let i = 0; i + 1 < nums.length; i += 2) pts.push([Number(nums[i]), Number(nums[i + 1])]);
+  if (/z\s*$/i.test(d) && pts.length) pts.push(pts[0]);
+  return pts;
+}
+
+/**
+ * Arc length of each pose, in the poses' own user units. Pure, geometry-only.
+ *
+ * The poses differ from one another by 3.59 units in 3,965 (0.091%), so anything measured on
+ * one pose is within ~2.3 px of the others on a 2,513-px perimeter. Measured, not assumed.
+ *
+ * Module-private: `poseFronts` is its only caller today, and an export with no consumer is the
+ * decoy the theme-token census exists to kill, one namespace over (knip reds on it). ACC-SIX and
+ * the §10 tally take arc length THROUGH `poseFronts`; the day one of them wants the raw number,
+ * it exports here, with its consumer, in the same diff.
+ */
+function poseLengths(frames: string[]): number[] {
+  return frames.map((d) => {
+    const pts = posePoints(d);
+    let total = 0;
+    for (let i = 1; i < pts.length; i++)
+      total += Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]);
+    return total;
+  });
+}
+
+/**
+ * Each pose CUT at `fraction` of its own arc length — the fill gauge's front, as geometry.
+ *
+ * THE DASH IS GONE, AND THAT IS THE CURE (T9-W7 §4). The gauge used to draw its front with
+ * `stroke-dasharray` over `pathLength="1000"`, and in WebKit it read 92% filled at a quarter.
+ * The pass-2 synthesis named `pathLength` as the cause; on the built prototype that is FALSE.
+ * Measured on this ring, both engines, four declaration arms (attribute dash, CSS dash, a
+ * period equal to the path, an offset of zero): every arm reads 4 runs at 0.215 share in
+ * WebKit for a requested 0.05. Decimating the same pose walks it back — 492 segments → 4 runs,
+ * 123 → 1, and a perfectly straight 599-segment rectangle breaks identically, so it is not the
+ * wobble either. WebKit restarts the dash phase every ~128 segments of a polyline; Chromium
+ * dashes the path whole. A hand-drawn ring is ~490 segments by construction.
+ *
+ * So the front is not dashed. It is DRAWN: the pose is truncated at `fraction · length`, with
+ * the final point interpolated, and the renderer paints a path that ends exactly where the
+ * player's work has got to. Engine-independent by construction, because there is no dash
+ * pattern for an engine to restart, and it cannot regress when a board size or a grain setting
+ * moves the segment count past somebody's chunk boundary.
