+  const STEP_MS = 150;
+  const watch = () =>
+    a.evaluate(() => {
+      const m = [...document.querySelectorAll('[data-player-mark]')].find(
+        (e) => (e as HTMLElement).getBoundingClientRect().width > 0,
+      )!;
+      // The scope is the mark's own parent: the button AND its sheet, shut or open, and every
+      // `cur`-driven node the sheet can hold (the chart, the qualifiers, the rows).
+      const scope = m.parentElement!;
+      const w = window as unknown as { __muts: number; __obs?: MutationObserver; __scope: string };
+      w.__muts = 0;
+      w.__obs?.disconnect();
+      w.__scope = `${scope.tagName.toLowerCase()} holding ${scope.querySelectorAll('[data-player-mark],[data-lobby]').length}`;
+      w.__obs = new MutationObserver((r) => (w.__muts += r.length));
+      w.__obs.observe(scope, { subtree: true, childList: true, attributes: true, characterData: true });
+    });
