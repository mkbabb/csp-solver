+/**
+ * WHERE THE ROOM IS (T9-W7 §11 · PLR-PLACE) — the head's seating chart, and the rows a critic
+ * proved the pass-3 file could not fail.
+ *
+ * PRM: live, because every row reads a SETTLED pose past its window (the sheet's 150ms fade, the
+ * chart's `PLACE_SETTLE_MS` damping) except row 8, which emulates `reducedMotion: 'reduce'`
+ * with emulateMedia({reducedMotion:'reduce'}) before goto and reads the open sheet there.
+ *
+ * O-12: LOCAL. An instrument run by hand and by the wave's battery, never by a runner.
+ *
+ *   1  the chart opens on the room as it is: every settled peer drawn at the press, and a MOVE
+ *      after it still damped (the negative control on the seed)
+ *   2  the query at four at the table: a peer's row leaves its dot at 1 and the other two at
+ *      0.55; your own row dims nothing, the ring stays 1, and the ring wears your mark's ink
+ *   3  Hidden says one `null` and B draws no dot for A; Shown says the cell A is on, once, and
+ *      B draws A there
+ *   4  the head is still while a peer walks the board (the mark and its shut sheet, the whole
+ *      subtree), and the SAME scope moves once the sheet is open (the negative control)
+ *   5  the pitch is 32/3 px a cell at 4×4, 9×9 and 16×16, every dot 8px across, unconditionally
+ *   6  each qualifier on its own peer: `you`, the silent peer's seconds, `no cell shown`, and
+ *      nothing on a peer with a dot
+ *   7  a TAP opens the mark on a coarse phone in both engines (the pass-3 seam, planted, is the
+ *      negative control: WebKit drops the tap's click), the tap lets the cell go so no tape is
+ *      left under the sheet, the sheet owns the lapped board's hit test, and one tap there
+ *      dismisses it and hits no cell
+ *   8  under reduce the open sheet has no transition left
+ */
+import { test, expect, type Browser, type BrowserContext, type Page } from '@playwright/test';
