@@ -0,0 +1,222 @@
+<script setup lang="ts">
+import { ref, watch } from "vue";
+import PlayerStub from "../icons/PlayerStub.vue";
+import PlaceChart from "./PlaceChart.vue";
+import type { LobbyLine, PlaceChartInput } from "./types";
+
+const props = defineProps<{
+  id: string;
+  open: boolean;
+  stateLine: string;
+  lines: LobbyLine[];
+  /** `and 3 more` — the compression line, or empty. */
+  overflow: string;
+  /** the seating chart (T9-W7 PLR-PLACE), or `null` — no room, or nobody else at it */
+  chart?: PlaceChartInput | null;
+}>();
+
+/**
+ * THE QUERY (T9-W7 PLR-PLACE; R6 law 14, one affordance). A mouse over a row whose player has a
+ * dot takes the pressure off every OTHER dot. A row with no dot asks nothing — your own row
+ * (your mark is the ring, which is never dimmed) and a peer with no cell shown — because a
+ * question with no answer would only dim the whole chart. A touch never queries: it cannot
+ * hover, and a tap on this sheet is its dismissal.
+ */
+const queried = ref<string | null>(null);
+function ask(e: PointerEvent, id: string): void {
+  if (e.pointerType === "touch") return;
+  queried.value = props.chart?.peers.some((d) => d.id === id) ? id : null;
+}
+watch(
+  () => props.open,
+  () => (queried.value = null),
+);
+</script>
+
+<template>
+  <!-- THE @mbabb CARD'S POSE, ON AN OPAQUE GROUND (T9-W7 §11): `top: 100%; left: 0` off the
+       head's fixed wrapper, a 2px border at 30%, radius and padding 1rem, `min-width: 16rem`.
+       Hung off the wrapper rather than off the mark, it opens at the PAGE's left edge — right
+       edge 256, which clears the sun's x = 326 on a phone and 1072 on the desk.
+
+       WHY THE GROUND IS THE ONE THING THAT DEPARTS FROM THE CARD. The card holds two lines over
+       whatever is behind it; this holds a LIST down the page, and what is behind it is the
+       wordmark's own bleed — measured rgb(204,203,203) over 8.9% of the desk sheet's box and
+       27.7% of the state line's. At 80% the quiet rung composites to 91 on that bleed, which is
+       4.23:1 against a local ground of 204: under the AA floor, and true today only because the
+       wordmark's strokes and a 3-to-13-character slug have not yet landed on each other. Luck is
+       not a design, so the arm the estate already wrote for `prefers-reduced-transparency` is
+       promoted to the default and the arm itself is deleted (it would be a no-op). The @mbabb
+       card is untouched. Declared as this family's one DELTA; the owner disposes at the re-look.
+
+       NO `role`, NO `aria-live`. The room's one `role="log"` stays mounted in the controls card
+       where it can speak whether this sheet is open or shut; a region inside a closed disclosure
+       announces nothing. These rows are plain markup — a disclosure, not a dialog.
+
+       NO `@click.stop`, and that is the phone's dismissal. There is nothing focusable in this
+       box and nothing in it to press, so a tap on it can only mean "I am done reading": it
+       reaches the page root's `closeAll` and shuts the sheet. That is what prices the lap —
+       whatever this sheet covers, one tap uncovers. Shut, it is `pointer-events: none`, so it
+       can never swallow a press meant for the board. -->
+  <div :id="id" data-lobby class="player-lobby" :class="{ 'is-open': open }">
+    <!-- R6 LAW 33, ONE NAME PER ACT (registry-v3 §2.5: the sheet's first line is never the
+         name's sentence). In a room the chart IS the first line, and the state line is not drawn:
+         the mark already says it, and the rows under the chart say who. Alone there is no chart,
+         so the line is drawn for the eye and `aria-hidden` for the ear, which heard it once, as
+         the name of the button that opened this. -->
+    <p v-if="!chart" class="pl-state" aria-hidden="true">{{ stateLine }}</p>
+    <PlaceChart
+      v-if="open && chart"
+      class="pl-chart"
+      :style="chart.selfInk"
+      :size="chart.size"
+      :subgrid="chart.subgrid"
+      :peers="chart.peers"
+      :self="chart.self"
+      :queried="queried"
+    />
+    <ul v-if="lines.length" class="pl-rows">
+      <li
+        v-for="p in lines"
+        :key="p.id"
+        class="pl-row"
+        :style="p.ink"
+        @pointerenter="ask($event, p.id)"
+        @pointerleave="queried = null"
+      >
+        <PlayerStub :size="14" class="pl-stub" />
+        <span class="pl-name">{{ p.name }}</span>
+        <span v-if="p.qualifier" class="pl-qual">{{ p.qualifier }}</span>
+      </li>
+    </ul>
+    <p v-if="overflow" class="pl-more">{{ overflow }}</p>
+  </div>
+</template>
+
+<style scoped>
+.player-lobby {
+  position: absolute;
+  top: 100%;
+  left: 0;
+  padding: 1rem;
+  /* OPAQUE. See the template note: this is the family's one declared delta from the card's
+     pose, and it is what makes every reading on this sheet a number rather than a stroke of
+     luck. `prefers-reduced-transparency` / `prefers-contrast: more` need no arm here — the
+     ground they would have asked for is the ground that ships. */
+  background: var(--color-popover);
+  border: 2px solid color-mix(in srgb, var(--color-border) 30%, transparent);
+  border-radius: 1rem;
+  min-width: 16rem;
+  opacity: 0;
+  /* UI-6, the attribution card's own reasoning: `visibility: hidden` pulls the rows out of the
+     tab order and the a11y tree while the sheet is shut, and it is delayed to the fade's end on
+     close so the transition still reads as a fade. */
+  visibility: hidden;
+  pointer-events: none;
+  transform: scale(0.9) translateY(8px);
+  transition:
+    opacity 150ms var(--ease-standard),
+    transform 150ms var(--ease-standard),
+    visibility 0s linear 150ms;
+  z-index: 50;
+}
+
+.player-lobby.is-open {
+  opacity: 1;
+  visibility: visible;
+  pointer-events: auto;
+  transform: scale(1) translateY(0);
+  transition:
+    opacity 150ms var(--ease-standard),
+    transform 150ms var(--ease-standard),
+    visibility 0s linear 0s;
+}
+
+/* REDUCED MOTION: the sheet appears and goes, with no fade and no delayed hide. BOTH selectors,
+   because a media query adds no specificity: `.player-lobby.is-open` above out-ranks a bare
+   `.player-lobby` here, and the open sheet kept its 150ms fade under reduce (PLR-PLACE pass 3,
+   measured `0.15s, 0.15s, 0s`). */
+@media (prefers-reduced-motion: reduce) {
+  .player-lobby,
+  .player-lobby.is-open {
+    transition-duration: 0s;
+    transition-delay: 0s;
+  }
+}
+
+/* M01's raise lives on the ROWS and only there. The state line, the qualifier and `and N more`
+   keep the tag rung: a one-rung raise on all three spends 16.2px of line box against the 12.4px
+   the coarse phone has between the sheet's bottom and the board's top (research R13, measured),
+   and a caption is not a control. */
+.pl-state {
+  margin: 0;
+  font-family: var(--font-hand);
+  font-size: var(--type-tag);
+  font-weight: 500;
+  line-height: 1.35;
+  color: var(--ink-press-quiet);
+}
+
+/* THE CHART IS THE FIRST LINE, so it has no berth of its own: the sheet's padding above it and
+   the rows' own 0.35rem below. In a room the height law is `36 + 10.667·N + 5.6 + 22.4·r +
+   (1.6 + S)·m` — the state line's S and the pass-3 chart's 8px berth are both gone from it. */
+
+/* THE FURNITURE IS DECLARED, NOT INHERITED (T9-W7 §11 — the substrate PLR-COUNT and PLR-PLACE
+   graft). `gap: 0` is said out loud because the height law has no term for one and a later hand
+   adding a gap here would break three families' arithmetic silently. */
+.pl-rows {
+  margin: 0.35rem 0 0;
+  padding: 0;
+  list-style: none;
+  display: flex;
+  flex-direction: column;
+  gap: 0;
+}
+
+/* ONE RUNG ABOVE THE WELL'S TAG (M01: raise, never lower) — 16px on the desk and on a coarse
+   phone against the roster's 14. The row carries the peer's own ink, so `currentColor` inks the
+   stub and `--color-user-ink` inks the name from the one binding. */
+/* THE ROW IS 22.4px TALL IN BOTH POINTER REGIMES, AND IT SAYS SO. `line-height: 1.35` on a
+   `--type-small` rung gives 20.39 at a fine pointer and moves with the mobile scale; the floor
+   is what makes `H = 36 + S + 5.6 + 22.4r + (1.6 + S)m` one law rather than two, and the
+   sections that graft this furniture (PLR-COUNT's tally, PLR-PLACE's list) read the 22.4 out of
+   this declaration. 1.4rem = 22.4px at the estate's 16px root. */
+.pl-row {
+  display: flex;
+  align-items: center;
+  gap: 0.35rem;
+  min-height: 1.4rem;
+  font-family: var(--font-hand);
+  font-size: var(--type-small);
+  line-height: 1.35;
+  color: var(--color-user-ink);
+}
+
+.pl-stub {
+  flex: 0 0 auto;
+}
+
+.pl-name {
+  color: var(--color-user-ink);
+}
+
+/* The qualifier's berth is the ROW's own 0.35rem gap and nothing besides — a `margin-left` on
+   top of it measured 11.2px, which is two spacings for one relationship. In the well this fact
+   sat at the row's far edge, 153.3px from the last letter it qualifies: a column, not a
+   sentence. Here it is 5.6px, and it reads as part of the line. */
+.pl-qual {
+  font-size: var(--type-tag);
+  font-weight: 400;
+  color: var(--ink-press-quiet);
+}
+
+/* The compression line's own 1.6px berth is the `m` term of the height law — declared, so the
+   law has a number for it rather than inheriting one. */
+.pl-more {
+  margin: 0.1rem 0 0;
+  font-family: var(--font-hand);
+  font-size: var(--type-tag);
+  line-height: 1.35;
+  color: var(--ink-press-quiet);
+}
+</style>
diff --git a/web/frontend/src/pencil/chrome/PlayerMark/PlayerMark.place.test.ts b/web/frontend/src/pencil/chrome/PlayerMark/PlayerMark.place.test.ts
new file mode 100644
index 00000000..966a85ba
--- /dev/null
+++ b/web/frontend/src/pencil/chrome/PlayerMark/PlayerMark.place.test.ts
@@ -0,0 +1,111 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { mount } from "@vue/test-utils";
+import PlayerMark from "./PlayerMark.vue";
+import type { MarkRow, PlaceInput } from "./types";
+
+/**
+ * THE SEATING CHART'S CLOCK (T9-W7 PLR-PLACE). The sheet OPENS on where the room is now and
+ * damps only the moves that come after; a row with no dot asks the chart nothing.
+ */
+const ROWS: MarkRow[] = [
+  { id: "me", name: "swift-heron", ink: { "--color-user-ink": "#2563eb" }, self: true },
+  {
+    id: "p1",
+    name: "brave-otter",
+    ink: { "--color-user-ink": "#c026d3" },
+    self: false,
+  },
+  { id: "p2", name: "calm-wren", ink: { "--color-user-ink": "#65a30d" }, self: false },
+  { id: "p3", name: "shy-lynx", ink: { "--color-user-ink": "#0891b2" }, self: false },
+];
+const place = (
+  cursors: Record<string, number | null>,
+  self: number | null = 40,
+): PlaceInput => ({
+  size: 9,
+  subgrid: 3,
+  cursors,
+  self,
+  settleMs: 700,
+});
+
+const dots = () =>
+  [...document.querySelectorAll<SVGCircleElement>("[data-lobby] .chart-dot")].map(
+    (d) => ({
+      id: d.dataset.peer,
+      cx: d.getAttribute("cx"),
+      dim: d.classList.contains("is-dimmed"),
+    }),
+  );
+
+function mountMark(cursors: Record<string, number | null>) {
+  return mount(PlayerMark, {
+    attachTo: document.body,
+    props: { stateLine: "3 other players", ink: {}, rows: ROWS, place: place(cursors) },
+  });
+}
+
+beforeEach(() => vi.useFakeTimers());
+afterEach(() => {
+  vi.useRealTimers();
+  document.body.innerHTML = "";
+});
+
+describe("the chart opens on the room as it is", () => {
+  it("draws every settled peer at the press, before any timer runs", async () => {
+    const w = mountMark({ p1: 10, p2: 20, p3: 30 });
+    await w.find("button").trigger("click");
+    expect(dots().map((d) => d.id)).toEqual(["p1", "p2", "p3"]);
+    expect(document.querySelectorAll("[data-lobby] .chart-self")).toHaveLength(1);
+    w.unmount();
+  });
+
+  it("holds a MOVE until the peer has sat still for settleMs, then steps", async () => {
+    const w = mountMark({ p1: 10, p2: 20, p3: 30 });
+    await w.find("button").trigger("click");
+    const before = dots().find((d) => d.id === "p1")!.cx;
+    await w.setProps({ place: place({ p1: 11, p2: 20, p3: 30 }) });
+    vi.advanceTimersByTime(699);
+    await w.vm.$nextTick();
+    expect(dots().find((d) => d.id === "p1")!.cx).toBe(before);
+    vi.advanceTimersByTime(1);
+    await w.vm.$nextTick();
+    expect(dots().find((d) => d.id === "p1")!.cx).not.toBe(before);
+    w.unmount();
+  });
+
+  it("a peer with no cell has a row, no dot, and says so", async () => {
+    const w = mountMark({ p1: 10, p2: null });
+    await w.find("button").trigger("click");
+    expect(dots().map((d) => d.id)).toEqual(["p1"]);
+    const quals = [...document.querySelectorAll("[data-lobby] .pl-qual")].map((q) =>
+      q.textContent?.trim(),
+    );
+    expect(quals).toEqual(["you", "no cell shown", "no cell shown"]);
+    w.unmount();
+  });
+});
+
+describe("the query asks only rows that have an answer", () => {
+  const enter = (i: number, pointerType = "mouse") => {
+    const row = document.querySelectorAll("[data-lobby] .pl-row")[i]!;
+    const e = new Event("pointerenter") as Event & { pointerType: string };
+    Object.defineProperty(e, "pointerType", { value: pointerType });
+    row.dispatchEvent(e);
+  };
+
+  it("a peer's row dims every other dot; your own row dims none", async () => {
+    const w = mountMark({ p1: 10, p2: 20, p3: 30 });
+    await w.find("button").trigger("click");
+    enter(2);
+    await w.vm.$nextTick();
+    expect(dots().map((d) => d.dim)).toEqual([true, false, true]);
+    enter(0);
+    await w.vm.$nextTick();
+    expect(dots().map((d) => d.dim)).toEqual([false, false, false]);
+    enter(1, "touch");
+    await w.vm.$nextTick();
+    expect(dots().map((d) => d.dim)).toEqual([false, false, false]);
+    w.unmount();
+  });
+});
diff --git a/web/frontend/src/pencil/chrome/PlayerMark/PlayerMark.vue b/web/frontend/src/pencil/chrome/PlayerMark/PlayerMark.vue
new file mode 100644
index 00000000..2e1fd725
--- /dev/null
+++ b/web/frontend/src/pencil/chrome/PlayerMark/PlayerMark.vue
@@ -0,0 +1,391 @@
+<script lang="ts">
+import { ref, type Ref } from "vue";
+
+/**
+ * ONE MediaQueryList PER QUERY, AT MODULE SCOPE — `useHoverCard`'s own idiom one file over,
+ * and the reason this component carries a second `<script>` block: `<script setup>` is the
+ * setup function, so a probe written there is one listener per instance and the head mounts
+ * two. The `matchMedia` guard is for the no-DOM case (jsdom), not for any browser.
+ */
+function probe(query: string): Ref<boolean> {
+  const m = ref(false);
+  if (typeof window !== "undefined" && typeof window.matchMedia === "function") {
+    const l = window.matchMedia(query);
+    m.value = l.matches;
+    l.addEventListener("change", (e) => {
+      m.value = e.matches;
+    });
+  }
+  return m;
+}
+
+/**
+ * THE COMPRESSION REGIME IS THE PHONE'S, AND IT IS KEYED ON THE PHONE (pass-4 gap 4).
+ *
+ * Pass 3 keyed it on `(min-height: 800px)` alone, and one pixel of desk viewport turned four
+ * names into one: at 1280×799 the sheet drew ONE row and `and 6 more`, at 1280×800 four rows
+ * and `and 3 more`, with the board's top at 122.5 in both. A 900px screen with browser chrome
+ * IS 1280×799. The constraint `ROWS.short` actually serves is the SHORT PHONE — a 664-tall
+ * coarse viewport has nothing between the sheet's bottom and the board's top to clear it with,
+ * where the desk's lap is CH-71's ratified pose and compression buys nothing there. So the
+ * regime reads the pointer class AND the height, never the height alone.
+ */
+const shortPhone = probe("(pointer: coarse) and (max-height: 799px)");
+</script>
+
+<script setup lang="ts">
+// `ref` comes from the module block above — the two script blocks share one scope.
+import { computed, onBeforeUnmount, useId, watch } from "vue";
+import PlayerStub from "../icons/PlayerStub.vue";
+import PlayerLobby from "./PlayerLobby.vue";
+import { LOBBY_COPY } from "./copy";
+import type { LobbyLine, MarkRow, PlaceInput, PlaceChartInput } from "./types";
+import {
+  claimHeadDisclosure,
+  registerHeadDisclosure,
+  useHoverCard,
+} from "../AttributionCard/useHoverCard";
+import { MOTION } from "@pencil/config/pencilConfig";
+
+/**
+ * YOUR MARK, IN YOUR INK (T9-W7 §11 · M14) — the head's second mark, and the one thing in the
+ * head that ever changes colour.
+ *
+ * The mark is a crayon stub, never a written name: it is 44 × 44 in every cell measured, where
+ * a slug runs 3 to 13 characters and breathes 4× beside a fixed 75.5px `@mbabb`; and because it
+ * draws no word, its accessible name is free to be exactly the state line (WCAG 2.5.3 forbids
+ * that of a mark that letters a name, and the estate's one-name law wants it).
+ *
+ * It rests graphite. Colour arrives on it — over 400ms, on the same `join` the board's wash
+ * rides — when the room becomes two, and leaves when it drops back to one. That is the whole
+ * sentence: a colour in the corner you look at first means somebody else is here.
+ *
+ * SO THE INK NEVER MOVES FOR ANY OTHER REASON. Hover and focus swap the stub's POSE — the
+ * house's own pre-baked path swap, zero filters, same frame — and touch neither hue nor alpha.
+ * The lift this replaces (graphite at 68% → graphite at 100%) was measured inverting the
+ * sentence exactly when the control was in use, and its cure by alpha fails 1.4.11 in light on
+ * a chromatic ink (research R2: an oklch L 0.5 ink at 68% over paper reads ≈2.9:1). No
+ * `.is-live` appears in any hover or focus selector, so the ordering trap cannot return.
+ *
+ * Pencil-pure: this component knows nothing about sessions. `App.vue` hands it the state line,
+ * the ink, the rows and a reader for how long each peer has been quiet.
+ */
+const props = withDefaults(
+  defineProps<{
+    /** The accessible name AND the sheet's first line: `no other players` / `3 other players`. */
+    stateLine: string;
+    /** This page's own ink in this room — bound on the mark, spent when the room is ≥2. */
+    ink: Record<string, string>;
+    /** You first, then arrival order. Empty on a board with no room. */
+    rows: MarkRow[];
+    /** Silence past this is worth saying out loud. The session's own `PRESENCE_QUIET_MS`. */
+    quietAfterMs?: number;
+    /** How long a peer has been silent, in ms — read at OPEN, never on a timer. */
+    quietMsOf?: (id: string) => number | null;
+    /** THE SEATING CHART (T9-W7 PLR-PLACE): the board's shape, where each peer's `cur`
+     *  stands, the cell you are on (`null` when unknown or hidden), and how long a peer must
+     *  hold still before their dot moves. Absent, the sheet is the list alone. */
+    place?: PlaceInput;
+  }>(),
+  { quietAfterMs: 20000, quietMsOf: undefined, place: undefined },
+);
+
+const { isOpen, toggle, close } = useHoverCard();
+const el = ref<HTMLButtonElement | null>(null);
+const lobbyId = useId();
+/** ≥2 at the table. One row (or none) is a board you are alone on, and it stays graphite. */
+const live = computed(() => props.rows.length > 1);
+
+// ── The lift: a pose, and only a pose ──────────────────────────────────────────────────────
+/** Hover is read off the EVENT's own pointer, not off a media query: `(hover: hover)` answers
+ *  for the primary pointer, and the question here is which pointer is on the mark right now. A
+ *  touch never lifts it, so a tap cannot leave the stub latched in the picked-up pose. */
+const hovering = ref(false);
+/** Keyboard focus only. `:focus-visible` is the browser's own judgement and it is asked for
+ *  directly — a programmatic `el.focus()` sets it on neither engine, which is the truth we
+ *  want: a mark focused by script is not a mark being operated. */
+const keyFocus = ref(false);
+const pose = computed<0 | 1>(() => (hovering.value || keyFocus.value ? 1 : 0));
+
+function onEnter(e: PointerEvent): void {
+  if (e.pointerType !== "touch") hovering.value = true;
+}
+function onLeave(): void {
+  hovering.value = false;
+}
+/**
+ * THE SEAM, FOR A MOUSE AND A PEN ONLY (PLR-PLACE pass 4). Pass 3 wrote `@pointerdown.prevent`
+ * for every pointer, and under a WebKit touch a cancelled `pointerdown` cancels the tap's CLICK
+ * with it: the mark never opened on a tapped phone (`aria-expanded` stayed false, measured with
+ * the incumbent `@mbabb` trigger opening in the same context as the control). A tap therefore
+ * moves focus like any other tap, and the room hears the one `null` a look away has always said.
+ */
+function onPress(e: PointerEvent): void {
+  if (e.pointerType !== "touch") e.preventDefault();
+}
+function onFocus(): void {
+  keyFocus.value = !!el.value?.matches(":focus-visible");
+}
+function onBlur(): void {
+  keyFocus.value = false;
+  // Nothing inside the sheet can take focus, so focus leaving the mark is a reader leaving the
+  // sheet. Tab off it is an honest leave; a mouse press never gets here (`onPress` prevents it).
+  close();
+}
+
+// ── Escape, window-bound, one owner — AND THE PHASE IS THE WHOLE OF IT ──────────────────────
+// GameGallery.vue:696-721's paragraph, applied: a key belongs to ONE surface at a time, so the
+// listener exists only while this sheet is open.
+//
+// Pass 3 wrote `preventDefault` and called that ownership. It was not (pass-4 gap 5).
+// `useAnswerKeyPeek.ts:56` answers Escape UNCONDITIONALLY on a `window` keydown registered at
+// mount — earlier than this one, and in the same bubble phase — so with the answer-key peek up
+// and the sheet open the peek read the key FIRST and `defaultPrevented` was still false when it
+// did. `stopImmediatePropagation` cannot reach backwards past a listener that already ran.
+//
+// The cure is the phase. This listener is registered in CAPTURE on `window`, which is the first
+// thing the event touches on its way down, and it stops propagation outright: while this sheet
+// is open, nothing else on the page reads Escape. That is what "one owner" has to mean, and it
+// costs nothing when the sheet is shut because the listener is not there.
+const ESCAPE_CAPTURE = { capture: true } as const;
+function onWindowEscape(e: KeyboardEvent): void {
+  if (e.key !== "Escape" || e.defaultPrevented) return;
+  e.preventDefault();
+  e.stopPropagation();
+  e.stopImmediatePropagation();
+  close();
+  el.value?.focus();
+}
+watch(isOpen, (open) => {
+  if (open) window.addEventListener("keydown", onWindowEscape, ESCAPE_CAPTURE);
+  else window.removeEventListener("keydown", onWindowEscape, ESCAPE_CAPTURE);
+});
+onBeforeUnmount(() =>
+  window.removeEventListener("keydown", onWindowEscape, ESCAPE_CAPTURE),
+);
+
+// The head's disclosures share one origin, so they share one open (the module Set in
+// `useHoverCard`). The mark is not a descendant of the card in either head arm, which is why
+// this is a Set and not an injection.
+const unregister = registerHeadDisclosure(close);
+onBeforeUnmount(unregister);
+watch(isOpen, (open) => {
+  if (!open) return;
+  claimHeadDisclosure(close);
+  // THE QUALIFIERS ARE READ AT THE OPEN AND NEVER AGAIN. A held-open sheet that counted
+  // upwards would need a clock the estate does not keep, and would rewrite a line under a
+  // reader who is reading it. What it says is true of the moment they asked.
+  quietAt.value = Object.fromEntries(
+    props.rows.map((r) => [r.id, r.self ? null : (props.quietMsOf?.(r.id) ?? null)]),
+  );
+});
+
+const quietAt = ref<Record<string, number | null>>({});
+
+/**
+ * THE SHEET NEVER SCROLLS, SO THE VIEWPORT DECIDES HOW MANY ROWS IT HOLDS.
+ *
+ * `H(r, m) = 36 + S + 5.6 + 22.4·r + (1.6 + S)·m` with S read from the sheet (measured exact to
+ * 0.05px at three points, both engines). A tall phone (844) has 5.3px between five rows and the
+ * board's top; a short one (664) has none, so it takes two. One media query — the regime above
+ * — and no scrollport anywhere: a list you scroll inside a disclosure is a second surface, and
+ * the compression line is the honest answer instead.
+ */
+const ROWS = { tall: 5, short: 2 } as const;
+const budget = computed(() => (shortPhone.value ? ROWS.short : ROWS.tall));
+const shown = computed(() =>
+  props.rows.length <= budget.value
+    ? props.rows
+    : props.rows.slice(0, budget.value - 1),
+);
+const overflow = computed(() =>
+  props.rows.length > shown.value.length
+    ? LOBBY_COPY.more(props.rows.length - shown.value.length)
+    : "",
+);
+
+// ── WHERE EVERYONE HAS SETTLED (T9-W7 PLR-PLACE) ────────────────────────────────────────────
+//
+// The wire sends one `cur` per focus CHANGE and nothing while a peer sits still, so a MOVE is
+// damped by a receiver-side timer: hold the latest arrival, restart on a newer one, draw when it
+// fires. What is NOT damped is the reading the sheet OPENS on: every open seeds the chart from
+// what the room holds at that moment, before any timer is armed, so a press shows where
+// everyone is now and never an empty board (pass 3 opened empty for 804/812 ms, both engines).
+const settled = ref<Record<string, number | null>>({});
+const timers: Record<string, ReturnType<typeof setTimeout>> = {};
+function stopTimers(): void {
+  for (const id of Object.keys(timers)) {
+    clearTimeout(timers[id]);
+    delete timers[id];
+  }
+}
+watch(
+  [isOpen, () => props.place?.cursors],
+  ([open, now], [wasOpen]) => {
+    if (!open || !now) return stopTimers();
+    if (!wasOpen) {
+      stopTimers();
+      settled.value = { ...now };
+      return;
+    }
+    for (const [id, pos] of Object.entries(now)) {
+      clearTimeout(timers[id]);
+      delete timers[id];
+      if (settled.value[id] === pos) continue;
+      timers[id] = setTimeout(() => {
+        delete timers[id];
+        settled.value = { ...settled.value, [id]: pos };
+      }, props.place!.settleMs);
+    }
+    for (const id of Object.keys(settled.value)) {
+      if (id in now) continue;
+      clearTimeout(timers[id]);
+      delete timers[id];
+      const { [id]: _gone, ...rest } = settled.value;
+      settled.value = rest;
+    }
+  },
+  { deep: true },
+);
+onBeforeUnmount(stopTimers);
+
+const placed = (id: string) => typeof settled.value[id] === "number";
+
+/** A seating chart of a room with nobody else in it is not a chart, so it draws only when the
+ *  room is ≥2. A peer with no settled cell, or with no ink, has a row and no dot: BoardHost's
+ *  law, an unknown author gets no colour, and a fallback here would draw a stranger in yours. */
+const chart = computed<PlaceChartInput | null>(() => {
+  const p = props.place;
+  if (!p || !live.value) return null;
+  return {
+    size: p.size,
+    subgrid: p.subgrid,
+    self: p.self,
+    // YOUR RING IS YOUR MARK'S INK. Unbound, the ring inherited the estate's default
+    // `--color-user-ink` (the incumbent blue) while the mark beside it wore the room's colour
+    // for you: two colours for one person on one sheet (pass 4, frame 2).
+    selfInk: props.ink,
+    peers: props.rows
+      .filter((r) => !r.self && placed(r.id) && r.ink["--color-user-ink"])
+      .map((r) => ({
+        id: r.id,
+        ink: r.ink["--color-user-ink"],
+        pos: settled.value[r.id] as number,
+      })),
+  };
+});
+
+const lines = computed<LobbyLine[]>(() =>
+  shown.value.map((r) => {
+    const quiet = quietAt.value[r.id];
+    return {
+      id: r.id,
+      name: r.name,
+      ink: r.ink,
+      qualifier: r.self
+        ? LOBBY_COPY.self
+        : quiet !== null && quiet !== undefined && quiet >= props.quietAfterMs
+          ? LOBBY_COPY.quiet(Math.floor(quiet / 1000))
+          : chart.value && !placed(r.id)
+            ? LOBBY_COPY.unplaced
+            : "",
+    };
+  }),
+);
+</script>
+
+<template>
+  <!-- `onPress` is the seam (PLR-PLACE arm I, both engines). A mouse press on this mark must not
+       move focus: the cell you were writing in keeps it, `onGridFocusout` never fires, and the
+       room is not told you looked away for as long as you read your own roster. The click still
+       lands, so Enter and Space are untouched — a native button's activation is the whole
+       contract, and the `@keydown.enter` that used to sit beside it ran the handler AND the
+       synthesised click, netting zero (CH-70). A TOUCH is not prevented: see `onPress`. -->
+  <button
+    ref="el"
+    type="button"
+    data-player-mark
+    class="player-mark"
+    :class="{ 'is-live': live }"
+    :style="[live ? ink : null, { '--presence-ink-dur': `${MOTION.presenceInkMs}ms` }]"
+    :aria-label="stateLine"
+    :aria-expanded="isOpen"
+    :aria-controls="lobbyId"
+    @click.stop="toggle"
+    @pointerdown="onPress"
+    @pointerenter="onEnter"
+    @pointerleave="onLeave"
+    @focus="onFocus"
+    @focusout="onBlur"
+  >
+    <PlayerStub :size="20" :pose="pose" />
+  </button>
+  <PlayerLobby
+    :id="lobbyId"
+    :open="isOpen"
+    :state-line="stateLine"
+    :lines="lines"
+    :overflow="overflow"
+    :chart="chart"
+  />
+</template>
+
+<style scoped>
+/* The `@mbabb` trigger's own √φ rungs, so the two marks share one centre line: 20px of stub
+   plus 2 × 9.888 is 39.8 tall, exactly the trigger's height at a fine pointer. */
+.player-mark {
+  display: flex;
+  align-items: center;
+  background: transparent;
+  border: none;
+  padding: 0.618rem 0.786rem;
+  cursor: pointer;
+  /* THE INK IS BOUND ONCE, HERE, and every other rule in this block leaves it alone. */
+  --mark-ink: var(--ink-press-quiet);
+  color: var(--mark-ink);
+  transition: color var(--presence-ink-dur) var(--ease-standard);
+}
+
+/* THE ONE SENTENCE. Your own index in the room's `k` is bound on this button by `App.vue`, so
+   `--color-user-ink` here is the colour every other page paints you — which is why the mark
+   going coloured means somebody else arrived, and not merely that a feature exists. */
+.player-mark.is-live {
+  --mark-ink: var(--color-user-ink);
+}
+
+/* ONE affordance, and it is not a colour: the stub is picked up (pose 0 → pose 1, both baked,
