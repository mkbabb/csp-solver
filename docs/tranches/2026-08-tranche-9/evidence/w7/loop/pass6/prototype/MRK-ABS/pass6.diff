+// PRM: live, because the board ledger is read in the regime the product ships (its figures
+// reproduce to the third decimal run to run) and G-ABS-4 reads a live focus's first frame; G-ABS-3
+// and G-ABS-4f park the boil — emulateMedia({reducedMotion:'reduce'}) before their goto — because
+// their grounds ride the board's boiling edge and a worst sample on a moving ground is not a quantity.
+/**
+ * THE FOCUS RING — the board ring's ledger and geometry, the chrome ring's ink and floor (T9-W7 §5/§6).
+ *
+ * Each row carries its own negative controls IN THE SAME RUN (the row is only a gate if the
+ * control reds):
+ *
+ *   G-ABS-5  THE LEDGER IS TRUE. `index.css`'s `--color-focus-sketch` comment carries a ledger:
+ *            the tier-2 opacity it was read at, one row per board × ground × theme × engine (the
+ *            left side's worst), and the frame cell's whole-ring count under 3:1 (a station too
+ *            faint to read counts under). EVERY numeral in that comment must be a ledger figure
+ *            or sit in a named phrase; the opacity must equal `gameCell.css` tier 2's source text
+ *            AND the painted ring's computed value; every row must sit within a tenth of paint,
+ *            the count within six stations; the paper cell's core median must clear 3:1 on paint.
+ *            Controls: tier 2 at 0.9, at 0.15 (faint), hidden (X1), transparent (X2); the source
+ *            text moved; the rows falsified to 9.99 and the count to 0; six numeral plants
+ *            (4.15, 1.8, 2.4:1, a percent, an integer, a comma decimal) and a one-decimal
+ *            opacity that must not eat a stray figure.
+ *   G-ABS-7  MA-N FROM THE DOM. At 16×16, every cell: the ring's painted outer ink (its vertices
+ *   G-ABS-8  through the path's own screen CTM, plus half the heaviest stroke the sheet draws)
+ *            stays inside its own cell. The resident `d` is first proved byte-identical to the
+ *            recipe below at `RING_GEOMETRY` (G-ABS-8) — so the recipe IS the product — and the
+ *            same wander at inset 1.00 must ENTER a neighbour (the inset is load-bearing for THIS
+ *            wander). 74a2b5d9's own recipe is printed beside it: it clears on its own.
+ *   G-ABS-4  ONE INK. On every game route, the deck and the armed guard, both themes: every
+ *            focus stop's ring host paints one token colour (law 39's dashed tab aside),
+ *            `outline-style: auto` nowhere, the final colour on the first frame; the three
+ *            descendant hosts (the deck's centre card, a staging face, a guard face) must be
+ *            REACHED. Control: one host re-styled to `outline: auto`.
+ *   G-ABS-4f FORCED COLOURS. Every ring the estate draws takes the system's Highlight, the three
+ *            descendant hosts included. Control: one host put back on CanvasText.
+ *   G-ABS-3  THE CHROME FLOOR, PAINTED, THE BOIL PARKED. The home stops, the deck's centre card
+ *            and a staging face, a guard face, both themes: each ring read from painted bytes
+ *            along each side's normal (ring OFF = the same pixels blurred; the changed pixel must
+ *            BE the computed outline ink). A stop passes when no sample line reads under 3:1; an
+ *            ADMITTED stop carries the fraction it is allowed and reds STALE when it obeys the
+ *            rule. Control: a stranded near-ground ring injected on one stop.
+ *
+ * Every read settles by POLLING, never by a fixed wait.
+ */
+import { test, expect, type Page } from "@playwright/test";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { wobbleRect } from "@mkbabb/pencil-boil";
+import { RING_GEOMETRY } from "../src/pencil/config/pencilConfig";
+
+const FE = join(fileURLToPath(new URL(".", import.meta.url)), "..");
+const INDEX_CSS = readFileSync(join(FE, "src/assets/index.css"), "utf8");
+const CELL_CSS = readFileSync(join(FE, "src/games/shared/gameCell.css"), "utf8");
+const TIER2 = ".game-cell:has(input:focus-visible) .cell-ghost-path";
+
+type RGB = number[];
+type Engine = "chromium" | "webkit";
+const lin = (c: number) => (c / 255 <= 0.04045 ? c / 255 / 12.92 : Math.pow((c / 255 + 0.055) / 1.055, 2.4));
+const lum = (c: RGB) => 0.2126 * lin(c[0]) + 0.7152 * lin(c[1]) + 0.0722 * lin(c[2]);
+const ratio = (a: RGB, b: RGB) => (Math.max(lum(a), lum(b)) + 0.05) / (Math.min(lum(a), lum(b)) + 0.05);
+const dist = (a: RGB, b: RGB) => Math.abs(a[0] - b[0]) + Math.abs(a[1] - b[1]) + Math.abs(a[2] - b[2]);
+const r3 = (x: number) => Math.round(x * 1000) / 1000;
+
+/** A real `?board=` payload in the app's own codec: base64url("\x01" + "<sub>.<cells base36>"). A
+ *  valid pattern solution, about two givens in five, cells 0 and 1 held EMPTY (the frame crossing
+ *  and the paper cell the ledger reads). */
+function mint(sub: number): string {
+  const n = sub * sub;
+  let cells = "";
+  for (let r = 0; r < n; r++)
+    for (let c = 0; c < n; c++) {
+      const i = r * n + c;
+      const keep = i > 1 && (r * 7 + c * 3) % 5 < 2;
+      cells += (keep ? ((r * sub + Math.floor(r / sub) + c) % n) + 1 : 0).toString(36);
+    }
+  return btoa(String.fromCharCode(1) + `${sub}.${cells}`).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+}
+
+async function loadBoard(page: Page, sub: number) {
+  const payload = mint(sub);
+  await page.goto(`/?size=${sub}&board=${payload}`);
+  await expect.poll(() => page.locator(".board-shell .game-cell").count(), { timeout: 120000 }).toBe(sub ** 4);
+  await expect.poll(() => page.evaluate(() => new URLSearchParams(location.search).get("board"))).toBe(payload);
+}
+
+async function setTheme(page: Page, want: "light" | "dark") {
+  const isDark = () => page.evaluate(() => document.documentElement.classList.contains("dark"));
+  if ((await isDark()) !== (want === "dark")) {
+    await page.locator("button.sun-moon-toggle").first().focus();
+    await page.keyboard.press("Enter");
+    await expect.poll(isDark, { timeout: 10000 }).toBe(want === "dark");
+  }
+  await page.evaluate(() => (document.activeElement as HTMLElement)?.blur?.());
+  await settled(page);
+}
+
+/** Settled = no running finite animation anywhere in the document (the theme's bake, a ring's
+ *  draw-on, a fold). Infinite loops (the boil's ticker is not an Animation) never block it. */
+const settled = (page: Page) =>
+  expect
+    .poll(
+      () =>
+        page.evaluate(
+          () =>
+            document
+              .getAnimations()
+              .filter((a) => a.playState === "running" && a.effect?.getTiming().iterations !== Infinity).length,
+        ),
+      { timeout: 15000 },
+    )
+    .toBe(0);
+
+async function inject(page: Page, css: string, id: string) {
+  await page.evaluate(
+    ({ css, id }) => {
+      document.getElementById(id)?.remove();
+      if (!css) return;
+      const s = document.createElement("style");
+      s.id = id;
+      s.textContent = css;
+      document.head.appendChild(s);
+    },
+    { css, id },
+  );
+}
+
+/** The painted bytes of a clip, decoded in the page (no image library in the estate). */
+async function pixels(page: Page, clip: { x: number; y: number; width: number; height: number }) {
+  const png = await page.screenshot({ clip, scale: "css" });
+  const data: number[] = await page.evaluate(
+    async ({ b64, w, h }) => {
+      const img = new Image();
+      img.src = `data:image/png;base64,${b64}`;
+      await img.decode();
+      const c = document.createElement("canvas");
+      c.width = w;
+      c.height = h;
+      const g = c.getContext("2d")!;
+      g.drawImage(img, 0, 0);
+      return Array.from(g.getImageData(0, 0, w, h).data);
+    },
+    { b64: png.toString("base64"), w: clip.width, h: clip.height },
+  );
+  return (x: number, y: number): RGB | null => {
+    const px = Math.round(x - clip.x),
+      py = Math.round(y - clip.y);
+    if (px < 0 || py < 0 || px >= clip.width || py >= clip.height) return null;
+    const o = (py * clip.width + px) * 4;
+    return [data[o], data[o + 1], data[o + 2]];
+  };
+}
+
+// ── G-ABS-5 · the ledger ─────────────────────────────────────────────────────────────────────
+// EVERY numeral token in the comment is read — a one-decimal figure, a ratio, a percent, an
+// integer, a comma decimal — and each must be a ledger figure or sit inside one of the phrases
+// below, which name the statistic and the law rather than report a reading.
+const NUMERAL = /\d+(?:[.,]\d+)*/g;
+const ALLOWED = [/\be2e\//g, /\bG-ABS-\d+\b/g, /\bT9-W\d+/g, /\bW\d+ record\b/g, /§\d+/g, /\btier \d\b/g, /\b\d+×\d+\b/g, /WCAG 1\.4\.11/g, /\b3:1\b/g, /\bU-10\b/g, /\b12 units\b/g, /\bWORST of 60 samples\b/g, /\bfour sides of 60\b/g, /\bof 240\b/g];
+type LedgerRow = { board: string; on: string; light: Record<Engine, number>; dark: Record<Engine, number> };
+type WholeRow = { light: Record<Engine, number>; dark: Record<Engine, number> };
+function ledger(css: string) {
+  const at = css.indexOf("--color-focus-sketch:");
+  const comment = css.slice(at, css.indexOf("*/", at));
+  const op = comment.match(/WORST of (\d+) samples, tier 2 at\s+stroke-opacity (\d+(?:\.\d+)?)/);
+  const rows: LedgerRow[] = [];
+  const guarded: string[] = op ? [op[2]] : [];
+  for (const m of comment.matchAll(/(16×16|9×9) (paper|frame)\s+light (\d+\.\d+) \/ (\d+\.\d+)\s+dark (\d+\.\d+) \/ (\d+\.\d+)/g)) {
+    rows.push({ board: m[1], on: m[2], light: { chromium: +m[3], webkit: +m[4] }, dark: { chromium: +m[5], webkit: +m[6] } });
+    guarded.push(m[3], m[4], m[5], m[6]);
+  }
+  const w = comment.match(/under 3:1 of 240\s+light (\d+) \/ (\d+)\s+dark (\d+) \/ (\d+)/);
+  const whole: WholeRow | null = w ? { light: { chromium: +w[1], webkit: +w[2] }, dark: { chromium: +w[3], webkit: +w[4] } } : null;
+  if (w) guarded.push(w[1], w[2], w[3], w[4]);
+  let prose = comment.replace(/^--color-focus-sketch:\s*#[0-9a-fA-F]+;/, "");
+  for (const a of ALLOWED) prose = prose.replace(a, " ");
+  const unguarded = [...prose.matchAll(NUMERAL)].map((m) => m[0]);
+  for (const g of guarded) {
+    const k = unguarded.indexOf(g);
+    if (k >= 0) unguarded.splice(k, 1);
+  }
+  return { opacity: op ? +op[2] : null, rows, whole, unguarded };
+}
+const tier2 = (src: string) => {
+  const i = src.indexOf(`${TIER2} {`);
+  return +(src.slice(i, src.indexOf("}", i)).match(/stroke-opacity:\s*([\d.]+)/)?.[1] ?? NaN);
+};
+
+/** The ledger's statistic: 60 samples along each side of the drawn path, at each the pixel of a
+ *  3×3 window that changed most between blurred and focused. The LEFT side's WORST of 60 is the
+ *  row; `under` counts the WHOLE ring's stations under 3:1 with a station that changed nothing
+ *  (d < 8) counted UNDER — a station too faint to read is the station under the floor; `median`
+ *  is the left side's core median with the same rule (an unpainted station reads 1). */
+async function ledgerRead(page: Page, idx: number) {
+  const geom = () =>
+    page.evaluate((i) => {
+      const cell = document.querySelectorAll(".board-shell .game-cell")[i] as HTMLElement;
+      const p = cell.querySelector(".cell-ghost-path") as SVGPathElement;
+      const m = p.getScreenCTM()!;
+      const pts = [...p.getAttribute("d")!.matchAll(/[ML]\s*(-?[\d.eE+]+),(-?[\d.eE+]+)/g)].map((g) => [
+        m.e + m.a * +g[1],
+        m.f + m.d * +g[2],
+      ]);
+      const r = cell.getBoundingClientRect();
+      return { pts, so: getComputedStyle(p).strokeOpacity, box: { x: r.x, y: r.y, w: r.width, h: r.height } };
+    }, idx);
+  const g0 = await geom();
+  const clip = { x: Math.max(0, Math.floor(g0.box.x - 20)), y: Math.max(0, Math.floor(g0.box.y - 20)), width: Math.ceil(g0.box.w + 40), height: Math.ceil(g0.box.h + 40) };
+  await page.evaluate(() => (document.activeElement as HTMLElement)?.blur?.());
+  await settled(page);
+  const before = await pixels(page, clip);
+  await page.locator(".board-shell .game-cell .cell-native-input").nth(idx).focus();
+  await page.keyboard.press("Shift");
+  await expect.poll(() => page.evaluate(() => document.querySelectorAll(".game-cell:has(input:focus-visible)").length)).toBe(1);
+  await settled(page);
+  const g = await geom();
+  const after = await pixels(page, clip);
+  await page.evaluate(() => (document.activeElement as HTMLElement)?.blur?.());
+  const nv = g.pts.length % 4 === 1 ? g.pts.length - 1 : g.pts.length;
+  const q = nv / 4;
+  const sides: (number | null)[][] = [];
+  for (let s = 0; s < 4; s++) {
+    const side = g.pts.slice(s * q, (s + 1) * q).concat([g.pts[((s + 1) * q) % nv]]);
+    const took: (number | null)[] = [];
+    for (let i = 0; i < 60; i++) {
+      const t = ((i + 0.5) / 60) * (side.length - 1);
+      const k = Math.min(side.length - 2, Math.floor(t)),
+        f = t - k;
+      const x = side[k][0] + f * (side[k + 1][0] - side[k][0]),
+        y = side[k][1] + f * (side[k + 1][1] - side[k][1]);
+      let best: { d: number; r: number } | null = null;
+      for (let dx = -1; dx <= 1; dx++)
+        for (let dy = -1; dy <= 1; dy++) {
+          const a = after(x + dx, y + dy),
+            b = before(x + dx, y + dy);
+          if (!a || !b) continue;
+          const d = dist(a, b);
+          if (!best || d > best.d) best = { d, r: ratio(a, b) };
+        }
+      took.push(best && best.d >= 8 ? best.r : null);
+    }
+    sides.push(took);
+  }
+  const left = sides[3];
+  const painted = left.filter((v): v is number => v !== null);
+  const all = sides.flat();
+  const med = [...left.map((v) => v ?? 1)].sort((a, b) => a - b)[30];
+  return {
+    worst: painted.length === 60 ? r3(Math.min(...painted)) : null,
+    median: r3(med),
+    under: all.filter((v) => v === null || v < 3).length,
+    unpainted: all.filter((v) => v === null).length,
+    strokeOpacity: +g.so,
+  };
+}
+
+type Read = { board: string; on: string; theme: string; worst: number | null; median: number; under: number; unpainted: number };
+test.describe("MRK-ABS · the board ring", () => {
+  test("G-ABS-5 · the ledger is true at the opacity it names, and reds when it is not", async ({ page }, info) => {
+    test.setTimeout(420000);
+    const engine = info.project.name as Engine;
+    const L = ledger(INDEX_CSS);
+    const srcOp = tier2(CELL_CSS);
+    const where = { "16×16": { sub: 4, cell: { paper: 1, frame: 0 } }, "9×9": { sub: 3, cell: { paper: 0 } } } as const;
+    const readArm = async (css: string, boards: ("16×16" | "9×9")[], themes: ("light" | "dark")[]) => {
+      const reads: Read[] = [];
+      const ops: number[] = [];
+      for (const board of boards) {
+        await loadBoard(page, where[board].sub);
+        await inject(page, css, "g-abs-5-arm");
+        for (const theme of themes) {
+          await setTheme(page, theme);
+          for (const [on, idx] of Object.entries(where[board].cell)) {
+            const r = await ledgerRead(page, idx);
+            reads.push({ board, on, theme, worst: r.worst, median: r.median, under: r.under, unpainted: r.unpainted });
+            ops.push(r.strokeOpacity);
+          }
+        }
+      }
+      return { reads, ops };
+    };
+    const shipped = await readArm("", ["16×16", "9×9"], ["light", "dark"]);
+    // The controls read the 16×16 board in light: one arm each, one variable each.
+    const controls = {
+      "ablated-0.9": await readArm(`${TIER2}{stroke-opacity:.9!important}`, ["16×16"], ["light"]),
+      "faint-0.15": await readArm(`${TIER2}{stroke-opacity:.15!important}`, ["16×16"], ["light"]),
+      "X1-opacity-0": await readArm(".game-cell .cell-ghost{opacity:0!important}", ["16×16"], ["light"]),
+      "X2-transparent": await readArm(`${TIER2}{stroke:rgba(0,0,0,0)!important;fill:rgba(0,0,0,0)!important}`, ["16×16"], ["light"]),
+    };
+    const paintClause = (rows: LedgerRow[], reads: Read[]) =>
+      rows.length === 3 &&
+      reads.every((r) => {
+        const row = rows.find((x) => x.board === r.board && x.on === r.on);
+        return !!row && r.worst !== null && Math.abs(r.worst - row[r.theme as "light" | "dark"][engine]) <= 0.1;
+      });
+    // The whole ring of the frame cell: the ledger's count within 6 stations (2.5 %) of paint.
+    const wholeClause = (whole: WholeRow | null, reads: Read[]) =>
+      !!whole && reads.filter((r) => r.board === "16×16" && r.on === "frame").every((r) => Math.abs(r.under - whole[r.theme as "light" | "dark"][engine]) <= 6);
+    // Visibility, not existence: the paper cell's left-side core median clears 3:1 on paint.
+    const visibleClause = (reads: Read[]) => reads.filter((r) => r.on === "paper").every((r) => r.median >= 3);
+    const opClause = (ledgerOp: number | null, source: number, computed: number[]) =>
+      ledgerOp !== null && ledgerOp === source && computed.every((o) => o === ledgerOp);
+    const say = (reads: Read[]) =>
+      reads.map((r) => {
+        const row = L.rows.find((x) => x.board === r.board && x.on === r.on);
+        return `${r.board} ${r.on} ${r.theme}: painted ${r.worst} ledger ${row?.[r.theme as "light" | "dark"][engine]} · left median ${r.median} · whole ring under 3:1 ${r.under}/240 (unpainted ${r.unpainted})`;
+      });
+    const lines = say(shipped.reads);
+    console.log(
+      `[G-ABS-5 ${engine}] opacity ledger ${L.opacity} source ${srcOp} computed ${[...new Set(shipped.ops)]} · whole-ring ledger ${JSON.stringify(L.whole)}\n${lines.join("\n")}\n` +
+        Object.entries(controls).map(([k, v]) => `${k}: ${say(v.reads).join(" | ")}`).join("\n"),
+    );
+    // THE GATE, on the tree.
+    expect(L.unguarded, "every numeral in the ledger comment is a ledger figure or an allowed phrase").toEqual([]);
+    expect(opClause(L.opacity, srcOp, shipped.ops), `opacity: ledger ${L.opacity}, source ${srcOp}, computed ${shipped.ops}`).toBe(true);
+    expect(paintClause(L.rows, shipped.reads), lines.join("\n")).toBe(true);
+    expect(wholeClause(L.whole, shipped.reads), `whole ring: ledger ${JSON.stringify(L.whole)}\n${lines.join("\n")}`).toBe(true);
+    expect(visibleClause(shipped.reads), lines.join("\n")).toBe(true);
+    // ITS CONTROLS, same run.
+    expect(opClause(L.opacity, srcOp, controls["ablated-0.9"].ops), "control: tier 2 ablated to 0.9 reds the opacity clause").toBe(false);
+    for (const [k, v] of Object.entries(controls)) expect(paintClause(L.rows, v.reads), `control ${k} reds the paint clause`).toBe(false);
+    for (const k of ["faint-0.15", "X1-opacity-0", "X2-transparent"] as const)
+      expect(visibleClause(controls[k].reads), `control ${k} reds the visibility clause`).toBe(false);
+    expect(wholeClause(L.whole, controls["faint-0.15"].reads), "control: the faint ring reds the whole-ring clause").toBe(false);
+    const t2 = CELL_CSS.indexOf(`${TIER2} {`);
+    const t2end = CELL_CSS.indexOf("}", t2);
+    const mutated = CELL_CSS.slice(0, t2) + CELL_CSS.slice(t2, t2end).replace(/stroke-opacity:\s*[\d.]+/, "stroke-opacity: 0.9") + CELL_CSS.slice(t2end);
+    expect(opClause(L.opacity, tier2(mutated), shipped.ops), "control: the source text moved reds the opacity clause").toBe(false);
+    const falsified = ledger(INDEX_CSS.replace(/(\b(?:light|dark) )(\d+\.\d+) \/ (\d+\.\d+)/g, "$19.99 / 9.99"));
+    expect(falsified.rows.length, "control: the falsified ledger still parses").toBe(3);
+    expect(paintClause(falsified.rows, shipped.reads), "control: every figure falsified to 9.99 reds the paint clause").toBe(false);
+    const recount = ledger(INDEX_CSS.replace(/(under 3:1 of 240\s+light )\d+ \/ \d+/, "$10 / 0"));
+    expect(wholeClause(recount.whole, shipped.reads), "control: the whole-ring count falsified to 0 reds its clause").toBe(false);
+    // The figure clause's plants: every numeral shape, and a guarded figure absent from the text
+    // (a ledger restated at a one-decimal opacity) must not eat a stray one.
+    const at = "Until the owner rules,";
+    for (const [plant, want] of [
+      ["The deck card reads 4.15.", ["4.15"]],
+      ["The deck card reads 1.8 dark.", ["1.8"]],
+      ["It is 2.4:1 there.", ["2.4", "1"]],
+      ["About 35 % of it.", ["35"]],
+      ["It sits 4 px out.", ["4"]],
+      ["It reads 2,40 there.", ["2,40"]],
+    ] as [string, string[]][])
+      expect(ledger(INDEX_CSS.replace(at, `${plant} ${at}`)).unguarded, `control: the plant "${plant}" reds the figure clause`).toEqual(want);
+    const oneDecimal = ledger(INDEX_CSS.replace(/(tier 2 at\s+stroke-opacity )\d+(?:\.\d+)?/, (_m, head: string) => `${head}1.0`).replace(at, `The guard's faces read 4.15. ${at}`));
+    expect(oneDecimal.opacity, "control: the one-decimal opacity parses").toBe(1);
+    expect(oneDecimal.unguarded, "control: a one-decimal opacity eats no stray figure").toEqual(["4.15"]);
+  });
+
+  test("G-ABS-7 · MA-N from the DOM: no ring enters its neighbour (G-ABS-8 identity; the inset witness)", async ({ page }) => {
+    test.setTimeout(180000);
+    await loadBoard(page, 4);
+    const cells = await page.evaluate(() =>
+      [...document.querySelectorAll(".board-shell .game-cell")].map((cell) => {
+        const p = cell.querySelector(".cell-ghost-path") as SVGPathElement;
+        const m = p.getScreenCTM()!;
+        const r = cell.getBoundingClientRect();
+        return { d: p.getAttribute("d")!, m: [m.a, m.d, m.e, m.f], box: [r.x, r.y, r.width, r.height] };
+      }),
+    );
+    const N = 16,
+      V = 1000,
+      cs = V / N,
+      SEED = 42;
+    // The recipe of `generateCellRects` (gridPaths.ts), inset free; G-ABS-8 below proves it IS the
+    // product at RING_GEOMETRY before the witness is allowed to speak.
+    const ring = (pos: number, inset: number) => {
+      const size = inset * cs,
+        pad = ((1 - inset) / 2) * cs;
+      const r = Math.floor(pos / N),
+        c = pos % N;
+      return wobbleRect(c * cs + pad, r * cs + pad, size, size, {
+        roughness: RING_GEOMETRY.wanderUnits / (0.015 * size),
+        segments: 4,
+        seed: SEED + 500 + pos * 7,
+        jagged: true,
+      });
+    };
+    const clearance = (d: string, m: number[], box: number[], stroke: number) => {
+      let worst = Infinity;
+      for (const g of d.matchAll(/[ML]\s*(-?[\d.eE+]+),(-?[\d.eE+]+)/g)) {
+        const x = m[2] + m[0] * +g[1],
+          y = m[3] + m[1] * +g[2];
+        const hs = (stroke / 2) * m[0];
+        worst = Math.min(worst, x - hs - box[0], box[0] + box[2] - (x + hs), y - hs - box[1], box[1] + box[3] - (y + hs));
+      }
+      return worst;
+    };
+    // 74a2b5d9's own recipe, for the record: roughness 0.4 of the edge, 2 segments at 16×16, no
+    // inset. It clears MA-N on its own; the inset pays for the wander THIS recipe adds, not for a
+    // defect the old ring had.
+    const head = (pos: number) =>
+      wobbleRect((pos % N) * cs, Math.floor(pos / N) * cs, cs, cs, { roughness: 0.4, segments: 2, seed: SEED + 500 + pos * 7, jagged: true });
+    const identical = cells.filter((c, pos) => c.d === ring(pos, RING_GEOMETRY.inset)).length;
+    expect(identical, "G-ABS-8: every resident `d` is the recipe at RING_GEOMETRY").toBe(N * N);
+    for (const stroke of [7, 10]) {
+      const product = Math.min(...cells.map((c) => clearance(c.d, c.m, c.box, stroke)));
+      const witness = Math.min(...cells.map((c, pos) => clearance(ring(pos, 1), c.m, c.box, stroke)));
+      const was = Math.min(...cells.map((c, pos) => clearance(head(pos), c.m, c.box, stroke)));
+      const alt = Math.min(...cells.map((c, pos) => clearance(ring(pos, 0.9), c.m, c.box, stroke)));
+      console.log(
+        `[G-ABS-7] stroke ${stroke}: product ${r3(product)} px · the banked alternate inset 0.90 ${r3(alt)} px · this wander at inset 1.00 ${r3(witness)} px · 74a2b5d9's recipe ${r3(was)} px · identical ${identical}/${N * N} · scale ${r3(cells[0].m[0])} px/u (ghost svg) · cell pitch ${r3(cells[0].box[2] / cs)} px/u`,
+      );
+      expect(product, `G-ABS-7 stroke ${stroke}: the ring's outer ink stays inside its own cell (px)`).toBeGreaterThanOrEqual(0);
+      if (stroke === 10) expect(witness, "the inset witness: THIS wander at inset 1.00 enters the neighbour (px)").toBeLessThan(0);
+    }
+  });
+});
+
+// ── the chrome ring ──────────────────────────────────────────────────────────────────────────
+const WALK = 'a[href], button, input:not([type=hidden]), select, textarea, [tabindex]:not([tabindex="-1"])';
+/** Three hosts wear their ring on a descendant (the deck's card, the staging and guard faces). */
+const HOSTS: [string, string][] = [
+  [".gallery-viewport", ".game-card.is-center"],
+  [".staging-btn", ".staging-face"],
+  [".guard-btn", ".guard-face"],
+];
+const stops = (page: Page) =>
+  page.evaluate((sel) => {
+    const out: string[] = [];
+    for (const n of document.querySelectorAll<HTMLElement>(sel)) {
+      const r = n.getBoundingClientRect();
+      const cs = getComputedStyle(n);
+      if (!r.width || !r.height || cs.visibility === "hidden" || cs.display === "none" || n.closest("[inert]")) continue;
+      const key = `${n.tagName.toLowerCase()}.${(n.getAttribute("class") || "").trim().split(/\s+/)[0]}`;
+      if (!out.includes(key)) out.push(key);
+    }
+    return out;
+  }, WALK);
+/** Keyboard modality first (a key press), then focus: the stop matches `:focus-visible` as a Tab
+ *  would leave it, and the first frame's computed ring is read one rAF after `focus()`. */
+const focusStop = async (page: Page, key: string) => {
+  await page.keyboard.press("Shift");
+  return page.evaluate(
+    async ({ key, HOSTS }) => {
+      const [tag, cls] = key.split(".");
+      const el = [...document.querySelectorAll<HTMLElement>(tag)].find((n) => (n.getAttribute("class") || "").trim().split(/\s+/)[0] === cls)!;
+      (document.activeElement as HTMLElement)?.blur?.();
+      await new Promise((r) => requestAnimationFrame(r));
+      el.focus();
+      await new Promise((r) => requestAnimationFrame(r));
+      let host = el;
+      for (const [f, h] of HOSTS) if (el.matches(f)) host = ((f === ".gallery-viewport" ? document : el).querySelector(h) as HTMLElement) ?? el;
+      const first = getComputedStyle(host);
+      // A disabled or inert control never takes focus: it is not a stop, and the walk says so.
+      return { took: document.activeElement === el, firstColour: first.outlineColor, firstStyle: first.outlineStyle };
+    },
+    { key, HOSTS },
+  );
+};
+const hostRing = (page: Page) =>
+  page.evaluate((HOSTS) => {
+    const el = document.activeElement as HTMLElement;
+    let host = el;
+    for (const [f, h] of HOSTS) if (el.matches(f)) host = ((f === ".gallery-viewport" ? document : el).querySelector(h) as HTMLElement) ?? el;
+    const cs = getComputedStyle(host);
+    const r = host.getBoundingClientRect();
+    // The ink as sRGB bytes whatever its serialisation (`rgb()`, `color(srgb … / a)`, `oklab()`):
+    // the page's own canvas resolves it.
+    const cv = document.createElement("canvas").getContext("2d", { willReadFrequently: true })!;
+    cv.fillStyle = cs.outlineColor;
+    cv.fillRect(0, 0, 1, 1);
+    const px = cv.getImageData(0, 0, 1, 1).data;
+    return {
+      fv: el.matches(":focus-visible"),
+      ink: [px[0], px[1], px[2], px[3] / 255],
+      colour: cs.outlineColor,
+      style: cs.outlineStyle,
+      w: parseFloat(cs.outlineWidth) || 0,
+      off: parseFloat(cs.outlineOffset) || 0,
+      radius: cs.borderRadius,
+      rect: { x: r.x, y: r.y, w: r.width, h: r.height },
+    };
+  }, HOSTS);
+
+/** The deck, where the three descendant hosts live: the centre card and the staging faces. */
+async function openGallery(page: Page) {
+  await page.goto(`/?view=gallery&size=3&board=${mint(3)}`);
+  await expect(page.locator(".staging-band")).toBeVisible({ timeout: 30000 });
+  await settled(page);
+}
+/** The armed guard: an entry on the board (so leaving costs something), the deck opened from
+ *  the logo, the deck moved off the current game, Deal pressed. The theme is set BEFORE this. */
+async function armGuard(page: Page) {
+  const blank = await page.evaluate(() => [...document.querySelectorAll(".board-shell .game-cell")].findIndex((c) => !c.querySelector(".glyph-svg")));
+  expect(blank, "an empty cell to write in").toBeGreaterThanOrEqual(0);
+  await page.locator(".board-shell .game-cell .cell-native-input").nth(blank).focus();
+  await page.keyboard.press("1");
+  await expect.poll(() => page.evaluate((i) => !!document.querySelectorAll(".board-shell .game-cell")[i].querySelector(".glyph-svg"), blank)).toBe(true);
+  await page.locator("button.logo-trigger").focus();
+  await page.keyboard.press("Enter");
+  await expect(page.locator(".staging-band")).toBeVisible({ timeout: 20000 });
+  await settled(page);
+  await page.locator(".gallery-viewport").focus();
+  for (let i = 0; i < 4; i++) {
+    await page.keyboard.press("ArrowRight");
+    await settled(page);
+  }
+  await page.locator(".staging-deal").focus();
+  await page.keyboard.press("Enter");
+  await expect(page.locator(".gallery-guard")).toBeVisible({ timeout: 10000 });
+  await settled(page);
+}
+/** The walk's key for a descendant host's owner (`div.gallery-viewport`, `button.staging-btn`, …). */
+const hostKey = (keys: string[], owner: string) => keys.find((k) => k.split(".")[1] === owner.slice(1));
+
+test.describe("MRK-ABS · the chrome ring", () => {
+  test("G-ABS-4 · one ink on every game route, the deck and the armed guard, no `auto`, the final colour on the first frame", async ({ page }) => {
+    test.setTimeout(420000);
+    const census = async (min: number) => {
+      const rows: { stop: string; colour: string; style: string; sameFrame: boolean }[] = [];
+      for (const key of await stops(page)) {
+        if (key === "input.cell-native-input") continue; // the cell's mark is the drawn ghost (G-ABS-5)
+        const first = await focusStop(page, key);
+        if (!first.took) continue;
+        await settled(page);
+        const h = await hostRing(page);
+        rows.push({ stop: key, colour: h.colour, style: h.style, sameFrame: first.firstColour === h.colour && first.firstStyle === h.style });
+      }
+      const inks = new Set(rows.filter((r) => r.style === "solid").map((r) => r.colour));
+      const law39 = rows.filter((r) => r.style === "dashed").map((r) => r.stop);
+      return {
+        rows,
+        clause:
+          rows.length >= min &&
+          inks.size === 1 &&
+          rows.every((r) => r.style === "solid" || (r.style === "dashed" && r.stop === "button.drawer-tab")) &&
+          rows.every((r) => r.sameFrame) &&
+          law39.length <= 1,
+        inks: [...inks],
+        autos: rows.filter((r) => r.style === "auto").length,
+      };
+    };
+    const tell = (c: Awaited<ReturnType<typeof census>>) => `inks ${c.inks.join(" | ")} · auto ${c.autos} · ${c.rows.map((r) => `${r.stop} ${r.style} ${r.colour}${r.sameFrame ? "" : " LATE"}`).join(", ")}`;
+    let token: string | null = null;
+    for (const game of ["sudoku", "futoshiki", "thermo", "killer", "kenken"])
+      for (const theme of ["light", "dark"] as const) {
+        await page.goto(`/?game=${game}`);
+        await expect.poll(() => page.locator(".board-shell .game-cell").count(), { timeout: 60000 }).toBeGreaterThan(0);
+        await setTheme(page, theme);
+        const c = await census(6);
+        expect(c.clause, `${game} ${theme}: ${tell(c)}`).toBe(true);
+        if (theme === "light") token ??= c.inks[0];
+        expect(c.inks[0], "the one ink is one value in both themes (R1)").toBe(token);
+      }
+    // The three hosts that wear the ring on a descendant: the deck's centre card and the staging
+    // faces (the gallery route), the guard's faces (the armed guard). Each must be REACHED.
+    for (const theme of ["light", "dark"] as const) {
+      await openGallery(page);
+      await setTheme(page, theme);
+      const deck = await census(2);
+      expect(hostKey(deck.rows.map((r) => r.stop), ".gallery-viewport"), `gallery ${theme}: the deck is walked\n${tell(deck)}`).toBeTruthy();
+      expect(hostKey(deck.rows.map((r) => r.stop), ".staging-btn"), `gallery ${theme}: a staging face is walked\n${tell(deck)}`).toBeTruthy();
+      expect(deck.clause && deck.inks[0] === token, `gallery ${theme}: ${tell(deck)}`).toBe(true);
+      await loadBoard(page, 3);
+      await setTheme(page, theme);
+      await armGuard(page);
+      const guard = await census(1);
+      expect(hostKey(guard.rows.map((r) => r.stop), ".guard-btn"), `guard ${theme}: a guard face is walked\n${tell(guard)}`).toBeTruthy();
+      expect(guard.clause && guard.inks[0] === token, `guard ${theme}: ${tell(guard)}`).toBe(true);
+    }
+    // CONTROL: one stop drawn with the browser's own ring.
+    await inject(page, ".guard-btn:focus-visible .guard-face{outline:auto!important}", "g-abs-4-control");
+    const ctl = await census(1);
+    expect(ctl.autos, "control: the injected `auto` is seen").toBeGreaterThan(0);
+    expect(ctl.clause, "control: an `auto` ring reds the clause").toBe(false);
+  });
+
+  test("G-ABS-4f · forced colours: every ring the estate draws takes the system's Highlight", async ({ page }) => {
+    test.setTimeout(300000);
+    await page.emulateMedia({ forcedColors: "active", reducedMotion: "reduce" });
+    const highlight = () =>
+      page.evaluate(() => {
+        const d = document.createElement("div");
+        d.style.color = "Highlight";
