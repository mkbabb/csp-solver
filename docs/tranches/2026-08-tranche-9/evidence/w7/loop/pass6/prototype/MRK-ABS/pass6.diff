+
+  test("G-ABS-3 · the chrome ring's painted floor, boil parked: the home stops, the deck, the armed guard", async ({ page }, info) => {
+    test.setTimeout(420000);
+    const engine = info.project.name as Engine;
+    await page.emulateMedia({ reducedMotion: "reduce" });
+    // ADMITTED: a stop allowed a fraction of sample lines under 3:1, WITH the value, per engine and
+    // theme; it reds STALE when the stop obeys the rule. `.info-btn`'s right side crosses the
+    // controls card's drawn case edge (a layout row: T9-B8 / M18 moves the bar and its ground);
+    // the tab's dashed `currentColor` is law 39's form, the chair's row.
+    const ADMITTED: Record<string, { why: string; max: Record<Engine, Record<"light" | "dark", number | null>> }> = {
+      // The values are the parked readings (spread 0 over five reads, pass-5 MRK-ABS `spread-*.json`);
