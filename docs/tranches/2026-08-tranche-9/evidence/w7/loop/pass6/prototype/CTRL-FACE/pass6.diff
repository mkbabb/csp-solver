+/* ══ 8 · THE FACE LAW IS KEYED BY THE RENDERED FAMILY ══════════════════════════════════════ */
+
+/**
+ * PASS 4 — the cure for the hole the critic opened with two lines on a scratch tree.
+ *
+ * `scripts/check-font-coverage.mjs` CHECK 6 built its class list out of its own keys, so a rule
+ * block whose selector carried no listed class was invisible to it: neither "an undeclared home"
+ * nor "a law with no home". `StagingBand.vue` renders `class="section-heading
+ * staging-axis-label"` on ONE element and `.staging-axis-label` won the cascade there, so the
+ * deck's axis label painted `Patrick Hand · 16 · 800` under a law that said Fraunces — and the
+ * check printed `font coverage OK`. Both falsifications passed: re-point `.staging-axis-label`
+ * to `var(--font-display)`, exit 0; put a literal `"Comic Sans MS", cursive` on it, exit 0.
+ *
+ * THE LAW HAS ONE HOME AND TWO READINGS. `FACE_SITES` in that script is the source-side census;
+ * this row PARSES THAT LITERAL and re-keys it over what the browser actually computed. The table
+ * is ORDERED — the LAST entry whose selector matches an element is the family that element must
+ * paint — so a class that legitimately overrides another is written down as the override rather
+ * than hiding behind it. `:deep(...)` is a compiler wrapper, not a DOM selector, and is unwrapped.
+ *
+ * It runs on the CARD route and the GALLERY route, because the hole was on the gallery.
+ */
+const FACE_LAW: [string, string][] = (() => {
+  const src = readFileSync(
+    fileURLToPath(new URL("../scripts/check-font-coverage.mjs", import.meta.url)),
+    "utf8",
+  );
+  const body = /const FACE_SITES = \{([\s\S]*?)\n\};/.exec(src);
+  if (!body) throw new Error("FACE_SITES not found in check-font-coverage.mjs");
+  const rows: [string, string][] = [];
+  for (const m of body[1].matchAll(/^\s*"([^"]+)":\s*"([^"]+)",/gm))
+    rows.push([m[1].replace(/:deep\(([^)]*)\)/g, "$1"), m[2]]);
+  return rows;
+})();
+
+for (const [label, route, use] of [
+  ["the card · 1280 fine", "size=3&difficulty=EASY", {}],
+  ["the card · 390×844 coarse", "size=3&difficulty=EASY", coarse(390, 844)],
+  ["the gallery · 1280 fine", "view=gallery&size=3&difficulty=MEDIUM", {}],
+] as const) {
+  test.describe(`the face law, rendered — ${label}`, () => {
+    test.use(use);
+
+    test("every element the law matches paints the family the law's LAST match names", async ({
+      page,
+    }) => {
+      if (route.startsWith("view=gallery")) {
+        await page.emulateMedia({ reducedMotion: "reduce" });
+        await page.goto("./?" + route);
+        await page.waitForSelector("svg.handwritten-logo", { timeout: 20000 });
+        await page.addStyleTag({ content: ".tuner-toggle { display: none !important; }" });
+      } else {
+        await loadCard(page, route);
+      }
+
+      // PASS 5 — THE FAMILY IS READ ON THE ELEMENT THAT OWNS THE TEXT. Pass 4 read the MATCHED
+      // element's computed family, so a face set on an unlisted DESCENDANT was invisible: the
+      // critic put `"Comic Sans MS", cursive` on `.ctrl-word` (the span every chip's word is),
+      // every chip painted it, and `.ctrl-btn` still reported the hand. Now every visible text
+      // node is judged: its law is the nearest ancestor-or-self the table matches (the LAST
+      // matching entry at that element), and its paint is its own parent element's family.
+      const read = (law: [string, string][]) => {
+        const seen: {
+          sel: string;
+          want: string;
+          got: string;
+          owner: string;
+          size: number;
+          text: string;
+        }[] = [];
+        const lawAt = (el: Element): [string, string] | null => {
+          let hit: [string, string] | null = null;
+          for (const [s, family] of law) if (el.matches(s)) hit = [s, family];
+          return hit;
+        };
+        const done = new Set<Element>();
+        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
+        for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+          if (!(n.textContent ?? "").trim()) continue;
+          const owner = n.parentElement;
+          if (!owner || done.has(owner)) continue;
+          done.add(owner);
+          if (!owner.getClientRects().length) continue;
+          let hit: [string, string] | null = null;
+          for (let a: Element | null = owner; a && !hit; a = a.parentElement) hit = lawAt(a);
+          if (!hit) continue;
+          const cs = getComputedStyle(owner);
+          seen.push({
+            sel: hit[0],
+            want: hit[1],
+            got: cs.fontFamily.split(",")[0].replace(/["']/g, "").trim(),
+            owner: owner.tagName.toLowerCase() + (owner.classList[0] ? "." + owner.classList[0] : ""),
+            size: Math.round(parseFloat(cs.fontSize) * 1000) / 1000,
+            text: (owner.textContent ?? "").trim().slice(0, 24),
+          });
+        }
+        return seen;
+      };
+
+      const rows = await page.evaluate(read, FACE_LAW);
+      const wrong = rows.filter((r) => r.got !== r.want);
+
+      test.info().annotations.push({
+        type: "face-law-rendered",
+        description:
+          `${rows.length} elements matched, ${wrong.length} off-law · ` +
+          [...new Set(rows.map((r) => `${r.sel}→${r.got}`))].join(" · "),
+      });
+
+      expect(rows.length, "the law reaches at least one element on this route").toBeGreaterThan(0);
+      expect(
+        wrong.map((w) => `${w.sel} "${w.text}" paints ${w.got}, the law says ${w.want}`),
+        "every element the law matches paints its declared family",
+      ).toEqual([]);
+
+      // ── BORN-RED, BOTH WAYS, IN THIS SAME RUN ─────────────────────────────────────────────
+      // (i) a LITERAL family — the one thing the coverage check's own header promises to red,
+      //     and the falsification that passed it at exit 0 through pass 3.
+      // (ii) a re-point to the OTHER estate face — the subtler one, where every string is a
+      //      legitimate token and only the rendered family says which law is being broken.
+      // PASS 5 — THE NEGATIVE CONTROL IS ASSERTED ON EVERY ROUTE. Pass 4's target was the
+      // table's LAST entry, which renders only on the gallery, so both card routes carried an
+      // annotation where a born-RED belonged. `.ctrl-word` is the word inside every chip and
+      // renders on all three routes (the card's chips AND the deck's), is listed NOWHERE in the
+      // table, and is exactly the critic's plant — so it is the one target that proves the
+      // owner-of-the-text reading. The table's last entry is kept as a second target where it
+      // renders.
+      expect(
+        rows.some((r) => r.owner.startsWith("span.ctrl-word")),
+        "`.ctrl-word` renders on this route (the negative control's target)",
+      ).toBe(true);
+      const lastEntry = FACE_LAW[FACE_LAW.length - 1][0];
+      const targets = [".ctrl-word", ...(rows.some((r) => r.sel === lastEntry) ? [lastEntry] : [])];
+      for (const target of targets)
+        for (const [why, css] of [
+          ["a literal family string", `${target} { font-family: "Comic Sans MS", cursive !important }`],
+          ["a re-point to the printed face", `${target} { font-family: var(--face-printed) !important }`],
+        ] as const) {
+          const handle = await page.addStyleTag({ content: css });
+          const after = await page.evaluate(read, FACE_LAW);
+          await handle.evaluate((n) => (n as unknown as HTMLElement).remove());
+          const broke = after.filter((r) => r.got !== r.want);
+          test.info().annotations.push({
+            type: "face-law-ablation",
+            description: `${why} on \`${target}\` → ${broke.length} off-law (${[...new Set(broke.map((b) => b.got))].join(", ")})`,
+          });
+          expect(broke.length, `the negative control: ${why} on \`${target}\` reds the law`).toBeGreaterThan(0);
+        }
+    });
+  });
+}
+
+/* ══ 9 · THE CASE-WIDE OCCLUSION GATE (§10's leader; every §10 lane runs this) ══════════════ */
+
+/**
+ * THIRD OCCURRENCE OF ONE CLASS, so it becomes a law with a home rather than a third finding:
+ * CTRL-RULE arm (a)'s sticky pin covered 38.8 % of the name it pinned, W2's hover notes 68.4 %,
+ * and the confirm ribbon 100 %. Each was found by a different lane with a different instrument,
+ * and each instrument was wrong in one of the three ways CTRL-RULE's critic fixed:
+ *
+ *   1 A PSEUDO-ELEMENT IS A SURFACE. `::before` / `::after` paint over text and appear in no
+ *     `querySelectorAll`. They have no rect API either, so each one's box is RECONSTRUCTED from
+ *     its host's border box and its own resolved inset/size — an approximation, declared here,
+ *     and it is why this row reports a coverage FRACTION rather than a pixel-exact area.
+ *   2 EVERY SURFACE IS CLIPPED TO ITS SCROLLPORT. The controls card IS a scrollport: an
+ *     absolutely-positioned child that extends past it is not painted there, and counting its
+ *     whole rect reports occlusion that nobody can see.
+ *   3 THE NAME IS A TEXT RANGE. An element's border box includes its padding and its flex
+ *     stretch; the ink is the Range over its text nodes. A pin that covers a caption's padding
+ *     covers nothing, and the 38.8 % reading was only possible because the box was the subject.
+ *
+ * The named surfaces are the case's whole furniture: the card, the foot, the sheet, and every
+ * element in the case whose computed position is sticky / fixed / absolute.
+ */
+test.describe("the case-wide occlusion gate", () => {
+  for (const [label, use] of [
+    ["390×844 coarse", coarse(390, 844)],
+    ["1280 fine", {}],
+  ] as const) {
+    test.describe(label, () => {
+      test.use(use);
+
+      test("no surface in the case covers any printed or written NAME", async ({ page }) => {
+        await loadCard(page);
+
+        const scan = (nameSel: string) => {
+          const px = (n: number) => Math.round(n * 100) / 100;
+          const inter = (a: DOMRect | DOMRectReadOnly, b: DOMRect | DOMRectReadOnly) => {
+            const w = Math.min(a.right, b.right) - Math.max(a.left, b.left);
+            const h = Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top);
+            return w > 0 && h > 0 ? w * h : 0;
+          };
+          const clipTo = (r: DOMRect, port: DOMRect | null): DOMRect => {
+            if (!port) return r;
+            const left = Math.max(r.left, port.left);
+            const top = Math.max(r.top, port.top);
+            const right = Math.min(r.right, port.right);
+            const bottom = Math.min(r.bottom, port.bottom);
+            return new DOMRect(left, top, Math.max(0, right - left), Math.max(0, bottom - top));
+          };
+          /** The nearest ancestor that clips — a scrollport, or a box with hidden overflow. */
+          const scrollport = (el: Element): DOMRect | null => {
+            for (let p = el.parentElement; p; p = p.parentElement) {
+              const cs = getComputedStyle(p);
+              if (/(auto|scroll|hidden|clip)/.test(cs.overflow + cs.overflowX + cs.overflowY))
+                return p.getBoundingClientRect();
+            }
+            return null;
+          };
+
+          const cases = [...document.querySelectorAll(".controls-card, .card-foot, .drawer-case")];
+          const root = cases.find((c) => c.getClientRects().length) ?? document.body;
+
+          // THE NAMES, AS TEXT RANGES.
+          const names: { text: string; rect: DOMRect; area: number; el: Element }[] = [];
+          for (const el of root.querySelectorAll(nameSel)) {
+            if (!(el as HTMLElement).getClientRects().length) continue;
+            const rng = document.createRange();
+            rng.selectNodeContents(el);
+            const rects = [...rng.getClientRects()].filter((r) => r.width > 0 && r.height > 0);
+            rng.detach?.();
+            if (!rects.length) continue;
+            const port = scrollport(el);
+            for (const raw of rects) {
+              const r = clipTo(raw as DOMRect, port);
+              if (r.width <= 0 || r.height <= 0) continue;
+              names.push({ text: (el.textContent ?? "").trim().slice(0, 24), rect: r, area: r.width * r.height, el });
+            }
+          }
+
+          // THE SURFACES: positioned elements, and their two pseudo-elements.
+          //
+          // TWO EXEMPTIONS, BOTH FOUND BY RUNNING THIS ROW RATHER THAN BY WRITING IT. The first
+          // form reported 48 intersections on a card with no defect in it:
+          //   · A SURFACE THAT PAINTS NOTHING IS NOT AN OCCLUDER. `HandDrawnOutline` puts an
+          //     absolutely-positioned `<svg>` over the whole of every well and every card; it
+          //     paints a STROKE at the edges and is transparent everywhere else, so counting its
+          //     rect read "100% covered" on all eight names at once. The predicate is therefore
+          //     a painted ground — a non-transparent `background-color`, a `background-image`, a
+          //     `box-shadow` or a `backdrop-filter`. This is a real narrowing and it is stated
+          //     rather than hidden: an SVG that FILLS its box would be exempted wrongly, and the
+          //     estate ships none (checked: every `HandDrawnOutline` path is `fill: none`).
+          //   · A NAME DOES NOT OCCLUDE ITSELF. A tag tape is `span.washi-label.washi-tag` — one
+          //     element that is both the name and a positioned paper surface — so it reported
+          //     covering its own text 94.35%. A surface that CONTAINS or IS CONTAINED BY the
+          //     name is skipped; only a sibling surface can be over it.
+          const paints = (cs: CSSStyleDeclaration) => {
+            const bg = cs.backgroundColor;
+            // THE ALPHA IS THE FOURTH COMPONENT, NOT THE LAST ONE. The first form tested
+            // `/rgba?\([^)]*,\s*0\s*\)$/`, which matches `rgb(255, 0, 0)` — a pure red read as
+            // transparent, and the planted occluder below was silently not a surface at all
+            // while the ablation still "passed" on the inherited count. Parse the components.
+            const parts = /^rgba?\(([^)]*)\)/.exec(bg || "");
+            const alpha = parts ? parseFloat(parts[1].split(/[,\s/]+/).filter(Boolean)[3] ?? "1") : 0;
+            const opaqueBg = !!bg && bg !== "transparent" && alpha > 0.02;
+            return (
+              opaqueBg ||
+              cs.backgroundImage !== "none" ||
+              (cs.boxShadow !== "none" && cs.boxShadow !== "") ||
+              (cs.backdropFilter !== "none" && cs.backdropFilter !== "")
+            );
+          };
+          const surfaces: { what: string; rect: DOMRect; el: Element | null }[] = [];
+          for (const el of root.querySelectorAll("*")) {
+            const cs = getComputedStyle(el);
+            const h = el as HTMLElement;
+            const box = h.getBoundingClientRect();
+            const port = scrollport(el);
+            const opaque =
+              cs.visibility !== "hidden" && cs.display !== "none" && parseFloat(cs.opacity) > 0.02;
+            if (
+              opaque &&
+              paints(cs) &&
+              /^(sticky|fixed|absolute)$/.test(cs.position) &&
+              box.width &&
+              box.height
+            )
+              surfaces.push({
+                what: `${el.tagName.toLowerCase()}.${(el.className || "").toString().split(/\s+/)[0]}`,
+                rect: clipTo(box, port),
+                el,
+              });
+            for (const pe of ["::before", "::after"]) {
+              const ps = getComputedStyle(el, pe);
+              if (ps.content === "none" || ps.content === "normal") continue;
+              if (!/^(sticky|fixed|absolute)$/.test(ps.position)) continue;
+              if (parseFloat(ps.opacity) <= 0.02 || ps.visibility === "hidden") continue;
+              // RECONSTRUCTED, and only for a pseudo whose own box is resolvable: a `width`/
+              // `height` in px with at least one inset. An `auto` box is reported unresolvable
+              // rather than guessed, because a guessed surface is a false red waiting to happen.
+              const num = (v: string) => (/px$/.test(v) ? parseFloat(v) : NaN);
+              const w = num(ps.width);
+              const hh = num(ps.height);
+              const l = num(ps.left);
+              const t = num(ps.top);
+              const rr = num(ps.right);
+              const bb = num(ps.bottom);
+              if (!paints(ps)) continue;
+              if ([w, hh].some(Number.isNaN)) {
+                surfaces.push({
+                  what: `${el.tagName.toLowerCase()}${pe} (UNRESOLVED)`,
+                  rect: new DOMRect(0, 0, 0, 0),
+                  el,
+                });
+                continue;
+              }
+              // BOTH AXES, FROM EITHER END. The first form defaulted an unresolvable `top` to
+              // the host's top edge, which puts a `bottom: 0` fade at the WRONG end of its bar
+              // and invents a 100% cover on the name above it. A box that resolves from neither
+              // end is UNRESOLVED and reported, never placed.
+              const x = !Number.isNaN(l)
+                ? box.left + l
+                : !Number.isNaN(rr)
+                  ? box.right - rr - w
+                  : NaN;
+              const y = !Number.isNaN(t)
+                ? box.top + t
+                : !Number.isNaN(bb)
+                  ? box.bottom - bb - hh
+                  : NaN;
+              if (Number.isNaN(x) || Number.isNaN(y)) {
+                surfaces.push({
+                  what: `${el.tagName.toLowerCase()}${pe} (UNRESOLVED POSITION)`,
+                  rect: new DOMRect(0, 0, 0, 0),
+                  el,
+                });
+                continue;
+              }
+              surfaces.push({
+                what: `${el.tagName.toLowerCase()}.${(el.className || "").toString().split(/\s+/)[0]}${pe}`,
+                rect: clipTo(new DOMRect(x, y, w, hh), port),
+                el,
+              });
+            }
+          }
+
+          const hits: { name: string; by: string; frac: number }[] = [];
+          for (const n of names)
+            for (const s of surfaces) {
+              if (!s.rect.width || !s.rect.height) continue;
+              if (s.el && (s.el.contains(n.el) || n.el.contains(s.el))) continue;
+              const a = inter(n.rect, s.rect);
+              if (a <= 0) continue;
+              hits.push({ name: n.text, by: s.what, frac: px((a / n.area) * 100) });
+            }
+          return {
+            names: names.length,
+            surfaces: surfaces.filter((s) => s.rect.width && s.rect.height).length,
+            unresolved: surfaces.filter((s) => /UNRESOLVED/.test(s.what)).length,
+            hits,
+          };
+        };
+
+        const NAME_SEL = ".washi-tag, .zone-row-label, .section-heading, .ctrl-word, .heading-value";
+        const read = await page.evaluate(scan, NAME_SEL);
+
+        test.info().annotations.push({
+          type: "occlusion",
+          description:
+            `${read.names} name ranges × ${read.surfaces} positioned surfaces ` +
+            `(${read.unresolved} pseudo boxes unresolvable, reported not guessed) → ` +
+            `${read.hits.length} intersections` +
+            (read.hits.length
+              ? `: ${read.hits.map((h) => `"${h.name}" ${h.frac}% by ${h.by}`).join(", ")}`
+              : ""),
+        });
+
+        expect(read.names, "the scan found names to protect").toBeGreaterThan(0);
+
+        // ── PASS 6 · THE CEILINGS ARE STRUCK AND THE FOLD'S LAW STANDS IN THEIR PLACE ─────────
+        // Pass 5 keyed sixteen `surface | name` pairs to THIS tree's own reading + 2 (four at 100,
+        // which cannot fire). The critic's two rows: a ceiling keyed to the tree is the tree citing
+        // itself, and a 100 % ceiling is no ceiling. Arm A of B-1 then moved every pair (the card's
+        // band grew 14.4 px) and six went "over" on a card with no new defect — the table measured
+        // WHICH names happen to sit in the bar's band, which is scroll position, not occlusion.
+        // So the gate reads the law the table approximated (W2 §2.3, `scene.css`): NOTHING
+        // STRADDLES THE CASE EDGE. The bar family (`.action-bar`, its opaque skirt `::after`, its
+        // fade `::before`) IS the case edge at the bottom of this scrollport:
+        //   · a name under the OPAQUE edge is either wholly past it (≥ 99.5 %, below the fold) or
+        //     clear of it (0), or the rest of it is under the FADE (the fade reaches card colour
+        //     exactly at the bar's top, so a name straddling that line dissolves into it). A name
+        //     the opaque edge CUTS — part hidden, the rest in plain view — is RED;
+        //   · a name under the FADE is dissolving, which is the fade's one job — printed, not red;
+        //   · EVERY OTHER SURFACE that covers a name is RED, whatever the fraction.
+        // Control 74a2b5d9 under this law: 1280 `pencils` 28.86 + 71.14 = 100 (below the fold),
+        // `marks` 100 (below); 390 `players` 100 by the fade (dissolving) — GREEN, and so is this
+        // tree. Two ablations below, one per clause, each asserted to red in this run.
+        const FOLD = /^div\.action-bar(::after)?$/; // opaque: the bar and its skirt
+        const FADE = /^div\.action-bar::before$/;
+        const judge = (hits: typeof read.hits) => {
+          const opaque = new Map<string, number>();
+          const fade = new Map<string, number>();
+          const fading: string[] = [];
+          const novel: string[] = [];
+          for (const h of hits)
+            if (FOLD.test(h.by)) opaque.set(h.name, (opaque.get(h.name) ?? 0) + h.frac);
+            else if (FADE.test(h.by)) {
+              fade.set(h.name, (fade.get(h.name) ?? 0) + h.frac);
+              fading.push(`"${h.name}" ${h.frac}%`);
+            } else novel.push(`"${h.name}" is ${h.frac}% covered by ${h.by}`);
+          const below = [...opaque].filter(([, f]) => f >= 99.5).map(([n]) => n);
+          const cut = [...opaque]
+            .filter(([n, f]) => f > 0.5 && f < 99.5 && f + (fade.get(n) ?? 0) < 99.5)
+            .map(([n, f]) => `"${n}" cut at ${f.toFixed(2)}% (fade ${(fade.get(n) ?? 0).toFixed(2)}%)`);
+          return { below, fading, cut, novel };
+        };
+        const verdict = judge(read.hits);
+        test.info().annotations.push({
+          type: "occlusion-fold",
+          description: `below the fold ${verdict.below.length} [${verdict.below.join(", ")}] · dissolving ${verdict.fading.length} [${verdict.fading.join(", ")}] · CUT ${verdict.cut.length} · novel ${verdict.novel.length}`,
+        });
+        expect(verdict.cut, "the opaque edge cuts no name").toEqual([]);
+        expect(verdict.novel, "no surface but the fold covers a name").toEqual([]);
+
+        // ── THE FOLD CLAUSE'S OWN BORN-RED: the fade struck (the edge no longer dissolves) and the
+        //    opaque edge walked up its own column 3 px at a time until it lands across a name —
+        //    the first pose where one straddles it must read CUT. No pose in 45 px is a red too.
+        {
+          let found = "";
+          for (let k = 0; k <= 45 && !found; k += 3) {
+            const h = await page.addStyleTag({
+              content: `.action-bar::before { display: none !important } .action-bar { translate: 0 -${k}px !important }`,
+            });
+            await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+            const moved = judge((await page.evaluate(scan, NAME_SEL)).hits);
+            await h.evaluate((n) => (n as unknown as HTMLElement).remove());
+            if (moved.cut.length) found = `fade struck, bar ${k}px up → ${moved.cut.join(", ")}`;
+          }
+          test.info().annotations.push({ type: "occlusion-fold-ablation", description: found || "no cut in 45 px" });
+          expect(found, "the fold clause's plant (fade struck, the edge walked up) cuts a name").not.toBe("");
+        }
+        const novel = read.hits.filter((h) => !FOLD.test(h.by) && !FADE.test(h.by));
+
+        // ── BORN-RED, in this same run: one surface planted over the first name ─────────────
+        const planted = await page.evaluate(
+          ({ sel }) => {
+            const card = [...document.querySelectorAll(".controls-card")].find((c) =>
+              c.getClientRects().length,
+            )!;
+            const victim = [...card.querySelectorAll(sel)].find((e) =>
+              (e as HTMLElement).getClientRects().length,
+            ) as HTMLElement;
+            const r = victim.getBoundingClientRect();
+            // ANCHORED TO THE VICTIM'S PARENT, `absolute`, NOT `fixed` TO THE VIEWPORT. The dock
+            // sheet is a TRANSFORMED ancestor (it slides), and a transform makes itself the
+            // containing block for `position: fixed` — so a plant given viewport coordinates
+            // landed somewhere else entirely and the control read "0 planted hits" on a page
+            // where the plant was on screen. It is a SIBLING of the name, never its ancestor, so
+            // the self-occlusion exemption above does not swallow it.
+            const host = victim.parentElement!;
+            const hs = getComputedStyle(host);
+            if (hs.position === "static") host.style.position = "relative";
+            const hr = host.getBoundingClientRect();
+            const d = document.createElement("div");
+            d.className = "planted-occluder";
+            d.style.cssText = `position:absolute;left:${r.left - hr.left}px;top:${r.top - hr.top}px;width:${r.width}px;height:${r.height}px;background-color:red;z-index:9999;`;
+            host.appendChild(d);
+            return (victim.textContent ?? "").trim().slice(0, 24);
+          },
+          { sel: NAME_SEL },
+        );
+        const after = await page.evaluate(scan, NAME_SEL);
+        await page.evaluate(() => document.querySelector(".planted-occluder")?.remove());
+        // THE PLANT MUST ADD A *NOVEL* HIT, not merely leave the count above zero. The first
+        // form asserted `after.hits.length > 0` — and the baseline is already 1 and 4, so the
+        // row read green with the plant removed. A negative control that the standing state
+        // satisfies is not a control; this is the same defect this pass came to cure, found in
+        // this pass's own new gate on its first run.
+        const plantedHits = after.hits.filter((h) => /planted-occluder/.test(h.by));
+        const novelAfter = after.hits.filter((h) => !FOLD.test(h.by) && !FADE.test(h.by));
+        test.info().annotations.push({
+          type: "occlusion-ablation",
+          description:
+            `a fixed div planted over "${planted}" → ${after.hits.length} intersection(s), ` +
+            `${plantedHits.length} by the plant, novel ${novel.length} → ${novelAfter.length}` +
+            (plantedHits.length ? `: ${plantedHits[0].frac}% on "${plantedHits[0].name}"` : ""),
+        });
+        expect(
+          plantedHits.map((h) => `${h.frac}% on "${h.name}"`),
+          "the negative control: the PLANTED surface is the one that is seen",
+        ).not.toEqual([]);
+        expect(
+          novelAfter.length,
+          "the negative control: the plant moves the NOVEL count off zero",
+        ).toBeGreaterThan(novel.length);
+
+      });
+    });
+  }
+});
+
+/* ══ 9b · THE CASE-WIDE GATE SAMPLES THE CASE'S SCROLL POSES (pass 6, the critic's row) ═══════
+   The rest-only gate above stayed green over W2 §2.5's one live red on this section: at 1440×900
+   the pinned `new game` tape parked 12 px below the paper band over three staged chips at the
+   scroll END, a pose no rest reading visits — and the control carries the same class at
+   mid-scroll poses W2's own row never samples. So the case is walked: every 5 px from the top
+   to the end (and the end itself), two frames after each move so the fold's rAF pass has run,
+   and at each pose every tape's box is intersected with every control in the card, less the
+   paper band the card's fold chrome paints while `data-fold-above` stands (W2's chair ruling,
+   the same subtraction §2.5 makes). A tape is flagged STUCK when its top did not move while the
+   content moved (an in-transit tape is not pinned — TAPE's STUCK predicate); both kinds count,
+   because a control under paper is covered however the paper got there. */
+test.describe("the case-wide occlusion gate, walked", () => {
+  for (const [label, use] of [
+    ["1440×900 fine", { viewport: { width: 1440, height: 900 } }],
+    ["390×844 coarse", coarse(390, 844)],
+  ] as const) {
+    test.describe(label, () => {
+      test.use(use);
+      test("no tape covers a control at ANY scroll pose, top to end", async ({ page }) => {
+        await loadCard(page, M17_PAYLOAD);
+        const POSE = ({ card, sel }: { card: string; sel: string }) => {
+          const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length) as HTMLElement;
+          const cr = root.getBoundingClientRect();
+          const band = root.hasAttribute("data-fold-above")
+            ? cr.top + root.clientTop + parseFloat(getComputedStyle(root).paddingTop)
+            : -Infinity;
+          const controls = [...root.querySelectorAll(sel)].filter((e) => e.getClientRects().length);
+          const tapes = [...root.querySelectorAll(".washi-tag")].filter((t) => {
+            const cs = getComputedStyle(t);
+            return cs.display !== "none" && cs.visibility !== "hidden" && +cs.opacity >= 0.05;
+          });
+          const hits: { tape: string; control: string; px: number; top: number }[] = [];
+          const tops: number[] = [];
+          for (const t of tapes) {
+            const r = t.getBoundingClientRect();
+            tops.push(r.top);
+            for (const c of controls) {
+              if (c.contains(t)) continue;
+              const b = c.getBoundingClientRect();
+              const w = Math.min(b.right, r.right) - Math.max(b.left, r.left);
+              const h = Math.min(b.bottom, r.bottom) - Math.max(b.top, r.top, band, cr.top);
+              if (w > 0 && h > 0 && w * h > 0.5)
+                hits.push({
+                  tape: (t.textContent ?? "").trim(),
+                  control: (c.getAttribute("aria-label") || c.textContent || "").trim().slice(0, 20),
+                  px: Math.round(w * h * 10) / 10,
+                  top: r.top,
+                });
+            }
+          }
+          return { st: root.scrollTop, max: root.scrollHeight - root.clientHeight, hits, tops };
+        };
+        const walk = async (extraCss?: string) => {
+          const h = extraCss ? await page.addStyleTag({ content: extraCss }) : null;
+          const max = await page.evaluate((card) => {
+            const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length) as HTMLElement;
+            return root.scrollHeight - root.clientHeight;
+          }, CARD);
+          const poses = [...new Set([...Array(Math.floor(max / 5) + 1).keys()].map((k) => k * 5).concat(max))];
+          const out: { st: number; hits: { tape: string; control: string; px: number; stuck: boolean }[] }[] = [];
+          let prev: number[] | null = null;
+          for (const st of poses) {
+            await page.evaluate(
+              ({ card, st }) => {
+                const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length) as HTMLElement;
+                root.scrollTop = st;
+                return new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
+              },
+              { card: CARD, st },
+            );
+            const p = await page.evaluate(POSE, { card: CARD, sel: 'button, [role="button"], input, select, a[href]' });
+            out.push({
+              st: p.st,
+              hits: p.hits.map((x) => ({
+                tape: x.tape,
+                control: x.control,
+                px: x.px,
+                stuck: !!prev && prev.some((t) => Math.abs(t - x.top) < 0.5),
+              })),
+            });
+            prev = p.tops;
+          }
+          if (h) await h.evaluate((n) => (n as unknown as HTMLElement).remove());
+          return { max, poses: out };
+        };
+        const clean = await walk();
+        const red = clean.poses.filter((p) => p.hits.length);
+        const worst = red.flatMap((p) => p.hits.map((x) => ({ st: p.st, ...x }))).sort((a, b) => b.px - a.px)[0];
+        test.info().annotations.push({
+          type: "occlusion-walk",
+          description:
+            `${clean.poses.length} poses (range ${clean.max}) → ${red.length} with a covered control` +
+            (worst ? `; worst ${worst.px}px² "${worst.tape}" over "${worst.control}" at st ${worst.st}${worst.stuck ? " (STUCK)" : ""}` : ""),
+        });
+        expect(clean.poses.length, "the walk visits the top, the end and every 5 px between").toBeGreaterThanOrEqual(
+          Math.floor(clean.max / 5) + 1,
+        );
+        expect(
+          red.map((p) => `st ${p.st}: ${p.hits.map((x) => `"${x.tape}" over "${x.control}" ${x.px}px²${x.stuck ? " STUCK" : ""}`).join(", ")}`),
+          "no tape covers a control at any pose",
+        ).toEqual([]);
+        // BORN-RED in the same run: the paper band struck back to 6 px (shallower than any tape the
+        // card lays — the dock utility's own padding, and 14 px under the rail's). A deeper TAPE
+        // is no plant here: the publisher re-reads the tape's box and the band follows it, which is
+        // the cure working (a 16 px deeper tape read 0 of 31 poses covered on the dist).
+        const planted = await walk(".controls-card { padding-top: 6px !important }");
+        const pr = planted.poses.filter((p) => p.hits.length).length;
+        test.info().annotations.push({ type: "occlusion-walk-plant", description: `band struck to 6px → ${pr} of ${planted.poses.length} poses covered` });
+        expect(pr, "the walk's plant (the band struck to 6 px) reds it").toBeGreaterThan(0);
+      });
+    });
+  }
+});
+
+/* ══ 10 · THE TAP FLOOR IS THE BINDING CONSTRAINT, AND THIS IS ITS HEADROOM ════════════════ */
+
+test.describe("the chip's tap box", () => {
+  test.use(coarse(390, 844));
+
+  test("44px is the FLOOR doing the work, and the row says how much is left", async ({ page }) => {
+    await loadCard(page);
+    const read = await page.evaluate((card) => {
+      const px = (n: number) => Math.round(n * 100) / 100;
+      const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!;
+      return [...root.querySelectorAll(".tray-well .ctrl-btn")]
+        .filter((b) => (b as HTMLElement).getClientRects().length)
+        .map((b) => {
+          const s = getComputedStyle(b);
+          const r = b.getBoundingClientRect();
+          const w = b.querySelector(".ctrl-word") as HTMLElement | null;
+          const ws = w ? getComputedStyle(w) : null;
+          const wr = w ? w.getBoundingClientRect() : null;
+          // THE INTRINSIC BOX: what the chip would be if the floor were not there — the word's
+          // own advance plus everything the chip adds around it.
+          const padX = parseFloat(s.paddingLeft) + parseFloat(s.paddingRight);
+          const padY = parseFloat(s.paddingTop) + parseFloat(s.paddingBottom);
+          const wordW = wr && ws ? wr.width - parseFloat(ws.paddingLeft) - parseFloat(ws.paddingRight) : 0;
+          const lh = ws ? parseFloat(ws.lineHeight) : 0;
+          return {
+            text: (b.textContent ?? "").trim(),
+            w: px(r.width),
+            h: px(r.height),
+            intrinsicW: px(wordW + padX),
+            intrinsicH: px(lh + padY),
+            rung: ws ? px(parseFloat(ws.fontSize)) : null,
+            tracking: ws ? ws.letterSpacing : null,
+          };
+        });
+    }, CARD);
+
+    const floor = 44;
+    // THE FLOOR GOVERNS THE CHIPS THAT SIT ON IT, NOT ALL OF THEM. The first form of this row
+    // took the WIDEST intrinsic ("Normal", 75.56) and asserted it under 44, which reds on a card
+    // with nothing wrong with it: a six-letter chip is wider than the floor by design and the
+    // floor never set its width. The chips the floor governs are the ones whose used box IS the
+    // floor (44.00 at every coarse cell — the critic's row 12), and the number that matters is
+    // the LARGEST intrinsic among those: the next rung or tracking change spends that headroom
+    // first, and when it goes the chip rows start setting the card's height instead of the floor.
+    const atFloorW = read.filter((c) => Math.abs(c.w - floor) <= 0.5);
+    const atFloorH = read.filter((c) => Math.abs(c.h - floor) <= 0.5);
+    const worstW = (atFloorW.length ? atFloorW : read).reduce((a, b) =>
+      b.intrinsicW > a.intrinsicW ? b : a,
+    );
+    const worstH = (atFloorH.length ? atFloorH : read).reduce((a, b) =>
+      b.intrinsicH > a.intrinsicH ? b : a,
+    );
+    const headW = Math.round((floor - worstW.intrinsicW) * 100) / 100;
+    const headH = Math.round((floor - worstH.intrinsicH) * 100) / 100;
+
+    test.info().annotations.push({
+      type: "tap-floor-headroom",
+      description:
+        `${read.length} chips · box min ${Math.min(...read.map((c) => c.w))}×${Math.min(...read.map((c) => c.h))} · ` +
+        `rung ${read[0].rung} tracking ${read[0].tracking} · ` +
+        `${atFloorW.length} chips AT the width floor, ${atFloorH.length} at the height floor · ` +
+        `worst at-floor W "${worstW.text}" ${worstW.intrinsicW} (headroom ${headW}) · ` +
+        `worst at-floor H "${worstH.text}" ${worstH.intrinsicH} (headroom ${headH}) · ` +
+        `widest chip overall ${Math.max(...read.map((c) => c.w))}`,
+    });
+
+    // (a) the floor holds — W2's landed token, not this family's.
+    for (const c of read) {
+      expect(c.w, `"${c.text}" meets the 44px tap floor across`).toBeGreaterThanOrEqual(floor - 0.5);
+      expect(c.h, `"${c.text}" meets the 44px tap floor down`).toBeGreaterThanOrEqual(floor - 0.5);
+    }
+    // (b) AND THE FLOOR IS STILL WHAT SETS THOSE BOXES. The pass-3 reading was 44.00×44.00 at
+    // every coarse cell — exactly at the floor, down from HEAD's 48.02–60.02 across — so every
+    // pixel of slack this card had is spent. The numbers below are what is left before the WORD
+    // sets a chip that the floor is currently setting; when they go, the chip rows start setting
+    // the card's height instead. They red on the next rung or tracking change, which is the row
+    // the critic asked for.
+    expect(
+      worstH.intrinsicH,
+      `the tap floor still sets the chip's height: "${worstH.text}" needs ${worstH.intrinsicH}, floor ${floor}, headroom ${headH}`,
+    ).toBeLessThanOrEqual(floor);
+    expect(
+      worstW.intrinsicW,
+      `the tap floor still sets the narrow chips' width: "${worstW.text}" needs ${worstW.intrinsicW}, floor ${floor}, headroom ${headW}`,
+    ).toBeLessThanOrEqual(floor);
+  });
+});
+
+/* ══ 11 · THE REGISTRATION TOOK · THE PUBLISHER RAN (the @property block's clause 4) ══════════ */
+
+/**
+ * PASS 5 — the two rows `index.css`'s block has cited since pass 4 and that existed nowhere.
+ * Clause 4: the born-RED ablation runs on a host that DECLARES the token. `.controls-card` is that
+ * host — its ResizeObserver publishes `--card-pad-t` / `--card-pad-b` onto it inline — and
+ * `--zone-step` is declared statically on `:root` and read inside it.
+ *
+ *   THE REGISTRATION TOOK. An invalid value set on a CHILD of the card computes, for a registered
+ *   `<length>` with `inherits: true`, to the INHERITED value — the card's — and never to the
+ *   literal. Unregistered, the child reads the literal back. The discriminator therefore asserts
+ *   against the ANCESTOR STATED (the card), not the initial (CTRL-TAPE's critic: an assertion on
+ *   the initial greens only while no ancestor declares the name). The same act on the one
+ *   UNREGISTERED name the card publishes, `--action-bar-h`, reads the literal: that is the row's
+ *   own negative control, in the same run.
+ *
+ *   THE PUBLISHER RAN. The card's value is a non-zero px (the rail's `p-5`, the dock's `py-1.5`);
+ *   delete the publisher's inline write and the card reads the registered INITIAL, `0px` exactly —
+ *   the visible failure clause 3 asks for — and never `""` (which is what an unregistered name
+ *   reads with its publisher gone). `--zone-step`'s publisher is a stylesheet line, so it is struck
+ *   with `initial` rather than removed.
+ */
+for (const [label, use] of [
+  ["1280 fine", {}],
+  ["390×844 coarse", coarse(390, 844)],
+] as const) {
+  test.describe(`the registration block, on its declaring host — ${label}`, () => {
+    test.use(use);
+
+    test("THE REGISTRATION TOOK and THE PUBLISHER RAN, with the unregistered control", async ({
+      page,
+    }) => {
+      await loadCard(page);
+      const read = await page.evaluate((cardSel) => {
+        const card = [...document.querySelectorAll<HTMLElement>(cardSel)].find(
+          (c) => c.getClientRects().length,
+        )!;
+        const child = card.querySelector<HTMLElement>(".tray-well") ?? card.firstElementChild as HTMLElement;
+        const v = (el: Element, n: string) => getComputedStyle(el).getPropertyValue(n).trim();
+        const took = (n: string) => {
+          const ancestor = v(card, n);
+          child.style.setProperty(n, "red");
+          const got = v(child, n);
+          child.style.removeProperty(n);
+          return { n, ancestor, got };
+        };
+        const ran = (n: string) => {
+          const published = v(card, n);
+          const inline = card.style.getPropertyValue(n);
+          card.style.removeProperty(n);
+          const without = v(card, n);
+          if (inline) card.style.setProperty(n, inline);
+          return { n, published, inline, without, restored: v(card, n) };
+        };
+        const zone = (() => {
+          const before = v(card, "--zone-step");
+          const s = document.createElement("style");
+          s.textContent = ":root { --zone-step: initial !important; }";
+          document.head.appendChild(s);
+          const without = v(card, "--zone-step");
+          s.remove();
+          return { n: "--zone-step", published: before, without, restored: v(card, "--zone-step") };
+        })();
+        return {
+          took: ["--card-pad-t", "--card-pad-b", "--zone-step"].map(took),
+          control: took("--action-bar-h"),
+          ran: ["--card-pad-t", "--card-pad-b"].map(ran),
+          controlRan: ran("--action-bar-h"),
+          zone,
+        };
+      }, CARD);
+
+      test.info().annotations.push({
+        type: "registration",
+        description:
+          read.took.map((t) => `${t.n}: child←red reads ${t.got} (card ${t.ancestor})`).join(" · ") +
+          ` · CONTROL ${read.control.n} (unregistered): child reads ${read.control.got} · ` +
+          read.ran.map((r) => `${r.n}: ${r.published} → publisher struck → ${r.without}`).join(" · ") +
+          ` · ${read.zone.n}: ${read.zone.published} → struck → ${read.zone.without} · CONTROL ` +
+          `${read.controlRan.n}: ${read.controlRan.published} → struck → "${read.controlRan.without}"`,
+      });
+
+      for (const t of read.took) {
+        expect(t.ancestor, `${t.n} is declared on the card (clause 4's host)`).toMatch(/^[\d.]+px$/);
+        expect(t.got, `THE REGISTRATION TOOK: an invalid ${t.n} inherits the card's value`).toBe(t.ancestor);
+      }
+      // the discriminator's own born-RED: an unregistered name hands the literal back
+      expect(read.control.got, "the unregistered control reads the literal").toBe("red");
+
+      for (const r of [...read.ran, read.zone]) {
+        expect(parseFloat(r.published), `THE PUBLISHER RAN: ${r.n} carries a real value`).toBeGreaterThan(0);
+        expect(r.without, `struck, ${r.n} reads its registered initial — visibly 0px`).toBe("0px");
+        expect(r.restored, `${r.n} restored`).toBe(r.published);
+      }
+      expect(read.controlRan.without, "struck, the unregistered control reads nothing").toBe("");
+    });
+  });
+}
+
+/* ══ 12 · BOTH RING SITES, BY KEYBOARD, AND THE CHIP SNAPS UNDER `reduce` ═══════════════════ */
+
+/**
+ * PASS 5 — charter rows 8 and 9. The two rings this family landed (`.mobile-heading-btn` and the
+ * card's `.ctrl-btn`, `outline: 2px dashed var(--ring-ink)`) had no e2e row at all.
+ *
+ * THE ROUTE. Chromium walks to a chip by Tab and the row asserts it does. PLAYWRIGHT WEBKIT DOES
+ * NOT PUT A `<button>` IN THE TAB ORDER (the critic's 80 presses at 390×844 never landed on a
+ * chip — macOS's "Tab to all controls" default), so on that engine the row takes the keyboard's
+ * other road: a key press, then `focus()`, and it ASSERTS `:focus-visible` matched rather than
+ * assuming it. The claim the rule's comment makes ("the keyboard gets the same answer the pointer
+ * gets") is therefore proved on WebKit for a keyboard-originated focus, not for a Tab walk — which
+ * is a property of the engine's settings, stated here, not a defect of the ring.
+ *
+ * THE READ is `outlineStyle` (an `outline: none` leaves the width at `medium` = 3px, so a width
+ * read cannot fail), after a flush, and the same walk carries a STRANDED control: a focusable
+ * injected with no indicator must read `none`, or the reader cannot tell a ring from no ring.
+ *
+ * ROW 9: under `prefers-reduced-motion: reduce` the chip's transition DURATION is 0s. The
+ * template's `transition-colors duration-150` includes `outline-color`, so the ring faded in over
+ * 150 ms under reduce until OptionSelector's PRM rule; the break-test is deleting that rule.
+ */
+for (const [label, use, sites] of [
+  ["390×844 coarse", coarse(390, 844), [".mobile-heading-btn", ".tray-well .ctrl-btn"]],
+  ["1280 fine", {}, [".tray-well .ctrl-btn"]],
+] as const) {
+  test.describe(`the rings, by keyboard — ${label}`, () => {
+    test.use(use);
+
+    test("each ring site shows a dashed --ring-ink ring on :focus-visible; a stranded focusable shows none", async ({
+      page,
+      browserName,
+    }) => {
+      await loadCard(page);
+      const flush = () =>
+        page.evaluate(
+          () => new Promise<void>((r) => requestAnimationFrame(() => requestAnimationFrame(() => r()))),
+        );
+      const ringInk = await page.evaluate(() => {
+        const d = document.createElement("div");
+        d.style.color = "var(--ring-ink)";
+        document.body.appendChild(d);
+        const c = getComputedStyle(d).color;
+        d.remove();
+        return c;
+      });
+
+      const readAt = async (sel: string) => {
+        // A NON-MODIFIER KEY: WebKit does not count a bare Shift as a keyboard interaction, so after
+        // the dock's tab TAP the modality stayed "pointer" and `focus()` matched no :focus-visible
+        // (measured: `.mobile-heading-btn` read `none 3px` at 390×844 webkit). Tab flips it in both.
+        await page.keyboard.press("Tab");
+        await page.evaluate(
+          ({ card, sel }) => {
+            const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!;
+            const el = [...root.querySelectorAll<HTMLElement>(sel)].find((e) => e.getClientRects().length)!;
+            el.focus();
+          },
+          { card: CARD, sel },
+        );
+        await flush();
+        return page.evaluate(() => {
+          const el = document.activeElement as HTMLElement;
+          const cs = getComputedStyle(el);
+          return {
+            fv: el.matches(":focus-visible"),
+            style: cs.outlineStyle,
+            color: cs.outlineColor,
+            width: cs.outlineWidth,
+            dur: cs.transitionDuration,
+          };
+        });
+      };
+
+      for (const sel of sites) {
+        const r = await readAt(sel);
+        test.info().annotations.push({
+          type: "ring",
+          description: `${sel}: :focus-visible ${r.fv} · ${r.style} ${r.width} ${r.color} (ink ${ringInk}) · transition ${r.dur}`,
+        });
+        expect(r.fv, `${sel} reached :focus-visible by the keyboard route`).toBe(true);
+        expect(r.style, `${sel} draws a ring (outlineStyle)`).toBe("dashed");
+        expect(r.color, `${sel}'s ring is --ring-ink`).toBe(ringInk);
+        if (sel.includes("ctrl-btn"))
+          expect(
+            r.dur.split(",").every((d) => parseFloat(d) === 0),
+            `row 9: the chip's ink and ring snap under reduce (${r.dur})`,
+          ).toBe(true);
+      }
+
+      // THE STRANDED CONTROL, same walk: a focusable with no indicator must read `none`.
+      await page.evaluate((card) => {
+        const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!;
+        const b = document.createElement("button");
+        b.className = "stranded-focusable";
+        b.textContent = "x";
+        b.style.cssText = "outline: none";
+        root.appendChild(b);
+      }, CARD);
+      const stranded = await readAt(".stranded-focusable");
+      expect(stranded.fv, "the stranded control is keyboard-focused too").toBe(true);
+      expect(stranded.style, "the negative control: no indicator reads none").toBe("none");
+
+      // CHROMIUM ALSO WALKS THERE BY TAB (WebKit's default Tab order skips buttons; see above).
+      if (browserName === "chromium") {
+        await page.evaluate(() => (document.activeElement as HTMLElement)?.blur());
+        let reached = false;
+        for (let i = 0; i < 120 && !reached; i++) {
+          await page.keyboard.press("Tab");
+          reached = await page.evaluate(
+            (sel) => !!document.activeElement?.matches(sel),
+            sites[sites.length - 1],
+          );
+        }
+        expect(reached, `a Tab walk reaches ${sites[sites.length - 1]} on chromium`).toBe(true);
+      }
+    });
+  });
+}
+
+/* ══ 12 · M17 SHIPS WITH ITS GATES (T9-M17, INTAKE rows 7, 8, 13 — pass 6) ════════════════════
+   Pass 5 cured the owner's "poor usage of space" and left every number in an evidence
+   instrument (`gpanel.mjs`): the column could come back and this file would read the same. The
+   four rows below are the instrument's G1–G5, each beside the plant that reds it IN THE SAME
+   RUN. One encoded payload (LAWS P4), the given-set read back through the aria-label corpus. */
+const M17_PAYLOAD =
+  "size=3&difficulty=MEDIUM&board=ATMuNTMwMDcwMDAwNjAwMTk1MDAwMDk4MDAwMDYwODAwMDYwMDAzNDAwODAzMDAxNzAwMDIwMDA2MDYwMDAwMjgwMDAwNDE5MDA1MDAwMDgwMDc5";
+const M17_GIVENS = "530070000600195000098000060800060003400803001700020006060000280000419005000080079";
+const BAR_FADE = 32; // `.action-bar::before`'s 2rem, GameControlPanel's `BAR_FADE_PX`
+
+/** The zone's geometry on the VISIBLE card (the desk keeps a hidden drawer twin). */
+const M17_READ = ({ card, fade }: { card: string; fade: number }) => {
+  const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length)!;
+  const zone = root.querySelector(".new-game-zone") as HTMLElement;
+  const text = (el: Element | null) => {
+    if (!el) return null;
+    const rg = document.createRange();
+    rg.selectNodeContents(el);
+    const qs = [...rg.getClientRects()].filter((q) => q.width > 0 && q.height > 0);
+    return qs.length ? { top: Math.min(...qs.map((q) => q.top)), bottom: Math.max(...qs.map((q) => q.bottom)) } : null;
+  };
+  const r2 = (n: number) => Math.round(n * 100) / 100;
+  const tag = zone.querySelector(".washi-tag")!.getBoundingClientRect();
+  const h2 = text(zone.querySelector(".staged-section h2"));
+  const deal = zone.querySelector(".deal-btn")!.getBoundingClientRect();
+  const bar = root.querySelector(".action-bar")!.getBoundingClientRect();
+  const lines = [...zone.querySelectorAll(".staged-section .ctrl-options")].map((o) => {
+    const tops = new Set(
+      [...o.querySelectorAll(":scope > .ctrl-btn")].map((b) => Math.round(b.getBoundingClientRect().top)),
+    );
+    return tops.size;
+  });
+  return {
+    scrollTop: (root as HTMLElement).scrollTop,
+    zoneH: r2(zone.getBoundingClientRect().height),
+    tapeToName: h2 ? r2(h2.top - tag.bottom) : null,
+    dealBottom: r2(deal.bottom),
+    fadeTop: r2(bar.top - fade),
+    lines,
+  };
+};
+
+test.describe("M17 — the new-game zone, one line per question (1280×800 fine)", () => {
+  test("G1 zone ≤ 320 · G2 one line per staged group · G3 Deal above the fade · G4 tape→name ≥ 13.6 — each reds under its plant", async ({
+    page,
+  }) => {
+    await loadCard(page, M17_PAYLOAD);
+    // the payload is the board (LAWS P5: read back through the aria-label corpus, not innerText)
+    const givens = await page.evaluate(() =>
+      [...document.querySelectorAll('[role="gridcell"] input')].map((i) => (i as HTMLInputElement).value || "0").join(""),
+    );
+    expect(givens, "both arms deal the encoded payload").toBe(M17_GIVENS);
+    const read = () => page.evaluate(M17_READ, { card: CARD, fade: BAR_FADE });
+    await page.evaluate((card) => {
+      const root = [...document.querySelectorAll(card)].find((c) => c.getClientRects().length) as HTMLElement;
+      root.scrollTop = 0;
+    }, CARD);
+    const clean = await read();
+    test.info().annotations.push({ type: "m17", description: `clean ${JSON.stringify(clean)}` });
+    expect(clean.zoneH, "G1: the new-game zone ≤ 320 at 1280×800 fine (HEAD 503.19)").toBeLessThanOrEqual(320);
+    expect(clean.lines, "G2: every staged group on ONE line").toEqual(clean.lines.map(() => 1));
+    expect(clean.dealBottom, "G3: Deal's bottom clears the bar's fade at scrollTop 0").toBeLessThanOrEqual(clean.fadeTop);
+    expect(clean.tapeToName, "G4: tape → first name ≥ 13.6 (the rule air)").toBeGreaterThanOrEqual(13.6);
+
+    // THE PLANTS, same run, each asserted to red its own row.
+    for (const [row, css, reds] of [
+      ["G1", ".new-game-zone { padding-bottom: 200px !important }", (m: typeof clean) => m.zoneH > 320],
+      ["G2", ".new-game-zone .options-line { flex-direction: column !important }", (m: typeof clean) => m.lines.some((n) => n > 1)],
+      ["G3", ".new-game-zone .deal-row { margin-top: 200px !important }", (m: typeof clean) => m.dealBottom > m.fadeTop],
+      ["G4", ".new-game-zone { --zone-step: 0px !important }", (m: typeof clean) => (m.tapeToName ?? 99) < 13.6],
+    ] as const) {
+      const h = await page.addStyleTag({ content: css });
+      await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))));
+      const planted = await read();
+      await h.evaluate((n) => (n as unknown as HTMLElement).remove());
+      test.info().annotations.push({ type: "m17-plant", description: `${row} ${css} → ${JSON.stringify(planted)}` });
+      expect(reds(planted), `${row}'s plant (${css}) reds its row`).toBe(true);
+    }
+  });
+});
+
+const RAIL_COARSE = { viewport: { width: 1280, height: 800 }, hasTouch: true, isMobile: false };
+for (const [label, use, armed] of [
+  ["1280 fine, rest", {}, false],
+  ["1280×800 coarse (hasTouch), rest", RAIL_COARSE, false],
+  // Deal arms on a COARSE pointer only (`onDeal`), and only on a dirtied board; the arm lapses
+  // in 2.5 s, so this cell reads once and asserts the arm held across the read.
+  ["1280×800 coarse (hasTouch), armed", RAIL_COARSE, true],
+  ["390×844 coarse, settled", coarse(390, 844), false],
+] as const) {
+  test.describe(`M17 G5 — Deal and its receipt stand on one line (${label})`, () => {
+    test.use(use);
+    test("the two words' PAINTED glyph bottoms are within 1.5px, and a 3px drop reds", async ({ page }) => {
+      await loadCard(page, M17_PAYLOAD);
+      if (armed) {
+        const blank = await page.evaluate(() => {
+          const cells = document.querySelectorAll(".game-cell");
+          for (let i = 0; i < cells.length; i++) if (!cells[i].querySelector(".glyph-svg")) return i;
+          return -1;
+        });
+        expect(blank).toBeGreaterThanOrEqual(0);
+        await page.locator(".game-cell").nth(blank).click();
+        await page.evaluate((idx) => {
+          const input = document.querySelectorAll(".game-cell input")[idx] as HTMLInputElement;
+          Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value")!.set!.call(input, "1");
+          input.dispatchEvent(new Event("input", { bubbles: true }));
+        }, blank);
+        // a mouse press at the verb's centre (locator.click scrolls a sticky scrollport, LAWS P5)
+        const c = await page.evaluate((card) => {
+          const root = [...document.querySelectorAll(card)].find((x) => x.getClientRects().length)!;
+          const b = root.querySelector(".deal-btn")!.getBoundingClientRect();
+          return [b.x + b.width / 2, b.y + b.height / 2];
+        }, CARD);
+        await page.touchscreen.tap(c[0], c[1]);
+        await expect(page.locator(`${CARD}:visible .deal-btn .icon-sublabel`)).toHaveText("sure?");
+      }
+      const row = page.locator(`${CARD}:visible .deal-row`);
+      await row.scrollIntoViewIfNeeded();
+      const dpr = await page.evaluate(() => devicePixelRatio);
+      const bottoms = async () => {
+        const deal = await paintedExtent(page, row, ".deal-btn .icon-sublabel { color: transparent !important }", true);
+        const dealt = await paintedExtent(page, row, ".deal-row .dt-label { color: transparent !important }", true);
+        return { deal: deal.hi / dpr, dealt: dealt.hi / dpr };
+      };
+      const b = await bottoms();
+      expect(Number.isFinite(b.deal) && Number.isFinite(b.dealt), "both words painted").toBe(true);
+      const d = Math.abs(b.deal - b.dealt);
+      test.info().annotations.push({ type: "m17-g5", description: `${label}: Deal ${b.deal.toFixed(2)} · dealt ${b.dealt.toFixed(2)} · |Δ| ${d.toFixed(2)} (dpr ${dpr})` });
+      expect(d, "G5: Deal and dealt share a painted baseline").toBeLessThanOrEqual(1.5);
+      if (armed) {
+        await expect(page.locator(`${CARD}:visible .deal-btn .icon-sublabel`), "the arm held across the read").toHaveText("sure?", { timeout: 50 });
+        return; // the plant runs on the rest cells; a second read would outlive the 2.5 s arm
+      }
+      const h = await page.addStyleTag({ content: ".deal-row .dt-label { position: relative; top: 3px }" });
+      const p = await bottoms();
+      await h.evaluate((n) => (n as unknown as HTMLElement).remove());
+      test.info().annotations.push({ type: "m17-g5-plant", description: `dealt dropped 3px → |Δ| ${Math.abs(p.deal - p.dealt).toFixed(2)}` });
+      expect(Math.abs(p.deal - p.dealt), "G5's plant (dealt 3px low) reds").toBeGreaterThan(1.5);
+    });
+  });
+}
