+import { describe, it, expect } from "vitest";
+import { mount } from "@vue/test-utils";
+import { nextTick } from "vue";
+import { MOTION, publishMotionRungs } from "@pencil/config/pencilConfig";
+import MarginNote from "./MarginNote.vue";
+// The component's own BYTES (vite's `?raw`), not the compiled component: the assertions below
+// are about what the stylesheet says. `node:fs` is not available here — `src/**` is typechecked
+// by the browser tsconfig, which carries no node types (the trap check-ink-pressure's head names).
+import MARGIN_NOTE_SRC from "./MarginNote.vue?raw";
+
+/**
+ * T9-W7 §7 — THE NOTE'S CLOCKS, ITS RUNGS AND ITS REST POSE, asserted where they are decided.
+ *
+ * What the live surface cannot say for itself:
+ *   G-hold  the refusal's hold is long enough to READ the refusal — derived from the house's
+ *           own constants, not picked. It reds if either end re-times.
+ *   G3      no duration literal in the component, and NO `var(--motion-x, fallback)`. The
+ *           fallback was pass 2's shape and chair §6.5 struck it: a byte-equal fallback makes
+ *           a deleted publisher invisible, which is exactly the failure the born-RED row
+ *           exists to catch. The rungs are registered at `initial-value: 0ms` instead.
+ *   G2/G4   the rest pose and the site PRM arm exist as STATIC text — the live halves are the
+ *           probe's, but a stylesheet that lost either would red here first.
+ */
+
+const STYLE = MARGIN_NOTE_SRC.slice(MARGIN_NOTE_SRC.indexOf("<style"));
+
+describe("the margin note's motion (T9-W7 §7)", () => {
+  it("G-hold: the refusal stands long enough to be read", () => {
+    const words = "that's a given clue".split(/\s+/).length;
+    // write-in, then a settle's worth of notice, then the words at 180 wpm (333 ms/word).
+    const need =
+      MOTION.rungs.note + MOTION.note.settleAfterBeats * MOTION.beatMs + words * 333;
+    const hold = MOTION.note.refusalHoldBeats * MOTION.beatMs;
+    expect(need).toBe(2582);
+    expect(hold).toBeGreaterThanOrEqual(need);
+  });
+
+  it("the ballot's slow end is the same derivation at 90 wpm", () => {
+    const words = "that's a given clue".split(/\s+/).length;
+    const slow =
+      MOTION.rungs.note +
+      2 * MOTION.note.settleAfterBeats * MOTION.beatMs +
+      words * 667;
+    // 4,918 ms → 40 beats on the 8-beat settle grid: the band's far end, derived not picked.
+    expect(Math.ceil(slow / MOTION.beatMs / 8) * 8).toBe(40);
+  });
+
+  it("G3: the verbs read rungs BARE — three of them, and no fallback anywhere", () => {
+    expect(STYLE.match(/var\(--motion-[a-z]+\s*,/g) ?? []).toEqual([]);
+    const bare = [...STYLE.matchAll(/var\(--motion-([a-z]+)\)/g)].map((m) => m[1]);
+    for (const rung of ["note", "whisper", "dusk"]) {
+      expect(bare).toContain(rung);
+      expect(MOTION.rungs[rung as keyof typeof MOTION.rungs]).toBeGreaterThan(0);
+    }
+  });
+
+  it("G3: no duration literal in the component", () => {
+    expect(STYLE.match(/\b\d+(\.\d+)?m?s\b/g) ?? []).toEqual([]);
+  });
+
+  it("G2 (static half): the leave has a REST POSE where its keyframe ends", () => {
+    // `ink-rub-out` has no fill, so the frame it releases is the cascade's. `.note-leave-to` IS
+    // that frame: clipped away from the end of the line, fully transparent.
+    const to = /\.note-leave-to\s*\{([^}]*)\}/.exec(STYLE)?.[1] ?? "";
+    expect(to.replace(/\s+/g, " ")).toContain("clip-path: inset(0 100% 0 0)");
+    expect(to).toContain("opacity: 0");
+  });
+
+  it("G16 (static half): the honest clock is an inline !important on the leaving node", () => {
+    // Vue drops the node on max(transition, animation). Pass 4 fenced it with a (0,4,0) selector
+    // and a declaration at (1,1,0) walked past it; an inline `!important` written at
+    // `before-leave` outranks every author rule, so the bound is the author origin. The live
+    // half is `e2e/affordances.spec.ts`'s drop-clock row, planted at (1,1,0) `!important`.
+    expect(MARGIN_NOTE_SRC).toContain('@before-leave="stopTheClock"');
+    expect(MARGIN_NOTE_SRC).toContain(
+      'style.setProperty("transition", "none", "important")',
+    );
