+    expect(/\.note-leave-active\s*\{[^}]*transition:/.test(STYLE)).toBe(false);
+  });
+
+  it("G16 (CI half): the LEAVING node carries `transition: none !important`", async () => {
+    // The row above reads the hook's TEXT, so a dead hook with its strings intact
+    // (`if (el) return;` as its first line) stayed 11/11 green, and the drop-clock row that sees
+    // it is a browser row — under O-12 a local instrument, never CI. This is the behaviour on the
+    // CI surface: the real <Transition> (unstubbed) runs the real `@before-leave` on a real
+    // replacement, and the node that is leaving is read.
+    const w = mount(MarginNote, {
+      props: { text: "one", seq: 1 },
+      global: { stubs: { transition: false } },
+      attachTo: document.body,
+    });
+    await nextTick();
+    const leaving = (w.element as HTMLElement).querySelector(
+      ".margin-note-ink",
+    ) as HTMLElement | null;
+    expect(leaving).not.toBeNull();
+    // Before the leave, the ink carries no inline clock: the write below is the hook's.
+    expect(leaving!.style.getPropertyValue("transition")).toBe("");
+    await w.setProps({ text: "two", seq: 2 });
+    await nextTick();
+    const clock = leaving!.style;
+    expect(
+      `${clock.getPropertyValue("transition")}|${clock.getPropertyPriority("transition")}`,
+    ).toBe("none|important");
+    w.unmount();
+  });
+
+  it("G4 (static half): PRM is answered at the site, both verbs and the settle", () => {
+    const prm = /@media \(prefers-reduced-motion: reduce\)\s*\{([\s\S]*?)\n\}/.exec(
+      STYLE,
+    )?.[1];
+    expect(prm).toBeTruthy();
+    expect(prm).toContain(".note-enter-active");
+    expect(prm).toContain(".note-leave-active");
+    expect(prm).toContain("animation: none");
+    expect(prm).toContain(".margin-note-ink[data-note-age]");
+  });
+
+  it("G5: THE FOLD CARRIES NO LADDER ROW — the rung MAP is §13's, key and value", () => {
+    // Re-cut twice. Pass 4 asserted a banner STRING (minting `erase: 125` stayed green); pass 5
+    // asserted the key SET, and a SET is blind to every value: retuning `whisper` to 125, `step`
+    // to 1, `rise` to 600, or SWAPPING whisper and dusk (the rub-out on 350 ms, the verb doubled)
+    // all stayed 11/11 green. The claim is the MAP: §13's banked ladder (`MOTION.rungs` in
+    // `pass5/prototype/MOT-VERB/pass5.diff`, lines 7005-7068), every key at its value, nothing
+    // else. §7 may neither mint, drop nor retune a rung. If §13 moves its own map (T9-B11's
+    // `rise`), this constant moves in §13's fold commit with it.
+    const LADDER_13 = {
+      whisper: 150,
+      leave: 200,
+      note: 250,
+      dusk: 350,
+      step: 440,
+      throw: 520,
+      rise: 520,
+    };
+    expect({ ...MOTION.rungs }).toEqual(LADDER_13);
+    // §7's own clocks are waits, not rungs, and they are exactly two.
+    expect(Object.keys(MOTION.note).sort()).toEqual([
+      "refusalHoldBeats",
+      "settleAfterBeats",
+    ]);
+    // §7's stylesheet CONSUMES `--motion-*` and DECLARES none. A declaration is `--motion-x:` at
+    // the head of a value; a consumption is `var(--motion-x)`.
+    expect(STYLE.match(/--motion-[a-z]+\s*:/g) ?? []).toEqual([]);
+    expect((STYLE.match(/var\(--motion-[a-z]+\)/g) ?? []).length).toBeGreaterThan(0);
+  });
+
+  it("G7 (row E): the publisher emits VALUES, never the registration it is guarded by", () => {
+    // The @property law's first clause. Pass 3 emitted both the registration and the values from
+    // `publishMotionRungs()`, so deleting the publisher took the TYPE with it: every rung
+    // computed to the empty string, the `animation` shorthand went invalid, `animation-name` read
+    // `none`, and the born-RED fired as row I — a mode the record never declared. The
+    // registration lives in the first static stylesheet (`assets/index.css`, `initial-value:
+    // 0ms`), so a missing publisher leaves every rung at 0ms: row E, asserted LIVE by the probe
+    // that deletes the node (vitest answers a `*.css?raw` import with the empty string).
+    //
+    // Re-cut at pass 5 to the BEHAVIOUR: run the publisher and read what it emits. The pass-4 row
+    // matched this tree's publisher text and redded on §13's, which builds the same values in a
+    // helper — a row keyed on one site's literal, redding the correct fold.
+    const doc = document.implementation.createHTMLDocument("");
+    publishMotionRungs(doc);
+    const nodes = doc.querySelectorAll("style[data-motion-rungs]");
+    expect(nodes.length).toBe(1);
+    const css = nodes[0].textContent ?? "";
+    expect(css).not.toContain("@property");
+    for (const [rung, ms] of Object.entries(MOTION.rungs))
+      expect(css).toContain(`--motion-${rung}:${ms}ms`);
+  });
+
+  it("EVERY note carries an age, fresh or settled, never a null", () => {
+    // One selector reads both ages (the site's PRM arm); a null left the fresh line outside it.
+    expect(MARGIN_NOTE_SRC).toContain(`:data-note-age="settled ? 'settled' : 'fresh'"`);
+    expect(MARGIN_NOTE_SRC).not.toContain("settled ? 'settled' : null");
+  });
+
+  it("the strip's reserve is DERIVED from the line it reserves, at every width", () => {
+    // `1.3em` was 1.3 of the BLOCK's inherited 16px while the voice inside sets `--type-body`
+    // (clamped, 18.18px at 1280) on `--type-leading-caption` — so the reserve was right at 390
+    // by coincidence and short by 2.81px wherever the clamp had climbed, and the strip grew the
+    // first time the voice spoke. The floor is the two tokens the voice itself reads.
+    const block = /\.margin-note-block\s*\{([^}]*)\}/.exec(STYLE)?.[1] ?? "";
+    expect(block.replace(/\s+/g, " ")).toContain(
+      "min-height: calc(var(--type-body) * var(--type-leading-caption))",
+    );
+  });
+});
