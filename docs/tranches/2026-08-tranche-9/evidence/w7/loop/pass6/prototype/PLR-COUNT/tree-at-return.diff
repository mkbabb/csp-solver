+// ── G9 · the crossing, both ways and both at once ──────────────────────────────────────────
+// THE LAW, RESTATED (pass 4): no SURVIVOR ever re-draws; the only stroke that draws is one the
+// tally did not hold a tick ago. Pass 3 wrote "6→5 re-draws nothing" and proved it with the
+// SIXTH person leaving, who was never in the five — the row below also sends an INNER leaver.
+test("a departure re-draws no survivor, and a depart-and-arrive draws exactly the newcomer", async ({
+  page,
+}) => {
+  const room = `tally-cross-${Date.now()}`;
+  await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+  await settled(page);
+  const ids = ["p0", "p1", "p2", "p3", "p4"];
+  const say = (msgs: { kind: string; from: string }[]) =>
+    page.evaluate(
+      ({ room, msgs }) => {
+        const w = window as unknown as { __ch?: BroadcastChannel };
+        w.__ch ??= new BroadcastChannel(`board:${room}`);
+        for (const m of msgs) w.__ch.postMessage({ kind: m.kind, data: {}, from: m.from });
+      },
+      { room, msgs },
+    );
+
+  // five, settled (every stroke landed), THEN the sixth, who is never drawn
+  await say(ids.slice(0, 4).map((from) => ({ kind: "hi", from })));
+  await expect.poll(async () => (await head(page)).strokes).toBe(5);
+  await inked(page);
+  await say([{ kind: "hi", from: ids[4] }]);
+  await expect.poll(async () => (await head(page)).written).toBe(writtenAt(6));
+
+  // SIX TO FIVE: the number gives way to five strokes, and not one of them tweens. A watch
+  // that only knows `now > was` re-draws all five here, because `drawn` goes 0 -> 5. (Arm (c)
+  // keeps the five through six; its remainder goes and nothing draws either.)
+  await say([{ kind: "bye", from: ids[4] }]);
+  await expect.poll(async () => countOf((await head(page)).label)).toBe(5);
+  for (let i = 0; i < 5; i++) {
+    // sleep-ok: the elapsed window IS the subject, five reads across 400ms in which no stroke may tween
+    await page.waitForTimeout(80);
+    const off = (await head(page)).offs;
+    expect(off.every((v) => v === "0")).toBe(true);
+  }
+  const five = await head(page);
+  expect(five.strokes).toBe(5);
+
+  // A MIDDLE DEPARTURE: the pose is keyed to the person and the slot is a transform, so four
+  // `d` attributes come through byte for byte and only the leaver's is gone.
+  await say([{ kind: "bye", from: ids[1] }]);
+  await expect.poll(async () => (await head(page)).strokes).toBe(4);
+  await inked(page);
+  const four = await head(page);
+  expect(four.strokes).toBe(4);
+  expect(four.ds.filter((d) => five.ds.includes(d)).length).toBe(4);
+
+  // ONE TICK, BOTH WAYS — the row pass 2 could not have passed. The count does not move, so a
+  // watch on the count never fires and the newcomer inherits the departed person's reveal.
+  // Watching the ID SET, exactly one stroke is new and exactly one is gone.
+  await say([
+    { kind: "bye", from: ids[0] },
+    { kind: "hi", from: "p9" },
+  ]);
+  // sleep-ok: the elapsed time IS the subject, a read 120ms into the newcomer's 600ms draw-in
+  await page.waitForTimeout(120);
+  const mid = await head(page);
+  expect(mid.strokes, "the count did not move").toBe(4);
+  // exactly one stroke is mid-draw (dashoffset above 0); the other three are untouched
+  const drawing = mid.offs.filter((v) => v !== "0").length;
+  expect(drawing, `exactly the newcomer draws in (offs ${JSON.stringify(mid.offs)})`).toBe(1);
+  await inked(page);
+  const after = await head(page);
+  // BY SLOT, not by set membership: the seed space is 97 poses (`seedFor`), so the newcomer can
+  // be drawn with the same `d` as the page's own stroke (a random id), and a membership count
+  // then reads 4 (pass 6, one chromium run in eight). The survivors keep their bytes in order.
+  expect(after.ds.slice(0, 3)).toEqual([four.ds[0], four.ds[2], four.ds[3]]);
+});
