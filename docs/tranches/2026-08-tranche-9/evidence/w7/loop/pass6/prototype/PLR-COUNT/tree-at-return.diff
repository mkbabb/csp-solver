@@ -0,0 +1,31 @@
+/**
+ * THE LOBBY'S FOUR LINES, IN ONE PLACE (T9-W7 §11 · M16).
+ *
+ * Two surfaces read this and one component computes both: the sheet draws it, and the mark's
+ * accessible name IS the state line — `PlayerMark` derives that line from the same rows it
+ * draws strokes for. The two gates that read copy read it once: `check-font-coverage.mjs`'s
+ * `lobbyStrings` derive (does the 46-codepoint cut hold these glyphs) and
+ * `check-copy-register.mjs`, whose table discovery finds `LOBBY_COPY` by its name (M16: no
+ * dash, no first person, no jargon). A line that moves out of this object stops being read.
+ *
+ * COUNTING, DECLARED ONCE — ONE POPULATION (registry-v4 §2.5, PLR-COUNT's base). The state
+ * line, the mark's accessible name, the rows and `and N more` all count the same people: everyone
+ * at this board, you included. A page with no room is one person at this board, and the sheet
+ * says so with your own row. The pass-4 `alone` / `others` pair counted OTHER players while the
+ * rows counted everyone, three populations in one sheet; it is retired. The mark draws one stroke
+ * per person and writes the number from six, so its name carries every digit the glyph paints
+ * (WCAG 2.5.3): `6` is a substring of `6 players`. The owner's arm (c) writes the REMAINDER
+ * after five strokes instead, and its name is two of these lines joined, `5 players and 1 more`.
+ *
+ * M16: plain English, no em dash, no first person, no colon, no `j`, no `x` (the cut).
+ */
+export const LOBBY_COPY = {
+  /** the state line, and the mark's whole name: everyone at this board */
+  count: (n: number) => (n === 1 ? "1 player" : `${n} players`),
+  /** your own row's qualifier — read at the open, never on a timer */
+  self: "you",
+  /** a peer past `PRESENCE_QUIET_MS`: still at the table, not yet gone */
+  quiet: (seconds: number) => `${seconds} seconds ago`,
+  /** the compression line: the rows the height budget could not draw */
+  more: (n: number) => `and ${n} more`,
+} as const;
