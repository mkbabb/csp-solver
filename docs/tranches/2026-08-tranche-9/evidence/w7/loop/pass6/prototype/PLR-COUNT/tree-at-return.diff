+// RE-CUT TWICE. Pass 4 asserted `not /,\s*0?\.\d+\)/` on the ground (blind to `color(srgb … / a)`);
+// pass 5 parsed the alpha in any form and planted the regression in-run — that half stands — but
+// read the lines' contrast as a BEST PIXEL, which is the declared ink at full coverage and 5.159
+// whatever the page painted (the critic's X1b ghosted two thirds of each line and it stayed green;
+// X2 had no dark arm to fail). Now the contrast half is the GLYPH-TEXT statistic (LAWS P5,
+// registry-v5 §2.11) on PAL-WALK's painted-text instrument, with the population keyed on the
+// GLYPH'S OWN COVERAGE — never on the ink the page chose, so a fade cannot drop out of it:
+//   A, A2  the line as painted, photographed twice (a one-shot minimum reds on a transient pixel)
+//   B      the same box with the text transparent: the painted ground under every glyph pixel
+//   R      the text re-inked at the theme's extreme (black / white) with every fade the author
+//          could apply struck (opacity, mask, filter, shadow) — the glyph's coverage
+// A pixel is in the core when its R coverage is ≥ 0.5; the row is the core's median contrast
+// (A against B, pixel for pixel) ≥ 4.5 in both photographs, with the fraction under 4.5 STATED
+// (bounded by the estate's T9-R6 row, not by this lane). An empty core is RED (a missing subject).
+// Each cell plants its negative control IN THE RUN and the statistic must see it: X1b (the
+// critic's: everything after the first 1.2em masked to 25 % alpha) in both themes, X2 (the quiet
+// lines at rgb(70, 68, 66)) in dark. Light at DPR 1 is the hand's tag rung, the estate's T9-R6
+// (pass6/CHAIR-RULINGS §1.4): read and printed, never gated here.
+type GlyphText = { n: number; median: number | null; median2: number | null; under: number | null };
+async function glyphText(page: Page, sel: string, tag: string): Promise<GlyphText> {
+  const el = page.locator(sel).first();
+  await el.evaluate((e, t) => e.setAttribute("data-aa-probe", t), tag);
+  const b = (await el.boundingBox())!;
+  const clip = {
+    x: Math.floor(b.x) - 2,
+    y: Math.floor(b.y) - 2,
+    width: Math.ceil(b.width) + 4,
+    height: Math.ceil(b.height) + 4,
+  };
+  const snap = async () =>
+    (await page.screenshot({ clip, animations: "disabled" })).toString("base64");
+  const probe = `html body [data-aa-probe="${tag}"]:not(#aa-none)`;
+  const dark = await page.evaluate(() => document.documentElement.classList.contains("dark"));
+  const ref = dark ? "#ffffff" : "#000000";
+  const A = await snap();
+  const A2 = await snap();
+  const off = await page.addStyleTag({
+    content: `${probe} { color: transparent !important; -webkit-text-fill-color: transparent !important; }`,
+  });
+  const B = await snap();
+  await off.evaluate((t) => (t as HTMLElement).remove());
+  const on = await page.addStyleTag({
+    content: `${probe} { color: ${ref} !important; -webkit-text-fill-color: ${ref} !important; opacity: 1 !important; filter: none !important; mask-image: none !important; -webkit-mask-image: none !important; text-shadow: none !important; }`,
+  });
+  const R = await snap();
+  await on.evaluate((t) => (t as HTMLElement).remove());
+  await el.evaluate((e) => e.removeAttribute("data-aa-probe"));
+  return page.evaluate(
+    async ({ A, A2, B, R, dark }) => {
+      const decode = async (b64: string) => {
+        const bmp = await createImageBitmap(
+          await (await fetch(`data:image/png;base64,${b64}`)).blob(),
+        );
+        const g = new OffscreenCanvas(bmp.width, bmp.height).getContext("2d")!;
+        g.drawImage(bmp, 0, 0);
+        return g.getImageData(0, 0, bmp.width, bmp.height).data;
+      };
+      const [a, a2, bg, r] = await Promise.all([A, A2, B, R].map(decode));
+      const lin = (c: number) =>
+        (c /= 255) <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
+      const L = (d: Uint8ClampedArray, i: number) =>
+        0.2126 * lin(d[i]) + 0.7152 * lin(d[i + 1]) + 0.0722 * lin(d[i + 2]);
+      const ratio = (x: number, y: number) => (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
+      const li = dark ? 1 : 0;
+      const one: number[] = [];
+      const two: number[] = [];
+      for (let i = 0; i < bg.length; i += 4) {
+        const lg = L(bg, i);
+        if (Math.abs(li - lg) < 1e-6) continue;
+        if (Math.abs(L(r, i) - lg) / Math.abs(li - lg) < 0.5) continue;
+        one.push(ratio(L(a, i), lg));
+        two.push(ratio(L(a2, i), lg));
+      }
+      const med = (xs: number[]) =>
+        xs.length ? +[...xs].sort((m, n) => m - n)[Math.floor(xs.length / 2)].toFixed(3) : null;
+      return {
+        n: one.length,
+        median: med(one),
+        median2: med(two),
+        under: one.length ? +(one.filter((c) => c < 4.5).length / one.length).toFixed(3) : null,
+      };
+    },
+    { A, A2, B, R, dark },
+  );
+}
