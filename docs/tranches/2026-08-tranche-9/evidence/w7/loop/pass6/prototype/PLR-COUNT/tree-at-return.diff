+// ── G16 · the written count's weight, ON PAINTED BYTES, per arm and per theme ────────────────
+// Ink weight, one normaliser for the crops compared, reduced motion so every stroke is inked.
+// KEYED ON `SIX_ARM` (the pass-5 critic: the row was arm (a)'s, and its negative control was arm
+// (c)'s shipped rung): each arm is held to its own promise, with the plant that breaks THAT
+// promise read in the same run.
+//   (a) title / (b) heading — the FLOOR: six out-weighs one graphite stroke. Plant: a rung the
+//       floor must see as lighter than one. In light that is the rung below title (heading: why
+//       the title rung ships). In DARK the heading rung CLEARS one stroke (79.52 against 59.48,
+//       pass 6), so the dark plant is the body rung. Arm (b) is RED in light by design: that is
+//       its ballot price.
+//   (c) remainder — MONOTONE, PER PERSON: six paints at least 6/5 of five's ink (the ink per
+//       person never falls; measured 1.44 light / 1.51 dark). Plant: the remainder and its plus
+//       hidden, and it must read under that bar. A first cut at ≥ 1.05 could NOT see this plant:
+//       the hidden arm still reads 1.09–1.10 of five in both engines (an unexplained residue of
+//       the 24 px wider crop), so the bar is the count's own ratio.
+const G16_PLANT = (theme: "light" | "dark"): string =>
+  SIX_ARM === "remainder"
+    ? ".pt-count.is-rest, .pt-plus { visibility: hidden !important; }"
+    : SIX_ARM === "title" && theme === "light"
+      ? ".pt-count { font-size: var(--type-heading) !important; }"
+      : ".pt-count { font-size: var(--type-body) !important; }";
+for (const theme of ["light", "dark"] as const)
+  test.describe(`the written count's weight · ${theme}`, () => {
+    test.use({
+      viewport: { width: 1280, height: 800 },
+      deviceScaleFactor: 2,
+      colorScheme: theme,
+      contextOptions: { reducedMotion: "reduce" },
+    });
+    test(`six people against one and five, and the plant that breaks the promise (${SIX_ARM}, ${theme})`, async ({
+      page,
+    }) => {
+      const room = `tally-ink-${theme}-${Date.now()}`;
+      await page.goto(`/?size=3&difficulty=EASY&wire=local&s=${room}`);
+      await settled(page);
+      expect(
+        await page.evaluate(() => document.documentElement.classList.contains("dark")),
+      ).toBe(theme === "dark");
+      await page.mouse.move(640, 790);
+      const crop = async () => {
+        await stable(() => mark(page).evaluate((e) => e.getBoundingClientRect().width));
+        return painted(page, await mark(page).screenshot({ animations: "disabled" }));
+      };
+      const one = await crop();
+      await peers(page, room, 4);
+      const five = await crop();
+      await peers(page, room, 1);
+      const six = await crop();
+      const plant = await page.addStyleTag({ content: G16_PLANT(theme) });
+      const sixPlanted = await crop();
+      await plant.evaluate((t) => (t as HTMLElement).remove());
+      const D = Math.max(one.core, five.core, six.core, sixPlanted.core);
+      const ink = {
+        one: inkOf(one.hist, D, 2),
+        five: inkOf(five.hist, D, 2),
+        six: inkOf(six.hist, D, 2),
+        sixPlanted: inkOf(sixPlanted.hist, D, 2),
+      };
+      console.log(
