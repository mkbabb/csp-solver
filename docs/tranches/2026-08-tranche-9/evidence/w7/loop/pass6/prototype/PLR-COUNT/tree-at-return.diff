+  await expect.poll(async () => (await head(page)).strokes).toBe(3);
+  await inked(page);
+  const trace = await page.evaluate(
+    ({ room }) =>
+      new Promise<{ t: number; off: number; bye: boolean }[]>((done) => {
+        const ch = new BroadcastChannel(`board:${room}`);
+        const out: { t: number; off: number; bye: boolean }[] = [];
+        let bye = false;
+        const t0 = performance.now();
+        const read = () => {
+          const g = document.querySelector("[data-player-mark] .pt-pose");
+          const ps = g ? g.querySelectorAll("path") : [];
+          const last = ps[ps.length - 1];
+          return last ? Number(last.getAttribute("stroke-dashoffset")) : NaN;
