+          class="pl-stub"
+          viewBox="3.5 7 6 30"
+          aria-hidden="true"
+          xmlns="http://www.w3.org/2000/svg"
+        >
+          <path
+            :d="rowPose"
+            fill="none"
+            stroke="currentColor"
+            stroke-linecap="round"
+            stroke-linejoin="round"
+            stroke-width="3.2"
+            stroke-opacity="0.95"
