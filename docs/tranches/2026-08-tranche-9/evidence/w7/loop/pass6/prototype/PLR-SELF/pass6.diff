+/**
+ * BOTH HEAD DISCLOSURES PAINT A DRAWN EDGE AND NO CSS BORDER (R6 L5; CH-71; pass-5 critic
+ * gap 3). A rect and a computed stroke are not paint: an `opacity: 0` edge (X1) and an inkless
+ * one (X2) both passed the pass-5 row. The row now photographs the sheet's top band twice —
+ * edge ON, then edge OFF (`visibility: hidden` on the edge layer) — and counts the columns
+ * whose best contrast against the sheet's own ground rises by half again when the edge is on.
+ * That is an EXISTENCE reading, so it holds for either edge ink the owner is shown (full:
+ * ~16:1, quiet: ~4.7:1, off: 1.00); the edge's contrast is a number in the record, not this
+ * row's. X1 and X2 are planted in the same run and must drive the count to zero; the pass-4
+ * border, planted, must read on the computed box.
+ */
+async function edgePaint(page: Page, sel: string) {
+  const sheet = page.locator(`${sel}:visible`).first();
+  const box = (await sheet.boundingBox())!;
+  const clip = { x: Math.round(box.x), y: Math.round(box.y), width: Math.round(box.width), height: 14 };
+  const shoot = async () => (await page.screenshot({ clip })).toString('base64');
+  const on = await shoot();
+  const off = await page.addStyleTag({ content: '.head-sheet-edge { visibility: hidden !important; }' });
+  const bare = await shoot();
+  await off.evaluate((e) => (e as Element).remove());
+  return page.evaluate(
+    async ({ on, bare }) => {
+      const read = async (b64: string) => {
+        const bmp = await createImageBitmap(await (await fetch(`data:image/png;base64,${b64}`)).blob());
+        const c = document.createElement('canvas');
+        c.width = bmp.width;
+        c.height = bmp.height;
+        const x = c.getContext('2d')!;
+        x.drawImage(bmp, 0, 0);
+        return x.getImageData(0, 0, c.width, c.height);
+      };
+      const lum = (d: Uint8ClampedArray, i: number) => {
+        const f = (v: number) => ((v /= 255) <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
+        return 0.2126 * f(d[i]) + 0.7152 * f(d[i + 1]) + 0.0722 * f(d[i + 2]);
+      };
+      const [a, b] = [await read(on), await read(bare)];
+      const best = (img: ImageData, x: number) => {
+        const g = lum(img.data, (10 * img.width + x) * 4);
+        let r = 1;
+        for (let y = 0; y < 5; y++) {
+          const l = lum(img.data, (y * img.width + x) * 4);
+          r = Math.max(r, (Math.max(l, g) + 0.05) / (Math.min(l, g) + 0.05));
+        }
+        return r;
+      };
+      const x0 = Math.floor(a.width * 0.2);
+      const x1 = Math.floor(a.width * 0.8);
+      let drawn = 0;
+      for (let x = x0; x < x1; x++) if (best(a, x) >= 1.5 * best(b, x)) drawn++;
+      return drawn / (x1 - x0);
+    },
+    { on, bare },
+  );
+}
+const border = (page: Page, sel: string) =>
+  page.locator(`${sel}:visible`).first().evaluate((el) => {
+    const cs = getComputedStyle(el);
+    return ['top', 'right', 'bottom', 'left'].reduce(
+      (n, s) =>
+        n + (cs.getPropertyValue(`border-${s}-style`) === 'none' ? 0 : parseFloat(cs.getPropertyValue(`border-${s}-width`))),
+      0,
+    );
+  });
+
+test('both head disclosures paint a drawn edge and no CSS border', async ({ page }) => {
