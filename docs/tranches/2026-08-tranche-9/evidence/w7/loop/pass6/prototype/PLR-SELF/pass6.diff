+  // A tall phone keeps four rows and laps nothing...
+  expect(await cell(390, 844)).toMatchObject({ rows: 4, more: 'and 3 more', lapped: 0 });
+  // ...until its rows WRAP: the longest slug, quiet, takes two lines (a row-count law would
+  // miss it; the tall sheet measures 212.13 tall at 390×1000). The same phone compresses.
+  expect(await cell(390, 844, true)).toMatchObject({ rows: 1, more: 'and 6 more', lapped: 0 });
+  // A short phone laps whatever it does with one row: the least the sheet can hold.
+  expect(await cell(390, 664)).toMatchObject({ rows: 1, more: 'and 6 more' });
+  // THE LANDSCAPE CELL (W2 §2.2's 844×390): the board is BESIDE the rows' start, so four rows,
+  // and the price is stated, not denied: six cells lapped where one row would lap four.
+  expect(await cell(844, 390)).toMatchObject({ rows: 4, more: 'and 3 more', lapped: 6 });
