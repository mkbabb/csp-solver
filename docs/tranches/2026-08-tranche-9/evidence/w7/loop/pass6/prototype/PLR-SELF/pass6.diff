+<script setup lang="ts">
+import { generateRectBoilFrames } from "@pencil/grid/gridPaths";
+
+withDefaults(defineProps<{ size?: number; pose?: 0 | 1 }>(), { size: 24, pose: 0 });
+
+/**
+ * THE CRAYON STUB (T9-W7 §11) — one filled hand-drawn rectangle, and that is the whole mark.
+ *
+ * Drawn rather than lettered: a player's name runs 3 to 13 characters over the real dictionary,
+ * so a written mark breathes 4× in the head's quietest corner beside a fixed 75.5px `@mbabb`.
+ * A rectangle does not. Its seed is 67 — the players well's own washi seed
+ * (`GameControlPanel.vue:1042`) — so the head's stub and the well's tag are one hand.
+ *
+ * TWO POSES, BOTH BAKED AT MODULE SCOPE. The icon family's idiom verbatim (`InviteIcon` and its
+ * siblings): a static `aria-hidden` SVG in `currentColor` with no stroke, no filter and no beat
+ * — so it enters no subscriber and costs the filter census nothing. What is new is the second
+ * frame: a second `boilAmount` over the same seed, which is the house's own PATH SWAP (the
+ * grid's steady state, `gridPaths.ts:213`). The mark's hover and focus affordance is a swap
+ * between
+ * these two `d` strings and nothing else — the ink never moves, because a live mark's ink is
+ * the family's whole sentence and a lift that dims it says the opposite thing (pass-2 research
+ * R2: the 68% pressure lift reads ≈2.9:1 in light on a chromatic ink, failing 1.4.11).
+ *
+ * The SET RULE (PLR-COUNT's graft): re-arming the lift may only swap a pose, never un-draw one.
+ * Both frames are the same rectangle at the same fill, so there is no state in which the mark
+ * is partly drawn.
+ */
+/**
+ * THE AMOUNT IS MEASURED, NOT CHOSEN (pass 3). At `boilAmount 0.4` the swap moved 0.274 viewBox
+ * units = 0.229 CSS px at the widest vertex and 0.454/255 mean over the mark's box — a
+ * rectangle printed twice, which is what the pass-2 critique saw at crop size. Displacement is
+ * LINEAR in the amount at 0.5713 CSS px per unit (9 samples), so the amount is 2: 1.143 CSS px
+ * at the widest vertex, 70 of 231 inked pixels moving by ≥8/255, and 0/0 at `boilAmount 0` in
+ * the same run as the negative control. Frame 0 is amount-independent, so the RESTING mark is
+ * byte-identical to pass 2's and the solo-identity gate does not move.
+ *
+ * The FLOOR this clears (how much travel a swap owes a reader) is NOT derived here — pass 3
+ * pinned it to this prototype's own reading, which is the circularity its critic named. It is
+ * an owner's row (U-10, ballot in the return); what is asserted below the line is only that the
+ * swap moves by this much and that 0 moves by nothing.
+ */
+const POSES = generateRectBoilFrames(
+  2,
+  5.5,
+  20,
+  13,
+  { roughness: 0.4, segments: 4, seed: 67, jagged: true },
+  2,
+  2,
+);
+</script>
+
+<template>
+  <!-- Decorative: the control around it carries the accessible name (a11y r1 M6). -->
+  <svg
+    aria-hidden="true"
+    :width="size"
+    :height="size"
+    viewBox="0 0 24 24"
+    fill="none"
+    xmlns="http://www.w3.org/2000/svg"
+  >
+    <path :d="POSES[pose]" fill="currentColor" />
+  </svg>
+</template>
