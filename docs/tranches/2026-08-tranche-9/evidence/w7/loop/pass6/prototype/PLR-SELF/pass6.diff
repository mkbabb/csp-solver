+/**
+ * A TAP OPENS THE MARK, AND A TAP IS A LOOK (PLR-PLACE's seam; `TAP_IS_A_LOOK`, arm (b)).
+ * `@pointerdown.prevent` for every pointer cancelled a WebKit tap's click (pass 4), so the sheet
+ * toggles on the touch's own `pointerup`; and because the touch is prevented, the cell you were
+ * writing in keeps focus and the room hears nothing — as for a mouse press (row 2). The negative
+ * control swallows that `pointerup` in-run: the mark then stays shut in BOTH engines, which is
+ * what proves the open is the release's and not a click's.
+ */
+test('a tap opens the mark on a coarse phone, keeps the cell, and tells the room nothing', async ({
+  browser,
+}) => {
+  const { ctx, page } = await coarsePage(browser, 390, 844);
+  await invite(page);
+  await page.evaluate(() => {
+    const room = new URL(location.href).searchParams.get('s')!;
+    const seen: unknown[] = [];
+    (window as any).__frames = seen;
+    const ch = new BroadcastChannel(`board:${room}`);
+    ch.onmessage = (e: MessageEvent) => seen.push(e.data);
+  });
+  const curs = () =>
+    page.evaluate(
+      () =>
+        ((window as any).__frames as { kind?: string }[]).filter((f) => f?.kind === 'cur').length,
+    );
+  await page.locator('.sudoku-cell input').first().tap();
+  await expect.poll(curs).toBeGreaterThan(0);
+  await expect.poll(() => inCell(page)).toBe(true);
+
+  // THE NEGATIVE CONTROL: the release swallowed, the mark stays shut in both engines.
+  await page.evaluate(() => {
+    const m = [...document.querySelectorAll('[data-player-mark]')].find(
+      (e) => (e as HTMLElement).getBoundingClientRect().width > 0,
+    )!;
+    const swallow = (e: Event) => e.stopImmediatePropagation();
+    m.addEventListener('pointerup', swallow, { capture: true });
+    (window as any).__unplant = () =>
+      m.removeEventListener('pointerup', swallow, { capture: true });
+  });
+  await mark(page).tap();
+  await stable(() => mark(page).getAttribute('aria-expanded'));
+  await expect(mark(page)).toHaveAttribute('aria-expanded', 'false');
+  await page.evaluate(() => (window as any).__unplant());
+
+  // THE ROW.
+  await page.evaluate(() => ((window as any).__frames as unknown[]).splice(0));
+  await mark(page).tap();
+  await expect(mark(page)).toHaveAttribute('aria-expanded', 'true');
+  // sleep-ok: an ABSENCE has no event to poll — a look-away reaches the wire CUR_MS (120ms) after
+  // the cell lets go, so a 500ms window with nothing in it is the measurement, not a settle.
+  await page.waitForTimeout(500);
+  expect(await curs()).toBe(0);
+  expect(await inCell(page)).toBe(true);
+  // A second tap shuts it, once (Chromium's click for the touch is not a second toggle).
+  await mark(page).tap();
+  await expect(mark(page)).toHaveAttribute('aria-expanded', 'false');
+  await ctx.close();
