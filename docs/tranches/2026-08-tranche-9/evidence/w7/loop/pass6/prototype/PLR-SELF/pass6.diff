+test('a portrait phone compresses exactly where four rows would lap the board', async ({
+  browser,
+}) => {
+  const cell = async (w: number, h: number, long = false) => {
+    const p = await coarsePage(browser, w, h);
+    await invite(p.page);
+    if (long) {
+      // `long-66737` slugs to `straightforward-tyrannosaurus`, 29 characters, the longest pair
+      // the dictionaries make. 21s on, every peer is QUIET, so its row carries a qualifier too.
+      await p.page.evaluate((room) => {
+        const ch = new BroadcastChannel(`board:${room}`);
+        for (const id of ['long-66737', 'q-1', 'q-2', 'q-3', 'q-4', 'q-5'])
+          ch.postMessage({ kind: 'hi', data: {}, from: id });
