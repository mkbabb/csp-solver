+      await expect(p.page.locator('.players-roster')).toContainText('straightforward-tyrannosaurus');
+      await p.page.clock.setSystemTime(new Date(Date.now() + 21000));
+    } else await crowd(p.page, 6, `band-${w}x${h}`);
+    const r = await drawSheet(p.page);
+    await p.ctx.close();
+    return r;
+  };
+  // THE CLIFF, BOTH SIDES OF IT. At 390×800 and 360×800 the board's top sits above the tall
+  // sheet's bottom: one row, nothing lapped. The pass-5 key read FALSE there and drew four rows
+  // over seven cells — the witness is the query itself, evaluated on the same page.
+  for (const [w, h] of [
+    [390, 800],
+    [360, 800],
+    [390, 799],
+  ] as const) {
+    const r = await cell(w, h);
