+/**
+ * THE ROW BUDGET IS KEYED ON THE SPACE, MEASURED (pass-5 critic gap 1; pass-6 row 1).
+ *
+ * Pass 3 keyed it on `(min-height: 800px)` (a one-pixel desk cliff), pass 4 on the pointer (a
+ * landscape misfire), pass 5 on `(orientation: portrait) and (max-height: 799px)` — which moved
+ * the cliff to 390×799/800: four rows at 390×800 lapped seven cells where one row lapped none.
+ * The sheet now compresses when, drawn tall, it would lap a board that runs under its rows. Each
+ * row reads the cells the sheet actually covers, and carries the retired query, evaluated live on
+ * the same page, as the witness of why the old key drew the wrong budget there.
+ */
+const PASS3 = '(min-height: 800px)';
+const PASS5 = '(orientation: portrait) and (max-height: 799px)';
+
+async function drawSheet(page: Page) {
+  if ((await mark(page).getAttribute('aria-expanded')) !== 'true') await mark(page).click();
+  await openSheet(page);
+  return lobby(page).evaluate(
+    (el, q) => {
+      const s = el.getBoundingClientRect();
+      const lapped = [...document.querySelectorAll('.sudoku-cell')]
+        .map((c) => c.getBoundingClientRect())
+        .filter(
+          (c) =>
+            c.width > 0 && c.left < s.right && c.right > s.left && c.top < s.bottom && c.bottom > s.top,
+        ).length;
+      return {
+        rows: el.querySelectorAll('.pl-row').length,
+        more: el.querySelector('.pl-more')?.textContent?.trim() ?? '',
+        lapped,
+        pass3: matchMedia(q.PASS3).matches,
+        pass5: matchMedia(q.PASS5).matches,
+      };
+    },
+    { PASS3, PASS5 },
+  );
+}
+
+test('the desk draws the same rows at 800 and at 799, and the pass-3 query is why it did not', async ({
+  page,
+}) => {
+  await page.setViewportSize({ width: 1280, height: 800 });
+  await page.goto(SOLO);
+  await settled(page);
+  await invite(page);
+  await crowd(page, 6, 'rows-spec');
+
+  const tall = await drawSheet(page);
+  await page.setViewportSize({ width: 1280, height: 799 });
+  await expect.poll(() => page.evaluate(() => innerHeight)).toBe(799);
+  await mark(page).click();
+  await expect(mark(page)).toHaveAttribute('aria-expanded', 'false');
+  const short = await drawSheet(page);
+  // The desk's corner lap is CH-71's ratified pose: the board is BESIDE the rows' start.
+  expect(tall.rows).toBe(4);
+  expect(tall.more).toBe('and 3 more');
+  // THE ROW: one pixel of desk viewport moves nothing.
+  expect(short.rows).toBe(tall.rows);
+  expect(short.more).toBe(tall.more);
+  // THE NEGATIVE CONTROL: the query pass 3 keyed on DID flip across that pixel.
+  expect(tall.pass3).toBe(true);
+  expect(short.pass3).toBe(false);
+});
