+ * THE SHEET NEVER SCROLLS, SO THE SPACE DECIDES HOW MANY ROWS IT HOLDS — AND THE SPACE IS READ.
+ *
+ * Two budgets: `tall` draws four rows and `and N more`, `short` draws your row and `and N more`.
+ * The sheet takes `short` when, drawn tall, it would lap a board that runs under its rows from
+ * where they start. Both facts are MEASURED at the open (and again when the room changes while it
+ * is open), never keyed on a media query: the pass-5 key `(orientation: portrait) and
+ * (max-height: 799px)` drew four rows at 390×800 and lapped seven cells where one row lapped none,
+ * because what decides the lap is where the board's top sits, and that moves with the width.
+ *   · the tall sheet's bottom is read off the sheet ITSELF, laid out and untransformed (the
+ *     offset box, so the 150ms scale-in is not in it) — a wrapped 29-character slug is in it too;
+ *   · the board's box comes from `App.vue`, because pencil may not import a board.
+ * The board BESIDE the sheet is not under its rows: the desk's corner lap is CH-71's ratified
+ * pose (1280×800: four rows over two or three cells, one row over one or two), and a coarse
+ * landscape phone keeps four rows AT A PRICE — at 844×390 six cells where one row laps four, at
+ * 812×375 five against three, and on the widest board (16×16) nine against six and eighteen
+ * against twelve. Stated, not denied; the landscape cell is ONE π row the fold reads.
+ * The re-read and the budget flip happen in one microtask pair, so no tall frame is painted.
+ */
+const ROWS = { tall: 5, short: 2 } as const;
+const cramped = ref(false);
+const budget = computed(() => (cramped.value ? ROWS.short : ROWS.tall));
+
+async function fit(): Promise<void> {
+  cramped.value = false;
+  await nextTick();
+  const sheet = document.getElementById(lobbyId);
+  const host = sheet?.offsetParent;
+  const board = props.boardBox?.();
+  if (!sheet || !(host instanceof HTMLElement) || !board) return;
+  const at = host.getBoundingClientRect();
+  const rowsStart =
+    at.left + sheet.offsetLeft + parseFloat(getComputedStyle(sheet).paddingLeft);
+  const bottom = at.top + sheet.offsetTop + sheet.offsetHeight;
+  cramped.value = board.left <= rowsStart && board.top < bottom;
