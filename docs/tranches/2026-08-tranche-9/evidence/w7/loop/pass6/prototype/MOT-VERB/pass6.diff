+    ["layout", "the one animated layout row", ["curve"]],
+  ],
+  // ── GRADED — the players well. Six numbers that are ONE decision: a return is lighter than
+  // an arrival (the fold lands 40ms sooner, the write-in 80ms). Naming them rung by rung
+  // shortens the arriving name by 130ms, which B6/the quality law forbid as a sweep, so the
+  // set is admitted whole at its auditioned literals and the rung expression is a pass-3
+  // audition the owner disposes.
+  [
+    "games/shared/GameControlPanel.vue :: player-row-open 320ms var(--ease-glassGlide) backwards #1",
+    ["graded", "an arrival's fold", ["rung"]],
