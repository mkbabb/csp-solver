+const DECL = /(?<![\w-])(transition|animation)([a-z-]*):\s*([^;{}]+);/g;
+const RUNG_VAR = /var\(\s*--motion-([A-Za-z]+)\s*(?:,\s*(\d+(?:\.\d+)?m?s)\s*)?\)/g;
+const OTHER_VAR = /var\(\s*(--[A-Za-z-]+)\s*(?:,\s*(\d+(?:\.\d+)?m?s)\s*)?\)/g;
+const MOTION_TS = /\bMOTION\.rungs\.[A-Za-z]+|v-bind\([^)]*MOTION[^)]*\)/;
