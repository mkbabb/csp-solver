+    ["shape", "the toggle's squash", ["rung"]],
+  ],
+  [
+    "pencil/celestial/DarkModeToggle.vue :: plush-land 1010ms both #1",
+    ["shape", "the plush landing", ["rung"]],
+  ],
+  [
+    "pencil/chrome/icons/DiceIcon.vue :: diceRoll var(--motion-throw) var(--ease-springPop) forwards #1",
+    ["shape", "an icon figure", ["curve"]],
