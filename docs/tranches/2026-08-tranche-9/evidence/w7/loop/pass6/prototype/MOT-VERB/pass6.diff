+    const body = m[3];
+    const line = text.slice(0, m.index).split("\n").length;
+    const before = text.slice(0, m.index);
+    const lineStart = before.lastIndexOf("\n") + 1;
+    const head = text.slice(lineStart, m.index).trim();
