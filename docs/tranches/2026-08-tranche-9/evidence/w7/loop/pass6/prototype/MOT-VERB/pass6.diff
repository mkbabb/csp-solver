+    "pencil/chrome/icons/SolveIcon.vue :: sparkleGrow var(--motion-throw) var(--ease-springPop) forwards #1",
+    ["shape", "an icon figure", ["curve"]],
+  ],
+  // Two press flourishes, reverted to their auditioned lengths in pass 2: a one-shot figure
+  // on a press is shape, and T6's cure path binds it from CELEBRATION file by file.
+  [
+    "games/shared/GameControlPanel.vue :: sharePop 500ms ease #1",
+    ["shape", "the share press flourish", ["curve", "rung"]],
+  ],
+  [
+    "games/shared/GameControlPanel.vue :: eraserScrub 400ms ease #1",
