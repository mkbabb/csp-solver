+/** Where a rung reaches CSS from. */
+/** Every `@property --name { … }` in a sheet, with its brace depth on the COMMENT-MASKED text
+ *  (a registration quoted in prose is not a registration) and its body. */
+function registrations(text) {
+  const masked = text.replace(/\/\*[^]*?\*\//g, (m) => m.replace(/[^\n]/g, " "));
+  const out = [];
+  let depth = 0;
+  for (let i = 0; i < masked.length; i++) {
+    const c = masked[i];
+    if (c === "{") depth++;
+    else if (c === "}") depth = Math.max(0, depth - 1);
+    else if (c === "@" && masked.startsWith("@property", i)) {
+      const m = /^@property\s+--([A-Za-z0-9-]+)\s*\{([^}]*)\}/.exec(masked.slice(i));
+      if (!m) continue;
+      out.push({ name: m[1], depth, body: m[2] });
+      i += m[0].length - 1; // the registration's own braces never change the depth
+    }
+  }
+  return out;
