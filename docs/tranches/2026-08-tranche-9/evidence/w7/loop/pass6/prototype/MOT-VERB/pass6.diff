+  // ── SHAPE — T6's motion vocabulary spends a raw number at the shorthand. Its own law says
+  // the number must arrive bound; the cure is mechanical (bind it the way CELEBRATION binds
+  // --draw-dur) and lands file by file.
+  [
+    "assets/index.css :: refuse-shake var(--refuse-dur) linear #1",
+    [
+      "shape",
+      "the error family's own figure, now bound (the length is MOTION.characters.refuse)",
+      ["curve"],
+    ],
+  ],
+  [
+    "assets/index.css :: cell-reveal 0.3s var(--ease-anticipatePop) #1",
+    ["shape", "the cell reveal is a T6 incumbent", ["rung"]],
+  ],
+  [
+    "assets/index.css :: var(--reveal-delay, 0ms) #1",
