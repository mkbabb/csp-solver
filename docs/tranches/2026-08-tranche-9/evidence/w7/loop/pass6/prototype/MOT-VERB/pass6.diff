+
+/** The row of the ledger that admits this position, or null. Content anchored. */
+function admits(d, ms, ledger = LEDGER) {
+  for (const row of ledger)
+    if (
+      // MOVED / RETUNE / DELETED rows admit no literal: their `ms` is the SUBJECT's banked
+      // value (a number), never a list of admitted lengths — B6 reads them, B1 never does.
+      Array.isArray(row.ms) &&
+      row.file === d.file &&
+      row.ms.includes(ms) &&
+      row.anchor &&
+      d.window.includes(row.anchor)
