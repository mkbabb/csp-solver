+    // animation runs. It survives a retune, which a line number and a millisecond do not:
+    // research §7 row 13 measured `file :: line` colliding 15× and `file :: prop :: ms` 23×
+    // over the same rows, against 0 for `file :: selector :: term`.
+    const term = (/^\s*([A-Za-z-]+)/.exec(pretty)?.[1] ?? "—").trim();
+    seq.forEach((t, i) => {
+      let role = longhand ?? (i === 0 ? "duration" : i === 1 ? "delay" : "extra");
