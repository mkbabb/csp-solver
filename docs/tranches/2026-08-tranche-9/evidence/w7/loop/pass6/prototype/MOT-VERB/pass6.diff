+  // THE REFUSAL SHAKE — the one row the deleted `isShape` carve-out was really covering. A
+  // refusal is a FIGURE, not a travel: `linear` is its per-step timing, deliberately, because a
+  // shake that eases is a wobble. Its length is bound at `--refuse-dur` (MOT-LADDER §1.5, one
+  // home for the cell's refusal and the solve verdict), so the only rule it breaks is the curve.
+  [
+    "games/shared/DigitCell.vue :: refuse-shake var(--refuse-dur) linear #1",
+    [
+      "shape",
+      "a refusal is a figure; `linear` is its per-step timing and `--refuse-dur` is the character's one binding",
+      ["curve"],
+    ],
+  ],
+  // ── SIGNATURE — a length the owner auditioned and kept. Assigned, never retuned.
+  // THE LAMINATE'S LAY-DOWN, 280ms — admitted rather than rounded (§1.2). The owner kept this
+  // pose at T4-W10 and the ladder has no 280: shortening it to `note` buys nothing under the
+  // quality law and lengthening it to `dusk` moves a ratified pose with no audition (U-10). It
+  // breaks ONE rule, the rung, and it names its curve like everything else.
+  [
+    "pencil/sheet/AnswerKeyLaminate.vue :: opacity 280ms var(--verb-layDown-ease), transform 280ms var(--verb-layDown-ease) #1",
+    [
+      "signature",
+      "the laminate's lay-down, owner-preserved at T4-W10; R6 §1.2's erase asymmetry (280 down, 200 up)",
+      ["rung"],
+    ],
+  ],
+  [
+    "pencil/chrome/HandwrittenLogo/HandwrittenLogo.vue :: clip-path 1.2s var(--ease-noteWrite) #1",
+    ["signature", "the wordmark's wipe", ["curve", "rung"]],
+  ],
+  // THE TOGGLE'S GESTURE, ADMITTED WHOLE (T9-W7 pass 2 §3). Eleven values, one character.
+  // Half-assigning it moved four beats on the owner's most-audited surface; the beat table
+  // beside the gesture is this admission's cite and rule 8's fixture.
+  [
+    "pencil/celestial/DarkModeToggle.vue :: transform 800ms var(--ease-springPop) 60ms !important #1",
+    ["signature", "the bloom", ["curve", "rung"]],
+  ],
+  [
+    "pencil/celestial/DarkModeToggle.vue :: opacity 300ms var(--ease-standard) 60ms !important #1",
+    ["signature", "the incoming icon's rise", ["curve", "rung"]],
+  ],
+  [
+    "pencil/celestial/DarkModeToggle.vue :: opacity 100ms var(--ease-standard) 240ms !important #1",
+    [
+      "signature",
+      "the outgoing icon's fade, in the last wring beat",
+      ["curve", "rung"],
+    ],
