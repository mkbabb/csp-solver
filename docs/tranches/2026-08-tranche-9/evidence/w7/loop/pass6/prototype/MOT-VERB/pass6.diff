+  // never walk back past the block the CSS lives in: `</p> <button v-if="retryable"` is not
+  // a selector, and it was one of the 17.
+  const floor = Math.max(before.lastIndexOf("<style"), 0);
+  const head = before.slice(floor, open);
+  const cut = Math.max(
+    head.lastIndexOf("}"),
+    head.lastIndexOf("{"),
+    head.lastIndexOf(";"),
+  );
