+        `MOTION\\.rungs\\.${p.rung}|spend\\(\\s*"[a-zA-Z]+"\\s*,\\s*"${p.rung}"`,
+      ).test(t)
+    )
+      bad.push(
+        `${p.file}  ${p.what} reads neither MOTION.rungs.${p.rung} nor spend(…, "${p.rung}") — a pinned value is the rung, never a literal beside it.`,
+      );
+    if (!p.doc.test(rungDoc) && !p.doc.test(src))
+      bad.push(
+        `MOTION.rungs.${p.rung}'s docstring does not name ${p.what}'s ruling — the cite at the site and the cite on the rung must be the same ruling.`,
+      );
+  }
+  return bad;
+}
+
+/**
+ * B11 — THE KIND FENCE (the CODE roster). 77 clocks live in .ts/<script>, 19 of them bare
+ * literals at HEAD, against 85 CSS terms: "one home for every length" is only true if the
+ * gate reads BOTH rosters. Four kinds, and every clock is one of them:
+ *   TRAVEL   a painted length — reads the ladder, a rung expression, or an ADMITTED class
+ *   WINDOW   a class held over a gesture — derives from a rung, or says `// window:` and why
+ *   CADENCE  a beat — reads MOTION.beatMs / beatsFor()
+ *   POLICY   a deadline, a backoff, a dwell, a wire rate — carries `// policy: <word>`, and
+ *            is out of scope BY KIND, never by file type
+ * Comments and type annotations are STRIPPED before the read, so the nine instrument
+ * artefacts research named (type positions, prose) are the self-test's negative-negative.
+ */
+const KIND_FILES = /\.(ts|vue)$/;
+const CLOCK = /\b(\d{2,5})\b/;
+const POLICY_TAG = /\/\/\s*policy:\s*\w+/;
+const WINDOW_TAG = /\/\/\s*window:\s*\S+/;
+/** The TS half of §2.2's GRADED class — a set whose differences ARE the design, cited. */
+const GRADED_TAG = /\/\/\s*graded:\s*\S+/;
+const TRAVEL_READ =
+  /MOTION\.rungs\.[A-Za-z]+|MOTION\.characters\.[A-Za-z]+|MOTION\.settleGuardMs|MOTION\.dealStaggerMs|MOTION\.beatMs|beatsFor\(|spend\(/;
+
+/** Strip comments and TS type positions, keeping line numbers. */
+function stripCode(text) {
+  return text
+    .replace(/\/\*[^]*?\*\/|<!--[^]*?-->/g, (m) => m.replace(/[^\n]/g, " "))
+    .replace(/^([^\n"'`]*?)\/\/.*$/gm, (_m, keep) => keep)
+    .replace(/:\s*(?:number|string|boolean)\b/g, "")
+    .replace(/\bas const\b/g, "");
+}
+
+function b11KindFence() {
+  const bad = [];
+  const rows = [];
+  for (const file of walk(SRC)) {
+    const rel = relative(ROOT, file);
+    if (!KIND_FILES.test(rel) || rel.includes("/pencil/dev/")) continue;
+    if (/\.(test|spec)\.ts$/.test(rel)) continue;
+    // pencilConfig IS the home (R6 law 4). B2 rules every number in it, by name and by
+    // cite; B11's business is the lengths that live OUTSIDE it.
+    if (rel.endsWith("pencil/config/pencilConfig.ts")) continue;
+    let text = readFileSync(file, "utf8");
+    if (rel.endsWith(".vue")) {
+      const s = text.indexOf("<script");
+      const e = text.indexOf("</script>");
+      text =
+        s >= 0 && e > s
+          ? text.slice(0, s).replace(/[^\n]/g, "") + text.slice(s, e)
+          : "";
+    }
+    if (!text) continue;
+    const raw = text.split("\n");
+    const code = stripCode(text).split("\n");
+    for (let i = 0; i < code.length; i++) {
+      const line = code[i];
+      // A clock is a millisecond a TIMER, an ANIMATION or a *_MS const spends.
+      // A STAGGER is a clock too (P5-M19-3): `const stagger = 90` spent the deal's delay step
+      // for four passes because none of the other shapes reads it.
+      const isClock =
+        /setTimeout\s*\(|setInterval\s*\(|duration\s*:|\.animate\s*\(|_MS\b|Ms\b\s*[:=]|\b[sS]tagger\w*\s*[:=]/.test(
+          line,
+        ) && CLOCK.test(line);
+      if (!isClock) continue;
+      if (
+        /MOTION\.rungs|rungs\./.test(line) &&
+        !/\d{2,5}/.test(line.replace(/rungs\.\w+/g, ""))
+      )
+        continue;
+      const ctx = raw.slice(Math.max(0, i - 4), i + 2).join("\n");
+      // An ADMITTED TS class is admitted WHOLE: a clock inside its object is the class's,
+      // not a stray. Walked back to the nearest `const NAME = {`, so a fifteen-constant
+      // table (`WASH`) is one row and not fifteen reds.
+      let cls = null;
+      for (let j = i; j >= 0 && j > i - 400; j--) {
+        const m = /^\s*(?:export\s+)?const ([A-Z][A-Z0-9_]*)\s*=\s*\{/.exec(code[j]);
+        if (m) {
+          cls = m[1];
+          break;
+        }
+        if (/^\}/.test(code[j])) break;
+      }
+      const kind =
+        TRAVEL_READ.test(line) ||
+        // a stagger's kind is read off its OWN line: a neighbour reading the ladder (the
+        // deal's `base` reads `MOTION.rungs.throw` one line up) does not home a literal step
+        (!/\b[sS]tagger\w*\s*[:=]/.test(line) && TRAVEL_READ.test(ctx)) ||
+        (cls && cls in ADMITTED_TS)
+          ? "TRAVEL"
+          : GRADED_TAG.test(ctx)
+            ? "TRAVEL"
+            : POLICY_TAG.test(ctx)
+              ? "POLICY"
+              : WINDOW_TAG.test(ctx)
+                ? "WINDOW"
+                : null;
+      rows.push({ rel, line: i + 1, text: line.trim().slice(0, 90), kind, cls });
+      if (!kind)
+        bad.push(
+          `${rel}:${i + 1}  a bare clock, no kind — TRAVEL reads the ladder, WINDOW derives and says so, CADENCE reads beatMs, POLICY carries \`// policy: <word>\`.  ${line.trim().slice(0, 80)}`,
+        );
+    }
+  }
+  return { bad, rows };
+}
+
+/**
+ * B12 (static half) — THE ABSENCE ROW, chair §6.5's born-RED. The runtime half deletes the
+ * publisher call in a scratch build and reads `.icon-btn`: `transition-duration: 0s`,
+ * `transition-property: opacity`. What CI can hold is the two things that make that outcome
+ * possible at all: the registration exists, and its initial is 0ms rather than a rung value.
+ */
+function b12Absence(p) {
+  const bad = [];
+  if (!p.pub.registered)
+    bad.push(
+      "no @property registration: an absent publisher leaves an UNKNOWN token, the transition shorthand falls back to `all`, and the page looks fine while the ladder is gone.",
+    );
+  if (!p.pub.initialStill)
+    bad.push("a registration ships a non-zero initial — absence would read as motion.");
+  return bad;
+}
+
+/** G-REFUSE-ONE-HOME — the character's length is typed ONCE, in TS. */
+function gRefuseOneHome(src) {
+  const bad = [];
+  if (!/characters:\s*\{[^]*?\brefuse:\s*\d+/.test(src))
+    bad.push(
+      "MOTION.characters.refuse is not declared — the refuse-shake has no one home.",
+    );
+  const theme = readFileSync(THEME, "utf8");
+  for (const m of theme.matchAll(/animation:\s*refuse-shake\s+([^\s;]+)/g))
+    if (!/^var\(--refuse-dur\)$/.test(m[1]))
+      bad.push(
+        `index.css  .solve-failure runs refuse-shake at ${m[1]} — a CSS consumer reads var(--refuse-dur), never a literal twin.`,
+      );
+  const cell = join(SRC, "games/shared/useGameCell.ts");
+  const t = existsSync(cell) ? readFileSync(cell, "utf8") : "";
+  if (t && !/MOTION\.characters\.refuse/.test(t))
+    bad.push(
+      "useGameCell.ts types its own refusal length — the character's number lives in MOTION.characters.",
+    );
+  return bad;
+}
+
+/**
+ * B9 — THE DELAY FENCE (MOT-VERB's rule, adopted section wide). The ladder governs
+ * TRAVEL. A delay is a beat alignment against another gesture's clock, and a shared rung
+ * would make one retune move two unrelated things.
+ */
+function b9DelayFence(decls) {
+  const bad = [];
+  for (const d of decls)
+    for (const q of d.pos)
+      if ((q.role === "delay" || q.role === "extra") && q.kind === "rung")
+        bad.push(
+          `${d.rel}  var(--motion-${q.rung}) in a DELAY position — a delay keeps its literal.  ${q.clause}`,
+        );
+  return bad;
+}
+
+/**
+ * G-DOCK-BAND (static half) — the dock's clock declares the band it governs, both ends.
+ * The dock inherited 520ms from a desk gesture and nobody ever saw it against the 302…681 px
+ * it actually travels. Whatever rung `useControlsDrawer` spends on the dock pose must carry a
+ * `travel: <a>px @WxH … <b>px @WxH` line; the runtime half measures the live sheet against it.
+ */
+/**
+ * THE CRITERION, as a pure function of the series and its ceiling. The shortest audited
+ * clock whose WORST RATE clears the ceiling at every pose and in every engine.
+ *
+ * Why a rate and not a frame count: a 120 Hz panel halves the displacement per sample and
+ * doubles the samples, so `worst frame (px)` reads a panel, not a gesture (LAWS §Gates —
+ * budgets are rates per second). Why shortest-that-clears and not the minimum of a
+ * statistic: `worst frame` and `excess area` both FALL MONOTONICALLY as the clock rises at
+ * matched travel, so either one, minimised, picks the longest clock offered and nothing is
+ * chosen (pass-3 critique §2.3). Against a fixed ceiling the objective inverts — shorter is
+ * better, the ceiling is the constraint — and the optimum is interior.
+ *
+ * The ceiling itself is a PARAMETER, declared in the series with its source and disposed by
+ * the owner (U-10). Moving it moves the pick, which is the whole point; it is not derived
+ * here and this file does not pretend it is.
+ */
+/** The spread above which a cell's excursion is not matched across rounds: the cell measures
+ *  the sampler, not the clock, and is reported as the instrument's defect (pass-4 critique §2.2). */
+const MATCHED_SPREAD_PX = 1;
+
+function dockPick(series) {
+  const matched = series.poses.filter(
+    (p) => (p.travelSpreadPx ?? 0) <= MATCHED_SPREAD_PX,
+  );
+  const clocks = [
+    ...new Set(matched.flatMap((p) => Object.keys(p.clocks).map(Number))),
+  ].sort((a, b) => a - b);
+  const worst = (ms) =>
+    matched.reduce(
+      (w, p) => {
+        const r = p.clocks[String(ms)]?.worstRatePxPerSec ?? -1;
+        return r > w.rate ? { rate: r, cell: `${p.name}, ${p.engine}` } : w;
+      },
+      { rate: -1, cell: "" },
+    );
+  const clears = (ms) =>
+    matched.length > 0 &&
+    matched.every((p) => {
+      const c = p.clocks[String(ms)];
+      return c && c.worstRatePxPerSec <= series.ceilingPxPerSec;
+    });
+  const won = clocks.find(clears);
+  return {
+    clocks,
+    pick: won ?? clocks[clocks.length - 1],
+    cleared: won !== undefined,
+    worst,
+    matched,
+    unmatched: series.poses.filter((p) => !matched.includes(p)),
+  };
+}
+
+/**
+ * G-DOCK-BAND — the dock's clock declares the band it governs, and the band is CHECKED
+ * AGAINST THE MEASUREMENT, not against itself.
+ *
+ * Pass 3 shipped this as a presence regex over the rung's own docstring; its critic falsified
+ * `293px` to `9999px` and the gate stayed green, then deleted the worst-frame lines and it
+ * stayed green again (critique §2.2). A gate that reads only the prose it tests can only test
+ * that prose exists. Five clauses now, four of them numeric, every one falsifiable:
+ *   1 a measured series exists, on this base, with ≥2 clocks — one clock cannot choose;
+ *   2 the travel ends in the docstring equal the series' own min/max within 1px;
+ *   3 the docstring's `ceiling:` equals the series' declared ceiling;
+ *   4 the docstring's `pick:` equals `dockPick()` — falsify any reading and the pick moves;
+ *   5 the SHIPPED rung is the pick, or is ruling 1's 520 carrying the ballot cite (U-10).
+ */
+function gDockBand({ rungDoc, rungs }) {
+  const bad = [];
+  const drawer = join(SRC, "games/shared/useControlsDrawer.ts");
+  const t = existsSync(drawer) ? readFileSync(drawer, "utf8") : "";
+  const m =
+    /mobileDock[^\n]*MOTION\.rungs\.([A-Za-z]+)|rungs\.([A-Za-z]+)\s*:\s*MOTION\.rungs|dock\s*\?\s*spend\(\s*"[a-zA-Z]+"\s*,\s*"([A-Za-z]+)"/.exec(
+      t,
+    );
+  const dockRung = m ? (m[1] ?? m[2] ?? m[3]) : null;
+  if (!dockRung)
+    return [
+      "the dock spends no named rung — a length nobody saw against its distance.",
+    ];
+  const shipped = rungs.find((r) => r.key === dockRung)?.value ?? null;
+
+  let series;
+  try {
+    series = JSON.parse(readFileSync(SERIES, "utf8"));
+  } catch {
+    return [
+      `no measured dock series at ${relative(ROOT, SERIES)} — the band has nothing to be checked against, and a gate whose evidence is unreachable does not green.`,
+    ];
+  }
+  if (series.base !== BASE_REF)
+    bad.push(`the dock series was measured against ${series.base}, not ${BASE_REF}.`);
+  if (!series.build) bad.push("the dock series records no build identity.");
+  const { clocks, pick, cleared, worst, matched } = dockPick(series);
+  if (matched.length < 2)
+    bad.push(
+      `the dock series has ${matched.length} matched cell(s) (travel spread ≤ ${MATCHED_SPREAD_PX}px) — a rate over an unmatched excursion measures the sampler.`,
+    );
+  if (clocks.length < 2)
+    bad.push(
+      `the dock series audits ${clocks.length} clock(s); a criterion needs at least two to choose between.`,
+    );
+
+  // 2 · the declared travel ends against the measured ones
+  const ends = [...rungDoc.matchAll(/([\d.]+)px @(\d+)x(\d+)/g)].map((x) =>
+    Number(x[1]),
+  );
+  const measured = series.poses.map((p) => p.travelPx);
+  for (const e of ends)
+    if (!measured.some((v) => Math.abs(v - e) <= 1))
+      bad.push(
+        `the rung declares travel ${e}px and the series measures none within 1px of it (${measured.map((v) => v.toFixed(1)).join(", ")}).`,
+      );
+  if (ends.length < 2)
+    bad.push("the rung declares fewer than two travel ends — no band, only a number.");
+
+  // 3 · the ceiling
+  const dc = /ceiling:\s*([\d.]+)\s*px\/s/.exec(rungDoc);
+  if (!dc)
+    bad.push("the rung declares no `ceiling: <n>px/s` — the criterion's parameter.");
+  else if (Number(dc[1]) !== series.ceilingPxPerSec)
+    bad.push(
+      `the rung declares ceiling ${dc[1]}px/s; the series was scored at ${series.ceilingPxPerSec}px/s.`,
+    );
+
+  // 4 · the pick
+  const dp = /pick:\s*(\d+)ms/.exec(rungDoc);
+  if (!dp) bad.push("the rung declares no `pick: <n>ms` — the criterion's answer.");
+  else if (Number(dp[1]) !== pick)
+    bad.push(
+      `the rung declares pick ${dp[1]}ms; the series at its own ceiling picks ${pick}ms.`,
+    );
+  if (!cleared && !/CEILING UNCLEARED/.test(rungDoc))
+    bad.push(
+      "no audited clock clears the declared ceiling and the rung does not say so — the pick is the longest clock audited, which is not a choice.",
+    );
+
+  // 6 · THE BALLOT'S NUMBERS are the matched worst, with the cell NAMED (pass-4 critique §2.2:
+  //     the sentence quoted chromium's 5411/4739 beside webkit frames, from the one cell whose
+  //     travel was not matched). The sentence and every table row are recomputed from the file.
+  const bs =
+    /Choosing (\d+) over (\d+) is choosing (\d+)\s*px\/s over (\d+)\s*px\/s at the worst MATCHED cell\s*\*?\s*\((\d+x\d+(?:-\w+)?), (\w+)\)/.exec(
+      rungDoc.replace(/\n\s*\*\s*/g, " "),
+    );
+  if (!bs)
+    bad.push(
+      "the rung states no ballot sentence priced on a MATCHED cell with the cell named.",
+    );
+  else {
+    const [, a, b, ra, rb, pose, engine] = bs;
+    const wa = worst(Number(a));
+    const wb = worst(Number(b));
+    if (Math.abs(wa.rate - Number(ra)) > 1 || Math.abs(wb.rate - Number(rb)) > 1)
+      bad.push(
+        `the ballot sentence prices ${a} vs ${b} at ${ra} vs ${rb}px/s; the matched series reads ${Math.round(wa.rate)} vs ${Math.round(wb.rate)}.`,
+      );
+    if (wa.cell !== `${pose}, ${engine}`)
+      bad.push(
+        `the ballot sentence names (${pose}, ${engine}); the matched worst at ${a}ms is (${wa.cell}).`,
+      );
+  }
+  for (const [, r, ms] of rungDoc.matchAll(/(\d{4})(?:\s*px\/s)?\s*→\s*(\d{3})ms/g))
+    if (Math.abs(worst(Number(ms)).rate - Number(r)) > 1)
+      bad.push(
+        `the ballot table says ${r}px/s → ${ms}ms; the matched worst at ${ms}ms is ${Math.round(worst(Number(ms)).rate)}.`,
+      );
+
+  // 5 · what actually ships
+  if (shipped !== pick && !(shipped === 520 && /BALLOT/.test(rungDoc)))
+    bad.push(
+      `the dock ships ${shipped}ms against a pick of ${pick}ms, with no BALLOT row holding it at ruling 1's 520.`,
+    );
+  return bad;
+}
+
+/** G-GUARD — one settle-guard constant, read by both FLIP engines. */
+function gGuard() {
+  const bad = [];
+  const flip = join(SRC, "games/shared/useFlipGlide.ts");
+  const car = join(SRC, "pencil/chrome/GameGallery/useCarouselGlide.ts");
+  for (const [f, name] of [
+    [flip, "useFlipGlide"],
+    [car, "useCarouselGlide"],
+  ]) {
+    if (!existsSync(f)) continue;
+    const t = readFileSync(f, "utf8");
+    if (!/MOTION\.settleGuardMs/.test(t))
+      bad.push(
+        `${name} does not read MOTION.settleGuardMs — two engines, two backstops, one unruled.`,
+      );
+    if (/\+\s*200\b/.test(t) && !/MOTION\.settleGuardMs/.test(t))
+      bad.push(`${name} carries its own "+ 200" guard literal.`);
+  }
+  return bad;
+}
+
+/* ── main ──────────────────────────────────────────────────────────────────── */
+
+const decls = collect();
+const lad = ladder();
+const pub = published(lad.src);
+const rungKeys = new Set(lad.rungs.map((r) => r.key));
