diff --git a/web/frontend/src/pencil/chrome/MarginNote.test.ts b/web/frontend/src/pencil/chrome/MarginNote.test.ts
new file mode 100644
index 00000000..ccd39264
--- /dev/null
+++ b/web/frontend/src/pencil/chrome/MarginNote.test.ts
@@ -0,0 +1,161 @@
+import { describe, it, expect, vi, afterEach } from "vitest";
+import { mount } from "@vue/test-utils";
+import { nextTick } from "vue";
+import MarginNote from "./MarginNote.vue";
+import source from "./MarginNote.vue?raw";
+
+/**
+ * T9-W7 §7 — THE PUSH AND THE RESERVE IT READS FROM, gated where CI can see them.
+ *
+ * Both cures were probe readings with nothing shipping behind them (pass-5 critique §2.1, §2.3):
+ * the push re-darkened a spent record for one rung, and the voice's in-flow reserve could be
+ * deleted with every gate green. The first row reads the push's keyframe 0 through a stubbed
+ * `animate`; the second reads the stylesheet's shape, and carries its own plants.
+ */
+
+// The two inks the push can start from, painted by a sheet jsdom cascades (VTU injects no SFC
+// styles). Distinct values, so the row reads which one keyframe 0 took.
+const SPENT_INK = "rgb(1, 2, 3)";
+const GRAPHITE = "#0a0b0c"; // a custom property reads back as authored
+function paint() {
+  const sheet = document.createElement("style");
+  sheet.textContent =
+    `.margin-note.is-spent { color: ${SPENT_INK}; }` +
+    `.margin-note-previous { --color-pencil-graphite: ${GRAPHITE}; color: rgb(4, 5, 6); }`;
+  document.head.append(sheet);
+  return sheet;
+}
+
+const realAnimate = Element.prototype.animate;
+afterEach(() => {
+  Element.prototype.animate = realAnimate;
+  document.head.querySelectorAll("style").forEach((s) => s.remove());
+});
+
+async function push(spent: boolean) {
+  paint();
+  const calls: Keyframe[][] = [];
+  // jsdom has no WAAPI: the stub records the call and returns nothing the watch reads.
+  Element.prototype.animate = vi.fn(function (kf: Keyframe[]) {
+    calls.push(kf);
+    return {} as Animation;
+  }) as unknown as typeof Element.prototype.animate;
+  const w = mount(MarginNote, {
+    props: { text: "only 4 fits here", seq: 1, spent },
+    attachTo: document.body,
+  });
+  await w.setProps({
+    text: "only 2 fits here",
+    seq: 2,
+    spent: false,
+    previous: "only 4 fits here",
+    previousSeq: 1,
+  });
+  await nextTick();
+  w.unmount();
+  return calls;
+}
+
+describe("MarginNote — the push starts from the ink the record was painted in", () => {
+  it("a SPENT record ages from its own quiet ink, never back up to full graphite", async () => {
+    const calls = await push(true);
+    expect(calls, "one push per displacement").toHaveLength(1);
+    expect(calls[0][0].color, "keyframe 0 is the displaced line's painted ink").toBe(
+      SPENT_INK,
+    );
+  });
+
+  it("an open record ages from full graphite, as it always has", async () => {
+    const calls = await push(false);
+    expect(calls).toHaveLength(1);
+    expect(calls[0][0].color).toBe(GRAPHITE);
+  });
+});
+
+// ── THE VOICE'S RESERVE (row 7) ───────────────────────────────────────────────────────────
+// Below 1024 the push reads line one's rect as its `from`, and an empty voice was a 0×0 box
+// (the record flew in from nowhere, `translate(0, −34.17) scale(1.31)`). The cure is ONE
+// declaration in ONE place: `.margin-note { min-height: inherit }` inside the <1024 block,
+// taking the block's reserve. Anywhere wider it grows the desk strip (+5.27 px, pass 5), and a
+// number instead of `inherit` grew the landscape strip (+1.29 / +1.18 px). The law reads that
+// shape, and the plants below are its negative controls, run every time it runs.
+type Rule = { prelude: string; body: string };
+function rules(css: string): Rule[] {
+  const out: Rule[] = [];
+  let depth = 0;
+  let start = 0;
+  let open = 0;
+  for (let i = 0; i < css.length; i++) {
+    if (css[i] === "{" && depth++ === 0) open = i;
+    else if (css[i] === "}" && --depth === 0) {
+      out.push({
+        prelude: css.slice(start, open).trim(),
+        body: css.slice(open + 1, i),
+      });
+      start = i + 1;
+    }
+  }
+  return out;
+}
+const declares = (r: Rule, prop: string) =>
+  new RegExp(`(?:^|;)\\s*${prop}\\s*:\\s*([^;]+)`).exec(r.body)?.[1].trim();
+const at = (rs: Rule[], sel: string) => rs.filter((r) => r.prelude === sel);
+
+function reserveLaw(sfc: string): string[] {
+  const css = (/<style scoped>([\s\S]*?)<\/style>/.exec(sfc)?.[1] ?? "").replace(
+    /\/\*[\s\S]*?\*\//g,
+    "",
+  );
+  const top = rules(css);
+  const fails: string[] = [];
+  const block = at(top, ".margin-note-block").map((r) => declares(r, "min-height"));
+  if (!block.some((v) => v && !/^0(px)?$/.test(v)))
+    fails.push("the block reserves no line (`.margin-note-block` has no min-height)");
+  if (at(top, ".margin-note").some((r) => declares(r, "min-height")))
+    fails.push("a reserve on the voice at every width grows the desk strip");
+  for (const m of top.filter((r) => r.prelude.startsWith("@media"))) {
+    const inner = at(rules(m.body), ".margin-note").map((r) =>
+      declares(r, "min-height"),
+    );
+    const narrow = m.prelude === "@media (max-width: 1023.98px)";
+    if (!narrow && inner.some(Boolean))
+      fails.push(`a reserve on the voice under \`${m.prelude}\``);
+    if (narrow && !inner.includes("inherit"))
+      fails.push(
+        "the <1024 voice does not take the block's reserve (`min-height: inherit`)",
+      );
+  }
+  if (!top.some((r) => r.prelude === "@media (max-width: 1023.98px)"))
+    fails.push("no <1024 block to seat the reserve in");
+  return fails;
+}
+
+describe("MarginNote — the empty voice keeps the block's reserve below 1024", () => {
+  it("the shipped stylesheet obeys the law", () => {
+    expect(reserveLaw(source)).toEqual([]);
+  });
+
+  it("every plant reds it: deleted, zeroed, a number, moved wide, moved to the desk", () => {
+    const seat =
+      /(@media \(max-width: 1023\.98px\) \{[\s\S]*?\.margin-note \{\s*)min-height: inherit;/;
+    expect(seat.test(source), "the plant anchors on the shipped seat").toBe(true);
+    const plants = {
+      deleted: source.replace(seat, "$1"),
+      zeroed: source.replace(seat, "$1min-height: 0;"),
+      number: source.replace(seat, "$1min-height: 1.3em;"),
+      wide: source
+        .replace(seat, "$1")
+        .replace(/\n\.margin-note \{/, "\n.margin-note {\n  min-height: inherit;"),
+      desk: source
+        .replace(seat, "$1")
+        .replace(
+          /@media \(min-width: 1024px\) \{/,
+          "@media (min-width: 1024px) {\n  .margin-note {\n    min-height: inherit;\n  }",
+        ),
+    };
+    for (const [name, sfc] of Object.entries(plants)) {
+      expect(sfc, `${name}: the plant moved the source`).not.toBe(source);
+      expect(reserveLaw(sfc).length, `${name} must red`).toBeGreaterThan(0);
+    }
+  });
+});
