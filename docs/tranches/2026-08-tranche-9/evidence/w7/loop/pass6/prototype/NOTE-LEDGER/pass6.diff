+
+/* A sentence displacing another is NOT an exit: line two catches the old text on the same
+   frame, and a rub-out here would paint it twice. Out of flow for the one frame it lingers. */
+.note-swap-leave-active {
+  position: absolute;
+  animation: none;
+}
+
+/* The enter is the WAAPI FLIP (line two) or `ink-write-in` (line one); neither wants a
+   second opinion from the transition. */
+.note-previous-enter-active,
+.note-rub-enter-active,
+.note-swap-enter-active {
+  transition: none;
+}
