+// ── G-LIVE-22 ───────────────────────────────────────────────────────────────────────────
+//
+// MA-N FROM THE DOM (MRK-ABS pass 5, G-ABS-7/8, grafted whole). At 16×16, every cell: the ring's
+// painted outer ink — each vertex of its `d` through the path's own screen CTM, plus half the
+// heaviest stroke the sheet draws — stays inside the cell's DOM box. Before the witness may speak,
+// G-ABS-8 proves the recipe below IS the product: every resident `d` equals `wobbleRect` at
+// `RING_GEOMETRY`, 256/256. Then the witness, the same wander at inset 1.00, must ENTER the
+// neighbour at stroke 10 — the row's own negative control, same run. A real `?board=` payload.
+function mintSudoku(sub: number): string {
+  const n = sub * sub;
+  let cells = "";
+  for (let r = 0; r < n; r++)
+    for (let c = 0; c < n; c++) {
+      const i = r * n + c;
+      const v = ((r * sub + Math.floor(r / sub) + c) % n) + 1;
+      const keep = i > 1 && (r * 7 + c * 3) % 5 < 2;
+      cells += (keep ? v : 0).toString(36);
+    }
+  return Buffer.from(String.fromCharCode(1) + `${sub}.${cells}`, "latin1").toString("base64url");
+}
+
+test("G-LIVE-22 · MA-N from the DOM: no ring enters its neighbour (the f = 1.00 witness enters)", async ({
+  page,
+}) => {
+  test.setTimeout(180000);
+  const payload = mintSudoku(4);
+  await page.goto(`./?size=4&board=${payload}`);
+  await expect
+    .poll(() => page.locator(".board-shell .game-cell").count(), { timeout: 120000 })
+    .toBe(256);
+  await expect
+    .poll(() => page.evaluate(() => new URLSearchParams(location.search).get("board")))
+    .toBe(payload);
+  const cells = await page.evaluate(() =>
+    [...document.querySelectorAll(".board-shell .game-cell")].map((cell) => {
+      const p = cell.querySelector(".cell-ghost-path") as SVGPathElement;
+      const m = p.getScreenCTM()!;
+      const r = cell.getBoundingClientRect();
+      return { d: p.getAttribute("d")!, m: [m.a, m.d, m.e, m.f], box: [r.x, r.y, r.width, r.height] };
+    }),
+  );
+  const N = 16;
+  const cs = 1000 / N;
+  const ring = (pos: number, inset: number) => {
+    const size = inset * cs;
+    const pad = ((1 - inset) / 2) * cs;
+    return wobbleRect((pos % N) * cs + pad, Math.floor(pos / N) * cs + pad, size, size, {
+      roughness: RING_GEOMETRY.wanderUnits / (0.015 * size),
+      segments: 4,
+      seed: 42 + 500 + pos * 7,
+      jagged: true,
+    });
+  };
+  const clearance = (d: string, m: number[], box: number[], stroke: number) => {
+    let worst = Infinity;
+    for (const g of d.matchAll(/[ML]\s*(-?[\d.eE+]+),(-?[\d.eE+]+)/g)) {
+      const x = m[2] + m[0] * +g[1];
+      const y = m[3] + m[1] * +g[2];
+      const hs = (stroke / 2) * m[0];
+      worst = Math.min(worst, x - hs - box[0], box[0] + box[2] - (x + hs), y - hs - box[1], box[1] + box[3] - (y + hs));
+    }
+    return worst;
+  };
+  const identical = cells.filter((c, pos) => c.d === ring(pos, RING_GEOMETRY.inset)).length;
+  expect(identical, "G-ABS-8: every resident `d` is the recipe at RING_GEOMETRY").toBe(N * N);
+  for (const stroke of [7, 10]) {
+    const product = Math.min(...cells.map((c) => clearance(c.d, c.m, c.box, stroke)));
+    const witness = Math.min(...cells.map((c, pos) => clearance(ring(pos, 1), c.m, c.box, stroke)));
+    const px = (x: number) => Math.round(x * 1000) / 1000;
+    console.log(
+      `[G-LIVE-22] stroke ${stroke}: product ${px(product)} px · witness f=1.00 ${px(witness)} px · identical ${identical}/${N * N} · ghost scale ${px(cells[0].m[0])} px/u · cell ${px(cells[0].box[2])} px`,
+    );
+    expect(product, `stroke ${stroke}: the ring's outer ink stays inside its own cell (px)`).toBeGreaterThanOrEqual(0);
+    if (stroke === 10)
+      expect(witness, "the witness: the same wander at inset 1.00 enters the neighbour (px)").toBeLessThan(0);
+  }
+});
