+import { describe, it, expect } from "vitest";
+import { generateCellRects, generateCellFrames } from "./gridPaths";
+
+// THE WALK EVICTS NOTHING (T9-W7 §5, G-LIVE-13).
+//
+// `useBoilCache` is ONE module-global Map with a cap of 24, and its `maxEntries` is a per-CALL
+// argument — so the smallest cap any caller passes governs the whole estate's window. Every
+// other caller keys on the BOARD (size, seed, viewBox): a handful of entries that live for the
+// session. `generateCellFrames` keys on the CELL, and the reader mints a fresh key on every
+// keystroke, so a 24-step keyboard walk inside the shared cache flushes the board's own
+// `cellRects` and the grid's frame tuples, and the next beat regenerates the whole board's
+// geometry to move one ring.
+//
+// The cure is that the living mark's poses never enter the shared cache at all: a module-local
+// two-entry window (the cell under the hand and the one it just left). The claim is referential
+// — the LRU hands back the SAME object on a hit and a fresh one on a miss — so identity is the
+// measurement, and the test reds by construction against the shared-LRU form.
+describe("gridPaths — the living mark's memo does not share the board's cache", () => {
+  it("30 cell-frame bakes later, the board's cellRects entry is still the same object", () => {
+    const board = () => generateCellRects(9, 3, 1000, 4242);
+    const first = board();
+    expect(board()).toBe(first); // the control: a hit is the same object
+
+    for (let pos = 0; pos < 30; pos++)
+      generateCellFrames(9, 3, 1000, 4242, pos, 0.3, 4);
+
+    expect(board()).toBe(first);
+  });
+
+  it("keeps a two-entry window: the cell under the hand and the one it just left", () => {
+    const at = (pos: number) => generateCellFrames(16, 4, 1000, 7, pos, 0.3, 4);
+    const a = at(0);
+    const b = at(1);
+    expect(at(1)).toBe(b); // the hand's own cell
+    expect(at(0)).toBe(a); // the cell it just left
+    at(2); // a third landing retires the oldest
+    expect(at(0)).not.toBe(a);
+  });
+
+  it("pose 0 is the resting ring byte for byte — the board cannot move when nothing is focused", () => {
+    const rects = generateCellRects(9, 3, 1000, 42);
+    expect(generateCellFrames(9, 3, 1000, 42, 40, 0.3, 4)[0]).toBe(rects[40]);
+    // …and at 16×16, where the ring recipe's pinned segments and inset are the whole difference
+    const r16 = generateCellRects(16, 4, 1000, 42);
+    expect(generateCellFrames(16, 4, 1000, 42, 0, 0.3, 4)[0]).toBe(r16[0]);
+    expect(generateCellFrames(16, 4, 1000, 42, 255, 0.3, 4)[0]).toBe(r16[255]);
+  });
+});
