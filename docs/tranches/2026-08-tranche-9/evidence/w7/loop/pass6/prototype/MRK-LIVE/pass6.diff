+// ── G-LIVE-19 ───────────────────────────────────────────────────────────────────────────
+//
+// The seams the ring reads from its host are REGISTERED, once each, with no `var(…, fallback)`
+// behind any of them anywhere, and each registration's value is the one that paints:
+//   · ONE HOME is counted in SOURCE, not assumed: every `@property` under `src/`, comments
+//     stripped, tallied per name, and its brace depth read — a second registration of any name is
+//     RED, and so is one nested inside a rule (the bundler hoists it silently). The CSSOM cannot
+//     make this count: the compiler dedupes `@property`, so a duplicate in source reaches the page
+//     as one rule (measured: a second `--motion-note` block greened the CSSOM tally). The CSSOM
+//     walk (recursive; a style rule read BEFORE its nested rules) still proves each one SHIPPED.
+//   · NO MASKED DEFAULT is scanned for — every style rule's text, for `var(--registered, `.
+//   · `--toggle-bleed`'s initial is a SENTINEL (9999px) no rung ever publishes, so the host
+//     must read its publisher's value (< 0); an absent publisher reds here, not silently.
+//   · `--motion-note`'s 250ms is read where it PAINTS: the marks' own scoped rule, on a probe
+//     that carries that rule's scope hash, computes `animation-duration: 0.25s`.
+// Nothing is wrapped in an `if`: a surface this route should carry and does not is a RED.
+/** Every `.css` file and every `.vue` `<style>` under `src/`, comments stripped — the SOURCE, so a
+ *  lazily loaded SFC (the laminate, the five posters) is read as surely as the entry sheet. */
+function sourceStyles() {
+  // ESM spec: no `__dirname` — the estate's idiom (filter-census.spec.ts G3.2).
+  const src = join(fileURLToPath(new URL(".", import.meta.url)), "..", "src");
+  const out: { file: string; text: string }[] = [];
+  const walk = (d: string) => {
+    for (const f of readdirSync(d)) {
+      const p = join(d, f);
+      if (statSync(p).isDirectory()) walk(p);
+      else if (/\.(css|vue)$/.test(f)) out.push({ file: p.slice(src.length + 1), text: styleText(readFileSync(p, "utf8"), f) });
+    }
+  };
+  walk(src);
+  return out;
+}
+
+/** One file's style text: a `.vue`'s `<style>` blocks only, comments stripped. */
+function styleText(text: string, file: string) {
+  if (file.endsWith(".vue"))
+    text = [...text.matchAll(/<style[^>]*>([\s\S]*?)<\/style>/g)].map((m) => m[1]).join("\n");
+  return text.replace(/\/\*[\s\S]*?\*\//g, "");
+}
+
+/** Every `@property` in one style text, with its brace depth. */
+function registrationsIn(file: string, text: string) {
+  const out: { name: string; file: string; depth: number }[] = [];
+  let depth = 0;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (c === "{") depth++;
+    else if (c === "}") depth--;
+    else if (c === "@" && text.startsWith("@property", i)) {
+      const m = /^@property\s+(--[\w-]+)/.exec(text.slice(i));
+      if (m) out.push({ name: m[1], file, depth });
+    }
+  }
+  return out;
+}
+
+/** Every `var(--registered, …)` in one style text: a second argument behind a registered name. */
+const maskedIn = (file: string, text: string, registered: Set<string>) =>
+  [...text.matchAll(/var\(\s*(--[\w-]+)\s*,/g)].filter((m) => registered.has(m[1])).map((m) => `${m[1]} in ${file}`);
+
+function sourceRegistrations() {
+  return sourceStyles().flatMap(({ file, text }) => registrationsIn(file, text));
+}
+
+test("G-LIVE-19 · the ring's seams have one home and no masked default", async ({ page }) => {
+  const source = sourceRegistrations();
+  const per = new Map<string, string[]>();
+  for (const r of source) per.set(r.name, [...(per.get(r.name) ?? []), r.file]);
+  expect(
+    [...per].filter(([, v]) => v.length > 1).map(([k, v]) => `${k}: ${v.join(", ")}`),
+    "no custom property is registered twice in source",
+  ).toEqual([]);
+  expect(
+    source.filter((r) => r.depth !== 0).map((r) => `${r.name} in ${r.file} at depth ${r.depth}`),
+    "no @property is nested inside a rule",
+  ).toEqual([]);
+  for (const n of ["--focus-ring-outset", "--toggle-bleed", "--motion-note"])
+    expect(per.get(n), `${n} has one home in source`).toEqual(["assets/index.css"]);
+
