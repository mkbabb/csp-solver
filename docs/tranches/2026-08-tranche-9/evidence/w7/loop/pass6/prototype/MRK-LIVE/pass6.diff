+/** A SETTLED POSE, polled: nothing finite running anywhere in the document and the subject's box
+ *  unmoved across three frames. The dock sheet and the tape both travel; this is how a row waits
+ *  for either without guessing a duration. */
+const poseSettled = (p: Page, sel: string) =>
+  p.waitForFunction(
+    (sel) =>
+      new Promise<boolean>((done) => {
+        const t = document.querySelector(sel);
+        if (!t) return done(false);
+        const running = document
+          .getAnimations()
+          .filter(
+            (a) =>
+              a.playState === "running" &&
+              Number.isFinite(a.effect?.getComputedTiming().endTime ?? Infinity),
+          );
+        if (running.length) return done(false);
+        const at = () => {
+          const r = t.getBoundingClientRect();
+          return r.top + r.left * 1e-3;
+        };
+        const y0 = at();
+        requestAnimationFrame(() =>
+          requestAnimationFrame(() => requestAnimationFrame(() => done(Math.abs(at() - y0) < 0.01))),
+        );
+      }),
+    sel,
+    { timeout: 10000 },
+  );
