+// ── G-LIVE-20 ───────────────────────────────────────────────────────────────────────────
+//
+// THE DEPARTURE, ON A PHONE (the 9-line check in `FocusRing.vue`'s `measure()`). At 393×699 in a
+// WITNESSED coarse regime an activation of the dock's tab opens the sheet over it, and WebKit
+// drops focus to `document.body` with no `focusout` on the ring's path; without the check a ring
+// stays drawn round the tab at every instant through settle. The invariant, at every framed
+// instant: focus on `body` means NO ring; focus anywhere else means at most one ring, framing the
+// element it CLAIMS (`aria-activedescendant` first) within half a pixel.
+//
+// Its bound, stated: the check runs only when something calls `measure()` — an event, the
+// ResizeObserver, or a settle frame. A departure with no animation on the target's path and no
+// event at all is still unread.
+test.describe("G-LIVE-20 · coarse", () => {
+  test.use({ viewport: { width: 393, height: 699 }, hasTouch: true, deviceScaleFactor: 2 });
+
+  test("G-LIVE-20 · the ring leaves with what it rang (393×699, coarse)", async ({ page }) => {
+    await boardReady(page);
+    const regime = await page.evaluate(() => ({
+      coarse: matchMedia("(pointer: coarse)").matches,
+      noHover: matchMedia("(hover: none)").matches,
+    }));
+    expect(regime, "the regime is witnessed coarse, not assumed").toEqual({
+      coarse: true,
+      noHover: true,
+    });
+    if (!(await page.locator(".drawer-tab").count()))
+      test.skip(true, "no .drawer-tab at this viewport");
+
+    // Each read waits ONE frame first: the settle loop runs `measure()` in a rAF callback, before
+    // that frame paints. A DOM read taken between a click and the next frame is a state no frame
+    // ever showed (measured: chromium read 1 ring on `body` there, and 0 one frame later).
+    const snap = () =>
