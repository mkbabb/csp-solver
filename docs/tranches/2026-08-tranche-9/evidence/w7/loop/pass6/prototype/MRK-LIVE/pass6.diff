+    x: (pos % boardSize) * cellSize + pad,
+    y: Math.floor(pos / boardSize) * cellSize + pad,
+    size,
+    opts: {
+      roughness: wanderUnits / (0.015 * size),
+      segments: 4,
+      seed: seed + 500 + pos * 7,
+      jagged: true,
+    },
+  };
