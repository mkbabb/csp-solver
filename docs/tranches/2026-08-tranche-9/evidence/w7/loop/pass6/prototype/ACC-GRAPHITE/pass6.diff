+function poseGeometry(frames: string[]): PoseGeometry[] {
+  const hit = poseGeometryCache.get(frames);
+  if (hit) return hit;
+  const built = frames.map((d) => {
+    const single = poseIsLinearSinglePath(d);
+    const pts = single ? posePoints(d) : [];
+    const cum: number[] = pts.length ? [0] : [];
+    for (let i = 1; i < pts.length; i++)
+      cum.push(
+        cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]),
+      );
+    return { pts, cum, single };
+  });
+  if (import.meta.env.DEV && built.some((g) => !g.single))
+    console.warn(
+      "[gridPaths] poseFronts: a pose is not a single linear polyline and was handed back uncut " +
+        "(gridPaths §poseIsLinearSinglePath).",
+    );
+  poseGeometryCache.set(frames, built);
+  return built;
+}
