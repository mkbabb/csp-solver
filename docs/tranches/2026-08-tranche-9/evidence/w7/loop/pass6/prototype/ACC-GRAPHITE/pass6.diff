+/** A closed linear pose (`pointsToLinear` + ` Z`) back to its points, the close made explicit. */
+function posePoints(d: string): [number, number][] {
+  const nums = d.match(/-?\d*\.?\d+(?:e[-+]?\d+)?/gi);
+  if (!nums || nums.length < 4) return [];
+  const pts: [number, number][] = [];
+  for (let i = 0; i + 1 < nums.length; i += 2)
+    pts.push([Number(nums[i]), Number(nums[i + 1])]);
+  if (/z\s*$/i.test(d) && pts.length) pts.push(pts[0]);
+  return pts;
+}
+
+/** One pose, parsed once: its points, the arc length at each point, and whether it may be cut. */
+type PoseGeometry = {
+  pts: [number, number][];
+  /** cum[k] = arc length from pts[0] to pts[k]; cum[last] is the pose's own length. */
+  cum: number[];
+  /** ONE subpath — the precondition below. False poses are handed back uncut. */
+  single: boolean;
+};
+
+/**
+ * `poseFronts`' PRECONDITION, enforced rather than assumed (T9-W7 §1, the cross-family hand-off).
+ *
+ * This file parses a pose by pulling every number pair out of the `d` and treating them as ONE
+ * polyline. That is exactly true of `pointsToLinear`'s output — `M x,y L x,y … Z` — which is
+ * what every caller passes today. It is false of two other shapes this estate can emit, and in
+ * both the cut would come back as a wrong path that looks plausible:
+ *
+ *   - MORE THAN ONE SUBPATH. The jumps between subpaths would be counted as drawn length and
+ *     the cut would return one connected path crossing the gap.
+ *   - A CURVE. `wobbleLine`'s non-jagged branch serialises through `catmullRomToBezier`, and
+ *     `C`'s control points are not vertices: they would be counted as points on the line, so
+ *     both the length and the cut would be wrong. Every caller passes `jagged: true` today —
+ *     the ring's generator hardcodes it — which is precisely the kind of fact that stops being
+ *     true without anyone noticing.
+ *
+ * So a pose that is not a single linear polyline is handed back UNCUT: the function declines to
+ * cut geometry it cannot measure, rather than guessing. `poseFronts` is §1's hand-off to
+ * ACC-SIX, the §10 tally and PLR-COUNT, and this is the sentence that travels with it.
+ */
+function poseIsLinearSinglePath(d: string): boolean {
+  const cmds = d.match(/[A-DF-Za-df-z]/g) ?? [];
+  if (cmds.filter((c) => c === "M" || c === "m").length > 1) return false;
+  return cmds.every(
+    (c) => c === "M" || c === "m" || c === "L" || c === "l" || /^[Zz]$/.test(c),
+  );
+}
