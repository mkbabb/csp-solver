+        for (let c = 0; c < boardSize; c++) {
+          const pos = r * boardSize + c;
+          rects[pos] = reverseLinearPath(
+            wobbleRect(
+              c * cellSize + inset,
+              r * cellSize + inset,
+              cellSize - inset * 2,
+              cellSize - inset * 2,
+              {
+                roughness: 0.4,
+                segments: cellSegments,
+                seed: seed + 500 + pos * 7 + 3,
+                jagged: true,
+              },
+            ),
+          );
+        }
+      }
+      return rects;
+    },
+  );
