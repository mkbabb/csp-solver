+    // long and pointing INTO the board from the pose (the ring's centroid decides which side).
+    // A mark laid ALONG a rule at a regular pitch is a dashed rule whatever its duty; a mark
+    // laid across it is a tally.
+    const cx = pts.reduce((a, p) => a + p[0], 0) / pts.length;
