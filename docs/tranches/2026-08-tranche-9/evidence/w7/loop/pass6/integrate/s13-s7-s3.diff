+    expect(STYLE.match(/var\(--motion-[a-z]+\s*,/g) ?? []).toEqual([]);
+    const bare = [...STYLE.matchAll(/var\(--motion-([a-z]+)\)/g)].map((m) => m[1]);
+    for (const rung of ["note", "whisper", "dusk"]) {
+      expect(bare).toContain(rung);
+      expect(MOTION.rungs[rung as keyof typeof MOTION.rungs]).toBeGreaterThan(0);
+    }
