new file mode 100644
index 0000000..b0cc1fe
--- /dev/null
+++ b/web/frontend/scripts/publish-verbs.mjs
@@ -0,0 +1,212 @@
+#!/usr/bin/env node
+/**
+ * PUBLISH THE PENCIL VERBS (T9-W7 §13).
+ *
+ * `MOTION.verbs` in `src/pencil/config/pencilConfig.ts` is the ONE source of the CURVES.
+ * This writes their CSS half into `src/assets/index.css` — the verb curves and nothing else —
+ * and `--check` diffs what is there against what it would write, BYTE FOR BYTE.
+ *
+ * CURVES ONLY (T9-W7 pass 3). The rung half of this publisher DIED: rungs and their
+ * reduced-motion arm are the LADDER's node (`publishMotionRungs`, pencilConfig.ts), one home,
+ * and no verb owns a number any more. What is left here is R6 law 3's two-layer partition,
+ * held by a gate instead of by a docstring: TS `MOTION.verbs` for `spend()`, CSS
+ * `--verb-*-ease` for `<style>` consumers, byte-identical by construction.
+ *
+ *   node scripts/publish-verbs.mjs --write    rewrite the block from the TS source
+ *   node scripts/publish-verbs.mjs --check    compare, name the divergent rows, exit 1
+ *
+ * THE PARSE READS A MARKER PAIR, NOT INDENTATION (T9-W7 pass 2). Pass 1 bounded the verbs
+ * by `^ {2}verbs: \{$` and ended them at the next unrelated construct ("House easing"), so a
+ * prettier reflow or a re-worded comment redded the gate for a reason nobody did. The source
+ * region is now `/* @verbs-begin *\/ … /* @verbs-end *\/`, comments are blanked before
+ * anything is matched, and every object is found by brace matching — a comment inserted
+ * inside RUNGS or inside a verb still publishes.
+ */
+import { readFileSync, writeFileSync } from "node:fs";
+import { dirname, resolve, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import process from "node:process";
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const ROOT = resolve(HERE, "..");
+const CONFIG = join(ROOT, "src/pencil/config/pencilConfig.ts");
+const CSS = join(ROOT, "src/assets/index.css");
+
+const TS_BEGIN = "/* @verbs-begin */";
+const TS_END = "/* @verbs-end */";
+const BEGIN =
+  "  /* ── THE PENCIL VERBS, PUBLISHED (T9-W7 §13) ── generated, do not hand-edit ──";
+const END = "/* ── end of the published verbs ── */";
+
+/** Blank comments in place so line count survives and prose is never a tuple. */
+export function strip(text) {
+  let out = "";
+  for (let i = 0, n = text.length; i < n;) {
+    if (text[i] === "/" && text[i + 1] === "*") {
+      const e = text.indexOf("*/", i + 2);
+      const end = e < 0 ? n : e + 2;
+      for (let k = i; k < end; k++) out += text[k] === "\n" ? "\n" : " ";
+      i = end;
+    } else if (text[i] === "/" && text[i + 1] === "/") {
+      while (i < n && text[i] !== "\n") {
+        out += " ";
+        i++;
+      }
+    } else out += text[i++];
+  }
+  return out;
+}
+
+/** The `{ … }` that starts at `open`, matched, not guessed. */
+function braces(text, open) {
+  let depth = 0;
+  for (let i = open; i < text.length; i++) {
+    if (text[i] === "{") depth++;
+    else if (text[i] === "}" && --depth === 0) return text.slice(open + 1, i);
+  }
+  throw new Error("publish-verbs: an object in pencilConfig.ts never closes");
+}
+
+/** Read the tuples out of the TS source. One shallow parse, no bundler. */
+export function readSource(raw = readFileSync(CONFIG, "utf8")) {
+  const markers = raw.includes(TS_BEGIN) && raw.includes(TS_END);
+  const text = strip(raw);
+  const region = markers
+    ? text.slice(
+        raw.indexOf(TS_BEGIN) + TS_BEGIN.length,
+        raw.indexOf(TS_END, raw.indexOf(TS_BEGIN)),
+      )
+    : text;
+
+  // THE LADDER IS READ, NEVER PUBLISHED HERE (pass 3). Its object is the leader's node and
+  // lives OUTSIDE the marker pair, so it is found in the whole source: `rungs: {` with a
+  // brace, which a verb's `rungs: [` array cannot be mistaken for. The gate needs the values
+  // to read the toggle's beat table back; this file never writes one of them into CSS.
+  // A tree that still spells the ladder `const RUNGS = {` (before the leader's node lands) is
+  // READ, not thrown at: a born-RED has to be a red, never a crash.
+  const rungsAt = (() => {
+    const a = text.search(/\brungs\s*:\s*\{/);
+    return a >= 0 ? a : text.search(/const RUNGS\s*=\s*\{/);
+  })();
+  if (rungsAt < 0)
+    throw new Error("publish-verbs: MOTION.rungs is not in pencilConfig.ts");
+  const rungsBody = braces(text, text.indexOf("{", rungsAt));
+  const rungs = [...rungsBody.matchAll(/([a-z]+)\s*:\s*(\d+)\s*,/g)].map((m) => [
+    m[1],
+    Number(m[2]),
+  ]);
+
+  const verbsAt = region.search(/\bverbs\s*:\s*\{/);
+  if (verbsAt < 0) throw new Error("publish-verbs: verbs is not in the marked region");
+  const verbsBody = braces(region, region.indexOf("{", verbsAt));
+  const verbs = [];
+  for (let i = 0; i < verbsBody.length;) {
+    // Each direct child of `verbs` is `name: { … }`; jumping past a matched body is what
+    // keeps the walk at depth 0 without counting braces a second time.
+    const m = /([A-Za-z]+)\s*:\s*\{/.exec(verbsBody.slice(i));
+    if (!m) break;
+    const open = verbsBody.indexOf("{", i + m.index);
+    const body = braces(verbsBody, open);
+    const list = (re) =>
+      [...(re.exec(body)?.[1] ?? "").matchAll(/"([a-zA-Z]+)"/g)].map((r) => r[1]);
+    verbs.push({
+      name: m[1],
+      ease: /ease:\s*"([^"]+)"/.exec(body)?.[1],
+      props: /props:\s*"([^"]+)"/.exec(body)?.[1],
+      fill: /fill:\s*"([^"]+)"/.exec(body)?.[1],
+      mechanism: list(/mechanism:\s*\[([^\]]*)\]/),
+      ms: /ms:\s*(\d+)/.test(body) ? Number(/ms:\s*(\d+)/.exec(body)[1]) : null,
+      rungs: list(/rungs:\s*\[([^\]]*)\]/),
+      // A verb no stylesheet spends says so, and no token is minted for it.
+      published: !/published:\s*false/.test(body),
+    });
+    i = open + body.length + 2;
+  }
+  return { rungs, verbs, markers };
+}
+
+/** The custom-property rows the CSS layer must carry, in source order. */
+function rows(src = readSource()) {
+  return src.verbs
+    .filter((v) => v.published)
+    .map((v) => `  --verb-${v.name}-ease: ${v.ease};`);
+}
+
+/** The whole published region: the verb curves, and nothing that carries a number. */
+function block(src = readSource()) {
+  return [
+    BEGIN,
+    "     Written by scripts/publish-verbs.mjs from the marker pair in pencilConfig.ts;",
+    "     lint:verbs diffs the two layers byte for byte. CURVES ONLY: no verb owns a number,",
+    "     every length is a rung, and the ladder publishes its own values and its own reduce",
+    "     arm from one node. A verb is what a hand does; a rung is how far. */",
+    ...rows(src),
+    "}",
+    END,
+  ].join("\n");
+}
+
+/** The CLI half. Importing this file for `rows`/`readSource` runs none of it. */
+if (
+  process.argv[1] &&
+  resolve(process.argv[1]) === resolve(fileURLToPath(import.meta.url))
+) {
+  const css = readFileSync(CSS, "utf8");
+  const b = css.indexOf(BEGIN);
+  const e = css.indexOf(END);
+  const src = readSource();
+  const wanted = block(src);
+
+  if (process.argv.includes("--write")) {
+    if (b < 0 || e < 0) {
+      console.error(
+        "publish-verbs: the markers are not in index.css. Add them once by hand.",
+      );
+      process.exit(1);
+    }
+    writeFileSync(CSS, css.slice(0, b) + wanted + css.slice(e + END.length));
+    console.log(`published ${rows(src).length} rows into src/assets/index.css`);
+    process.exit(0);
+  }
+
+  const have = b < 0 || e < 0 ? "" : css.slice(b, e + END.length);
+  const want = rows(src);
+  const got = have.split("\n").filter((l) => /^ {2}--/.test(l));
+  const divergent = [
+    ...want
+      .filter((l) => !got.includes(l))
+      .map((l) => `the stylesheet is missing ${l.trim()}`),
+    ...got
+      .filter((l) => !want.includes(l))
+      .map((l) => `the stylesheet carries a row the config does not: ${l.trim()}`),
+  ];
+  const ownMs = src.verbs.filter((v) => v.ms !== null);
+  const bytes = have === wanted;
+
+  console.log(
+    `published rows: ${got.length} of ${want.length} wanted, divergent ${divergent.length}`,
+  );
+  console.log(
+    `verbs with a number of their own: ${ownMs.length} (${ownMs.map((v) => v.name).join(", ") || "none"}); none is lawful`,
+  );
+  console.log(`the block matches the config byte for byte: ${bytes ? "yes" : "no"}`);
+  console.log(
+    `the source marker pair is in pencilConfig.ts: ${src.markers ? "yes" : "no"}`,
+  );
+  for (const d of divergent) console.log(`  · ${d}`);
+  for (const v of ownMs)
+    console.log(
+      `  · ${v.name} owns a number of its own (${v.ms}ms). No verb owns a number; every length is a rung. Delete the ms key and spend a rung.`,
+    );
+  if (!bytes)
+    console.log(
+      "  · the published block is not what the config says. Run publish-verbs.mjs --write.",
+    );
+  if (!src.markers)
+    console.log(
+      "  · pencilConfig.ts has no /* @verbs-begin */ … /* @verbs-end */ pair. Add it once by hand.",
+    );
+  const bad = divergent.length > 0 || ownMs.length > 0 || !bytes || !src.markers;
+  console.log(bad ? "RED" : "GREEN");
+  process.exit(bad ? 1 : 0);
+}
