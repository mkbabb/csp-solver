+    vi.advanceTimersByTime(REST_MS);
+    await nextTick();
+    expect(line(w)).toBe(null);
+    w.unmount();
+  });
+
+  it("an undo back to empty does NOT consume the lesson — the same lesson resumes and still lifts", async () => {
+    // Pass 4, the critique's §2.4: the behaviour is decided here and the name says what the
+    // row asserts. The count follows the board, so an undo to empty takes the line away and
+    // the next write lays the SAME lesson down again; `taught` is set at the lift, so the
+    // deal's own third write still ends it. Only a new deal un-teaches (the row below).
+    const w = mountBoard();
+    await write(w, 1);
+    expect(line(w)).toBe("1 of 16 on the board");
+    await write(w, 0);
+    expect(line(w)).toBe(null);
+    await write(w, 1);
+    expect(line(w)).toBe("1 of 16 on the board");
+    // …and it still lifts on this deal's OWN third write, rather than stalling forever.
+    await write(w, 3);
+    vi.advanceTimersByTime(REST_MS);
+    await nextTick();
+    expect(line(w)).toBe(null);
+    w.unmount();
+  });
+
+  it("a session restored at two fills opens with no line", async () => {
+    const values = emptyValues();
+    values["0"] = 1;
+    values["1"] = 1;
+    const w = mountBoard({ values });
+    await nextTick();
+    expect(line(w)).toBe(null);
+    await write(w, 3);
+    expect(line(w)).toBe(null);
+    w.unmount();
+  });
