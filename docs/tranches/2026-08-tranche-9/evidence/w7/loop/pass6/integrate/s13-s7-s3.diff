+    const w = mountBoard();
+    await write(w, 3);
+    vi.advanceTimersByTime(REST_MS);
+    await nextTick();
+    expect(line(w)).toBe(null);
+    // Same size, different givens: the board key moves, so the deal is new.
+    await w.setProps({ givenCells: new Set(["15"]), values: emptyValues() });
+    await nextTick();
+    await write(w, 1);
+    expect(line(w)).toBe("1 of 15 on the board");
+    w.unmount();
+  });
+
+  it("the debug tally outranks the count when both exist", async () => {
+    // `:meta="… tally || countLine"` — the tally is DEBUG ink and wins the one line.
+    const w = mountBoard();
+    await write(w, 1);
+    expect(line(w)).toBe("1 of 16 on the board");
+    w.unmount();
+  });
+});
