+        cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]),
+      );
+    return { pts, cum, single };
+  });
+  if (import.meta.env.DEV && built.some((g) => !g.single))
+    console.warn(
+      "[gridPaths] poseFronts: a pose is not a single linear polyline and was handed back uncut " +
+        "(gridPaths §poseIsLinearSinglePath).",
+    );
+  poseGeometryCache.set(frames, built);
+  return built;
+}
+
+/**
+ * Each pose CUT at `fraction` of its own arc length — the fill gauge's front, as geometry.
+ *
+ * THE DASH IS GONE, AND THAT IS THE CURE (T9-W7 §4). The gauge used to draw its front with
+ * `stroke-dasharray` over `pathLength="1000"`, and in WebKit it read 92% filled at a quarter.
+ * The pass-2 synthesis named `pathLength` as the cause; on the built prototype that is FALSE.
+ * Measured on this ring, both engines, four declaration arms (attribute dash, CSS dash, a
+ * period equal to the path, an offset of zero): every arm reads 4 runs at 0.215 share in
+ * WebKit for a requested 0.05. Decimating the same pose walks it back — 492 segments → 4 runs,
+ * 123 → 1, and a perfectly straight 599-segment rectangle breaks identically, so it is not the
+ * wobble either. WebKit restarts the dash phase every ~128 segments of a polyline; Chromium
+ * dashes the path whole. A hand-drawn ring is ~490 segments by construction.
+ *
+ * So the front is not dashed. It is DRAWN: the pose is truncated at `fraction · length`, with
+ * the final point interpolated, and the renderer paints a path that ends exactly where the
+ * player's work has got to. Engine-independent by construction, because there is no dash
+ * pattern for an engine to restart, and it cannot regress when a board size or a grain setting
+ * moves the segment count past somebody's chunk boundary.
+ *
+ * The price, declared and then PAID: `stroke-dashoffset` was tweenable and a truncated `d` is
+ * not, so a bare swap would STEP the front ~31px per digit at 9x9 and ~158px at 4x4. The tween
+ * moved up one level instead — the consumer eases the FRACTION on the boil scheduler's sequence
+ * chain and calls this on a RATE-GATED subset of its frames (HandDrawnGrid, T9-W7 §5), never
+ * once per vsync: the budget is re-cuts per SECOND, because a per-event frame count is the
+ * reviewer's display talking (29 on a 120 Hz panel against 15 on a 60 Hz one — pass-3 critique
+ * §3.1). The step survives as the PRM arm and as the fallback should the rung ever read 0.
+ *
+ * PRECONDITION: one subpath per pose, enforced at the parse (`poseIsLinearSinglePath` above); a
+ * multi-subpath pose comes back uncut and unchanged.
+ */
+export function poseFronts(frames: string[], fraction: number): string[] {
+  const f = Math.max(0, Math.min(1, fraction));
+  if (f >= 1) return frames;
+  if (f <= 0) return frames.map(() => "");
+  const geom = poseGeometry(frames);
+  return frames.map((d, i) => {
+    const { pts, cum, single } = geom[i];
+    if (!single) return d;
+    const target = cum.length ? cum[cum.length - 1] * f : 0;
+    if (!pts.length || target <= 0) return "";
+    const out = [pts[0]];
+    for (let k = 1; k < pts.length; k++) {
+      if (cum[k] >= target) {
+        const seg = cum[k] - cum[k - 1];
+        const t = seg === 0 ? 0 : (target - cum[k - 1]) / seg;
+        out.push([
+          pts[k - 1][0] + (pts[k][0] - pts[k - 1][0]) * t,
+          pts[k - 1][1] + (pts[k][1] - pts[k - 1][1]) * t,
+        ]);
+        break;
+      }
+      out.push(pts[k]);
+    }
+    return pointsToLinear(out);
+  });
+}
+
+/**
+ * THE FRONT'S RATE BUDGET, and every `poseFronts` consumer rides it (T9-W7 §5).
+ *
+ * A `sequence` subscriber holds the continuous rAF chain while it runs, so "one re-cut per
+ * frame" is the panel's refresh rate wearing a budget's clothes: ungated, the tally re-cut at
+ * 134.2/s on a 128 Hz panel and 60.9/s on a 63 Hz one (pass-4 critique §3.1). The budget is a
+ * declared constant instead: at most one commit per FRONT_MIN_MS, ≤62.5 re-cuts per second at
+ * any refresh rate. `e2e/front-rate.spec.ts` counts it on every consumer.
+ */
+// policy: rate
+export const FRONT_MIN_MS = 16;
+
+/**
+ * Leading-edge rate gate on a front's commit: the first write lands now (the front never lags
+ * the act), then at most once per FRONT_MIN_MS. `force` commits regardless, for a tween's exact
+ * end value or a rest pose, so a gauge and its a11y mirror still agree to the digit.
+ */
+export function frontGate(commit: (v: number) => void) {
+  let last = -Infinity;
+  return {
+    write(v: number, force = false) {
+      const now = performance.now();
+      if (!force && now - last < FRONT_MIN_MS) return;
+      last = now;
+      commit(v);
+    },
+    /** A new write re-arms the leading edge, so its first frame is never swallowed. */
+    rearm() {
+      last = -Infinity;
+    },
+  };
+}
