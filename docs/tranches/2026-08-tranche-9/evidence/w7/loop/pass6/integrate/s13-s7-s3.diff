+      values[pos] = v;
+      at++;
+    }
+  while (at !== n) {
+    if (at < n) {
+      values[String(at)] = 1;
+      at++;
+    } else {
+      at--;
+      values[String(at)] = 0;
+    }
+    await w.setProps({ values: { ...values } });
+    await nextTick();
+  }
