+  beforeEach(() => vi.useFakeTimers());
+  afterEach(() => vi.useRealTimers());
+
+  it("lifts one write-in band after the third write, and stays gone", async () => {
+    const w = mountBoard();
+    await write(w, 3);
+    expect(line(w)).toBe("3 of 16 on the board");
+    vi.advanceTimersByTime(REST_MS - 1);
+    await nextTick();
+    expect(line(w)).toBe("3 of 16 on the board");
+    vi.advanceTimersByTime(1);
+    await nextTick();
