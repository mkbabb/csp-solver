+}
+
+/* RUB OUT (T9-W7 §13) -- the note's missing exit, the write-in run backwards under an
+   accelerating hand. The clip retreats the way it arrived and the ink goes with it, so
+   the glyphs never re-lay out and the text never boils: one clip-path + one opacity on
+   an inline-block that is already its own paint. The verb is defined here; WHICH acts
+   erase a note is not this family's to design. */
+.margin-note-ink.is-rubbing-out {
+  animation: ink-rub-out var(--rung-breath) var(--verb-rubOut-ease) forwards;
+}
+
+@keyframes ink-rub-out {
+  from {
+    clip-path: inset(0 0 0 0);
+    opacity: 1;
+  }
+  to {
+    clip-path: inset(0 0 0 100%);
+    opacity: 0;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .margin-note-ink.is-rubbing-out {
+    animation: none;
+    opacity: 0;
+  }
 }
 
