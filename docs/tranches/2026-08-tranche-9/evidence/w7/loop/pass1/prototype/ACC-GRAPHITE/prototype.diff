+/** Inset of the retrace rect from the cell rect, in board-viewBox units — one focus stroke
+ *  width (12) less the half-widths that already overlap. Two 12-unit passes 10 apart fuse
+ *  into a 22-unit band; see gameCell.css's `.cell-ghost-retrace`. */
+const RETRACE_INSET = 10;
+
+/**
+ * THE SECOND PASS (T9-W7 ACC-GRAPHITE) — the same rect, one stroke width in, on its own seed.
+ *
+ * A pencil makes a heavy line by going round twice. This emits the inner pass of the focus
+ * ring: `generateCellRects`' geometry inset by `RETRACE_INSET`, seeded `+3` off the same
+ * lattice so the two passes wander independently (the `scribbleUnderline` / `.join-pose`
+ * retrace idiom, in the cell's own viewBox), and REVERSED so the draw-on runs the other way
+ * round — no second keyframe, no second timing constant.
+ *
+ * Subgrid-independent like its sibling and memoized through the same LRU under its own key.
+ */
+export function generateCellRetraceRects(
+  boardSize: number,
+  viewBoxSize: number,
+  seed: number = 42,
+): Record<number, string> {
+  return useBoilCache<Record<number, string>>(
+    ["cellRetraceRects", boardSize, viewBoxSize, seed],
+    () => {
+      const cellSize = viewBoxSize / boardSize;
+      const cellSegments = boardSize >= 16 ? 2 : 4;
+      const inset = Math.min(RETRACE_INSET, cellSize / 4);
+      const rects: Record<number, string> = {};
+      for (let r = 0; r < boardSize; r++) {
+        for (let c = 0; c < boardSize; c++) {
+          const pos = r * boardSize + c;
+          rects[pos] = reverseLinearPath(
+            wobbleRect(
+              c * cellSize + inset,
+              r * cellSize + inset,
+              cellSize - inset * 2,
+              cellSize - inset * 2,
+              {
+                roughness: 0.4,
+                segments: cellSegments,
+                seed: seed + 500 + pos * 7 + 3,
+                jagged: true,
+              },
+            ),
+          );
+        }
+      }
+      return rects;
+    },
+  );
+}
+
+/** Reverse a jagged (`M x,y L x,y … Z`) closed path so the pencil's second pass travels the
+ *  other way round. `wobbleRect({ jagged: true })` serializes through `pointsToLinear`, so the
+ *  path is exactly a move plus lines and the point list is the whole of it. */
+function reverseLinearPath(d: string): string {
+  const points = d.match(/-?\d[\d.e+-]*,-?\d[\d.e+-]*/g);
+  if (!points || points.length < 2) return d;
+  return `M${points.reverse().join(" L")} Z`;
+}
+
+/** The points of a jagged path, in order. */
+function linearPoints(d: string): [number, number][] {
+  const raw = d.match(/-?\d[\d.e+-]*,-?\d[\d.e+-]*/g) ?? [];
+  return raw.map((p) => {
+    const [x, y] = p.split(",");
+    return [Number(x), Number(y)] as [number, number];
+  });
+}
+
+/**
+ * THE TALLY'S TICKS, AS GEOMETRY (T9-W7 ACC-GRAPHITE).
+ *
+ * `k` marks laid along a baked polyline: the ring is divided into `slots` equal pitches and
+ * each of the first `k` carries an ink mark `duty` of the pitch long. The marks are cut out of
+ * the ring's own points, so every tick wanders exactly as the frame it sits inside does.
+ *
+ * IT IS GEOMETRY AND NOT A DASH, and that is measured rather than preferred: a
+ * `stroke-dasharray` whose pattern is longer than the path renders ONCE in Chromium and FOUR
+ * TIMES in WebKit — one repeat per side of the frame ring — so a 3-tick list painted 12 ticks
+ * there. The sweep is banked (`dash-diag`, both engines, same path: `100 4000` -> 1 run
+ * chromium / 4 webkit; `50 100` -> 27 in both). A gauge that reads four times the truth on one
+ * engine is not a gauge, and no dash list can be made portable across that. Cut the marks and
+ * both engines paint the same k.
+ *
+ * Pure of its arguments and cheap (one pass over ~350 points per pose, on a FILL event only).
+ */
+export function tickMarksAlong(
+  d: string,
+  k: number,
+  slots: number,
+  duty: number = 0.57,
+): string {
+  const pts = linearPoints(d);
+  if (k <= 0 || slots <= 0 || pts.length < 2) return "";
+  const cum: number[] = [0];
+  for (let i = 1; i < pts.length; i++) {
+    cum.push(cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
+  }
+  const total = cum[cum.length - 1];
+  if (total <= 0) return "";
+  const pitch = total / slots;
+  const ink = pitch * duty;
+  /** The point at arc length `s`, and the index of the vertex after it. */
+  const at = (s: number): { p: [number, number]; next: number } => {
+    let lo = 0;
+    let hi = cum.length - 1;
+    while (lo < hi) {
+      const mid = (lo + hi) >> 1;
+      if (cum[mid] < s) lo = mid + 1;
+      else hi = mid;
+    }
+    const i = Math.max(1, lo);
+    const seg = cum[i] - cum[i - 1] || 1;
+    const t = Math.min(1, Math.max(0, (s - cum[i - 1]) / seg));
+    return {
+      p: [
+        pts[i - 1][0] + (pts[i][0] - pts[i - 1][0]) * t,
+        pts[i - 1][1] + (pts[i][1] - pts[i - 1][1]) * t,
+      ],
+      next: i,
+    };
+  };
+  const out: string[] = [];
+  for (let m = 0; m < Math.min(k, slots); m++) {
+    const a = m * pitch;
+    const b = Math.min(total, a + ink);
+    const start = at(a);
+    const end = at(b);
+    const mid = pts.slice(start.next, end.next);
+    const chain = [start.p, ...mid, end.p]
+      .map((p) => `${+p[0].toFixed(2)},${+p[1].toFixed(2)}`)
+      .join(" L");
+    out.push(`M${chain}`);
+  }
+  return out.join(" ");
+}
