+// ── F4: chip state + the deal arm ───────────────────────────────────────────────────────
+// One chip map per card id, seeded lazily: the card's static defaults, overlaid with the mounted
+// board's real pair for the CURRENT game. Transient by design — a chip is provisional until a
+// Deal commits it (D7), and closing the picker forgets it.
+const chips = reactive<Record<string, Record<string, string | number>>>({});
+function chipsFor(card: GalleryCard): Record<string, string | number> {
+  let held = chips[card.id];
+  if (!held) {
+    held = {};
+    for (const axis of card.staging) held[axis.key] = axis.default;
+    if (card.id === props.currentId && props.staged)
+      for (const [k, v] of Object.entries(props.staged)) if (k in held) held[k] = v;
+    chips[card.id] = held;
+  }
+  return held;
+}
