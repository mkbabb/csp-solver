+/**
+ * ONE STAGING AXIS (F4-D1) — the card's staging band, as STATIC data.
+ *
+ * This replaces two things at once: the dead `range` caption (5 producers, 1 consumer, 0 tests)
+ * and `GameDefinition.options: (model) => ControlSection[]`, whose only consumer was the
+ * drawer's staged zone. Staging moves to the picker card, so the registry must carry the SCHEMA
+ * — and it carries it without a live model: values in via props, intents out via emits (the
+ * pencil grammar). The mounted board's real pair arrives through `useStagingBridge`, never here.
+ *
+ * `key` is the URL/bridge vocabulary (`size` · `difficulty`) and stays uniform across the five;
+ * `label` is the game's OWN word — which is what fixes the old `range.label: "size"` lie on
+ * futoshiki/kenken, whose axis is a board side length, not a subgrid size.
+ */
+export interface StagingAxis {
+  key: string;
+  label: string;
+  /** shown on the board-margin re-deal strip as well as the card (the frequent axis). */
+  quick?: boolean;
+  options: { value: string | number; label: string; colorClass?: string }[];
+  default: string | number;
+}
