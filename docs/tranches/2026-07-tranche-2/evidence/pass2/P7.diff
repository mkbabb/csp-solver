index 69f412bb..19102098 100644
--- a/web/frontend/vite.config.ts
+++ b/web/frontend/vite.config.ts
@@ -147,12 +147,26 @@ export default defineConfig({
     minify: 'esbuild',
     rollupOptions: {
       output: {
-        manualChunks: {
-          'vue-vendor': ['vue'],
-          // keyframes.js dropped from the app runtime by W8's 4th workstream (grid + glyph
-          // draw-in migrated off `KeyframesAnimation` onto the unified scheduler's `sequence`
-          // subscriber kind), so it no longer enters any chunk — only pencil-boil remains here.
-          'animation-vendor': ['@mkbabb/pencil-boil'],
+        // P7 (Vite 8 / Rolldown prototype): Rolldown's `manualChunks` binding
+        // requires a function — the plain `{ chunkName: [specifiers] }` object
+        // form Rollup/esbuild-Vite accepted throws `manualChunks is not a
+        // function` at build time under Rolldown. The object form's semantics
+        // were dependency-graph-based (name a package, everything IT imports
+        // rides along) — the naive function-form equivalent is an id substring
+        // test, and `vue`'s own npm package is a thin re-export shell around
+        // `@vue/runtime-core`/`@vue/runtime-dom`/`@vue/reactivity`/`@vue/shared`,
+        // so both prefixes are needed to reproduce the old chunk contents.
+        // NOTE (P7 finding): even with per-module assignment verified correct
+        // (instrumented — every @vue/* file returns 'vue-vendor', every
+        // pencil-boil file returns 'animation-vendor'), Rolldown's chunk
+        // emission does not preserve the 1:1 name↔content mapping the same
+        // function achieves under Rollup — content ends up redistributed
+        // across the two named files. Build succeeds and the app still
+        // functions (import graph is correct either way); only the vendor
+        // split's *shape* drifts. See P7 report for detail.
+        manualChunks(id) {
+          if (id.includes('/node_modules/vue/') || id.includes('/node_modules/@vue/')) return 'vue-vendor'
