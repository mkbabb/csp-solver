diff --git a/web/frontend/index.html b/web/frontend/index.html
index 802e0c30..114ef8e9 100644
--- a/web/frontend/index.html
+++ b/web/frontend/index.html
@@ -5,12 +5,9 @@
     <meta name="viewport" content="width=device-width, initial-scale=1.0" />
     <title>Sudoku - CSP Solver</title>
     <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
-    <link rel="preconnect" href="https://fonts.googleapis.com" />
-    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
-    <link
-      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Fira+Code:wght@300..700&family=Patrick+Hand&display=swap"
-      rel="stylesheet"
-    />
+    <!-- P5 (Tranche II Pass-2): fonts are self-hosted subsets, wired via @font-face
+         in src/assets/index.css — the Google Fonts CDN link is gone, so is the
+         fonts.googleapis.com/fonts.gstatic.com CSP allowance (see public/_headers). -->
   </head>
   <body>
     <div id="app"></div>
diff --git a/web/frontend/public/_headers b/web/frontend/public/_headers
index d085fe42..badc20db 100644
--- a/web/frontend/public/_headers
+++ b/web/frontend/public/_headers
@@ -26,11 +26,13 @@
 #                                  animation system set inline style
 #                                  attributes at runtime (no nonce plumbing
 #                                  exists for this yet)
-#               fonts.googleapis.com  the Fraunces/Fira Code/Patrick Hand
-#                                     stylesheet linked in index.html
-#   font-src    'self'
-#               fonts.gstatic.com  the woff2 files the Google Fonts
-#                                  stylesheet above actually resolves to
+#   font-src    'self'             P5 (2026-07-09): Fraunces/Fira Code/Patrick
+#                                  Hand are self-hosted subsets under
+#                                  src/assets/fonts/ (@font-face in index.css),
+#                                  bundled same-origin — fonts.googleapis.com /
+#                                  fonts.gstatic.com are gone from both this
+#                                  clause and style-src above (the Google Fonts
+#                                  <link> in index.html is deleted)
 #   img-src     'self'
 #               data:              hand-drawn pencil-stroke SVGs are
 #                                  generated at runtime as
@@ -65,7 +67,7 @@
 #     avoids leaking path/query to third parties
 
 /*
-  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://avatars.githubusercontent.com; connect-src 'self' https://api.sudoku.babb.dev; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
+  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://avatars.githubusercontent.com; connect-src 'self' https://api.sudoku.babb.dev; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
   Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
   X-Frame-Options: DENY
   X-Content-Type-Options: nosniff
