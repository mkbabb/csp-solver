diff --git a/web/frontend/src/assets/index.css b/web/frontend/src/assets/index.css
index 6f0f65d7..563d83e4 100644
--- a/web/frontend/src/assets/index.css
+++ b/web/frontend/src/assets/index.css
@@ -3,6 +3,74 @@
 
 @custom-variant dark (&:is(.dark *));
 
+/* ── P5 PROTOTYPE — self-hosted subset faces (Tranche II Pass-2) ────────────
+ * Replaces the Google Fonts CDN `<link>` (index.html) + its `fonts.googleapis.com`/
+ * `fonts.gstatic.com` CSP clauses. Each woff2 is `pyftsubset`-built from the
+ * upstream google/fonts variable-font source, trimmed to the EXACT glyphs the
+ * app renders (derived from the source templates/copy, not guessed — see the
+ * P5 report for the derivation + byte table):
+ *
+ *   fraunces-subset.woff2    9,764 B  — WORDMARK + HEADINGS ONLY (opsz+wght
+ *                                       variable, SOFT/WONK pinned like the
+ *                                       CDN's own served instance). Covers the
+ *                                       game-name wordmark ("sudoku",
+ *                                       "futoshiki") + the .section-heading
+ *                                       labels ("Size", "Difficulty", "Board
+ *                                       Size"). unicode-range gates it to
+ *                                       exactly that repertoire so any OTHER
+ *                                       text asking for 'Fraunces' (there are
+ *                                       none live today — text-body/
+ *                                       text-prose/text-title/etc. are unused
+ *                                       utilities) safely falls through to the
+ *                                       Georgia stack instead of mixing
+ *                                       glyphs mid-word. NOT a general body-
+ *                                       copy subset — that's a wider follow-on
+ *                                       if --font-text ever gets a real
+ *                                       consumer.
+ *   firacode-subset.woff2    3,624 B  — full realistic app coverage: every
+ *                                       OptionSelector option label (size +
+ *                                       difficulty, both games) + the
+ *                                       AttributionCard "@mbabb" byline.
+ *   patrickhand-subset.woff2 3,840 B  — full realistic app coverage: every
+ *                                       MarginNote status string, every
+ *                                       SolverErrorNote paper-note variant
+ *                                       (both games), every SheetWashiLabel
+ *                                       tooltip, + the wordmark dropdown list.
+ *
+ * Total self-hosted: 17,228 B for all three faces vs. the ~124.5–204 KB the
+ * CDN serves today for the same three families' latin-only chunks (regime
+ * depends on whether the italic Fraunces chunk — used by AttributionCard's
+ * body-inherited caption — is counted; that chunk is OUT of this subset's
+ * scope, see --font-text below).
+ */
+@font-face {
+  font-family: 'Fraunces';
+  font-style: normal;
+  font-weight: 100 900;
+  font-display: swap;
+  font-stretch: 100%;
+  src: url('./fonts/fraunces-subset.woff2') format('woff2');
+  unicode-range: U+0020, U+0042, U+0044, U+0053, U+0061, U+0063-0064, U+0065-0066, U+0068, U+0069, U+006B, U+006C, U+006F, U+0072-0074, U+0075, U+0079, U+007A;
+}
+
+@font-face {
+  font-family: 'Fira Code';
+  font-style: normal;
+  font-weight: 300 700;
+  font-display: swap;
+  src: url('./fonts/firacode-subset.woff2') format('woff2');
+  unicode-range: U+0020, U+0031, U+0034-0037, U+0039, U+0040, U+0045, U+0048, U+004D, U+0061-0062, U+0064-0065, U+0069, U+006D, U+0072, U+0073, U+0075, U+0079, U+00D7;
+}
+
+@font-face {
+  font-family: 'Patrick Hand';
+  font-style: normal;
+  font-weight: 400;
+  font-display: swap;
+  src: url('./fonts/patrickhand-subset.woff2') format('woff2');
+  unicode-range: U+0020-0021, U+0027, U+002D, U+002E, U+0030-0039, U+003F, U+0043, U+0052, U+0053, U+0061-0068, U+006B-0071, U+0073-007A, U+2014, U+2026;
+}
+
 @layer base {
   body {
     font-family: var(--font-text);
@@ -22,10 +90,22 @@
      and Plus Jakarta never ships. Defining --font-mono/--font-serif here also
      retires the D5 gap: Tailwind's `font-mono` now resolves to Fira Code (not
      the ui-monospace system default), so the mono surface is finally the soul's
-     mono, not the platform's. One consolidated Fraunces fallback chain (D6). */
-  --font-text: 'Fraunces', Georgia, Cambria, 'Times New Roman', serif;
+     mono, not the platform's.
+     P5 (2026-07-09): --font-mono/--font-hand now resolve against the
+     self-hosted subsets above (comprehensive — every live consumer's glyphs
+     are covered). --font-text/--font-serif deliberately DROP 'Fraunces' here:
+     the self-hosted Fraunces subset only covers the wordmark + .section-heading
+     repertoire (the P5 gate's stated scope), and --font-text/--font-serif are
+     the BODY/prose registers (bound by text-body/text-prose/text-title/etc. —
+     all zero-consumer utilities today, so this changes no rendered pixel; the
+     one live body-inherited use, AttributionCard's caption + GitHub link, gets
+     the honest Georgia fallback instead of a mid-word glyph mismatch once the
+     Google Fonts CDN is dropped). --font-display keeps 'Fraunces' — its only
+     consumers (text-display*, .section-heading, the wordmark's own hardcoded
+     family string) are exactly what the subset covers. */
+  --font-text: Georgia, Cambria, 'Times New Roman', serif;
   --font-display: 'Fraunces', Georgia, Cambria, 'Times New Roman', serif;
-  --font-serif: 'Fraunces', Georgia, Cambria, 'Times New Roman', serif;
+  --font-serif: Georgia, Cambria, 'Times New Roman', serif;
   --font-mono: 'Fira Code', monospace;
   --font-hand: 'Patrick Hand', cursive;
 
diff --git a/web/frontend/vite.config.ts b/web/frontend/vite.config.ts
index 69f412bb..253ca848 100644
--- a/web/frontend/vite.config.ts
+++ b/web/frontend/vite.config.ts
@@ -145,6 +145,14 @@ export default defineConfig({
   build: {
     target: 'es2020',
     minify: 'esbuild',
+    // P5 (Tranche II Pass-2): never base64-inline the self-hosted font subsets. The
+    // default 4KB assetsInlineLimit would otherwise fold firacode-subset.woff2
+    // (3,624 B) and patrickhand-subset.woff2 (3,840 B) into index.css as base64 —
+    // ~33% bigger on the wire than the raw binary AND no longer independently
+    // cacheable (they'd get re-fetched on every CSS-touching deploy instead of
+    // sitting behind their own immutable, content-hashed URL — the W5 cache-header
+    // beat this self-host exists to feed).
+    assetsInlineLimit: (filePath) => !filePath.endsWith('.woff2'),
     rollupOptions: {
       output: {
         manualChunks: {
diff --git a/web/nginx/sudoku.conf b/web/nginx/sudoku.conf
index afb0cadf..f78cde02 100644
--- a/web/nginx/sudoku.conf
+++ b/web/nginx/sudoku.conf
@@ -29,7 +29,10 @@ server {
     # web/frontend/public/_headers for the directive-by-directive
     # rationale — this CSP mirrors that one for consistency across both
     # served paths.
-    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://avatars.githubusercontent.com; connect-src 'self' https://api.sudoku.babb.dev; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
+    # P5 (2026-07-09): fonts.googleapis.com/fonts.gstatic.com dropped — Fraunces/
+    # Fira Code/Patrick Hand are self-hosted subsets under src/assets/fonts/
+    # (@font-face in index.css), same-origin.
+    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://avatars.githubusercontent.com; connect-src 'self' https://api.sudoku.babb.dev; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
     # Force HTTPS for 2y, cover subdomains. `preload` only marks eligibility
     # — actual submission to the HSTS preload list is a separate owner action.
     add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
